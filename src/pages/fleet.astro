  },
  {
    q: "Why do Kalidass Travels Tempo Travellers not have rooftop luggage carriers?",
    a: "In accordance with strict Tamil Nadu and interstate RTO highway safety standards, open rooftop carriers are prohibited as they alter vehicle center-of-gravity, create aerodynamic drag, and expose passenger luggage to highway dust and tropical rain. All Kalidass Travels Force Tempo Travellers and Urbania vans feature dedicated internal rear luggage trunks (450L to 1,600L) ensuring 100% weather-proof, inside storage."
  },
  {
    q: "How does Force Urbania VIP differ from a standard Force Tempo Traveller?",
    a: "Force Urbania is built on a European monocoque architecture with independent front coil suspension, delivering passenger-car ride smoothness with virtually zero body roll. It features aircraft-style independent recliners, individual reading lights, triple-zone climate control, and sealed aircraft-style overhead cabin bins, providing business-class comfort for VIP delegations, NRIs, and destination weddings."
  },
  {
    q: "What are the minimum billing kilometers for outstation cab rentals in Chennai?",
    a: "Outstation round trips carry a standard commercial minimum billing of 250 kilometers per calendar day for Sedans (Dzire, Etios) and Family MPVs (Ertiga, Innova). For Innova Crysta, Tempo Travellers (12S, 14S, 17S, 20S), and Force Urbania, the minimum billing is 300 km per calendar day (350 km/day for 26-Seater Coach). If actual kilometers exceed the daily slab, additional kilometers are billed at the published flat per-km rate with zero surge."
  }
];

// Schema.org Structured Data: ItemList and FAQPage
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "@id": "https://kalidasstravels.in/fleet/#itemlist",
      name: "Kalidass Travels Commercial Taxi & Van Fleet",
      description: "Pristine, sanitized commercial yellow-plate taxi fleet in Chennai: Swift Dzire, Toyota Etios, Maruti Ertiga, Toyota Innova, Innova Crysta, 12 to 26-Seater Force Tempo Travellers, and Force Urbania VIP with background-verified chauffeurs.",
      url: "https://kalidasstravels.in/fleet/",
      numberOfItems: fleetVehicles.length,
      itemListElement: fleetVehicles.map((v, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        item: {
          "@type": "Product",
          name: `${v.name} Commercial Taxi Rental`,
          description: `Commercial AC vehicle with verified chauffeur. ${v.seats}, ${v.baggage}. Outstation round trip from ₹${v.roundTripRate}/km, driver allowance ₹${v.driverBata}/day.`,
          image: `https://kalidasstravels.in${v.image}`,
          sku: `FLEET-${v.id.toUpperCase()}`,
          brand: {
            "@type": "Brand",
            name: "Kalidass Travels"
          },
          offers: {
            "@type": "Offer",
            priceCurrency: "INR",
            price: v.roundTripRate,
            priceSpecification: {
              "@type": "UnitPriceSpecification",
              price: v.roundTripRate,
              priceCurrency: "INR",
              unitText: "KM"
            },
            priceValidUntil: "2027-12-31",
            validFrom: "2025-01-01",
            availability: "https://schema.org/InStock",
            url: `https://kalidasstravels.in/fleet/#${v.id}`,
            seller: {
              "@id": "https://kalidasstravels.in/#localbusiness"
            }
          }
        }
      }))
    },
    {
      "@type": "FAQPage",
      "@id": "https://kalidasstravels.in/fleet/#faq",
      mainEntity: faqs.map(faq => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.a
        }
      }))
    }
  ]
};
---

<Layout
  title="Commercial Taxi & Van Fleet in Chennai | Sedans, Tempo Travellers & Urbania | Kalidass Travels"
  description="Explore Kalidass Travels commercial taxi and van fleet in Chennai: Swift Dzire, Etios, Ertiga, Innova Crysta, 12–26 seater Tempo Travellers & Force Urbania VIP."
  ogImage="/og/fleet.jpg"
  keywords="commercial fleet chennai, cab fleet chennai, tempo traveller hire chennai, 12 seater tempo traveller chennai, 17 seater tempo traveller chennai, force urbania rental chennai, innova crysta rental chennai, ertiga cab chennai, sedan taxi chennai, commercial cabs with driver chennai"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface-container-low min-h-screen pt-4 pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- 1. Page Header -->
      <header id="fleet-page-header" class="text-center max-w-3xl mx-auto mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-m3-on-surface tracking-tight leading-tight mb-2 font-heading">
          Our Commercial Fleet &amp; <span class="text-m3-primary">Luxury Cabs</span>
        </h1>
        <p class="text-xs sm:text-sm text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal font-sans">
          Sanitized AC sedans, 6–7 seater MPVs, 12 to 26-seater Force Tempo Travellers, and Force Urbania VIP vans with verified chauffeurs.
        </p>
      </header>

      <!-- 2. Interactive Category Filter Chips -->
      <section class="mb-8" aria-label="Filter Vehicles by Category">
        <div class="flex items-center justify-center flex-wrap gap-2 sm:gap-2.5">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-fleet-filter={cat.key}
              aria-pressed={idx === 0 ? "true" : "false"}
              class={`fleet-filter-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-m3-full text-xs sm:text-sm font-bold min-h-[44px] transition-all cursor-pointer border ${
                idx === 0
                  ? "bg-m3-primary text-white border-m3-primary shadow-xs"
                  : "bg-white text-slate-700 border-slate-300 hover:bg-slate-100"
              }`}
            >
              <span>{cat.label}</span>
              <span class={`text-xs px-2 py-0.5 rounded-full font-bold ${
                idx === 0 ? "bg-white/20 text-white" : "bg-slate-100 text-slate-600"
              }`}>
                {cat.count}
              </span>
            </button>
          ))}
        </div>
      </section>

      <!-- 3. Comprehensive Vehicle Cards Grid -->
      <section id="fleet-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 mb-14" aria-label="Fleet Vehicles Catalog">
        {fleetVehicles.map((vehicle) => {
          return (
            <article
              id={vehicle.id}
              data-category={vehicle.category}
              class="fleet-card bg-m3-surface-container-lowest rounded-m3-2xl border border-slate-200/90 shadow-ambient hover:shadow-ambient-hover hover:border-slate-300 transition-all flex flex-col justify-between overflow-hidden group select-none scroll-mt-28"
            >
              <div>
                <!-- Vehicle Image Showcase Container -->
                <div class="relative h-44 sm:h-48 bg-m3-surface-container-low flex items-center justify-center p-4 border-b border-slate-200/60 overflow-hidden">
                  <!-- Category Badge -->
                  <span class="absolute top-3 left-3 z-10 text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-m3-full bg-white/95 text-slate-900 border border-slate-200 shadow-2xs">
                    {vehicle.badge}
                  </span>

