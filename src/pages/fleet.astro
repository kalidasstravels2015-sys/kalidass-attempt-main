<script>
  // Interactive Category Filter Logic with progressive enhancement
  function initFleetCategoryFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-fleet-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.fleet-card');

    if (!filterButtons.length || !cards.length) return;

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-fleet-filter') || 'all';

        // Update button states
        filterButtons.forEach(b => {
          const isActive = b === btn;
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive) {
            b.className = 'fleet-filter-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-m3-full text-xs sm:text-sm font-bold min-h-[44px] transition-all cursor-pointer border bg-m3-primary text-white border-m3-primary shadow-xs';
            const badge = b.querySelector('span:last-child');
            if (badge) badge.className = 'text-xs px-2 py-0.5 rounded-full font-bold bg-white/20 text-white';
          } else {
            b.className = 'fleet-filter-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-m3-full text-xs sm:text-sm font-bold min-h-[44px] transition-all cursor-pointer border bg-white text-slate-700 border-slate-300 hover:bg-slate-100';
            const badge = b.querySelector('span:last-child');
            if (badge) badge.className = 'text-xs px-2 py-0.5 rounded-full font-bold bg-slate-100 text-slate-600';
          }
        });

        // Filter cards smoothly
        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (targetCategory === 'all' || cardCategory === targetCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFleetCategoryFilters);
  } else {
    initFleetCategoryFilters();
  }
</script>
