---
import Layout from "../layouts/Layout.astro";
import FleetRoll from "../components/react/FleetRoll.jsx";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import tariffConfig from "../data/tariff_config.json";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Fleet", item: "/fleet/" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Kalidass Travels Fleet",
  description: "Our fleet of well-maintained vehicles for outstation, temple tours, and corporate travel across South India.",
  url: "https://kalidasstravels.in/fleet/",
  itemListElement: Object.entries(tariffConfig.vehicles).map(([name, v]: [string, any], idx: number) => ({
    "@type": "ListItem",
    position: idx + 1,
    item: {
      "@type": "Product",
      name: `${name} Taxi Rental`,
      description: `Commercial AC vehicle with driver. Round trip from ₹${v.round_trip_rate}/km, One way from ₹${v.one_way_rate}/km.`,
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: v.round_trip_rate,
        unitText: "KM"
      }
    }
  }))
};
---

<Layout
  title="Commercial Cab Fleet in Chennai | Dzire, Ertiga, Innova & Tempo Travellers – Kalidass Travels"
  description="Explore our sanitized commercial taxi fleet in Chennai: Swift Dzire, Toyota Etios, Maruti Ertiga, Innova Crysta & 12–17 Seater Tempo Travellers with verified drivers."
  keywords="cab fleet chennai, innova crysta rental chennai, tempo traveller hire chennai, sedan taxi chennai, ertiga cab booking chennai, commercial vehicles with driver chennai"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface-container-low min-h-screen pt-6 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-amber-400 border border-amber-500 text-slate-950 text-xs font-black shadow-sm mb-3.5 tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-slate-950"></span>
          <span>Commercial Yellow-Plate AITP Fleet</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
          Our Premium Fleet &amp; <span class="text-m3-primary">Taxi Models</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-6 font-normal font-sans">
          Pristine, sanitized, and commercial-plated vehicles driven by background-verified chauffeurs. Fixed rates per km with zero surge pricing.
        </p>
      </div>

      <!-- Fleet Component -->
      <FleetRoll client:load currentLang="en" hideHeader={true} />

      <!-- Bottom Booking CTA Banner -->
      <div class="mt-10 bg-m3-inverse-surface text-m3-inverse-on-surface rounded-m3-2xl p-6 sm:p-8 text-center shadow-m3-3 border border-m3-outline-variant/20 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight leading-tight mb-2.5 font-heading text-white">
            Need Help Choosing the <span class="text-white">Right Vehicle?</span>
          </h2>
          <p class="text-xs sm:text-sm md:text-base text-slate-300 max-w-2xl mx-auto mb-6 leading-relaxed font-normal font-sans">
            Whether it's a 4-seater sedan for Chennai city errands or a 12-seater Tempo Traveller for an outstation pilgrimage, our team is available 24/7.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/calculator/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-m3-primary hover:bg-slate-900 text-m3-on-primary font-bold text-m3-label-l rounded-m3-full shadow-m3-2 hover:shadow-m3-3 transition-all transform hover:-translate-y-0.5 border border-white/20 group"
            >
              <span>Calculate Instant Fare</span>
              <span class="material-symbols-outlined text-[18px] text-emerald-400 transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
            <a
              href="tel:+919092303060"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-m3-surface hover:bg-m3-surface-container text-m3-on-surface font-bold text-m3-label-l rounded-m3-full shadow-m3-1 transition-all"
            >
              <span class="material-symbols-outlined text-[18px] text-emerald-500">call</span>
              <span>Call Helpline: +91 90923 03060</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
