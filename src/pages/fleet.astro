---
import Layout from "../layouts/Layout.astro";
import FleetCarousel from "../components/FleetCarousel.astro";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import tariffConfig from "../data/tariff_config.json";
import { ArrowRight, Phone, ShieldCheck, CheckCircle2, Sparkles, Navigation } from "lucide-react";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Fleet", item: "/fleet/" },
];

const vehicleImages: Record<string, string> = {
  "Swift Dzire": "/images/fleet/swift-dzire.webp",
  "Toyota Etios": "/images/fleet/toyoto-etios.webp",
  "Maruti Ertiga": "/images/fleet/maruti-ertiga.webp",
  "Innova": "/images/fleet/suv.webp",
  "Innova Crysta": "/images/fleet/suv.webp",
  "Tempo Traveller": "/images/fleet/tempo.webp",
  "Force Urbania": "/images/fleet/force-urbania.webp",
};

const schema = {
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/fleet/#itemlist",
  name: "Kalidass Travels Fleet",
  description: "Our fleet of well-maintained vehicles for outstation, temple tours, and corporate travel across South India.",
  url: "https://kalidasstravels.in/fleet/",
  itemListElement: Object.entries(tariffConfig.vehicles).map(([name, v]: [string, any], idx: number) => ({
    "@type": "ListItem",
    position: idx + 1,
    item: {
      "@type": "Product",
      name: `${name} Taxi Rental`,
      description: `Commercial AC vehicle with driver. Round trip from ₹${v.round_trip_rate}/km, One way from ₹${v.one_way_rate}/km.`,
      image: `https://kalidasstravels.in${vehicleImages[name] || "/images/fleet/swift-dzire.webp"}`,
      sku: `FLEET-${name.toUpperCase().replace(/\s+/g, '-')}`,
      brand: {
        "@type": "Brand",
        name: "Kalidass Travels"
      },
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: v.round_trip_rate,
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: v.round_trip_rate,
          priceCurrency: "INR",
          unitText: "KM"
        },
        priceValidUntil: "2027-12-31",
        validFrom: "2025-01-01",
        availability: "https://schema.org/InStock",
        url: "https://kalidasstravels.in/fleet/",
        seller: {
          "@id": "https://kalidasstravels.in/#localbusiness"
        }
      }
    }
  }))
};
---

<Layout
  title="Commercial Cab Fleet in Chennai | Kalidass Travels"
  description="Sanitized commercial taxi fleet in Chennai: Swift Dzire, Ertiga, Innova Crysta & 12–17 seater Tempo Travellers with verified drivers."
  ogImage="/og/fleet.jpg"
  keywords="cab fleet chennai, innova crysta rental chennai, tempo traveller hire chennai, sedan taxi chennai, ertiga cab booking chennai, commercial vehicles with driver chennai"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface-container-low min-h-screen pt-6 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-m3-full bg-amber-400 border border-amber-500 text-slate-950 text-xs font-black shadow-xs mb-3.5 tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-slate-950"></span>
          <span>Commercial Yellow-Plate AITP Fleet</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Our Premium Fleet &amp; <span class="text-m3-primary">Taxi Models</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-6 font-normal font-sans">
          Pristine, sanitized, and commercial-plated vehicles driven by background-verified chauffeurs. Fixed rates per km with zero surge pricing.
        </p>

        <!-- Desktop Trust Pill Strip -->
        <div class="flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <ShieldCheck className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>100% Commercial Yellow Plates</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <Navigation className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>GPS Tracked &amp; FASTag Enabled</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <Sparkles className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>Daily Sanitized Interiors</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <CheckCircle2 className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>Working AC Guaranteed</span>
          </span>
        </div>
      </div>

      <!-- Fleet Component -->
      <FleetCarousel hideHeader={true} sectionHeading="Available Cabs and Commercial Vehicles" />

      <!-- Bottom Booking CTA Banner -->
      <div class="mt-10 bg-gradient-to-br from-[#0B57D0] via-[#0842A0] to-[#041E49] text-white rounded-m3-2xl p-6 sm:p-8 text-center shadow-m3-3 border border-[#0B57D0]/20 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight leading-tight mb-2.5 font-heading text-white">
            Need Help Choosing the <span class="text-white">Right Vehicle?</span>
          </h2>
          <p class="text-xs sm:text-sm md:text-base text-white/90 max-w-2xl mx-auto mb-6 leading-relaxed font-normal font-sans">
            Whether it's a 4-seater sedan for Chennai city errands or a 12-seater Tempo Traveller for an outstation pilgrimage, our team is available 24/7.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/calculator/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] bg-white hover:bg-[#F0F4F9] !text-[#0B57D0] hover:!text-[#0842A0] font-bold text-xs sm:text-sm rounded-m3-full shadow-m3-2 hover:shadow-m3-3 transition-all transform hover:-translate-y-0.5 border border-white/40 group"
            >
              <span>Calculate Instant Fare</span>
              <ArrowRight className="w-4 h-4 text-[#0B57D0] transform group-hover:translate-x-1 transition-transform shrink-0" />
            </a>
            <a
              href="tel:+918939539211"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 min-h-[44px] bg-white/15 hover:bg-white/25 text-white font-bold text-xs sm:text-sm rounded-m3-full border border-white/30 shadow-m3-1 transition-all"
            >
              <Phone className="w-4 h-4 text-white shrink-0" />
              <span>Call Helpline: +91 89395 39211</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
