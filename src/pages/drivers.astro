---
import Layout from "../layouts/Layout.astro";
import siteContent from "../data/siteContent.json";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";

const drivers = siteContent.drivers;

function toSlug(name: string) {
  return name
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Drivers", item: "/drivers/" },
];

const site = "https://kalidasstravels.in";

const driversSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/drivers/#itemlist",
  "name": "Verified Chauffeurs & Acting Drivers in Chennai - Kalidass Travels",
  "description": "Background-verified, experienced chauffeurs with police clearance certificates (PVC).",
  "itemListElement": drivers.map((driver: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Person",
      "name": driver.name,
      "jobTitle": "Professional Chauffeur",
      "description": `${driver.experience} experience. Specialist in ${driver.specialty}. Languages: ${driver.languages}.`,
      "image": `${site}${driver.image}`,
      "url": `${site}/drivers/${toSlug(driver.name)}/`
    }
  }))
};
---

<Layout
  title="Verified Chauffeurs & Acting Drivers in Chennai – Kalidass Travels"
  description="Meet our police-verified, background-checked chauffeurs & acting drivers in Chennai. 10+ years experience in highway trips, temple routes & city driving."
  keywords="verified drivers chennai, acting drivers in chennai, professional chauffeurs chennai, highway driver chennai, outstation driver hire chennai, personal car driver chennai"
  schema={driversSchema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <main class="pt-6 pb-12 bg-m3-surface-container-low text-m3-on-surface min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="text-center max-w-3xl mx-auto mb-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-3.5 tracking-wide">
          <span class="material-symbols-outlined text-[16px] text-m3-primary">verified_user</span>
          <span>Police Background Verified (PVC)</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
          Our Verified <span class="text-m3-primary">Drivers &amp; Chauffeurs</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-6 font-normal font-sans">
          All our drivers are permanent team members with verified police clearance (PVC) and clean highway records. Meet the drivers behind Kalidass Travels.
        </p>
      </div>

      {/* Driver Cards Grid */}
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
        <h2 class="sr-only">List of Verified Drivers</h2>
        {
          drivers.map((driver) => {
            const slug = toSlug(driver.name);
            const profileUrl = `${site}/drivers/${slug}/`;
            const waShareText = encodeURIComponent(
              `*${driver.name}* - ${driver.specialty}\n` +
              `⭐ ${driver.rating} Rating | ${driver.trips} Trips\n` +
              `✅ Police Verification Certified\n\n` +
              `Book via *Kalidass Travels*\n` +
              `👉 ${profileUrl}`
            );

            return (
              <div class="bg-m3-surface rounded-m3-xl shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant transition-all duration-300 group flex flex-col h-full overflow-hidden">

                <!-- Clickable photo area -->
                <a href={`/drivers/${slug}/`} class="block relative overflow-hidden shrink-0 bg-m3-surface-container-high">
                  <img
                    src={driver.image}
                    width="300"
                    height="176"
                    decoding="async"
                    class="w-full h-40 sm:h-44 object-cover object-top transform group-hover:scale-105 transition-transform duration-300"
                    alt={driver.name}
                    loading="lazy"
                  />
                  <!-- Tag chip -->
                  <span class="absolute top-2.5 left-2.5 bg-slate-950/80 backdrop-blur-md border border-white/20 text-white text-badge font-bold px-2.5 py-0.5 rounded-m3-full shadow-sm">
                    {driver.tag}
                  </span>
                </a>

                <div class="p-4 flex flex-col flex-grow gap-2.5">
                  <!-- Name + rating -->
                  <a href={`/drivers/${slug}/`} class="flex justify-between items-start gap-1 group-hover:text-m3-primary transition-colors">
                    <h3 class="font-bold text-base text-m3-on-surface leading-tight font-heading">
                      {driver.name}
                    </h3>
                    <div class="flex items-center bg-m3-surface-container-high px-2 py-0.5 rounded-m3-full border border-m3-outline-variant shrink-0">
                      <span class="material-symbols-outlined text-[14px] text-gold-600">star</span>
                      <span class="text-badge font-bold text-m3-on-surface ml-1">
                        {driver.rating || "4.8"}
                      </span>
                    </div>
                  </a>

                  <!-- Badges -->
                  <div class="flex flex-wrap gap-1.5">
                    <div class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-m3-surface-container-high border border-m3-outline-variant rounded-m3-sm text-badge font-semibold text-m3-on-surface">
                      <span class="material-symbols-outlined text-[14px] text-m3-primary">verified_user</span>
                      Verified
                    </div>
                    {driver.trips && (
                      <div class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-m3-surface-container-high border border-m3-outline-variant rounded-m3-sm text-badge font-semibold text-m3-on-surface-variant">
                        <span class="text-m3-primary">●</span> {driver.trips} Trips
                      </div>
                    )}
                  </div>

                  <!-- Details -->
                  <div class="text-xs text-m3-on-surface-variant space-y-1.5 my-1">
                    <div class="flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-[16px] text-m3-primary shrink-0">schedule</span>
                      <span>{driver.experience}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-[16px] text-m3-primary shrink-0">translate</span>
                      <span>{driver.languages}</span>
                    </div>
                  </div>

                  <!-- CTAs -->
                  <div class="pt-3 mt-auto border-t border-m3-outline-variant/60 flex items-center gap-2">
                    <a
                      href={`/drivers/${slug}/`}
                      class="flex-1 text-center text-micro sm:text-xs font-semibold text-m3-on-surface bg-m3-surface-container-high hover:bg-m3-surface-container-highest py-1.5 sm:py-2 rounded-m3-full transition-all whitespace-nowrap"
                    >
                      View Profile
                    </a>
                    <a
                      href={`https://wa.me/?text=${waShareText}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Share on WhatsApp"
                      class="flex items-center justify-center w-8 h-8 bg-[#25D366]/10 hover:bg-[#25D366] text-[#25D366] hover:text-white rounded-m3-full transition-all duration-200 shrink-0 shadow-sm hover:shadow-m3-1 focus-visible:ring-2 focus-visible:ring-[#25D366]"
                      aria-label={`Share ${driver.name} profile on WhatsApp`}
                    >
                      <WhatsAppIcon class="w-4 h-4" variant="brand" />
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </section>
    </div>
  </main>
</Layout>
