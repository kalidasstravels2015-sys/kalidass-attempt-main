---
import Layout from "../layouts/Layout.astro";
import siteContent from "../data/siteContent.json";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import { ShieldCheck, Star, CheckCircle2, Clock, Globe, ArrowRight } from "lucide-react";

const drivers = siteContent.drivers;

function toSlug(name: string) {
  return name
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Drivers", item: "/drivers/" },
];

const site = "https://kalidasstravels.in";

const driversSchema = {
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/drivers/#itemlist",
  "name": "Verified Chauffeurs & Acting Drivers in Chennai - Kalidass Travels",
  "description": "Background-verified, experienced chauffeurs with police clearance certificates (PVC).",
  "itemListElement": drivers.map((driver: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Person",
      "name": driver.name,
      "jobTitle": "Professional Chauffeur",
      "description": `${driver.experience} experience. Specialist in ${driver.specialty}. Languages: ${driver.languages}.`,
      "image": `${site}${driver.image}`,
      "url": `${site}/drivers/${toSlug(driver.name)}/`
    }
  }))
};
---

<Layout
  title="Verified Chauffeurs & Acting Drivers | Kalidass Travels"
  description="Meet police-verified chauffeurs & acting drivers in Chennai. 10+ years experience in highway trips, temple routes & city driving with Kalidass Travels."
  keywords="verified drivers chennai, acting drivers in chennai, professional chauffeurs chennai, highway driver chennai, outstation driver hire chennai, personal car driver chennai"
  schema={driversSchema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <main class="pt-6 pb-12 bg-m3-surface-container-low text-m3-on-surface min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-xs mb-3.5 tracking-wide">
          <ShieldCheck className="w-4 h-4 text-m3-primary shrink-0" />
          <span>Police Background Verified (PVC) · Zero Incident Track Record</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Our Verified <span class="text-m3-primary">Drivers &amp; Chauffeurs</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-6 font-normal font-sans">
          All our drivers are permanent team members with verified police clearance (PVC), clean highway records, and 10+ years of expert navigation across South India.
        </p>

        <!-- Desktop Trust Pill Strip -->
        <div class="flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <CheckCircle2 className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>Police Clearance Certificate (PVC)</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <Clock className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>10+ Years Highway Experience</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <Globe className="w-3.5 h-3.5 text-m3-primary shrink-0" />
            <span>Multi-Lingual (Tamil, English, Hindi)</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-medium text-m3-on-surface shadow-2xs">
            <Star className="w-3.5 h-3.5 text-amber-500 fill-amber-500 shrink-0" />
            <span>4.9★ Average Rider Rating</span>
          </span>
        </div>
      </div>

      {/* Driver Cards Grid */}
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
        <h2 class="sr-only">List of Verified Drivers</h2>
        {
          drivers.map((driver) => {
            const slug = toSlug(driver.name);
            const driverUrl = `/drivers/${slug}/`;

            return (
              <div class="bg-m3-surface rounded-m3-xl shadow-m3-1 hover:shadow-m3-2 border border-m3-outline-variant p-3 sm:p-3.5 transition-all duration-200 group flex gap-3 sm:gap-3.5 items-stretch relative">

                <!-- Leading Media: 1:1 Square Thumbnail (Clickable) -->
                <a
                  href={driverUrl}
                  class="relative shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-m3-lg overflow-hidden bg-m3-surface-container-high self-start block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-m3-primary"
                  title={`View ${driver.name} Verified Credentials`}
                >
                  <img
                    src={driver.image}
                    width="112"
                    height="112"
                    decoding="async"
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                    alt={`${driver.name} - Verified Chauffeur at Kalidass Travels`}
                    loading="lazy"
                  />
                  <!-- Tag chip -->
                  <span class="absolute bottom-1 left-1 bg-m3-inverse-surface/85 backdrop-blur-md text-white text-[9px] font-bold px-1.5 py-0.5 rounded-m3-full leading-none shadow-sm">
                    {driver.tag}
                  </span>
                </a>

                <!-- Content & Details -->
                <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
                  <div>
                    <!-- Name + rating -->
                    <div class="flex items-center justify-between gap-1.5 mb-1">
                      <a
                        href={driverUrl}
                        class="font-bold text-sm sm:text-base text-m3-on-surface hover:text-m3-primary transition-colors truncate font-heading focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-m3-primary rounded"
                      >
                        {driver.name}
                      </a>
                      <div class="inline-flex items-center gap-0.5 bg-m3-tertiary-container/300/10 border border-m3-tertiary/30 px-1.5 py-0.5 rounded-m3-full shrink-0">
                        <Star className="w-3 h-3 text-m3-tertiary fill-current" />
                        <span class="text-xs font-bold text-m3-on-surface leading-none">{driver.rating || "4.8"}</span>
                      </div>
                    </div>

                    <!-- M3 Assist Chips -->
                    <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                      <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 bg-m3-success-container/400/10 border border-m3-success/30 rounded-m3-xs text-xs font-bold text-m3-on-success-container dark:text-m3-success">
                        <CheckCircle2 className="w-3 h-3 text-m3-success" />
                        PVC Verified
                      </span>
                      {driver.trips && (
                        <span class="inline-flex items-center px-1.5 py-0.5 bg-m3-surface-container-high rounded-m3-xs text-xs font-semibold text-m3-on-surface-variant">
                          {driver.trips} Trips
                        </span>
                      )}
                    </div>

                    <!-- Details -->
                    <div class="text-xs text-m3-on-surface-variant space-y-0.5 mb-2">
                      <div class="flex items-center gap-1 truncate">
                        <Clock className="w-3.5 h-3.5 text-m3-on-surface-variant/70 shrink-0" />
                        <span class="truncate">{driver.experience}</span>
                      </div>
                      <div class="flex items-center gap-1 truncate">
                        <Globe className="w-3.5 h-3.5 text-m3-on-surface-variant/70 shrink-0" />
                        <span class="truncate">{driver.languages}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Actions Row: View Verified ID Link -->
                  <div class="flex items-center justify-between pt-1.5 border-t border-m3-outline-variant/60 gap-2">
                    <a
                      href={driverUrl}
                      class="inline-flex items-center gap-1 text-xs font-bold text-m3-primary hover:underline transition-all"
                    >
                      <span>View Verified ID</span>
                      <ArrowRight className="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </section>
    </div>
  </main>
</Layout>
