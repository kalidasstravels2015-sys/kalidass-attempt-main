---
import Layout from "../layouts/Layout.astro";
import siteContent from "../data/siteContent.json";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";

const drivers = siteContent.drivers;

function toSlug(name: string) {
  return name
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Drivers", item: "/drivers/" },
];

const site = "https://kalidasstravels.in";

const driversSchema = {
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/drivers/#itemlist",
  "name": "Verified Chauffeurs & Acting Drivers in Chennai - Kalidass Travels",
  "description": "Background-verified, experienced chauffeurs with police clearance certificates (PVC).",
  "itemListElement": drivers.map((driver: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Person",
      "name": driver.name,
      "jobTitle": "Professional Chauffeur",
      "description": `${driver.experience} experience. Specialist in ${driver.specialty}. Languages: ${driver.languages}.`,
      "image": `${site}${driver.image}`,
      "url": `${site}/drivers/${toSlug(driver.name)}/`
    }
  }))
};
---

<Layout
  title="Verified Chauffeurs & Acting Drivers in Chennai – Kalidass Travels"
  description="Meet our police-verified, background-checked chauffeurs & acting drivers in Chennai. 10+ years experience in highway trips, temple routes & city driving."
  keywords="verified drivers chennai, acting drivers in chennai, professional chauffeurs chennai, highway driver chennai, outstation driver hire chennai, personal car driver chennai"
  schema={driversSchema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <main class="pt-6 pb-12 bg-m3-surface-container-low text-m3-on-surface min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="text-center max-w-3xl mx-auto mb-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-3.5 tracking-wide">
          <span class="material-symbols-outlined text-[16px] text-m3-primary">verified_user</span>
          <span>Police Background Verified (PVC)</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
          Our Verified <span class="text-m3-primary">Drivers &amp; Chauffeurs</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-6 font-normal font-sans">
          All our drivers are permanent team members with verified police clearance (PVC) and clean highway records. Meet the drivers behind Kalidass Travels.
        </p>
      </div>

      {/* Driver Cards Grid */}
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
        <h2 class="sr-only">List of Verified Drivers</h2>
        {
          drivers.map((driver) => {
            const waShareText = encodeURIComponent(
              `*${driver.name}* - ${driver.specialty}\n` +
              `⭐ ${driver.rating} Rating | ${driver.trips} Trips\n` +
              `✅ Police Verification Certified\n\n` +
              `Book via *Kalidass Travels* – kalidasstravels.in`
            );

            return (
              <div class="bg-m3-surface rounded-m3-xl shadow-m3-1 hover:shadow-m3-2 border border-m3-outline-variant p-3 sm:p-3.5 transition-all duration-200 group flex gap-3 sm:gap-3.5 items-stretch">

                <!-- Leading Media: 1:1 Square Thumbnail -->
                <div class="relative shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-m3-lg overflow-hidden bg-m3-surface-container-high self-start">
                  <img
                    src={driver.image}
                    width="112"
                    height="112"
                    decoding="async"
                    class="w-full h-full object-cover object-center"
                    alt={`${driver.name} - Verified Chauffeur at Kalidass Travels`}
                    loading="lazy"
                  />
                  <!-- Tag chip -->
                  <span class="absolute bottom-1 left-1 bg-slate-950/85 backdrop-blur-md text-white text-[9px] font-bold px-1.5 py-0.5 rounded-m3-full leading-none shadow-sm">
                    {driver.tag}
                  </span>
                </div>

                <!-- Content & Details -->
                <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
                  <div>
                    <!-- Name + rating -->
                    <div class="flex items-center justify-between gap-1.5 mb-1">
                      <span class="font-bold text-sm sm:text-base text-m3-on-surface truncate font-heading">
                        {driver.name}
                      </span>
                      <div class="inline-flex items-center gap-0.5 bg-amber-500/10 border border-amber-500/20 px-1.5 py-0.5 rounded-m3-full shrink-0">
                        <span class="material-symbols-outlined text-[13px] text-amber-500">star</span>
                        <span class="text-[11px] font-bold text-m3-on-surface leading-none">{driver.rating || "4.8"}</span>
                      </div>
                    </div>

                    <!-- M3 Assist Chips -->
                    <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                      <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 bg-emerald-500/10 border border-emerald-500/20 rounded-m3-xs text-[10px] font-bold text-emerald-800">
                        <span class="material-symbols-outlined text-[12px] text-emerald-600">verified</span>
                        Verified
                      </span>
                      {driver.trips && (
                        <span class="inline-flex items-center px-1.5 py-0.5 bg-m3-surface-container-high rounded-m3-xs text-[10px] font-semibold text-m3-on-surface-variant">
                          {driver.trips} Trips
                        </span>
                      )}
                    </div>

                    <!-- Details -->
                    <div class="text-[11px] text-m3-on-surface-variant space-y-0.5 mb-2">
                      <div class="flex items-center gap-1 truncate">
                        <span class="material-symbols-outlined text-[13px] text-m3-on-surface-variant/70 shrink-0">schedule</span>
                        <span class="truncate">{driver.experience}</span>
                      </div>
                      <div class="flex items-center gap-1 truncate">
                        <span class="material-symbols-outlined text-[13px] text-m3-on-surface-variant/70 shrink-0">translate</span>
                        <span class="truncate">{driver.languages}</span>
                      </div>
                    </div>
                  </div>

                  <!-- WhatsApp Share -->
                  <div class="flex items-center justify-end pt-1 border-t border-m3-outline-variant/60">
                    <a
                      href={`https://wa.me/?text=${waShareText}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Share on WhatsApp"
                      class="flex items-center justify-center w-7 h-7 bg-[#25D366]/10 hover:bg-[#25D366] text-[#25D366] hover:text-white rounded-m3-full transition-all shrink-0 shadow-sm hover:shadow-m3-1 focus-visible:ring-2 focus-visible:ring-[#25D366]"
                      aria-label={`Share ${driver.name} profile on WhatsApp`}
                    >
                      <WhatsAppIcon class="w-3.5 h-3.5" variant="brand" />
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </section>
    </div>
  </main>
</Layout>
