---
import Layout from "../layouts/Layout.astro";
import QuotationEngine from "../components/QuotationEngine.jsx";
import LocalRentalBookingEngine from "../components/LocalRentalBookingEngine.jsx";
import AirportBookingEngine from "../components/AirportBookingEngine.jsx";
import DriverFeeEstimator from "../components/DriverFeeEstimator.jsx";
import VehicleRelocationCalculator from "../components/VehicleRelocationCalculator.jsx";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import tariffConfig from "../data/tariff_config.json";
import {
  Plane,
  Clock,
  Car,
  UserCheck,
  Truck,
  ArrowRight,
  Route,
  ChevronRight,
  CheckCircle2,
  Calculator,
  Info,
  ShieldCheck,
  Check,
  AlertCircle,
  X,
  Phone,
  Star,
} from "lucide-react";
import WhatsAppIcon from "../components/react/WhatsAppIcon.jsx";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Fare Calculator", item: "/calculator/" },
];

const benchmarkFleet = [
  {
    name: "Swift Dzire / Toyota Etios",
    subtitle: "Comfort AC Sedan · 350L Boot",
    capacity: "4 Pax + Driver",
    airportFlat: "₹650 flat",
    key: "Swift Dzire" as keyof typeof tariffConfig.vehicles,
  },
  {
    name: "Maruti Ertiga / XL6",
    subtitle: "Spacious 6-Seater MPV",
    capacity: "6 Pax + Driver",
    airportFlat: "₹1,150 flat",
    key: "Maruti Ertiga" as keyof typeof tariffConfig.vehicles,
  },
  {
    name: "Toyota Innova Crysta",
    subtitle: "VIP Executive Captain Seats",
    capacity: "7 Pax + Driver",
    airportFlat: "₹1,500 flat",
    key: "Innova Crysta" as keyof typeof tariffConfig.vehicles,
  },
  {
    name: "Tempo Traveller (12–14 Seater)",
    subtitle: "Family & Group Pilgrim Van",
    capacity: "12–14 Pax",
    airportFlat: "₹2,400 flat",
    key: "Tempo Traveller" as keyof typeof tariffConfig.vehicles,
  },
];

const webAppSchema = {
  "@type": "WebApplication",
  "@id": "https://kalidasstravels.in/calculator/#calculator-app",
  "name": "Kalidass Travels Fare Calculator & Trip Cost Estimator",
  "url": "https://kalidasstravels.in/calculator/",
  "applicationCategory": "TravelApplication",
  "operatingSystem": "All (Web, Android, iOS, Windows, macOS)",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "softwareVersion": "2.5",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "description": "Instant transparent fare estimators for Outstation Cabs, Chennai Local Hourly Packages, Chennai Airport Taxi, Acting Drivers, and Vehicle Relocation with zero surge pricing.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1250",
    "bestRating": "5",
    "worstRating": "1"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "INR",
    "priceValidUntil": "2027-12-31",
    "lowPrice": "499",
    "highPrice": "35000",
    "offerCount": "24",
    "url": "https://kalidasstravels.in/calculator/",
    "availability": "https://schema.org/InStock"
  },
  "featureList": [
    "Chennai Airport Fixed Zone Flat Tariff Estimator with Flight Delay Tracking",
    "Chennai Local Hourly Rental Packages (4h, 5h, 8h, 10h, 12h) Calculator",
    "Outstation One-Way and Round-Trip Taxi Fare Estimation with Toll Guidelines",
    "Acting Driver Hourly and Daily Duty Fee Calculator",
    "Interstate Vehicle Relocation & Road Transit Cost Estimation",
    "Zero Surge Pricing Transparent Fare Breakdown & FASTag Toll Transparency"
  ]
};

const howToSchema = {
  "@type": "HowTo",
  "@id": "https://kalidasstravels.in/calculator/#howto",
  "name": "How to Calculate Taxi & Outstation Trip Fares in Chennai",
  "description": "Calculate exact travel costs for outstation cabs, Chennai Airport flat rates, local city rentals, and acting drivers without surge pricing.",
  "totalTime": "PT1M",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Select Your Travel Engine",
      "text": "Choose from Airport Taxi (flat zone fare), Local Rental (hourly packages), Outstation Cabs (per-km billing), Acting Drivers, or Vehicle Relocation.",
      "url": "https://kalidasstravels.in/calculator/#airport-taxi-estimator"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Input Origin & Destination or Package Hours",
      "text": "Type your pickup and drop location for point-to-point calculation, or select standard rental durations like 5h/50km or 10h/100km.",
      "url": "https://kalidasstravels.in/calculator/#local-rental-estimator"
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Select Vehicle Class",
      "text": "Pick from Sedan (Dzire/Etios), 6-Seater SUV (Ertiga), Luxury MUV (Innova Crysta), or 12-Seater Tempo Traveller based on your group size.",
      "url": "https://kalidasstravels.in/calculator/#outstation-estimator"
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Review Transparent Estimate & Book",
      "text": "Review transparent rates including base kilometers, driver bata, and toll guidelines with zero surge pricing, then confirm via WhatsApp or phone.",
      "url": "https://kalidasstravels.in/calculator/#acting-driver-estimator"
    }
  ]
};

const faqItems = [
  {
    q: "How is outstation cab fare calculated from Chennai?",
    a: "Outstation cab fare is calculated as: [Total Billable Kilometers × Vehicle Per-KM Rate] + [Calendar Days × Driver Bata] + [Highway Tolls & State Permits at actuals]. For round trips, a standard minimum distance of 250 km per calendar day applies (300 km for Innova Crysta & Tempo Traveller). If you travel 180 km in 1 day, the 250 km minimum applies; if you travel 340 km, you pay for the exact 340 km."
  },
  {
    q: "Does Kalidass Travels charge surge pricing during peak hours or heavy rain?",
    a: "No. Kalidass Travels guarantees 100% Zero Surge Pricing. Unlike app-based taxi aggregators that apply 1.5x–3.0x multiplier rates during rain, late night hours, airport rush, or festivals, our published tariffs remain fixed and transparent 365 days a year."
  },
  {
    q: "How does Chennai Airport flat rate taxi pricing work?",
    a: "Chennai Airport (MAA) taxi fares are based on fixed zone slabs starting from ₹650 for South Chennai (Guindy, Tambaram, Medavakkam), ₹950 for Central Chennai (T. Nagar, Anna Nagar), ₹1,250 for OMR IT Corridor, and ₹1,650 for ECR/Mahabalipuram. Our flat rate includes 60 minutes free waiting time and automated flight delay tracking with zero extra waiting fee."
  },
  {
    q: "What is included in the Chennai Local Hourly Rental Packages?",
    a: "Local hourly packages (such as 5 Hrs / 50 KM from ₹1,500 or 10 Hrs / 100 KM from ₹2,600 for Sedans) include the sanitized air-conditioned vehicle, fuel costs, and chauffeur bata. Any additional usage beyond the package is billed transparently at published extra km (₹15–₹24/km) and extra hour (₹150–₹500/hr) rates."
  },
  {
    q: "Are highway tolls, parking charges, and interstate permits included?",
    a: "Tolls, destination parking fees, and interstate border entry permits (such as crossing into Pondicherry, Andhra Pradesh, Karnataka, or Kerala) are paid at actuals. Tolls are processed transparently via vehicle FASTag with digital pass-through statements to ensure you pay exact government rates."
  },
  {
    q: "How are acting driver fees calculated for personal cars?",
    a: "For city duty within Chennai, acting driver fees start at ₹499 for the first 4 hours, plus ₹99 per additional hour. A night allowance of ₹200 applies between 10:00 PM and 06:00 AM. For outstation trips in your car, outstation driver duty is billed at ₹1,100/day bata + ₹300 food allowance + return public transit ticket for one-way drops."
  },
  {
    q: "Can I get a GST-compliant tax invoice for corporate travel claims?",
    a: "Yes. All trips booked through Kalidass Travels come with verifiable GST tax invoices detailing base rental, fuel, driver allowance, and GST registration number (GSTIN: 33COVPM0531D1Z4), making it 100% eligible for company reimbursement and corporate input tax credit."
  },
  {
    q: "What happens if my incoming flight to Chennai Airport is delayed?",
    a: "We actively track your flight status using the flight number provided during booking. Your pickup chauffeur adjusts arrival timing to match your actual landing time, with up to 60 minutes of complimentary waiting after wheels touch down at no additional charge."
  }
];

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/calculator/#faq",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const serviceSchemas = [
  {
    "@type": "Service",
    "@id": "https://kalidasstravels.in/calculator/#service-airport",
    "name": "Chennai Airport Flat Tariff Taxi Transfers",
    "serviceType": "Airport Taxi Transfer",
    "provider": { "@id": "https://kalidasstravels.in/#localbusiness" },
    "description": "Pre-booked flat zone fares between Chennai International Airport (MAA) and all Chennai neighborhoods starting from ₹650 with flight delay tracking.",
    "offers": {
      "@type": "Offer",
      "price": "650",
      "priceCurrency": "INR"
    }
  },
  {
    "@type": "Service",
    "@id": "https://kalidasstravels.in/calculator/#service-local",
    "name": "Chennai Local Hourly Car Rental Packages",
    "serviceType": "Hourly Car Rental",
    "provider": { "@id": "https://kalidasstravels.in/#localbusiness" },
    "description": "Flexible city hourly car packages (5h/50km, 8h/80km, 10h/100km, 12h/120km) with fuel and chauffeur included starting from ₹1,500.",
    "offers": {
      "@type": "Offer",
      "price": "1500",
      "priceCurrency": "INR"
    }
  },
  {
    "@type": "Service",
    "@id": "https://kalidasstravels.in/calculator/#service-outstation",
    "name": "Outstation Cab Fare Calculation & Booking",
    "serviceType": "Outstation Taxi Service",
    "provider": { "@id": "https://kalidasstravels.in/#localbusiness" },
    "description": "Point-to-point and round-trip outstation cab cost estimation starting from ₹14/km across Tamil Nadu, Pondicherry, Andhra Pradesh, and Karnataka.",
    "offers": {
      "@type": "Offer",
      "price": "14",
      "priceCurrency": "INR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "14",
        "priceCurrency": "INR",
        "unitText": "KM"
      }
    }
  },
  {
    "@type": "Service",
    "@id": "https://kalidasstravels.in/calculator/#service-driver",
    "name": "Acting Driver Services in Chennai",
    "serviceType": "Chauffeur Service",
    "provider": { "@id": "https://kalidasstravels.in/#localbusiness" },
    "description": "Background-verified professional acting drivers for personal cars on hourly city duty or outstation daily bata starting from ₹499.",
    "offers": {
      "@type": "Offer",
      "price": "499",
      "priceCurrency": "INR"
    }
  },
  {
    "@type": "Service",
    "@id": "https://kalidasstravels.in/calculator/#service-relocation",
    "name": "Intercity Vehicle Relocation Service",
    "serviceType": "Vehicle Relocation",
    "provider": { "@id": "https://kalidasstravels.in/#localbusiness" },
    "description": "Professional door-to-door car and SUV driveaway relocation across South India with live GPS tracking and trip insurance.",
    "offers": {
      "@type": "Offer",
      "price": "3500",
      "priceCurrency": "INR"
    }
  }
];
---

<Layout
  title="Chennai Taxi Fare Calculator & Outstation Cab Estimator | Kalidass Travels"
  description="Instant travel cost & taxi fare calculator in Chennai. Transparent rates for outstation cabs (₹14/km), Chennai airport flat fares (₹650), local hourly packages & acting drivers with 100% zero surge pricing."
  ogImage="/og/calculator.jpg"
  keywords="taxi fare calculator chennai, outstation cab fare calculator chennai, travel cost calculator, trip amount calculator, km calculator car rent chennai, local taxi package calculator, chennai airport taxi calculator, acting driver charges calculator, vehicle relocation cost calculator, kalidass travels fare calculator"
  schema={[webAppSchema, howToSchema, faqSchema, ...serviceSchemas]}
>
  <Breadcrumbs items={breadcrumbItems} />
  
  <main class="bg-m3-surface-container-low text-m3-on-surface min-h-screen pt-4 pb-16 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Header & AEO Snapshot -->
      <header class="text-center mb-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-2.5 tracking-wide">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Instant Travel Cost Estimators · Zero Surge Guarantee</span>
        </div>
        
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2 font-heading">
          Chennai Taxi Fare &amp; Outstation Cab <span class="text-m3-primary">Cost Calculator</span>
        </h1>
        
        <p class="text-xs sm:text-sm text-m3-on-surface-variant max-w-2xl mx-auto font-normal leading-relaxed mb-4 font-sans">
          Instant, transparent fare estimates for Chennai airport drops, local city hourly packages, outstation highway trips, acting drivers, and vehicle relocation.
        </p>

      </header>

      <!-- Sticky Quick-Jump Pill Bar (2 Rows) -->
      <nav 
        data-quick-nav 
        aria-label="Calculator Quick Navigation" 
        class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-2 sm:py-2.5 mb-8 -mx-4 sm:-mx-6 lg:-mx-8 px-2 sm:px-6 lg:px-8 transition-all"
      >
        <div class="max-w-7xl mx-auto flex flex-col items-center justify-center gap-1.5 sm:gap-2">
          <!-- Row 1: Airport, Local Package, Outstation -->
          <div class="flex items-center justify-center gap-1.5 sm:gap-2 w-full overflow-x-auto no-scrollbar scroll-px-2 py-0.5" data-quick-nav-container>
            <a 
              href="#airport-taxi-estimator" 
              class="px-3 sm:px-3.5 py-1.5 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs flex items-center gap-1.5 transition-all shrink-0 text-xs border border-m3-outline-variant/30 hover:bg-m3-primary hover:text-white"
              data-active="true"
              aria-current="true"
            >
              <Plane className="w-3.5 h-3.5 shrink-0" />
              <span>Airport Taxi</span>
            </a>
            <a 
              href="#local-rental-estimator" 
              class="px-3 sm:px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high font-medium shadow-xs flex items-center gap-1.5 transition-all shrink-0 text-xs border border-m3-outline-variant/30"
            >
              <Clock className="w-3.5 h-3.5 shrink-0" />
              <span>Local Package</span>
            </a>
            <a 
              href="#outstation-estimator" 
              class="px-3 sm:px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high font-medium shadow-xs flex items-center gap-1.5 transition-all shrink-0 text-xs border border-m3-outline-variant/30"
            >
              <Car className="w-3.5 h-3.5 shrink-0" />
              <span>Outstation Cabs</span>
            </a>
          </div>
          
          <!-- Row 2: Acting Driver, Car Relocation -->
          <div class="flex items-center justify-center gap-1.5 sm:gap-2 w-full overflow-x-auto no-scrollbar scroll-px-2 py-0.5" data-quick-nav-container>
            <a 
              href="#acting-driver-estimator" 
              class="px-3 sm:px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high font-medium shadow-xs flex items-center gap-1.5 transition-all shrink-0 text-xs border border-m3-outline-variant/30"
            >
              <UserCheck className="w-3.5 h-3.5 shrink-0" />
              <span>Acting Drivers</span>
            </a>
            <a 
              href="#vehicle-relocation-estimator" 
              class="px-3 sm:px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high font-medium shadow-xs flex items-center gap-1.5 transition-all shrink-0 text-xs border border-m3-outline-variant/30"
            >
              <Truck className="w-3.5 h-3.5 shrink-0" />
              <span>Car Relocation</span>
            </a>
          </div>
        </div>
      </nav>

      <!-- Pure Engines Dashboard (Direct Side-by-Side 2-Column Grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start mb-16">
        
        {/* 1. Chennai Airport Taxi Engine */}
        <section id="airport-taxi-estimator" class="w-full flex justify-center scroll-mt-40" aria-label="Chennai Airport Taxi Estimator">
          <AirportBookingEngine client:load showHeader={true} enableStickyBar={false} />
        </section>

        {/* 2. Local City Rental Engine */}
        <section id="local-rental-estimator" class="w-full flex justify-center scroll-mt-40" aria-label="Local City Rental Estimator">
          <LocalRentalBookingEngine
            client:load
            showHeader={true}
            title="Chennai Local City Rental"
          />
        </section>

        {/* 3. Outstation Cab Engine */}
        <section id="outstation-estimator" class="w-full flex justify-center scroll-mt-40" aria-label="Outstation Cab Estimator">
          <QuotationEngine
            client:load
            initialTab="oneway"
            allowedTabs={['oneway', 'round']}
            title="Outstation Cab Estimator"
            subtitle="One-Way Drop & Round-Trip • Transparent Per-KM Rates"
            headerIcon="car"
            variant="card"
            showAirportTab={false}
          />
        </section>

        {/* 4. Acting Driver Engine */}
        <section id="acting-driver-estimator" class="w-full flex justify-center scroll-mt-40" aria-label="Acting Driver Estimator">
          <DriverFeeEstimator
            client:load
            title="Acting Driver Estimator"
            subtitle="Hourly City Duty & Outstation Daily Bata"
          />
        </section>

        {/* 5. Intercity Vehicle Relocation Engine */}
        <section id="vehicle-relocation-estimator" class="w-full flex justify-center lg:col-span-2 scroll-mt-40 pt-2" aria-label="Vehicle Relocation Estimator">
          <div class="w-full max-w-4xl mx-auto">
            <VehicleRelocationCalculator client:load />
          </div>
        </section>

      </div>

      <!-- AEO Direct Answer Box (Google AI Overviews & Answer Engine Optimization) -->
      <section 
        class="max-w-4xl mx-auto text-left bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-5 sm:p-6 shadow-m3-1 mb-16 scroll-mt-36"
        aria-label="Overview & Direct Fare Formula"
        data-speakable="true"
      >
        <div class="flex items-start gap-3.5">
          <div class="w-9 h-9 rounded-m3-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
            <CheckCircle2 className="w-5 h-5 text-emerald-600" />
          </div>
          <div class="flex-1">
            <h2 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
              <span>Quick Answer: How are Taxi &amp; Outstation Fares Calculated in Chennai?</span>
            </h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant font-normal leading-relaxed">
              In Chennai, commercial taxi fares consist of three transparent components: 
              <strong class="text-m3-on-surface font-semibold">1) Base Billable Distance</strong> (from ₹14/km for Sedans with standard 250 km/day calendar rule for outstation), 
              <strong class="text-m3-on-surface font-semibold">2) Daily Chauffeur Bata</strong> (₹300–₹800/day depending on vehicle class for outstation, or fully included in local packages), and 
              <strong class="text-m3-on-surface font-semibold">3) Highway Tolls &amp; State Taxes</strong> passed through at actuals via FASTag. Kalidass Travels guarantees <strong class="text-emerald-700 font-semibold">100% Zero Surge Pricing</strong> 365 days a year with official GST invoices.
            </p>
            <div class="mt-3 pt-3 border-t border-m3-outline-variant/50 flex flex-wrap items-center justify-between gap-2 text-micro sm:text-xs">
              <span class="inline-flex items-center gap-1 font-mono bg-m3-surface-container-high px-2.5 py-1 rounded text-m3-on-surface font-semibold">
                <span>Formula: Total = (KM × Rate) + (Days × Bata) + Tolls</span>
              </span>
              <span class="text-m3-on-surface-variant flex items-center gap-1">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Verified 2026 Rates · GSTIN: 33COVPM0531D1Z4</span>
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 1: Machine-Readable Quick Fare Reference Matrix (AEO & SERP Table) -->
      <section class="mb-16 scroll-mt-36" aria-labelledby="fare-matrix-heading">
        <div class="text-center max-w-3xl mx-auto mb-8">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-2.5 tracking-wide">
            <span class="w-2 h-2 rounded-full bg-m3-primary"></span>
            <span>2026 Official Commercial Tariff Benchmarks</span>
          </div>
          <h2 id="fare-matrix-heading" class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2 font-heading">
            Chennai Taxi &amp; Cab <span class="text-m3-primary">Fare Benchmark Matrix</span>
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant font-normal leading-relaxed max-w-2xl mx-auto font-sans">
            Reference table of official commercial vehicle rates across airport flat transfers, Chennai hourly city packages, and outstation per-kilometer tariffs.
          </p>
        </div>

        <div class="overflow-x-auto rounded-m3-xl shadow-m3-1 border border-m3-outline-variant bg-m3-surface">
          <table class="w-full text-left font-sans text-xs sm:text-sm">
            <caption class="sr-only">Official Chennai Taxi Fare Benchmark Rates for 2026</caption>
            <thead class="bg-m3-surface-container-high text-m3-on-surface text-micro sm:text-xs font-bold uppercase tracking-wider border-b border-m3-outline-variant">
              <tr>
                <th scope="col" class="px-4 py-3.5">Vehicle Category</th>
                <th scope="col" class="px-3 py-3.5 text-center">Capacity</th>
                <th scope="col" class="px-3 py-3.5 text-center">Airport (MAA) From</th>
                <th scope="col" class="px-3 py-3.5 text-center">Local (5h / 50km)</th>
                <th scope="col" class="px-3 py-3.5 text-center">Local (10h / 100km)</th>
                <th scope="col" class="px-3 py-3.5 text-center">Outstation Per KM</th>
                <th scope="col" class="px-3 py-3.5 text-center">Driver Bata / Day</th>
                <th scope="col" class="px-3 py-3.5 text-right">Surge Fee</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-m3-outline-variant/40">
              {benchmarkFleet.map((row, idx) => {
                const v = tariffConfig.vehicles[row.key];
                return (
                  <tr class={idx % 2 === 1 ? "bg-m3-surface-container-lowest hover:bg-m3-surface-container-low transition-colors" : "hover:bg-m3-surface-container-low transition-colors"}>
                    <th scope="row" class="px-4 py-3 font-bold text-m3-on-surface flex flex-col">
                      <span>{row.name}</span>
                      <span class="text-[10px] text-m3-on-surface-variant font-normal">{row.subtitle}</span>
                    </th>
