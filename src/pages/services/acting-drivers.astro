<Layout 
  title={`${title} | Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/acting-drivers.webp"
  ogImage="/og/acting-drivers.jpg"
  schema={[chauffeurServiceSchema, productSchema, howToSchema, faqSchema, tariffListSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">

      <!-- TOP PAGE HEADING & TRUST BADGES -->
      <div class="max-w-2xl mx-auto mb-2 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant text-m3-on-surface text-[10px] font-bold mb-1">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            <span>100% Police Verified (PVC) Chauffeurs</span>
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface font-heading tracking-tight leading-tight">
            Hire An Acting Driver For Your Own Car
          </h1>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant font-medium mt-0.5">
            Manual, Automatic &amp; EV certified • Doorstep arrival in 30–45 mins • 0% advance
          </p>
        </div>
        <div class="flex items-center justify-center sm:justify-end gap-2 shrink-0">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-m3-full bg-m3-surface-container-lowest border border-m3-outline-variant shadow-2xs text-xs font-semibold text-m3-on-surface">
            <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <span>4.9/5 Rating (1,280+ Trips)</span>
          </span>
        </div>
      </div>

      <!-- 1. FIRST SECTION: INTERACTIVE COST CALCULATOR & BOOKING TOOL -->
      <div id="trip-estimator" class="scroll-mt-28 max-w-2xl mx-auto mb-4">
        <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 overflow-hidden">
          <div class="bg-m3-surface">
            <DriverFeeEstimator 
              client:load
              title="Acting Driver Cost Calculator"
              subtitle="Bata · Food · Stay · Return Bus Ticket"
              embedded={true}
            />
          </div>
        </div>

        <!-- Trust Reassurance Footer Strip -->
        <div class="mt-2 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-[11px] text-m3-on-surface-variant font-medium">
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <span class="font-bold text-m3-on-surface">Zero Advance Required — Pay After Trip</span>
