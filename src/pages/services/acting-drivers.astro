  <script is:inline>
    function handleActingDriverHash() {
      if (window.location.hash) {
        const target = document.querySelector(window.location.hash);
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth' });
          }, 100);
        }
      }
    }

    // 4. Chauffeur Dispatch Intake Modal Logic
    let openChauffeurIntakeModal = null;

    function initChauffeurIntakeDialog() {
      const dialog = document.getElementById('chauffeur-intake-dialog');
      if (!dialog) return;

      const closeBtn = document.getElementById('intake-close-btn');
      const submitBtn = document.getElementById('intake-submit-btn');
      const skipBtn = document.getElementById('intake-skip-btn');
      const pkgTitle = document.getElementById('intake-package-title');
      const pkgSubtitle = document.getElementById('intake-package-subtitle');
      const pkgFare = document.getElementById('intake-package-fare');
      const carInput = document.getElementById('intake-car-model');
      const carChips = document.querySelectorAll('.car-chip');
      const gearBtns = document.querySelectorAll('.gear-select-btn');
      const dateInput = document.getElementById('intake-travel-date');
      const timeSelect = document.getElementById('intake-pickup-time');
      const pickupInput = document.getElementById('intake-pickup-address');
      const dropInput = document.getElementById('intake-drop-address');
      const dropLabel = document.getElementById('intake-drop-label');

      let currentBooking = {
        service: 'Outstation One-Way Drop',
        route: 'Chennai → Pondicherry (151 km)',
        fare: '₹1,600',
        directHref: 'https://wa.me/918939539211?text=Hi%20Kalidass%20Travels'
      };

      let selectedGear = 'Manual (MT)';

      // Handle Gear Selection
      gearBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          gearBtns.forEach(b => {
            b.setAttribute('aria-checked', 'false');
            b.classList.remove('border-2', 'border-m3-primary', 'bg-m3-primary/10', 'text-m3-primary', 'font-bold');
            b.classList.add('border', 'border-m3-outline-variant', 'bg-m3-surface', 'text-m3-on-surface', 'font-semibold');
          });
          btn.setAttribute('aria-checked', 'true');
          btn.classList.remove('border', 'border-m3-outline-variant', 'bg-m3-surface', 'text-m3-on-surface', 'font-semibold');
          btn.classList.add('border-2', 'border-m3-primary', 'bg-m3-primary/10', 'text-m3-primary', 'font-bold');
          selectedGear = btn.getAttribute('data-gear') || 'Manual (MT)';
        });
      });

      // Handle Car Chips
      carChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const chipVal = chip.getAttribute('data-chip');
          if (carInput && chipVal) {
            carInput.value = chipVal;
            carChips.forEach(c => c.classList.remove('border-m3-primary', 'text-m3-primary', 'bg-m3-primary/10'));
            chip.classList.add('border-m3-primary', 'text-m3-primary', 'bg-m3-primary/10');
          }
        });
      });

      // Close handlers
      if (closeBtn) {
        closeBtn.addEventListener('click', () => dialog.close());
      }

      // Backdrop click light dismiss
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          dialog.close();
        }
      });

      // Skip button: Opens basic WhatsApp directly
      if (skipBtn) {
        skipBtn.addEventListener('click', () => {
          dialog.close();
          window.open(currentBooking.directHref, '_blank');
        });
      }

      // Submit button: builds comprehensive dispatch dossier
      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          const car = (carInput?.value || '').trim() || 'Personal Car (Sedan / Hatch / SUV)';
          const dateVal = dateInput?.value || '';
          let formattedDate = 'Today / Tomorrow';
          if (dateVal) {
            try {
              const parts = dateVal.split('-');
              if (parts.length === 3) {
                const dt = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                formattedDate = dt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
              }
            } catch (e) {
              formattedDate = dateVal;
            }
          }
          const timeVal = timeSelect?.value || '06:00 AM';
          const pickupVal = (pickupInput?.value || '').trim() || 'Chennai (Address to share)';
          const dropVal = (dropInput?.value || '').trim() || currentBooking.route;

          const fullMessage = 
            `Hi Kalidass Travels, I would like to book an Acting Driver:\n\n` +
            `📋 BOOKING DETAILS:\n` +
            `• Service: ${currentBooking.service}\n` +
            `• Package / Route: ${currentBooking.route}\n` +
            `• Quoted Rate: ${currentBooking.fare}\n\n` +
            `🚗 VEHICLE DETAILS:\n` +
            `• Car Model: ${car}\n` +
            `• Transmission / Gear: ${selectedGear}\n\n` +
            `📅 SCHEDULE & REPORTING:\n` +
            `• Travel Date: ${formattedDate}\n` +
            `• Reporting Time: ${timeVal}\n\n` +
            `📍 TRIP LOCATIONS:\n` +
            `• Pickup Area: ${pickupVal}\n` +
            `• Drop / Notes: ${dropVal}\n\n` +
            `Please assign a police-verified chauffeur and confirm driver details.`;

          dialog.close();
          const targetUrl = `https://wa.me/918939539211?text=${encodeURIComponent(fullMessage)}`;
          window.open(targetUrl, '_blank');
        });
      }

      // Global opener
      openChauffeurIntakeModal = function(data) {
        currentBooking = data;
        if (pkgTitle) pkgTitle.textContent = data.service || 'Acting Driver';
        if (pkgSubtitle) pkgSubtitle.textContent = data.route || '';
        if (pkgFare) pkgFare.textContent = data.fare || '';
        if (dropInput) dropInput.value = data.dropDefault || '';
        if (dropLabel) dropLabel.textContent = data.dropLabel || 'Drop Destination / Landmark';

        // Set default date to Tomorrow
        if (dateInput && !dateInput.value) {
          const tomorrow = new Date();
          tomorrow.setDate(tomorrow.getDate() + 1);
          const yyyy = tomorrow.getFullYear();
          const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
          const dd = String(tomorrow.getDate()).padStart(2, '0');
          dateInput.value = `${yyyy}-${mm}-${dd}`;
        }

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      };
    }

    // 1. Card 1: City Metro Duty Option Selection (4h vs 8h)
    function initCityCardSelection() {
      const options = document.querySelectorAll('[data-city-option]');
      const waBtn = document.getElementById('city-card-whatsapp-btn');
      const hint = document.getElementById('city-selection-hint');
      let selectedOption = null;

      options.forEach(opt => {
        opt.addEventListener('click', () => {
          // Clear shake/warning from all options immediately
          options.forEach(o => {
            o.classList.remove('animate-option-shake', 'ring-amber-500/50');
            o.setAttribute('aria-checked', 'false');
            o.classList.remove('border-m3-primary', 'ring-2', 'ring-m3-primary/30', 'bg-m3-primary/5', 'shadow-xs');
            o.classList.add('border-m3-outline-variant/70', 'bg-m3-surface');
            const dot = o.querySelector('.city-radio-dot');
            if (dot) {
              dot.classList.remove('scale-100');
              dot.classList.add('scale-0');
            }
            const circle = o.querySelector('.city-radio-circle');
            if (circle) {
              circle.classList.remove('border-m3-primary', 'bg-m3-primary/10');
              circle.classList.add('border-m3-outline');
            }
          });

          opt.setAttribute('aria-checked', 'true');
          opt.classList.remove('border-m3-outline-variant/70', 'bg-m3-surface');
          opt.classList.add('border-m3-primary', 'ring-2', 'ring-m3-primary/30', 'bg-m3-primary/5', 'shadow-xs');
          const dot = opt.querySelector('.city-radio-dot');
          if (dot) {
            dot.classList.remove('scale-0');
            dot.classList.add('scale-100');
          }
          const circle = opt.querySelector('.city-radio-circle');
          if (circle) {
            circle.classList.remove('border-m3-outline');
            circle.classList.add('border-m3-primary', 'bg-m3-primary/10');
          }

          selectedOption = opt;
          const msg = opt.getAttribute('data-msg') || 'Hi Kalidass Travels, I want to book a City Acting Driver in Chennai.';
          if (waBtn) {
            waBtn.href = `https://wa.me/918939539211?text=${encodeURIComponent(msg)}`;
          }
          if (hint) {
            hint.classList.add('hidden');
          }
        });
      });

      if (waBtn) {
        waBtn.addEventListener('click', e => {
          if (!selectedOption) {
            e.preventDefault();
            if (hint) {
              hint.classList.remove('hidden');
              hint.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            options.forEach(o => {
              o.classList.add('animate-option-shake', 'ring-2', 'ring-amber-500/50');
              setTimeout(() => {
                o.classList.remove('animate-option-shake', 'ring-2', 'ring-amber-500/50');
              }, 400);
            });
            return;
          }

          // Option selected: open intake modal
          e.preventDefault();
          const pkgName = selectedOption.getAttribute('data-name') || 'Within Chennai Metro';
          const pkgRate = selectedOption.getAttribute('data-rate') || '₹500';
          if (typeof openChauffeurIntakeModal === 'function') {
            openChauffeurIntakeModal({
              service: 'Within Chennai Metro (Local Duty)',
              route: pkgName,
              fare: pkgRate,
              dropLabel: 'Local Destination / Errand Notes',
              dropDefault: 'Multi-stop errands across Chennai',
              directHref: waBtn.href
            });
          } else {
            window.open(waBtn.href, '_blank');
          }
        });
      }
    }

    // 2. Card 2: Outstation One-Way Drop Route Selection
    function initOnewayCardSelection() {
      const options = document.querySelectorAll('[data-oneway-option]');
      const waBtn = document.getElementById('oneway-card-whatsapp-btn');
      const hint = document.getElementById('oneway-selection-hint');
      let selectedOption = null;

      options.forEach(opt => {
        opt.addEventListener('click', () => {
          options.forEach(o => {
            o.classList.remove('animate-option-shake', 'ring-amber-500/50');
            o.setAttribute('aria-checked', 'false');
            o.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/30', 'bg-amber-500/10', 'shadow-xs');
            o.classList.add('border-m3-outline-variant/60', 'bg-m3-surface/60');
            const dot = o.querySelector('.oneway-radio-dot');
            if (dot) {
              dot.classList.remove('scale-100');
              dot.classList.add('scale-0');
            }
            const circle = o.querySelector('.oneway-radio-circle');
            if (circle) {
              circle.classList.remove('border-amber-500', 'bg-amber-500/10');
              circle.classList.add('border-m3-outline');
            }
          });

          opt.setAttribute('aria-checked', 'true');
          opt.classList.remove('border-m3-outline-variant/60', 'bg-m3-surface/60');
          opt.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/30', 'bg-amber-500/10', 'shadow-xs');
          const dot = opt.querySelector('.oneway-radio-dot');
          if (dot) {
            dot.classList.remove('scale-0');
            dot.classList.add('scale-100');
          }
          const circle = opt.querySelector('.oneway-radio-circle');
          if (circle) {
            circle.classList.remove('border-m3-outline');
            circle.classList.add('border-amber-500', 'bg-amber-500/10');
          }

          selectedOption = opt;
          const msg = opt.getAttribute('data-msg') || 'Hi Kalidass Travels, I need a One-Way Acting Driver from Chennai.';
          if (waBtn) {
            waBtn.href = `https://wa.me/918939539211?text=${encodeURIComponent(msg)}`;
          }
          if (hint) {
            hint.classList.add('hidden');
          }
        });
      });

      if (waBtn) {
        waBtn.addEventListener('click', e => {
          if (!selectedOption) {
            e.preventDefault();
            if (hint) {
              hint.classList.remove('hidden');
              hint.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            options.forEach(o => {
              o.classList.add('animate-option-shake', 'ring-2', 'ring-amber-500/50');
              setTimeout(() => {
                o.classList.remove('animate-option-shake', 'ring-2', 'ring-amber-500/50');
              }, 400);
            });
            return;
          }

          // Option selected: open intake modal
          e.preventDefault();
          const route = selectedOption.getAttribute('data-route') || 'Chennai → Outstation';
          const dest = selectedOption.getAttribute('data-dest') || 'Outstation City';
          const fare = selectedOption.getAttribute('data-total') || 'Standard Rate';
          if (typeof openChauffeurIntakeModal === 'function') {
            openChauffeurIntakeModal({
              service: 'Outstation One-Way Drop',
              route: route,
              fare: fare,
              dropLabel: 'Drop Destination / Address',
              dropDefault: dest,
              directHref: waBtn.href
            });
          } else {
            window.open(waBtn.href, '_blank');
          }
        });
      }
    }

    // 3. Card 3: Outstation Round Trip Vehicle Selection + Dynamic Preferences
    function initRoundTripCardPricing() {
      const foodCheck = document.getElementById('card-food-provided');
      const stayCheck = document.getElementById('card-stay-provided');
      const rateEls = document.querySelectorAll('.round-trip-rate');
      const statusBadge = document.getElementById('round-status-badge');
      const summaryNote = document.getElementById('round-summary-note');
      const waBtn = document.getElementById('round-trip-whatsapp-btn');
      const hint = document.getElementById('round-selection-hint');
      const vehicleOptions = document.querySelectorAll('[data-round-option]');
      let selectedVehicle = null;

      function updateRates() {
        if (!foodCheck || !stayCheck) return;
        const foodProvided = foodCheck.checked;
        const stayProvided = stayCheck.checked;

        const foodAdd = foodProvided ? 0 : 300;
        const stayAdd = stayProvided ? 0 : 300;
        const totalAdd = foodAdd + stayAdd;

        rateEls.forEach(el => {
          const base = parseInt(el.getAttribute('data-base-bata'), 10) || 1100;
          const finalRate = base + totalAdd;
          el.textContent = `₹${finalRate.toLocaleString('en-IN')} / day`;
        });

        let prefBadge = 'All-Inclusive (Bata + Food + Stay)';
        if (foodProvided && stayProvided) {
          prefBadge = 'Pure Driver Bata (₹0 Food & Stay)';
          if (statusBadge) {
            statusBadge.textContent = prefBadge;
            statusBadge.className = 'px-2.5 py-0.5 rounded-m3-full text-[10px] font-bold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 shrink-0';
          }
          if (summaryNote) summaryNote.textContent = '• Meals & dorm arranged with family/hotel';
        } else if (!foodProvided && stayProvided) {
          prefBadge = 'Bata + Food Included';
          if (statusBadge) {
            statusBadge.textContent = prefBadge;
            statusBadge.className = 'px-2.5 py-0.5 rounded-m3-full text-[10px] font-bold bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/20 shrink-0';
          }
          if (summaryNote) summaryNote.textContent = '• Includes ₹300/day food allowance';
        } else if (foodProvided && !stayProvided) {
          prefBadge = 'Bata + Lodge Stay Included';
          if (statusBadge) {
            statusBadge.textContent = prefBadge;
            statusBadge.className = 'px-2.5 py-0.5 rounded-m3-full text-[10px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 shrink-0';
          }
          if (summaryNote) summaryNote.textContent = '• Includes ₹300/night lodge allowance';
        } else {
          prefBadge = 'All-Inclusive (Bata + Food + Stay)';
          if (statusBadge) {
            statusBadge.textContent = prefBadge;
            statusBadge.className = 'px-2.5 py-0.5 rounded-m3-full text-[10px] font-bold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20 shrink-0';
          }
          if (summaryNote) summaryNote.textContent = '• All-inclusive (Food + Lodge stay covered)';
        }

        const foodDesc = foodProvided ? 'Food arranged by passenger (₹0)' : 'Driver food allowance included (+₹300/day)';
        const stayDesc = stayProvided ? 'Stay/dorm arranged by passenger (Hotel Dorm ₹0)' : 'Driver night lodge allowance included (+₹300/night)';

        let msg = '';
        if (selectedVehicle) {
          const vName = selectedVehicle.getAttribute('data-vehicle') || 'Hatchback & Sedan';
          const baseBata = parseInt(selectedVehicle.getAttribute('data-base-bata'), 10) || 1100;
          const finalVehicleRate = baseBata + totalAdd;
          msg = `Hi Kalidass Travels, I need an Outstation Round Trip Acting Driver from Chennai:\n• Vehicle: ${vName} (₹${finalVehicleRate.toLocaleString('en-IN')}/day)\n• Passenger Preferences: ${prefBadge}\n  - Food: ${foodDesc}\n  - Stay: ${stayDesc}\n• Total Daily Rate: ₹${finalVehicleRate.toLocaleString('en-IN')}/day\nPlease confirm driver availability.`;
        } else {
          msg = `Hi Kalidass Travels, I need an Outstation Round Trip Acting Driver from Chennai:\n• Passenger Preferences: ${prefBadge}\n  - Food: ${foodDesc}\n  - Stay: ${stayDesc}\nPlease share vehicle options and quote.`;
        }

        if (waBtn) {
          waBtn.href = `https://wa.me/918939539211?text=${encodeURIComponent(msg)}`;
        }
      }

      vehicleOptions.forEach(opt => {
        opt.addEventListener('click', () => {
          vehicleOptions.forEach(o => {
            o.classList.remove('animate-option-shake', 'ring-amber-500/50');
            o.setAttribute('aria-checked', 'false');
            o.classList.remove('border-m3-primary', 'ring-2', 'ring-m3-primary/30', 'bg-m3-primary/5', 'shadow-xs');
            o.classList.add('border-m3-outline-variant/60', 'bg-m3-surface/60');
            const dot = o.querySelector('.round-radio-dot');
            if (dot) {
              dot.classList.remove('scale-100');
              dot.classList.add('scale-0');
            }
            const circle = o.querySelector('.round-radio-circle');
            if (circle) {
              circle.classList.remove('border-m3-primary', 'bg-m3-primary/10');
              circle.classList.add('border-m3-outline');
            }
          });

          opt.setAttribute('aria-checked', 'true');
          opt.classList.remove('border-m3-outline-variant/60', 'bg-m3-surface/60');
          opt.classList.add('border-m3-primary', 'ring-2', 'ring-m3-primary/30', 'bg-m3-primary/5', 'shadow-xs');
          const dot = opt.querySelector('.round-radio-dot');
          if (dot) {
            dot.classList.remove('scale-0');
            dot.classList.add('scale-100');
          }
          const circle = opt.querySelector('.round-radio-circle');
          if (circle) {
            circle.classList.remove('border-m3-outline');
            circle.classList.add('border-m3-primary', 'bg-m3-primary/10');
          }

          selectedVehicle = opt;
          if (hint) {
            hint.classList.add('hidden');
          }
          updateRates();
        });
      });

      if (waBtn) {
        waBtn.addEventListener('click', e => {
          updateRates();
          if (!selectedVehicle) {
            e.preventDefault();
            if (hint) {
              hint.classList.remove('hidden');
              hint.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            vehicleOptions.forEach(o => {
              o.classList.add('animate-option-shake', 'ring-2', 'ring-amber-500/50');
              setTimeout(() => {
                o.classList.remove('animate-option-shake', 'ring-2', 'ring-amber-500/50');
              }, 400);
            });
            return;
          }

          // Option selected: open intake modal
          e.preventDefault();
          const vName = selectedVehicle.getAttribute('data-vehicle') || 'Hatchback & Sedan';
          const rateEl = selectedVehicle.querySelector('.round-trip-rate');
          const currentRate = rateEl ? rateEl.textContent.trim() : '₹1,400 / day';
          const prefText = statusBadge ? statusBadge.textContent.trim() : 'Bata + Food Included';

          if (typeof openChauffeurIntakeModal === 'function') {
            openChauffeurIntakeModal({
              service: 'Outstation Round Trip',
              route: `${vName} (${prefText})`,
              fare: currentRate,
              dropLabel: 'Outstation Destination(s)',
              dropDefault: '',
              directHref: waBtn.href
            });
          } else {
            window.open(waBtn.href, '_blank');
          }
        });
      }

      if (foodCheck && stayCheck) {
        ['change', 'input', 'click'].forEach(evt => {
          foodCheck.addEventListener(evt, updateRates);
          stayCheck.addEventListener(evt, updateRates);
        });
      }
      updateRates();
    }

    function initActingDriverCards() {
      handleActingDriverHash();
      initChauffeurIntakeDialog();
      initCityCardSelection();
      initOnewayCardSelection();
      initRoundTripCardPricing();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initActingDriverCards);
    } else {
      initActingDriverCards();
    }
  </script>
</Layout>
