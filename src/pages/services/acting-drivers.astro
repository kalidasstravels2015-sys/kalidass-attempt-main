          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">Zero Advance</div>
            <div class="text-[10px] text-m3-on-surface-variant">Pay post-trip via UPI</div>
          </div>
        </div>
        <div class="flex items-center gap-2.5 p-3 rounded-m3-xl bg-m3-surface-container-lowest border border-m3-outline-variant shadow-xs">
          <div class="w-8 h-8 rounded-m3-md bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400 flex items-center justify-center shrink-0">
