---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import DriverFeeEstimator from '../../components/DriverFeeEstimator.jsx';
import OptimizedImage from '../../components/OptimizedImage.astro';
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import HeroVisualCard from '../../components/HeroVisualCard.astro';
import { Phone } from 'lucide-react';

const title = "Hire Acting Drivers in Chennai & Tamil Nadu from ₹750";
const description = "Hire verified acting drivers in Chennai & across Tamil Nadu for personal cars (MT/AT/EV). City duty from ₹750, outstation from ₹1,400/day. All 38 districts covered with ₹500 advance to confirm.";
const keywords = "acting driver in chennai, acting driver tamil nadu, call driver chennai, outstation acting driver tamil nadu, hire acting driver chennai, driver for personal car chennai, acting driver coimbatore madurai trichy salem, one way acting driver chennai, hourly driver chennai, acting driver charges chennai, acting driver automatic car chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Acting Drivers", item: "/services/acting-drivers/" },
];

const cityTariff = [
  {
    name: "City Short Duty (4 Hours)",
    hours: "4 Hours Continuous",
    rate: "₹750",
    extra: "₹120 / extra hour",
    idealFor: "Doctor visits, shopping in T. Nagar, airport pickup/drop, local errands",
    whatsappMsg: "Hi Kalidass Travels, I want to book a 4-Hour City Acting Driver (₹750) in Chennai."
  },
  {
    name: "City Full Day Duty (8 Hours)",
    hours: "8 Hours Continuous",
    rate: "₹1,200",
    extra: "₹120 / extra hour",
    idealFor: "Family functions, multi-stop office meetings, full-day shopping, wedding duties",
    whatsappMsg: "Hi Kalidass Travels, I want to book an 8-Hour Full Day City Acting Driver (₹1,200) in Chennai."
  }
];

const outstationTariff = [
  {
    vehicle: "Hatchback & Sedan",
    examples: "Dzire, Etios, Honda City, Verna, Baleno",
    baseBata: 1400,
    rate: "₹1,700 / day",
    total: "₹1,700 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Sedan (₹1,700/day with driver meals included)."
  },
  {
    vehicle: "Compact SUV / MPV",
    examples: "Ertiga, Creta, Seltos, Carens, XL6",
    baseBata: 1500,
    rate: "₹1,800 / day",
    total: "₹1,800 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my SUV (₹1,800/day with driver meals included)."
  },
  {
    vehicle: "Premium SUV / MUV",
    examples: "Innova Crysta, Fortuner, Safari, XUV700",
    baseBata: 1600,
    rate: "₹1,900 / day",
    total: "₹1,900 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Innova Crysta (₹1,900/day with driver meals included)."
  },
  {
    vehicle: "Luxury European",
    examples: "BMW, Mercedes-Benz, Audi, Volvo",
    baseBata: 1900,
    rate: "₹2,200 / day",
    total: "₹2,200 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Luxury Car (₹2,200/day with driver meals included)."
  }
];

const onewayDropTariff = [
  {
    route: "Chennai → Pondicherry (151 km)",
    dest: "Puducherry / Auroville",
    breakdown: "₹1,400 Bata + ₹200 SETC Bus + ₹300 Food",
    total: "₹1,900",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Pondicherry (₹1,900)."
  },
  {
    route: "Chennai → Bangalore (346 km)",
    dest: "Bengaluru / Hosur (251–450 km)",
    breakdown: "₹2,100 (1.5d Bata) + ₹420 SETC Bus + ₹300 Food",
    total: "₹2,820",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Bangalore (₹2,820)."
  },
  {
    route: "Chennai → Trichy (332 km)",
    dest: "Tiruchirappalli / Thanjavur (251–450 km)",
    breakdown: "₹2,100 (1.5d Bata) + ₹370 SETC Bus + ₹300 Food",
    total: "₹2,770",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Trichy (₹2,770)."
  },
  {
    route: "Chennai → Madurai (462 km)",
    dest: "Madurai / Dindigul (451–650 km)",
    breakdown: "₹2,800 (2d Bata) + ₹500 SETC Bus + ₹450 Food",
    total: "₹3,750",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Madurai (₹3,750)."
  },
  {
    route: "Chennai → Coimbatore (505 km)",
    dest: "Coimbatore / Tirupur (451–650 km)",
    breakdown: "₹2,800 (2d Bata) + ₹550 SETC Bus + ₹450 Food",
    total: "₹3,800",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Coimbatore (₹3,800)."
  }
];

const faqs = [
  {
    q: "How quickly can an acting driver report to my location in Chennai?",
    a: "We recommend booking 1 to 2 hours in advance. For emergency requirements, our dispatch desk connects you with the nearest police-verified chauffeur within 30 to 45 minutes across all Chennai zones (Anna Nagar, T. Nagar, Adyar, Velachery, OMR, Porur, and Tambaram)."
  },
  {
    q: "Do you provide acting drivers across all districts of Tamil Nadu and outstation destinations?",
    a: "Yes! Kalidass Travels provides police-verified acting drivers across all 38 districts of Tamil Nadu for personal cars. Whether you need a driver for a one-way car relocation from Chennai to Coimbatore, Madurai, or Trichy, a round-trip temple tour across Thanjavur and Kumbakonam, or a vacation to hill stations like Ooty and Kodaikanal (hairpin bend and ghat-road certified), our drivers are available with ₹500 advance deposit (100% deducted from bill). We also cover interstate trips to Puducherry, Bangalore, and Tirupati."
  },
  {
    q: "Are your drivers trained for Automatic, EV, and Luxury cars?",
    a: "Yes. Every driver assigned to automatic or electric vehicles is specifically vetted on Torque Converter, CVT, Dual-Clutch (DCT/DSG), AMT, and EV drivetrains (Tata.ev, MG ZS EV, BYD). We also maintain specialist chauffeurs certified for luxury marques including Mercedes-Benz, BMW, Audi, Volvo, and Innova Crysta."
  },
  {
    q: "How are Outstation One-Way Drop acting driver rates calculated?",
    a: "Outstation One-Way Drop follows our transparent 4-tier distance formula: Driver Bata (1.0x up to 250 km, 1.5x for 251–450 km, 2.0x for 451–650 km, 2.5x above 650 km) + Return AC/Sleeper Bus Ticket + Food Allowance (₹300 up to 450 km, ₹450 for 451–650 km, ₹600 above 650 km). This fairly compensates the chauffeur for both driving hours and overnight return bus travel. Fuel and FASTag highway tolls in your car are paid directly by you."
  },
  {
    q: "What are the driver food and accommodation rules for outstation trips?",
    a: "Our outstation acting driver tariff (from ₹1,700/day) already includes the ₹300/day driver food allowance, so our chauffeurs independently manage their own meals. The driver will NEVER ask you for food or cash during the trip. If you prefer to invite the driver to eat with your family at highway halts, let our booking desk know to waive the food allowance (reducing the rate to the base bata of ₹1,400/day). For night stay: Under Tamil Nadu Hotel Regulations (TNCDBR), hotels and resorts provide free driver dormitories and washrooms (₹0). If your private stay (such as a farm house or Airbnb) has no dorm, a modest ₹300/night lodging allowance applies so the driver rests safely."
  },
  {
    q: "Is there any government-fixed tariff for acting drivers in Tamil Nadu?",
    a: "No. Unlike auto-rickshaw meter fares, the Tamil Nadu Transport Department does not fix statutory customer tariffs for acting drivers. Pricing is governed by competitive market standards and driver welfare guidelines. However, drivers are legally recognized semi-skilled workers under Tamil Nadu labour laws, and hotels across the state are mandated by the 2023 building rules amendment to provide driver accommodation facilities."
  },
  {
    q: "Are drivers background-checked and police-verified?",
    a: "Yes, 100% of our drivers hold verified Police Clearance Certificates (PVC), valid commercial transport badges, and clean driving records with zero criminal history. A digital chauffeur profile with photo ID is shared on WhatsApp prior to arrival."
  },
  {
    q: "Who pays for fuel, toll plaza FASTag fees, and parking charges?",
    a: "Since the driver operates your personal vehicle, fuel, FASTag highway toll charges, and mall or hospital parking fees are paid directly by the vehicle owner."
  },
  {
    q: "What happens if my shopping or event takes longer than booked?",
    a: "You do not need to call the office to request an extension. Simply inform your driver. Extra duty hours are billed at a flat ₹120 per hour at final settlement with zero surge pricing."
  },
  {
    q: "What is your cancellation and driver replacement policy?",
    a: "Free cancellation is available up to 2 hours before the scheduled reporting time. In the rare event of driver illness or vehicle emergency, our dispatch team provides a guaranteed replacement within 30 to 60 minutes across Chennai."
  }
];

// ── Schema.org Structured Data ───────────────────────────────────────────
const chauffeurServiceSchema = {
  "@type": "Service",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#service",
  "name": "Acting Driver & Personal Car Chauffeur Service in Chennai",
  "alternateName": [
    "Acting Driver Chennai",
    "Call Driver Chennai",
    "Hire Acting Driver Chennai",
    "Driver for Personal Car Chennai",
    "Outstation Acting Driver Chennai"
  ],
  "serviceType": "Acting Driver & Personal Car Chauffeur Service",
  "description": description,
  "url": "https://kalidasstravels.in/services/acting-drivers/",
  "image": "https://kalidasstravels.in/images/services/acting-drivers.webp",
  "hoursAvailable": "Mo-Su 00:00-23:59",
  "termsOfService": "₹500 advance deposit (100% deducted from bill), pay balance post-trip, police-verified chauffeurs, flat rates with zero surge pricing",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "City", "name": "Tambaram" },
    { "@type": "City", "name": "Chengalpattu" },
    { "@type": "City", "name": "Kanchipuram" },
    { "@type": "City", "name": "Coimbatore" },
    { "@type": "City", "name": "Madurai" },
    { "@type": "City", "name": "Tiruchirappalli" },
    { "@type": "City", "name": "Salem" },
    { "@type": "City", "name": "Tirunelveli" },
    { "@type": "City", "name": "Vellore" },
    { "@type": "City", "name": "Erode" },
    { "@type": "City", "name": "Thanjavur" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Puducherry" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Acting Driver Rates in Chennai",
    "itemListElement": [
      ...cityTariff.map((item) => ({
        "@type": "Offer",
        "name": item.name,
        "description": `${item.hours} - ${item.idealFor}. Extra hour: ${item.extra}`,
        "price": item.rate.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/#tariffs"
      })),
      ...outstationTariff.map((item) => ({
        "@type": "Offer",
        "name": `Outstation Acting Driver for ${item.vehicle}`,
        "description": `Outstation driver daily duty for ${item.examples} at ${item.rate}`,
        "price": item.rate.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/#tariffs"
      })),
      ...onewayDropTariff.map((item) => ({
        "@type": "Offer",
        "name": `Outstation One-Way Drop Acting Driver: ${item.route}`,
        "description": `${item.dest} - ${item.breakdown} = ${item.total}`,
        "price": item.total.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/#tariffs"
      }))
    ]
  },
  "potentialAction": {
    "@type": "ReserveAction",
    "name": "Hire Acting Driver",
    "description": "Book a verified acting driver for your personal car with ₹500 advance deposit (deducted from bill)",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://kalidasstravels.in/services/acting-drivers/#trip-estimator",
      "inLanguage": "en-IN",
      "actionPlatform": [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform"
      ]
    },
    "result": {
      "@type": "Reservation",
      "name": "Acting Driver Booking",
      "provider": {
        "@id": "https://kalidasstravels.in/#localbusiness"
      }
    }
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a.replace(/<[^>]*>/g, '')
    }
  }))
};

const tariffListSchema = {
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#tariffs-list",
  "name": "Acting Driver Rates in Chennai — City & Outstation Tariffs",
  "description": "Standardized, transparent customer tariffs for hiring verified acting drivers in Chennai for local and outstation trips.",
  "numberOfItems": cityTariff.length + outstationTariff.length + onewayDropTariff.length,
  "itemListElement": [
    ...cityTariff.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${item.name} (${item.rate})`,
      "description": `${item.hours} - ${item.idealFor}. Extra hour: ${item.extra}`
    })),
    ...outstationTariff.map((item, idx) => ({
      "@type": "ListItem",
      "position": cityTariff.length + idx + 1,
      "name": `Outstation Round Trip: ${item.vehicle} (${item.total})`,
      "description": `Outstation driver daily duty for ${item.examples} at ${item.total}`
    })),
    ...onewayDropTariff.map((item, idx) => ({
      "@type": "ListItem",
      "position": cityTariff.length + outstationTariff.length + idx + 1,
      "name": `Outstation One-Way Drop: ${item.route} (${item.total})`,
      "description": `${item.dest} - ${item.breakdown} = ${item.total}`
    }))
  ]
};
---

<Layout 
  title={`${title} | Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/acting-drivers.webp"
  ogImage="/og/acting-drivers.jpg"
  schema={[chauffeurServiceSchema, faqSchema, tariffListSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">

      <!-- Top Hero Section (M3 Adaptive: 2-Column Split on Desktop, App-First on Mobile) -->
      <section class="mb-5 sm:mb-7">
        <!-- Mobile ONLY Heading + Separate Google Rating Row -->
        <div class="block lg:hidden text-center max-w-xl mx-auto mb-3">
          <p role="heading" aria-level="1" data-speakable="true" class="text-xl sm:text-2xl font-extrabold text-m3-on-surface font-heading tracking-tight leading-tight">
            Hire An Acting Driver For Your Own Car
          </p>
          <div class="mt-2 flex justify-center">
            <GoogleRatingBadge />
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
          
          <!-- Left Column: Visible on Desktop (lg+) with Hero Image -->
          <div class="hidden lg:flex lg:col-span-5 flex-col justify-between pt-1">
            <div>
              <!-- Desktop H1 + Separate Google Star Rating Row -->
              <h1 data-speakable="true" class="text-3xl lg:text-[34px] font-extrabold text-m3-on-surface font-heading tracking-tight leading-[1.15] mb-2.5">
                Hire An Acting Driver For Your Own Car
              </h1>
              <div class="mb-2.5">
                <GoogleRatingBadge />
              </div>

              <p data-speakable="true" class="text-sm text-m3-on-surface-variant leading-relaxed">
                Police-verified personal car drivers in Chennai for Manual, Automatic &amp; EV cars. City duty: <strong>₹750 (4 Hrs)</strong> • <strong>₹1,200 (8 Hrs)</strong>. Outstation: <strong>₹1,400/day + ₹300 food bata</strong>. Doorstep reporting in 30–45 mins, ₹500 advance to confirm.
              </p>
            </div>

            <!-- Desktop Hero Visual Showcase Card -->
            <HeroVisualCard
              src="/images/services/acting-drivers.webp"
              alt="Kalidass Travels police-verified acting driver for personal cars in Chennai"
              badge="100% Police-Verified Chauffeurs"
              headline="Manual, Automatic & EV Certified • Doorstep in 30–45 Mins"
              points={["Zero Surge Pricing", "Pay Balance Post-Trip", "All 38 TN Districts"]}
              objectPosition="center 40%"
            />

            <!-- Desktop Direct Call CTA -->
            <div class="flex items-center gap-3">
              <a
                href="tel:+918939539211"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-surface-container-highest text-m3-on-surface text-sm font-semibold border border-m3-outline-variant shadow-2xs hover:shadow-xs transition-all"
              >
                <Phone className="w-4 h-4 text-m3-primary shrink-0" />
                <span>Call Driver Desk: +91 89395 39211</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Elevated Estimator Engine Card -->
          <div class="lg:col-span-7 w-full max-w-2xl mx-auto lg:max-w-none flex flex-col">
            <div id="trip-estimator" class="scroll-mt-28 w-full flex-1">
              <DriverFeeEstimator 
                client:load
                title="Acting Driver Cost Calculator"
                subtitle="Bata · Food · Stay · Return Bus Ticket"
                embedded={true}
                showHeader={false}
              />
            </div>
          </div>

        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR -->
      <nav 
        data-quick-nav 
        aria-label="Acting Driver Quick Navigation" 
        class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-b border-m3-outline-variant/60 shadow-xs py-2.5 mb-6 px-4 sm:px-6 lg:px-8"
      >
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs sm:text-sm font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <a
            href="#trip-estimator"
            data-active="true"
            aria-current="true"
            class="px-3.5 py-1.5 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0 hover:bg-m3-primary hover:text-white"
          >
            Calculate Fare
          </a>
          <a
            href="#how-it-works"
            class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium"
          >
            How to Book
          </a>
          <a
            href="#tariffs"
            class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium"
          >
            Fixed Tariffs
          </a>
          <a
            href="#coverage"
            class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium"
          >
            Coverage Areas
          </a>
          <a
            href="#driver-faqs"
            class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium"
          >
            Driver FAQs
          </a>
        </div>
      </nav>

      <!-- 2. HOW TO BOOK (Schema: HowTo) - Full Width Desktop Layout -->
      <section id="how-it-works" class="rounded-2xl bg-m3-surface-container-lowest border border-m3-outline-variant shadow-sm p-4 sm:p-6 mb-8 relative overflow-hidden scroll-mt-28">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-3 mb-4 border-b border-m3-outline-variant">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-m3-on-surface font-heading">
              How Booking Works &amp; Chauffeur Allocation
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-3.5">
          <!-- Step 1 -->
          <div class="p-3 sm:p-4 rounded-xl bg-m3-surface hover:bg-m3-surface-container border border-m3-outline-variant/80 shadow-2xs flex flex-col justify-between transition-colors">
            <div>
              <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-m3-primary text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mb-2">01</span>
              <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading leading-tight mb-1">Share Details</h3>
              <p class="text-xs text-m3-on-surface-variant leading-snug">Car model (MT/AT/EV), reporting address in Chennai, and preferred departure time.</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="p-3 sm:p-4 rounded-xl bg-m3-surface hover:bg-m3-surface-container border border-m3-outline-variant/80 shadow-2xs flex flex-col justify-between transition-colors">
            <div>
              <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-m3-inverse-surface text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mb-2">02</span>
              <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading leading-tight mb-1">Driver Assigned</h3>
              <p class="text-xs text-m3-on-surface-variant leading-snug">Nearest police background-verified (PVC) chauffeur allocated with phone &amp; credentials sent in advance.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="p-3 sm:p-4 rounded-xl bg-m3-surface hover:bg-m3-surface-container border border-m3-outline-variant/80 shadow-2xs flex flex-col justify-between transition-colors">
            <div>
              <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-m3-inverse-surface text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mb-2">03</span>
              <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading leading-tight mb-1">Vehicle Check</h3>
              <p class="text-xs text-m3-on-surface-variant leading-snug">Chauffeur reports 15 mins early in clean uniform. Quick 2-min joint inspection of fuel gauge &amp; odometer.</p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="p-3 sm:p-4 rounded-xl bg-m3-surface hover:bg-m3-surface-container border border-m3-outline-variant/80 shadow-2xs flex flex-col justify-between transition-colors">
            <div>
              <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-m3-success text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mb-2">04</span>
              <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading leading-tight mb-1">Pay Balance After Trip</h3>
              <p class="text-xs text-m3-on-surface-variant leading-snug">Travel with zero fatigue. Settle the agreed transparent fare post-trip via UPI or Cash with ₹500 advance deducted from bill.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. FIXED RATES & TARIFFS (Schema: Product / AggregateOffer) -->
      <section id="tariffs" class="my-6 md:my-8 scroll-mt-28">
