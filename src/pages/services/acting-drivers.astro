---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import AndroidPhoneIcon from '../../components/AndroidPhoneIcon.astro';
import DriverFeeEstimator from '../../components/DriverFeeEstimator.jsx';
import OptimizedImage from '../../components/OptimizedImage.astro';

const title = "Hire Acting Drivers in Chennai from ₹500 | 100% Police Verified Chauffeurs";
const description = "Hire verified acting drivers in Chennai for your personal car (Manual, Auto, EV). City duty from ₹500 (4h), outstation from ₹1,100/day. Doorstep arrival in 30 mins.";
const keywords = "acting driver in chennai, call driver chennai, hire acting driver chennai, driver for personal car chennai, acting driver outstation chennai, one way acting driver chennai, hourly driver chennai, acting driver medavakkam velachery tambaram";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Acting Drivers", item: "/services/acting-drivers/" },
];

const cityTariff = [
  {
    name: "City Short Duty (4 Hours)",
    hours: "4 Hours Continuous",
    rate: "₹500",
    extra: "₹100 / extra hour",
    idealFor: "Doctor visits, shopping in T. Nagar, airport pickup/drop, local errands",
    whatsappMsg: "Hi Kalidass Travels, I want to book a 4-Hour City Acting Driver (₹500) in Chennai."
  },
  {
    name: "City Full Day Duty (8 Hours)",
    hours: "8 Hours Continuous",
    rate: "₹800",
    extra: "₹100 / extra hour",
    idealFor: "Family functions, multi-stop office meetings, full-day shopping, wedding duties",
