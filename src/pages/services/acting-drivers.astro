          </div>
        </div>
        <div class="flex items-center gap-2.5 p-3 rounded-m3-xl bg-m3-surface-container-lowest border border-m3-outline-variant shadow-xs">
          <div class="w-8 h-8 rounded-m3-md bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 flex items-center justify-center shrink-0">
