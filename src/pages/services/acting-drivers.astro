    total: "₹1,800 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Luxury Car (₹1,800/day transparent rate)."
  }
];

const onewayDropTariff = [
  {
    route: "Chennai → Pondicherry (151 km)",
    dest: "Puducherry / Auroville",
    breakdown: "₹1,100 Bata + ₹200 Bus + ₹300 Food",
    total: "₹1,600",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Pondicherry (₹1,600)."
  },
  {
    route: "Chennai → Bangalore (346 km)",
    dest: "Bengaluru / Hosur",
    breakdown: "₹1,100 Bata + ₹450 Bus + ₹300 Food",
    total: "₹1,850",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Bangalore (₹1,850)."
  },
