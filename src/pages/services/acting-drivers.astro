  description={description}
  keywords={keywords}
  image="/images/services/acting-drivers.webp"
  ogImage="/og/acting-drivers.jpg"
  schema={[breadcrumbSchema, serviceSchema, howToSchema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. SIGNATURE HERO SECTION WITH HERO IMAGE -->
      <section class="group relative min-h-[240px] sm:min-h-[300px] md:min-h-[340px] rounded-m3-2xl overflow-hidden shadow-m3-2 border border-m3-outline-variant/60 bg-slate-950 flex flex-col justify-end p-5 sm:p-8 md:p-10 mb-6 transition-all duration-300">
        <!-- Background Hero Image -->
        <OptimizedImage
          src="/images/services/acting-drivers.webp"
          alt="Hire Verified Acting Drivers & Chauffeurs for Personal Cars in Chennai - Kalidass Travels"
          class="absolute inset-0 w-full h-full object-cover object-[center_35%] transition-transform duration-700 group-hover:scale-105 opacity-85"
          loading="eager"
          fetchpriority="high"
