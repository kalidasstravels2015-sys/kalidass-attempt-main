  <script is:inline>
    function handleActingDriverHash() {
      if (window.location.hash) {
        const target = document.querySelector(window.location.hash);
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth' });
          }, 100);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', handleActingDriverHash);
    } else {
      handleActingDriverHash();
    }
  </script>
