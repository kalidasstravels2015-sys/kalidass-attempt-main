    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Madurai (₹2,500)."
  },
  {
    route: "Chennai → Coimbatore (505 km)",
    dest: "Coimbatore / Tirupur / Salem (>400 km)",
    breakdown: "₹1,650 (1.5d Bata) + ₹620 Bus + ₹300 Food",
    total: "₹2,570",
    whatsappMsg: "Hi Kalidass Travels, I need a One-Way Acting Driver to Coimbatore (₹2,570)."
  }
];

const faqs = [
  {
    q: "How quickly can an acting driver report to my location in Chennai?",
    a: "We recommend booking 1 to 2 hours in advance. For emergency requirements, our dispatch desk connects you with the nearest police-verified chauffeur within 30 to 45 minutes across all Chennai zones (Anna Nagar, T. Nagar, Adyar, Velachery, OMR, Porur, and Tambaram)."
  },
  {
    q: "Are your drivers trained for Automatic, EV, and Luxury cars?",
    a: "Yes. Every driver assigned to automatic or electric vehicles is specifically vetted on Torque Converter, CVT, Dual-Clutch (DCT/DSG), AMT, and EV drivetrains (Tata.ev, MG ZS EV, BYD). We also maintain specialist chauffeurs certified for luxury marques including Mercedes-Benz, BMW, Audi, Volvo, and Innova Crysta."
  },
  {
    q: "How are Outstation One-Way Drop acting driver rates calculated?",
    a: "Outstation One-Way Drop follows the Tamil Nadu driver community standard: 1-Day Driver Bata (₹1,100 for Sedan, ₹1,200 for SUV) + Return Govt. SETC Bus Ticket + ₹300 Food Allowance. For long-distance trips exceeding 400 km (such as Madurai, Coimbatore, or Tirunelveli), 1.5 Days Bata applies to compensate for the driver's return travel day. Fuel and FASTag highway tolls in your car are paid directly by you."
  },
  {
    q: "What are the driver food and accommodation rules for outstation trips?",
    a: "For outstation trips, food and stay are 100% passenger preference. Food: You can either invite the driver to eat with your family at highway halts (Food Allowance = ₹0) or provide a modest ₹300/day allowance (₹150 × 2 meals) for independent dining. Stay: Under the Tamil Nadu Government 2023 Hotel Regulations (TNCDBR), hotels, resorts, and commercial lodges are legally mandated to provide driver dormitories and washrooms (Night Stay = ₹0). If your stay (like a private Airbnb or homestay) has no driver dorm, a standard ₹300/night lodging allowance applies so the driver can rest at a nearby lodge. Drivers are strictly prohibited from sleeping inside personal cars to prevent driver fatigue and guarantee highway safety for your family."
  },
  {
    q: "Is there any government-fixed tariff for acting drivers in Tamil Nadu?",
    a: "No. Unlike auto-rickshaw meter fares, the Tamil Nadu Transport Department does not fix statutory customer tariffs for acting drivers. Pricing is governed by competitive market standards and driver welfare guidelines. However, drivers are legally recognized semi-skilled workers under Tamil Nadu labour laws, and hotels across the state are mandated by the 2023 building rules amendment to provide driver accommodation facilities."
  },
  {
    q: "Are drivers background-checked and police-verified?",
    a: "Yes, 100% of our drivers hold verified Police Clearance Certificates (PVC), valid commercial transport badges, and clean driving records with zero criminal history. A digital chauffeur profile with photo ID is shared on WhatsApp prior to arrival."
  },
  {
    q: "Who pays for fuel, toll plaza FASTag fees, and parking charges?",
    a: "Since the driver operates your personal vehicle, fuel, FASTag highway toll charges, and mall or hospital parking fees are paid directly by the vehicle owner."
  },
  {
    q: "What happens if my shopping or event takes longer than booked?",
    a: "You do not need to call the office to request an extension. Simply inform your driver. Extra duty hours are billed at a flat ₹100 per hour at final settlement with zero surge pricing."
  },
  {
    q: "What is your cancellation and driver replacement policy?",
    a: "Free cancellation is available up to 2 hours before the scheduled reporting time. In the rare event of driver illness or vehicle emergency, our dispatch team provides a guaranteed replacement within 30 to 60 minutes across Chennai."
  }
];

// ── Schema.org Structured Data ───────────────────────────────────────────
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#breadcrumb",
  "itemListElement": breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": `https://kalidasstravels.in${item.item}`
  }))
};

const serviceSchema = {
  "@type": "Service",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#service",
  "name": "Acting Driver & Personal Car Chauffeur Service in Chennai",
  "serviceType": "ChauffeurService",
  "description": description,
  "url": "https://kalidasstravels.in/services/acting-drivers/",
  "image": "https://kalidasstravels.in/images/services/acting-drivers.webp",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://kalidasstravels.in/#localbusiness",
    "name": "Kalidass Travels",
    "telephone": "+918939539211",
    "priceRange": "₹₹",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "No. 14, VGP Shanthi Nagar, Pallikaranai / Medavakkam",
      "addressLocality": "Chennai",
      "addressRegion": "Tamil Nadu",
      "postalCode": "600100",
      "addressCountry": "IN"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "City", "name": "Tambaram" },
    { "@type": "City", "name": "Chengalpattu" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Acting Driver Rates in Chennai",
    "itemListElement": [
      ...cityTariff.map((item) => ({
        "@type": "Offer",
        "name": item.name,
        "description": `${item.hours} - ${item.idealFor}. Extra hour: ${item.extra}`,
        "price": item.rate.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/"
      })),
      ...outstationTariff.map((item) => ({
        "@type": "Offer",
        "name": `Outstation Acting Driver for ${item.vehicle}`,
        "description": `Outstation driver daily duty for ${item.examples} at ${item.rate}`,
        "price": item.rate.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/"
      })),
      ...onewayDropTariff.map((item) => ({
        "@type": "Offer",
        "name": `Outstation One-Way Drop Acting Driver: ${item.route}`,
        "description": `${item.dest} - ${item.breakdown} = ${item.total}`,
        "price": item.total.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/"
      }))
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1280",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const howToSchema = {
  "@type": "HowTo",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#howto",
  "name": "How to Book a Police-Verified Acting Driver in Chennai",
  "description": "Step-by-step process for hiring a verified chauffeur to drive your personal car in Chennai or for outstation trips.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Share Car Model & Pickup Details",
      "text": "Share your car model, transmission type (Manual, Automatic, or EV), reporting address in Chennai, and departure time via WhatsApp or phone call."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Verified Chauffeur Assigned",
      "text": "Our 24/7 dispatch desk assigns the nearest police background-verified (PVC) chauffeur and shares their contact details and credentials in advance."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "2-Minute Joint Vehicle Inspection",
      "text": "Driver reports 15 minutes early in clean uniform. Complete a quick 2-minute check of fuel gauge, odometer reading, and any vehicle quirks."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Relax and Pay After Trip",
      "text": "Enjoy your ride with zero driving fatigue. Pay the exact transparent agreed fare post-trip via UPI or cash with zero advance deposit."
    }
  ]
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
