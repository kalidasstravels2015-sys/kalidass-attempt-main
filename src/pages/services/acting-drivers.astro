---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import ServiceExplainer3Step from '../../components/ServiceExplainer3Step.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import DriverFeeEstimator from '../../components/DriverFeeEstimator.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

const title = "Hire Acting Drivers in Chennai";
const description = "Hire verified acting drivers in Chennai for your car. City duty (₹600/4hrs) & outstation round trips (₹600 bata). 30-min doorstep arrival across Chennai.";
const keywords = "acting driver in chennai, hire acting driver chennai, call driver chennai, personal car driver hire chennai, hourly driver chennai, outstation acting driver chennai, temporary driver chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Acting Drivers", item: "/services/acting-drivers/" },
];

const explainerSteps = [
  {
    stepNumber: "1",
    badge: "Step 1: Your Car",
    title: "You Provide The Car",
    desc: "You own the vehicle — Hatchback, Sedan, SUV, EV, or Luxury. We provide the certified driver to take the wheel."
  },
  {
    stepNumber: "2",
    badge: "Step 2: On-Time Arrival",
    title: "Verified Driver Arrives",
    desc: "Our police background-verified driver reports at your Chennai doorstep in 30–60 minutes in full uniform with photo ID."
  },
  {
    stepNumber: "3",
    badge: "Step 3: Stress-Free Ride",
    title: "You Relax & Enjoy",
    desc: "No traffic headaches or parking hassles. Pay straightforward, pre-agreed hourly or daily rates upon trip completion."
  }
];

const cityTariff = [
  {
    name: "City Short Duty (4 Hours)",
    hours: "4 Hours Continuous",
    rate: "₹600",
    extra: "₹150 / extra hour",
    idealFor: "Doctor visits, shopping in T. Nagar, airport pickup/drop, local errands",
    whatsappMsg: "Hi Kalidass Travels, I want to book a 4-Hour City Acting Driver (₹600) in Chennai."
  },
  {
    name: "City Full Day Duty (8 Hours)",
    hours: "8 Hours Continuous",
    rate: "₹900",
    extra: "₹150 / extra hour",
    idealFor: "Family functions, multi-stop office meetings, full-day shopping",
    whatsappMsg: "Hi Kalidass Travels, I want to book an 8-Hour Full Day City Acting Driver (₹900) in Chennai."
  }
];

const outstationTariff = [
  {
    vehicle: "Hatchback & Sedan",
    examples: "Dzire, Etios, Honda City, Verna, Baleno",
    rate: "₹600 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Sedan (₹600/day)."
  },
  {
    vehicle: "Compact SUV / MPV",
    examples: "Ertiga, Creta, Seltos, Carens, XL6",
    rate: "₹700 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my SUV (₹700/day)."
  },
  {
    vehicle: "Premium SUV / MUV",
    examples: "Innova Crysta, Fortuner, Safari, XUV700",
    rate: "₹800 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Innova Crysta (₹800/day)."
  },
  {
    vehicle: "Luxury European",
    examples: "BMW, Mercedes-Benz, Audi, Volvo",
    rate: "₹1,000 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Outstation Acting Driver for my Luxury Car (₹1,000/day)."
  }
];

const faqs = [
  {
    q: "Can the driver handle automatic and luxury cars?",
    a: "Yes. All our assigned drivers are thoroughly vetted and experienced across Manual, Automatic (Torque Converter, CVT, DCT/DSG), Hybrid, and Electric Vehicles (EVs)."
  },
  {
    q: "Is there any distance limit for city packages?",
    a: "No kilometer limit applies for city hourly packages. You can make unlimited stops within the Chennai metropolitan area. You simply provide the vehicle and fuel."
  },
  {
    q: "What are the meal and accommodation rules for outstation trips?",
    a: "If the driver does not share family meals, a food allowance of ₹150 per meal applies. For overnight stays, if your hotel does not provide complimentary driver dormitory lodging, a ₹300 overnight room allowance is applicable."
  },
  {
    q: "Are drivers background verified?",
    a: "Yes, 100% of our drivers undergo Police Verification (PVC) and hold valid commercial transport badges with clean driving records."
  },
  {
    q: "How fast can a driver reach my doorstep?",
    a: "In most central and suburban Chennai areas (Anna Nagar, T. Nagar, OMR, Velachery, Guindy, Porur), drivers can report at your doorstep within 30 to 60 minutes of booking."
  }
];

const schema = {
  "@type": "Service",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#service",
  "name": title,
  "serviceType": "Acting Driver & Chauffeur Services",
  "description": description,
  "url": "https://kalidasstravels.in/services/acting-drivers/",
  "image": "https://kalidasstravels.in/images/services/acting-drivers.webp",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Acting Driver Rates in Chennai",
    "itemListElement": [
      ...cityTariff.map((item) => ({
        "@type": "Offer",
        "name": item.name,
        "description": `${item.hours} - ${item.idealFor}. Extra hour: ${item.extra}`,
        "price": item.rate.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/",
        "seller": {
          "@id": "https://kalidasstravels.in/#localbusiness"
        }
      })),
      ...outstationTariff.map((item) => ({
        "@type": "Offer",
        "name": `Outstation Acting Driver for ${item.vehicle}`,
        "description": `Outstation driver bata for ${item.examples} at ${item.rate}`,
        "price": item.rate.replace(/[^0-9]/g, ""),
        "priceCurrency": "INR",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": "https://kalidasstravels.in/services/acting-drivers/",
        "seller": {
          "@id": "https://kalidasstravels.in/#localbusiness"
        }
      }))
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1250",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/acting-drivers/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={`${title} – Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/acting-drivers.webp"
  ogImage="/og/acting-drivers.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. SIGNATURE HERO SECTION WITH HERO IMAGE -->
      <section class="group relative min-h-[220px] sm:min-h-[280px] md:min-h-[320px] rounded-m3-2xl overflow-hidden shadow-m3-2 border border-m3-outline-variant/60 bg-slate-950 flex flex-col justify-end p-5 sm:p-8 md:p-10 mb-8 transition-all duration-300">
        <!-- Background Hero Image -->
        <OptimizedImage
          src="/images/services/acting-drivers.webp"
          alt="Hire Verified Acting Drivers & Chauffeurs for Personal Cars in Chennai - Kalidass Travels"
          class="absolute inset-0 w-full h-full object-cover object-[center_35%] transition-transform duration-700 group-hover:scale-105 opacity-85"
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 768px) 100vw, 1200px"
        />
        <!-- High-Contrast Scrim Gradient for 100% Text Legibility while keeping image vivid -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 via-50% to-slate-950/25 sm:bg-gradient-to-r sm:from-slate-950/95 sm:via-slate-950/70 sm:to-transparent"></div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold uppercase tracking-wider mb-2.5 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <span>Police Background-Verified (PVC)</span>
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-2.5 font-heading drop-shadow-sm">
              Hire An <span class="text-amber-400">Acting Driver</span> For Your Own Car
            </h1>
            <p class="text-xs sm:text-sm md:text-base text-slate-200 leading-relaxed font-normal max-w-xl drop-shadow-xs">
              Enjoy the comfort of your personal car without driving fatigue. Police-verified, polite chauffeurs for city shopping, doctor visits, night functions, and outstation trips.
            </p>
          </div>
          <div class="hidden sm:flex flex-col items-start sm:items-end shrink-0 gap-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-m3-full bg-white/10 backdrop-blur-md text-white text-xs font-semibold border border-white/20 shadow-xs">
              ⚡ 30–60 Min Doorstep Arrival
            </span>
            <span class="text-xs text-slate-300 font-medium">
              City Duty from ₹600 · Outstation from ₹600/day
            </span>
          </div>
        </div>
      </section>

      <!-- Sticky Sub-Nav Quick Jump Bar (Below Hero) -->
      <nav data-quick-nav aria-label="Acting Driver Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-8 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-1.5 sm:gap-2 text-xs font-semibold whitespace-nowrap overflow-x-auto no-scrollbar py-0.5">
          <span class="text-micro uppercase tracking-wider text-m3-on-surface-variant mr-1 font-bold hidden sm:inline">Jump To:</span>
          <a href="#how-it-works" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0">How It Works</a>
          <a href="#tariffs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Fixed Rates</a>
          <a href="#trip-estimator" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Trip Estimator</a>
          <a href="#driver-vetting" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Chauffeur Vetting</a>
          <a href="#driver-faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Driver FAQs</a>
        </div>
      </nav>

      <!-- 2. ⚡ 3-STEP VISUAL WORKFLOW ILLUSTRATION -->
      <div id="how-it-works" class="scroll-mt-28">
        <ServiceExplainer3Step 
          title="How Acting Driver Service Works"
          subtitle="3 simple steps to enjoy your personal car without driving stress"
          steps={explainerSteps}
        />
      </div>

      <!-- 3. UPFRONT DUAL PRICING TABLES (STRAIGHT TO THE POINT) -->
      <section id="tariffs" class="my-10 md:my-14 scroll-mt-28">
        
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
            <span>Transparent Pricing</span>
          </div>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
            Fixed Rates • <span class="text-m3-primary">Zero Surge Pricing</span>
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5 font-sans">
            Pay only for the contracted time or days. Fuel is provided by you in your personal car.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
          
          <!-- Table 1: City Hourly Duty -->
          <div class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-6 border border-m3-outline-variant shadow-m3-1">
            <div class="flex items-center justify-between gap-2 border-b border-m3-outline-variant/60 pb-3 mb-4">
              <div>
                <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading flex items-center gap-2">
                  <svg class="w-5 h-5 text-m3-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Within Chennai Metro</span>
                </h3>
                <span class="text-micro text-m3-on-surface-variant font-medium">Unlimited Kilometers • Time-Based</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-m3-full text-micro font-bold bg-m3-surface-container-high text-m3-on-surface border border-m3-outline-variant">
                Most Popular
              </span>
            </div>

            <div class="space-y-3">
              {cityTariff.map((item) => (
                <div class="p-4 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-m3-primary/40 transition-colors">
                  <div>
                    <div class="font-bold text-sm sm:text-base text-m3-on-surface font-heading">{item.name}</div>
                    <div class="text-xs text-m3-on-surface-variant mt-0.5">{item.idealFor}</div>
                    <div class="text-badge text-m3-primary font-semibold mt-1">Extra Hour: {item.extra}</div>
                  </div>
                  <div class="flex items-center justify-between sm:flex-col sm:items-end gap-2 shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-m3-outline-variant/40">
                    <span class="text-xl sm:text-2xl font-black text-m3-primary font-heading">{item.rate}</span>
                    <WhatsAppButton
                      href={`https://wa.me/916381939769?text=${encodeURIComponent(item.whatsappMsg)}`}
                      size="sm"
                      variant="filled"
                      text="Book Driver"
                      ariaLabel={`Book ${item.name} on WhatsApp`}
                    />
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-4 pt-3 border-t border-m3-outline-variant/60 text-micro text-m3-on-surface-variant space-y-1">
              <p>• <strong>Night Duty Allowance:</strong> +₹200 flat for duty occurring between 10:00 PM and 5:00 AM.</p>
              <p>• <strong>Zero Distance Limits:</strong> Unlimited stops across Chennai city limits.</p>
            </div>
          </div>

          <!-- Table 2: Outstation Daily Duty -->
          <div class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-6 border border-m3-outline-variant shadow-m3-1">
            <div class="flex items-center justify-between gap-2 border-b border-m3-outline-variant/60 pb-3 mb-4">
              <div>
                <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading flex items-center gap-2">
                  <svg class="w-5 h-5 text-m3-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                  <span>Outstation Round Trip</span>
                </h3>
                <span class="text-micro text-m3-on-surface-variant font-medium">Daily Chauffeur Bata • Temple & Highway</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-m3-full text-micro font-bold bg-m3-surface-container-high text-m3-on-surface border border-m3-outline-variant">
                Up to 14 hrs/day
              </span>
            </div>

            <div class="divide-y divide-m3-outline-variant/40">
              {outstationTariff.map((item) => (
                <div class="py-3 flex items-center justify-between gap-3 hover:bg-m3-surface/60 transition-colors px-1">
                  <div class="min-w-0 flex-1">
                    <div class="font-bold text-xs sm:text-sm text-m3-on-surface truncate">{item.vehicle}</div>
                    <div class="text-micro text-m3-on-surface-variant truncate">{item.examples}</div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <span class="text-sm sm:text-base font-black text-m3-primary font-heading">{item.rate}</span>
                    <WhatsAppButton
                      href={`https://wa.me/916381939769?text=${encodeURIComponent(item.whatsappMsg)}`}
                      size="sm"
                      variant="tonal"
                      text="Book"
                      ariaLabel={`Book driver for ${item.vehicle} on WhatsApp`}
                    />
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-4 pt-3 border-t border-m3-outline-variant/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-micro text-m3-on-surface-variant">
              <div class="space-y-0.5">
                <p>• <strong>Meal Allowance:</strong> ₹150/meal (if not shared).</p>
                <p>• <strong>Night Stay:</strong> ₹300/night (if no dorm).</p>
              </div>
              <a href="#trip-estimator" class="inline-flex items-center gap-1 text-xs font-bold text-m3-primary hover:underline shrink-0">
                <span>Estimate Trip Total</span>
                <span aria-hidden="true">&darr;</span>
              </a>
            </div>
          </div>

        </div>

      </section>

      <!-- 3B. OUTSTATION TRIP COST ESTIMATOR (Option A) -->
      <section id="trip-estimator" class="my-10 md:my-14 scroll-mt-28">
        <div class="bg-gradient-to-b from-m3-surface-container-low to-m3-surface rounded-m3-2xl p-6 sm:p-8 lg:p-10 border border-m3-outline-variant shadow-m3-1">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Left Explainer Column -->
            <div class="lg:col-span-6 space-y-4">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container-high text-m3-primary text-xs font-bold uppercase tracking-wider border border-m3-outline-variant">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14H6v-2h6v2zm4-4H6v-2h10v2zm0-4H6V7h10v2z"/></svg>
                <span>Interactive Cost Calculator</span>
              </div>
              
              <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading leading-tight">
                Planning an Outstation Trip? <span class="text-m3-primary">Calculate Total Cost</span>
              </h2>
              
              <p class="text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed">
                Estimate the complete driver expense before you travel. Whether it's a 2-day family temple trip or a one-way car relocation, calculate driver bata, food allowance, night stay, or return bus ticket with zero hidden fees.
              </p>

              <!-- Transparent Cost Breakdown Cards -->
              <div class="space-y-3 pt-2">
                <div class="flex items-start gap-3 p-3 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
                  <div class="w-8 h-8 rounded-m3-md bg-m3-primary-container text-m3-primary flex items-center justify-center shrink-0 font-bold text-xs font-mono">
                    01
                  </div>
                  <div>
                    <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface">Vehicle-Specific Daily Bata</h3>
                    <p class="text-micro text-m3-on-surface-variant mt-0.5">Fixed at ₹600 (Sedan), ₹700 (SUV), ₹800 (Innova Crysta), ₹1,000 (Luxury) per calendar day.</p>
                  </div>
                </div>

                <div class="flex items-start gap-3 p-3 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
                  <div class="w-8 h-8 rounded-m3-md bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-xs font-mono">
                    02
                  </div>
                  <div>
                    <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface">Accommodation Savings</h3>
                    <p class="text-micro text-m3-on-surface-variant mt-0.5">If your hotel provides driver dormitory lodging, check the box to save ₹300/night instantly.</p>
                  </div>
                </div>

                <div class="flex items-start gap-3 p-3 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
                  <div class="w-8 h-8 rounded-m3-md bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 font-bold text-xs font-mono">
                    03
                  </div>
                  <div>
                    <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface">One-Way Drop Policy</h3>
                    <p class="text-micro text-m3-on-surface-variant mt-0.5">For one-way intercity drops, the driver's standard return bus ticket (SETC / actuals) is calculated transparently.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Calculator Card -->
            <div class="lg:col-span-6 flex justify-center">
              <DriverFeeEstimator 
                title="Outstation Driver Estimator"
                subtitle="Calculate exact Bata, Stay & Transit"
              />
            </div>

          </div>
        </div>
      </section>

      <!-- 4. KEY CHAUFFEUR GUARANTEES (CLEAN 4-PILLAR GRID) -->
      <section id="driver-vetting" class="my-10 md:my-14 bg-m3-surface-container-low rounded-m3-2xl p-6 sm:p-8 border border-m3-outline-variant scroll-mt-28">
        <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
          <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-m3-on-surface font-heading">
            Why Car Owners Choose Kalidass Drivers
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
