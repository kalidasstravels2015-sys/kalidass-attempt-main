      const dropdown = document.getElementById('airport-search-dropdown');
      const quickSuggestionsSection = document.getElementById('quick-suggestions-section');
      const chipsContainer = document.getElementById('finder-chips-container');
      const resultBox = document.getElementById('finder-result-box');
      const resultTitle = document.getElementById('result-title');
      const resultLandmarks = document.getElementById('result-landmarks');
      const resultEtaDistance = document.getElementById('result-eta-distance');
      const vehicleGrid = document.getElementById('finder-vehicle-grid');
      const whatsappBtn = document.getElementById('finder-whatsapp-btn');
      const btnLabel = document.getElementById('finder-btn-label');

      // Web Booking Modal Elements
      const openWebBookingBtn = document.getElementById('open-web-booking-btn');
      const webBookingModal = document.getElementById('web-booking-modal') as HTMLDialogElement | null;
      const closeWebBookingBtn = document.getElementById('close-web-booking-btn');
      const closeSuccessModalBtn = document.getElementById('close-success-modal-btn');
      const webBookingForm = document.getElementById('web-booking-form') as HTMLFormElement | null;
      const webBookingSuccess = document.getElementById('web-booking-success');
      const modalSummaryDirection = document.getElementById('modal-summary-direction');
      const modalSummaryRoute = document.getElementById('modal-summary-route');
      const modalSummaryVehicle = document.getElementById('modal-summary-vehicle');
      const modalSummaryFare = document.getElementById('modal-summary-fare');

      // All 5 Zones Bottom Sheet / Modal Elements
      const toggleAllZonesBtn = document.getElementById('toggle-all-zones-btn');
      const allZonesModal = document.getElementById('all-zones-modal') as HTMLDialogElement | null;
      const closeZonesModalBtn = document.getElementById('close-zones-modal-btn');
      const closeZonesModalBottomBtn = document.getElementById('close-zones-modal-bottom-btn');
      const zonesModalDirectionLabel = document.getElementById('zones-modal-direction-label');
      const modalZoneSelectBtns = document.querySelectorAll<HTMLButtonElement>('.modal-zone-select-btn');

      let currentMode: 'drop' | 'pickup' = 'pickup';
      let selectedDest: AirportDest | null = null;
      let selectedVehicle: 'sedan' | 'innova' | 'crysta' | 'tempo' = 'sedan';
      let selectedFromChip = false;

      // 3. Render Finder UI
      function updateSuggestionsVisibility() {
        if (!quickSuggestionsSection) return;
        const query = searchInput ? searchInput.value.trim() : '';

        if (selectedFromChip) {
          quickSuggestionsSection.classList.remove('hidden');
          return;
        }

        if (query.length > 0) {
          quickSuggestionsSection.classList.add('hidden');
        } else {
          quickSuggestionsSection.classList.remove('hidden');
        }
      }

      function renderChips() {
        if (!chipsContainer) return;
        chipsContainer.innerHTML = '';

        const trendingList = destinations.slice(0, 4);

        trendingList.forEach((dest) => {
          const isSelected = !!selectedDest && selectedDest.id === dest.id;
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = `group flex items-center gap-1.5 px-3 py-1.5 rounded-full text-left transition-all cursor-pointer min-w-0 select-none active:scale-[0.98] ${
            isSelected
              ? 'bg-slate-900 text-white font-bold shadow-xs border border-slate-900'
              : 'bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 font-medium'
          }`;
          chip.innerHTML = `
            <svg class="w-3.5 h-3.5 shrink-0 transition-colors ${
              isSelected ? 'text-emerald-400' : 'text-slate-400 group-hover:text-emerald-600'
            }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
            <span class="truncate text-[11px] leading-tight">${dest.trendingLabel || dest.chipLabel}</span>
          `;
          chip.onclick = () => {
            if (selectedDest && selectedDest.id === dest.id) {
              selectedDest = null;
              selectedFromChip = false;
              if (searchInput) searchInput.value = '';
              if (clearBtn) clearBtn.classList.add('hidden');
            } else {
              selectedDest = dest;
              selectedFromChip = true;
              if (searchInput) searchInput.value = dest.name;
              if (clearBtn) clearBtn.classList.remove('hidden');
            }
            if (dropdown) dropdown.classList.add('hidden');
            renderFinderState();
          };
          chipsContainer.appendChild(chip);
        });
      }

      function promptForDestination() {
        const isDrop = currentMode === 'drop';
        if (searchInput) {
          searchInput.focus();
          searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
          searchInput.classList.add('ring-2', 'ring-emerald-600', 'bg-emerald-50/50');
          setTimeout(() => {
            searchInput.classList.remove('ring-2', 'ring-emerald-600', 'bg-emerald-50/50');
          }, 2000);
        }
        const hint = document.getElementById('finder-input-hint');
        const hintText = document.getElementById('finder-hint-text');
        if (hint && hintText) {
          hintText.textContent = isDrop
            ? "Please enter your pickup address / doorstep in Chennai"
            : "Please enter your drop location / hotel in Chennai";
          hint.classList.remove('hidden');
          setTimeout(() => hint.classList.add('hidden'), 5000);
        }
      }

      function renderFinderState() {
        renderChips();
        updateSuggestionsVisibility();

        if (!selectedDest) {
          if (resultBox) resultBox.classList.add('hidden');
          const isDrop = currentMode === 'drop';
          if (btnLabel) {
            btnLabel.textContent = isDrop ? 'Reserve Drop · From ₹650' : 'Reserve Pickup · From ₹650';
          }
          if (whatsappBtn) {
            whatsappBtn.setAttribute('title', isDrop ? 'Reserve Airport Drop (From ₹650 - Pay After Trip)' : 'Reserve Airport Pickup (From ₹650 - Pay After Trip)');
            whatsappBtn.onclick = () => promptForDestination();
          }
          return;
        }

        const hint = document.getElementById('finder-input-hint');
        if (hint) hint.classList.add('hidden');

        if (resultBox) resultBox.classList.remove('hidden');

        if (resultTitle) resultTitle.textContent = selectedDest.name;
        if (resultLandmarks) resultLandmarks.textContent = selectedDest.landmarks;
        if (resultEtaDistance) resultEtaDistance.textContent = `${selectedDest.eta} · ${selectedDest.distance}`;

        // Vehicles breakdown
        const vehicles = [
          { type: 'sedan' as const, name: 'Sedan', model: 'Dzire / Etios', pax: '4 Pax · 2 Bags', price: selectedDest.sedan },
          { type: 'innova' as const, name: 'SUV', model: 'Innova / Ertiga', pax: '6 Pax · 3 Bags', price: selectedDest.innova },
          { type: 'crysta' as const, name: 'VIP Crysta', model: 'Innova Crysta', pax: '7 Pax · 5 Bags', price: selectedDest.crysta },
          { type: 'tempo' as const, name: 'Tempo', model: '12-Seater Coach', pax: '12 Pax · 12 Bags', price: selectedDest.tempo },
        ];

        if (vehicleGrid) {
          vehicleGrid.innerHTML = '';
          vehicles.forEach((v) => {
            const isChosen = selectedVehicle === v.type;
            const card = document.createElement('button');
            card.type = 'button';
            card.className = `p-2.5 rounded-xl border text-center transition-all cursor-pointer flex flex-col justify-between ${
              isChosen
                ? 'border-slate-900 bg-slate-100 font-bold ring-2 ring-slate-900 shadow-xs'
                : 'border-slate-200 bg-white hover:border-slate-400'
            }`;
            card.innerHTML = `
              <span class="text-[10px] uppercase font-bold text-slate-500 block truncate leading-none mb-0.5" title="${v.model}">${v.name}</span>
              <strong class="text-xs sm:text-sm font-extrabold text-slate-900 block leading-tight">${v.price}</strong>
              <span class="text-[10px] text-slate-500 block truncate mt-0.5">${v.pax}</span>
            `;
            card.onclick = () => {
              selectedVehicle = v.type;
              renderFinderState();
            };
            vehicleGrid.appendChild(card);
          });
        }

        // WhatsApp booking link update
        const chosenVehicle = vehicles.find((v) => v.type === selectedVehicle) || vehicles[0];
        const isDrop = currentMode === 'drop';

        if (btnLabel) {
          btnLabel.textContent = isDrop
            ? `Reserve Drop (${chosenVehicle.price})`
            : `Reserve Pickup (${chosenVehicle.price})`;
        }

        if (whatsappBtn) {
          whatsappBtn.setAttribute('title', isDrop
            ? `Reserve Airport Drop with ${chosenVehicle.name} (${chosenVehicle.price} - Pay After Trip)`
            : `Reserve Airport Pickup with ${chosenVehicle.name} (${chosenVehicle.price} - Pay After Trip)`);
          whatsappBtn.onclick = () => openBookingModal();
        }
      }

      // 4. Google Maps Places Autocomplete Integration
      function attachGooglePlaces() {
        if (typeof (window as any).google !== 'undefined' && (window as any).google.maps && (window as any).google.maps.places) {
          if (searchInput && !searchInput.dataset.googleAttached) {
            searchInput.dataset.googleAttached = "true";
            try {
              const autocomplete = new (window as any).google.maps.places.Autocomplete(searchInput, {
                componentRestrictions: { country: 'in' },
                fields: ['name', 'formatted_address', 'geometry']
              });

              autocomplete.addListener('place_changed', () => {
                const place = autocomplete.getPlace();
                if (place && place.geometry && place.geometry.location) {
                  const placeLat = place.geometry.location.lat();
                  const placeLng = place.geometry.location.lng();
                  // Chennai Airport coordinates: 12.9941, 80.1709
                  const km = calculateRoadKm(12.9941, 80.1709, placeLat, placeLng);
                  
                  let calculatedDest: AirportDest;
                  if (km <= 15) {
                    calculatedDest = {
                      id: "custom-south",
                      name: place.name || "Airport Vicinity",
                      chipLabel: place.name || "Airport Vicinity",
                      landmarks: place.formatted_address || "Chennai",
                      keywords: [],
                      sedan: "₹650",
                      innova: "₹1,150",
                      crysta: "₹1,500",
                      tempo: "₹2,400",
                      distance: `${km} km`,
                      eta: "10–20 mins"
                    };
                  } else if (km <= 28) {
                    calculatedDest = {
                      id: "custom-central",
                      name: place.name || "City Center & Downtown",
                      chipLabel: place.name || "City Center",
                      landmarks: place.formatted_address || "Chennai",
                      keywords: [],
                      sedan: "₹950",
                      innova: "₹1,550",
                      crysta: "₹1,950",
                      tempo: "₹2,900",
                      distance: `${km} km`,
                      eta: "30–45 mins"
                    };
                  } else if (km <= 60) {
                    calculatedDest = {
                      id: "custom-ecr",
                      name: place.name || "Mahabalipuram / ECR Coastal",
                      chipLabel: place.name || "ECR Coastal",
                      landmarks: place.formatted_address || "Tamil Nadu",
                      keywords: [],
                      sedan: "₹1,650",
                      innova: "₹2,400",
                      crysta: "₹2,950",
                      tempo: "₹4,200",
                      distance: `${km} km`,
                      eta: "45–60 mins"
                    };
                  } else if (km <= 90) {
                    calculatedDest = {
                      id: "custom-kanchi",
                      name: place.name || "Kanchipuram / Industrial Belt",
                      chipLabel: place.name || "Kanchipuram Hub",
                      landmarks: place.formatted_address || "Tamil Nadu",
                      keywords: [],
                      sedan: "₹2,600",
                      innova: "₹3,800",
                      crysta: "₹4,600",
                      tempo: "₹6,200",
                      distance: `${km} km`,
                      eta: "1.5–2 hrs"
                    };
                  } else {
                    calculatedDest = {
                      id: "custom-outstation",
                      name: place.name || "Outstation Direct Transfer",
                      chipLabel: place.name || "Outstation",
                      landmarks: place.formatted_address || "South India",
                      keywords: [],
                      sedan: "₹3,900",
                      innova: "₹5,600",
                      crysta: "₹6,800",
                      tempo: "₹8,900",
                      distance: `${km} km`,
                      eta: `${Math.round(km / 50 * 10) / 10} hrs`
                    };
                  }

                  selectedDest = calculatedDest;
                  selectedFromChip = false;
                  if (clearBtn) clearBtn.classList.remove('hidden');
                  if (dropdown) dropdown.classList.add('hidden');
                  renderFinderState();
                }
              });
            } catch (e) {
              console.warn("Places autocomplete failed", e);
            }
          }
        }
      }

      // Lazy load Google Maps when user focuses search input
      if (searchInput) {
        searchInput.addEventListener('focus', () => {
          import('../../lib/googleMapsLoader')
            .then((m) => m.loadGoogleMaps())
            .then(attachGooglePlaces)
            .catch(() => {
              // Fallback to internal matching seamlessly
            });
        }, { once: true });
      }

      // 5. Curated Instant Autocomplete Handler
      if (searchInput && dropdown && clearBtn) {
        searchInput.oninput = () => {
          selectedFromChip = false;
          updateSuggestionsVisibility();
          const q = searchInput.value.trim().toLowerCase();
          if (q.length === 0) {
            clearBtn.classList.add('hidden');
            dropdown.classList.add('hidden');
            selectedDest = null;
            renderFinderState();
            return;
          }
          clearBtn.classList.remove('hidden');

          const matches = destinations.filter(
            (d) =>
              d.name.toLowerCase().includes(q) ||
              d.landmarks.toLowerCase().includes(q) ||
              d.keywords.some((kw) => kw.includes(q))
          );

          dropdown.innerHTML = '';
          if (matches.length > 0) {
            matches.forEach((m) => {
              const item = document.createElement('button');
              item.type = 'button';
              item.className = 'w-full p-2.5 text-left text-xs hover:bg-slate-100 transition-colors flex items-center justify-between cursor-pointer';
              item.innerHTML = `
                <div>
                  <strong class="font-bold text-slate-900 block">${m.name}</strong>
                  <span class="text-[11px] text-slate-500 line-clamp-1">${m.landmarks}</span>
                </div>
                <div class="text-right shrink-0 ml-2">
                  <span class="font-extrabold text-slate-900 block">${m.sedan}</span>
                  <span class="text-[10px] text-slate-500">${m.eta}</span>
                </div>
              `;
              item.onclick = () => {
                selectedFromChip = false;
                searchInput.value = m.name;
                dropdown.classList.add('hidden');
                selectedDest = m;
                renderFinderState();
              };
              dropdown.appendChild(item);
            });
          } else {
            const customItem = document.createElement('button');
            customItem.type = 'button';
            customItem.className = 'w-full p-2.5 text-left text-xs hover:bg-slate-50 transition-colors block text-emerald-800 font-semibold cursor-pointer';
            customItem.textContent = `Location not in list? Tap for custom quote: "${searchInput.value}"`;
            customItem.onclick = () => {
              const customDest = searchInput.value.trim();
              const isDrop = currentMode === 'drop';
              const customMsg = isDrop
                ? `Hi Kalidass Travels, I need an Airport DROP to Chennai Airport (MAA) from ${customDest}. Please share the flat quote for Sedan and Innova.`
                : `Hi Kalidass Travels, I need an Airport PICKUP at Chennai Airport (MAA) to ${customDest}. Please share the flat quote for Sedan and Innova.`;
              window.open(`https://wa.me/916381939769?text=${encodeURIComponent(customMsg)}`, '_blank');
            };
            dropdown.appendChild(customItem);
          }
          dropdown.classList.remove('hidden');
        };

        clearBtn.onclick = () => {
          searchInput.value = '';
          clearBtn.classList.add('hidden');
          dropdown.classList.add('hidden');
          selectedDest = null;
          selectedFromChip = false;
          renderFinderState();
          searchInput.focus();
        };

        document.addEventListener('click', (e) => {
          if (!dropdown.contains(e.target as Node) && e.target !== searchInput) {
            dropdown.classList.add('hidden');
          }
        });
      }

      // 6. Direction Switcher Logic
      function setDirection(mode: 'drop' | 'pickup') {
        currentMode = mode;
        const isDrop = mode === 'drop';

        // 6a. Toggle Button UI & Sticky Indicator
        if (indicator) {
          indicator.textContent = isDrop ? 'Going to Airport (Drop)' : 'Landing at Airport (Pickup)';
        }

        if (btnDrop && btnPickup) {
          if (isDrop) {
            btnDrop.className = "flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold transition-all shadow-sm bg-slate-900 text-white cursor-pointer active:scale-95";
            btnDrop.setAttribute('aria-selected', 'true');
            btnPickup.className = "flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer active:scale-95";
            btnPickup.setAttribute('aria-selected', 'false');
            const iconPickup = btnPickup.querySelector('.material-symbols-outlined') || btnPickup.querySelector('svg');
            if (iconPickup) iconPickup.setAttribute('class', "material-symbols-outlined text-[17px] text-slate-500");
            const iconDrop = btnDrop.querySelector('.material-symbols-outlined') || btnDrop.querySelector('svg');
            if (iconDrop) iconDrop.setAttribute('class', "material-symbols-outlined text-[17px] text-white");
          } else {
            btnPickup.className = "flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold transition-all shadow-sm bg-slate-900 text-white cursor-pointer active:scale-95";
            btnPickup.setAttribute('aria-selected', 'true');
            btnDrop.className = "flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer active:scale-95";
            btnDrop.setAttribute('aria-selected', 'false');
            const iconPickup = btnPickup.querySelector('.material-symbols-outlined') || btnPickup.querySelector('svg');
            if (iconPickup) iconPickup.setAttribute('class', "material-symbols-outlined text-[17px] text-white");
            const iconDrop = btnDrop.querySelector('.material-symbols-outlined') || btnDrop.querySelector('svg');
            if (iconDrop) iconDrop.setAttribute('class', "material-symbols-outlined text-[17px] text-slate-500");
          }
        }

        // 6b. Toggle Pre-Tariff Assurance Protocols
        if (protocolPickup && protocolDrop) {
          if (isDrop) {
            protocolDrop.classList.remove('hidden');
            protocolPickup.classList.add('hidden');
          } else {
            protocolPickup.classList.remove('hidden');
            protocolDrop.classList.add('hidden');
          }
        }
        const commitmentsSubtitle = document.getElementById('commitments-mode-subtitle');
        if (commitmentsSubtitle) {
          commitmentsSubtitle.textContent = isDrop ? 'Drop Protocol' : 'Pickup Protocol';
        }

        // 6c. Update Route Fields Layout, Labels & Swap Button
        if (routeInputsContainer && userLocationFieldWrapper && airportMaaFieldWrapper && routeSwapRow) {
          if (isDrop) {
            // Drop Mode: Doorstep (Pickup) -> Airport MAA (Drop)
            routeInputsContainer.appendChild(userLocationFieldWrapper);
            routeInputsContainer.appendChild(routeSwapRow);
            routeInputsContainer.appendChild(airportMaaFieldWrapper);

            if (userFieldEyebrow) {
              userFieldEyebrow.innerHTML = `
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block shrink-0"></span>
                <span>Pickup Location</span>
              `;
            }
            if (airportFieldEyebrow) {
              airportFieldEyebrow.innerHTML = `
                <span class="w-2 h-2 rounded-full bg-slate-900 inline-block shrink-0"></span>
                <span>Drop-off Destination</span>
              `;
            }
            if (airportFieldBadge) {
              airportFieldBadge.textContent = "MAA Airport";
            }
            if (airportFieldSubtext) {
              airportFieldSubtext.textContent = "Direct Ramp Drop · Departure Gates T1, T2 & T4";
            }
            if (airportIcon) {
              airportIcon.textContent = "flight_takeoff";
            }
            if (routeSwapLabel) {
              routeSwapLabel.textContent = "Swap to Airport Pickup";
            }
            if (routeSwapBtn) {
              routeSwapBtn.setAttribute('title', "Swap to Airport Pickup (Landing at MAA)");
              routeSwapBtn.setAttribute('aria-label', "Swap to Airport Pickup");
            }
            if (routeSwapIcon) {
              routeSwapIcon.classList.add('rotate-180');
            }
          } else {
            // Pickup Mode: Airport MAA (Pickup) -> Doorstep (Drop)
            routeInputsContainer.appendChild(airportMaaFieldWrapper);
            routeInputsContainer.appendChild(routeSwapRow);
            routeInputsContainer.appendChild(userLocationFieldWrapper);

            if (airportFieldEyebrow) {
              airportFieldEyebrow.innerHTML = `
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block shrink-0"></span>
                <span>Pickup Location</span>
              `;
            }
            if (airportFieldBadge) {
              airportFieldBadge.textContent = "MAA Airport";
            }
            if (airportFieldSubtext) {
              airportFieldSubtext.textContent = "Arrival Exit Gates · Chauffeur meets with Name Placard";
            }
            if (airportIcon) {
              airportIcon.textContent = "flight_land";
            }
            if (userFieldEyebrow) {
              userFieldEyebrow.innerHTML = `
                <span class="w-2 h-2 rounded-full bg-slate-900 inline-block shrink-0"></span>
                <span>Drop-off Destination</span>
              `;
            }
            if (routeSwapLabel) {
              routeSwapLabel.textContent = "Swap to Airport Drop";
            }
            if (routeSwapBtn) {
              routeSwapBtn.setAttribute('title', "Swap to Airport Drop (Going to MAA)");
              routeSwapBtn.setAttribute('aria-label', "Swap to Airport Drop");
            }
            if (routeSwapIcon) {
              routeSwapIcon.classList.remove('rotate-180');
            }
          }
        }

        // 6d. Update Search Input Placeholder & Labels
        if (searchInput) {
          searchInput.placeholder = isDrop
            ? "Where from? Search pickup doorstep, hotel, or office in Chennai..."
            : "Where to? Search hotel, area, or address on Google Maps...";
        }

        // 6e. Update Tariff Headings
        if (tariffHeading && tariffSubheading) {
          if (isDrop) {
            tariffHeading.textContent = "Book Airport Drop — Doorstep to Chennai Airport (From ₹650)";
            tariffSubheading.textContent = "Punctual doorstep pickup across Chennai direct to Departure Gates T1, T2 & T4. Fuel, chauffeur & AC included.";
          } else {
            tariffHeading.textContent = "Book Airport Pickup — Chennai Airport to Doorstep (From ₹650)";
            tariffSubheading.textContent = "Chauffeur meets at arrival gate with personalized name board. Completely free waiting time on flight delays.";
          }
        }

        // 6f. Update Desktop Table Booking URLs and Labels
        desktopLinks.forEach((link) => {
          const msg = isDrop ? link.getAttribute('data-drop-msg') : link.getAttribute('data-pickup-msg');
          if (msg) {
            link.href = `https://wa.me/916381939769?text=${encodeURIComponent(msg)}`;
          }
          const label = link.querySelector('.action-label');
          if (label) {
            label.textContent = isDrop ? 'Book Drop' : 'Book Pickup';
          }
        });

        // 6g. Update Mobile Cards Booking URLs and Labels
        mobileCards.forEach((card) => {
          const msg = isDrop ? card.getAttribute('data-drop-msg') : card.getAttribute('data-pickup-msg');
          if (msg) {
            card.href = `https://wa.me/916381939769?text=${encodeURIComponent(msg)}`;
          }
          const label = card.querySelector('.mobile-action-label');
          if (label) {
            label.textContent = isDrop ? 'Book Drop' : 'Book Pickup';
          }
        });

        // 6h. Update All 5 Zones Modal Direction & Button Labels
        if (zonesModalDirectionLabel) {
          zonesModalDirectionLabel.textContent = isDrop
            ? 'Active Transfer: Doorstep to Airport (Drop)'
            : 'Active Transfer: Landing at Airport (Pickup)';
        }
        modalZoneSelectBtns.forEach((btn) => {
          const label = btn.querySelector('.modal-zone-select-label');
          if (label) {
            label.textContent = isDrop ? 'Book Drop' : 'Book Pickup';
          }
        });

        renderFinderState();
      }

      if (btnDrop && btnPickup) {
        btnDrop.onclick = () => setDirection('drop');
        btnPickup.onclick = () => setDirection('pickup');
      }

      if (routeSwapBtn) {
        routeSwapBtn.onclick = () => {
          const nextMode = currentMode === 'drop' ? 'pickup' : 'drop';
          setDirection(nextMode);
        };
      }

      if (airportFieldCard && searchInput) {
        airportFieldCard.onclick = () => {
          searchInput.focus();
        };
        airportFieldCard.onkeydown = (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            searchInput.focus();
          }
        };
      }

      // 7. Booking Modal Logic
      function openBookingModal(destOverride?: AirportDest, vehicleType?: 'sedan' | 'innova' | 'crysta' | 'tempo') {
        if (destOverride) {
          selectedDest = destOverride;
        }
        if (vehicleType) {
          selectedVehicle = vehicleType;
        }
        if (!selectedDest) {
          selectedDest = destinations[0];
        }
        if (!webBookingModal) return;

        const vehicles = [
          { type: 'sedan', name: 'Sedan (Dzire / Etios)', price: selectedDest.sedan },
          { type: 'innova', name: 'SUV (Ertiga / Innova)', price: selectedDest.innova },
          { type: 'crysta', name: 'VIP Crysta (Innova Crysta)', price: selectedDest.crysta },
          { type: 'tempo', name: 'Tempo (12-Seater Coach)', price: selectedDest.tempo },
        ];
        const chosen = vehicles.find((v) => v.type === selectedVehicle) || vehicles[0];
        const isDrop = currentMode === 'drop';

        if (modalSummaryDirection) {
          modalSummaryDirection.textContent = isDrop ? 'Airport Drop (Departure Transfer)' : 'Airport Pickup (Arrival Meet & Greet)';
        }
        if (modalSummaryRoute) {
          modalSummaryRoute.textContent = isDrop 
            ? `${selectedDest.name} ➔ Chennai Airport (MAA)` 
            : `Chennai Airport (MAA) ➔ ${selectedDest.name}`;
        }
        if (modalSummaryVehicle) {
          modalSummaryVehicle.textContent = chosen.name;
        }
        if (modalSummaryFare) {
          modalSummaryFare.textContent = chosen.price;
        }

        const modalVehicleCapHint = document.getElementById('modal-vehicle-cap-hint');
        if (modalVehicleCapHint) {
          if (chosen.type === 'sedan') modalVehicleCapHint.textContent = 'Max 4 Pax';
          else if (chosen.type === 'innova') modalVehicleCapHint.textContent = 'Max 6 Pax';
          else if (chosen.type === 'crysta') modalVehicleCapHint.textContent = 'Max 7 Pax';
          else modalVehicleCapHint.textContent = 'Up to 12 Pax';
        }

        if (webBookingForm) {
          webBookingForm.classList.remove('hidden');
          webBookingForm.reset();

          const dateInput = document.getElementById('modal-booking-date') as HTMLInputElement | null;
          const timeInput = document.getElementById('modal-booking-time') as HTMLInputElement | null;
          const flightLabel = document.getElementById('modal-flight-label');
          const flightInput = document.getElementById('modal-flight-input') as HTMLInputElement | null;
          const dateLabel = document.getElementById('modal-date-label');
          const timeLabel = document.getElementById('modal-time-label');
          const timezoneHelp = document.getElementById('modal-timezone-help');

          const nowIST = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Kolkata" }));
          const year = nowIST.getFullYear();
          const month = String(nowIST.getMonth() + 1).padStart(2, '0');
          const day = String(nowIST.getDate()).padStart(2, '0');
          const todayStr = `${year}-${month}-${day}`;

          if (dateInput) {
            dateInput.min = todayStr;
            dateInput.value = todayStr;
          }

          if (timeInput) {
            const futureIST = new Date(nowIST.getTime() + 2 * 60 * 60 * 1000);
            const hours = String(futureIST.getHours()).padStart(2, '0');
            timeInput.value = `${hours}:00`;
          }

          if (isDrop) {
            if (flightLabel) flightLabel.textContent = "Flight / Terminal (Optional)";
            if (flightInput) flightInput.placeholder = "e.g. AI 572 · T1 / T4";
            if (dateLabel) dateLabel.textContent = "Pickup Date *";
            if (timeLabel) timeLabel.textContent = "Pickup Time (IST) *";
            if (timezoneHelp) {
              timezoneHelp.textContent = "Doorstep pickup across Chennai · Chauffeur arrives 10m early";
            }
          } else {
            if (flightLabel) flightLabel.textContent = "Flight No. (Optional)";
            if (flightInput) flightInput.placeholder = "e.g. BA 35 / AI 572 / 6E 214";
            if (dateLabel) dateLabel.textContent = "Landing Date *";
            if (timeLabel) timeLabel.textContent = "Landing Time (IST) *";
            if (timezoneHelp) {
              timezoneHelp.textContent = "Chauffeur greets at arrival gate with placard · Free delay wait";
            }
          }
        }

        if (webBookingSuccess) webBookingSuccess.classList.add('hidden');
        webBookingModal.showModal();
      }

      function closeWebModal() {
        if (webBookingModal) webBookingModal.close();
      }

      if (openWebBookingBtn) openWebBookingBtn.onclick = () => openBookingModal();
      if (closeWebBookingBtn) closeWebBookingBtn.onclick = closeWebModal;
      if (closeSuccessModalBtn) closeSuccessModalBtn.onclick = closeWebModal;

      if (webBookingModal) {
        if (!('closedBy' in HTMLDialogElement.prototype)) {
          webBookingModal.addEventListener('click', (event: MouseEvent) => {
            if (event.target !== webBookingModal) return;
            const rect = webBookingModal.getBoundingClientRect();
            const isInside = (
              rect.top <= event.clientY &&
              event.clientY <= rect.top + rect.height &&
              rect.left <= event.clientX &&
              event.clientX <= rect.left + rect.width
            );
            if (!isInside) {
              closeWebModal();
            }
          });
        }
      }

      // Channel Selection & Device Detection (iOS vs Android vs Web)
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

      // Web Booking Form Submission Handler
      if (webBookingForm && webBookingSuccess) {
        webBookingForm.onsubmit = (e) => {
          e.preventDefault();
          const formData = new FormData(webBookingForm);
          const name = (formData.get('name') as string || '').trim();
          const email = (formData.get('email') as string || '').trim();
          const phone = (formData.get('phone') as string || '').trim();
          const passengers = (formData.get('passengers') as string || '1 Passenger').trim();
          const luggage = (formData.get('luggage') as string || '1 Bag').trim();
          const flight = (formData.get('flight_no') as string || '').trim();
          const transferDate = (formData.get('transfer_date') as string || '').trim();
          const transferTime = (formData.get('transfer_time') as string || '').trim();
          const notes = (formData.get('notes') as string || '').trim();
          const channel = (formData.get('dispatch_channel') as string) || 'whatsapp';

          const vehicles = [
            { type: 'sedan', name: 'Sedan (Dzire / Etios)', price: selectedDest?.sedan || '₹650' },
            { type: 'innova', name: 'SUV (Ertiga / Innova)', price: selectedDest?.innova || '₹1,150' },
            { type: 'crysta', name: 'VIP Crysta (Innova Crysta)', price: selectedDest?.crysta || '₹1,500' },
            { type: 'tempo', name: 'Tempo (12-Seater Coach)', price: selectedDest?.tempo || '₹2,400' },
          ];
          const chosen = vehicles.find((v) => v.type === selectedVehicle) || vehicles[0];
          const isDrop = currentMode === 'drop';
          const directionText = isDrop ? 'AIRPORT DROP (Doorstep ➔ Airport)' : 'AIRPORT PICKUP (Airport ➔ Doorstep)';
          const destName = selectedDest?.name || 'Chennai';
          const routeText = isDrop ? `${destName} ➔ Chennai Airport (MAA)` : `Chennai Airport (MAA) ➔ ${destName}`;

          let bookingMessage = `*NEW BOOKING: CHENNAI AIRPORT CAB*\n`;
          bookingMessage += `━━━━━━━━━━━━━━━━━━━━━\n`;
          bookingMessage += `🚖 *Service:* ${directionText}\n`;
          bookingMessage += `📍 *Route:* ${routeText}\n`;
          bookingMessage += `🚗 *Cab Category:* ${chosen.name}\n`;
          bookingMessage += `💰 *Fixed Tariff:* ${chosen.price} (Zero Surge Flat Fare)\n`;
          bookingMessage += `🛡️ *Payment:* ₹0 Advance Required (Pay driver via Cash/Card/UPI post-trip)\n`;
          bookingMessage += `━━━━━━━━━━━━━━━━━━━━━\n`;
          bookingMessage += `👤 *Passenger:* ${name}\n`;
          bookingMessage += `📱 *Phone:* ${phone}\n`;
          bookingMessage += `✉️ *Email:* ${email}\n`;
          bookingMessage += `👥 *Passengers:* ${passengers}\n`;
          bookingMessage += `🧳 *Luggage:* ${luggage}\n`;
          bookingMessage += `📅 *Date:* ${transferDate}\n`;
          bookingMessage += `⏰ *Time:* ${transferTime} IST (Chennai Time)\n`;
          if (flight) {
            bookingMessage += `✈️ *Flight No:* ${flight} (Live Radar Tracked)\n`;
            if (!isDrop) {
              bookingMessage += `🪧 *Airport Greeting:* Chauffeur meets with Name Placard at Gate\n`;
            }
          }
          bookingMessage += `━━━━━━━━━━━━━━━━━━━━━\n`;
          bookingMessage += `_Please confirm driver details & dispatch assignment._`;

          if (notes) {
            bookingMessage += `\n📝 *Notes:* ${notes}`;
          }

          if (channel === 'whatsapp') {
            const waUrl = `https://wa.me/916381939769?text=${encodeURIComponent(bookingMessage)}`;
            window.open(waUrl, '_blank');
          } else if (channel === 'sms') {
            const smsDivider = isIOS ? '&' : '?';
            const smsUrl = `sms:+916381939769${smsDivider}body=${encodeURIComponent(bookingMessage)}`;
            window.location.href = smsUrl;
          } else if (channel === 'email') {
            const emailSubject = `Airport Transfer Booking: ${directionText} - ${transferDate} - ${name}`;
            const mailtoUrl = `mailto:kalidasstravels2015@gmail.com?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(bookingMessage)}`;
            window.location.href = mailtoUrl;
          }

          webBookingForm.classList.add('hidden');
          webBookingSuccess.classList.remove('hidden');
          const successDetails = document.getElementById('success-booking-details');
          if (successDetails) {
            successDetails.textContent = `${directionText} | ${routeText} | ${chosen.name} (${chosen.price}) | ${transferDate} at ${transferTime} IST`;
          }
        };
      }

      // All 5 Zones Modal Handlers
      if (toggleAllZonesBtn && allZonesModal) {
        toggleAllZonesBtn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          allZonesModal.showModal();
          toggleAllZonesBtn.setAttribute('aria-expanded', 'true');
        };
      }
      if (closeZonesModalBtn && allZonesModal) {
        closeZonesModalBtn.onclick = (e) => {
          e.preventDefault();
          allZonesModal.close();
        };
      }
      if (closeZonesModalBottomBtn && allZonesModal) {
        closeZonesModalBottomBtn.onclick = (e) => {
          e.preventDefault();
          allZonesModal.close();
        };
      }
      if (allZonesModal) {
        allZonesModal.addEventListener('close', () => {
          if (toggleAllZonesBtn) toggleAllZonesBtn.setAttribute('aria-expanded', 'false');
        });
        if (!('closedBy' in HTMLDialogElement.prototype)) {
          allZonesModal.addEventListener('click', (event: MouseEvent) => {
            if (event.target !== allZonesModal) return;
            const rect = allZonesModal.getBoundingClientRect();
            const isInside = (
              rect.top <= event.clientY &&
              event.clientY <= rect.top + rect.height &&
              rect.left <= event.clientX &&
              event.clientX <= rect.left + rect.width
            );
            if (!isInside) {
              allZonesModal.close();
            }
          });
        }
      }

      modalZoneSelectBtns.forEach((btn) => {
        btn.onclick = () => {
          const zoneId = btn.getAttribute('data-zone-id');
          if (zoneId) {
            const matchedDest = destinations.find((d) => d.id === zoneId);
            if (matchedDest) {
              selectedDest = matchedDest;
              selectedFromChip = true;
              if (searchInput) searchInput.value = matchedDest.name;
              if (clearBtn) clearBtn.classList.remove('hidden');
              renderFinderState();
              if (allZonesModal) allZonesModal.close();
              const bookingEngine = document.getElementById('airport-fare-finder') || document.getElementById('zone-tariffs');
              if (bookingEngine) {
                bookingEngine.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
            }
          }
        };
      });

      const specVehicleBtns = document.querySelectorAll<HTMLButtonElement>('.spec-book-vehicle-btn');
      specVehicleBtns.forEach((btn) => {
        btn.onclick = () => {
          const vType = btn.dataset.vehicleType as 'sedan' | 'innova' | 'crysta' | 'tempo';
          if (vType) {
            selectedVehicle = vType;
            renderFinderState();
            const bookingEngine = document.getElementById('zone-tariffs') || document.getElementById('airport-booking-engine');
            if (bookingEngine) {
              bookingEngine.scrollIntoView({ behavior: 'smooth', block: 'start' });
              if (vehicleGrid) {
                vehicleGrid.classList.add('ring-2', 'ring-emerald-600', 'rounded-xl');
                setTimeout(() => {
                  vehicleGrid.classList.remove('ring-2', 'ring-emerald-600', 'rounded-xl');
                }, 1500);
              }
            }
          }
        };
      });

      // Vehicle Specifications: Horizontal carousel scroll & dots indicator sync
      const specScroller = document.getElementById('spec-fleet-scroller');
      const specDots = document.querySelectorAll<HTMLButtonElement>('.spec-dot');
      if (specScroller && specDots.length > 0) {
        const updateSpecDots = () => {
          const scrollLeft = specScroller.scrollLeft;
          const cardWidth = specScroller.offsetWidth * 0.75;
          const activeIdx = Math.min(Math.round(scrollLeft / cardWidth), specDots.length - 1);
          specDots.forEach((dot, idx) => {
            const bar = dot.querySelector<HTMLSpanElement>('.spec-dot-bar');
            if (bar) {
              if (idx === activeIdx) {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-slate-900 w-5';
              } else {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-slate-300 w-1.5';
              }
            }
          });
        };

        specScroller.addEventListener('scroll', updateSpecDots, { passive: true });

        specDots.forEach((dot) => {
          dot.onclick = () => {
            const idx = parseInt(dot.dataset.index || '0', 10);
            const cards = specScroller.querySelectorAll('.spec-fleet-card');
            if (cards[idx]) {
              cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
          };
        });
      }

      // Initial render of Airport Fare Finder (clean state, no auto-select, shows visible booking CTA)
      renderFinderState();
      setDirection(currentMode);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupAirportPageInteractions);
    } else {
      setupAirportPageInteractions();
    }
    document.addEventListener('astro:page-load', setupAirportPageInteractions);
  </script>

  <style is:global>
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    /* Chrome Modern Web Guidance: Native Dialog Top-Layer Animations (Baseline 2024) */
    dialog#web-booking-modal,
    dialog#all-zones-modal {
      border: none;
      padding: 1rem;
      background: transparent;
      max-width: 100vw;
      max-height: 100vh;
      margin: auto;
      overflow: visible;
      transition: 
        display 0.25s ease-out allow-discrete,
        overlay 0.25s ease-out allow-discrete,
        opacity 0.25s ease-out,
        transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      background-color: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      transition: 
        display 0.25s ease-out allow-discrete,
        overlay 0.25s ease-out allow-discrete,
        background-color 0.25s ease-out,
        backdrop-filter 0.25s ease-out,
        -webkit-backdrop-filter 0.25s ease-out;
    }

    dialog#web-booking-modal[open]::backdrop,
    dialog#all-zones-modal[open]::backdrop {
      background-color: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);

      @starting-style {
        background-color: rgba(0, 0, 0, 0);
        backdrop-filter: blur(0px);
        -webkit-backdrop-filter: blur(0px);
      }
    }

    /* Form validation UX: only flag errors after user has touched field */
    #web-booking-form input:user-invalid {
      border-color: #ef4444 !important;
    }

    /* Respect user preference for reduced motion */
    @media (prefers-reduced-motion: reduce) {
      dialog#web-booking-modal,
      dialog#web-booking-modal::backdrop,
      dialog#all-zones-modal,
      dialog#all-zones-modal::backdrop {
        transform: none;
        transition-duration: 0.05s;
      }
      @starting-style {
        dialog#web-booking-modal[open],
        dialog#all-zones-modal[open] {
          transform: none;
        }
      }
    }
  </style>
</Layout>
