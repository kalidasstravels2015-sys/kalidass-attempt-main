      "datePublished": "2026-03-22",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "reviewBody": "Flew from London Heathrow to Chennai (MAA). Skipped the long prepaid taxi counter line inside the arrival hall. Chauffeur was waiting outside T4 international exit with a name placard and cold AC Ertiga. Paid in cash INR after drop in Medavakkam. Exceptional service!"
    }
  ]
};

const howToSchema = {
  "@type": "HowTo",
  "@id": "https://kalidasstravels.in/services/chennai-airport-taxi/#howto",
  "name": "How to Book Chennai Airport Taxi Online (Arrival Pickup or Doorstep Drop)",
  "description": "Step-by-step procedure to book a fixed-rate Chennai Airport taxi or cab transfer with Kalidass Travels with zero advance deposit.",
  "totalTime": "PT2M",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Select Ride Direction & Pickup/Drop Location",
      "text": "Choose whether you need a doorstep cab To Airport (Drop) or terminal pickup From Airport (Arrival) and enter your address or hotel.",
      "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#booking-section"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Check Transparent Zone Fare & Select Vehicle",
      "text": "Review transparent zone tariffs from ₹650 flat. Pick between Sedan (Dzire/Etios), 6-seater Ertiga SUV, 7-seater Innova Crysta, or 12-seater Tempo Traveller.",
      "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-tariffs"
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Confirm with ₹0 Advance & Flight Details",
      "text": "Reserve with your travel date, pickup time, and flight number. No credit card or Indian bank OTP is required.",
      "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#booking-section"
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Meet Chauffeur at Arrival Gate or Doorstep",
      "text": "For airport arrivals, your chauffeur monitors live radar for delays and greets you at the terminal exit with a name board placard. For airport drops, driver arrives 20-30 mins early.",
      "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#terminal-pickup-drop-guide"
    }
  ]
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/chennai-airport-taxi/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a.replace(/<[^>]*>/g, '')
    }
  }))
};

// Route-level Trip + ItemList schema — enables AEO rich answers for
// "Chennai airport to [destination] taxi fare" queries in Google SGE / AI Overviews
const tripListSchema = {
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-route-list",
  "name": "Chennai Airport (MAA) Transfer Zone Fares — All Routes",
  "description": "Fixed flat-rate taxi fares from Chennai International Airport (MAA) to all major city zones and outstation destinations.",
  "numberOfItems": zoneTariffs.length,
  "itemListElement": zoneTariffs.map((z, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Trip",
      "@id": `https://kalidasstravels.in/services/chennai-airport-taxi/#route-${z.id}`,
      "name": `Chennai Airport (MAA) to ${z.zone} Taxi`,
      "description": `Direct airport taxi from Chennai International Airport (MAA) to ${z.destinations}. Fixed flat rate — Sedan ₹${z.sedan}, Innova ${z.innova}, Innova Crysta ${z.crysta}, Tempo Traveller ${z.tempo}. Distance: ${z.distance}. Drive time: ${z.eta}. Zero surge, no advance payment.`,
      "provider": { "@id": "https://kalidasstravels.in/#localbusiness" },
      "itinerary": [
        {
          "@type": "Place",
          "name": "Chennai International Airport (MAA)",
          "identifier": "MAA"
        },
        {
          "@type": "Place",
          "name": z.zone,
          "description": z.destinations
        }
      ],
      "offers": [
        {
          "@type": "Offer",
          "name": `Sedan (4 Pax) — ${z.zone}`,
          "description": `Swift Dzire / Etios airport taxi to ${z.zone}. ${z.eta}, ${z.distance}.`,
          "price": z.sedan.replace(/[^0-9]/g, ''),
          "priceCurrency": "INR",
          "priceValidUntil": "2027-12-31",
          "availability": "https://schema.org/InStock",
          "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-tariffs",
          "seller": { "@id": "https://kalidasstravels.in/#localbusiness" }
        },
        {
          "@type": "Offer",
          "name": `Innova / Ertiga (6 Pax) — ${z.zone}`,
          "description": `Maruti Ertiga / Innova airport taxi to ${z.zone}. ${z.eta}, ${z.distance}.`,
          "price": z.innova.replace(/[^0-9]/g, ''),
          "priceCurrency": "INR",
          "priceValidUntil": "2027-12-31",
          "availability": "https://schema.org/InStock",
          "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-tariffs",
          "seller": { "@id": "https://kalidasstravels.in/#localbusiness" }
        },
        {
          "@type": "Offer",
          "name": `Innova Crysta VIP (7 Pax) — ${z.zone}`,
          "description": `Innova Crysta executive airport taxi to ${z.zone}. ${z.eta}, ${z.distance}.`,
          "price": z.crysta.replace(/[^0-9]/g, ''),
          "priceCurrency": "INR",
          "priceValidUntil": "2027-12-31",
          "availability": "https://schema.org/InStock",
          "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-tariffs",
          "seller": { "@id": "https://kalidasstravels.in/#localbusiness" }
        },
        {
          "@type": "Offer",
          "name": `Tempo Traveller (12 Pax) — ${z.zone}`,
          "description": `Tempo Traveller group taxi to ${z.zone}. ${z.eta}, ${z.distance}.`,
          "price": z.tempo.replace(/[^0-9]/g, ''),
          "priceCurrency": "INR",
          "priceValidUntil": "2027-12-31",
          "availability": "https://schema.org/InStock",
          "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-tariffs",
          "seller": { "@id": "https://kalidasstravels.in/#localbusiness" }
        }
      ]
    }
  }))
};
---

<Layout 
  title={`${title} | Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/airport-transfer.webp"
  ogImage="/og/chennai-airport-taxi.jpg"
  schema={[taxiServiceSchema, productSchema, faqSchema, howToSchema, tripListSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="bg-m3-surface text-m3-on-surface font-sans pb-6">
    <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 pt-1 sm:pt-2">

      <!-- TOP PAGE HEADING & TRUST BADGES -->
      <div class="max-w-2xl mx-auto mb-2 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5 sm:gap-2">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-m3-label-s font-semibold mb-1">
            <span class="w-2 h-2 rounded-m3-full bg-m3-success animate-pulse"></span>
            <span>24/7 MAA Airport Transfers</span>
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface font-heading tracking-tight leading-tight">
            Chennai Airport Taxi &amp; Cab Booking
          </h1>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant font-medium mt-0.5">
            Terminals 1, 2 &amp; 4 · Fixed Fares from ₹650 · ₹500 Token Advance for Outstation
          </p>
        </div>
        <div class="flex items-center justify-center sm:justify-end gap-2 shrink-0">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container-lowest border border-m3-outline-variant shadow-m3-1 text-m3-label-m font-semibold text-m3-on-surface">
            <span class="material-symbols-outlined text-m3-tertiary text-base">star</span>
            <span>4.9★ (5,000+ Trips)</span>
          </span>
        </div>
      </div>

      <!-- AEO QUICK FACTS DIRECT ANSWER TARGET (PARSED BY GOOGLE AI OVERVIEWS & PERPLEXITY) -->
      <section aria-label="Quick summary of Chennai Airport taxi and cab services" class="max-w-2xl mx-auto mb-3 p-3.5 sm:p-4 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/60 shadow-2xs">
        <h2 class="text-xs sm:text-sm font-bold text-m3-on-surface mb-1.5 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-m3-primary text-base">info</span>
          <span>Quick Facts: Chennai Airport Taxi &amp; Cab Service (MAA)</span>
        </h2>
        <p data-speakable="true" class="text-xs text-m3-on-surface-variant leading-relaxed">
          Doorstep Chennai airport transfers start from <strong>₹650 Flat</strong> for an AC Sedan across <strong>T1, T2 &amp; T4</strong> terminals. Enjoy <strong>100% Free Wait</strong> with automated live flight radar tracking. A reliable, transparent alternative to Chennai airport prepaid taxi with driver details sent on WhatsApp before takeoff.
        </p>
      </section>

      <!-- 1. BOOKING ENGINE AT THE TOP -->
      <div id="booking-section" class="scroll-mt-24"></div>
      <section class="relative py-0.5 px-1 sm:px-2 max-w-2xl mx-auto mb-2">
        <AirportBookingEngine client:load showHeader={false} />

        <!-- M3 Trust Reassurance Strip with Material Symbols -->
        <div class="mt-2.5 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-m3-label-s text-m3-on-surface-variant font-medium">
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-m3-primary text-base shrink-0">verified_user</span>
            <span class="font-bold text-m3-on-surface">₹500 Token Advance • Balance at Drop</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-m3-on-surface-variant text-base shrink-0">schedule</span>
            <span>Free Flight Radar Tracking</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-m3-on-surface-variant text-base shrink-0">badge</span>
            <span>Name Placard Meet &amp; Greet</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-m3-on-surface-variant text-base shrink-0">receipt_long</span>
            <span>GST Tax Invoices</span>
          </div>
        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (M3 Pill Bar) -->
      <nav data-quick-nav aria-label="Airport Taxi Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-b border-m3-outline-variant/60 shadow-m3-1 py-2.5 mb-6 -mx-3 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-m3-label-m font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <a href="#booking-section" data-active="true" aria-current="true" class="px-3.5 py-1.5 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0 hover:bg-m3-primary hover:text-white">
            Calculate Fare
          </a>
          <a href="#arrival-protocol" class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Arrival Protocol
          </a>
          <a href="#outstation-fares" class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Outstation Fares
          </a>
          <a href="#fleet-section" class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Vehicle Fleet
          </a>
          <a href="#prepaid-taxi-comparison" class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Prepaid Comparison
          </a>
          <a href="#airport-faq" class="px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Airport FAQs
          </a>
        </div>
      </nav>

      <!-- 2. OUR GUARANTEE & TERMINAL PICKUP GUIDE -->
      <div id="arrival-protocol" class="scroll-mt-28"></div>
      <section id="terminal-pickup-drop-guide" class="rounded-m3-xl bg-m3-surface-container-lowest border border-m3-outline-variant shadow-2xs p-3.5 sm:p-5 mb-6 sm:mb-8 scroll-mt-28">
        <div class="flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-m3-outline-variant">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-m3-lg bg-m3-primary/10 text-m3-primary flex items-center justify-center shrink-0 border border-m3-primary/20">
              <span class="material-symbols-outlined text-base">verified_user</span>
            </span>
            <h2 class="text-base sm:text-lg font-extrabold text-m3-on-surface font-heading leading-none">
              Terminal Pick Up &amp; Drop Guide (T1, T2 &amp; T4)
            </h2>
          </div>
          <span class="text-xs text-m3-on-surface-variant font-medium hidden sm:inline">
            T1, T2 &amp; T4 Terminals · 24/7 Operations
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 text-xs sm:text-sm">
          <!-- Airport Pickup Protocol -->
          <div class="p-3 sm:p-3.5 rounded-m3-lg bg-m3-surface border border-m3-outline-variant/80">
            <div class="flex items-center gap-2 font-bold text-xs sm:text-sm text-m3-primary pb-2 mb-2.5 border-b border-m3-outline-variant/50">
              <svg class="w-5 h-5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2.5 19h19v2h-19v-2zm16.84-5.46c.74-.35 1.04-1.24.69-1.98l-.7-1.48c-.35-.74-1.24-1.04-1.98-.69l-5.32 2.51-6.1-5.11c-.37-.31-.88-.41-1.39.11l-.87.96c-.33.36-.33.91.11 1.39l4.22 4.68-4.38 2.06-2.83-.73c-.28-.07-.57-.03-.81.11-.28.16-.48.42-.56.73l-.22.96c-.09.39.06.79.37 1.03.3.24.71.28 1.06.12l4.47-1.36 14.25-6.72z"/>
              </svg>
              <span>Arrival Pick Up Protocol (Terminal 1, 2 &amp; 4)</span>
            </div>
            <ul class="space-y-2 text-m3-on-surface text-xs sm:text-sm font-medium">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">1</span>
                <span><strong>Automated Flight Tracking:</strong> Free waiting if domestic or foreign flight is delayed</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">2</span>
                <span><strong>Terminal Exit Meet &amp; Greet:</strong> Chauffeur meets you at T1, T2 &amp; T4 arrival exits with name placard</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">3</span>
                <span><strong>Driver Allotted Before Take-Off:</strong> Chauffeur name, phone &amp; car details sent to WhatsApp before you take off</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">4</span>
                <span><strong>Curbside AC Cab Pickup:</strong> Direct ride with balance settlement at destination</span>
              </li>
            </ul>
          </div>

          <!-- Airport Drop Protocol -->
          <div class="p-3 sm:p-3.5 rounded-m3-lg bg-m3-surface border border-m3-outline-variant/80">
            <div class="flex items-center gap-2 font-bold text-xs sm:text-sm text-m3-primary pb-2 mb-2.5 border-b border-m3-outline-variant/50">
              <svg class="w-5 h-5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2.5 19h19v2h-19v-2zm19.57-9.36c-.21-.8-1.04-1.28-1.84-1.06L14.92 10 8.35 3.73c-.15-.14-.35-.23-.56-.23-.27 0-.52.12-.68.32l-.83.99c-.16.19-.22.44-.17.68.05.24.2.45.41.56l4.57 4.34-4.5 1.21-2.48-1.59c-.21-.14-.47-.19-.72-.15-.26.04-.49.18-.65.39l-.54.83c-.29.44-.17 1.03.26 1.33l3.77 2.76 14.15-3.8c.8-.21 1.28-1.05 1.06-1.84z"/>
              </svg>
              <span>Doorstep Airport Drop Protocol</span>
            </div>
            <ul class="space-y-2 text-m3-on-surface text-xs sm:text-sm font-medium">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">1</span>
                <span><strong>Guaranteed On-Time Doorstep Pickup:</strong> Chauffeur arrives ahead of schedule</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">2</span>
                <span><strong>Direct Elevated Ramp Drop:</strong> Curbside departure baggage drop at T1, T2 or T4 terminal</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">3</span>
                <span><strong>Driver Details Before Pickup:</strong> Chauffeur details sent 2 hrs prior (or by 9 PM previous night for early morning drops)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">4</span>
                <span><strong>100% Fixed Transparent Fares:</strong> Zero midnight surge pricing; balance at airport</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-3 pt-2.5 border-t border-m3-outline-variant/60 flex items-center gap-2 text-xs text-m3-on-surface-variant">
          <svg class="w-4 h-4 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span><strong>Corporate Invoicing (GSTIN: 33COVPM0531D1Z4):</strong> 100% itemized GST tax invoices for business claims and input tax credit.</span>
        </div>
      </section>

      <!-- 3. OUTSTATION TARIFF CHART -->
      <section id="outstation-fares" class="pt-5 sm:pt-6 mt-5 sm:mt-6 border-t border-m3-outline-variant mb-8 sm:mb-10 scroll-mt-28">
        <div id="highway-corridors" class="scroll-mt-28"></div>
        <div id="zone-tariffs" class="scroll-mt-28"></div>

        <div id="all-zones-container" class="mt-2 mb-6">
          <!-- Section Header (Clean Flat Section, not a card) -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 pb-2.5 mb-3 border-b border-m3-outline-variant">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-8 h-8 rounded-xl bg-m3-primary/10 text-m3-primary flex items-center justify-center shrink-0 border border-m3-primary/20 shadow-2xs">
                <svg class="w-4 h-4 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2v20"/>
                  <path d="M18 5H6a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h12l3-2-3-2z"/>
                  <path d="M6 13h12a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H6l-3-2 3-2z"/>
                </svg>
              </span>
              <div class="min-w-0">
                <h2 class="text-base sm:text-lg md:text-xl font-extrabold text-m3-on-surface font-heading block leading-tight">
                  Chennai Airport Outstation Taxi Fare &amp; Rates Chart
                </h2>
                <span class="text-xs text-m3-on-surface-variant block mt-0.5">
                  Fixed flat taxi rates from Chennai Airport (MAA) to popular outstation destinations. Same flat rate for pickups &amp; drops · Tolls and airport parking at actuals.
                </span>
              </div>
            </div>
          </div>

          <!-- MOBILE ACCORDION LIST (hidden on desktop sm+) -->
          <div class="sm:hidden space-y-1.5 mb-4">
            {zoneTariffs.map((t) => (
              <details
                class="group rounded-xl border border-m3-outline-variant bg-white overflow-hidden shadow-2xs transition-all duration-150 open:border-m3-primary/40 open:shadow-xs"
                data-zone={t.zone}
                data-corridor={t.zone.split('&')[0].trim()}
              >
                <summary class="flex items-center justify-between px-3 py-2.5 cursor-pointer list-none gap-2 select-none hover:bg-m3-surface-container/50 transition-colors">
                  <div class="flex items-center gap-2 min-w-0 flex-1">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5">
                        <span class="font-semibold text-m3-on-surface text-[13px] leading-snug truncate">{t.zone}</span>
                        {t.popular && (
                          <span class="shrink-0 px-1.5 py-px rounded-full bg-m3-success-container/70 text-m3-on-surface text-[9px] font-bold uppercase tracking-wider border border-m3-outline-variant">★</span>
                        )}
                      </div>
                      <span class="text-[10px] text-m3-on-surface-variant leading-none mt-0.5 block">
                        {t.eta} · {t.distance}
                      </span>
                    </div>
