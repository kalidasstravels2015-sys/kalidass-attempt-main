---

<Layout 
  title={`${title} | Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/airport-transfer.webp"
  ogImage="/og/chennai-airport-taxi.jpg"
  schema={[taxiServiceSchema, productSchema, faqSchema, howToSchema]}
  preloadHero={{
    href: "/images/services/airport-transfer.webp"
  }}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="bg-slate-50 text-slate-900 font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">

      <!-- 1. SIGNATURE HERO SECTION -->
      <section class="group relative min-h-[220px] sm:min-h-[260px] md:min-h-[280px] rounded-2xl overflow-hidden shadow-md border border-slate-800 bg-slate-950 flex flex-col justify-end p-5 sm:p-7 md:p-8 mb-6 sm:mb-8 transition-all duration-300">
        <!-- Background Image with Scrim -->
        <OptimizedImage
          src="/images/services/airport-transfer.webp"
          alt="Kalidass Travels - Chennai Airport Taxi & Transfers (Pickup & Drop)"
          class="absolute inset-0 w-full h-full object-cover object-[62%_top] sm:object-[center_28%] transition-transform duration-700 group-hover:scale-105 opacity-80"
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 768px) 100vw, 1024px"
        />
        <!-- High-Contrast Scrim Gradient for 100% Text Legibility while keeping image vivid -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40 sm:bg-gradient-to-r sm:from-slate-950/95 sm:via-slate-950/70 sm:to-transparent"></div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold mb-2.5 backdrop-blur-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>24/7 MAA Airport Transfers</span>
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight font-heading drop-shadow-sm">
              Chennai Airport Taxi &amp; Cab Booking
            </h1>
            <p class="text-xs sm:text-sm md:text-base text-slate-200 mt-2 font-normal leading-relaxed max-w-2xl drop-shadow-xs">
              Planning your trip early? Reserve for ₹0 advance today with no credit card required. Pay only after your ride completes safely. Free live flight radar tracking &amp; name-board greeting for all travelers.
            </p>
          </div>
          <div class="hidden sm:flex flex-col items-end shrink-0">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-xs text-white font-medium">
              <span class="material-symbols-outlined text-emerald-400 text-[16px]">verified</span>
              Direct ramp drop T1, T2 &amp; T4 · Free Placard
            </span>
          </div>
        </div>
      </section>

      <!-- 2. STICKY DIRECTION BAR (Docks beneath top navbar on scroll) -->
      <div 
        id="sticky-direction-bar" 
        class="sticky top-16 z-30 bg-slate-50/90 backdrop-blur-md py-2 transition-all mb-3 sm:mb-4"
        role="region"
        aria-label="Airport Transfer Direction Switcher"
      >
        <div class="max-w-2xl mx-auto flex items-center justify-between gap-2.5 bg-white/95 rounded-full border border-slate-200/90 shadow-2xs px-3 sm:px-4 py-1.5">
          <!-- Active Mode Indicator with Live Dot -->
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <div class="min-w-0">
              <span class="text-[9px] font-bold uppercase tracking-wider text-slate-600 block leading-tight">Active Transfer</span>
              <strong id="sticky-direction-indicator" class="text-xs sm:text-sm font-extrabold text-slate-900 truncate block font-heading leading-tight">
                Landing at Airport (Pickup)
              </strong>
            </div>
          </div>

          <!-- Tactile Segmented Pill Switcher -->
          <div class="inline-flex p-0.5 rounded-full bg-slate-100 border border-slate-200/80 shadow-inner shrink-0" role="tablist" aria-label="Airport Transfer Direction">
            <button 
              type="button" 
              id="tab-btn-drop"
              role="tab"
              aria-selected="false"
              class="flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer active:scale-95"
