        class="group relative min-h-[200px] sm:min-h-[240px] md:min-h-[260px] rounded-2xl overflow-hidden shadow-md border border-m3-outline-variant/60 bg-m3-inverse-surface flex flex-col justify-end p-5 sm:p-7 md:p-8 mb-8 transition-all duration-300" 
        aria-label="Quick summary of Chennai Airport taxi and cab services"
      >
        <!-- Background Image with Scrim -->
        <OptimizedImage
          src="/images/services/airport-transfer.webp"
          alt="Kalidass Travels - Chennai Airport Taxi & Transfers"
          class="absolute inset-0 w-full h-full object-cover object-[62%_top] sm:object-[center_28%] transition-transform duration-700 group-hover:scale-105 opacity-80"
          loading="lazy"
          fetchpriority="auto"
          sizes="(max-width: 768px) 100vw, 1024px"
        />
        <!-- High-Contrast Scrim Gradient for 100% Text Legibility -->
        <div class="absolute inset-0 bg-gradient-to-t from-m3-inverse-surface via-m3-inverse-surface/85 to-m3-inverse-surface/50 sm:bg-gradient-to-r sm:from-m3-inverse-surface/95 sm:via-m3-inverse-surface/80 sm:to-transparent"></div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white text-xs font-bold mb-2 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
              <span>Quick Facts: Chennai Airport Taxi &amp; Cab Service (MAA)</span>
            </div>
            <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-white tracking-tight leading-tight font-heading drop-shadow-sm">
              Official MAA Airport Meet &amp; Greet
            </h2>
            <p data-speakable="true" class="text-xs sm:text-sm md:text-base text-m3-inverse-on-surface mt-2 font-normal leading-relaxed max-w-2xl drop-shadow-xs pr-8 sm:pr-0">
              Doorstep Chennai airport transfers start from <strong class="text-white font-bold">₹650 Flat</strong> for an AC Sedan across <strong class="text-white font-semibold">T1, T2 &amp; T4</strong> terminals. Enjoy <strong class="text-white font-semibold">100% Free Wait</strong> with automated live flight radar tracking. A reliable, transparent alternative to <strong class="text-white font-semibold">Chennai airport prepaid taxi</strong> with driver details sent on WhatsApp before takeoff.
            </p>

            <!-- 4 Quick Fact Badges -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-3 pt-3 border-t border-white/15 text-xs">
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 border border-white/15">
                <span class="text-white/80 block text-xs font-medium">Starting Fare</span>
                <span class="font-bold text-white text-xs sm:text-sm">₹650 Flat</span>
              </div>
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 border border-white/15">
                <span class="text-white/80 block text-xs font-medium">Terminals Served</span>
                <span class="font-bold text-white text-xs sm:text-sm">T1, T2 &amp; T4</span>
              </div>
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 border border-white/15">
                <span class="text-white/80 block text-xs font-medium">Flight Delays</span>
                <span class="font-bold text-white text-xs sm:text-sm">100% Free Wait</span>
              </div>
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 border border-white/15">
                <span class="text-white/80 block text-xs font-medium">Driver Details</span>
                <span class="font-bold text-white text-xs sm:text-sm">Before Take-Off</span>
              </div>
            </div>
          </div>

          <div class="hidden sm:flex flex-col items-end shrink-0">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-xs text-white font-medium">
              <CheckCircle2 className="w-4 h-4 text-m3-success shrink-0" />
              Automated Flight Radar Tracking
            </span>
          </div>
        </div>
      </section>

      <!-- 2. OUR GUARANTEE & TERMINAL PICKUP GUIDE -->
      <div id="arrival-protocol" class="scroll-mt-28"></div>
      <div id="commitments" class="scroll-mt-28"></div>
      <section id="terminal-pickup-drop-guide" class="rounded-2xl bg-m3-surface-container-lowest border border-m3-outline-variant shadow-sm p-4 sm:p-6 mb-8 relative overflow-hidden scroll-mt-28">
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5 sm:gap-3 pb-3 mb-4 border-b border-m3-outline-variant">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-m3-primary text-white flex items-center justify-center shrink-0 shadow-xs">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <h2 class="text-lg sm:text-xl font-bold text-m3-on-surface font-heading leading-tight">
              Terminal Pick Up &amp; Drop Guide (T1, T2 &amp; T4)
            </h2>
          </div>
          <span class="text-xs font-bold text-m3-on-surface bg-m3-surface-container border border-m3-outline-variant px-3 py-1 rounded-full shrink-0">
            T1, T2 &amp; T4 Terminals · 24/7 Operations
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 text-xs sm:text-sm">
          <!-- Airport Pickup Protocol -->
          <div class="p-3.5 sm:p-4 rounded-xl bg-m3-surface border border-m3-outline-variant/80 shadow-2xs">
            <div class="flex items-center gap-2 font-bold text-xs sm:text-sm text-m3-primary pb-2 mb-2.5 border-b border-m3-outline-variant/50">
              <svg class="w-5 h-5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2.5 19h19v2h-19v-2zm16.84-5.46c.74-.35 1.04-1.24.69-1.98l-.7-1.48c-.35-.74-1.24-1.04-1.98-.69l-5.32 2.51-6.1-5.11c-.37-.31-.88-.41-1.39.11l-.87.96c-.33.36-.33.91.11 1.39l4.22 4.68-4.38 2.06-2.83-.73c-.28-.07-.57-.03-.81.11-.28.16-.48.42-.56.73l-.22.96c-.09.39.06.79.37 1.03.3.24.71.28 1.06.12l4.47-1.36 14.25-6.72z"/>
              </svg>
              <span>Arrival Pick Up Protocol (Terminal 1, 2 &amp; 4)</span>
            </div>
            <ul class="space-y-2 text-m3-on-surface text-xs sm:text-sm font-medium">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
                <span><strong>Automated Flight Tracking:</strong> Free waiting if domestic or foreign flight is delayed</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
                <span><strong>Terminal Exit Meet &amp; Greet:</strong> Chauffeur meets you at T1, T2 &amp; T4 arrival exits with name placard</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
                <span><strong>Driver Allotted Before Take-Off:</strong> Chauffeur name, phone &amp; car details sent to WhatsApp before you take off</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">4</span>
                <span><strong>Curbside AC Cab Pickup:</strong> Direct ride with balance settlement at destination</span>
              </li>
            </ul>
          </div>

          <!-- Airport Drop Protocol -->
          <div class="p-3.5 sm:p-4 rounded-xl bg-m3-surface border border-m3-outline-variant/80 shadow-2xs">
            <div class="flex items-center gap-2 font-bold text-xs sm:text-sm text-m3-primary pb-2 mb-2.5 border-b border-m3-outline-variant/50">
              <svg class="w-5 h-5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2.5 19h19v2h-19v-2zm19.57-9.36c-.21-.8-1.04-1.28-1.84-1.06L14.92 10 8.35 3.73c-.15-.14-.35-.23-.56-.23-.27 0-.52.12-.68.32l-.83.99c-.16.19-.22.44-.17.68.05.24.2.45.41.56l4.57 4.34-4.5 1.21-2.48-1.59c-.21-.14-.47-.19-.72-.15-.26.04-.49.18-.65.39l-.54.83c-.29.44-.17 1.03.26 1.33l3.77 2.76 14.15-3.8c.8-.21 1.28-1.05 1.06-1.84z"/>
              </svg>
              <span>Doorstep Airport Drop Protocol</span>
            </div>
            <ul class="space-y-2 text-m3-on-surface text-xs sm:text-sm font-medium">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
                <span><strong>Guaranteed On-Time Doorstep Pickup:</strong> Chauffeur arrives ahead of schedule</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
                <span><strong>Direct Elevated Ramp Drop:</strong> Curbside departure baggage drop at T1, T2 or T4 terminal</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
                <span><strong>Driver Details Before Pickup:</strong> Chauffeur details sent 2 hrs prior (or by 9 PM previous night for early morning drops)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">4</span>
                <span><strong>100% Fixed Transparent Fares:</strong> Zero midnight surge pricing; balance at airport</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Corporate GST Invoicing Card (Matching Outstation Cabs Page) -->
      <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-m3-surface-container-lowest border border-m3-outline-variant shadow-sm">
        <div class="flex items-start gap-3.5">
          <span class="w-8 h-8 rounded-xl bg-m3-surface-container text-m3-on-surface flex items-center justify-center shrink-0 border border-m3-outline-variant">
            <Building2 className="w-5 h-5 text-m3-on-surface" />
          </span>
          <div>
            <h3 class="text-sm sm:text-base font-bold text-m3-on-surface font-heading leading-tight mb-1">
              Corporate GST Invoicing &amp; Executive Desks
            </h3>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed">
              Itemized GST tax invoices (GSTIN: 33COVPM0531D1Z4) for corporate travel reimbursement, monthly billing accounts, and executive airport transfers.
            </p>
          </div>
        </div>
      </div>

      <!-- 3. VEHICLE SPECIFICATIONS & LUGGAGE CAPACITIES (Unified Fleet) -->
      <section id="fleet-section" class="pt-6 sm:pt-8 mt-6 sm:mt-8 border-t border-m3-outline-variant mb-10 sm:mb-14 scroll-mt-28">
        <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-10">
          <span class="text-xs font-bold uppercase tracking-wider text-m3-primary">All-Inclusive Fares • No Hidden Charges</span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-m3-on-surface font-heading tracking-tight mt-1">
            Vehicle Specifications &amp; Luggage Capacities
          </h2>
          <p class="text-m3-on-surface-variant mt-2 text-xs sm:text-sm">
            Clean AC cabs with dedicated luggage boots, doorstep pickup, and verified drivers.
          </p>
        </div>

        <!-- Fleet Grid/Scroll Container (Horizontal Order like Outstation & Home Page) -->
        <div class="relative group/fleet">
          <!-- Horizontal Swipe Container on Mobile, 4-Col Grid on Desktop -->
          <div
            id="spec-fleet-scroller"
            class="flex overflow-x-auto snap-x snap-mandatory pb-4 space-x-4 px-1 sm:px-2 md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-4 md:space-x-0 md:overflow-visible md:pb-0 scrollbar-hide focus:outline-none"
            tabindex="0"
            role="region"
            aria-label="Airport Fleet Gallery"
          >
            {airportFleet.map((vehicle) => {
              const seats = vehicle.capsShort.includes('Pax') ? vehicle.capsShort.replace('Pax', 'Passengers') : vehicle.capsShort;
              const luggageShort = vehicle.type === 'tempo' ? '8–10 Bags' : vehicle.type === 'crysta' ? '5 Bags' : vehicle.type === 'innova' ? '4 Bags' : '2 Bags';
              return (
                <VehicleCard
                  className="shrink-0 w-72 sm:w-80 md:w-auto snap-center md:snap-align-none"
                  name={vehicle.name}
                  image={vehicle.image}
                  badge={vehicle.badge}
                  seats={seats}
                  baggage={luggageShort}
                  priceLabel="Airport Flat"
                  priceSubtext="Ramp Drop & Tolls Inc."
                  price={vehicle.price}
                  actionText={`Book ${vehicle.shortName}`}
                  actionClass="spec-book-vehicle-btn"
                  dataAttributes={{
                    'data-vehicle-type': vehicle.type,
                    'data-vehicle-name': vehicle.name,
                    'data-vehicle-price': vehicle.price,
                  }}
                />
              );
            })}
          </div>

          <!-- Scroll Indicator Dots (Mobile Only) -->
          <div id="spec-fleet-dots" class="flex justify-center items-center mt-3.5 space-x-1 md:hidden">
            {airportFleet.map((_, index) => (
              <button
                type="button"
                class="min-w-[32px] min-h-[32px] flex items-center justify-center p-1.5 cursor-pointer spec-dot"
                data-index={index}
                aria-label={`Go to slide ${index + 1}`}
              >
                <span class={`h-1.5 rounded-full transition-all duration-300 spec-dot-bar ${index === 0 ? 'bg-m3-primary w-5' : 'bg-m3-outline-variant w-1.5'}`}></span>
              </button>
            ))}
          </div>
        </div>

        <!-- Transparent Calculation Rules & Guidelines -->
        <div class="mt-6 bg-m3-surface-container-low rounded-2xl p-4 sm:p-5 border border-m3-outline-variant shadow-xs">
          <div class="flex items-start gap-2 mb-3">
            <Info className="w-5 h-5 text-m3-primary shrink-0 mt-0.5" />
            <p class="text-xs text-m3-on-surface-variant leading-relaxed">
              Fixed flat rates for both terminal pickups and doorstep drops. Dedicated luggage boot space. Tolls and official parking at actual receipts.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-m3-outline-variant/60 shadow-2xs">
              <div class="w-7 h-7 rounded-lg bg-m3-primary text-white flex items-center justify-center shrink-0 font-bold text-xs">
                01
              </div>
              <div>
                <h4 class="text-xs font-bold text-m3-on-surface">100% Fixed Flat Fares</h4>
                <p class="text-xs text-m3-on-surface-variant mt-0.5 leading-relaxed">Transparent rates from ₹650. Zero midnight, rain, or rush-hour surge pricing.</p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-m3-outline-variant/60 shadow-2xs">
              <div class="w-7 h-7 rounded-lg bg-m3-success-container text-m3-on-success-container flex items-center justify-center shrink-0 font-bold text-xs">
                02
              </div>
              <div>
                <h4 class="text-xs font-bold text-m3-on-surface">100% Free Delay Waiting</h4>
                <p class="text-xs text-m3-on-surface-variant mt-0.5 leading-relaxed">Automated live flight radar tracking. No waiting penalties if flights are delayed.</p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-m3-outline-variant/60 shadow-2xs">
              <div class="w-7 h-7 rounded-lg bg-m3-surface-container-high text-m3-primary flex items-center justify-center shrink-0 font-bold text-xs">
                03
              </div>
