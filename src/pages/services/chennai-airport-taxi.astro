---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const title = "Chennai Airport Taxi & Cab Booking (MAA) from ₹650";
const description = "Chennai International Airport (MAA) taxi transfers by Kalidass Travels. Rapid 5-10 min terminal dispatch, zero-delay flight tracking, Meet & Greet, flat pricing from ₹650.";
const keywords = "chennai airport taxi, chennai airport cab booking, maa airport pickup taxi, chennai airport drop cab, prepaid taxi chennai airport, airport transfer chennai, chennai airport cab fare";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Airport Transfers", item: "/services/chennai-airport-taxi/" },
];

const zoneTariffs = [
  {
    zone: "OMR & IT Corridor",
    destinations: "Perungudi, Thoraipakkam, Sholinganallur, Navalur, Siruseri SIPCOT",
    sedan: "₹1,250",
    innova: "₹1,850",
    crysta: "₹2,300",
    tempo: "₹3,400",
    eta: "25–40 mins",
    popular: true,
    whatsappMsg: "Hi Kalidass Travels, I need an Airport Transfer between Chennai Airport (MAA) and OMR IT Corridor."
  },
  {
    zone: "Central & Downtown",
    destinations: "Chennai Central, Egmore, T. Nagar, Nungambakkam, Anna Nagar",
    sedan: "₹950",
    innova: "₹1,550",
    crysta: "₹1,950",
    tempo: "₹2,900",
    eta: "30–45 mins",
    popular: false,
    whatsappMsg: "Hi Kalidass Travels, I need an Airport Transfer between Chennai Airport (MAA) and Central/Egmore/T Nagar."
  },
  {
    zone: "South Chennai & Suburbs",
    destinations: "Guindy, Pallavaram, Tambaram, Medavakkam, Velachery, Chromepet",
    sedan: "₹650",
    innova: "₹1,150",
    crysta: "₹1,500",
    tempo: "₹2,400",
    eta: "10–20 mins",
    popular: false,
    whatsappMsg: "Hi Kalidass Travels, I need an Airport Transfer between Chennai Airport (MAA) and South Chennai / Medavakkam / Tambaram."
  },
  {
    zone: "ECR Coastal & Resorts",
    destinations: "Kovalam, Mahabalipuram, Nemmeli, InterContinental, Radisson Blu Temple Bay",
    sedan: "₹1,650",
    innova: "₹2,400",
    crysta: "₹2,950",
    tempo: "₹4,200",
    eta: "45–60 mins",
    popular: true,
    whatsappMsg: "Hi Kalidass Travels, I need an Airport Transfer between Chennai Airport (MAA) and ECR / Mahabalipuram."
  },
  {
    zone: "Airport ⇄ Pondicherry Direct",
    destinations: "Auroville, White Town, Promenade Beach, JIPMER (Direct from Flight)",
    sedan: "₹3,900",
    innova: "₹5,600",
    crysta: "₹6,800",
    tempo: "₹8,900",
    eta: "2.5–3 hrs",
    popular: true,
    whatsappMsg: "Hi Kalidass Travels, I need a Direct Airport Transfer from Chennai Airport (MAA) to Pondicherry."
  },
  {
    zone: "Airport ⇄ Tirupati / Vellore Direct",
    destinations: "Tirupati Balaji Temple Hills, Vellore CMC Hospital Direct Airport Yatra",
    sedan: "₹4,200",
    innova: "₹6,200",
    crysta: "₹7,400",
    tempo: "₹9,800",
    eta: "3–3.5 hrs",
    popular: false,
    whatsappMsg: "Hi Kalidass Travels, I need a Direct Airport Transfer from Chennai Airport (MAA) to Tirupati / Vellore."
  }
];

const b2bPartnershipTiers = [
  {
    category: "Corporate Guest & Delegate Pickups",
    role: "Arrival Meet & Greet with Name Board",
    description: "Scheduled terminal pickups for visiting corporate executives, delegates, and team members commuting to OMR tech corridors, Guindy, Siruseri, or Sriperumbudur.",
    perks: [
      "Uniformed driver with passenger name board at Arrival exit",
      "Clean commercial AC Sedan, Innova Crysta, or Tempo Traveller",
      "100% itemized GST invoice with company GSTIN for tax credit",
      "Guaranteed pickup even during late-night (1:00 AM - 4:00 AM) flights"
    ]
  },
  {
    category: "Hotels & Travel Agencies",
    role: "Reliable On-Ground Airport Transfer Partner",
    description: "Fixed-rate airport transfer tie-ups for Chennai hotels, guest houses, and local travel agencies needing dependable ground dispatch for their guests.",
    perks: [
      "Fixed transparent rates with zero surge pricing during rain or peak hours",
      "Pre-assigned driver contact details sent 2 hours before arrival",
      "Spacious luggage boot for heavy domestic and international baggage",
      "Immediate backup car dispatch from our nearby airport corridor hub"
    ]
  },
  {
    category: "Direct Outstation Transfers",
    role: "Non-Stop Airport to Outstation Cab Service",
    description: "Landing at Chennai and traveling directly to Pondicherry, Tirupati Balaji, or Vellore CMC Hospital? Step into a waiting highway cab with zero city-center delay.",
    perks: [
      "Chennai Airport to Pondicherry: ₹3,900 flat (Sedan)",
      "Chennai Airport to Tirupati Balaji: ₹4,200 flat (Sedan)",
      "Experienced highway chauffeurs with expressway safety discipline",
      "Doorstep drop directly to your destination hotel, temple, or hospital"
    ]
  }
];

const faqs = [
  {
    q: "How close is Kalidass Travels to Chennai International Airport (MAA)?",
    a: "Our primary vehicle dispatch hub is located directly in the airport perimeter corridor (Pallavaram / Medavakkam / Guindy belt). This allows us to dispatch vehicles to Terminal 1 (Domestic) and Terminals 2 & 4 (International) within 5 to 10 minutes flat, avoiding typical city-center delays."
  },
  {
    q: "What happens if my flight is delayed by several hours?",
    a: "We track your flight number in real-time. Whether your flight touches down early or is delayed by 2 to 4 hours, your assigned chauffeur adjusts the pickup time automatically. We do NOT charge extra waiting fees for airline delays."
  },
  {
    q: "How does the Arrivals Meet & Greet service work?",
    a: "Your chauffeur waits at the designated airport arrival exit gate holding a personalized name board with your name or corporate logo. The driver assists with your luggage and escorts you directly to the car parked in the designated commercial pickup zone."
  },
  {
    q: "Are parking and airport entry fees included in the fare?",
    a: "Our flat rates are completely transparent. Standard airport parking tickets and toll booth receipts are provided digitally without hidden surge pricing or unexpected driver demands."
  },
  {
    q: "Do you provide corporate billing and tie-ups for companies and hotels?",
    a: "Yes. We work directly with corporate administrative teams, IT firms, hotels, and travel desks. We provide itemized GST invoices, monthly billing terms, and dedicated vehicle coordination. Contact our desk at +91 63819 39769 or kalidasstravels2015@gmail.com."
  },
  {
    q: "Can I book a direct transfer from Chennai Airport to Pondicherry, Vellore, or Tirupati?",
    a: "Yes! Many tourists and medical travelers land at MAA and travel directly outstation. We specialize in immediate non-stop outstation drops to Pondicherry, Vellore CMC Hospital, and Tirupati Balaji with comfortable long-distance highway cruisers."
  }
];

const schema = {
  "@type": "TaxiService",
  "@id": "https://kalidasstravels.in/services/chennai-airport-taxi/#service",
  "name": "Chennai Airport Taxi & Transfers - Kalidass Travels",
  "description": description,
  "url": "https://kalidasstravels.in/services/chennai-airport-taxi/",
  "image": "https://kalidasstravels.in/images/services/airport-transfer.webp",
  "serviceType": "Airport Taxi & Transfers",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "Airport", "name": "Chennai International Airport (MAA)" },
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Airport Transfer Zones",
    "itemListElement": zoneTariffs.map((z, idx) => ({
      "@type": "Offer",
      "position": idx + 1,
      "name": z.zone,
      "description": `Airport transfer to ${z.destinations}`,
      "priceCurrency": "INR",
      "price": z.sedan.replace(/[^0-9]/g, ''),
      "priceValidUntil": "2027-12-31",
      "url": "https://kalidasstravels.in/services/chennai-airport-taxi/",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": "https://kalidasstravels.in/#localbusiness"
      }
    }))
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1250",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/chennai-airport-taxi/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={`${title} – Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/airport-transfer.webp"
  ogImage="/og/chennai-airport-taxi.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. HERO SECTION -->
      <section class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3.5 font-heading">
          Chennai Airport Taxi &amp; <span class="text-m3-primary">Transfers</span>
        </h1>
        <p class="text-sm sm:text-base md:text-lg text-m3-on-surface-variant font-normal leading-relaxed max-w-2xl mx-auto">
          Step off your flight and straight into a sanitized, pre-cooled cab with zero waiting. Dispatched from our base right next to Chennai International Airport with real-time flight tracking and arrivals Meet &amp; Greet.
        </p>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Below Hero) -->
      <nav aria-label="Airport Transfer Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5">
          <a href="#zone-tariffs" class="px-3.5 py-2 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container hover:bg-m3-primary hover:text-m3-on-primary transition-all shrink-0">
            Zone Tariffs
          </a>
          <a href="#luggage-guide" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            Luggage &amp; Fleet
          </a>
          <a href="#corporate-desks" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            Corporate &amp; Hotel Desks
          </a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            Airport FAQs
          </a>
        </div>
      </nav>

      <!-- 2. AIRPORT SERVICE HIGHLIGHTS -->
      <section class="mb-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
          <div class="p-4 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/70 shadow-m3-1">
            <div class="w-10 h-10 rounded-m3-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-2xl">near_me</span>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-m3-on-surface mb-1 font-heading">5–10 Min Proximity</h3>
            <p class="text-xs text-m3-on-surface-variant leading-relaxed">Located directly on the airport perimeter corridor. Cabs reach T1, T2, and T4 terminals within minutes.</p>
          </div>

          <div class="p-4 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/70 shadow-m3-1">
            <div class="w-10 h-10 rounded-m3-lg bg-blue-500/10 text-blue-600 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-2xl">flight_takeoff</span>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-m3-on-surface mb-1 font-heading">Free Flight Delay Tracking</h3>
            <p class="text-xs text-m3-on-surface-variant leading-relaxed">Provide your flight number. If your flight is delayed by 2 hours, your driver adjusts automatically with zero waiting penalty.</p>
          </div>

          <div class="p-4 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/70 shadow-m3-1">
            <div class="w-10 h-10 rounded-m3-lg bg-amber-500/10 text-amber-600 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-2xl">badge</span>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-m3-on-surface mb-1 font-heading">Meet &amp; Greet with Paging</h3>
            <p class="text-xs text-m3-on-surface-variant leading-relaxed">Your uniformed chauffeur waits at the arrival gate with your name board, helping with heavy suitcases straight to the car.</p>
          </div>

          <div class="p-4 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/70 shadow-m3-1">
            <div class="w-10 h-10 rounded-m3-lg bg-purple-500/10 text-purple-600 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-2xl">currency_rupee</span>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-m3-on-surface mb-1 font-heading">Zero Surge Pricing</h3>
            <p class="text-xs text-m3-on-surface-variant leading-relaxed">Rain, late midnight arrivals (1:30 AM), or peak business hours — your agreed flat rate remains 100% unchanged.</p>
          </div>
        </div>
      </section>

      <!-- 3. ZONE-WISE FLAT TARIFF CARDS -->
      <section id="zone-tariffs" class="mb-14 scroll-mt-28">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-2">
            <span class="material-symbols-outlined text-sm text-m3-primary">payments</span>
            <span>Transparent Flat Rates</span>
          </div>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
            Chennai Airport Fixed Zone Tariffs
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5">
            Transparent flat zone fares from Chennai Airport (MAA). Fuel, parking ticket, and tolls clearly itemized with zero surge pricing.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
          {zoneTariffs.map((tariff) => (
            <div class={`relative bg-m3-surface-container-lowest rounded-m3-xl border p-4 sm:p-5 flex flex-col justify-between shadow-m3-1 hover:shadow-m3-2 transition-all ${tariff.popular ? 'border-m3-primary ring-1 ring-m3-primary/30' : 'border-m3-outline-variant/70'}`}>
              {tariff.popular && (
                <div class="absolute -top-2.5 right-4 px-2.5 py-0.5 bg-m3-primary text-white text-[10px] font-bold uppercase tracking-wider rounded-full shadow-sm">
                  Most Booked
                </div>
              )}

              <div>
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading">{tariff.zone}</h3>
                  <span class="inline-flex items-center gap-1 text-micro text-m3-on-surface-variant font-medium bg-m3-surface-container px-2 py-0.5 rounded-full">
                    <span class="material-symbols-outlined text-[13px]">schedule</span>
                    {tariff.eta}
                  </span>
                </div>
                <p class="text-xs text-m3-on-surface-variant mb-4 line-clamp-2 leading-relaxed">
                  {tariff.destinations}
                </p>

                <!-- Vehicle Price Breakdown Grid -->
                <div class="space-y-1.5 mb-4 bg-m3-surface-container-low p-2.5 rounded-m3-lg border border-m3-outline-variant/50 text-xs">
                  <div class="flex justify-between items-center py-0.5">
                    <span class="text-m3-on-surface-variant font-medium">Sedan (Dzire/Etios, 4 Pax)</span>
                    <span class="font-bold text-m3-on-surface">{tariff.sedan}</span>
                  </div>
                  <div class="flex justify-between items-center py-0.5 border-t border-m3-outline-variant/40">
                    <span class="text-m3-on-surface-variant font-medium">Innova (6 Pax + Bags)</span>
                    <span class="font-bold text-m3-on-surface">{tariff.innova}</span>
                  </div>
                  <div class="flex justify-between items-center py-0.5 border-t border-m3-outline-variant/40">
                    <span class="text-m3-on-surface-variant font-medium">Innova Crysta VIP</span>
                    <span class="font-bold text-m3-on-surface">{tariff.crysta}</span>
                  </div>
                  <div class="flex justify-between items-center py-0.5 border-t border-m3-outline-variant/40">
                    <span class="text-m3-on-surface-variant font-medium">Tempo Traveller (12 Pax)</span>
                    <span class="font-bold text-m3-on-surface">{tariff.tempo}</span>
                  </div>
                </div>
              </div>

              <WhatsAppButton 
                href={`https://wa.me/916381939769?text=${encodeURIComponent(tariff.whatsappMsg)}`}
                size="sm"
                variant="filled"
                text={`Book ${tariff.zone}`}
              />
            </div>
          ))}
        </div>
      </section>

      <!-- 4. LUGGAGE & FLEET CAPACITY GUIDE -->
      <section id="luggage-guide" class="mb-14 p-5 sm:p-7 rounded-m3-2xl bg-m3-surface-container-low border border-m3-outline-variant scroll-mt-28">
        <div class="max-w-2xl mb-6">
          <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-m3-on-surface font-heading">
            Choose Your Vehicle by Luggage Capacity
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">
            Avoid cramped airport rides. Pick a vehicle suited for your international check-in bags and party size.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          <div class="p-3.5 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
            <h3 class="text-sm font-bold text-m3-on-surface font-heading">Executive Sedan</h3>
            <p class="text-[11px] text-m3-secondary font-medium mt-0.5">Swift Dzire / Toyota Etios</p>
            <div class="mt-3 space-y-1 text-xs text-m3-on-surface-variant">
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">group</span> 4 Passengers</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">luggage</span> 2 Large Suitcases + 2 Cabin</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">ac_unit</span> Dual AC Comfort</div>
            </div>
          </div>

          <div class="p-3.5 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
            <h3 class="text-sm font-bold text-m3-on-surface font-heading">Maruti Ertiga</h3>
            <p class="text-[11px] text-m3-secondary font-medium mt-0.5">Compact Family MPV</p>
            <div class="mt-3 space-y-1 text-xs text-m3-on-surface-variant">
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">group</span> 5–6 Passengers</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">luggage</span> 3 Medium Suitcases + Handbags</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">ac_unit</span> Roof AC Vents</div>
            </div>
          </div>

          <div class="p-3.5 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
            <h3 class="text-sm font-bold text-m3-on-surface font-heading">Toyota Innova / Crysta</h3>
            <p class="text-[11px] text-m3-secondary font-medium mt-0.5">NRI &amp; VIP Executive Standard</p>
            <div class="mt-3 space-y-1 text-xs text-m3-on-surface-variant">
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">group</span> 6–7 Passengers</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">luggage</span> 5 Large International Suitcases</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">chair</span> Reclining Captain Seats</div>
            </div>
          </div>

          <div class="p-3.5 rounded-m3-xl bg-m3-surface border border-m3-outline-variant/60 shadow-xs">
            <h3 class="text-sm font-bold text-m3-on-surface font-heading">Tempo Traveller</h3>
            <p class="text-[11px] text-m3-secondary font-medium mt-0.5">Corporate &amp; Group Transport</p>
            <div class="mt-3 space-y-1 text-xs text-m3-on-surface-variant">
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">group</span> 12–14 Passengers</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">luggage</span> 12+ Suitcases Dedicated Boot</div>
              <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-emerald-600">airline_seat_recline_extra</span> High-Roof Luxury Cabin</div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. CORPORATE TRAVEL & HOTEL TIE-UPS -->
      <section id="corporate-desks" class="mb-14 scroll-mt-20">
        <div class="rounded-m3-2xl bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 text-white p-6 sm:p-10 shadow-m3-3 border border-slate-800">
          <div class="max-w-3xl mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-m3-full bg-white/10 border border-white/20 text-emerald-400 text-xs font-semibold shadow-xs mb-3">
              <span class="material-symbols-outlined text-sm">handshake</span>
              <span>Corporate Accounts &amp; Travel Desks</span>
            </div>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight font-heading text-white">
              Corporate Travel &amp; Hotel Tie-Ups at Chennai Airport
            </h2>
            <p class="text-slate-300 text-xs sm:text-sm md:text-base mt-2 leading-relaxed">
              Managing travel for office teams, visiting delegates, or hotel guests? Kalidass Travels provides dedicated ground pickups at Chennai International Airport (MAA) with automated flight tracking, arrival name boards, and 100% itemized GST invoicing.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">
