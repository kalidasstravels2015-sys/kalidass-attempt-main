  <!-- Client-side Script for Interactive Direction Switcher (Drop vs Pickup) + Fleet Book Links + Neighborhood Booking -->
  <script>
    function setupAirportPage() {
      // 1. Listen for Direction Changes from AirportBookingEngine
      const protocolPickup = document.getElementById('protocol-banner-pickup');
      const protocolDrop = document.getElementById('protocol-banner-drop');
      const commitmentsSubtitle = document.getElementById('commitments-mode-subtitle');
      const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.booking-link');

      function updateDirectionUI(dir: 'drop' | 'pickup') {
        const isDrop = dir === 'drop';
        if (protocolPickup && protocolDrop) {
          if (isDrop) {
            protocolDrop.classList.remove('hidden');
            protocolPickup.classList.add('hidden');
          } else {
            protocolPickup.classList.remove('hidden');
            protocolDrop.classList.add('hidden');
          }
        }
        if (commitmentsSubtitle) {
          commitmentsSubtitle.textContent = isDrop ? 'Drop Protocol' : 'Pickup Protocol';
        }
        desktopLinks.forEach((link) => {
          const msg = isDrop ? link.getAttribute('data-drop-msg') : link.getAttribute('data-pickup-msg');
          if (msg) {
            link.href = `https://wa.me/918939539211?text=${encodeURIComponent(msg)}`;
          }
          link.setAttribute('data-direction', dir);
          const label = link.querySelector('.action-label');
          if (label) {
            label.textContent = isDrop ? 'Book Drop' : 'Book Pickup';
          }
        });
        const mobileBtns = document.querySelectorAll<HTMLElement>('[id^="mobile-book-"]');
        mobileBtns.forEach((btn) => {
          btn.setAttribute('data-direction', dir);
          const label = btn.querySelector('span');
          if (label) {
            label.textContent = isDrop ? 'Book Drop' : 'Book Pickup';
          }
        });
      }

      window.addEventListener('airport-direction-change', ((e: CustomEvent) => {
        if (e.detail?.direction) {
          updateDirectionUI(e.detail.direction);
        }
      }) as EventListener);

      // 2. Connect Fleet Section Book Buttons directly to Booking Engine
      const specVehicleBtns = document.querySelectorAll<HTMLButtonElement>('.spec-book-vehicle-btn');
      const vehicleMap: Record<string, string> = {
        sedan: 'Swift Dzire',
        innova: 'Maruti Ertiga',
        crysta: 'Innova Crysta',
        tempo: 'Tempo Traveller'
      };

      specVehicleBtns.forEach((btn) => {
        btn.onclick = () => {
          const vType = btn.dataset.vehicleType || 'sedan';
          const vehicleName = vehicleMap[vType] || 'Swift Dzire';
          window.dispatchEvent(new CustomEvent('airport-set-vehicle', { detail: { vehicle: vehicleName } }));

          const fareFinder = document.getElementById('airport-fare-finder') || document.getElementById('booking-section');
          if (fareFinder) {
            fareFinder.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => {
              const fromInput = document.getElementById('airport-from-input') as HTMLInputElement | null;
              const toInput = document.getElementById('airport-to-input') as HTMLInputElement | null;
              if (fromInput && !fromInput.readOnly) {
                fromInput.focus();
              } else if (toInput && !toInput.readOnly) {
                toInput.focus();
              }
            }, 400);
          }
        };
      });

      // 3. Connect Popular Neighborhood Buttons directly to On-Page Booking Engine
      const neighborhoodBtns = document.querySelectorAll<HTMLElement>('.neighborhood-book-btn');
      neighborhoodBtns.forEach((btn) => {
        btn.onclick = () => {
          const loc = btn.getAttribute('data-location') || 'Tambaram, Chennai';
          const fareFinder = document.getElementById('airport-fare-finder') || document.getElementById('booking-section');
          if (fareFinder) {
            fareFinder.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          window.dispatchEvent(new CustomEvent('airport-set-location', {
            detail: { location: loc, autoCalculate: true }
          }));
        };
      });

      // 4. Fleet Horizontal Carousel & Indicator Dots (Mobile)
      const specScroller = document.getElementById('spec-fleet-scroller');
      const specDots = document.querySelectorAll<HTMLButtonElement>('.spec-dot');
      if (specScroller && specDots.length > 0) {
        const updateSpecDots = () => {
          const scrollLeft = specScroller.scrollLeft;
          const cardWidth = specScroller.offsetWidth * 0.75;
          const activeIdx = Math.min(Math.round(scrollLeft / cardWidth), specDots.length - 1);
          specDots.forEach((dot, idx) => {
            const bar = dot.querySelector<HTMLSpanElement>('.spec-dot-bar');
            if (bar) {
              if (idx === activeIdx) {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-m3-primary w-5';
              } else {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-m3-outline-variant w-1.5';
              }
            }
          });
        };

        specScroller.addEventListener('scroll', updateSpecDots, { passive: true });

        specDots.forEach((dot) => {
          dot.onclick = () => {
            const idx = parseInt(dot.dataset.index || '0', 10);
            const cards = specScroller.querySelectorAll('.spec-fleet-card');
            if (cards[idx]) {
              cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
          };
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupAirportPage);
    } else {
      setupAirportPage();
    }
    document.addEventListener('astro:page-load', setupAirportPage);
  </script>

  <style is:global>
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
  </style>
</Layout>
