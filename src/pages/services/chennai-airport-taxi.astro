        },
        {
          "@type": "Offer",
          "name": `Tempo Traveller (12 Pax) — ${z.zone}`,
          "description": `Tempo Traveller group taxi to ${z.zone}. ${z.eta}, ${z.distance}.`,
          "price": z.tempo.replace(/[^0-9]/g, ''),
          "priceCurrency": "INR",
          "priceValidUntil": "2027-12-31",
          "availability": "https://schema.org/InStock",
          "url": "https://kalidasstravels.in/services/chennai-airport-taxi/#zone-tariffs",
          "seller": { "@id": "https://kalidasstravels.in/#localbusiness" }
        }
      ]
    }
  }))
};
---

<Layout 
  title={`${title} | Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/airport-transfer.webp"
  ogImage="/og/chennai-airport-taxi.jpg"
  schema={[taxiServiceSchema, productSchema, faqSchema, howToSchema, tripListSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="bg-slate-50 text-slate-900 font-sans pb-16">
    <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 pt-2 sm:pt-4">

      <!-- TOP PAGE HEADING & TRUST BADGES -->
      <div class="max-w-2xl mx-auto mb-2 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-2">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[10px] font-bold mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>24/7 MAA Airport Transfers</span>
          </div>
          <h1 class="text-lg sm:text-2xl md:text-3xl font-extrabold text-slate-900 font-heading tracking-tight leading-tight">
            Chennai Airport Taxi &amp; Cab Booking
          </h1>
        </div>
        <div class="hidden sm:flex items-center gap-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700">
            <span class="material-symbols-outlined text-amber-500 text-[15px]">star</span>
            <span>4.9/5 Rating (5,000+ Trips)</span>
          </span>
        </div>
      </div>

      <div id="booking-section" class="scroll-mt-28"></div>

      <!-- Complete New Airport Transfer Booking Panel (Home-Screen Inspired) -->
      <section class="relative z-20 py-1 sm:py-2 px-1 sm:px-3 max-w-2xl mx-auto mb-3">
        <AirportBookingEngine client:load showHeader={false} />

        <!-- Trust Reassurance Footer Strip -->
        <div class="mt-2 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-[11px] text-slate-500 font-medium">
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-emerald-600 shrink-0">verified</span>
            <span class="font-bold text-slate-800">Zero Advance Required — Pay After Trip</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-emerald-600 shrink-0">check_circle</span>
            <span>Instant WhatsApp confirmation</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-emerald-600 shrink-0">check_circle</span>
            <span>Zero hidden charges</span>
          </div>
        </div>
      </section>

      <!-- 1. SIGNATURE HERO BANNER -->
      <section class="group relative min-h-[200px] sm:min-h-[240px] md:min-h-[260px] rounded-2xl overflow-hidden shadow-md border border-slate-800 bg-slate-950 flex flex-col justify-end p-5 sm:p-7 md:p-8 mt-4 mb-8 transition-all duration-300">
        <!-- Background Image with Scrim -->
        <OptimizedImage
          src="/images/services/airport-transfer.webp"
          alt="Kalidass Travels - Chennai Airport Taxi & Transfers (Pickup & Drop)"
          class="absolute inset-0 w-full h-full object-cover object-[62%_top] sm:object-[center_28%] transition-transform duration-700 group-hover:scale-105 opacity-80"
          loading="lazy"
          fetchpriority="auto"
          sizes="(max-width: 768px) 100vw, 1024px"
        />
        <!-- High-Contrast Scrim Gradient for 100% Text Legibility while keeping image vivid -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40 sm:bg-gradient-to-r sm:from-slate-950/95 sm:via-slate-950/70 sm:to-transparent"></div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold mb-2 backdrop-blur-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>24/7 Verified Chauffeur Service</span>
            </div>
            <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight leading-tight font-heading drop-shadow-sm">
              Official MAA Airport Meet &amp; Greet
            </h2>
            <p class="text-xs sm:text-sm md:text-base text-slate-200 mt-2 font-normal leading-relaxed max-w-2xl drop-shadow-xs pr-8 sm:pr-0">
              Planning your trip early? Reserve for ₹0 advance today with no credit card required. Pay only after your ride completes safely. Free live flight radar tracking &amp; name-board greeting for all travelers.
            </p>
          </div>
          <div class="hidden sm:flex flex-col items-end shrink-0">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-xs text-white font-medium">
              <span class="material-symbols-outlined text-emerald-400 text-[16px]">verified</span>
              Direct ramp drop T1, T2 &amp; T4 · Free Placard
            </span>
          </div>
        </div>
      </section>

      <!-- 4. FIXED ZONE TARIFFS & COMMITMENTS -->
      <section id="zone-tariffs" class="mb-8 sm:mb-12 scroll-mt-28">

      <!-- AIRPORT TRANSFER COMMITMENTS & GUARANTEES CARD -->
      <section 
        id="trust-promises-section" 
        class="rounded-2xl bg-white border border-slate-200 shadow-sm p-4 sm:p-6 mt-6 mb-6 relative overflow-hidden offscreen-defer"
        aria-labelledby="commitments-card-heading"
      >
        <!-- Card Header -->
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5 sm:gap-3 pb-3 mb-4 border-b border-slate-200">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-xs">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <h3 id="commitments-card-heading" class="text-base sm:text-lg font-extrabold text-slate-900 font-heading">
              Our 5 Airport Guarantees
            </h3>
          </div>

          <span id="commitments-mode-subtitle" class="text-xs font-bold text-slate-900 bg-slate-100 border border-slate-200 px-3 py-1 rounded-full shrink-0">
            Pickup Protocol
          </span>
        </div>

        <!-- 1. Pickup Commitments Grid (Landing at MAA) -->
        <div 
          id="protocol-banner-pickup" 
          class="grid grid-cols-1 md:grid-cols-2 gap-3" 
          role="list"
        >
          <!-- Commitment 01: Zero Advance -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              01
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Pay ₹0 Today — Settle After Safe Arrival
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Zero advance payment. Pay via UPI, Cash, or Card only after arriving safely at your destination.
              </p>
            </div>
          </div>

          <!-- Commitment 02: Flight Delayed Waiting -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              02
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Flight Delayed? We Wait Free of Charge
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Live radar tracking. Even if your flight is delayed 2 hours at midnight, your cab waits at zero extra cost.
              </p>
            </div>
          </div>

          <!-- Commitment 03: Gate-Side Name Board -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              03
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Chauffeur at Exit with Name Board
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Chauffeur stands right outside arrival gate holding your name board—no searching or confusion.
              </p>
            </div>
          </div>

          <!-- Commitment 04: Pre-Stationed Terminal Cab -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              04
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Chilled AC Cab Pre-Parked at Airport
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Vehicle cooled and parked inside airport before touchdown. Board in under 3 minutes with zero queue.
              </p>
            </div>
          </div>

          <!-- Commitment 05: Transparent Fixed Fare -->
          <div role="listitem" class="col-span-1 md:col-span-2 p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              05
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                100% Fixed Fare — Tolls &amp; Parking Included
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Flat transparent fare with toll, parking, fuel, and AC included. Never any surge or hidden fees.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Drop Commitments Grid (Going to MAA) -->
        <div 
          id="protocol-banner-drop" 
          class="hidden grid grid-cols-1 md:grid-cols-2 gap-3" 
          role="list"
        >
          <!-- Drop Commitment 01: Zero Advance -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              01
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Zero Advance — Pay at Airport Terminal
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Confirm your ride today with ₹0 advance. Settle the flat fare after reaching the departure gate safely.
              </p>
            </div>
          </div>

          <!-- Drop Commitment 02: Punctuality -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              02
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Doorstep Pickup — 15 to 30 Mins Early
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Never stress about missing a flight. Your chauffeur arrives 15–30 minutes early at your doorstep.
              </p>
            </div>
          </div>

          <!-- Drop Commitment 03: Driver Info by 9 PM -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              03
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Driver &amp; Cab Info Sent by 9 PM Prior Night
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Chauffeur details and vehicle number delivered to your WhatsApp by 9 PM the evening before.
              </p>
            </div>
          </div>

          <!-- Drop Commitment 04: Direct Ramp Drop -->
          <div role="listitem" class="p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              04
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Direct Ramp Drop at Departure Gate
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Ramp drop right outside your airline gate (T1 Domestic, T2/T4 International) with luggage assistance.
              </p>
            </div>
          </div>

          <!-- Drop Commitment 05: Guaranteed Flat Tariff -->
          <div role="listitem" class="col-span-1 md:col-span-2 p-3.5 sm:p-4 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 shadow-2xs flex items-start gap-3 transition-colors">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              05
            </span>
            <div class="min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 font-heading leading-tight">
                Guaranteed Flat Tariff — Tolls &amp; GST Included
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Flat pricing across Chennai with tolls, GST, and AC included. Never midnight surge or baggage fees.
              </p>
            </div>
          </div>
        </div>
      </section>

        <!-- Corporate GST Invoicing Card -->
        <div class="mt-4 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="flex items-start gap-3.5">
            <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-900 flex items-center justify-center shrink-0 border border-slate-200">
              <span class="material-symbols-outlined text-[20px] text-slate-900">business</span>
            </span>
            <div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 font-heading leading-tight mb-1">
                Corporate GST Invoicing &amp; Executive Desks
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Itemized GST tax invoices (GSTIN: 33COVPM0531D1Z4) for corporate expense claims, monthly billing accounts, and executive delegate name-board pickups.
              </p>
            </div>
          </div>
        </div>

        <!-- Standard Transfer Zones & Rates Overview -->
        <div id="all-zones-container" class="mt-6 mb-8">

          <!-- Section Header (shared) -->
          <div class="flex items-center gap-3 pb-3 mb-4 border-b border-slate-200">
            <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-200">
              <span class="material-symbols-outlined text-[18px]">receipt_long</span>
            </span>
            <div class="min-w-0">
              <span class="text-base sm:text-lg font-extrabold text-slate-900 font-heading block">
                All 6 Standard Transfer Zones &amp; Rates Overview
              </span>
              <span class="text-xs sm:text-sm text-slate-600 block mt-0.5">
                Fixed transparent pricing across Chennai &amp; Outstation
              </span>
            </div>
          </div>

          <!-- MOBILE: Compact M3-style dense list accordion (shown only on < sm) -->
          <div class="sm:hidden rounded-xl border border-slate-200 bg-white overflow-hidden divide-y divide-slate-100 shadow-xs">
            {zoneTariffs.map((t) => (
              <details class={`group ${t.popular ? 'bg-emerald-50/40' : 'bg-white'}`}>
                <summary class="flex items-center justify-between px-3 py-2 cursor-pointer list-none gap-2 select-none">
                  <div class="min-w-0 flex items-center gap-2 overflow-hidden">
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <span class="font-semibold text-slate-900 text-[13px] leading-snug truncate">{t.zone}</span>
                        {t.popular && (
                          <span class="shrink-0 px-1.5 py-px rounded-full bg-emerald-100 text-emerald-800 text-[9px] font-bold uppercase tracking-wider border border-emerald-200">★</span>
                        )}
                      </div>
                      <span class="text-[10px] text-slate-400 leading-none mt-0.5 block">
                        {t.eta} · {t.distance}
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    <span class="font-bold text-emerald-700 text-[12px]">{t.sedan}</span>
                    <span class="material-symbols-outlined text-[16px] text-slate-400 transition-transform duration-150 group-open:rotate-180">expand_more</span>
                  </div>
                </summary>
                <div class="px-3 pt-1.5 pb-2.5 border-t border-slate-100 bg-slate-50/60">
                  <!-- Horizontal price chips -->
                  <div class="flex gap-1.5 overflow-x-auto pb-1 scrollbar-hide mb-2">
                    <div class="flex-shrink-0 text-center bg-white border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-[9px] text-slate-400 block leading-none">Sedan</span>
                      <span class="text-[11px] font-bold text-slate-900">{t.sedan}</span>
                    </div>
                    <div class="flex-shrink-0 text-center bg-white border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-[9px] text-slate-400 block leading-none">Innova</span>
                      <span class="text-[11px] font-bold text-slate-900">{t.innova}</span>
                    </div>
                    <div class="flex-shrink-0 text-center bg-white border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-[9px] text-slate-400 block leading-none">Crysta</span>
                      <span class="text-[11px] font-bold text-slate-900">{t.crysta}</span>
                    </div>
                    <div class="flex-shrink-0 text-center bg-white border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-[9px] text-slate-400 block leading-none">Tempo</span>
                      <span class="text-[11px] font-bold text-slate-900">{t.tempo}</span>
                    </div>
                  </div>
                  <div class="flex justify-start mt-1">
                    <WhatsAppButton
                      id={`mobile-book-${t.id}`}
                      href={`https://wa.me/918939539211?text=${encodeURIComponent(t.whatsappPickup)}`}
                      size="sm"
                      variant="tonal"
                      text="Book Pickup"
                      ariaLabel={`Book pickup taxi to ${t.zone} via WhatsApp`}
                    />
                  </div>
                </div>
              </details>
            ))}
          </div>

          <!-- DESKTOP/TABLET: Full table (hidden on mobile, shown sm+) -->
          <div class="hidden sm:block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
            <div class="p-4 sm:p-6 pt-3 sm:pt-4">
              <!-- "Scroll rates" hint for tablet -->
              <div class="flex justify-end mb-3 lg:hidden">
                <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-full flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px] text-slate-400">swipe</span>
                  <span>Scroll rates</span>
                </span>
              </div>
              <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-2xs">
                <table class="w-full text-left text-xs font-sans border-collapse">
                  <thead class="bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider border-b border-slate-200">
                    <tr>
                      <th class="px-4 py-3" id="table-col-location">Destination &amp; Key Landmarks</th>
                      <th class="px-3 py-3 text-center">Drive &amp; Distance</th>
                      <th class="px-3 py-3 text-center">Sedan (4 Pax)</th>
                      <th class="px-3 py-3 text-center">Innova (6 Pax)</th>
                      <th class="px-3 py-3 text-center">Innova Crysta</th>
                      <th class="px-3 py-3 text-center">Tempo (12 Pax)</th>
                      <th class="px-4 py-3 text-right">Instant Action</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200">
                    {zoneTariffs.map((t) => (
                      <tr class={`hover:bg-slate-50 transition-colors ${t.popular ? 'bg-emerald-50/30' : ''}`}>
                        <td class="px-4 py-3.5">
                          <div class="flex items-center gap-2">
                            <span class="font-bold text-slate-900 font-heading text-sm">{t.zone}</span>
                            {t.popular && (
                              <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] font-bold uppercase tracking-wider">
                                Popular
                              </span>
                            )}
                          </div>
                          <p class="text-xs text-slate-600 leading-relaxed mt-1">{t.destinations}</p>
                        </td>
                        <td class="px-3 py-3.5 text-center text-xs font-medium text-slate-600 whitespace-nowrap">
                          <span class="inline-flex items-center gap-1 bg-slate-100 px-2 py-0.5 rounded-full">
                            <span class="material-symbols-outlined text-[14px] text-slate-500">schedule</span>
                            <span>{t.eta} · {t.distance}</span>
