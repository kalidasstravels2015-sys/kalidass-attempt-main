      "priceRange": "₹7,500 - ₹15,500",
      "termsOfService": "https://kalidasstravels.in/terms/",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": "7500",
        "highPrice": "15500",
        "offerCount": String(fleetPackages.length),
        "offers": fleetPackages.map((v) => ({
          "@type": "Offer",
          "name": `${v.name} (${v.shortName}) – 2-Day Yelagiri Package`,
          "price": v.day2Price.replace(/[^\d]/g, ''),
          "priceCurrency": "INR",
          "priceValidUntil": "2027-12-31",
          "availability": "https://schema.org/InStock",
          "url": canonicalURL
        }))
      }
    },
    {
      "@type": "TouristTrip",
      "@id": `${canonicalURL}#trip`,
      "name": "Chennai to Yelagiri Hills Cab & 2-Day Weekend Tour Package",
      "description": description,
      "image": "https://kalidasstravels.in/images/hero/outstation-highway.webp",
      "url": canonicalURL,
      "touristType": ["Families", "Couples", "Corporate Groups", "Weekend Travelers"],
      "itinerary": {
        "@type": "ItemList",
        "name": "Chennai to Yelagiri Hills Route Itinerary",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Chennai Doorstep Pickup via NH 48" },
          { "@type": "ListItem", "position": 2, "name": "14 Hairpin Bends Ghat Road Ascent" },
          { "@type": "ListItem", "position": 3, "name": "Punganoor Lake & Yelagiri Nature Park" },
          { "@type": "ListItem", "position": 4, "name": "Swamimalai Hill Viewpoint & Jalagamparai Falls" }
        ]
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": "7500",
        "highPrice": "15500",
        "offerCount": String(fleetPackages.length)
      },
      "provider": {
        "@id": "https://kalidasstravels.in/#localbusiness"
      }
    },
    {
      "@type": "FAQPage",
