---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import BookingEngine from '../../components/BookingEngine.jsx';
import { 
  ShieldCheck, 
  Clock, 
  MapPin, 
  Phone, 
  CheckCircle2, 
  Car, 
  Users, 
  Luggage, 
  ArrowRight,
  Sparkles,
  Info
} from 'lucide-react';

const title = "Local Hourly Car Rental in Chennai – 4h, 8h & 12h Packages | Kalidass Travels";
const description = "Hire local cabs in Chennai by the hour with private chauffeurs. 4h/40km from ₹1,600, 8h/80km from ₹2,600. Innova Crysta 4h rental ₹3,400. Zero surge pricing.";
const keywords = "local car rental chennai, hourly cab booking chennai, 4 hours cab rental chennai, 8 hours car rental chennai, innova crysta hourly rental chennai, city taxi packages chennai, car rental medavakkam, cab hire for shopping chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Local Hourly Cabs", item: "/services/local-hourly-cabs/" },
];

const hourlyTariff = [
  {
    vehicle: "Swift Dzire / Toyota Etios",
