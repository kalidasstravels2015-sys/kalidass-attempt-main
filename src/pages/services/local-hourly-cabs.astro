    pkg5hr: "₹3,800",
    pkg8hr: "₹5,400",
    pkg10hr: "₹6,200",
    pkg12hr: "₹7,200",
    extraKm: "₹22 / km",
    extraHr: "₹350 / hr",
    description: "Top-tier executive travel. Captain seats, plush dual-zone climate control, and unmatched luxury for VIP delegates."
  },
  {
    vehicle: "Tempo Traveller (12 Seater)",
    vehicleKey: "Tempo Traveller",
    category: "Group Coach",
    capacity: "12 Seats • 8+ Bags",
    image: "/images/fleet/tempo.webp",
    badge: "Large Group Van",
    pkg4hr: "₹4,200",
