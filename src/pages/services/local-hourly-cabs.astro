<Layout
  title={title}
  description={description}
  keywords={keywords}
  image="/images/services/corporate.webp"
  ogImage="/og/local-hourly-cabs.jpg"
  schema={[taxiServiceSchema, faqSchema, breadcrumbsSchema]}
>
  <!-- Hero Section: Unified Framed Visual Card on Desktop, Clean App-First Hero on Mobile -->
  <section
    id="local-hero"
    class="relative overflow-hidden bg-m3-surface lg:bg-[#041E49] pt-2 pb-5 sm:pb-7 lg:pt-3 lg:pb-10 border-b border-m3-outline-variant/60 lg:border-white/10"
  >
    <div class="relative z-20 max-w-6xl mx-auto px-3 sm:px-6 lg:px-8">
      <!-- Breadcrumbs (Light on mobile, Dark on desktop) -->
      <div class="w-full -mt-0.5 mb-2 sm:mb-3">
        <div class="block lg:hidden">
          <Breadcrumbs items={breadcrumbItems} />
        </div>
        <div class="hidden lg:block">
          <Breadcrumbs items={breadcrumbItems} variant="dark" />
        </div>
      </div>

      <!-- Mobile ONLY Heading + Separate Google Rating Row -->
      <div class="block lg:hidden text-center max-w-xl mx-auto mb-3">
        <p role="heading" aria-level="1" data-speakable="true" class="text-xl sm:text-2xl font-extrabold text-m3-on-surface font-heading tracking-tight leading-tight">
          Local Hourly Car Rental in Chennai
        </p>
        <div class="mt-2 flex justify-center">
          <GoogleRatingBadge />
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
        
        <!-- Left Column: Visible on Desktop (lg+) with Title, Rating, Overview, Visual Card & Highlights -->
        <div class="hidden lg:flex lg:col-span-5 flex-col justify-between text-white pt-1">
          <div>
            <!-- Google Rating Eyebrow Badge -->
            <div class="mb-2 sm:mb-2.5">
              <GoogleRatingBadge variant="dark" />
            </div>

