  </div>

  <!-- Client-side Script for Deep-linking & Carousel Scrolling -->
  <script is:inline>
    function setupLocalHourlyPage() {
      // 1. Quick Table Book and Vehicle Card Select Buttons
      document.querySelectorAll('[data-vehicle-select], .local-select-vehicle-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var vKey = btn.getAttribute('data-vehicle-select') || btn.getAttribute('data-vehicle-key');
          var pKey = btn.getAttribute('data-pkg-select') || btn.getAttribute('data-pkg-key');
          if (vKey) {
            window.dispatchEvent(new CustomEvent('select-quote-vehicle', {
              detail: { vehicle: vKey, key: vKey }
            }));
          }
          if (pKey) {
            window.dispatchEvent(new CustomEvent('select-quote-package', {
              detail: { package: pKey }
            }));
          }
          var bookingSec = document.getElementById('fare-calculator');
          if (bookingSec) {
            bookingSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // 2. Local Fleet Horizontal Carousel & Indicator Dots (Mobile)
      var scroller = document.getElementById('local-fleet-scroller');
      var dots = document.querySelectorAll('.local-dot');
      if (scroller && dots.length > 0) {
        var updateDots = function() {
          var scrollLeft = scroller.scrollLeft;
          var cardWidth = scroller.offsetWidth * 0.75;
          var activeIdx = Math.min(Math.round(scrollLeft / cardWidth), dots.length - 1);
          dots.forEach(function(dot, idx) {
            var bar = dot.querySelector('.local-dot-bar');
            if (bar) {
              if (idx === activeIdx) {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 local-dot-bar bg-m3-primary w-5';
              } else {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 local-dot-bar bg-m3-outline-variant w-1.5';
              }
            }
          });
        };

        scroller.addEventListener('scroll', updateDots, { passive: true });

        dots.forEach(function(dot) {
          dot.onclick = function() {
            var idx = parseInt(dot.dataset.index || '0', 10);
            var cards = scroller.querySelectorAll('.tariff-card, [data-vehicle-name], .group');
            if (cards[idx]) {
              cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
          };
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLocalHourlyPage);
    } else {
      setupLocalHourlyPage();
    }
    document.addEventListener('astro:page-load', setupLocalHourlyPage);
  </script>

  <style is:global>
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
  </style>
</Layout>
