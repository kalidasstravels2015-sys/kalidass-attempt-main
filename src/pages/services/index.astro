---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { 
  PlaneTakeoff,
  UserCheck, 
  Landmark, 
  Compass, 
  Building2, 
  ArrowRight, 
  CheckCircle2, 
  Phone, 
  ShieldCheck, 
  Sparkles,
  Car,
  Clock
} from 'lucide-react';

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
];

const servicesList = [
  {
    id: "airport-transfers",
    number: "01",
    title: "Chennai Airport Taxi & Transfers",
    tagline: "5–10 min rapid terminal dispatch from MAA. Real-time flight tracking & zero delay penalty.",
    badge: "5-Min Proximity",
    icon: PlaneTakeoff,
    image: "/images/services/airport-transfer.webp",
    imagePosition: "top",
    theme: "emerald",
    link: "/services/chennai-airport-taxi/",
    overview: "Located adjacent to Chennai International Airport (MAA). Guaranteed on-time pickup for Domestic (T1) and International (T2/T4) terminals with arrivals Meet & Greet, name paging boards, and zero surge pricing.",
    highlights: [
      "5–10 min rapid dispatch from airport perimeter base",
      "Real-time flight delay tracking with zero extra waiting fee",
      "Meet & Greet terminal service with passenger name boards",
      "Direct transfers to OMR, Central, ECR, Pondicherry & Tirupati"
    ],
    popularTrips: ["Airport ⇄ OMR IT Corridor", "Airport ⇄ Central / Egmore", "Airport ⇄ Pondicherry", "Airport ⇄ Tirupati Balaji"],
    whatsappMsg: "Hi Kalidass Travels, I need an airport taxi transfer to/from Chennai Airport (MAA)."
  },
  {
    id: "outstation-cabs",
    number: "02",
    title: "Outstation Cabs",
    tagline: "Flat per-km rates & weekend getaway road trips across South India.",
    badge: "Starts ₹14 / km",
    icon: Compass,
    image: "/images/temple/mahabalipuram-ecr-temples.webp",
    imagePosition: "center 30%",
    theme: "blue",
    link: "/services/outstation-cabs/",
    overview: "Rent a clean, dual-AC taxi for weekend road trips or one-way drops to Pondicherry, Mahabalipuram, Bangalore, or Yercaud with flat, transparent tariffs.",
    highlights: [
      "Flat per-km rates: Sedan (₹14/km) & Innova (₹20/km)",
      "Chennai to Pondicherry 1-Day: ₹4,500 (ECR tolls included)",
      "Chennai to Mahabalipuram Coastal Tour: ₹3,500 Full Day",
      "Disciplined 80–90 km/h highway speed limits"
    ],
    popularTrips: ["Chennai to Pondicherry", "Chennai to Mahabalipuram", "Chennai to Bangalore", "Chennai to Yercaud"],
    whatsappMsg: "Hi Kalidass Travels, I need an outstation cab from Chennai."
  },
  {
    id: "temple-tours",
    number: "03",
    title: "Temple Tours",
    tagline: "All-inclusive spiritual darshan yatras with sanitized AC cabs & all tolls included.",
    badge: "Starts ₹3,200",
    icon: Landmark,
    image: "/images/services/temple-tours.webp",
    imagePosition: "center 25%",
    theme: "emerald",
    link: "/services/tours/temple-tours/",
    overview: "Comfortable spiritual darshan yatras from Chennai. Clean sanitized AC cab, courteous satvik driver, and all highway FASTag tolls 100% included upfront.",
    highlights: [
      "Chennai to Tirupati Balaji (1 Day): From ₹6,000",
      "Chennai to Kumbakonam 9 Navagraha (2 Days): From ₹8,600",
      "Chennai to Thiruvannamalai Girivalam: From ₹6,500",
      "Chennai to Kanchipuram Temple Circuit: From ₹3,200"
    ],
    popularTrips: ["Chennai to Tirupati", "Chennai to Navagraha", "Chennai to Thiruvannamalai", "Chennai to Kanchipuram"],
    whatsappMsg: "Hi Kalidass Travels, I want to enquire about Temple Tour packages from Chennai."
  },
  {
    id: "corporate-mobility",
    number: "04",
    title: "Corporate Mobility",
    tagline: "24/7 staff commute, executive retainers & corporate airport cabs.",
    badge: "Starts ₹350 / shift",
    icon: Building2,
    image: "/images/services/corporate.webp",
    imagePosition: "top",
    theme: "purple",
    link: "/services/corporate/",
    overview: "Dedicated enterprise transport for Chennai IT corridors and factories. Safe night shift commutes with live GPS tracking and 100% GST invoicing.",
    highlights: [
      "Employee shift cabs with live GPS tracking",
      "Monthly car + chauffeur retainers from ₹42,000/mo",
      "Flight-tracked airport pickups with nameboards",
      "Guaranteed 60-minute replacement car & driver guarantee"
    ],
    popularTrips: ["Employee Shift Pickups", "Monthly Car Retainers", "Airport Transfers"],
    whatsappMsg: "Hi Kalidass Travels, I need a corporate transport quotation for our company."
  },
  {
    id: "acting-drivers",
    number: "05",
    title: "Acting Drivers",
    tagline: "Police-verified chauffeurs for your personal car (Manual, Automatic, or EV).",
    badge: "Starts ₹600",
    icon: UserCheck,
    image: "/images/services/acting-drivers.webp",
    imagePosition: "center",
    theme: "amber",
    link: "/services/acting-drivers/",
    overview: "Hate city traffic or tiring highway driving? Book a police-verified chauffeur to drive your personal car with flexible hourly and daily outstation packages.",
    highlights: [
      "Doorstep arrival across Chennai in 30–60 mins",
      "City hourly duty: 4 hrs (₹600) & 8 hrs (₹900)",
      "Outstation round trips from ₹600/day driver bata",
      "Zero surge pricing during rain or peak hours"
    ],
    popularTrips: ["City 4h/8h Duty", "Hospital & Shopping", "Outstation Highway Driver"],
    whatsappMsg: "Hi Kalidass Travels, I need an acting driver for my car in Chennai."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://kalidasstravels.in/services/#collection",
  "name": "Travel Services in Chennai - Kalidass Travels",
  "description": "Book trusted travel services in Chennai: Airport Transfers, Outstation Cabs, Temple Tours, Corporate Mobility, and Acting Drivers for your personal car.",
  "url": "https://kalidasstravels.in/services/",
  "image": "https://kalidasstravels.in/images/services/airport-transfer.webp",
  "mainEntity": {
    "@type": "ItemList",
    "name": "Kalidass Travels Core Services",
    "itemListElement": servicesList.map((s, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": s.title,
      "url": `https://kalidasstravels.in${s.link}`,
      "description": s.tagline,
      "image": `https://kalidasstravels.in${s.image}`
    }))
  }
};
---

<Layout 
  title="Cab & Driver Services in Chennai | Airport Taxi, Outstation Cabs & Temple Tours – Kalidass Travels"
  description="Book Chennai airport taxi transfers, flat-rate outstation cabs, all-inclusive temple tours, corporate mobility, and verified acting drivers. Transparent fixed rates and 24/7 support."
  keywords="cab services chennai, taxi services chennai, outstation cabs chennai, airport taxi chennai, temple tour cabs chennai, acting driver in chennai, corporate cab chennai, kalidass travels"
  image="/images/services/airport-transfer.webp"
  ogImage="/og/services.jpg"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. CLEAN HERO SECTION -->
      <section class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Our Travel Services in <span class="text-m3-primary">Chennai</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal">
          Whether you need a rapid airport transfer, flat-rate outstation cabs, an all-inclusive temple tour, corporate mobility, or an acting driver for your own car — select your service below for instant rates.
        </p>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Below Hero) -->
      <nav aria-label="Services Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-1 sm:gap-2 text-xs font-semibold whitespace-nowrap overflow-x-auto no-scrollbar py-0.5">
          <span class="text-micro uppercase tracking-wider text-m3-on-surface-variant mr-1 font-bold hidden sm:inline">Jump To:</span>
          <a href="#airport-transfers" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-primary hover:text-white transition-colors text-m3-on-surface">Airport Taxi</a>
          <a href="#outstation-cabs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-primary hover:text-white transition-colors text-m3-on-surface">Outstation Cabs</a>
          <a href="#temple-tours" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-primary hover:text-white transition-colors text-m3-on-surface">Temple Tours</a>
          <a href="#corporate-mobility" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-primary hover:text-white transition-colors text-m3-on-surface">Corporate Mobility</a>
          <a href="#acting-drivers" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-primary hover:text-white transition-colors text-m3-on-surface">Acting Drivers</a>
        </div>
      </nav>

      <!-- 2. THE 5 MAIN SERVICE PILLARS -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-14">
        {servicesList.map((srv) => {
          const IconComp = srv.icon;
          return (
            <div 
              id={srv.id}
              class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 hover:shadow-m3-2 transition-all flex flex-col justify-between scroll-mt-28 overflow-hidden group"
            >
              <div>
                <!-- Service Media Image Header -->
                <a href={srv.link} class="relative h-56 sm:h-64 w-full block overflow-hidden bg-slate-900 cursor-pointer" aria-label={`View ${srv.title} Details`}>
                  <OptimizedImage
                    src={srv.image}
                    alt={`Kalidass Travels - ${srv.title}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    style={`object-position: ${srv.imagePosition || 'center'};`}
                    sizes="(max-width: 768px) 100vw, 50vw"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></div>
                  
                  <!-- Overlaid Chips (Positioned at bottom so faces and heads at the top remain completely visible) -->
                  <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none">
                    <span class="px-2.5 py-1 rounded-m3-full text-micro font-bold bg-slate-900/85 backdrop-blur-md text-white border border-white/20 shadow-xs uppercase tracking-wider">
                      Service {srv.number}
                    </span>
                    <span class="px-2.5 py-1 rounded-m3-full text-micro font-bold bg-m3-primary text-white shadow-xs">
                      {srv.badge}
                    </span>
                  </div>
                </a>

                <!-- Card Content -->
                <div class="p-5 sm:p-6">
                  <div class="flex items-center gap-2.5 mb-3">
                    <div class="w-9 h-9 rounded-m3-lg bg-m3-surface-container-high text-m3-primary flex items-center justify-center border border-m3-outline-variant shrink-0">
                      <IconComp className="w-5 h-5" />
                    </div>
                    <h2 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading leading-snug">
                      <a href={srv.link} class="hover:text-m3-primary transition-colors">{srv.title}</a>
                    </h2>
                  </div>

                  <p class="text-xs sm:text-sm text-m3-on-surface-variant font-medium leading-relaxed mb-3">
                    {srv.tagline}
                  </p>

                  <p class="text-xs text-m3-on-surface-variant mb-4 leading-relaxed">
                    {srv.overview}
                  </p>

                  <!-- Key Bullet Highlights -->
                  <ul class="space-y-2 mb-5 bg-m3-surface-container-low p-3.5 rounded-m3-xl border border-m3-outline-variant/60">
                    {srv.highlights.map((hl) => (
                      <li class="flex items-start gap-2 text-xs text-m3-on-surface leading-tight">
                        <CheckCircle2 className="w-3.5 h-3.5 text-m3-primary shrink-0 mt-0.5" />
                        <span>{hl}</span>
                      </li>
                    ))}
                  </ul>

                  <!-- Popular Routes Chips -->
                  <div class="mb-5">
                    <span class="text-micro font-bold uppercase tracking-wider text-m3-on-surface-variant block mb-1.5">
                      Popular Options:
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                      {srv.popularTrips.map((trip) => (
                        <span class="text-micro font-medium px-2 py-0.5 rounded-m3-md bg-m3-surface border border-m3-outline-variant/70 text-m3-on-surface">
                          {trip}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="p-5 sm:p-6 pt-0">
                <div class="pt-4 border-t border-m3-outline-variant/60 flex items-center gap-3">
                  <a
                    href={srv.link}
                    class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-4 bg-m3-primary hover:bg-m3-primary/90 text-m3-on-primary rounded-m3-full text-xs font-bold shadow-xs transition-all"
                  >
                    <span>View Rates &amp; Details</span>
                    <ArrowRight className="w-3.5 h-3.5" />
                  </a>
                  <WhatsAppButton
                    href={`https://wa.me/919092303060?text=${encodeURIComponent(srv.whatsappMsg)}`}
                    size="icon"
                    variant="filled"
                    ariaLabel={`Book ${srv.title} on WhatsApp`}
                  />
                </div>
              </div>
            </div>
          );
        })}
      </section>



      <!-- 4. TRUST & GUARANTEES (4 Pillars) -->
      <section class="bg-m3-surface-container-low rounded-m3-2xl p-6 sm:p-8 border border-m3-outline-variant mb-14">
        <div class="text-center max-w-2xl mx-auto mb-6">
          <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-m3-on-surface font-heading">
            Our Service Promises
          </h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <ShieldCheck className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Police Verification Certifieds</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Clean background checks with valid commercial transport badges.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <Sparkles className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Zero Surge Pricing</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Fixed transparent tariffs that never surge during rains or holidays.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <Car className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">All Tolls Covered</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">In tour packages, highway tolls, parking &amp; permits are included upfront.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <Clock className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">24/7 Phone Helpline</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Instant telephone dispatch desk for bookings and real-time support.</p>
          </div>
        </div>
      </section>

      <!-- 5. BOTTOM CONVERSION CTA BANNER -->
      <section class="bg-m3-inverse-surface text-m3-inverse-on-surface rounded-m3-2xl p-6 sm:p-10 text-center shadow-m3-2 border border-slate-800 my-8">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold font-heading text-white mb-2">
          Need Help Selecting the Right Service?
        </h2>
        <p class="text-slate-300 text-xs sm:text-sm max-w-lg mx-auto mb-6">
          Call our Chennai booking desk or chat with us on WhatsApp. We'll recommend the best option and share an exact rate in 60 seconds.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <WhatsAppButton
            href="https://wa.me/919092303060?text=Hi%20Kalidass%20Travels,%20I%20need%20help%20choosing%20the%20right%20travel%20service."
            size="md"
            variant="filled"
            text="Chat on WhatsApp"
          />
          <a
            href="tel:+916381939769"
            class="inline-flex items-center gap-2 px-6 py-3 bg-m3-surface hover:bg-m3-surface-container text-m3-on-surface font-bold text-xs sm:text-sm rounded-m3-full shadow-m3-1 transition-all"
          >
            <span>Call +91 63819 39769</span>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
