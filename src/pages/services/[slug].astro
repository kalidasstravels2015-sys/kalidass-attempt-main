                {parsedDressCode && (
                  <button
                    type="button"
                    role="tab"
                    id="tab-dresscode-btn"
                    aria-selected="true"
                    aria-controls="panel-dresscode"
                    data-guide-tab="dresscode"
                    class="guide-tab-btn inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 py-2 rounded-m3-lg text-xs sm:text-sm font-bold transition-all bg-m3-primary text-m3-on-primary shadow-xs shrink-0"
                  >
                    {isTour ? <Sparkles className="w-3.5 h-3.5 shrink-0" /> : <ShieldCheck className="w-3.5 h-3.5 shrink-0" />}
                    <span>{guideLabels.dressCodeLabel}</span>
                  </button>
                )}
                {parsedTips.length > 0 && (
                  <button
                    type="button"
                    role="tab"
                    id="tab-tips-btn"
                    aria-selected={!parsedDressCode ? "true" : "false"}
                    aria-controls="panel-tips"
                    data-guide-tab="tips"
                    class={`guide-tab-btn inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 py-2 rounded-m3-lg text-xs sm:text-sm font-bold transition-all shrink-0 ${
                      !parsedDressCode 
                        ? 'bg-m3-primary text-m3-on-primary shadow-xs' 
                        : 'text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container'
                    }`}
                  >
                    <CheckCircle2 className="w-3.5 h-3.5 shrink-0 text-m3-secondary" />
                    <span>{guideLabels.tipsTitle}</span>
                  </button>
                )}
              </div>

              <!-- Sub Panel 1: Dress Code -->
              {parsedDressCode && (
                <div
                  id="panel-dresscode"
                  role="tabpanel"
                  aria-labelledby="tab-dresscode-btn"
                  data-guide-panel="dresscode"
                  class="bg-m3-surface-container-low border border-m3-outline-variant rounded-m3-xl p-4 sm:p-5 space-y-3.5"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-m3-outline-variant/60 pb-2.5">
                    <div>
                      <h4 class="font-bold text-sm sm:text-base font-heading text-m3-on-surface">
                        {guideLabels.dressCodeLabel}
                      </h4>
                      <p class="text-xs font-medium text-m3-on-surface-variant">
                        {isTour ? "Mandatory Temple Entry Attire Policy" : "Chauffeur Standards & Code of Conduct"}
                      </p>
                    </div>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-m3-full text-xs font-bold uppercase tracking-wider bg-m3-surface-container text-m3-on-surface border border-m3-outline-variant">
                      {isTour ? "Mandatory" : "Verified Standard"}
                    </span>
                  </div>

                  {parsedDressCode.general && parsedDressCode.items && parsedDressCode.items.length > 0 && (
                    <p class="text-xs sm:text-sm font-medium leading-relaxed text-m3-on-surface">
                      {parsedDressCode.general}
                    </p>
                  )}

                  {parsedDressCode.items && parsedDressCode.items.length > 0 && (
                    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
                      {parsedDressCode.items.map((item: any) => (
                        <div class="bg-m3-surface rounded-m3-lg p-3.5 border border-m3-outline-variant shadow-xs space-y-1.5">
                          <h5 class="font-bold text-xs sm:text-sm text-m3-on-surface block font-heading border-b border-m3-outline-variant/60 pb-1">
                            {item.title}
                          </h5>
                          <div class="space-y-1 text-xs">
                            <div class="flex items-start gap-1.5 text-m3-on-surface">
                              <CheckCircle2 className="w-3.5 h-3.5 text-m3-secondary shrink-0 mt-0.5" />
                              <span class="leading-relaxed"><strong>Allowed:</strong> {item.allowed}</span>
                            </div>
                            {item.prohibited && (
                              <div class="flex items-start gap-1.5 text-m3-on-surface-variant">
                                <XCircle className="w-3.5 h-3.5 text-m3-primary shrink-0 mt-0.5" />
                                <span class="leading-relaxed"><strong>Prohibited:</strong> {item.prohibited}</span>
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}

                  {isTour ? (
                    <div class="p-3 bg-m3-primary-container/40 border border-m3-primary/20 rounded-m3-md text-xs sm:text-sm text-m3-on-surface flex items-start gap-2.5">
                      <AlertCircle className="w-4 h-4 text-m3-primary shrink-0 mt-0.5" />
                      <span class="leading-relaxed">
                        <strong class="font-bold text-m3-on-primary-container">Strict Enforcement:</strong> {service.slug === 'tirupati-package' 
                          ? "Devotees wearing jeans, modern printed t-shirts, Bermudas, shorts, or western clothing will be strictly stopped at the Vaikuntam scanning queue and denied sanctum entry."
                          : "Traditional attire is mandatory across major South Indian shrines. Devotees in western outfits, shorts, or modern t-shirts will be stopped at entrance gopurams and denied inner sanctum entry."}
                      </span>
                    </div>
                  ) : (
                    <div class="p-3 bg-m3-surface-container border border-m3-outline-variant rounded-m3-md text-xs sm:text-sm text-m3-on-surface flex items-start gap-2.5">
                      <ShieldCheck className="w-4 h-4 text-m3-primary shrink-0 mt-0.5" />
                      <span class="leading-relaxed">
                        <strong class="font-bold">Professional Assurance:</strong> Every assigned driver is police background-verified (PVC), carries a photo ID badge, maintains personal car cleanliness, and strictly adheres to passenger confidentiality and speed discipline.
                      </span>
                    </div>
                  )}
                </div>
              )}

              <!-- Sub Panel 2: Practical Tips -->
              {parsedTips.length > 0 && (
                <div
                  id="panel-tips"
                  role="tabpanel"
                  aria-labelledby="tab-tips-btn"
                  data-guide-panel="tips"
                  class={`bg-m3-surface-container-low border border-m3-outline-variant rounded-m3-xl p-4 sm:p-5 space-y-3.5 ${parsedDressCode ? 'hidden' : ''}`}
                >
                  <h4 class="font-bold text-sm sm:text-base font-heading text-m3-on-surface">
                    {guideLabels.tipsTitle}
                  </h4>
                  <div class="grid sm:grid-cols-2 gap-3">
                    {parsedTips.map((tip: any) => (
                      <div class="bg-m3-surface p-3.5 rounded-m3-md border border-m3-outline-variant/60 flex items-start gap-2.5 shadow-xs">
                        <CheckCircle2 className="w-4 h-4 text-m3-secondary shrink-0 mt-0.5" />
                        <div class="space-y-1 text-xs sm:text-sm min-w-0 flex-1">
                          {tip.title && (
                            <span class="font-bold text-m3-on-surface block font-heading">{tip.title}</span>
                          )}
                          <p class="text-m3-on-surface-variant leading-relaxed break-words">{tip.desc}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}
        </section>
      )}

      <!-- 4. FAQS -->
      {service.faq && (
        <section
          id="faq"
          class="bg-m3-surface rounded-m3-2xl p-5 sm:p-7 border border-m3-outline-variant shadow-m3-1 space-y-5 scroll-mt-40"
        >
          <div class="border-b border-m3-outline-variant/60 pb-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-bold uppercase tracking-widest mb-2">
              Help &amp; Queries
            </span>
            <h2 class="text-lg sm:text-xl font-bold text-m3-on-surface flex items-center gap-2 font-heading">
              <HelpCircle className="w-5 h-5 text-m3-primary" />
              <span>{shortName} FAQs &amp; Booking Information</span>
            </h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">Instant answers to common booking, darshan timings &amp; permit queries</p>
          </div>

          <FAQAccordion items={service.faq} columns={1} name="faq-accordion" />

          {/* Important Notes if present */}
          {service.notes && (
            <div class="p-4 sm:p-5 bg-m3-primary-container/30 border border-m3-primary/20 rounded-m3-lg mt-4">
              <h3 class="text-xs font-bold text-m3-on-primary-container uppercase tracking-wider mb-2 flex items-center gap-2 font-heading">
                <Info className="w-4 h-4 text-m3-primary" />
                <span>Important Terms &amp; Safety Notes</span>
              </h3>
              <ul class="space-y-1.5">
                {service.notes.map((note: string) => (
                  <li class="text-xs sm:text-sm text-m3-on-surface flex items-start gap-2">
                    <span class="text-m3-primary font-bold">•</span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}

      <!-- 3. CONVERSION BANNER (Calibrated Charcoal Theme) -->
      <section class="bg-m3-inverse-surface text-m3-inverse-on-surface rounded-m3-2xl p-6 sm:p-10 text-center shadow-m3-3 border border-slate-800">
        <div class="max-w-2xl mx-auto space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold font-heading text-white">
            Ready to Book {service.title}?
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            {isTour 
              ? "Reserve your sanitized AC car with an experienced pilgrimage chauffeur. Zero advance deposit required — pay upon boarding or trip completion." 
              : "Share your car details and pickup address. Our dispatch team confirms your chauffeur in 60 seconds with zero advance deposit."}
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <WhatsAppButton
              href={whatsappLink}
              size="md"
              variant="filled"
              className="w-full sm:w-auto"
              text="Confirm on WhatsApp"
            />
            <a
              href="tel:+916381939769"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 bg-m3-surface hover:bg-m3-surface-container text-m3-on-surface font-bold text-xs sm:text-sm rounded-m3-full shadow-m3-1 transition-all"
            >
              <Phone className="w-4 h-4 text-m3-primary" />
              <span>Call Dispatch: +91 63819 39769</span>
            </a>
          </div>
        </div>
      </section>

    </div>

  </main>
</Layout>

<script>
  function setupGuideTabs() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.guide-tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('[data-guide-panel]');

    if (!tabBtns.length) return;

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-guide-tab');
        if (!target) return;

        tabBtns.forEach((b) => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs');
          b.classList.add('text-m3-on-surface-variant');
        });

        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs');
        btn.classList.remove('text-m3-on-surface-variant');

        tabPanels.forEach((p) => {
          if (p.getAttribute('data-guide-panel') === target) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  }

  setupGuideTabs();
  document.addEventListener('astro:page-load', setupGuideTabs);
</script>
