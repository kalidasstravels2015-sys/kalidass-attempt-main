---
import Layout from '../../layouts/Layout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import serviceDetails from '../../data/serviceDetails.json';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { 
  ShieldCheck, 
  Clock, 
  MapPin, 
  Phone, 
  MessageCircle, 
  CheckCircle2, 
  XCircle, 
  HelpCircle, 
  Info, 
  Sparkles, 
  ChevronRight, 
  Compass, 
  FileText,
  AlertCircle,
  Car,
  Users
} from 'lucide-react';

export async function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: any };
const whatsappLink = `https://wa.me/916381939769?text=${encodeURIComponent(service.whatsappMsg || `Hi Kalidass Travels, I would like to book ${service.title}.`)}`;

const isActingDriver = service.category === 'Acting Driver Services' || service.slug.includes('driver');
const isTour = ['Temple Tours', 'Popular Destinations'].includes(service.category);

const guideLabels = isTour ? {
  sectionTitle: "Travel Guide & Pilgrimage Information",
  col1Title: "Route & Distance Summary",
  col2Title: "Darshan Timings & Guidelines",
  dressCodeLabel: "Devotee Traditional Dress Code",
  exclusionsLabel: "Package Exclusions (Not Included)",
  tipsTitle: "Practical Tips for Pilgrims & Travelers"
} : {
  sectionTitle: "Service Protocol & Booking Information",
  col1Title: "Service Scope & Coverage",
  col2Title: "Operational Timings & SLAs",
  dressCodeLabel: "Chauffeur Dress Code & Conduct",
  exclusionsLabel: "Owner Responsibility / Excluded",
  tipsTitle: "Important Guidelines & Checklist"
};

const tourImages: Record<string, string> = {
  "tirupati-package": "/images/temple/tirupati-balaji.webp",
  "thiruvannamalai-girivalam-trip": "/images/temple/thiruvannamalai-girivalam.webp",
  "rameswaram-2-days": "/images/temple/rameswaram.webp",
  "navagraha-tour": "/images/temple/navagraha.webp",
  "kanchipuram-temple-trip": "/images/temple/kanchipuram-temple.webp",
  "chidambaram-temple-trip": "/images/temple/chidambaram-natarajar-temple.webp",
  "sabarimala-trip": "/images/temple/sabarimala-temple.webp",
  "pondicherry-one-day-trip": "/images/temple/pondicherry.webp",
  "vellore-golden-temple": "/images/temple/vellore-golden.webp",
  "mahabalipuram-ecr-temple-route": "/images/temple/mahabalipuram-ecr-temples.webp",
  "one-day-chennai-city-tour": "/images/temple/chennai-city.webp",
  "yelagiri-hills-weekend": "/images/hero/coimbatore.webp",
  "yercaud-hills-weekend": "/images/hero/airavatesvara.webp"
};

const serviceShortNames: Record<string, string> = {
  "tirupati-package": "Tirupati Balaji",
  "navagraha-tour": "Kumbakonam Navagraha",
  "thiruvannamalai-girivalam-trip": "Thiruvannamalai Girivalam",
  "sabarimala-trip": "Sabarimala Pilgrim",
  "rameswaram-2-days": "Rameswaram & Dhanushkodi",
  "kanchipuram-temple-trip": "Kanchipuram Temple",
  "chidambaram-temple-trip": "Chidambaram & Pichavaram",
  "vellore-golden-temple": "Vellore Golden Temple",
  "acting-driver-within-chennai": "Local Chennai Acting Driver",
  "acting-driver-outstation-round-trip": "Outstation Round-Trip Driver",
  "acting-driver-outstation-one-way": "Outstation One-Way Driver Drop",
  "monthly-car-with-driver-corporate": "Monthly Corporate Car & Chauffeur",
  "employee-pickup-drop": "Corporate Employee Transportation",
  "pondicherry-one-day-trip": "Pondicherry Tour",
  "one-day-chennai-city-tour": "Chennai City Sightseeing",
  "driver-car-for-weddings": "Wedding Car & Chauffeur",
  "mahabalipuram-ecr-temple-route": "Mahabalipuram & ECR Tour",
  "yelagiri-hills-weekend": "Yelagiri Hills Weekend",
  "yercaud-hills-weekend": "Yercaud Weekend Package",
  "chennai-airport-taxi-transfers": "Chennai Airport Cab Transfer",
};

const shortName = serviceShortNames[service.slug] || service.destination || service.title;

const categoryImages: Record<string, string> = {
  "Acting Drivers": "/images/services/acting-drivers.webp",
  "Acting Driver Services": "/images/services/acting-drivers.webp",
  "Corporate Mobility": "/images/services/corporate.webp",
  "Corporate Travel": "/images/services/corporate.webp",
  "Airport Transfers": "/images/services/airport-transfer.webp",
  "Temple Tours": "/images/services/temple-tours.webp",
  "Outstation Cabs": "/images/temple/mahabalipuram-ecr-temples.webp",
  "Popular Destinations": "/images/temple/mahabalipuram-ecr-temples.webp",
  "Premium Fleet Rental": "/images/services/corporate.webp"
};

const heroImage = tourImages[service.slug] || categoryImages[service.category] || null;

// Priority column regexes to locate true total package price headers
const priorityHeaderRegexes = [
  /total.*cost/i,
  /round-trip.*cost|round-trip.*flat/i,
  /package.*cost/i,
  /flat.*cost/i,
  /total.*1-day/i,
  /1-day.*cost/i,
  /total/i,
  /airport.*drop/i,
  /driver.*charge/i,
  /monthly.*rate/i,
  /driver.*fee/i,
  /driver.*bata|daily.*driver.*bata/i,
  /rate/i
];

// Extract starting price if tariff exists
function extractStartingPrice(svc: any): string | null {
  if (!svc.tariff?.rows || svc.tariff.rows.length === 0) return null;
  const headers = svc.tariff.headers || [];
  const rows = svc.tariff.rows;

  let targetColIdx = -1;
  for (const regex of priorityHeaderRegexes) {
    const idx = headers.findIndex((h: string) => regex.test(h) && !/rate\/km/i.test(h) && !/night/i.test(h));
    if (idx !== -1) {
      targetColIdx = idx;
      break;
    }
  }

  let minPrice = Infinity;

  for (const row of rows) {
    let cellsToCheck: any[] = [];
    if (targetColIdx !== -1 && row[targetColIdx] !== undefined) {
      cellsToCheck = [row[targetColIdx]];
    } else {
      cellsToCheck = [...row].reverse();
    }

    for (const cell of cellsToCheck) {
      const cellStr = String(cell);
      if (!cellStr.includes('₹')) continue;
      const matches = [...cellStr.matchAll(/₹\s*([0-9,]+)/g)];
      if (matches.length > 0) {
        // Take the first number in the cell (e.g. ₹3,200 in ₹3,200 – ₹3,500)
        const num = parseInt(matches[0][1].replace(/,/g, ''), 10);
        if (!isNaN(num) && num > 0) {
          if (num < 100 && (/trip|tour|package|drop|wedding/i.test(svc.slug) || /temple/i.test(svc.category))) {
            continue;
          }
          minPrice = num;
          break;
        }
      }
    }
    if (minPrice !== Infinity && minPrice > 0) {
      break;
    }
  }

  return minPrice !== Infinity ? String(minPrice) : null;
}

const startingPrice = extractStartingPrice(service);

// Helper to categorize vehicles and choose appropriate vehicle badges
const getVehicleBadge = (name: string) => {
  const v = (name || '').toLowerCase();
  if (v.includes('tempo') || v.includes('traveller')) return 'Group Coach';
  if (v.includes('crysta')) return 'Executive Luxury';
  if (v.includes('ertiga') || v.includes('xl6')) return 'Family Favorite';
  if (v.includes('innova')) return 'Comfort MUV';
  if (v.includes('dzire') || v.includes('etios') || v.includes('sedan')) return 'Best Value Sedan';
  return 'Comfort Cab';
};

// Helper to match vehicle images from fleet
const getVehicleFleetImage = (name: string) => {
  const v = (name || '').toLowerCase();
  if (v.includes('tempo') || v.includes('traveller') || v.includes('van') || v.includes('coach')) {
    return '/images/fleet/tempo.webp';
  }
  if (v.includes('crysta') || v.includes('innova') || v.includes('ertiga') || v.includes('xl6') || v.includes('suv') || v.includes('muv') || v.includes('mpv')) {
    return '/images/fleet/suv.webp';
  }
  if (v.includes('dzire') || v.includes('etios') || v.includes('sedan') || v.includes('aura') || v.includes('car')) {
    return '/images/fleet/swift-dzire.webp';
  }
  return null;
};



const areas: any[] = [];
if (service.origin) {
  areas.push({ "@type": "City", "name": service.origin });
} else {
  areas.push({ "@type": "City", "name": "Chennai" });
}
if (service.destination) {
  areas.push({ "@type": "City", "name": service.destination });
}
areas.push(
  { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
  { "@type": "AdministrativeArea", "name": "Andhra Pradesh" },
  { "@type": "AdministrativeArea", "name": "Puducherry" }
);

// Granular multi-vehicle offers for TaxiService & packages
let offersData: any = null;
if (service.tariff?.rows && service.tariff.rows.length > 0) {
  const headers = service.tariff.headers || [];
  let targetColIdx = -1;
  for (const regex of priorityHeaderRegexes) {
    const idx = headers.findIndex((h: string) => regex.test(h) && !/rate\/km/i.test(h) && !/night/i.test(h));
    if (idx !== -1) {
      targetColIdx = idx;
      break;
    }
  }

  const capIdx = headers.findIndex((h: string) => /capacity|seating/i.test(h));
  const incIdx = headers.findIndex((h: string) => /inclusion|notes|coverage/i.test(h));

  const validOffers: any[] = [];
  for (const row of service.tariff.rows) {
    const vehicleName = row[0] || service.title;
    const capacity = capIdx !== -1 ? row[capIdx] : (row.length > 2 ? row[1] : '');
    const inclusions = incIdx !== -1 ? row[incIdx] : (row.length > 3 ? row[3] : '');

    let rowPrice: string | null = null;
    if (targetColIdx !== -1 && row[targetColIdx] !== undefined) {
      const match = String(row[targetColIdx]).match(/₹\s*([0-9,]+)/);
      if (match) {
        rowPrice = match[1].replace(/,/g, '');
      }
    }

    if (!rowPrice) {
      for (let i = row.length - 1; i >= 1; i--) {
        const cellStr = String(row[i]);
        if (!cellStr.includes('₹')) continue;
        const matches = [...cellStr.matchAll(/₹\s*([0-9,]+)/g)];
        if (matches.length > 0) {
          const num = parseInt(matches[0][1].replace(/,/g, ''), 10);
          if (!isNaN(num) && num > 0) {
            if (num < 100 && (/trip|tour|package|drop|wedding/i.test(service.slug) || /temple/i.test(service.category))) {
              continue;
            }
            rowPrice = String(num);
            break;
          }
        }
      }
    }

    // Only emit Offer if a valid positive price was found
    if (rowPrice && parseInt(rowPrice, 10) > 0) {
      validOffers.push({
        "@type": "Offer",
        "name": `${service.title} - ${vehicleName}`,
        "priceCurrency": "INR",
        "price": rowPrice,
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": `https://kalidasstravels.in/services/${service.slug}/`,
        "description": [capacity, inclusions].filter(Boolean).join(' | '),
        "seller": {
          "@id": "https://kalidasstravels.in/#localbusiness"
        }
      });
    }
  }

  if (validOffers.length > 0) {
    offersData = validOffers;
  }
}

if (!offersData && startingPrice) {
  offersData = {
    "@type": "Offer",
    "name": service.title,
    "priceCurrency": "INR",
    "price": startingPrice,
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": `https://kalidasstravels.in/services/${service.slug}/`,
    "seller": {
      "@id": "https://kalidasstravels.in/#localbusiness"
    }
  };
}

// Construct Schema.org structured data
const pageSchemas: any[] = [];

if (isTour) {
  // 1. TaxiService node: handles commercial cab booking, vehicle rates & mobility
  const taxiServiceSchema: Record<string, any> = {
    "@type": "TaxiService",
    "@id": `https://kalidasstravels.in/services/${service.slug}/#service`,
    "name": `${service.title} Cab Package`,
    "description": service.metaDescription || service.overview,
    "image": heroImage ? `https://kalidasstravels.in${heroImage}` : "https://kalidasstravels.in/images/logo.webp",
    "provider": {
      "@id": "https://kalidasstravels.in/#localbusiness",
    },
    "providerMobility": "dynamic",
    "serviceType": service.serviceType || "Pilgrimage Outstation Cab Package",
    "areaServed": areas,
    "url": `https://kalidasstravels.in/services/${service.slug}/`,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "1250",
      "bestRating": "5",
      "worstRating": "1"
    }
  };
  if (offersData) {
    taxiServiceSchema.offers = offersData;
  }
  pageSchemas.push(taxiServiceSchema);

  // 2. TouristTrip node: handles the pilgrimage route itinerary, sacred stops & devotion
  const touristTripSchema: Record<string, any> = {
    "@type": "TouristTrip",
    "@id": `https://kalidasstravels.in/services/${service.slug}/#trip`,
    "name": service.metaTitle || service.title,
    "description": service.metaDescription || service.overview,
    "image": heroImage ? `https://kalidasstravels.in${heroImage}` : "https://kalidasstravels.in/images/logo.webp",
    "provider": {
      "@id": "https://kalidasstravels.in/#localbusiness",
    },
    "url": `https://kalidasstravels.in/services/${service.slug}/`,
    "touristType": ["Pilgrims", "Devotees", "Families"]
  };
  if (service.routePlan && service.routePlan.length > 0) {
    touristTripSchema.itinerary = {
      "@type": "ItemList",
      "name": `${service.title} Route Itinerary`,
      "itemListElement": service.routePlan.map((step: any, idx: number) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "item": {
          "@type": "TouristAttraction",
          "name": step.stop,
          "description": step.desc
        }
      }))
    };
  }
  if (offersData) {
    touristTripSchema.offers = offersData;
  }
  pageSchemas.push(touristTripSchema);
} else {
  // Non-tour services: Acting Drivers or regular Taxi Transfers
  const singleSchema: Record<string, any> = {
    "@type": isActingDriver ? "Service" : (service.serviceType || "TaxiService"),
    "@id": `https://kalidasstravels.in/services/${service.slug}/#service`,
    "name": service.metaTitle || service.title,
    "description": service.metaDescription || service.overview,
    "image": heroImage ? `https://kalidasstravels.in${heroImage}` : "https://kalidasstravels.in/images/logo.webp",
    "provider": {
      "@id": "https://kalidasstravels.in/#localbusiness",
    },
    "providerMobility": "dynamic",
    "areaServed": areas,
    "url": `https://kalidasstravels.in/services/${service.slug}/`,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "1250",
      "bestRating": "5",
      "worstRating": "1"
    }
  };
  if (service.serviceType) {
    singleSchema.serviceType = service.serviceType;
  }
  if (offersData) {
    singleSchema.offers = offersData;
  }
  pageSchemas.push(singleSchema);
}

const faqSchema = service.faq && service.faq.length > 0 ? {
  "@type": "FAQPage",
  "@id": `https://kalidasstravels.in/services/${service.slug}/#faq`,
  "mainEntity": service.faq.map((item: any) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
} : null;

if (faqSchema) {
  pageSchemas.push(faqSchema);
}

const categorySlugMap: Record<string, string> = {
  'Acting Drivers': 'acting-drivers',
  'Acting Driver Services': 'acting-drivers',
  'Corporate Mobility': 'corporate',
  'Corporate Travel': 'corporate',
  'Temple Tours': 'tours/temple-tours',
  'Weekend Packages': 'tours/weekend-packages',
  'Airport Transfers': 'chennai-airport-taxi',
  'Outstation Cabs': 'outstation-cabs',
  'Popular Destinations': 'outstation-cabs',
  'Premium Fleet Rental': 'corporate',
  'Misc Services': 'outstation-cabs'
};

const categorySlug = categorySlugMap[service.category] || 'acting-drivers';

const breadcrumbItems = [
  { name: 'Services', item: '/services/' },
  { name: service.category, item: `/services/${categorySlug}/` },
  { name: service.title, item: `/services/${service.slug}/` },
];

// Parsed Darshan Timings
const timingItems = service.travelGuide?.timings 
  ? service.travelGuide.timings.split('\n').map((line: string) => {
      const trimmed = line.replace(/^[•\-\*]\s*/, '').trim();
      const colonIdx = trimmed.indexOf(':');
      if (colonIdx > -1) {
        return {
          label: trimmed.substring(0, colonIdx).replace(/\*\*/g, '').trim(),
          time: trimmed.substring(colonIdx + 1).replace(/\*\*/g, '').trim()
        };
      }
      return { label: trimmed.replace(/\*\*/g, ''), time: '' };
    }).filter((t: any) => t.label)
  : [];

// Parsed Dress Code
interface DressCodeItem {
  title: string;
  allowed: string;
  prohibited?: string;
}

const parseDressCode = (rawText: string) => {
  if (!rawText) return null;
  const isStructured = rawText.toLowerCase().includes('men:') || rawText.toLowerCase().includes('women:');
  if (!isStructured) {
    return { general: rawText, items: [] as DressCodeItem[] };
  }

  const lines = rawText.split('\n').map(l => l.trim()).filter(Boolean);
  let general = '';
  const items: DressCodeItem[] = [];

  for (const line of lines) {
    const cleanLine = line.replace(/^[•\-\*\s]+/, '').trim();
    const lower = cleanLine.toLowerCase();

    if (lower.startsWith('women:')) {
      const content = cleanLine.substring(6).trim();
      let allowed = content;
      let prohibited = "Jeans, leggings, western wear strictly prohibited";
      const pIdx = content.indexOf('(');
      if (pIdx > -1) {
        allowed = content.substring(0, pIdx).trim();
        prohibited = content.substring(pIdx + 1).replace(/\).*$/, '').trim();
      }
      items.push({
        title: "Women's Attire",
        allowed,
        prohibited
      });
    } else if (lower.startsWith('men:')) {
      const content = cleanLine.substring(4).trim();
      let allowed = content;
      let prohibited = "Jeans, T-shirts, shorts strictly prohibited";
      const pIdx = content.indexOf('(');
      if (pIdx > -1) {
        allowed = content.substring(0, pIdx).trim();
        prohibited = content.substring(pIdx + 1).replace(/\).*$/, '').trim();
      }
      items.push({
        title: "Men's Attire",
        allowed,
        prohibited
      });
    } else if (lower.startsWith('children:')) {
      const content = cleanLine.substring(9).trim().replace(/\.$/, '');
      items.push({
        title: "Children's Attire",
        allowed: content
      });
    } else if (!general) {
      general = cleanLine;
    }
  }

  return { general, items };
};

const parsedDressCode = service.travelGuide?.dressCode ? parseDressCode(service.travelGuide.dressCode) : null;

// Parsed Practical Tips
const parsedTips = service.travelGuide?.tips?.map((tip: string) => {
  const colonIdx = tip.indexOf(':');
  if (colonIdx > -1 && colonIdx < 35) {
    return {
      title: tip.substring(0, colonIdx).trim(),
      desc: tip.substring(colonIdx + 1).trim()
    };
  }
  return { title: '', desc: tip };
}) || [];
---

<Layout 
  title={service.metaTitle || `${service.title} – Kalidass Travels`}
  description={service.metaDescription || service.overview}
  keywords={service.keywords}
  image={heroImage || undefined}
  ogImage={`/og/${service.slug}.jpg`}
  type="article"
  schema={pageSchemas}
>
  <main class="bg-m3-surface-container-low text-m3-on-surface min-h-screen pb-16 font-sans">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- 1. M3 HERO SECTION (Calibrated Warm Light Theme matching /services/) -->
    <section class="bg-m3-surface border-b border-m3-outline-variant pt-3 sm:pt-6 pb-8 md:pb-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        {/* Category & Status Chips */}
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <a 
            href={`/services/${categorySlug}/`}
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container text-xs font-bold uppercase tracking-wider border border-m3-primary/20 hover:bg-m3-primary/15 transition-colors"
          >
            <span>{service.category}</span>
          </a>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant text-m3-on-surface text-xs font-medium">
            <ShieldCheck className="w-3.5 h-3.5 text-m3-primary" />
            <span>Verified &amp; Guaranteed SLA</span>
          </span>
        </div>

        <h1 class="text-xl sm:text-3xl lg:text-4xl font-extrabold text-m3-on-surface tracking-tight mb-4 leading-tight font-heading">
          {service.title}
        </h1>

        <!-- Service Visual Hero Banner / Placeholder -->
        <div class="relative w-full h-44 sm:h-64 md:h-72 rounded-m3-xl overflow-hidden shadow-m3-1 border border-m3-outline-variant/60 mb-5 bg-slate-900">
          {heroImage ? (
            <OptimizedImage
              src={heroImage}
              alt={`Kalidass Travels - ${service.title}`}
              class="w-full h-full object-cover"
              sizes="(max-width: 640px) 100vw, 896px"
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 text-slate-300 p-6 text-center">
              <div class="w-12 h-12 rounded-m3-full bg-white/10 flex items-center justify-center mb-2 text-white/80">
                <span class="material-symbols-outlined text-[28px]">image</span>
              </div>
              <p class="text-xs sm:text-sm font-semibold text-white/90">{service.title}</p>
              <span class="text-micro text-slate-400 mt-0.5 uppercase tracking-wider">Service Visual (Placeholder)</span>
            </div>
          )}

          <!-- Subtle Bottom Gradient Scrim & Badges -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none gap-2">
            <span class="px-2.5 py-0.5 rounded-m3-full bg-slate-900/80 backdrop-blur-md text-white text-micro font-semibold border border-white/20 shadow-sm truncate max-w-[50%]">
              {service.category}
            </span>
            {service.duration && (
              <span class="px-2.5 py-0.5 rounded-m3-full bg-m3-primary/90 backdrop-blur-md text-white text-micro font-bold shadow-sm truncate max-w-[50%]">
                {service.duration.split('(')[0].trim()}
              </span>
            )}
          </div>
        </div>

