                        <div class={`w-2 h-2 rounded-full shrink-0 mt-1.5 ring-2 ${
                          isTour 
                            ? 'bg-amber-600 ring-amber-100' 
                            : 'bg-m3-primary ring-m3-primary/20'
                        }`}></div>
                        <div class="min-w-0 flex-1">
                          <span class="block font-bold text-xs text-m3-on-surface font-heading leading-tight truncate">
                            {item.title}
                          </span>
                          {item.desc && (
                            <span class="block text-micro text-m3-on-surface-variant font-medium leading-snug mt-0.5">
                              {item.desc}
                            </span>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              <div class="mt-4 pt-3 border-t border-m3-outline-variant/40 flex items-center gap-1.5 text-micro font-semibold text-emerald-800">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>{isTour ? "Sacred yatra circuit coordinated with verified sanctum pooja timings" : "Doorstep pickup & return across all Chennai neighborhoods"}</span>
              </div>
            </div>

            {/* CARD 2: Temple & Darshan Timings */}
            <div class="bg-m3-surface-container-low rounded-m3-xl p-4 sm:p-5 border border-m3-outline-variant flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 border-b border-m3-outline-variant/60 pb-2.5 mb-3.5">
                  <h3 class="font-bold text-m3-on-surface text-sm sm:text-base font-heading flex items-center gap-2">
                    <Clock className="w-4 h-4 text-m3-primary shrink-0" />
                    <span>{guideLabels.col2Title}</span>
                  </h3>
                  <span class="text-micro font-bold uppercase tracking-wider text-m3-on-surface-variant bg-m3-surface-container px-2 py-0.5 rounded-m3-sm border border-m3-outline-variant/50">
                    {isTour ? "Darshan Slots" : "Operational SLA"}
                  </span>
                </div>

                {timingItems.length > 0 ? (
                  <div class="space-y-2">
                    {timingItems.map((item: any) => {
                      const isLong = item.time && item.time.length > 28;
                      return (
                        <div class={`bg-m3-surface p-2.5 rounded-m3-lg border border-m3-outline-variant/60 text-xs sm:text-sm ${
                          isLong 
                            ? 'space-y-1' 
                            : 'flex flex-col sm:flex-row sm:items-center justify-between gap-1.5'
                        }`}>
                          <span class="font-semibold text-m3-on-surface leading-snug">{item.label}</span>
                          {item.time && (
                            <span class={`inline-block px-2.5 py-0.5 bg-m3-primary-container text-m3-on-primary-container text-xs font-bold leading-relaxed max-w-full break-words ${
                              isLong 
                                ? 'rounded-m3-md w-full' 
                                : 'rounded-m3-full self-start sm:self-auto shrink-0'
                            }`}>
                              {item.time}
                            </span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <div class="space-y-2 text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed">
                    <p>24/7 round-the-clock booking and dispatch support across Chennai.</p>
                  </div>
                )}
              </div>

              {isTour && (
                <div class="mt-4 pt-3 border-t border-m3-outline-variant/40 flex items-start gap-1.5 text-micro text-m3-on-surface-variant">
                  <Info className="w-3.5 h-3.5 text-amber-600 shrink-0 mt-0.5" />
                  <span>Afternoon Break: Most shrines close 12:30 PM – 04:00 PM for pooja &amp; reopen in the evening.</span>
                </div>
              )}
            </div>

            {/* CARD 3: Devotee Traditional Dress Code / Chauffeur Standards */}
            <div class="bg-m3-surface-container-low rounded-m3-xl p-4 sm:p-5 border border-m3-outline-variant flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 border-b border-m3-outline-variant/60 pb-2.5 mb-3.5">
                  <h3 class="font-bold text-m3-on-surface text-sm sm:text-base font-heading flex items-center gap-2">
                    {isTour ? <Sparkles className="w-4 h-4 text-amber-600 shrink-0" /> : <ShieldCheck className="w-4 h-4 text-emerald-600 shrink-0" />}
                    <span>{guideLabels.dressCodeLabel}</span>
                  </h3>
                  <span class="text-micro font-bold uppercase tracking-wider text-m3-on-surface-variant bg-m3-surface-container px-2 py-0.5 rounded-m3-sm border border-m3-outline-variant/50">
                    {isTour ? "Mandatory Policy" : "Chauffeur Standard"}
                  </span>
                </div>

                {parsedDressCode?.general && (
                  <p class="text-xs sm:text-sm font-medium leading-relaxed text-m3-on-surface mb-3">
                    {parsedDressCode.general}
                  </p>
                )}

                {parsedDressCode?.items && parsedDressCode.items.length > 0 ? (
                  <div class="grid sm:grid-cols-2 gap-2.5 mb-3">
                    {parsedDressCode.items.map((item: any) => (
                      <div class="bg-m3-surface rounded-m3-lg p-3 border border-m3-outline-variant shadow-2xs space-y-1">
                        <h4 class="font-bold text-xs text-m3-on-surface font-heading border-b border-m3-outline-variant/50 pb-1">
                          {item.title}
                        </h4>
                        <div class="text-xs space-y-1 pt-0.5">
                          <div class="flex items-start gap-1.5 text-m3-on-surface">
                            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                            <span class="leading-snug"><strong class="font-semibold text-emerald-900">Allowed:</strong> {item.allowed}</span>
                          </div>
                          {item.prohibited && (
                            <div class="flex items-start gap-1.5 text-m3-on-surface-variant">
                              <XCircle className="w-3.5 h-3.5 text-rose-600 shrink-0 mt-0.5" />
                              <span class="leading-snug"><strong class="font-semibold text-rose-800">Prohibited:</strong> {item.prohibited}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="text-xs text-m3-on-surface-variant leading-relaxed mb-3">
                    All passengers and drivers are expected to maintain professional and respectful attire.
                  </p>
                )}
              </div>

              {isTour ? (
                <div class="mt-2 p-2.5 bg-amber-500/10 border border-amber-400/30 rounded-m3-md text-micro sm:text-xs text-amber-950 flex items-start gap-2">
                  <AlertCircle className="w-3.5 h-3.5 text-amber-700 shrink-0 mt-0.5" />
                  <span class="leading-snug">
                    <strong class="font-bold">Strict Rule:</strong> Western wear, jeans, shorts, and Bermudas are prohibited inside sanctums by temple authorities.
                  </span>
                </div>
              ) : (
                <div class="mt-2 p-2.5 bg-emerald-50 border border-emerald-200 rounded-m3-md text-micro sm:text-xs text-emerald-950 flex items-start gap-2">
                  <ShieldCheck className="w-3.5 h-3.5 text-emerald-700 shrink-0 mt-0.5" />
                  <span class="leading-snug">
                    <strong class="font-bold">Verified Drivers:</strong> Uniformed, police-verified, non-smoking chauffeurs with 7+ years of driving experience.
                  </span>
                </div>
              )}
            </div>

            {/* CARD 4: Practical Tips for Pilgrims & Travelers */}
            <div class="bg-m3-surface-container-low rounded-m3-xl p-4 sm:p-5 border border-m3-outline-variant flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 border-b border-m3-outline-variant/60 pb-2.5 mb-3.5">
                  <h3 class="font-bold text-m3-on-surface text-sm sm:text-base font-heading flex items-center gap-2">
                    <Lightbulb className="w-4 h-4 text-amber-600 shrink-0" />
                    <span>{guideLabels.tipsTitle}</span>
                  </h3>
                  <span class="text-micro font-bold uppercase tracking-wider text-m3-on-surface-variant bg-m3-surface-container px-2 py-0.5 rounded-m3-sm border border-m3-outline-variant/50">
                    {isTour ? "Pilgrim Tips" : "Checklist"}
                  </span>
                </div>

                {parsedTips.length > 0 ? (
                  <div class="space-y-2.5">
                    {parsedTips.map((tip: any) => (
                      <div class="bg-m3-surface p-2.5 sm:p-3 rounded-m3-lg border border-m3-outline-variant/60 flex items-start gap-2.5 shadow-2xs">
                        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                        <div class="space-y-0.5 text-xs sm:text-sm min-w-0 flex-1">
                          {tip.title && (
                            <span class="font-bold text-m3-on-surface block text-xs">{tip.title}</span>
                          )}
                          <p class="text-m3-on-surface-variant leading-relaxed text-xs break-words">{tip.desc}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="space-y-2 text-xs text-m3-on-surface-variant">
                    <p>Book at least 24 hours in advance to guarantee vehicle preference and early morning departure slots.</p>
                  </div>
                )}
              </div>

              <div class="mt-4 pt-3 border-t border-m3-outline-variant/40 flex items-center justify-between text-micro text-m3-on-surface-variant">
                <span class="font-semibold text-emerald-800">Assistance during darshan &amp; temple queues</span>
                <span class="font-bold text-m3-primary">24/7 Helpline</span>
              </div>
            </div>

          </div>
        </section>
      )}

      <!-- 4. FAQS -->
      {service.faq && (
        <section
          id="faq"
          class="bg-m3-surface rounded-m3-2xl p-5 sm:p-7 border border-m3-outline-variant shadow-m3-1 space-y-5 scroll-mt-40"
        >
          <div class="border-b border-m3-outline-variant/60 pb-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-bold uppercase tracking-widest mb-2">
              Help &amp; Queries
            </span>
            <h2 class="text-lg sm:text-xl font-bold text-m3-on-surface flex items-center gap-2 font-heading">
              <HelpCircle className="w-5 h-5 text-m3-primary" />
              <span>{shortName} FAQs &amp; Booking Information</span>
            </h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">Instant answers to common booking, darshan timings &amp; permit queries</p>
          </div>

          <FAQAccordion items={service.faq} columns={1} name="faq-accordion" />

          {/* Important Notes if present */}
          {service.notes && (
            <div class="p-4 sm:p-5 bg-m3-primary-container/30 border border-m3-primary/20 rounded-m3-lg mt-4">
              <h3 class="text-xs font-bold text-m3-on-primary-container uppercase tracking-wider mb-2 flex items-center gap-2 font-heading">
                <Info className="w-4 h-4 text-m3-primary" />
                <span>Important Terms &amp; Safety Notes</span>
              </h3>
              <ul class="space-y-1.5">
                {service.notes.map((note: string) => (
                  <li class="text-xs sm:text-sm text-m3-on-surface flex items-start gap-2">
                    <span class="text-m3-primary font-bold">•</span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}

      <!-- 3. CONVERSION BANNER (Calibrated Charcoal Theme) -->
      <section class="bg-m3-inverse-surface text-m3-inverse-on-surface rounded-m3-2xl p-6 sm:p-10 text-center shadow-m3-3 border border-slate-800">
        <div class="max-w-2xl mx-auto space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold font-heading text-white">
            {pilgrimConfig ? pilgrimConfig.ctaHeading : `Ready to Book Your ${shortName} Trip?`}
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            {isTour 
              ? "Reserve your sanitized AC car with an experienced pilgrimage chauffeur. Zero advance deposit required — pay upon boarding or trip completion." 
              : "Share your car details and pickup address. Our dispatch team confirms your chauffeur in 60 seconds with zero advance deposit."}
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <WhatsAppButton
              href={whatsappLink}
              size="md"
              variant="filled"
              className="w-full sm:w-auto"
              text="Confirm on WhatsApp"
            />
            <a
              href="tel:+918939539211"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 bg-m3-surface hover:bg-m3-surface-container text-m3-on-surface font-bold text-xs sm:text-sm rounded-m3-full shadow-m3-1 transition-all"
            >
              <Phone className="w-4 h-4 text-m3-primary" />
              <span>Call Dispatch: +91 89395 39211</span>
            </a>
          </div>
        </div>
      </section>

    </div>

  </main>
</Layout>
