          <script is:inline>
            (function() {
              function initTariffInteractions() {
                const btnCards = document.getElementById('tariff-btn-cards');
                const btnTable = document.getElementById('tariff-btn-table');
                const viewCards = document.getElementById('tariff-cards-view');
                const viewTable = document.getElementById('tariff-table-view');

                if (btnCards && btnTable && viewCards && viewTable) {
                  btnCards.addEventListener('click', function() {
                    viewCards.classList.remove('hidden');
                    viewTable.classList.add('hidden');
                    btnCards.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs');
                    btnCards.classList.remove('text-m3-on-surface-variant');
                    btnCards.setAttribute('aria-pressed', 'true');
                    btnTable.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs');
                    btnTable.classList.add('text-m3-on-surface-variant');
                    btnTable.setAttribute('aria-pressed', 'false');
                  });

                  btnTable.addEventListener('click', function() {
                    viewCards.classList.add('hidden');
                    viewTable.classList.remove('hidden');
                    btnTable.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs');
                    btnTable.classList.remove('text-m3-on-surface-variant');
                    btnTable.setAttribute('aria-pressed', 'true');
                    btnCards.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs');
                    btnCards.classList.add('text-m3-on-surface-variant');
                    btnCards.setAttribute('aria-pressed', 'false');
                  });
                }

                // Dynamic stay duration & pricing update for Tirupati tariff cards
                document.querySelectorAll('.tirupati-stay-select').forEach(function(select) {
                  select.addEventListener('change', function(e) {
                    const target = e.target;
                    const selectedOpt = target.options[target.selectedIndex];
                    if (!selectedOpt) return;

                    const card = target.closest('.tariff-card');
                    if (!card) return;

                    const price = selectedOpt.getAttribute('data-price');
                    const duration = selectedOpt.getAttribute('data-duration');
                    const inclusions = selectedOpt.getAttribute('data-inclusions');
                    const vehicleName = card.getAttribute('data-vehicle-name') || '';
                    const serviceTitle = card.getAttribute('data-service-title') || 'Chennai to Tirupati Cab';

                    // Update hero price
                    const priceEl = card.querySelector('.tariff-hero-price');
                    if (priceEl && price) {
                      priceEl.textContent = price;
                    }

                    // Update inclusions text
                    const inclusionsEl = card.querySelector('.tariff-inclusions-text');
                    if (inclusionsEl && inclusions) {
                      inclusionsEl.textContent = inclusions;
                    }

                    // Update WhatsApp enquiry button
                    const waBtn = card.querySelector('.tariff-whatsapp-btn');
                    if (waBtn) {
                      const newMsg = `Hi Kalidass Travels, I want to book ${vehicleName} for ${serviceTitle} (${duration}) (${price}).`;
                      waBtn.setAttribute('href', `https://wa.me/918939539211?text=${encodeURIComponent(newMsg)}`);
                      waBtn.setAttribute('aria-label', `Book ${vehicleName} on WhatsApp for ${price}`);
                    }
                  });
                });
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTariffInteractions);
              } else {
                initTariffInteractions();
              }
            })();
