                  <span>{guideLabels.col2Title}</span>
                </h3>
                <div class="grid gap-2">
                  {timingItems.map((item: any) => {
                    const isLong = item.time && item.time.length > 25;
                    return (
                      <div class={`bg-m3-surface-container-low p-2.5 sm:p-3 rounded-m3-md border border-m3-outline-variant/60 text-xs sm:text-sm ${
                        isLong 
                          ? 'space-y-1' 
                          : 'flex flex-col sm:flex-row sm:items-center justify-between gap-1.5'
                      }`}>
                        <span class="font-semibold text-m3-on-surface leading-snug">{item.label}</span>
                        {item.time && (
                          <span class={`inline-block px-2.5 py-0.5 bg-m3-primary-container text-m3-on-primary-container text-xs font-semibold leading-relaxed max-w-full break-words ${
                            isLong 
                              ? 'rounded-m3-md w-full' 
                              : 'rounded-m3-full self-start sm:self-auto shrink-0'
                          }`}>
                            {item.time}
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            ) : (
              <div class="space-y-2">
                <h3 class="font-bold text-m3-on-surface text-sm sm:text-base font-heading flex items-center gap-2">
                  <ShieldCheck className="w-4 h-4 text-m3-primary shrink-0" />
                  <span>Verified Service Standards</span>
                </h3>
                <p class="text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed">
                  All trips follow certified sanitization protocols, punctuality guarantees, and upfront transparent pricing with zero surprise charges.
                </p>
              </div>
            )}
          </div>

          <!-- Sub-Tabs for Dress Code & Practical Tips -->
          {(parsedDressCode || parsedTips.length > 0) && (
            <div class="pt-4 border-t border-m3-outline-variant/60 space-y-4">
