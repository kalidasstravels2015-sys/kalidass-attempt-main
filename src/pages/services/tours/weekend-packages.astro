    slug: "chennai-to-bangalore-taxi",
    image: "/images/hero/coimbatore.webp",
    rates: [
      { type: "Sedan", names: "Swift Dzire / Etios", passengers: "4 Passengers", baggage: "2 Bags", price: "₹14 / km" },
      { type: "Family SUV", names: "Maruti Ertiga / XL6", passengers: "6 Passengers", baggage: "3 Bags", price: "₹17 / km" },
      { type: "Comfort MUV", names: "Toyota Innova", passengers: "7 Passengers", baggage: "4 Bags", price: "₹20 / km" },
      { type: "Luxury MPV", names: "Innova Crysta", passengers: "7 Passengers", baggage: "4 Bags", price: "₹24 / km" },
      { type: "Group Coach", names: "12S Tempo Traveller", passengers: "12 Passengers", baggage: "8+ Bags", price: "₹28 / km" },
    ],
    highlights: "Smooth express corridor ride to Lalbagh Botanical Garden, Cubbon Park, Bangalore Palace & Commercial Street. Karnataka interstate permit assistance.",
    whatsappMsg: `*Kalidass Travels - Bangalore Highway Cab Enquiry*
• Route: Chennai to Bangalore Round Trip
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Vehicle Preference: [Sedan / Ertiga / Innova / Crysta / Tempo]
• Passengers: 

Please share per-km tariff and confirmed estimate.`
  }
];

const holidayFleetGuide = [
  {
    type: "AC Sedan",
    names: "Swift Dzire / Toyota Etios",
    passengers: "4 Passengers",
    baggage: "2 Medium Bags + Handbags",
    image: "/images/fleet/swift-dzire.webp",
    badge: "Best for Couples & Solos",
