  {
    id: "mahabalipuram",
    name: "Chennai to Mahabalipuram & ECR Coastal Drive",
    duration: "1 Day (120 km Round Trip)",
    badge: "Quick 1-Day Getaway",
    slug: "mahabalipuram-ecr-temple-route",
    image: "/images/temple/mahabalipuram-ecr-temples.webp",
    rates: createPackageRates(["₹2,200", "₹3,200", "₹3,800", "₹4,800", "₹6,000"]),
    highlights: "UNESCO Shore Temple, Pancha Rathas, Krishna's Butter Ball, Kovalam surf beach, Muttukadu boating & DakshinaChitra cultural museum. ECR toll included.",
    whatsappMsg: `*Kalidass Travels - Mahabalipuram Tour Enquiry*
• Tour: Chennai to Mahabalipuram & ECR Drive (1 Day)
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Vehicle Preference: [Sedan / Ertiga / Innova / Crysta / Tempo]
• Passengers: 

Please share availability and confirmed all-inclusive quote.`
  },
  {
    id: "yelagiri",
    name: "Chennai to Yelagiri Hills Weekend Retreat",
    duration: "2 Days / 1 Night (460 km Round Trip)",
    badge: "Hill Station Escape",
    slug: "yelagiri-hills-weekend",
    image: "/images/hero/outstation-highway.webp",
    rates: createPackageRates(["₹7,500", "₹9,200", "₹11,000", "₹13,000", "₹16,500"]),
    highlights: "Scenic 14 hairpin bends drive, Punganoor Lake boating, Swamimalai viewpoint, Jalagamparai waterfalls & Nature Park. 2-Day vehicle hire + fuel covered.",
    whatsappMsg: `*Kalidass Travels - Yelagiri Hills Enquiry*
• Tour: Chennai to Yelagiri Hills Weekend (2 Days)
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Vehicle Preference: [Sedan / Ertiga / Innova / Crysta / Tempo]
• Passengers: 

Please share availability and confirmed quote.`
  },
  {
    id: "yercaud",
    name: "Chennai to Yercaud Hill Station (Shevaroy Range)",
    duration: "2–3 Days (720 km Round Trip)",
    badge: "Coffee Plantation Hills",
    slug: "yercaud-hills-weekend",
    image: "/images/hero/outstation-highway.webp",
    rates: createPackageRates(["₹11,500", "₹14,000", "₹16,800", "₹19,500", "₹24,000"]),
    highlights: "Emerald Lake, Lady's Seat & Pagoda Point viewpoints, Killiyur Falls, botanical garden & aromatic coffee plantation walks. Hill road experienced drivers.",
    whatsappMsg: `*Kalidass Travels - Yercaud Hills Enquiry*
• Tour: Chennai to Yercaud Hill Station (2-3 Days)
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Vehicle Preference: [Sedan / Ertiga / Innova / Crysta / Tempo]
• Passengers: 

Please share availability and confirmed quote.`
  },
  {
    id: "chennai-city",
    name: "Chennai Full Day City Heritage & Coastal Tour",
    duration: "1 Day (80–100 km / 8–10 Hours)",
    badge: "Local City Special",
    slug: "one-day-chennai-city-tour",
    image: "/images/temple/chennai-city.webp",
    rates: createPackageRates(["₹2,200", "₹3,200", "₹3,800", "₹4,800", "₹6,000"]),
    highlights: "Marina Beach promenade, San Thome Basilica, Fort St. George Museum, Kapaleeshwarar Temple & Guindy National Park. Doorstep pickup and drop within Chennai.",
    whatsappMsg: `*Kalidass Travels - Chennai City Tour Enquiry*
• Tour: Chennai Full Day City Sightseeing
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Vehicle Preference: [Sedan / Ertiga / Innova / Crysta / Tempo]
• Passengers: 

Please share availability and confirmed quote.`
  },
  {
    id: "bangalore",
    name: "Chennai to Bangalore Garden City & Highway Trip",
    duration: "2–3 Days (700+ km Round Trip)",
    badge: "Metropolitan Weekend",
    slug: "chennai-to-bangalore-taxi",
    image: "/images/hero/coimbatore.webp",
    rates: [
      { type: "Sedan", names: "Swift Dzire / Etios", passengers: "4 Passengers", baggage: "2 Bags", price: "₹14 / km" },
      { type: "Family SUV", names: "Maruti Ertiga / XL6", passengers: "6 Passengers", baggage: "3 Bags", price: "₹17 / km" },
      { type: "Comfort MUV", names: "Toyota Innova", passengers: "7 Passengers", baggage: "4 Bags", price: "₹20 / km" },
      { type: "Luxury MPV", names: "Innova Crysta", passengers: "7 Passengers", baggage: "4 Bags", price: "₹24 / km" },
      { type: "Group Coach", names: "12S Tempo Traveller", passengers: "12 Passengers", baggage: "8+ Bags", price: "₹28 / km" },
    ],
    highlights: "Smooth express corridor ride to Lalbagh Botanical Garden, Cubbon Park, Bangalore Palace & Commercial Street. Karnataka interstate permit assistance.",
    whatsappMsg: `*Kalidass Travels - Bangalore Highway Cab Enquiry*
• Route: Chennai to Bangalore Round Trip
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Vehicle Preference: [Sedan / Ertiga / Innova / Crysta / Tempo]
• Passengers: 

Please share per-km tariff and confirmed estimate.`
  }
];

const holidayFleetGuide = [
  {
    type: "AC Sedan",
    names: "Swift Dzire / Toyota Etios",
    passengers: "4 Passengers",
    baggage: "2 Medium Bags + Handbags",
    image: "/images/fleet/swift-dzire.webp",
    badge: "Best for Couples & Solos",
    bestFor: "Day trips to Mahabalipuram, Pondicherry coastal drives, or couples weekend getaways.",
    features: ["Chilled Dual AC", "Smooth highway cruising", "Fits 2 medium suitcases in boot"]
  },
  {
    type: "Family SUV",
    names: "Maruti Ertiga / XL6",
    passengers: "6 Passengers",
    baggage: "3 Bags (with 3rd row adjusted)",
    image: "/images/fleet/maruti-ertiga.webp",
    badge: "Family Favorite",
    bestFor: "Families with kids planning hill-station weekends to Yelagiri or beach vacations in Pondy.",
    features: ["Rear AC blowers for all rows", "Flexible 60:40 seats", "High mileage economy"]
  },
  {
    type: "Comfort MUV",
    names: "Toyota Innova",
    passengers: "7 Passengers",
    baggage: "4 Large Suitcases",
    image: "/images/fleet/toyota-innova.webp",
    badge: "Ultimate Road Trip King",
    bestFor: "Steep hill roads (Yelagiri hairpin bends, Yercaud ghats) and multi-day holiday road trips.",
    features: ["Exceptional ghat road suspension", "High ground clearance", "Captain chair comfort"]
  },
  {
    type: "Luxury MPV",
    names: "Toyota Innova Crysta",
    passengers: "7 Passengers",
    baggage: "4 Large Suitcases",
    image: "/images/fleet/innova-crysta.webp",
    badge: "Executive Leisure",
    bestFor: "Luxury holiday escapes, corporate executive weekend retreats, and premium family getaways.",
    features: ["Acoustic quiet cabin", "Reclining leather captain chairs", "Multi-zone climate control"]
  },
  {
    type: "Group Coach",
    names: "12-Seater Tempo Traveller",
    passengers: "12 Passengers",
    baggage: "8–10 Large Bags (Separate boot)",
    image: "/images/fleet/tempo.webp",
    badge: "Group Holiday Coach",
    bestFor: "Friends reunions, bachelor trips, joint family getaways & corporate team outings.",
    features: ["Full standing aisle height", "Pushback 2x1 seats", "High-power AC & music system"]
  }
];

const faqs = [
  {
    q: "How are 1-day weekend packages billed versus multi-day trips?",
    a: "Our popular 1-day holiday trips (such as Chennai to Mahabalipuram or 1-day Pondicherry) are fixed all-inclusive flat rates covering vehicle hire, fuel, FASTag tolls, and driver allowance upfront. For multi-day trips (such as 2-day Yelagiri, Yercaud, or Bangalore), packages cover vehicle hire and fuel, while highway tolls and daily driver night bata (₹400/night) are billed at actuals."
  },
  {
    q: "Can we make spontaneous photo stops and restaurant detours on the way?",
    a: "Absolutely! Unlike rigid tour buses or app-based shared rides, your private Kalidass cab is exclusively dedicated to your party. You can stop along the East Coast Road for tender coconut, coastal cafes, beach viewpoints, or local seafood joints without any rush or penalty."
  },
  {
    q: "Are the drivers experienced with hill station hairpin bends?",
    a: "Yes. For destinations with mountain ghat roads like Yelagiri (14 hairpin bends) and Yercaud (20 hairpin bends), we assign verified senior chauffeurs with over 7+ years of certified hill-driving experience. Vehicles are inspected for brake pad wear and tire tread before every mountain dispatch."
  },
  {
    q: "How early in advance should we book a weekend holiday cab?",
    a: "For weekend peak dates (Friday evening to Sunday), we recommend booking at least 24 to 48 hours in advance to guarantee your preferred vehicle model (especially Innova Crysta and 12-Seater Tempo Travellers which sell out fast)."
  },
  {
    q: "What is your cancellation and rescheduling policy?",
    a: "We offer zero-penalty rescheduling up to 6 hours before your scheduled pickup. Your ₹500 advance lock token is fully credited towards your revised travel date or refundable if cancelled in advance."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "TaxiService",
  "@id": "https://kalidasstravels.in/services/tours/weekend-packages/#service",
  "name": title,
  "description": description,
  "url": "https://kalidasstravels.in/services/tours/weekend-packages/",
  "image": "https://kalidasstravels.in/images/temple/pondicherry.webp",
  "telephone": "+918939539211",
  "priceRange": "₹2,200 - ₹28,000",
  "providerMobility": "dynamic",
  "serviceType": "Weekend & Holiday Tour Cab Packages",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Puducherry" },
    { "@type": "AdministrativeArea", "name": "Karnataka" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/tours/weekend-packages/#faq",
  "name": "Weekend & Holiday Tour FAQs",
  "description": "Frequently asked questions regarding weekend holiday cab packages, ECR beach drives, hill station trips, and group rentals from Chennai.",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={`${title} | Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/temple/pondicherry.webp"
  ogImage="/og/temple-tours.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. HERO SECTION -->
      <section class="max-w-4xl mx-auto mb-8 sm:mb-10 text-center">
        <!-- Eyebrow Row: Google Rating & Holiday Badge -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-3">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-2xs">
            <Palmtree className="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Scenic Weekend Road Trips &amp; Holidays • From ₹2,200</span>
          </div>
          <GoogleRatingBadge />
        </div>

        <h1 data-speakable="true" class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Chennai to <span class="text-m3-primary">Weekend &amp; Holiday Getaways</span>
        </h1>
        <p data-speakable="true" class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal mb-5">
          Escape the city routine with private, sanitized AC cabs to South India's top coastal beaches, French heritage quarters, and cool hill stations. No surge pricing, no forced itineraries.
        </p>

        <!-- Destination Quick Chips -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-6 text-xs">
          <a href="/services/pondicherry-one-day-trip/" class="px-3 py-1.5 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high border border-m3-outline-variant/60 font-semibold text-m3-on-surface transition-colors shadow-2xs">
            Pondicherry (From ₹4,500)
          </a>
          <a href="/services/mahabalipuram-ecr-temple-route/" class="px-3 py-1.5 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high border border-m3-outline-variant/60 font-semibold text-m3-on-surface transition-colors shadow-2xs">
            Mahabalipuram ECR (From ₹2,200)
          </a>
          <a href="/services/yelagiri-hills-weekend/" class="px-3 py-1.5 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high border border-m3-outline-variant/60 font-semibold text-m3-on-surface transition-colors shadow-2xs">
            Yelagiri Hills (From ₹7,500)
          </a>
          <a href="/services/yercaud-hills-weekend/" class="px-3 py-1.5 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high border border-m3-outline-variant/60 font-semibold text-m3-on-surface transition-colors shadow-2xs">
            Yercaud Retreat (From ₹11,500)
          </a>
          <a href="/services/one-day-chennai-city-tour/" class="px-3 py-1.5 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high border border-m3-outline-variant/60 font-semibold text-m3-on-surface transition-colors shadow-2xs">
            Chennai Sightseeing (From ₹2,200)
          </a>
          <a href="/services/chennai-to-bangalore-taxi/" class="px-3 py-1.5 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high border border-m3-outline-variant/60 font-semibold text-m3-on-surface transition-colors shadow-2xs">
            Bangalore (₹14/km)
          </a>
        </div>

        <!-- Visual Hero Showcase Banner -->
        <div class="relative w-full h-48 sm:h-56 md:h-64 rounded-m3-2xl overflow-hidden shadow-m3-1 border border-m3-outline-variant/60 bg-m3-inverse-surface group text-left">
          <OptimizedImage
            src="/images/temple/pondicherry.webp"
            alt="Kalidass Travels - Weekend & Holiday Cab Getaways from Chennai"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
            sizes="(max-width: 640px) 100vw, 896px"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-m3-inverse-surface/90 via-m3-inverse-surface/30 to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between pointer-events-none text-white text-xs font-semibold gap-2">
            <span class="px-3 py-1 rounded-m3-full bg-m3-inverse-surface/90 backdrop-blur-md border border-white/20 flex items-center gap-1.5 shadow-xs truncate max-w-[65%]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
              <span class="truncate">Doorstep Chennai Pickup • Chilled AC • Flexible Photo Stops</span>
            </span>
            <span class="px-3 py-1 rounded-m3-full bg-m3-primary text-m3-on-primary text-xs font-bold shadow-xs shrink-0">
              From ₹2,200 All-Inclusive
            </span>
          </div>
        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR -->
      <nav data-quick-nav aria-label="Weekend Tours Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <a href="#how-it-works" data-active="true" aria-current="true" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0 hover:bg-m3-primary hover:text-white">
            How It Works
          </a>
          <a href="#weekend-packages" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Holiday Packages &amp; Rates
          </a>
          <a href="#holiday-fleet" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Fleet &amp; Capacity
          </a>
          <a href="#holiday-promise" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Why Kalidass Travels
          </a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Holiday FAQs
          </a>
        </div>
      </nav>

      <!-- 2. 3-STEP VISUAL WORKFLOW ILLUSTRATION -->
      <div id="how-it-works" class="scroll-mt-40">
        <ServiceExplainer3Step 
          title="How Weekend Holiday Road Trips Work"
          subtitle="Easy private cab bookings with zero surge and personalized travel flexibility"
          steps={explainerSteps}
        />
      </div>

      <!-- 3. UPFRONT PACKAGES MATRIX -->
      <section id="weekend-packages" class="my-10 md:my-14 scroll-mt-40">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
            <span>Verified Getaway Packages</span>
          </div>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
            Weekend Getaway Rates • <span class="text-m3-primary">Transparent Pricing</span>
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5 font-sans">
            1-day coastal packages include vehicle hire, fuel, FASTag tolls, and driver bata upfront. Multi-day hill station packages cover vehicle and fuel, with highway tolls and driver night bata at actuals.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {weekendPackages.map((pkg) => {
            const leafUrl = `/services/${pkg.slug}/`;

            return (
              <div class="tariff-card bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between hover:shadow-m3-2 hover:border-m3-primary/30 transition-all overflow-hidden group">
                <div>
                  <!-- Media Image Header with Badges & Leaf Link -->
                  <a href={leafUrl} class="block h-48 sm:h-52 overflow-hidden relative bg-m3-surface-container-high cursor-pointer group/img" aria-label={`View ${pkg.name} Details`}>
                    <OptimizedImage
                      src={pkg.image}
                      alt={pkg.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 relative z-10"
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-m3-inverse-surface/80 via-transparent to-transparent z-10"></div>

                    <!-- Top USP Badge -->
                    <span class="absolute top-3 left-3 bg-m3-inverse-surface/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-m3-full shadow-xs z-20">
                      {pkg.badge}
                    </span>

                    <!-- Duration Chip (clock icon, same as temple-tours) -->
                    <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-md text-m3-on-surface text-xs font-semibold px-2.5 py-1 rounded-m3-full shadow-xs z-20">
                      <svg class="w-3.5 h-3.5 text-m3-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <span>{pkg.duration}</span>
                    </span>
                  </a>

                  <!-- Card Content Body -->
                  <div class="p-5 sm:p-6">
                    <a href={leafUrl} class="block group/title">
                      <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading mb-1.5 group-hover/title:text-m3-primary transition-colors">
                        {pkg.name}
                      </h3>
                    </a>
                    <p class="text-xs text-m3-on-surface-variant mb-4 leading-relaxed">
                      {pkg.highlights}
                    </p>

                    <!-- Vehicle Price Slabs Grid (matching temple-tours format) -->
                    <div class="bg-m3-surface-container-low p-3 sm:p-3.5 rounded-m3-xl border border-m3-outline-variant/60 space-y-2">
                      <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-m3-on-surface-variant border-b border-m3-outline-variant/60 pb-1.5">
                        <span>Vehicle (Model) • Capacity</span>
                        <span class="text-right">Flat Fare</span>
                      </div>
                      {pkg.rates.map((r) => (
                        <div class="flex items-center justify-between text-xs py-1.5 border-b border-m3-outline-variant/40 last:border-0 gap-2">
                          <div class="min-w-0 pr-1">
                            <span class="font-bold text-m3-on-surface block text-xs truncate">
                              {r.type} <span class="text-m3-on-surface-variant font-medium text-[11px]">({r.names})</span>
                            </span>
                            <span class="text-[10px] text-m3-on-surface-variant font-medium flex items-center gap-1.5 mt-0.5">
                              <span class="text-m3-success font-semibold">{r.passengers}</span>
                              <span>•</span>
                              <span>{r.baggage}</span>
                            </span>
                          </div>
                          <strong class="text-m3-primary font-heading font-black text-sm shrink-0 whitespace-nowrap">{r.price}</strong>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Card Actions: View Itinerary (single button, same as temple-tours) -->
                <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-2 mt-auto">
                  <a
                    href={leafUrl}
                    class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-m3-full bg-m3-primary hover:bg-m3-primary/90 text-m3-on-primary text-xs font-bold transition-all shadow-m3-1"
                  >
                    <span>View Itinerary</span>
                    <ChevronRight className="w-4 h-4" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- 4. FLEET GUIDE FOR HOLIDAY & HILL ROAD TRIPS -->
      <section id="holiday-fleet" class="my-10 md:my-14 bg-m3-surface-container-low rounded-m3-2xl p-6 sm:p-8 border border-m3-outline-variant scroll-mt-40">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
            <span>Vehicles for Leisure &amp; Ghat Roads</span>
          </div>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
            Choose the Right Cab for Your <span class="text-m3-primary">Getaway</span>
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5 font-sans">
            From budget-friendly sedans for couples to luxury Innova Crystas and 12-seater coaches for group reunions.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {holidayFleetGuide.map((fleet) => {
            const baggageClean = fleet.baggage.split('(')[0].replace('+ Handbags', '').replace('Large Suitcases', 'Bags').replace('Medium Bags', 'Bags').trim();
            const startingRate = fleet.names.includes('Dzire') || fleet.names.includes('Etios') ? '₹2,200'
              : fleet.names.includes('Ertiga') || fleet.names.includes('XL6') ? '₹3,200'
              : fleet.names.includes('Crysta') ? '₹4,800'
              : fleet.names.includes('Innova') ? '₹3,800'
              : '₹6,000';
            return (
              <VehicleCard
                className="w-full"
                name={fleet.names}
                image={fleet.image}
                badge={fleet.badge}
                seats={fleet.passengers}
                baggage={baggageClean}
                priceLabel="Starting From"
                priceSubtext="1-Day (Tolls & Driver Inc.)"
                price={startingRate}
                actionText="View Rates"
                actionHref="#weekend-packages"
              />
            );
          })}
        </div>
      </section>

      <!-- 5. HOLIDAY TRAVEL GUARANTEES (4 PILLARS) -->
      <section id="holiday-promise" class="my-10 md:my-14 bg-m3-surface-container-low rounded-m3-2xl p-6 sm:p-8 border border-m3-outline-variant scroll-mt-40">
        <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
          <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-m3-on-surface font-heading">
            Why Travelers Choose Kalidass for Vacation Road Trips
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Flexible Photo & Cafe Stops</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Stop for seaside breakfast, fresh coconut, or viewpoints — your dedicated cab, your pace.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Ghat-Road Certified Drivers</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Verified senior chauffeurs with 7+ years of hill-road experience for Yelagiri & Yercaud routes.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">100% Tolls Included on 1-Day Trips</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Zero highway cash hassles. All tolls pre-calculated upfront for Pondicherry, Mahabalipuram & Chennai city tours.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Nominal ₹500 Advance</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Lock your vehicle with just ₹500 advance. Free rescheduling up to 6 hours before pickup.</p>
          </div>
        </div>
      </section>

      <!-- 6. FREQUENTLY ASKED QUESTIONS -->
      <section id="faqs" class="my-12 md:my-16 scroll-mt-40">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
            <span>Got Questions?</span>
          </div>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
            Weekend Tour <span class="text-m3-primary">Frequently Asked Questions</span>
          </h2>
        </div>

        <div class="max-w-3xl mx-auto">
          <FAQAccordion items={faqs} />
        </div>
      </section>

      <!-- Cross Navigation to Airport Taxi & Outstation Cabs -->
      <section class="py-8 my-6 bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant/60 p-5 sm:p-7">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="/services/chennai-airport-taxi/" class="p-5 rounded-m3-xl bg-m3-success-container/400/5 border border-m3-success/30 hover:border-m3-success/50 transition-all group flex items-center justify-between">
              <div>
                <div class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-m3-on-success-container mb-1">
                  <svg class="w-3.5 h-3.5 text-m3-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3.5c-.5-.5-2.5 0-4 1.5L13.5 8.5 5.3 6.7c-.8-.2-1.6.2-2 .9l-.3.5c-.4.7-.2 1.6.4 2.1l5.7 4.3-2.6 2.6-2.6-.9c-.5-.2-1.1 0-1.5.4l-.2.2c-.4.4-.4 1.1 0 1.5l2.4 2.4 2.4 2.4c.4.4 1.1.4 1.5 0l.2-.2c.4-.4.6-1 .4-1.5l-.9-2.6 2.6-2.6 4.3 5.7c.5.6 1.4.8 2.1.4l.5-.3c.7-.4 1.1-1.2.9-2z"/>
                  </svg>
                  <span>Airport Transfers (MAA)</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-m3-on-surface group-hover:text-m3-on-success-container transition-colors font-heading">
                  Chennai Airport Taxi Transfers
                </h3>
                <p class="text-xs text-m3-on-surface-variant mt-0.5">Direct airport pickup for outstation visitors & holidaymakers heading to Chennai getaways.</p>
              </div>
              <ArrowRight className="w-5 h-5 text-m3-success group-hover:translate-x-1 transition-transform shrink-0" />
            </a>

            <a href="/services/outstation-cabs/" class="p-5 rounded-m3-xl bg-m3-surface-container border border-m3-outline-variant hover:border-m3-primary/50 transition-all group flex items-center justify-between">
              <div>
                <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase text-m3-primary mb-1">
                  <svg class="w-3.5 h-3.5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2 10.9 2 11.1 2 11.3V16c0 .6.4 1 1 1h2"/>
                    <circle cx="7" cy="17" r="2"/>
                    <circle cx="17" cy="17" r="2"/>
                  </svg>
                  <span>Per-KM Cabs &amp; One-Way</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-m3-on-surface group-hover:text-m3-primary transition-colors font-heading">
                  Outstation Cabs from ₹14 / KM
                </h3>
                <p class="text-xs text-m3-on-surface-variant mt-0.5">Sedans, Ertiga &amp; Innova Crysta for flexible highway trips across South India.</p>
              </div>
              <ArrowRight className="w-5 h-5 text-m3-primary group-hover:translate-x-1 transition-transform shrink-0" />
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>
