  },
  {
    id: "chennai-city",
    name: "Chennai Full Day City Heritage & Coastal Tour",
    duration: "1 Day (80–100 km / 8–10 Hours)",
    badge: "Local City Special",
    slug: "one-day-chennai-city-tour",
    image: "/images/temple/chennai-city.webp",
    rates: createPackageRates(["₹2,200", "₹3,200", "₹3,800", "₹4,800", "₹6,000"]),
    highlights: "Marina Beach promenade, San Thome Basilica, Fort St. George Museum, Kapaleeshwarar Temple & Guindy National Park. Doorstep pickup and drop within Chennai.",
    whatsappMsg: `*Kalidass Travels - Chennai City Tour Enquiry*
