---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/SEO/Breadcrumbs.astro';
import ServiceExplainer3Step from '../../../components/ServiceExplainer3Step.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import { buildWhatsAppUrl } from '../../../utils/whatsapp';
import OptimizedImage from '../../../components/OptimizedImage.astro';
import GoogleRatingBadge from '../../../components/GoogleRatingBadge.astro';
import { ChevronRight, ArrowRight, ShieldCheck, Palmtree, Compass, MapPin, Sparkles } from 'lucide-react';

const title = "Weekend & Holiday Tour Packages from Chennai (From ₹2,200)";
const description = "Explore top weekend getaways & holiday road trips from Chennai: Pondicherry, Mahabalipuram, Yelagiri Hills, Yercaud & Bangalore. Verified AC cabs, friendly chauffeurs & all-inclusive pricing.";
const keywords = "weekend tour packages from chennai, holiday packages from chennai, chennai to pondicherry cab package, chennai to mahabalipuram taxi, chennai to yelagiri car rental, chennai to yercaud taxi package, outstation holiday cabs chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Tour Packages", item: "/services/tours/" },
  { name: "Weekend & Holidays", item: "/services/tours/weekend-packages/" },
];

const explainerSteps = [
  {
    stepNumber: "1",
    badge: "Step 1: Choose Getaway",
    title: "Pick Your Holiday Route",
    desc: "Select your getaway (Pondicherry beaches, Mahabalipuram shore, Yelagiri hills, or Yercaud retreat) and your car size.",
    illustrationTitle: "Select Destination & Cab",
    illustrationSub: "Sedan • Ertiga • Crysta • Tempo",
    theme: "amber" as const,
    iconType: "car" as const
  },
  {
    stepNumber: "2",
    badge: "Step 2: Doorstep Pickup",
    title: "Punctual Morning Chauffeur",
    desc: "On-time doorstep pickup from anywhere in Chennai. Courteous, experienced highway chauffeurs who know scenic photo stops.",
    illustrationTitle: "Doorstep Chennai Pickup",
    illustrationSub: "Sanitized AC Cabs • Punctual Drivers",
    theme: "blue" as const,
    iconType: "pickup" as const
  },
  {
    stepNumber: "3",
    badge: "Step 3: Scenic Relaxation",
    title: "All-Inclusive Stress-Free Trip",
    desc: "Stop whenever you like for tender coconut, coastal cafes, or viewpoints. All 1-day tours include fuel, tolls, and driver bata.",
    illustrationTitle: "Scenic Holiday Experience",
    illustrationSub: "Zero Surge • Transparent Billing",
    theme: "emerald" as const,
    iconType: "relax" as const
  }
];

const fleetTierSpecs = [
  { type: "Sedan", names: "Swift Dzire / Etios", passengers: "4 Passengers", baggage: "2 Bags" },
  { type: "Family SUV", names: "Maruti Ertiga / XL6", passengers: "6 Passengers", baggage: "3 Bags" },
  { type: "Comfort MUV", names: "Toyota Innova", passengers: "7 Passengers", baggage: "4 Bags" },
  { type: "Luxury MPV", names: "Innova Crysta", passengers: "7 Passengers", baggage: "4 Bags" },
  { type: "Group Coach", names: "12S Tempo Traveller", passengers: "12 Passengers", baggage: "8+ Bags" },
];

function createPackageRates(prices: [string, string, string, string, string]) {
  return fleetTierSpecs.map((spec, i) => ({
    ...spec,
    price: prices[i],
  }));
}

const weekendPackages = [
  {
    id: "pondicherry",
    name: "Chennai to Pondicherry Beach & Auroville Tour",
    duration: "1 or 2 Days (310 km Round Trip)",
    badge: "Top Weekend Choice",
    slug: "pondicherry-one-day-trip",
    image: "/images/temple/pondicherry.webp",
    rates: createPackageRates(["₹4,500", "₹5,800", "₹6,800", "₹8,200", "₹10,500"]),
    highlights: "Promenade Beach, French White Town cafes, Auroville Matrimandir, Sri Aurobindo Ashram & Paradise Beach. Tolls & Puducherry border entry permit covered on 1-day trips.",
    whatsappMsg: `*Kalidass Travels - Pondicherry Weekend Tour Enquiry*
• Tour: Chennai to Pondicherry Beach & Auroville Tour
• Travel Date: 
