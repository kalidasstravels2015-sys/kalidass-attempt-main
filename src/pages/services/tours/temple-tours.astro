---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/SEO/Breadcrumbs.astro';
import ServiceExplainer3Step from '../../../components/ServiceExplainer3Step.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import WhatsAppIcon from '../../../components/WhatsAppIcon.astro';
import AndroidPhoneIcon from '../../../components/AndroidPhoneIcon.astro';
import { buildWhatsAppUrl } from '../../../utils/whatsapp';
import OptimizedImage from '../../../components/OptimizedImage.astro';
import { ChevronRight } from 'lucide-react';

const title = "Temple Tour Cab Packages from Chennai";
const description = "Temple tour packages from Chennai: Tirupati, Navagraha, Thiruvannamalai, Sabarimala & Rameswaram. AC cabs, courteous drivers & tolls included.";
const keywords = "temple tour packages from chennai, chennai to tirupati cab, kumbakonam navagraha taxi, thiruvannamalai girivalam cab, rameswaram pilgrimage taxi, sabarimala taxi chennai, south india temple tour cabs";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Tour Packages", item: "/services/tours/" },
  { name: "Temple Tours", item: "/services/tours/temple-tours/" },
];

const explainerSteps = [
  {
    stepNumber: "1",
    badge: "Step 1: Choose Package",
    title: "Pick Your Sacred Yatra",
    desc: "Select your destination (Tirupati, Navagraha, Girivalam, etc.) and preferred vehicle (Sedan, Ertiga, Crysta, Tempo).",
    illustrationTitle: "Select Yatra & Cab",
    illustrationSub: "Sedan • Ertiga • Crysta • Tempo",
    theme: "amber" as const,
    iconType: "car" as const
  },
  {
    stepNumber: "2",
    badge: "Step 2: Doorstep Pickup",
    title: "Satvik Chauffeur Arrives",
    desc: "Early morning doorstep pickup in Chennai by a courteous, non-smoking, teetotaler driver who understands temple traditions.",
    illustrationTitle: "Punctual Doorstep Pickup",
    illustrationSub: "Polite Satvik Chauffeur",
    theme: "blue" as const,
    iconType: "pickup" as const
  },
  {
    stepNumber: "3",
    badge: "Step 3: Sacred Darshan",
    title: "All-Inclusive Peaceful Darshan",
    desc: "All highway FASTag tolls, interstate permits, and driver allowance are 100% included upfront. Zero hidden fees.",
    illustrationTitle: "Peaceful Temple Darshan",
    illustrationSub: "All Tolls & Permits Included",
    theme: "emerald" as const,
    iconType: "relax" as const
  }
];

const fleetTierSpecs = [
  { type: "Sedan", names: "Swift Dzire / Etios", passengers: "4 Passengers", baggage: "2 Bags" },
  { type: "Family SUV", names: "Maruti Ertiga / XL6", passengers: "6 Passengers", baggage: "3 Bags" },
  { type: "Comfort MUV", names: "Toyota Innova", passengers: "7 Passengers", baggage: "4 Bags" },
  { type: "Luxury MPV", names: "Innova Crysta", passengers: "7 Passengers", baggage: "4 Bags" },
  { type: "Group Coach", names: "12S Tempo Traveller", passengers: "12 Passengers", baggage: "8+ Bags" },
];

function createPackageRates(prices: [string, string, string, string, string]) {
  return fleetTierSpecs.map((spec, i) => ({
    ...spec,
    price: prices[i],
  }));
}

const tourPackages = [
  {
    id: "tirupati",
    name: "Chennai to Tirupati Balaji Darshan",
    duration: "1 Day (320 km Round Trip)",
    badge: "Most Popular",
    rates: createPackageRates(["₹6,000", "₹7,500", "₹8,500", "₹10,000", "₹12,500"]),
    highlights: "Doorstep 4 AM Chennai pickup • Andhra State Permit, Tolls, Alipiri check & Driver Bata fully included.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Tirupati Balaji Car Package."
  },
  {
    id: "navagraha",
    name: "Chennai to Kumbakonam 9 Navagraha Tour",
    duration: "2 Days / 1 Night (750 km)",
    badge: "Complete 9 Temples",
    rates: createPackageRates(["₹8,600", "₹10,600", "₹13,100", "₹15,500", "₹18,500"]),
    highlights: "All 9 planetary temples sequenced without backtracking • 2 Days driver bata, fuel & highway tolls included.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Kumbakonam 9 Navagraha 2-Day Tour."
  },
  {
    id: "thiruvannamalai",
    name: "Chennai to Thiruvannamalai Girivalam Trip",
    duration: "1 Day / Pournami Night (400 km)",
    badge: "Pournami Special",
    rates: createPackageRates(["₹6,500", "₹7,900", "₹9,300", "₹11,100", "₹13,500"]),
    highlights: "Arunachaleswarar Darshan + 14 km Pournami Girivalam car standby for family & seniors.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Thiruvannamalai Girivalam Tour."
  },
  {
    id: "kanchipuram",
    name: "Chennai to Kanchipuram Temple Tour",
    duration: "1 Day (150 km)",
    badge: "Divya Desam",
    rates: createPackageRates(["₹3,500", "₹4,500", "₹5,500", "₹6,800", "₹8,500"]),
    highlights: "Kamakshi Amman, Ekambareswarar, Varadharaja Perumal & Silk Saree weaver visit included.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Kanchipuram 1-Day Temple Package."
  },
  {
    id: "rameswaram",
    name: "Chennai to Rameswaram & Dhanushkodi Yatra",
    duration: "2 Days / 1 Night (1,200 km)",
    badge: "Char Dham Sthalam",
    rates: createPackageRates(["₹15,500", "₹18,500", "₹22,000", "₹26,000", "₹31,000"]),
    highlights: "22 Theertham baths, Pamban bridge, Ram Setu / Arichal Munai & APJ Abdul Kalam Memorial.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Rameswaram 2-Day Pilgrimage Package."
  },
  {
    id: "sabarimala",
    name: "Chennai to Sabarimala Yatra Car Package",
    duration: "3 Days / 2 Nights (1,350 km)",
    badge: "Mandala Season",
    rates: createPackageRates(["₹15,900", "₹18,500", "₹22,000", "₹26,500", "₹32,000"]),
    highlights: "Satvik teetotaler driver • Kerala State Permit • 3 Days driver allowance and ghat road guidance.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Sabarimala 3-Day Package."
  },
  {
    id: "vellore",
    name: "Chennai to Vellore Golden Temple Tour",
    duration: "1 Day (300 km)",
    badge: "Golden Temple",
    rates: createPackageRates(["₹4,800", "₹6,000", "₹7,200", "₹8,800", "₹10,500"]),
    highlights: "1,500 kg Gold Sripuram Mahalakshmi Temple & Jalakandeswarar Fort Temple + Tolls included.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Vellore Golden Temple Trip."
  },
  {
    id: "chidambaram",
    name: "Chennai to Chidambaram Natarajar Temple",
    duration: "1 Day (450 km)",
    badge: "Pancha Bhoota",
    rates: createPackageRates(["₹7,400", "₹9,200", "₹11,000", "₹13,500", "₹16,500"]),
    highlights: "Akasha Lingam Spatika linga puja + Pichavaram Mangrove Forest boat ride + Tolls.",
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Chidambaram Natarajar Temple Tour."
  }
];

const templeFleetGuide = [
  {
    type: "AC Sedan",
    names: "Swift Dzire / Toyota Etios",
    passengers: "4 Passengers",
    baggage: "2 Medium Bags + Handbags",
    image: "/images/fleet/swift-dzire.webp",
    badge: "Best Value",
    bestFor: "Couple darshans, small families (parents + 2 kids), and 1-day yatras (Tirupati, Kanchi, Vellore).",
    features: ["Chilled Dual AC", "Low step-in height for elders", "Dedicated boot for luggage"]
  },
  {
    type: "Family SUV",
    names: "Maruti Ertiga / XL6",
    passengers: "6 Passengers",
    baggage: "3 Bags (with 3rd row adjusted)",
    image: "/images/fleet/suv.webp",
    badge: "Family Favorite",
    bestFor: "Families with 3–4 adults and 2 children, budget-friendly 1-day or weekend temple trips.",
    features: ["Roof-mounted rear AC blowers", "Flexible 60:40 folding seats", "Smooth highway mileage"]
  },
  {
    type: "Comfort MUV",
    names: "Toyota Innova",
    passengers: "7 Passengers",
    baggage: "4 Large Suitcases",
    image: "/images/fleet/suv.webp",
    badge: "Pilgrim Choice",
    bestFor: "Joint families and multi-day long pilgrimages (Kumbakonam Navagraha, Rameswaram, Sabarimala).",
    features: ["Legendary highway suspension", "Generous legroom for grandparents", "High ground clearance"]
  },
  {
    type: "Luxury MPV",
    names: "Toyota Innova Crysta",
    passengers: "7 Passengers",
    baggage: "4 Large Suitcases",
    image: "/images/fleet/suv.webp",
    badge: "Executive Comfort",
    bestFor: "VIP darshan trips and families seeking maximum noise-insulation, captain seats & extra legroom.",
    features: ["Ergonomic plush captain seats", "Whisper-quiet acoustic cabin", "Multi-zone automatic climate control"]
  },
  {
    type: "Group Coach",
    names: "12-Seater Tempo Traveller",
    passengers: "12 Passengers",
    baggage: "8–10 Large Bags (Dedicated rear boot)",
    image: "/images/fleet/tempo.webp",
    badge: "Group Yatra",
    bestFor: "Extended joint families, Bhajan mandalis, Sabarimala Ayyappa groups & community yatras.",
    features: ["Full standing aisle height", "2x1 pushback bucket seats", "Individual AC vents & audio system"]
  }
];

const faqs = [
  {
    q: "Are highway tolls and interstate permits really 100% included?",
    a: "Yes! In all our temple tour packages, FASTag toll charges, parking fees at temple premises, and interstate road permits (e.g. Andhra Pradesh permit for Tirupati, Kerala permit for Sabarimala) are fully covered in the published price."
  },
  {
    q: "What vehicle models and seating capacities are available for temple tours?",
    a: "We offer 5 standardized AC vehicle classes: AC Sedan (Swift Dzire / Toyota Etios for 4 devotees, 2 bags), Family SUV (Maruti Ertiga / XL6 for 6 devotees, 3 bags), Comfort MUV (Toyota Innova for 7 devotees, 4 bags), Luxury MPV (Toyota Innova Crysta for 7 devotees, 4 bags), and Group Coach (12-Seater Tempo Traveller for 12 devotees, 8+ bags). All vehicles are clean, sanitized, and dual AC."
  },
  {
    q: "Which vehicle is recommended for senior citizens on long pilgrimage routes like Navagraha or Rameswaram?",
    a: "For long multi-day yatras, we highly recommend the Toyota Innova or Innova Crysta. Their wide doors allow effortless entry and exit, ergonomic captain seats provide superior lumbar support for elderly devotees, and their renowned highway suspension absorbs road bumps smoothly."
  },
  {
    q: "Will the driver assist senior citizens with darshan queues?",
    a: "Yes! Our drivers drop families directly at the temple entrance porch before parking, guide you on ticket counter timings, and assist elderly passengers with wheelchair access points."
  },
  {
    q: "Are the drivers satvik and polite?",
    a: "Strictly yes. All drivers on pilgrimage duties are polite, teetotalers (strictly zero smoking and zero alcohol), and maintain pure vegetarian food discipline during the journey."
  },
  {
    q: "Can the itinerary be customized for additional local temples?",
    a: "Absolutely. If you want to visit additional nearby temples (e.g. adding Padmavathi Ammavari Temple or Srinivasa Mangapuram on a Tirupati trip), our drivers will gladly accommodate your darshan schedule."
  }
];

const tourPackageSlugs: Record<string, string> = {
  tirupati: "tirupati-package",
  navagraha: "navagraha-tour",
  thiruvannamalai: "thiruvannamalai-girivalam-trip",
  kanchipuram: "kanchipuram-temple-trip",
  rameswaram: "rameswaram-2-days",
  sabarimala: "sabarimala-trip",
  chidambaram: "chidambaram-temple-trip",
  vellore: "vellore-golden-temple",
};

const tourPackageImages: Record<string, string> = {
  tirupati: "/images/temple/tirupati-balaji.webp",
  navagraha: "/images/temple/navagraha.webp",
  thiruvannamalai: "/images/temple/thiruvannamalai-girivalam.webp",
  kanchipuram: "/images/temple/kanchipuram-temple.webp",
  rameswaram: "/images/temple/rameswaram.webp",
  sabarimala: "/images/temple/sabarimala-temple.webp",
  chidambaram: "/images/temple/chidambaram-natarajar-temple.webp",
  vellore: "/images/temple/vellore-golden.webp",
};

const tourPackageImageAlts: Record<string, string> = {
  tirupati: "Chennai to Tirupati Balaji temple cab package",
  navagraha: "Kumbakonam 9 Navagraha temples tour taxi from Chennai",
  thiruvannamalai: "Chennai to Thiruvannamalai Girivalam temple trip cab",
  kanchipuram: "Chennai to Kanchipuram temple tour package taxi",
  rameswaram: "Chennai to Rameswaram and Dhanushkodi 2-day yatra taxi",
  sabarimala: "Chennai to Sabarimala pilgrimage car package",
  chidambaram: "Chennai to Chidambaram Natarajar Temple cab package",
  vellore: "Chennai to Vellore Sripuram Golden Temple cab trip",
};

const schema = {
  "@type": "TaxiService",
  "@id": "https://kalidasstravels.in/services/tours/temple-tours/#service",
  "name": title,
  "description": description,
  "url": "https://kalidasstravels.in/services/tours/temple-tours/",
  "image": "https://kalidasstravels.in/images/services/temple-tours.webp",
  "providerMobility": "dynamic",
  "serviceType": "Temple Pilgrimage Cab Packages",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Andhra Pradesh" },
    { "@type": "AdministrativeArea", "name": "Kerala" }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1250",
    "bestRating": "5",
    "worstRating": "1"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "South India Temple Tour Cab Packages",
    "itemListElement": tourPackages.flatMap((pkg) =>
      pkg.rates.map((r, rIdx) => ({
        "@type": "Offer",
        "name": `${pkg.name} - ${r.type} (${r.names})`,
        "description": `${pkg.name} by ${r.type} (${r.names}) for ${r.passengers} with ${r.baggage}. All tolls, AP/interstate permits & driver bata included.`,
        "image": `https://kalidasstravels.in${tourPackageImages[pkg.id] || "/images/services/temple-tours.webp"}`,
        "priceCurrency": "INR",
        "price": r.price.replace(/[^0-9]/g, ''),
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": `https://kalidasstravels.in/services/${tourPackageSlugs[pkg.id] || pkg.id}/`,
        "seller": {
          "@id": "https://kalidasstravels.in/#localbusiness"
        },
        "itemOffered": {
          "@type": "TaxiService",
          "name": `${pkg.name} - ${r.type} (${r.names})`,
          "serviceType": "Pilgrimage Cab Package"
        }
      }))
    )
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/tours/temple-tours/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={`${title} – Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/temple-tours.webp"
  ogImage="/og/temple-tours.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. HERO SECTION -->
      <section class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Chennai to <span class="text-m3-primary">Temple Tour Packages</span> (All-Inclusive)
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal">
          Hassle-free pilgrimage yatras from Chennai to South India's sacred shrines. Clean AC cabs, courteous satvik drivers, and all highway FASTag tolls paid upfront.
        </p>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Below Hero) -->
      <nav data-quick-nav aria-label="Temple Tours Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <a href="#how-it-works" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0">
            How It Works
          </a>
          <a href="#tour-packages" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Temple Cab Rates
          </a>
          <a href="#temple-fleet" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Fleet &amp; Capacity
          </a>
          <a href="#pilgrim-standards" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Pilgrimage Promise
          </a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Darshan FAQs
          </a>
        </div>
      </nav>

      <!-- 2. ⚡ 3-STEP VISUAL WORKFLOW ILLUSTRATION -->
      <div id="how-it-works" class="scroll-mt-40">
        <ServiceExplainer3Step 
          title="How Chennai to Temple Cabs Work"
          subtitle="Hassle-free pilgrimage yatras planned respectfully in 3 simple steps"
          steps={explainerSteps}
        />
      </div>

      <!-- 3. UPFRONT PACKAGES MATRIX (STRAIGHT TO THE POINT) -->
      <section id="tour-packages" class="my-10 md:my-14 scroll-mt-40">
        
        <div class="text-center max-w-2xl mx-auto mb-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
            <span>All-Inclusive Darshan Packages</span>
          </div>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
            Chennai to Temple Cab Rates • <span class="text-m3-primary">All Tolls &amp; Permits Included</span>
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5 font-sans">
            Includes vehicle, fuel, driver allowance, FASTag tolls, and interstate state entry permits. Zero hidden charges.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {tourPackages.map((pkg) => {
            const leafSlug = tourPackageSlugs[pkg.id] || pkg.id;
            const leafUrl = `/services/${leafSlug}/`;
            const pkgImage = tourPackageImages[pkg.id] || "/images/temple/tirupati-balaji.webp";
            const pkgImageAlt = tourPackageImageAlts[pkg.id] || pkg.name;

            return (
              <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between hover:shadow-m3-2 hover:border-m3-primary/30 transition-all overflow-hidden group">
                <div>
                  <!-- Media Image Header with Badges & Leaf Link -->
                  <a href={leafUrl} class="block h-48 sm:h-52 overflow-hidden relative bg-m3-surface-container-high cursor-pointer group/img" aria-label={`View ${pkg.name} Itinerary`}>
                    <OptimizedImage
                      src={pkgImage}
                      alt={pkgImageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 relative z-10"
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent z-10"></div>

                    <!-- Top USP Badge -->
                    <span class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-m3-full shadow-xs z-20">
                      {pkg.badge}
                    </span>

                    <!-- Duration Chip -->
                    <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-md text-slate-900 text-xs font-semibold px-2.5 py-1 rounded-m3-full shadow-xs z-20">
                      <svg class="w-3.5 h-3.5 text-m3-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <span>{pkg.duration}</span>
                    </span>
                  </a>

                  <!-- Card Content Body -->
                  <div class="p-5 sm:p-6">
                    <a href={leafUrl} class="block group/title">
                      <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading mb-1.5 group-hover/title:text-m3-primary transition-colors">
                        {pkg.name}
                      </h3>
                    </a>
                    <p class="text-xs text-m3-on-surface-variant mb-4 leading-relaxed">
                      {pkg.highlights}
                    </p>

                    <!-- Vehicle Price Slabs Grid (SEO / AEO Enhanced: Type (Model) - Passengers - Baggage) -->
                    <div class="bg-m3-surface-container-low p-3 sm:p-3.5 rounded-m3-xl border border-m3-outline-variant/60 space-y-2">
                      <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-m3-on-surface-variant border-b border-m3-outline-variant/60 pb-1.5">
                        <span>Vehicle (Model) • Capacity</span>
                        <span class="text-right">Flat Fare</span>
                      </div>
                      {pkg.rates.map((r) => (
                        <div class="flex items-center justify-between text-xs py-1.5 border-b border-m3-outline-variant/40 last:border-0 gap-2">
                          <div class="min-w-0 pr-1">
                            <span class="font-bold text-m3-on-surface block text-xs truncate">
                              {r.type} <span class="text-m3-on-surface-variant font-medium text-[11px]">({r.names})</span>
                            </span>
                            <span class="text-[10px] text-m3-on-surface-variant font-medium flex items-center gap-1.5 mt-0.5">
                              <span class="text-emerald-700 font-semibold">{r.passengers}</span>
                              <span>•</span>
                              <span>{r.baggage}</span>
                            </span>
                          </div>
                          <strong class="text-m3-primary font-heading font-black text-sm shrink-0 whitespace-nowrap">{r.price}</strong>
                        </div>
                      ))}
