const faqs = [
  {
    q: "How do you ensure female employee safety during night shifts?",
    a: "We strictly follow safety protocols: female employees are never the first pickup or last drop during night shifts (8 PM to 6 AM). All cabs have active GPS tracking and driver contact details are shared with your admin desk in advance."
