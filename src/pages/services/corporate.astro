};
---

<Layout 
  title={`${title} – Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/corporate.webp"
  ogImage="/og/corporate.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-[#F8FAFC] text-slate-900 font-sans pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-5 sm:pt-8">

      <!-- 1. EXECUTIVE HERO (COMPACT & CUT-AND-DRIED) -->
      <section class="max-w-3xl mx-auto mb-6 sm:mb-8 text-center">
        <!-- Badge Pill -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 text-white text-[11px] font-bold uppercase tracking-wider mb-3">
          <ShieldCheck className="w-3.5 h-3.5 text-emerald-400 shrink-0" />
          <span>Enterprise B2B Transport • 100% GST Compliant</span>
        </div>

        <!-- H1 Headline -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-2.5 font-heading">
          Corporate Cab, <span class="text-[#1E252D]">Employee Mobility</span> &amp; Tempo Fleet in Chennai
        </h1>

        <!-- Cut-and-Dried Subtitle -->
        <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mx-auto leading-relaxed mb-4">
          Dependable transport partner for IT corridors, manufacturing plants, bio-refineries, and cinema crews. 24/7 routed shift commutes, monthly executive retainers, and 12–20 seater AC Tempo Travellers.
        </p>

        <!-- Fast Proof Chips -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-2xs">
            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>100% Commercial Yellow Board</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-2xs">
            <Clock className="w-3.5 h-3.5 text-slate-700 shrink-0" />
            <span>60-Min Replacement SLA</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-2xs">
            <Award className="w-3.5 h-3.5 text-slate-700 shrink-0" />
            <span>100% GST Invoiced (ITC Claim)</span>
          </span>
        </div>

        <!-- Hero Visual Banner (Compact 180px - 260px) -->
        <div class="relative w-full h-44 sm:h-56 md:h-64 rounded-2xl overflow-hidden shadow-xs border border-slate-200 bg-slate-900 text-left">
          <OptimizedImage
            src="/images/services/corporate.webp"
            alt="Kalidass Travels Corporate Cab, Employee Mobility and Tempo Traveller Fleet in Chennai"
            class="w-full h-full object-cover object-[center_35%]"
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 640px) 100vw, 768px"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent pointer-events-none"></div>
          
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none gap-2">
            <span class="px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-white text-[11px] font-semibold border border-white/20 shadow-xs truncate max-w-[55%]">
              Monthly Retainers &amp; Tempo Shuttles
            </span>
            <span class="px-2.5 py-1 rounded-full bg-emerald-600/95 backdrop-blur-md text-white text-[11px] font-bold shadow-xs truncate max-w-[45%]">
              24/7 Dispatch Desk
            </span>
          </div>
        </div>

        <!-- Instant B2B Action Buttons -->
        <div class="flex items-center justify-center gap-2.5 mt-4">
          <a
            href={buildWhatsAppUrl("Hi Kalidass Travels, I would like to request an Enterprise RFP for Corporate Mobility & Fleet Retainers.")}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="h-10 px-4 rounded-full bg-[#25D366] hover:bg-[#20ba5a] active:bg-[#1da851] text-white text-xs font-bold inline-flex items-center justify-center gap-1.5 shadow-xs transition-transform active:scale-[0.98]"
          >
            <WhatsAppIcon variant="brand" className="w-4 h-4 shrink-0 brightness-0 invert" />
            <span>Request Enterprise RFP</span>
          </a>
          <a
            href="tel:+918939539211"
            class="h-10 px-4 rounded-full bg-white hover:bg-slate-100 active:bg-slate-200 text-slate-800 border border-slate-300 text-xs font-bold inline-flex items-center justify-center gap-1.5 shadow-2xs transition-transform active:scale-[0.98]"
          >
            <AndroidPhoneIcon className="w-3.5 h-3.5 text-slate-700 shrink-0" />
            <span>Call: +91 89395 39211</span>
          </a>
        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Tracks Scrolling Progress) -->
      <nav data-quick-nav aria-label="Corporate Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-2.5 sm:py-3 mb-6 sm:mb-8 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto flex items-center gap-1.5 sm:gap-2 text-xs font-semibold whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <span class="text-[11px] uppercase tracking-wider text-m3-on-surface-variant mr-1 font-bold hidden sm:inline">Jump To:</span>
          <a href="#retainers" data-active="true" aria-current="true" class="px-3.5 py-1.5 sm:py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0 hover:bg-m3-primary hover:text-white">
            Car Retainers
          </a>
          <a href="#tempo-fleet" class="px-3.5 py-1.5 sm:py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Tempo Fleet
          </a>
          <a href="#active-work-orders" class="px-3.5 py-1.5 sm:py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Active Work Orders
          </a>
          <a href="#compliance" class="px-3.5 py-1.5 sm:py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Enterprise SLAs
          </a>
          <a href="#faqs" class="px-3.5 py-1.5 sm:py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            B2B FAQs
          </a>
        </div>
      </nav>

      <!-- 2. MONTHLY CAR RETAINERS -->
      <section id="retainers" class="mb-8 bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-xs scroll-mt-28 sm:scroll-mt-32">
        <!-- Retainers Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3 mb-4">
          <div>
            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-900 text-white text-[10px] font-bold uppercase tracking-wider mb-1.5">
              <Car className="w-3 h-3 text-emerald-400" />
              <span>Dedicated Car Fleet</span>
            </div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900 font-heading">
              Monthly Car Retainers with Dedicated Chauffeur
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Official GeM standard slabs • Fuel included • 60-min replacement guarantee • 100% GST
            </p>
          </div>
          <div class="flex items-center gap-2 shrink-0 text-[11px] text-slate-600">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 font-semibold text-slate-800">
              <CheckCircle2 className="w-3 h-3 text-emerald-600" />
              <span>60-Min SLA</span>
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 font-semibold text-slate-800">
              100% GST ITC
            </span>
          </div>
        </div>

        <!-- Master Package Slab Switcher (Horizontal Pill Bar) -->
        <div class="mb-4">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-2">
            <span>Select Monthly Usage Slab (GeM Standard):</span>
            <span class="text-[11px] text-slate-500 font-normal hidden sm:inline">Tap any slab to update all cars</span>
          </div>

          <!-- Horizontal Scrollable Pill Bar -->
          <div 
            role="tablist" 
            aria-label="GeM Standard Monthly Usage Slabs" 
            class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 pe-2 -mx-1 px-1 scroll-px-2"
          >
            {gemStandardPackages.map((pkg) => (
              <button
                type="button"
                role="tab"
                id={`slab-tab-${pkg.id}`}
                data-pkg-slab-tab={pkg.id}
                aria-selected={pkg.id === defaultPkgId ? "true" : "false"}
                class={`shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${
                  pkg.id === defaultPkgId
                    ? "bg-slate-900 text-white font-bold shadow-xs"
                    : "bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200/80"
                }`}
              >
                <span>{pkg.shortLabel}</span>
              </button>
            ))}
          </div>

          <!-- Active Slab Summary Strip -->
          <div id="active-slab-summary" class="mt-2.5 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between text-[11px] text-slate-600 gap-1">
            <div>
              Active Slab: <strong id="active-slab-name" class="text-slate-900 font-bold">{defaultPkg.name}</strong>
              <span class="mx-1 text-slate-400">•</span>
              <span id="active-slab-duty">{defaultPkg.duty}</span>
            </div>
            <div class="text-slate-500 italic">
              <span id="active-slab-usecase">{defaultPkg.useCase}</span>
            </div>
          </div>
        </div>

        <!-- 3 Ultra-Compact Retainer Cards (~85px tall each on mobile) -->
        <div class="space-y-2.5">
          {retainerVehicles.map((vehicle) => {
            const currentRate = defaultPkg.rates[vehicle.id];
            const whatsappText = `Hi Kalidass Travels, I want to enquire about the ${vehicle.plan} - ${defaultPkg.name} (${currentRate}/monthly).`;
            return (
              <div class="bg-white rounded-xl border border-slate-200 hover:border-slate-400 transition-colors p-2.5 sm:p-3 shadow-2xs">
                <div class="flex items-center justify-between gap-3">
                  
                  <!-- Left: Vehicle Thumbnail -->
                  <div class="w-16 h-14 sm:w-20 sm:h-16 shrink-0 bg-slate-50 rounded-lg p-1 flex items-center justify-center border border-slate-200">
                    <img
                      src={vehicle.image}
                      alt={vehicle.cars}
                      width="80"
                      height="48"
                      loading="lazy"
                      decoding="async"
                      class="max-w-full max-h-full object-contain"
                    />
                  </div>

                  <!-- Middle: Car Title, Live Rate & Overage -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-1.5 flex-wrap">
                      <h3 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">
                        {vehicle.plan}
                      </h3>
                      <span class="text-[10px] sm:text-xs text-slate-500 font-medium">
                        ({vehicle.cars} • {vehicle.capacity})
                      </span>
                    </div>

                    <!-- Monthly Price Line -->
                    <div class="mt-1 flex items-baseline gap-2">
                      <strong 
                        class="text-sm sm:text-base font-extrabold text-slate-900 tabular-nums" 
                        data-rate-display={vehicle.id}
                      >
                        {currentRate} / monthly
                      </strong>
                      <span class="text-[10px] text-emerald-700 font-semibold bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200/60 hidden sm:inline">
                        Fuel Included
                      </span>
                    </div>

                    <!-- Cut-and-Dried Overage Specifications (Clean, wrapped, no truncation) -->
                    <div class="text-[10px] sm:text-xs text-slate-600 mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                      <span>Addl. KM: <strong class="text-slate-900 font-semibold">{vehicle.addlKm}</strong></span>
                      <span class="text-slate-300">•</span>
                      <span>OT: <strong class="text-slate-900 font-semibold">{vehicle.addlHour}</strong></span>
                      <span class="text-slate-300">•</span>
                      <span>Night: <strong class="text-slate-900 font-semibold">{vehicle.nightOt}</strong></span>
                    </div>
                  </div>

                  <!-- Right: Clean Single Enquire CTA (No Call Button) -->
                  <div class="shrink-0">
                    <a
                      href={buildWhatsAppUrl(whatsappText)}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      aria-label={`Enquire about ${vehicle.plan} on WhatsApp`}
                      data-wa-btn={vehicle.id}
                      class="h-8 sm:h-9 px-3 sm:px-4 rounded-full bg-[#25D366] hover:bg-[#20ba5a] active:bg-[#1da851] text-white text-xs font-bold inline-flex items-center justify-center gap-1.5 shadow-2xs transition-transform active:scale-[0.98]"
                    >
                      <WhatsAppIcon variant="brand" className="w-3.5 h-3.5 shrink-0 brightness-0 invert" />
                      <span>Enquire</span>
                    </a>
                  </div>

                </div>
              </div>
            );
          })}
        </div>

        <!-- Retainers Footnote -->
        <div class="mt-3 pt-2.5 border-t border-slate-200 text-[11px] text-slate-500 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
          <span>* Fuel included for contracted kilometers. Toll, parking, and state permits billed at actuals.</span>
          <span class="text-slate-700 font-semibold">15-day &amp; 30-day corporate credit terms available</span>
        </div>
      </section>

      <!-- 3. CORPORATE TEMPO TRAVELLER FLEET (VISIBLE DIRECTLY ON PAGE) -->
      <section id="tempo-fleet" class="mb-10 bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-xs scroll-mt-24">
        <!-- Tempo Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3 mb-4">
          <div>
            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-900 text-white text-[10px] font-bold uppercase tracking-wider mb-1.5">
              <Bus className="w-3 h-3 text-emerald-400" />
              <span>Group &amp; Staff Transit</span>
            </div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900 font-heading">
              Corporate Tempo Traveller &amp; Plant Staff Shuttles
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
              12, 14, 17 and 20–26 seater commercial AC coaches for shifts, site audits &amp; film crews.
            </p>
          </div>
          <span class="inline-flex items-center text-[11px] font-semibold text-slate-800 bg-slate-100 border border-slate-200 px-2.5 py-0.5 rounded-full w-fit">
            Commercial Yellow Plate Fleet
          </span>
        </div>

        <!-- 4-Segmented Tempo Tab Selector -->
        <div class="mb-4">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-2">
            <span>Select Tempo Configuration:</span>
            <span class="text-[11px] text-slate-500 font-normal hidden sm:inline">Tap to view exact tariff &amp; seating</span>
          </div>

          <!-- Segment Bar -->
          <div 
            role="tablist" 
            aria-label="Tempo Traveller Seating Configurations" 
            class="grid grid-cols-2 sm:grid-cols-4 gap-1.5"
          >
            {tempoFleet.map((tempo, idx) => (
              <button
                type="button"
                role="tab"
                id={`tempo-tab-${tempo.id}`}
                data-tempo-tab={tempo.id}
                aria-selected={idx === 0 ? "true" : "false"}
                class={`px-3 py-2 rounded-lg text-xs font-semibold text-center transition-all cursor-pointer ${
                  idx === 0
                    ? "bg-slate-900 text-white font-bold shadow-xs"
                    : "bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200/80"
                }`}
              >
                <span class="block truncate">{tempo.shortTitle}</span>
                <span class="block text-[10px] opacity-75 font-normal truncate">{tempo.capacity}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Dynamic Single Tempo Card View (~160px tall) -->
        {tempoFleet.map((tempo, idx) => (
          <div 
            id={`tempo-card-${tempo.id}`} 
            data-tempo-card={tempo.id}
            class={`${idx === 0 ? "block" : "hidden"} bg-slate-50 rounded-xl p-3.5 sm:p-4 border border-slate-200`}
          >
            <!-- Card Row 1: Identity & Image -->
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex-1 min-w-0">
                <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-200/80 text-slate-700 text-[10px] font-bold uppercase mb-1">
                  <Sparkles className="w-3 h-3 text-slate-700 shrink-0" />
                  <span>{tempo.badge}</span>
                </div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 leading-snug">
                  {tempo.name}
                </h3>
                <p class="text-xs text-slate-600 font-medium">
                  {tempo.seating} • {tempo.capacity}
                </p>
              </div>

              <div class="w-24 h-14 sm:w-28 sm:h-16 shrink-0 bg-white rounded-lg p-1 flex items-center justify-center border border-slate-200 shadow-2xs">
                <img
                  src={tempo.image}
                  alt={tempo.name}
                  width="112"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="max-w-full max-h-full object-contain"
                />
              </div>
            </div>

            <!-- Card Row 2: 3-Box Commercial Tariff Matrix -->
            <div class="grid grid-cols-3 gap-2 mb-3 text-center">
              <div class="bg-white p-2 rounded-lg border border-slate-200 shadow-2xs">
                <span class="text-[10px] text-slate-500 block uppercase font-bold">Shift Route</span>
                <strong class="text-xs sm:text-sm font-bold text-slate-900 block mt-0.5 tabular-nums">{tempo.rates.shift}</strong>
              </div>
              <div class="bg-white p-2 rounded-lg border border-slate-200 shadow-2xs">
                <span class="text-[10px] text-slate-500 block uppercase font-bold">Day (8h/80km)</span>
                <strong class="text-xs sm:text-sm font-bold text-slate-900 block mt-0.5 tabular-nums">{tempo.rates.spot}</strong>
              </div>
              <div class="bg-white p-2 rounded-lg border border-slate-200 shadow-2xs">
                <span class="text-[10px] text-slate-500 block uppercase font-bold">Outstation</span>
                <strong class="text-xs sm:text-sm font-bold text-slate-900 block mt-0.5 tabular-nums">{tempo.rates.outstation}</strong>
              </div>
            </div>

            <!-- Card Row 3: Key Specs Checklist -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-slate-600 mb-3.5">
              {tempo.features.map(feat => (
                <div class="flex items-center gap-1.5">
                  <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                  <span class="truncate">{feat}</span>
                </div>
              ))}
            </div>

            <!-- Card Row 4: Clean Action Button (No Call button) -->
            <div class="flex items-center justify-end pt-2.5 border-t border-slate-200">
              <a
                href={buildWhatsAppUrl(tempo.whatsappMsg)}
                target="_blank"
                rel="noopener noreferrer nofollow"
                aria-label={`Enquire about ${tempo.name} on WhatsApp`}
                class="h-8 sm:h-9 px-3.5 sm:px-4 rounded-full bg-[#25D366] hover:bg-[#20ba5a] active:bg-[#1da851] text-white text-xs font-bold inline-flex items-center gap-1.5 shadow-2xs transition-transform active:scale-[0.98]"
              >
                <WhatsAppIcon variant="brand" className="w-3.5 h-3.5 shrink-0 brightness-0 invert" />
                <span>Enquire on WhatsApp</span>
              </a>
            </div>
          </div>
        ))}

        <!-- Tempo Trust Strip -->
        <div class="mt-3 pt-2.5 border-t border-slate-200 grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] font-semibold text-slate-600">
          <div class="flex items-center gap-1">
            <CheckCircle2 className="w-3 h-3 text-emerald-600 shrink-0" />
            <span>Dual AC Compressor</span>
          </div>
          <div class="flex items-center gap-1">
            <CheckCircle2 className="w-3 h-3 text-emerald-600 shrink-0" />
            <span>Pushback Seats</span>
          </div>
          <div class="flex items-center gap-1">
            <CheckCircle2 className="w-3 h-3 text-emerald-600 shrink-0" />
            <span>Speed Governor (80 km/h)</span>
          </div>
          <div class="flex items-center gap-1">
            <CheckCircle2 className="w-3 h-3 text-emerald-600 shrink-0" />
            <span>First Aid &amp; Fire Ext.</span>
          </div>
        </div>
      </section>

      <!-- 3. ACTIVE WORK ORDERS & CLIENT PROOF (4x2 CLEAN GRID) -->
      <section id="active-work-orders" class="mb-12 bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-xs scroll-mt-28 sm:scroll-mt-32">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3 mb-5">
          <div>
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-0.5">
              Enterprise Trust &amp; Track Record
            </span>
            <h2 class="text-base sm:text-lg font-bold text-slate-900 font-heading">
              Active Work Orders &amp; Contract Deployments
            </h2>
          </div>
          <span class="inline-flex items-center text-[11px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
            Live Operational Deployments
          </span>
        </div>

        <!-- 8 Logos Grid (2 cols mobile, 4 cols desktop) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {activeWorkOrders.map((wo) => (
            <div class="bg-slate-50/70 rounded-xl p-3 border border-slate-200/80 flex flex-col items-center text-center">
              <div class="w-full h-12 bg-white rounded-lg border border-slate-200/70 p-1.5 flex items-center justify-center mb-2 shadow-2xs">
                <img
                  src={wo.logo}
                  alt={wo.alt || wo.name}
                  width="110"
                  height="40"
                  loading="lazy"
                  decoding="async"
                  class="max-w-full max-h-full object-contain"
                />
              </div>
              <h3 class="text-xs font-bold text-slate-900 leading-tight">
                {wo.name}
              </h3>
              <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1 leading-snug">
                {wo.category}
              </p>
            </div>
          ))}
