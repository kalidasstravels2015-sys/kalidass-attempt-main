                <WhatsAppIcon variant="brand" className="w-3.5 h-3.5 shrink-0" />
                <span>Enquire Scope</span>
              </a>
              <a
                href="tel:+918939539211"
                class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-m3-full bg-m3-primary text-white text-xs font-bold shadow-xs hover:bg-m3-primary/90 transition-all"
              >
                <AndroidPhoneIcon className="w-3.5 h-3.5 shrink-0" />
                <span>Talk to B2B Head</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Shift Commute & Spot Plans -->
        <div id="shift-spot" class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-8 border border-m3-outline-variant shadow-m3-1 scroll-mt-40">
          <div class="border-b border-m3-outline-variant/60 pb-4 mb-6">
            <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
              <span>Shift Commute &amp; Spot Rentals</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface font-heading">
              Employee Transportation (ETS) &amp; <span class="text-m3-primary">Airport VIP Services</span>
            </h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">
              On-demand business rentals, routed staff commutes, and terminal pickup protocols with verified chauffeurs.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            {spotPlans.map((item) => (
              <div class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-6 border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between hover:shadow-m3-2 hover:border-m3-primary/40 transition-all overflow-hidden group">
                <div>
                  <!-- Top Badges Row -->
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-m3-primary/10 text-m3-primary text-micro font-bold tracking-wider uppercase border border-m3-primary/20">
                      <Sparkles className="w-3 h-3 text-m3-primary shrink-0" />
                      <span>{item.badge}</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-micro font-semibold text-m3-on-surface-variant">
                      <Users className="w-3.5 h-3.5 text-m3-secondary shrink-0" />
                      <span>{item.capacity}</span>
                    </span>
                  </div>

                  <!-- Vehicle Identity & Preview Row with CAR IMAGE -->
                  <div class="flex items-center justify-between gap-3 mb-3">
                    <div class="min-w-0 flex-1">
                      <h3 class="font-bold text-sm sm:text-base text-m3-on-surface font-heading group-hover:text-m3-primary transition-colors">
                        {item.name}
                      </h3>
                      <span class="text-micro text-m3-primary font-semibold block mt-0.5">{item.cars} • {item.scope}</span>
                    </div>
                    <div class="shrink-0 w-20 h-12 sm:w-24 sm:h-14 flex items-center justify-end">
                      <img
                        src={item.image}
                        alt={item.name}
                        width="112"
                        height="56"
                        decoding="async"
                        class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-xs"
                        loading="lazy"
                      />
                    </div>
                  </div>

                  <!-- Rate Slab -->
                  <div class="bg-m3-surface-container-low p-3 rounded-m3-xl border border-m3-outline-variant/50 mb-3 flex flex-col gap-0.5">
                    <span class="text-micro font-semibold text-m3-on-surface-variant uppercase tracking-wider">Corporate Fare</span>
                    <strong class="text-sm sm:text-base font-bold text-m3-primary font-heading leading-snug break-words">{item.rate}</strong>
                  </div>

                  <p class="text-xs text-m3-on-surface-variant leading-relaxed mb-4">{item.detail}</p>
                </div>

                <div class="pt-1">
                  <div class="grid grid-cols-2 gap-2">
                    <a
                      href="tel:+918939539211"
                      aria-label={`Call for ${item.name}`}
                      class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-m3-full bg-m3-surface-container hover:bg-m3-primary-container/30 active:bg-m3-primary-container/50 text-m3-on-surface hover:text-m3-primary border border-m3-outline-variant hover:border-m3-primary/40 text-xs font-bold transition-all select-none"
                    >
                      <AndroidPhoneIcon className="w-3.5 h-3.5 text-m3-primary shrink-0" />
                      <span>Call Now</span>
                    </a>
                    <a
                      href={buildWhatsAppUrl(item.whatsappMsg)}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      aria-label={`Book ${item.name} on WhatsApp`}
                      class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-m3-full bg-m3-success-container/20 hover:bg-m3-success-container/35 active:bg-m3-success-container/50 text-m3-on-surface border border-m3-success/30 text-xs font-bold transition-all select-none"
                    >
                      <WhatsAppIcon variant="brand" className="w-3.5 h-3.5 shrink-0" />
                      <span>Enquire</span>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </section>

      <!-- 6. ENTERPRISE COMMITMENTS (4 PILLARS) -->
      <section id="compliance" class="my-10 md:my-14 bg-m3-surface-container-low rounded-m3-2xl p-6 sm:p-8 border border-m3-outline-variant scroll-mt-40">
        <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
          <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-m3-on-surface font-heading">
            Built for Reliable Corporate Transportation
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">
            How Kalidass Travels guarantees compliance, safety, and business uptime across every fleet assignment.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <ShieldCheck className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Women Night Shift Safety</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Doorstep pickup &amp; drop verification, never first-in or last-drop on night shifts, with active GPS tracking.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <Clock className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">60-Min Backup Guarantee</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Immediate backup driver and vehicle dispatch within 60 minutes anywhere in Chennai to eliminate downtime.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <CheckCircle2 className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">100% GST Tax Invoicing</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">Itemized monthly B2B tax invoices with logbook reconciliation for seamless Input Tax Credit (ITC) deduction.</p>
          </div>

          <div class="bg-m3-surface p-4 rounded-m3-xl border border-m3-outline-variant shadow-xs">
            <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center mb-2.5">
              <Award className="w-4 h-4 text-m3-primary" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface font-heading">Corporate Credit Terms</h3>
            <p class="text-micro sm:text-xs text-m3-on-surface-variant mt-1 leading-relaxed">15-day and 30-day bill-to-company credit terms with designated corporate account onboarding.</p>
          </div>
        </div>
      </section>

      <!-- 7. FREQUENTLY ASKED QUESTIONS -->
      <section id="faqs" class="my-10 md:my-14 max-w-3xl mx-auto scroll-mt-40">
        <div class="text-center mb-6">
          <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface font-heading">
            Corporate Mobility &amp; Fleet Rental <span class="text-m3-primary">FAQs</span>
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">Information on vendor onboarding, backup guarantees, credit terms, and fleet specifications</p>
        </div>

        <FAQAccordion items={faqs} columns={1} name="corporate-faq" />
      </section>

      <!-- 8. BOTTOM CONVERSION CTA BANNER -->
      <section class="bg-m3-inverse-surface text-m3-inverse-on-surface rounded-m3-2xl p-6 sm:p-10 text-center shadow-m3-3 border border-m3-outline-variant/30 my-8">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold font-heading text-white mb-2">
          Looking for a Corporate Cab &amp; Tempo Partner in Chennai?
        </h2>
        <p class="text-m3-inverse-on-surface/85 text-xs sm:text-sm max-w-xl mx-auto mb-6">
          Connect with our corporate transport desk for employee shift commute proposals, industrial plant worker shuttles, monthly executive retainers, or film shoot production fleets.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <WhatsAppButton
            href={buildWhatsAppUrl("Hi Kalidass Travels, I would like to discuss a Corporate Transportation & Fleet proposal.")}
            size="md"
            variant="filled"
            text="Discuss on WhatsApp"
          />
          <a
            href="tel:+918939539211"
            class="inline-flex items-center gap-2 px-6 py-3 bg-m3-surface hover:bg-m3-surface-container text-m3-on-surface font-bold text-xs sm:text-sm rounded-m3-full shadow-m3-1 transition-all"
          >
            <span>Call B2B Desk: +91 89395 39211</span>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
