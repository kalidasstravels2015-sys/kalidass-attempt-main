---

<Layout 
  title={`${title} – Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/corporate.webp"
  ogImage="/og/corporate.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. HERO SECTION -->
      <section class="max-w-4xl mx-auto mb-8 sm:mb-12 text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container text-xs font-bold uppercase tracking-wider mb-3.5 border border-m3-primary/20">
          <span>Enterprise B2B Transport</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Corporate Cab &amp; <span class="text-m3-primary">Employee Mobility</span> in Chennai
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal mb-6">
          Dependable business transportation for IT parks, factories, and corporate offices. 24/7 employee shift commute, monthly executive car retainers, and VIP airport protocol.
        </p>

        <!-- Service Visual Hero Banner (Matching [slug].astro) -->
        <div class="relative w-full h-48 sm:h-64 md:h-80 rounded-m3-xl overflow-hidden shadow-m3-1 border border-m3-outline-variant/60 bg-slate-900 text-left">
          <OptimizedImage
            src="/images/services/corporate.webp"
            alt="Kalidass Travels - Corporate Cab & Employee Transport Services in Chennai"
            class="w-full h-full object-cover object-[center_35%]"
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 640px) 100vw, 896px"
          />

          <!-- Subtle Bottom Gradient Scrim & Badges -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3.5 left-3.5 right-3.5 flex items-center justify-between pointer-events-none gap-2">
            <span class="px-2.5 py-1 rounded-m3-full bg-slate-900/80 backdrop-blur-md text-white text-micro font-semibold border border-white/20 shadow-sm truncate max-w-[50%]">
              Corporate Mobility &amp; Retainers
            </span>
            <span class="px-2.5 py-1 rounded-m3-full bg-m3-primary/95 backdrop-blur-md text-white text-micro font-bold shadow-sm truncate max-w-[50%]">
              100% GST Invoicing • 24/7 SLA
            </span>
          </div>
        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Below Hero, matching [slug].astro) -->
      <nav data-quick-nav aria-label="Corporate Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-8 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-1.5 sm:gap-2 text-xs font-semibold whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <span class="text-micro uppercase tracking-wider text-m3-on-surface-variant mr-1 font-bold hidden sm:inline">Jump To:</span>
          <a href="#how-it-works" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0">How It Works</a>
          <a href="#retainers" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Executive Retainers</a>
          <a href="#shift-spot" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Shift &amp; Spot Rates</a>
          <a href="#compliance" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Enterprise SLA</a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">B2B FAQs</a>
        </div>
      </nav>

      <!-- 2. ⚡ 3-STEP VISUAL WORKFLOW ILLUSTRATION -->
      <div id="how-it-works" class="scroll-mt-40">
        <ServiceExplainer3Step 
          title="How Corporate Mobility Works"
          subtitle="Transparent contracts, verified drivers, and automated GST billing in 3 simple steps"
          steps={explainerSteps}
        />
      </div>

      <!-- 3. UPFRONT B2B RATE CARDS (STRAIGHT TO THE POINT) -->
      <section class="my-10 md:my-14 space-y-12">
        
        <!-- Monthly Retainer Plans -->
        <div id="retainers" class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-8 border border-m3-outline-variant shadow-m3-1 scroll-mt-40">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-m3-outline-variant/60 pb-4 mb-6">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container text-xs font-bold uppercase tracking-wider mb-2 border border-m3-primary/20">
                <span>Monthly Retainers</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface font-heading">
                Dedicated Executive Cars <span class="text-m3-primary">&amp; Chauffeur Retainers</span>
              </h2>
              <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">
                Fixed monthly contracts (26 days / 10 hours daily) for Directors, CXOs, and business teams.
              </p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-m3-on-surface bg-m3-surface-container-high border border-m3-outline-variant px-3 py-1 rounded-m3-full w-fit shrink-0">
              60-Min Replacement SLA
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {retainers.map((plan) => (
              <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between hover:shadow-m3-2 hover:border-m3-primary/40 transition-all overflow-hidden group">
                <div class="p-5 sm:p-6">
                  <!-- Top Badges Row -->
                  <div class="flex items-center justify-between gap-2 mb-3.5">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-m3-full bg-m3-primary/10 text-m3-primary text-[11px] font-bold tracking-wider uppercase border border-m3-primary/20">
                      <Sparkles className="w-3 h-3 text-m3-primary shrink-0" />
                      <span>{plan.badge}</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-semibold text-m3-on-surface-variant">
                      <Users className="w-3.5 h-3.5 text-m3-secondary shrink-0" />
                      <span>{plan.capacity}</span>
                    </span>
                  </div>

                  <!-- Vehicle Identity & Preview Row with CAR IMAGE -->
                  <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="min-w-0 flex-1">
                      <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading leading-snug group-hover:text-m3-primary transition-colors">
                        {plan.plan}
                      </h3>
                      <p class="text-micro text-m3-on-surface-variant mt-0.5 font-medium">
                        {plan.cars} • Dedicated Chauffeur
                      </p>
                    </div>
                    <div class="shrink-0 w-20 h-12 sm:w-24 sm:h-14 flex items-center justify-end">
                      <img
                        src={plan.image}
                        alt={plan.cars}
                        width="112"
                        height="56"
                        decoding="async"
                        class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-xs"
                        loading="lazy"
                      />
                    </div>
                  </div>

                  <!-- M3 Tonal Surface Price Slabs -->
                  <div class="bg-m3-surface-container-low p-4 rounded-m3-xl border border-m3-outline-variant/60 mb-4 space-y-2.5">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="text-[11px] font-semibold text-m3-on-surface-variant uppercase tracking-wider">
                        Monthly Retainer Fee
                      </span>
                      <strong class="text-2xl sm:text-3xl font-black text-m3-primary font-heading tracking-tight leading-none">
                        {plan.rate}
                      </strong>
                    </div>

                    <div class="pt-2 border-t border-m3-outline-variant/50 space-y-1.5">
                      <div class="flex items-center justify-between text-xs py-0.5">
                        <span class="text-m3-on-surface-variant font-medium">Standard Duty Scope</span>
                        <strong class="font-bold text-m3-on-surface">{plan.scope}</strong>
                      </div>
                      <div class="flex items-center justify-between text-xs py-0.5">
                        <span class="text-m3-on-surface-variant font-medium">Overtime / Fuel Rules</span>
                        <strong class="font-bold text-m3-on-surface">{plan.extra}</strong>
                      </div>
                    </div>

                    <div class="pt-1.5 border-t border-m3-outline-variant/40 flex items-center gap-1.5 text-micro font-semibold text-emerald-800">
                      <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                      <span>60-Min Replacement SLA • 100% GST Invoice</span>
                    </div>
                  </div>

                  <!-- Key Highlights -->
                  <p class="text-xs text-m3-on-surface-variant leading-relaxed mb-2">
                    {plan.highlight}
                  </p>
                </div>

                <!-- Card Action Area (Dual Action Buttons) -->
                <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-1">
                  <div class="grid grid-cols-2 gap-2">
                    <a
                      href="tel:+916381939769"
                      aria-label={`Call for ${plan.shortName}`}
