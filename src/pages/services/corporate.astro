<!-- Client-Side Synchronization Script for Tabs & Slabs -->
<script is:inline define:vars={{ gemStandardPackages, retainerVehicles, defaultPkgId, tempoFleet }}>
  function setupCorporateMobility() {
    // 1. Master Slab Switcher for Retainers
    const slabTabs = document.querySelectorAll('[data-pkg-slab-tab]');
    const slabNameEl = document.getElementById('active-slab-name');
    const slabDutyEl = document.getElementById('active-slab-duty');
    const slabUseCaseEl = document.getElementById('active-slab-usecase');

    function updateRetainerSlab(pkgId) {
      const pkg = gemStandardPackages.find(function(p) { return p.id === pkgId; });
      if (!pkg) return;

      // Update slab button styles
      slabTabs.forEach(function(tab) {
        const isCurrent = tab.getAttribute('data-pkg-slab-tab') === pkgId;
        tab.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          tab.className = 'shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-pointer';
        } else {
          tab.className = 'shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200/80 transition-all cursor-pointer';
        }
      });

      // Update active slab description text
      if (slabNameEl) slabNameEl.textContent = pkg.name;
      if (slabDutyEl) slabDutyEl.textContent = pkg.duty;
      if (slabUseCaseEl) slabUseCaseEl.textContent = pkg.useCase;

      // Update 3 vehicle rates and WhatsApp buttons
      retainerVehicles.forEach(function(vehicle) {
        const rate = pkg.rates[vehicle.id];
        const fullRateStr = rate + ' / monthly';

        document.querySelectorAll('[data-rate-display="' + vehicle.id + '"]').forEach(function(el) {
          el.textContent = fullRateStr;
        });

        const waMsg = encodeURIComponent('Hi Kalidass Travels, I want to enquire about the ' + vehicle.plan + ' - ' + pkg.name + ' (' + fullRateStr + ').');
        const waUrl = 'https://wa.me/918939539211?text=' + waMsg;
        document.querySelectorAll('[data-wa-btn="' + vehicle.id + '"]').forEach(function(btn) {
          btn.setAttribute('href', waUrl);
        });
      });
    }

    slabTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const pkgId = tab.getAttribute('data-pkg-slab-tab');
        if (pkgId) updateRetainerSlab(pkgId);
      });
    });

    // 2. Tempo Configuration Switcher
    const tempoTabs = document.querySelectorAll('[data-tempo-tab]');
    const tempoCards = document.querySelectorAll('[data-tempo-card]');

    function setTempoModel(tempoId) {
      tempoTabs.forEach(function(tab) {
        const isCurrent = tab.getAttribute('data-tempo-tab') === tempoId;
        tab.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          tab.className = 'px-3 py-2 rounded-lg text-xs font-bold text-center bg-slate-900 text-white shadow-xs transition-all cursor-pointer';
        } else {
          tab.className = 'px-3 py-2 rounded-lg text-xs font-semibold text-center bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200/80 transition-all cursor-pointer';
        }
      });

      tempoCards.forEach(function(card) {
        const matches = card.getAttribute('data-tempo-card') === tempoId;
        if (matches) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.add('hidden');
          card.classList.remove('block');
        }
      });
    }

    tempoTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const tempoId = tab.getAttribute('data-tempo-tab');
        if (tempoId) setTempoModel(tempoId);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCorporateMobility);
  } else {
    setupCorporateMobility();
  }
  document.addEventListener('astro:page-load', setupCorporateMobility);
</script>
