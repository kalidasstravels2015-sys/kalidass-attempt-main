<Layout 
  title={`${title} – Kalidass Travels`}
  description={description}
  keywords={keywords}
  image="/images/services/corporate.webp"
  ogImage="/og/corporate.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. HERO SECTION -->
      <section class="max-w-4xl mx-auto mb-8 sm:mb-12 text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container text-xs font-bold uppercase tracking-wider mb-3.5 border border-m3-primary/20">
          <span>Enterprise B2B Transport • 100% GST Compliant</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Corporate Cab, <span class="text-m3-primary">Employee Mobility</span> &amp; Tempo Fleet in Chennai
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal mb-5">
          Dependable transportation partner for IT corridors, manufacturing plants, bio-refineries, and cinema studios. 24/7 routed employee shifts, executive car retainers, and 12–20 seater AC Tempo Travellers with 100% GST billing.
        </p>

        <!-- Quick Proof Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant text-micro sm:text-xs font-semibold text-m3-on-surface">
            <CheckCircle2 className="w-3.5 h-3.5 text-m3-primary shrink-0" />
