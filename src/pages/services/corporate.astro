import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const title = "Corporate Cab & Employee Transport Services in Chennai";
const description = "Enterprise transportation in Chennai: 24/7 routed employee shift commute, monthly executive car retainers with dedicated chauffeurs, and corporate airport transfers with 100% GST billing.";
const keywords = "corporate cab service chennai, employee transport service chennai, corporate car rental with driver chennai, monthly cab retainer chennai, office cab service chennai, staff commute cab chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Corporate Mobility", item: "/services/corporate/" },
];

const explainerSteps = [
  {
    stepNumber: "1",
    badge: "Step 1: Choose Service",
    title: "Choose Your Service Type",
    desc: "Select from monthly car retainers with driver, daily employee shift routes, or corporate airport transfers.",
    illustrationTitle: "Select Corporate Plan",
    illustrationSub: "Retainers • Shifts • Airport Transfers",
    theme: "purple" as const,
    iconType: "car" as const
  },
  {
    stepNumber: "2",
    badge: "Step 2: Deployment",
    title: "Verified Chauffeur & Vehicle",
    desc: "Background-verified drivers in uniform, active GPS tracking, and a 60-minute emergency backup replacement guarantee.",
    illustrationTitle: "Dedicated Fleet & Chauffeur",
    illustrationSub: "60-Min Replacement Guarantee",
    theme: "blue" as const,
    iconType: "driver" as const
  },
  {
    stepNumber: "3",
    badge: "Step 3: GST Invoicing",
    title: "Monthly Consolidated Billing",
    desc: "Digital duty slips and 100% GST-compliant monthly tax invoices for your company's full input tax credit claim.",
    illustrationTitle: "100% GST Invoicing",
    illustrationSub: "Monthly Corporate Invoices",
    theme: "emerald" as const,
    iconType: "relax" as const
  }
];

const retainers = [
