    title: "Choose Your Service Type",
    desc: "Select from monthly car retainers with driver, daily employee shift routes, or corporate airport transfers.",
    illustrationTitle: "Select Corporate Plan",
    illustrationSub: "Retainers • Shifts • Airport Transfers",
    theme: "purple" as const,
    iconType: "car" as const
  },
  {
    stepNumber: "2",
    badge: "Step 2: Deployment",
    title: "Verified Chauffeur & Vehicle",
    desc: "Background-verified drivers in uniform, active GPS tracking, and a 60-minute emergency backup replacement guarantee.",
    illustrationTitle: "Dedicated Fleet & Chauffeur",
    illustrationSub: "60-Min Replacement Guarantee",
    theme: "blue" as const,
    iconType: "driver" as const
  },
  {
    stepNumber: "3",
    badge: "Step 3: GST Invoicing",
    title: "Monthly Consolidated Billing",
    desc: "Digital duty slips and 100% GST-compliant monthly tax invoices for your company's full input tax credit claim.",
