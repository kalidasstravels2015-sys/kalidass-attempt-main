<!-- CLIENT-SIDE EVENT WIRING & CAROUSEL OBSERVERS -->
<script is:inline>
  (function initTempoPageScripts() {
    // 1. Vehicle Card "Calculate & Book" Action -> Selects vehicle in QuotationEngine
    const specBookBtns = document.querySelectorAll('.spec-book-vehicle-btn');
    specBookBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const vKey = btn.dataset.vehicleKey;
        const vName = btn.dataset.vehicleName;
        const targetVehicle = vName || (vKey === '17' ? '17-Seater Executive Force Tempo' : vKey === 'urbania' ? 'Force Urbania VIP Luxury' : '12-Seater Luxury Force Tempo');
        window.dispatchEvent(new CustomEvent('select-quote-vehicle', { detail: { vehicle: targetVehicle } }));
        const calcEl = document.getElementById('trip-calculator') || document.getElementById('fare-calculator');
        if (calcEl) {
          calcEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // 1b. Package Card "Book in Booking Engine" Action -> Selects package in QuotationEngine & scrolls to calculator
    const pkgBookBtns = document.querySelectorAll('.pkg-book-engine-btn');
    pkgBookBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const dest = btn.dataset.destination || '';
        const days = btn.dataset.days || '1';
        const veh = btn.dataset.vehicle || '12-Seater Luxury Force Tempo';

        window.dispatchEvent(new CustomEvent('select-quote-package', {
          detail: {
            destination: dest,
            days: days,
            vehicle: veh,
            tab: 'round'
          }
        }));

        const calcEl = document.getElementById('trip-calculator') || document.getElementById('fare-calculator') || document.getElementById('tempo-quotation-engine');
        if (calcEl) {
          calcEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // 2. Interactive Tabbed Vehicle Spotlight Switcher
    const specTabBtns = document.querySelectorAll('.spec-tab-btn');
    const specPanels = document.querySelectorAll('.spec-panel');
    specTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.targetTab;
        specTabBtns.forEach(b => {
          const isSelected = (b === btn);
          b.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          if (isSelected) {
            b.className = 'flex-1 min-h-[42px] py-2 px-3.5 rounded-full text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center truncate spec-tab-btn select-none bg-m3-primary text-white shadow-2xs';
          } else {
            b.className = 'flex-1 min-h-[42px] py-2 px-3.5 rounded-full text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center truncate spec-tab-btn select-none text-m3-on-surface-variant hover:text-m3-primary hover:bg-m3-surface-container-high';
          }
        });
        specPanels.forEach(panel => {
          if (panel.id === `panel-${targetId}`) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
            setTimeout(() => {
              panel.classList.remove('opacity-0');
              panel.classList.add('opacity-100');
            }, 10);
          } else {
            panel.classList.remove('block', 'opacity-100');
            panel.classList.add('hidden', 'opacity-0');
          }
        });
      });
    });

    // 2b. Mobile Fleet Scroller Dots Indicator
    const specScroller = document.getElementById('spec-fleet-scroller');
    const specDots = document.querySelectorAll('.spec-dot');
    if (specScroller && specDots.length > 0) {
      const updateSpecDots = function() {
        const scrollLeft = specScroller.scrollLeft;
        const cardWidth = specScroller.offsetWidth * 0.88;
        const activeIdx = Math.min(Math.round(scrollLeft / cardWidth), specDots.length - 1);
        specDots.forEach(function(dot, idx) {
          const bar = dot.querySelector('.spec-dot-bar');
          if (bar) {
            if (idx === activeIdx) {
              bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-m3-primary w-5';
            } else {
              bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-m3-outline-variant w-1.5';
            }
          }
        });
      };
      specScroller.addEventListener('scroll', updateSpecDots, { passive: true });
      specDots.forEach(function(dot) {
        dot.onclick = function() {
          const idx = parseInt(dot.dataset.specIndex || '0', 10);
          const cards = specScroller.children;
          if (cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        };
      });
    }

    // 3. Top Outstation Packages Scroller Dots Indicator (Mobile)
    const pkgScroller = document.getElementById('packages-carousel-track');
    const pkgDots = document.querySelectorAll('.pkg-dot');
    if (pkgScroller && pkgDots.length > 0) {
      const updatePkgDots = function() {
        const scrollLeft = pkgScroller.scrollLeft;
        const cardWidth = pkgScroller.offsetWidth * 0.85;
        const activeIdx = Math.min(Math.round(scrollLeft / cardWidth), pkgDots.length - 1);
        pkgDots.forEach(function(dot, idx) {
          const bar = dot.querySelector('.pkg-dot-bar');
          if (bar) {
            if (idx === activeIdx) {
              bar.className = 'h-1.5 rounded-full transition-all duration-300 pkg-dot-bar bg-m3-primary w-5';
            } else {
              bar.className = 'h-1.5 rounded-full transition-all duration-300 pkg-dot-bar bg-m3-outline-variant w-1.5';
            }
          }
        });
      };

      pkgScroller.addEventListener('scroll', updatePkgDots, { passive: true });

      pkgDots.forEach(function(dot) {
        dot.onclick = function() {
          const idx = parseInt(dot.dataset.pkgIndex || '0', 10);
          const cards = pkgScroller.children;
          if (cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        };
      });
    }

    // 4. Side-by-Side Model Comparison: Modal Trigger on Mobile / Smooth Scroll on Desktop
    const specModal = document.getElementById('specModal');
    const openSpecModalBtn = document.getElementById('open-spec-modal-btn');
    const closeSpecModalBtns = document.querySelectorAll('.close-spec-modal-btn');

    function openSpecModal() {
      if (specModal && typeof specModal.showModal === 'function') {
        specModal.showModal();
      }
    }

    function closeSpecModal() {
      if (specModal && typeof specModal.close === 'function') {
        specModal.close();
      }
    }

    if (openSpecModalBtn) {
      openSpecModalBtn.addEventListener('click', openSpecModal);
    }

    closeSpecModalBtns.forEach(btn => {
      btn.addEventListener('click', closeSpecModal);
    });

    // Close modal when clicking outside dialog (on backdrop)
    if (specModal) {
      specModal.addEventListener('click', (e) => {
        const dialogDimensions = specModal.getBoundingClientRect();
        if (
          e.clientX < dialogDimensions.left ||
          e.clientX > dialogDimensions.right ||
          e.clientY < dialogDimensions.top ||
          e.clientY > dialogDimensions.bottom
        ) {
          specModal.close();
        }
      });
    }

    // Quick-nav link "#spec-comparison": open modal on mobile, scroll to section on desktop
    const specNavLinks = document.querySelectorAll('a[href="#spec-comparison"]');
    specNavLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        if (window.innerWidth < 768) {
          e.preventDefault();
          openSpecModal();
        }
      });
    });

    // 5. Transparent Tariff Carousel Sync for Mobile
    const tariffTrack = document.getElementById('tariff-carousel-track');
    const tariffDots = document.querySelectorAll('.tariff-dot');

    if (tariffTrack && tariffDots.length > 0) {
      tariffTrack.addEventListener('scroll', () => {
        const scrollLeft = tariffTrack.scrollLeft;
        const cardWidth = tariffTrack.firstElementChild?.clientWidth || 300;
        const activeIdx = Math.min(
          tariffDots.length - 1,
          Math.max(0, Math.round(scrollLeft / cardWidth))
        );

        tariffDots.forEach((dot, idx) => {
          const bar = dot.querySelector('.tariff-dot-bar');
          if (bar) {
            if (idx === activeIdx) {
              bar.classList.add('bg-m3-primary', 'w-5');
              bar.classList.remove('bg-m3-outline-variant', 'w-1.5');
            } else {
              bar.classList.remove('bg-m3-primary', 'w-5');
              bar.classList.add('bg-m3-outline-variant', 'w-1.5');
            }
          }
        });
      }, { passive: true });

      tariffDots.forEach(dot => {
        dot.addEventListener('click', function() {
          const idx = parseInt(this.dataset.tariffIndex || '0', 10);
          const cards = tariffTrack.children;
          if (cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
      });
    }
  })();
</script>

<style>
  dialog#specModal:modal {
    overscroll-behavior: contain;
  }
  dialog#specModal::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
  }
</style>
