---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  url={canonicalURL}
>
  <main class="min-h-screen bg-m3-surface text-m3-on-surface font-sans pb-16">
    <!-- Breadcrumbs Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3 pb-1">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- SECTION 1: SYSTEM UI DESIGN SYSTEM HERO WITH DEDICATED TEMPO QUOTATION ENGINE -->
    <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 pt-1 sm:pt-2">
      
      <!-- Top Page Heading & Google Rating Badge (Minimalist, No Clutter) -->
      <div class="max-w-3xl mx-auto mb-2 text-center">
        <div class="flex items-center justify-center mb-1.5">
          <GoogleRatingBadge />
        </div>
        <h1 data-speakable="true" class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface font-heading tracking-tight leading-tight">
          Tempo Traveller Rental in Chennai
        </h1>
      </div>

      <div id="fare-calculator" class="scroll-mt-28"></div>
      <div id="trip-calculator" class="scroll-mt-28"></div>

      <!-- Dedicated Tempo Quotation Engine -->
      <section class="relative z-20 py-1 px-1 sm:px-3 max-w-2xl mx-auto mb-3">
        <TempoQuotationEngine 
          client:load 
          variant="card" 
          allowedTabs={['round', 'local']}
          initialTab="round"
          initialPickup="Chennai, Tamil Nadu"
          initialDrop=""
          autoCalculate={false}
          showHeader={false}
        />
      </section>

      <!-- MATERIAL 3 STICKY QUICK NAVIGATION BAR -->
      <nav id="mobile-quick-nav" data-quick-nav aria-label="Tempo Traveller Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-2.5 mb-6 px-4 sm:px-6 lg:px-8 -mx-3 sm:-mx-6 lg:-mx-8">
        <div class="max-w-6xl mx-auto flex items-center justify-start sm:justify-center gap-2 text-xs font-semibold whitespace-nowrap overflow-x-auto no-scrollbar py-0.5">
          <a href="#trip-calculator" class="px-3.5 py-1.5 rounded-full font-bold text-white bg-m3-primary hover:bg-m3-primary/90 transition shrink-0 shadow-2xs">
            Fare Calculator
          </a>
          <a href="#fleet-section" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            Tempo Fleet
          </a>
          <a href="#spec-comparison" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            Specs Matrix
          </a>
          <a href="#tariff-section" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            Tariff Comparison
          </a>
          <a href="#packages-section" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            Outstation Packages
          </a>
          <a href="#inclusions-section" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            Inclusions &amp; Policy
          </a>
          <a href="#booking-steps-section" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            How to Book
          </a>
          <a href="#faq-section" class="px-3.5 py-1.5 rounded-full font-medium text-m3-on-surface bg-m3-surface-container hover:bg-m3-surface-container-high transition shrink-0">
            Passenger FAQs
          </a>
        </div>
      </nav>

      <!-- SECTION 2: VEHICLE SPECIFICATIONS & LUGGAGE CAPACITIES -->
      <section id="fleet-section" class="pt-2 sm:pt-4 mb-10 sm:mb-14 scroll-mt-28">
        <span id="per-km-table" class="scroll-mt-28"></span>
        <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-10">
          <span class="text-xs font-bold uppercase tracking-wider text-m3-primary">Transparent Per-KM Rates • Zero Surge</span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-m3-on-surface font-heading tracking-tight mt-1">
            Vehicle Specifications &amp; Luggage Capacities
          </h2>
          <p class="text-m3-on-surface-variant mt-2 text-xs sm:text-sm">
            Standing 6.2 ft walkthrough cabins, 135° pushback recliners, dual AC blowers, and certified 3-zone luggage architecture.
          </p>
        </div>

        <!-- 1. Interactive Tabbed Vehicle Spotlight (Uber Reserve / Tesla style) -->
        <div class="mb-10">
          <!-- Segmented Tab Switcher (Desktop Only) -->
          <div class="hidden md:flex items-center justify-center mb-5">
            <div class="flex items-center justify-center gap-1.5 p-1 bg-m3-surface-container-low rounded-full border border-m3-outline-variant/60 shadow-xs max-w-2xl w-full" role="tablist" aria-label="Select Tempo Traveller Model">
              {vanFleet.map((vehicle, idx) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                  id={`tab-${vehicle.id}`}
                  aria-controls={`panel-${vehicle.id}`}
                  class={`flex-1 min-h-[42px] py-2 px-3.5 rounded-full text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center truncate spec-tab-btn select-none ${
                    idx === 0
                      ? 'bg-m3-primary text-white shadow-2xs'
                      : 'text-m3-on-surface-variant hover:text-m3-primary hover:bg-m3-surface-container-high'
                  }`}
                  data-target-tab={vehicle.id}
                >
                  {vehicle.shortTitle}
                </button>
              ))}
            </div>
          </div>

          <!-- Spotlight Showcase Panels (Desktop Only) -->
          <div class="hidden md:block max-w-2xl mx-auto">
            {vanFleet.map((vehicle, idx) => (
              <div
                id={`panel-${vehicle.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${vehicle.id}`}
                class={`spec-panel transition-all duration-300 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}
              >
                <div class="bg-m3-surface-container-lowest rounded-3xl border border-m3-outline-variant/70 shadow-xs hover:shadow-m3-1 transition-all overflow-hidden">
                  
                  <!-- Top Vehicle Studio Stage -->
                  <div class="relative bg-gradient-to-b from-m3-surface-container-low/80 via-m3-surface-container-low/40 to-m3-surface-container-lowest pt-5 pb-4 px-4 sm:px-6 border-b border-m3-outline-variant/50 flex flex-col items-center overflow-hidden">
                    
                    <!-- Subtle Radial Spotlight Background -->
                    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-m3-primary/5 via-transparent to-transparent pointer-events-none"></div>

                    <!-- Top Badge Bar -->
                    <div class="w-full flex items-center justify-between gap-2 mb-2 relative z-10">
                      <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-m3-primary/10 text-m3-primary border border-m3-primary/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-m3-primary animate-pulse"></span>
                        {vehicle.badge}
                      </span>
                      <span class="text-xs font-medium text-m3-on-surface-variant bg-m3-surface-container px-2.5 py-0.5 rounded-full border border-m3-outline-variant/60">
                        {vehicle.chassis.split(' (')[0]}
                      </span>
                    </div>

                    <!-- Vehicle Image with Ground Reflection Shadow -->
                    <div class="relative my-1 flex flex-col items-center">
                      <img
                        src={vehicle.image}
                        alt={`${vehicle.name} - Kalidass Travels Chennai`}
                        width="240"
                        height="120"
                        loading="lazy"
                        decoding="async"
                        class="h-28 sm:h-36 max-w-full object-contain filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.10)] transition-transform duration-300 hover:scale-[1.02]"
                      />
                      <!-- Soft Oval Contact Ground Shadow -->
                      <div class="w-3/4 h-2 bg-slate-950/15 dark:bg-black/30 rounded-[100%] blur-[4px] -mt-1"></div>
                    </div>

                    <!-- Vehicle Title & Layout Subtitle -->
                    <div class="text-center mt-2 relative z-10">
                      <h3 class="text-lg sm:text-xl font-bold text-m3-on-surface tracking-tight leading-snug">
                        {vehicle.name}
                      </h3>
                      <p class="text-xs sm:text-sm text-m3-on-surface-variant font-medium mt-0.5 flex items-center justify-center gap-1.5">
                        <span>{vehicle.layout}</span>
                      </p>
                    </div>
                  </div>

                  <!-- Card Body Content -->
                  <div class="p-4 sm:p-6 space-y-4">
                    
                    <!-- 4 Minimal Stat Chips (2x2 on mobile, 4-in-a-row on desktop) -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                      <div class="p-2.5 rounded-2xl bg-m3-surface-container-low border border-m3-outline-variant/60 text-center">
                        <Users className="w-4 h-4 text-m3-primary mx-auto mb-1" />
                        <div class="text-xs sm:text-sm font-bold text-m3-on-surface leading-tight tabular-nums">{vehicle.capacityNumber} Seats</div>
                        <div class="text-xs text-m3-on-surface-variant font-medium mt-0.5">{vehicle.recline.split(' ')[0]} Recline</div>
                      </div>

                      <div class="p-2.5 rounded-2xl bg-m3-surface-container-low border border-m3-outline-variant/60 text-center">
                        <ArrowUpDown className="w-4 h-4 text-m3-primary mx-auto mb-1" />
                        <div class="text-xs sm:text-sm font-bold text-m3-on-surface leading-tight tabular-nums">{vehicle.headroom.split(' ')[0]} {vehicle.headroom.split(' ')[1]}</div>
                        <div class="text-xs text-m3-on-surface-variant font-medium mt-0.5">Walk upright</div>
                      </div>

                      <div class="p-2.5 rounded-2xl bg-m3-surface-container-low border border-m3-outline-variant/60 text-center">
                        <Wind className="w-4 h-4 text-m3-primary mx-auto mb-1" />
                        <div class="text-xs sm:text-sm font-bold text-m3-on-surface leading-tight tabular-nums">Dual AC Vents</div>
                        <div class="text-xs text-m3-on-surface-variant font-medium mt-0.5">Every Single Row</div>
                      </div>

                      <div class="p-2.5 rounded-2xl bg-m3-surface-container-low border border-m3-outline-variant/60 text-center">
                        <Zap className="w-4 h-4 text-m3-primary mx-auto mb-1" />
                        <div class="text-xs sm:text-sm font-bold text-m3-on-surface leading-tight tabular-nums">2.4A Fast USB</div>
                        <div class="text-xs text-m3-on-surface-variant font-medium mt-0.5">At Every Row</div>
                      </div>
                    </div>

                    <!-- Visual 3-Zone Luggage Capacity Strip -->
                    <div class="p-3 rounded-2xl bg-m3-surface-container-low border border-m3-outline-variant/60">
                      <div class="flex items-center justify-between text-xs font-bold mb-2">
                        <span class="flex items-center gap-1.5 text-m3-on-surface">
                          <Luggage className="w-3.5 h-3.5 text-m3-primary" />
                          <span>Certified 3-Zone Luggage Capacity</span>
                        </span>
                        <span class="text-xs font-semibold text-emerald-800 dark:text-emerald-300 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                          Zero Gangway Bags
                        </span>
                      </div>
                      
                      <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="p-2.5 rounded-xl bg-m3-surface-container-lowest border border-m3-outline-variant/60 shadow-2xs">
