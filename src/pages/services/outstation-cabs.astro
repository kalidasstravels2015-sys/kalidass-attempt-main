  <!-- Client-side Script for Outstation Calculator Modal Triggers & Fleet Scroller -->
  <script is:inline>
    function setupOutstationPage() {
      // 1. Wire Up Outstation Calculator Modal Triggers
      document.addEventListener('click', function(e) {
        var trigger = e.target.closest('[data-open-outstation-calc="true"]');
        if (!trigger) return;

        e.preventDefault();
        e.stopPropagation();

        var vehicleData = {
          vehicleKey: trigger.getAttribute('data-vehicle-key'),
          vehicleName: trigger.getAttribute('data-vehicle-name'),
          badge: trigger.getAttribute('data-badge'),
          image: trigger.getAttribute('data-image'),
          capacity: trigger.getAttribute('data-capacity'),
          roundTripRate: parseInt(trigger.getAttribute('data-round-rate'), 10) || 17,
          oneWayRate: parseInt(trigger.getAttribute('data-oneway-rate'), 10) || 19,
          bata: parseInt(trigger.getAttribute('data-bata'), 10) || 500,
          minKm: parseInt(trigger.getAttribute('data-min-km'), 10) || 250
        };

        if (window.openOutstationCalculator) {
          window.openOutstationCalculator(vehicleData);
        } else {
          window.dispatchEvent(new CustomEvent('open-outstation-calculator', { detail: vehicleData }));
        }
      });

      // 2. Fleet Horizontal Carousel & Indicator Dots (Mobile)
      var specScroller = document.getElementById('spec-fleet-scroller');
      var specDots = document.querySelectorAll('.spec-dot');
      if (specScroller && specDots.length > 0) {
        var updateSpecDots = function() {
          var scrollLeft = specScroller.scrollLeft;
          var cardWidth = specScroller.offsetWidth * 0.75;
          var activeIdx = Math.min(Math.round(scrollLeft / cardWidth), specDots.length - 1);
          specDots.forEach(function(dot, idx) {
            var bar = dot.querySelector('.spec-dot-bar');
            if (bar) {
              if (idx === activeIdx) {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-m3-primary w-5';
              } else {
                bar.className = 'h-1.5 rounded-full transition-all duration-300 spec-dot-bar bg-m3-outline-variant w-1.5';
              }
            }
          });
        };

        specScroller.addEventListener('scroll', updateSpecDots, { passive: true });

        specDots.forEach(function(dot) {
          dot.onclick = function() {
            var idx = parseInt(dot.dataset.index || '0', 10);
            var cards = specScroller.querySelectorAll('.tariff-card, [data-vehicle-name]');
            if (cards[idx]) {
              cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
          };
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupOutstationPage);
    } else {
      setupOutstationPage();
    }
    document.addEventListener('astro:page-load', setupOutstationPage);
  </script>

