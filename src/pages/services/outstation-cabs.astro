---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
  image="/images/temple/mahabalipuram-ecr-temples.webp"
  ogImage="/og/outstation-cabs.jpg"
  schema={[taxiServiceSchema, productSchema, faqSchema, howToSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 pt-2 sm:pt-4">

      <!-- TOP PAGE HEADING & TRUST BADGES (Matching Airport Taxi Standard) -->
      <div class="max-w-2xl mx-auto mb-2 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-2">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-m3-surface-container-low border border-m3-outline-variant text-m3-on-surface text-[10px] font-bold mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-m3-success animate-pulse"></span>
            <span>24/7 Outstation Cabs Chennai • Flat ₹14/km</span>
          </div>
          <h1 data-speakable="true" class="text-lg sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface font-heading tracking-tight leading-tight">
            Chennai Outstation Cabs &amp; Intercity Taxi
          </h1>
          <p class="text-xs text-m3-on-surface-variant font-medium mt-0.5">
            Transparent pricing • Verified chauffeurs • Zero surge
          </p>
        </div>
        <div class="hidden sm:flex items-center gap-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-m3-surface-container-lowest border border-m3-outline-variant shadow-2xs text-xs font-semibold text-m3-on-surface">
            <span class="material-symbols-outlined text-m3-tertiary text-[15px]">star</span>
            <span>4.9/5 Rating (5,000+ Trips)</span>
          </span>
        </div>
      </div>

      <div id="fare-calculator" class="scroll-mt-28"></div>

      <!-- Dedicated Outstation Booking Panel (Home-Screen Inspired Matching Airport Page) -->
      <section class="relative z-20 py-1 sm:py-2 px-1 sm:px-3 max-w-2xl mx-auto mb-3">
        <QuotationEngine 
          client:load 
          showAirportTab={false} 
          showHeader={false}
          variant="card" 
        />

        <!-- Trust Reassurance Footer Strip -->
        <div class="mt-2 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-[11px] text-m3-on-surface-variant font-medium">
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-m3-primary shrink-0">verified</span>
            <span class="font-bold text-m3-on-surface">₹500 Advance to Confirm — Balance Post Trip</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-m3-primary shrink-0">check_circle</span>
            <span>Instant WhatsApp confirmation</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-m3-primary shrink-0">check_circle</span>
            <span>Zero surge pricing • 250 km/day standard</span>
          </div>
        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Matching Document Flow) -->
      <nav data-quick-nav aria-label="Outstation Cabs Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-b border-m3-outline-variant/60 shadow-xs py-3 mb-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <a href="#fare-calculator" data-active="true" aria-current="true" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0 hover:bg-m3-primary hover:text-white">
            Calculate Fare
          </a>
          <a href="#commitments" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Our Guarantees
          </a>
          <a href="#fleet-section" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Vehicle Fleet
          </a>
          <a href="#popular-routes" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Top Routes
          </a>
          <a href="#safety-benchmark" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Highway Safety
          </a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Outstation FAQs
          </a>
        </div>
