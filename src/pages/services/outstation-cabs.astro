---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import ServiceExplainer3Step from '../../components/ServiceExplainer3Step.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { ChevronRight } from 'lucide-react';

const title = "Outstation Cabs from Chennai | Round Trip & One-Way Taxi (₹14/km) – Kalidass Travels";
const description = "Book clean AC cabs from Chennai for outstation trips and weekend getaways. Flat ₹14/km rates for Sedans, Innova Crysta, and Tempo Travellers with zero surge pricing.";
const keywords = "outstation cabs chennai, outstation taxi from chennai, outstation cab booking chennai, chennai to pondicherry cab, car rental with driver chennai, per km taxi rate chennai, round trip cab chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Outstation Cabs", item: "/services/outstation-cabs/" },
];

const explainerSteps = [
  {
    stepNumber: "1",
    badge: "Step 1: Choose Ride",
    title: "Pick Your Vehicle",
    desc: "Select from clean AC Sedans (Dzire/Etios), spacious Ertigas, luxury Innova Crystas, or 12–17 seat Tempo Travellers.",
    illustrationTitle: "Choose Your Fleet",
    illustrationSub: "Sedan • SUV • Crysta • Tempo",
    theme: "amber" as const,
    iconType: "car" as const
  },
  {
    stepNumber: "2",
    badge: "Step 2: Doorstep Pickup",
    title: "Driver Arrives on Time",
    desc: "Punctual reporting at your home, hotel, or Chennai Airport with clean sanitized interior and polite highway chauffeur.",
    illustrationTitle: "Doorstep Pickup in Chennai",
    illustrationSub: "Home, Hotel, or Airport",
    theme: "blue" as const,
    iconType: "pickup" as const
  },
  {
    stepNumber: "3",
    badge: "Step 3: Safe Highway Tour",
    title: "Transparent & Safe Travel",
    desc: "Disciplined 80–90 km/h cruising with flexible refreshment stops. Pay transparent per-km or flat package rates.",
    illustrationTitle: "Smooth Highway Journey",
    illustrationSub: "Transparent Distance Billing",
    theme: "emerald" as const,
    iconType: "road" as const
  }
];

const packageTariff = [
  {
    id: "pondicherry-1day",
    slug: "pondicherry-one-day-trip",
    name: "Chennai to Pondicherry (1-Day Trip)",
    badge: "Top Weekend Trip",
    image: "/images/temple/pondicherry.webp",
    route: "Auroville, French White Town, Promenade Beach & ECR Tolls Included",
    duration: "Same Day Return (Up to 320 KM)",
    rates: [
      { car: "Sedan (Dzire/Etios)", price: "₹4,500" },
      { car: "Ertiga (6 Pax)", price: "₹5,500" },
      { car: "Innova (7 Pax)", price: "₹6,500" },
      { car: "Innova Crysta", price: "₹7,500" },
      { car: "Tempo (12 Pax)", price: "₹9,500" }
    ],
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai to Pondicherry 1-Day Trip package."
  },
  {
    id: "mahabalipuram-day",
    slug: "mahabalipuram-ecr-temple-route",
    name: "Chennai to Mahabalipuram UNESCO & Beach Tour",
    badge: "Heritage & Beach",
    image: "/images/temple/mahabalipuram-ecr-temples.webp",
    route: "Shore Temple, Five Rathas, Arjuna's Penance, Seashell Museum + Tolls",
    duration: "Full Day (8 Hrs / 120 KM)",
    rates: [
      { car: "Sedan (Dzire/Etios)", price: "₹3,500" },
      { car: "Ertiga (6 Pax)", price: "₹4,500" },
      { car: "Innova (7 Pax)", price: "₹5,500" },
      { car: "Innova Crysta", price: "₹6,500" },
      { car: "Tempo (12 Pax)", price: "₹8,000" }
    ],
    whatsappMsg: "Hi Kalidass Travels, I want to book the Mahabalipuram Day Tour package."
  },
  {
    id: "chennai-city-tour",
    slug: "one-day-chennai-city-tour",
    name: "One-Day Chennai City Sightseeing",
    badge: "City Discovery",
    image: "/images/temple/chennai-city.webp",
    route: "Kapaleeshwarar, Santhome, Marina Beach, Egmore Museum & Fort St. George",
    duration: "8 Hours / 80 KM City Package",
    rates: [
      { car: "Sedan (Dzire/Etios)", price: "₹2,500" },
      { car: "Ertiga (6 Pax)", price: "₹3,200" },
      { car: "Innova (7 Pax)", price: "₹3,800" },
      { car: "Innova Crysta", price: "₹4,500" },
      { car: "Tempo (12 Pax)", price: "₹5,500" }
    ],
    whatsappMsg: "Hi Kalidass Travels, I want to book the Chennai City Sightseeing Tour package."
  }
];

const perKmTariff = [
  {
    vehicle: "Swift Dzire / Toyota Etios",
    capacity: "4 Pax + 2 Bags",
    roundTrip: "₹14 / km",
    oneWay: "₹16 / km",
    minKm: "250 km / day",
    bata: "₹400 / day",
    whatsappMsg: "Hi Kalidass Travels, I need a Sedan (₹14/km) for an outstation trip."
  },
  {
    vehicle: "Maruti Ertiga / XL6",
    capacity: "6 Pax + 3 Bags",
    roundTrip: "₹17 / km",
    oneWay: "₹19 / km",
    minKm: "250 km / day",
    bata: "₹500 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Ertiga SUV (₹17/km) for an outstation trip."
  },
  {
    vehicle: "Toyota Innova",
    capacity: "7 Pax + 4 Bags",
    roundTrip: "₹20 / km",
    oneWay: "₹22 / km",
    minKm: "250 km / day",
    bata: "₹600 / day",
    whatsappMsg: "Hi Kalidass Travels, I need a Toyota Innova (₹20/km) for an outstation trip."
  },
  {
    vehicle: "Toyota Innova Crysta",
    capacity: "7 Pax + 5 Bags",
    roundTrip: "₹22 / km",
    oneWay: "₹25 / km",
    minKm: "250 km / day",
    bata: "₹700 / day",
    whatsappMsg: "Hi Kalidass Travels, I need an Innova Crysta (₹22/km) for an outstation trip."
  },
  {
    vehicle: "Tempo Traveller (12 / 17 Seater)",
    capacity: "12–17 Pax + Bags",
    roundTrip: "₹26 / km",
    oneWay: "₹29 / km",
    minKm: "300 km / day",
    bata: "₹800 / day",
    whatsappMsg: "Hi Kalidass Travels, I need a Tempo Traveller (₹26/km) for a group outstation trip."
  }
];

const faqs = [
  {
    q: "How is outstation distance and billing calculated?",
    a: "Outstation round-trips follow a standard minimum of 250 km per calendar day (300 km for Tempo Traveller). Kilometers are calculated garage-to-garage from Chennai. If you travel 210 km, the minimum 250 km applies; if you travel 330 km, you pay for the exact 330 km."
  },
  {
    q: "Are tolls and driver bata included in fixed packages vs per-km rates?",
    a: "For fixed destination packages (like Pondicherry and Mahabalipuram), highway tolls, fuel, and driver bata are 100% all-inclusive. For open per-km outstation bookings, vehicle and fuel are included in the per-km rate, while FASTag tolls, parking fees, and interstate road taxes are billed at actuals."
  },
  {
    q: "Can we make spontaneous sightseeing or cafe stops on the way?",
    a: "Yes! Our drivers are courteous and flexible. You can request breakfast halts on the highway, scenic photo stops along the East Coast Road, or temple darshan detours at your convenience."
  },
  {
    q: "Do you provide one-way drop outstation taxi service?",
    a: "Yes! We provide one-way drop taxis from Chennai to Bangalore, Pondicherry, Tirupati, Vellore, Trichy, and Madurai with fixed drop pricing."
  }
];

const schema = {
  "@type": "TaxiService",
  "@id": "https://kalidasstravels.in/services/outstation-cabs/#service",
  "name": title,
  "description": description,
  "url": "https://kalidasstravels.in/services/outstation-cabs/",
  "image": "https://kalidasstravels.in/images/temple/mahabalipuram-ecr-temples.webp",
  "providerMobility": "dynamic",
  "serviceType": "Outstation Cabs & Taxi Services",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Puducherry" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Outstation Cab Packages from Chennai",
    "itemListElement": packageTariff.map((pkg, idx) => ({
      "@type": "Offer",
      "position": idx + 1,
      "name": pkg.name,
      "description": `${pkg.duration} - ${pkg.route}`,
      "priceCurrency": "INR",
      "price": pkg.rates?.[0]?.price ? pkg.rates[0].price.replace(/[^0-9]/g, '') : "2500",
      "availability": "https://schema.org/InStock",
      "url": pkg.slug ? `https://kalidasstravels.in/services/${pkg.slug}/` : "https://kalidasstravels.in/services/outstation-cabs/",
      "image": `https://kalidasstravels.in${pkg.image}`,
      "seller": {
        "@id": "https://kalidasstravels.in/#localbusiness"
      },
      "itemOffered": {
        "@type": "TaxiService",
        "name": pkg.name,
        "serviceType": "Outstation Cab Package"
      }
    }))
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/outstation-cabs/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
  image="/images/temple/mahabalipuram-ecr-temples.webp"
  ogImage="/og/outstation-cabs.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. HERO SECTION -->
      <section class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-3 font-heading">
          Chennai <span class="text-m3-primary">Outstation Taxi Rates</span> &amp; Weekend Getaways
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto leading-relaxed font-normal">
          Flat per-kilometer rates and transparent fixed packages to Pondicherry, Mahabalipuram, Bangalore, and all South India destinations with clean AC cars and experienced highway chauffeurs.
        </p>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Below Hero) -->
      <nav aria-label="Outstation Cabs Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5">
          <a href="#per-km-table" class="px-3.5 py-2 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container hover:bg-m3-primary hover:text-m3-on-primary transition-all shrink-0">
            Per-KM Rates
          </a>
          <a href="#fixed-packages" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            Fixed Packages
          </a>
          <a href="#how-it-works" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            How It Works
          </a>
          <a href="#safety-benchmark" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            Highway Safety
          </a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high transition-colors shrink-0">
            Outstation FAQs
          </a>
        </div>
      </nav>

      <!-- 2. ⚡ 3-STEP VISUAL WORKFLOW ILLUSTRATION -->
      <div id="how-it-works" class="scroll-mt-28">
        <ServiceExplainer3Step 
          title="How Our Outstation Cab Service Works"
          subtitle="Transparent distance billing and doorstep convenience in 3 simple steps"
          steps={explainerSteps}
        />
      </div>

      <!-- 3. UPFRONT TARIFF SECTION (STRAIGHT TO THE POINT) -->
      <section class="my-10 md:my-14 space-y-12">
        
        <!-- Table 1: Per-KM Outstation Rates -->
        <div id="per-km-table" class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-8 border border-m3-outline-variant shadow-m3-1 scroll-mt-28">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-m3-outline-variant/60 pb-4 mb-6">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container text-xs font-bold uppercase tracking-wider mb-2 border border-m3-primary/20">
                <span>Per-KM Tariff Card</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface font-heading">
                Outstation Taxi Rates <span class="text-m3-primary">(Per KM from Chennai)</span>
              </h2>
              <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">
                Transparent distance rates for round trips and one-way drops to any destination across South India.
              </p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-m3-on-surface bg-m3-surface-container-high border border-m3-outline-variant px-3 py-1 rounded-m3-full w-fit shrink-0">
              Min 250 km / Day
            </span>
          </div>

          <!-- Desktop Table (>= md) -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left text-sm font-sans border-collapse">
              <thead class="bg-m3-surface-container-high text-m3-on-surface text-xs font-bold uppercase tracking-wider border-b border-m3-outline-variant">
                <tr>
                  <th class="px-4 py-3.5">Vehicle Type</th>
                  <th class="px-4 py-3.5 text-center">Capacity</th>
                  <th class="px-4 py-3.5 text-center">Round Trip (₹/km)</th>
                  <th class="px-4 py-3.5 text-center">One Way (₹/km)</th>
                  <th class="px-4 py-3.5 text-center">Min KM / Day</th>
                  <th class="px-4 py-3.5 text-center">Driver Bata</th>
                  <th class="px-4 py-3.5 text-right">Instant Booking</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-m3-outline-variant/40">
                {perKmTariff.map((row, idx) => (
                  <tr class={idx % 2 === 0 ? "bg-m3-surface hover:bg-m3-surface-container transition-colors" : "bg-m3-surface-container-lowest hover:bg-m3-surface-container transition-colors"}>
                    <td class="px-4 py-4 font-bold text-m3-on-surface font-heading">
                      {row.vehicle}
                    </td>
                    <td class="px-4 py-4 text-center text-m3-on-surface-variant text-xs whitespace-nowrap">
                      {row.capacity}
                    </td>
                    <td class="px-4 py-4 text-center font-black text-m3-primary font-heading text-base">
                      {row.roundTrip}
                    </td>
                    <td class="px-4 py-4 text-center font-bold text-m3-on-surface">
                      {row.oneWay}
                    </td>
                    <td class="px-4 py-4 text-center text-m3-on-surface-variant text-xs">
                      {row.minKm}
                    </td>
                    <td class="px-4 py-4 text-center text-m3-on-surface-variant text-xs">
                      {row.bata}
                    </td>
                    <td class="px-4 py-4 text-right">
                      <WhatsAppButton
                        href={`https://wa.me/919092303060?text=${encodeURIComponent(row.whatsappMsg)}`}
                        size="sm"
                        text="Book"
                        ariaLabel={`Book ${row.vehicle} on WhatsApp`}
                      />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile Cards (< md) -->
          <div class="block md:hidden space-y-3">
            {perKmTariff.map((row) => (
              <div class="bg-m3-surface rounded-m3-xl p-4 border border-m3-outline-variant shadow-xs space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <div>
                    <h3 class="font-bold text-sm text-m3-on-surface font-heading">{row.vehicle}</h3>
                    <span class="text-micro text-m3-on-surface-variant font-medium">{row.capacity}</span>
                  </div>
                  <span class="text-sm font-black text-m3-primary font-heading">{row.roundTrip}</span>
                </div>

                <div class="grid grid-cols-2 gap-2 text-micro bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/50">
                  <div><span class="text-m3-on-surface-variant">One-Way:</span> <strong class="text-m3-on-surface">{row.oneWay}</strong></div>
                  <div><span class="text-m3-on-surface-variant">Driver Bata:</span> <strong class="text-m3-on-surface">{row.bata}</strong></div>
                  <div><span class="text-m3-on-surface-variant">Min Billing:</span> <strong class="text-m3-on-surface">{row.minKm}</strong></div>
                  <div><span class="text-m3-on-surface-variant">AC Comfort:</span> <strong class="text-m3-on-surface">100% On</strong></div>
                </div>

                <WhatsAppButton
                  href={`https://wa.me/919092303060?text=${encodeURIComponent(row.whatsappMsg)}`}
                  size="md"
                  fullWidth={true}
                  text={`Book ${row.vehicle.split('/')[0]}`}
                  ariaLabel={`Book ${row.vehicle} on WhatsApp`}
                />
              </div>
            ))}
          </div>

          <div class="mt-4 pt-3 border-t border-m3-outline-variant/60 text-micro text-m3-on-surface-variant space-y-1">
            <p>• <strong>Distance Rules:</strong> Outstation billing is based on a standard minimum of 250 km per calendar day (300 km for Tempo Traveller). Kilometer and time calculated garage to garage in Chennai.</p>
            <p>• <strong>Exclusions:</strong> FASTag highway toll booth fees, interstate permit taxes (if crossing state border), and parking fees are charged at actuals.</p>
          </div>
        </div>

        <!-- Table 2: Fixed Destination Packages (All-Inclusive) -->
        <div id="fixed-packages" class="bg-m3-surface-container-lowest rounded-m3-2xl p-5 sm:p-8 border border-m3-outline-variant shadow-m3-1 scroll-mt-28">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-m3-outline-variant/60 pb-4 mb-6">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
                <span>All-Inclusive Fixed Trips</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface font-heading">
                Popular Weekend Packages <span class="text-m3-primary">(Tolls &amp; Fuel Included)</span>
              </h2>
              <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1">
                Fixed, worry-free pricing with door-to-door cab, highway tolls, driver allowance, and sightseeing halts included.
              </p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-m3-primary bg-m3-primary-container px-3 py-1 rounded-m3-full w-fit shrink-0 border border-m3-primary/20">
              Zero Hidden Charges
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {packageTariff.map((pkg) => {
              const leafUrl = pkg.slug ? `/services/${pkg.slug}/` : undefined;
              return (
                <div class="bg-m3-surface rounded-m3-2xl border border-m3-outline-variant shadow-xs flex flex-col justify-between hover:shadow-m3-2 hover:border-m3-primary/30 transition-all overflow-hidden group">
                  <div>
                    <!-- Media Image Header with Badges & Leaf Link -->
                    <a href={leafUrl} class="block h-48 sm:h-52 overflow-hidden relative bg-m3-surface-container-high cursor-pointer group/img" aria-label={`View ${pkg.name} Itinerary`}>
                      <OptimizedImage
                        src={pkg.image}
                        alt={pkg.name}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 relative z-10"
                        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent z-10"></div>

                      <!-- Top USP Badge -->
                      <span class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-m3-full shadow-xs z-20">
                        {pkg.badge}
                      </span>

                      <!-- Duration Chip -->
                      <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-md text-slate-900 text-xs font-semibold px-2.5 py-1 rounded-m3-full shadow-xs z-20">
                        <svg class="w-3.5 h-3.5 text-m3-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>{pkg.duration}</span>
                      </span>
                    </a>

                    <!-- Card Body -->
                    <div class="p-5 sm:p-6">
                      <a href={leafUrl} class="block group/title">
                        <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading mb-1.5 group-hover/title:text-m3-primary transition-colors">
                          {pkg.name}
                        </h3>
                      </a>
                      <p class="text-xs text-m3-on-surface-variant mb-4 leading-relaxed">
                        {pkg.route}
                      </p>

                      <!-- Vehicle Price Slabs -->
                      <div class="space-y-1.5 mb-5 bg-m3-surface-container-low p-3.5 rounded-m3-xl border border-m3-outline-variant/60">
                        {pkg.rates.map((r) => (
                          <div class="flex items-center justify-between text-xs py-1 border-b border-m3-outline-variant/30 last:border-0">
                            <span class="text-m3-on-surface-variant font-medium">{r.car}</span>
                            <strong class="text-m3-primary font-heading font-black text-sm">{r.price}</strong>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>

                  <!-- Card Action Footer -->
                  <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-0 flex items-center gap-2">
                    {leafUrl && (
                      <a
                        href={leafUrl}
                        class="flex-1 inline-flex items-center justify-center gap-1 px-4 py-2.5 rounded-m3-full bg-m3-primary hover:bg-m3-primary/90 text-m3-on-primary text-xs font-bold transition-all shadow-m3-1"
                      >
                        <span>View Itinerary</span>
                        <ChevronRight className="w-4 h-4" />
                      </a>
                    )}
