---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/SEO/Breadcrumbs.astro';
import ServiceExplainer3Step from '../../components/ServiceExplainer3Step.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import AndroidPhoneIcon from '../../components/AndroidPhoneIcon.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { 
  Sparkles, 
  Users, 
  CheckCircle2, 
  Info, 
  Calculator 
} from 'lucide-react';
import QuotationEngine from '../../components/QuotationEngine.jsx';

const title = "Outstation Cabs from Chennai | Kalidass Travels";
const description = "Book AC cabs from Chennai for round-trip & one-way outstation travel. Flat ₹14/km rates for Sedans, Ertiga, Innova & Tempo Travellers. Zero surge pricing.";
const keywords = "outstation cabs chennai, outstation taxi from chennai, outstation cab booking chennai, per km taxi rate chennai, round trip cab chennai, one way drop taxi chennai";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services/" },
  { name: "Outstation Cabs", item: "/services/outstation-cabs/" },
];

const explainerSteps = [
  {
    stepNumber: "1",
    badge: "Step 1: Choose Ride",
    title: "Pick Your Vehicle",
    desc: "Select from clean AC Sedans (Dzire/Etios), spacious Ertigas, luxury Innova Crystas, or 12–17 seat Tempo Travellers.",
    illustrationTitle: "Choose Your Fleet",
    illustrationSub: "Sedan • SUV • Crysta • Tempo",
    theme: "amber" as const,
    iconType: "car" as const
  },
  {
    stepNumber: "2",
    badge: "Step 2: Doorstep Pickup",
    title: "Driver Arrives on Time",
    desc: "Punctual reporting at your home, hotel, or Chennai Airport with clean sanitized interior and polite highway chauffeur.",
    illustrationTitle: "Doorstep Pickup in Chennai",
    illustrationSub: "Home, Hotel, or Airport",
    theme: "blue" as const,
    iconType: "pickup" as const
  },
  {
    stepNumber: "3",
    badge: "Step 3: Safe Highway Tour",
    title: "Transparent & Safe Travel",
    desc: "Disciplined 80–90 km/h cruising with flexible refreshment stops. Pay transparent per-km rates with zero hidden charges.",
    illustrationTitle: "Smooth Highway Journey",
    illustrationSub: "Transparent Distance Billing",
    theme: "emerald" as const,
    iconType: "road" as const
  }
];

const perKmTariff = [
  {
    vehicle: "Swift Dzire / Toyota Etios",
    shortName: "Swift Dzire",
    badge: "Best Value Sedan",
    image: "/images/fleet/swift-dzire.webp",
    capacity: "4 Pax + 2 Bags",
    roundTrip: "₹14 / km",
    oneWay: "₹16 / km",
    minKm: "250 km / day",
    bata: "₹400 / day",
    highlights: "Clean AC Sedan • Ample Boot Space • Ideal for 3–4 Pax",
    whatsappMsg: `*Kalidass Travels - Outstation Cab Enquiry*
• Vehicle: Sedan (Swift Dzire / Etios) - ₹14/km
• Destination / Route: 
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Trip Type: [Round Trip / One-Way Drop]
• Number of Passengers: 

Please share total fare quotation and availability.`
  },
  {
    vehicle: "Maruti Ertiga / XL6",
    shortName: "Maruti Ertiga",
    badge: "Family Favorite",
    image: "/images/fleet/suv.webp",
    capacity: "6 Pax + 3 Bags",
    roundTrip: "₹17 / km",
    oneWay: "₹19 / km",
    minKm: "250 km / day",
    bata: "₹500 / day",
    highlights: "Comfortable 6-Seater MUV • Dual AC • Family Road Trips",
    whatsappMsg: `*Kalidass Travels - Outstation Cab Enquiry*
• Vehicle: Maruti Ertiga / XL6 (6 Pax) - ₹17/km
• Destination / Route: 
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Trip Type: [Round Trip / One-Way Drop]
• Number of Passengers: 

Please share total fare quotation and availability.`
  },
  {
    vehicle: "Toyota Innova",
    shortName: "Toyota Innova",
    badge: "Comfort MUV",
    image: "/images/fleet/suv.webp",
    capacity: "7 Pax + 4 Bags",
    roundTrip: "₹20 / km",
    oneWay: "₹22 / km",
    minKm: "250 km / day",
    bata: "₹600 / day",
    highlights: "Spacious 7-Seater • Legendary Highway Reliability & Ride Comfort",
    whatsappMsg: `*Kalidass Travels - Outstation Cab Enquiry*
• Vehicle: Toyota Innova (7 Pax) - ₹20/km
• Destination / Route: 
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Trip Type: [Round Trip / One-Way Drop]
• Number of Passengers: 

Please share total fare quotation and availability.`
  },
  {
    vehicle: "Toyota Innova Crysta",
    shortName: "Innova Crysta",
    badge: "Executive Luxury",
    image: "/images/fleet/suv.webp",
    capacity: "7 Pax + 5 Bags",
    roundTrip: "₹22 / km",
    oneWay: "₹25 / km",
    minKm: "250 km / day",
    bata: "₹700 / day",
    highlights: "Executive MPV • Plush Captain Seats • VIP Highway Cruising",
    whatsappMsg: `*Kalidass Travels - Outstation Cab Enquiry*
• Vehicle: Toyota Innova Crysta - ₹22/km
• Destination / Route: 
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Trip Type: [Round Trip / One-Way Drop]
• Number of Passengers: 

Please share total fare quotation and availability.`
  },
  {
    vehicle: "Tempo Traveller (12 / 17 Seater)",
    shortName: "Tempo Traveller",
    badge: "Group Coach",
    image: "/images/fleet/tempo.webp",
    capacity: "12–17 Pax + Bags",
    roundTrip: "₹26 / km",
    oneWay: "₹29 / km",
    minKm: "300 km / day",
    bata: "₹800 / day",
    highlights: "Spacious Group Coach • Pushback Seats • High Roof & Huge Luggage Space",
    whatsappMsg: `*Kalidass Travels - Group Outstation Enquiry*
• Vehicle: Tempo Traveller (12-17 Pax) - ₹26/km
• Destination / Route: 
• Travel Date: 
• Pickup Time: 
• Pickup Area (Chennai): 
• Trip Type: [Round Trip / One-Way Drop]
• Number of Passengers: 

Please share total fare quotation and availability.`
  }
];

const faqs = [
  {
    q: "How is outstation distance and billing calculated?",
    a: "Outstation round-trips follow a standard minimum of 250 km per calendar day (300 km for Tempo Traveller). Kilometers are calculated garage-to-garage from Chennai. If you travel 210 km, the minimum 250 km applies; if you travel 330 km, you pay for the exact 330 km."
  },
  {
    q: "Are tolls, parking, and driver bata included in the per-km rate?",
    a: "Our per-km rate includes the vehicle, clean AC, and fuel. Driver bata is charged per calendar day as indicated in the tariff card. FASTag highway tolls, parking fees, and interstate permit taxes (if crossing state borders into Karnataka, Andhra Pradesh, or Puducherry) are billed at actuals with zero markup."
  },
  {
    q: "Can we make spontaneous sightseeing or cafe stops on the way?",
    a: "Yes! Our drivers are courteous and flexible. You can request breakfast halts on the highway, scenic photo stops along the East Coast Road, or temple darshan detours at your convenience."
  },
  {
    q: "Do you provide one-way drop outstation taxi service?",
    a: "Yes! We provide one-way drop taxis from Chennai to Bangalore, Pondicherry, Tirupati, Vellore, Trichy, and Madurai with fixed drop pricing."
  }
];

const schema = {
  "@type": "TaxiService",
  "@id": "https://kalidasstravels.in/services/outstation-cabs/#service",
  "name": title,
  "description": description,
  "url": "https://kalidasstravels.in/services/outstation-cabs/",
  "image": "https://kalidasstravels.in/images/temple/mahabalipuram-ecr-temples.webp",
  "serviceType": "Outstation Cabs & Taxi Services",
  "provider": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Puducherry" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Outstation Cab Rates from Chennai",
    "itemListElement": perKmTariff.map((tier, idx) => ({
      "@type": "Offer",
      "position": idx + 1,
      "name": `${tier.vehicle} Outstation Taxi`,
      "description": `Outstation round trip: ${tier.roundTrip}, one way: ${tier.oneWay}. Capacity: ${tier.capacity}`,
      "priceCurrency": "INR",
      "price": tier.roundTrip.replace(/[^0-9]/g, ''),
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": tier.roundTrip.replace(/[^0-9]/g, ''),
        "priceCurrency": "INR",
        "unitText": "KM"
      },
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock",
      "url": "https://kalidasstravels.in/services/outstation-cabs/",
      "seller": {
        "@id": "https://kalidasstravels.in/#localbusiness"
      },
      "itemOffered": {
        "@type": "TaxiService",
        "name": `${tier.vehicle} Outstation Cab`,
        "serviceType": "Outstation Taxi",
        "image": `https://kalidasstravels.in${tier.image}`
      }
    }))
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1250",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/services/outstation-cabs/#faq",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
  image="/images/temple/mahabalipuram-ecr-temples.webp"
  ogImage="/og/outstation-cabs.jpg"
  schema={[schema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface font-sans pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">

      <!-- 1. SIGNATURE HERO SECTION WITH HERO IMAGE -->
      <section class="group relative min-h-[220px] sm:min-h-[280px] md:min-h-[320px] rounded-m3-2xl overflow-hidden shadow-m3-2 border border-m3-outline-variant/60 bg-slate-950 flex flex-col justify-end p-5 sm:p-8 md:p-10 mb-8 transition-all duration-300">
        <!-- Background Hero Image -->
        <OptimizedImage
          src="/images/temple/mahabalipuram-ecr-temples.webp"
          alt="Chennai Outstation Cabs & Intercity Taxi Service - Kalidass Travels"
          class="absolute inset-0 w-full h-full object-cover object-[center_35%] transition-transform duration-700 group-hover:scale-105 opacity-85"
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 768px) 100vw, 1200px"
        />
        <!-- High-Contrast Scrim Gradient for 100% Text Legibility while keeping image vivid -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 via-50% to-slate-950/25 sm:bg-gradient-to-r sm:from-slate-950/95 sm:via-slate-950/70 sm:to-transparent"></div>

        <div class="relative z-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-blue-500/20 text-blue-300 border border-blue-500/30 text-xs font-bold uppercase tracking-wider mb-2.5 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
              <span>Intercity Highway Cabs</span>
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-2.5 font-heading drop-shadow-sm">
              Chennai <span class="text-blue-400">Outstation Taxi Rates</span> &amp; Intercity Cabs
            </h1>
            <p class="text-xs sm:text-sm md:text-base text-slate-200 leading-relaxed font-normal max-w-xl drop-shadow-xs">
              Flat per-kilometer rates for round trips and one-way drops to Bangalore, Pondicherry, <a href="/services/tirupati-package/" class="underline decoration-blue-400 hover:text-white font-medium" title="Chennai to Tirupati Cab Package">Chennai to Tirupati Cab</a>, Coimbatore, and all South India destinations with clean AC cars and experienced highway chauffeurs.
            </p>
          </div>
          <div class="hidden sm:flex flex-col items-start sm:items-end shrink-0 gap-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-m3-full bg-white/10 backdrop-blur-md text-white text-xs font-semibold border border-white/20 shadow-xs">
              ⚡ Starts ₹14 / km
            </span>
            <span class="text-xs text-slate-300 font-medium">
              Zero Surge Pricing · GPS Live Tracking
            </span>
          </div>
        </div>
      </section>

      <!-- STICKY QUICK-NAV JUMP BAR (Below Hero) -->
      <nav data-quick-nav aria-label="Outstation Cabs Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs font-semibold text-m3-on-surface whitespace-nowrap overflow-x-auto no-scrollbar py-0.5 pe-6 scroll-px-4">
          <a href="#how-it-works" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0">
            How It Works
          </a>
          <a href="#per-km-table" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Per-KM Rates
          </a>
          <a href="#fare-calculator" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Calculate Fare
          </a>
          <a href="#safety-benchmark" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Highway Safety
          </a>
          <a href="#faqs" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">
            Outstation FAQs
          </a>
        </div>
      </nav>

      <!-- 2. ⚡ 3-STEP VISUAL WORKFLOW ILLUSTRATION -->
      <div id="how-it-works" class="scroll-mt-40">
        <ServiceExplainer3Step 
          title="How Our Outstation Cab Service Works"
          subtitle="Transparent distance billing and doorstep convenience in 3 simple steps"
          steps={explainerSteps}
        />
      </div>

      <!-- 3. UPFRONT TARIFF SECTION (STRAIGHT TO THE POINT) -->
      <section class="my-10 md:my-14 space-y-12">
        
        <!-- Table 1: Per-KM Outstation Rates -->
        <div id="per-km-table" class="bg-m3-surface rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 overflow-hidden scroll-mt-40">
          <!-- Section Header Bar (Reference from tirupati-package) -->
          <div class="p-5 sm:p-7 bg-m3-surface-container-low border-b border-m3-outline-variant flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="max-w-xl">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-m3-on-surface text-xs font-bold uppercase tracking-wider mb-2 border border-m3-outline-variant">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Transparent Per-KM Tariff • Zero Surge Pricing</span>
              </div>
              <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
                Outstation Taxi Rates &amp; Cab Options <span class="text-m3-primary">(Per KM from Chennai)</span>
              </h2>
              <p class="text-xs sm:text-sm text-m3-on-surface-variant font-sans mt-1">
                Transparent distance rates for round trips and one-way drops to any South India destination with clean AC cars and verified highway chauffeurs.
              </p>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <!-- Desktop Cards vs Table Switcher -->
              <div class="hidden md:inline-flex items-center p-1 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant text-xs font-semibold select-none">
                <button
                  type="button"
                  id="tariff-btn-cards"
                  class="px-3.5 py-1.5 rounded-m3-full bg-m3-primary text-m3-on-primary shadow-xs transition-all cursor-pointer"
                  aria-pressed="true"
                >
                  Cards View
                </button>
                <button
                  type="button"
                  id="tariff-btn-table"
                  class="px-3.5 py-1.5 rounded-m3-full text-m3-on-surface-variant hover:text-m3-on-surface transition-all cursor-pointer"
                  aria-pressed="false"
                >
                  Table View
                </button>
              </div>


            </div>
          </div>

          <!-- M3 Vehicle Cards Grid (Default View, matching tirupati-package reference) -->
          <div id="tariff-cards-view" class="p-4 sm:p-6 bg-m3-surface-container-low">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              {perKmTariff.map((row, rIdx) => {
                const isOddLast = rIdx === perKmTariff.length - 1 && perKmTariff.length % 2 !== 0;
                return (
                  <div class={`bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between hover:shadow-m3-2 hover:border-m3-primary/40 transition-all overflow-hidden group ${isOddLast ? 'md:col-span-2' : ''}`}>
                    <div class="p-5 sm:p-6">
                      <!-- Top Badges Row -->
                      <div class="flex items-center justify-between gap-2 mb-3.5">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-m3-full bg-m3-primary/10 text-m3-primary text-[11px] font-bold tracking-wider uppercase border border-m3-primary/20">
                          <Sparkles className="w-3 h-3 text-m3-primary shrink-0" />
                          <span>{row.badge}</span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant/60 text-xs font-semibold text-m3-on-surface-variant">
                          <Users className="w-3.5 h-3.5 text-m3-secondary shrink-0" />
                          <span>{row.capacity}</span>
                        </span>
                      </div>

                      <!-- Vehicle Identity & Preview Row with CAR IMAGE -->
                      <div class="flex items-center justify-between gap-3 mb-4">
                        <div class="min-w-0 flex-1">
                          <h3 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading leading-snug group-hover:text-m3-primary transition-colors">
                            {row.vehicle}
                          </h3>
                          <p class="text-micro text-m3-on-surface-variant mt-0.5 font-medium">
                            Doorstep Pickup &amp; Return • Chilled Dual AC
                          </p>
                        </div>
                        <div class="shrink-0 w-20 h-12 sm:w-24 sm:h-14 flex items-center justify-end">
                          <img
                            src={row.image}
                            alt={row.vehicle}
                            width="112"
                            height="56"
                            decoding="async"
                            class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-xs"
                            loading="lazy"
                          />
                        </div>
                      </div>

                      <!-- M3 Tonal Surface Price Slabs -->
                      <div class="bg-m3-surface-container-low p-4 rounded-m3-xl border border-m3-outline-variant/60 mb-4 space-y-2.5">
                        <div class="flex items-baseline justify-between gap-2">
                          <span class="text-[11px] font-semibold text-m3-on-surface-variant uppercase tracking-wider">
                            Round-Trip Rate
                          </span>
                          <strong class="text-lg sm:text-xl font-bold text-m3-primary font-heading tracking-tight leading-none">
                            {row.roundTrip}
                          </strong>
                        </div>

                        <div class="pt-2 border-t border-m3-outline-variant/50 space-y-1.5">
                          <div class="flex items-center justify-between text-xs py-0.5">
                            <span class="text-m3-on-surface-variant font-medium">One-Way Drop Rate</span>
                            <strong class="font-bold text-m3-on-surface">{row.oneWay}</strong>
                          </div>
                          <div class="flex items-center justify-between text-xs py-0.5">
                            <span class="text-m3-on-surface-variant font-medium">Minimum Distance Billing</span>
                            <strong class="font-bold text-m3-on-surface">{row.minKm}</strong>
                          </div>
                          <div class="flex items-center justify-between text-xs py-0.5">
                            <span class="text-m3-on-surface-variant font-medium">Driver Bata (Allowance)</span>
                            <strong class="font-bold text-m3-on-surface">{row.bata}</strong>
                          </div>
                        </div>

                        <div class="pt-1.5 border-t border-m3-outline-variant/40 flex items-center gap-1.5 text-micro font-semibold text-emerald-800">
                          <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                          <span>Fuel &amp; Clean AC Included • Tolls &amp; Permits at Actuals</span>
                        </div>
                      </div>

                      <!-- Key Highlights -->
                      {row.highlights && (
                        <div class="flex items-start gap-2 text-xs text-m3-on-surface-variant leading-relaxed mb-1">
                          <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                          <span>{row.highlights}</span>
                        </div>
                      )}
                    </div>

                    <!-- Dual Action Buttons (Tonal Call & WhatsApp) -->
                    <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-1">
                      <div class="grid grid-cols-2 gap-2">
                        <a
                          href="tel:+918939539211"
                          aria-label={`Call to book ${row.vehicle} outstation cab`}
                          class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-m3-full bg-m3-surface-container hover:bg-blue-50 active:bg-blue-100 text-m3-on-surface hover:text-[#1A73E8] border border-m3-outline-variant hover:border-blue-300 text-xs font-bold transition-all select-none"
                        >
                          <AndroidPhoneIcon className="w-3.5 h-3.5 text-[#1A73E8] shrink-0" />
                          <span>Call Now</span>
                        </a>
                        <a
                          href={`https://wa.me/918939539211?text=${encodeURIComponent(row.whatsappMsg)}`}
                          target="_blank"
                          rel="noopener noreferrer nofollow"
                          aria-label={`Book ${row.vehicle} outstation cab on WhatsApp`}
                          class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-m3-full bg-emerald-50 hover:bg-emerald-100 active:bg-emerald-200 text-emerald-950 border border-emerald-300/80 text-xs font-bold transition-all select-none"
                        >
                          <WhatsAppIcon variant="brand" className="w-3.5 h-3.5 shrink-0" />
                          <span>Enquire</span>
                        </a>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Secondary Desktop Table View (Toggleable, with Car Images) -->
          <div id="tariff-table-view" class="hidden overflow-x-auto">
            <table class="w-full text-left text-sm font-sans border-collapse">
