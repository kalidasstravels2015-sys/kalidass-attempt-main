---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import serviceDetails from "../data/serviceDetails.json";
import siteContent from "../data/siteContent.json";
import { getAllDrivers } from "../data/driversData";

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "HTML Sitemap", item: "/sitemap/" },
];

const title = "Website Sitemap & Complete Service Directory | Kalidass Travels Chennai";
const description = "Comprehensive directory and HTML sitemap of Kalidass Travels Chennai. Explore all outstation routes, airport taxi transfers, temple tour packages, acting drivers, vehicle fleets, and verified chauffeurs.";
const canonicalURL = "https://kalidasstravels.in/sitemap/";

// Core Portals & Tools
const corePortals = [
  {
    title: "Home",
    url: "/",
    desc: "Primary portal for outstation cabs, airport transfers, temple tours, and verified acting drivers in Chennai.",
    tag: "Main Portal",
    badge: "24/7 Dispatch"
  },
  {
    title: "Official Tariff Card",
    url: "/tariff/",
    desc: "Transparent local hourly packages (5h/50km, 10h/100km) and per-km outstation tariffs for Sedans, SUVs, and Tempo Travellers.",
    tag: "Pricing Guide",
    badge: "Zero Surge"
  },
  {
    title: "Instant Fare Calculator",
    url: "/calculator/",
    desc: "Interactive fare estimation tool for outstation round-trips, one-way drops, local car rentals, and acting driver duties.",
    tag: "Interactive Tool",
    badge: "Instant Estimate"
  },
  {
    title: "Vehicle Fleet Catalog",
    url: "/fleet/",
    desc: "Detailed vehicle models, seating capacities, luggage specs, and AC configurations (Dzire, Etios, Ertiga, Innova Crysta, Force Urbania).",
    tag: "Vehicle Catalog",
    badge: "Clean AC Fleet"
  },
  {
    title: "Verified Drivers Directory",
    url: "/drivers/",
    desc: "Directory of 100% police-verified chauffeurs with hill-station certifications, languages spoken, and customer ratings.",
    tag: "Chauffeur Team",
    badge: "100% Police Verified"
  },
  {
    title: "All Mobility Services",
    url: "/services/",
    desc: "Complete catalog of corporate mobility, airport taxi, darshan pilgrimages, outstation tours, and personal chauffeur hire.",
    tag: "Services Directory",
    badge: "All Offerings"
  },
  {
    title: "Commercial Cab & Fleet Partner Attachment",
    url: "/attach-cab/",
    desc: "Partner portal for commercial taxi owners to attach yellow-board vehicles (Dzire, Ertiga, Innova, Tempo) via dedicated fleet desk (+91 90923 03060).",
    tag: "Partner Portal",
    badge: "Commercial Fleet Desk"
  },
];

// Core Service Hubs
const coreHubs = [
  {
    title: "Chennai Airport Taxi (MAA Transfers)",
    url: "/services/chennai-airport-taxi/",
    desc: "24/7 doorstep drop and terminal pickup with 5-10 min rapid dispatch, live flight delay tracking, and zero waiting fee.",
    tag: "Airport Taxi",
    badge: "From ₹650"
  },
  {
    title: "Outstation Cabs from Chennai",
    url: "/services/outstation-cabs/",
    desc: "Round-trip and one-way outstation cabs across Tamil Nadu, Pondicherry, Karnataka, and Andhra Pradesh from ₹14/km.",
    tag: "Highway Cab",
    badge: "From ₹14/km"
  },
  {
    title: "Tour Packages Hub",
    url: "/services/tours/",
    desc: "Curated South India road trips covering sacred temple circuits, UNESCO heritage monuments, and Western Ghats hill escapes.",
    tag: "Tour Hub",
    badge: "Curated Itineraries"
  },
  {
    title: "South India Temple Tours",
    url: "/services/tours/temple-tours/",
    desc: "Pilgrimage packages with satvik non-smoking chauffeurs, FASTag tolls pre-included on 1-day tours, and interstate permits pre-cleared.",
    tag: "Pilgrimage Hub",
    badge: "Satvik Chauffeurs"
  },
  {
    title: "Corporate Mobility & ETS",
    url: "/services/corporate/",
    desc: "24/7 routed employee commute transport, monthly executive car retainers, and GST-compliant invoicing for IT/manufacturing firms.",
    tag: "Corporate",
    badge: "100% GST Tax Credit"
  },
  {
    title: "Tempo Traveller Rental Chennai",
    url: "/services/tempo-traveller-rental-chennai/",
    desc: "12 to 26-Seater Tempo Travellers & Luxury Urbania for outstation family pilgrimages, joint tours, weddings, and corporate transit from ₹24/km.",
    tag: "Group Travel",
    badge: "From ₹24/km"
  },
  {
    title: "Acting Drivers in Chennai",
    url: "/services/acting-drivers/",
    desc: "Hire background-verified professional chauffeurs for your personal manual, automatic, EV, or luxury car (hourly or outstation).",
    tag: "Acting Drivers",
    badge: "From ₹600"
  },
];

// Categorized Services from serviceDetails.json
const templeServices = serviceDetails.filter(s => s.category === "Temple Tours");
const outstationServices = serviceDetails.filter(s => s.category === "Outstation Cabs" || s.category === "Popular Destinations");
const corridorHubServices = serviceDetails.filter(s => s.category === "Airport Transfers");
const corporateAndDriverServices = serviceDetails.filter(s => s.category.includes("Acting Driver") || s.category.includes("Corporate"));

function getServiceStartingPrice(s: any): string {
  const headers = s.tariff?.headers || [];
  const row = s.tariff?.rows?.[0] || [];
  const totalCostIdx = headers.findIndex((h: string) => /total cost|package cost|flat cost|fare/i.test(h));
  if (totalCostIdx !== -1 && row[totalCostIdx] && typeof row[totalCostIdx] === 'string' && row[totalCostIdx].includes('₹')) {
    return row[totalCostIdx];
  }
  const rateIdx = headers.findIndex((h: string) => /cost|rate|charges|fare/i.test(h));
  if (rateIdx !== -1 && row[rateIdx] && typeof row[rateIdx] === 'string' && row[rateIdx].includes('₹')) {
    return row[rateIdx];
  }
  const match = row.find((c: any) => typeof c === 'string' && /₹\s*[\d,]+/i.test(c));
  if (match) return match;
  return "Flat Tariff";
}

// Verified Chauffeurs
const driversList = getAllDrivers();

// Machine-Readable AI & Developer Resources
const machineEndpoints = [
  {
    title: "LLM Summary Context (llms.txt)",
    url: "/llms.txt",
    desc: "Authoritative machine-readable directory for LLMs (ChatGPT, Perplexity, Gemini, Claude) following the llmstxt.org standard.",
    badge: "llmstxt.org"
  },
  {
    title: "Comprehensive LLM Knowledge Base (llms-full.txt)",
    url: "/llms-full.txt",
    desc: "Complete uncompressed context repository with fleet specs, all service itineraries, tariffs, policies, and FAQs for AI agents.",
    badge: "Full RAG Context"
  },
  {
    title: "RFC AI Directory (.well-known/llms.txt)",
    url: "/.well-known/llms.txt",
    desc: "Standard .well-known location serving machine-readable service directory and grounding context for autonomous search engines.",
    badge: ".well-known"
  },
  {
    title: "AI Crawler Policy (ai.txt)",
    url: "/ai.txt",
    desc: "Spawning.ai AI/LLM crawler and retrieval augmentation permissions declaration welcoming foundational AI models.",
    badge: "AI Policy"
  },
  {
    title: "Search Engine Robots Policy (robots.txt)",
    url: "/robots.txt",
    desc: "Crawler directives explicitly granting full access to search engines, LLM spiders, and referencing XML sitemaps.",
    badge: "Crawler Config"
  },
  {
    title: "Primary XML Sitemap (sitemap.xml)",
    url: "/sitemap.xml",
    desc: "Standard XML sitemap index containing canonical URLs, lastmod dates, change frequencies, and crawl priorities.",
    badge: "Search Index"
  },
  {
    title: "XML Sitemap Index (sitemap-index.xml)",
    url: "/sitemap-index.xml",
    desc: "Multi-sitemap root index referencing all subordinate URL sets generated by Astro.",
    badge: "Sitemap Index"
  },
  {
    title: "XML URL Set (sitemap-0.xml)",
    url: "/sitemap-0.xml",
    desc: "Direct URL set listing all indexed website paths for rapid crawler consumption.",
    badge: "XML URLset"
  },
  {
    title: "Fleet Specifications API (api/fleet.json)",
    url: "/api/fleet.json",
    desc: "Machine-readable REST JSON endpoint returning vehicle models, luggage limits, seat capacities, and per-km tariffs.",
    badge: "REST JSON API"
  },
  {
    title: "Popular Routes API (api/routes.json)",
    url: "/api/routes.json",
    desc: "Machine-readable REST JSON endpoint listing all verified travel corridors and routes with starting package prices and direct WhatsApp booking URLs.",
    badge: "REST JSON API"
  },
  {
    title: "OpenAPI 3.1 Specification (openapi.json)",
    url: "/openapi.json",
    desc: "OpenAPI 3.1 machine specification allowing AI assistants and GPT plugins to discover callable travel booking actions.",
    badge: "OpenAPI 3.1"
  },
  {
    title: "Privacy Policy",
    url: "/privacy/",
    desc: "Data protection commitment, GPS telemetry confidentiality, and passenger privacy practices under Indian IT Law.",
    badge: "Compliance"
  },
  {
    title: "Terms & Conditions",
    url: "/terms/",
    desc: "Standard operating agreement, garage-to-garage km computation, permit guidelines, and cancellation terms.",
    badge: "Terms of Service"
  },
];

// Schema for Sitemap Directory
const sitemapDirectorySchema = {
  "@type": "ItemList",
  "@id": `${canonicalURL}#directory`,
  "name": "Kalidass Travels Complete Directory",
  "description": "Index of all web pages, services, tour packages, fleet categories, and machine-readable resources.",
  "numberOfItems": corePortals.length + coreHubs.length + serviceDetails.length + driversList.length + machineEndpoints.length
};
---

<Layout
  title={title}
  description={description}
  schema={sitemapDirectorySchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-m3-inverse-surface to-m3-primary text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-m3-outline-variant/60">
    <div class="max-w-6xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-m3-success/15 border border-m3-success/30 text-m3-success text-xs font-semibold mb-4 tracking-wide uppercase">
        <span class="inline-block w-2 h-2 rounded-full bg-m3-success"></span>
        <span>Directory &amp; Information Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        Website Sitemap &amp; Service Directory
      </h1>
      <p class="text-base sm:text-lg text-m3-inverse-on-surface max-w-3xl leading-relaxed mb-8">
        Direct architectural directory of all pages, outstation routes, airport transfer hubs, temple pilgrimage circuits, acting driver services, verified chauffeurs, and machine-readable AI context files for Kalidass Travels Chennai.
      </p>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-4xl pt-2">
        <div class="bg-m3-primary border border-m3-outline-variant/60 rounded-xl p-3.5 text-center">
          <div class="text-2xl font-bold text-white">{serviceDetails.length}</div>
          <div class="text-xs text-m3-on-surface-variant mt-0.5">Tour &amp; Transit Routes</div>
        </div>
        <div class="bg-m3-primary border border-m3-outline-variant/60 rounded-xl p-3.5 text-center">
          <div class="text-2xl font-bold text-white">18</div>
          <div class="text-xs text-m3-on-surface-variant mt-0.5">Verified Chauffeurs</div>
        </div>
        <div class="bg-m3-primary border border-m3-outline-variant/60 rounded-xl p-3.5 text-center">
          <div class="text-2xl font-bold text-white">7+</div>
          <div class="text-xs text-m3-on-surface-variant mt-0.5">Service Hubs</div>
        </div>
        <div class="bg-m3-primary border border-m3-outline-variant/60 rounded-xl p-3.5 text-center">
          <div class="text-2xl font-bold text-m3-success">100%</div>
          <div class="text-xs text-m3-on-surface-variant mt-0.5">Machine-Readable AI</div>
        </div>
      </div>

      <!-- Quick Jump Anchors -->
      <div class="mt-8 flex flex-wrap gap-2 text-xs">
        <a href="#core-portals" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Portals &amp; Tools</a>
        <a href="#service-hubs" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Service Hubs</a>
        <a href="#temple-tours" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Temple Pilgrimages</a>
        <a href="#outstation-routes" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Outstation Cab Routes</a>
        <a href="#corridor-hubs" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Corridors &amp; Local Hubs</a>
        <a href="#driver-corporate" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Acting Drivers &amp; Corporate</a>
        <a href="#chauffeur-directory" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">Chauffeurs</a>
        <a href="#ai-endpoints" class="px-3 py-1.5 rounded-lg bg-m3-primary hover:bg-m3-primary border border-m3-outline-variant/60 text-m3-on-primary transition-colors">AI &amp; Developer APIs</a>
      </div>
    </div>
  </section>

  <!-- Content Container -->
  <main class="bg-m3-surface text-m3-on-surface py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-16">

      <!-- Section 1: Core Portals & Booking Tools -->
      <section id="core-portals" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-m3-primary text-white flex items-center justify-center font-bold text-lg">1</div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface">Core Portals &amp; Booking Tools</h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant">Essential navigation portals, fare calculation engines, and fleet specifications.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {corePortals.map((item) => (
            <a
              href={item.url}
              class="group block p-5 bg-m3-surface-container-lowest border border-m3-outline-variant hover:border-m3-outline rounded-xl shadow-xs hover:shadow-md transition-all duration-200"
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-m3-surface-container text-m3-on-surface border border-m3-outline-variant">{item.tag}</span>
                <span class="text-xs font-medium text-m3-primary bg-m3-surface-container-low px-2 py-0.5 rounded-md border border-m3-outline-variant">{item.badge}</span>
              </div>
              <h3 class="text-base font-bold text-m3-on-surface group-hover:text-m3-on-surface flex items-center gap-1.5">
                <span>{item.title}</span>
                <span class="text-m3-on-surface-variant group-hover:translate-x-0.5 transition-transform text-xs">→</span>
              </h3>
              <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed">{item.desc}</p>
              <div class="mt-3 text-[11px] text-m3-on-surface-variant/80 break-all">{item.url}</div>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 2: Core Service Hubs -->
      <section id="service-hubs" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-m3-primary text-white flex items-center justify-center font-bold text-lg">2</div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface">Master Service Category Hubs</h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant">Comprehensive landing hubs for airport transits, outstation trips, pilgrimages, and chauffeur hire.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {coreHubs.map((item) => (
            <a
              href={item.url}
              class="group block p-5 bg-m3-surface-container-lowest border border-m3-outline-variant hover:border-m3-outline rounded-xl shadow-xs hover:shadow-md transition-all duration-200"
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-m3-surface-container text-m3-on-surface border border-m3-outline-variant">{item.tag}</span>
                <span class="text-xs font-bold text-m3-on-surface bg-m3-surface-container px-2 py-0.5 rounded-md">{item.badge}</span>
              </div>
              <h3 class="text-base font-bold text-m3-on-surface group-hover:text-m3-on-surface flex items-center gap-1.5">
                <span>{item.title}</span>
                <span class="text-m3-on-surface-variant group-hover:translate-x-0.5 transition-transform text-xs">→</span>
              </h3>
              <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed">{item.desc}</p>
              <div class="mt-3 text-[11px] text-m3-on-surface-variant/80 break-all">{item.url}</div>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 3: South India Temple Pilgrimages -->
      <section id="temple-tours" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-m3-primary text-white flex items-center justify-center font-bold text-lg">3</div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface">South India Temple Pilgrimages (All-Inclusive)</h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant">Sacred darshan yatras from Chennai with satvik non-smoking drivers, tolls, and interstate permits included.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {templeServices.map((service) => {
            const startPrice = getServiceStartingPrice(service);
            return (
              <a
                href={`/services/${service.slug}/`}
                class="group block p-5 bg-m3-surface-container-lowest border border-m3-outline-variant hover:border-m3-outline rounded-xl shadow-xs hover:shadow-md transition-all duration-200"
              >
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-medium text-m3-on-surface-variant">{service.duration}</span>
                  <span class="text-xs font-bold text-m3-on-surface bg-m3-tertiary-container/40 text-m3-tertiary border border-m3-outline-variant px-2 py-0.5 rounded-md">From {startPrice}</span>
                </div>
                <h3 class="text-base font-bold text-m3-on-surface group-hover:text-m3-on-surface flex items-center gap-1.5">
                  <span>{service.title}</span>
                  <span class="text-m3-on-surface-variant group-hover:translate-x-0.5 transition-transform text-xs">→</span>
                </h3>
                <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed line-clamp-2">{service.overview}</p>
                <div class="mt-3 text-[11px] text-m3-on-surface-variant/80">https://kalidasstravels.in/services/{service.slug}/</div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- Section 4: Outstation Cab Routes & Long-Distance Travel -->
      <section id="outstation-routes" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-m3-primary text-white flex items-center justify-center font-bold text-lg">4</div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface">Outstation Cab Routes &amp; Long-Distance Travel</h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant">Per-km transparent tariffs for travel from Chennai to Pondicherry, Mahabalipuram, Bangalore, Yelagiri Hills, and Yercaud.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {outstationServices.map((service) => {
            const startPrice = getServiceStartingPrice(service);
            return (
              <a
                href={`/services/${service.slug}/`}
                class="group block p-5 bg-m3-surface-container-lowest border border-m3-outline-variant hover:border-m3-outline rounded-xl shadow-xs hover:shadow-md transition-all duration-200"
              >
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-medium text-m3-on-surface-variant">{service.duration}</span>
                  <span class="text-xs font-bold text-m3-on-surface bg-m3-primary-container/30 text-m3-primary border border-m3-primary/20 px-2 py-0.5 rounded-md">From {startPrice}</span>
                </div>
                <h3 class="text-base font-bold text-m3-on-surface group-hover:text-m3-on-surface flex items-center gap-1.5">
                  <span>{service.title}</span>
                  <span class="text-m3-on-surface-variant group-hover:translate-x-0.5 transition-transform text-xs">→</span>
                </h3>
                <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed line-clamp-2">{service.overview}</p>
                <div class="mt-3 text-[11px] text-m3-on-surface-variant/80">https://kalidasstravels.in/services/{service.slug}/</div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- Section 5: High-Intent Travel Corridors & Local Suburban Hubs -->
      <section id="corridor-hubs" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-m3-primary text-white flex items-center justify-center font-bold text-lg">5</div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface">High-Intent Corridors &amp; Suburban Hubs</h2>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant">Dedicated landing hubs for key highway routes, airport corridors, and neighborhood dispatch bases.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {corridorHubServices.map((service) => {
            const startPrice = getServiceStartingPrice(service);
            return (
              <a
                href={`/services/${service.slug}/`}
                class="group block p-5 bg-m3-surface-container-lowest border border-m3-outline-variant hover:border-m3-outline rounded-xl shadow-xs hover:shadow-md transition-all duration-200"
              >
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-medium text-m3-on-surface-variant">{service.duration}</span>
                  <span class="text-xs font-bold text-m3-on-surface bg-m3-surface-container-low text-m3-primary border border-m3-outline-variant px-2 py-0.5 rounded-md">From {startPrice}</span>
                </div>
                <h3 class="text-base font-bold text-m3-on-surface group-hover:text-m3-on-surface flex items-center gap-1.5">
                  <span>{service.title}</span>
                  <span class="text-m3-on-surface-variant group-hover:translate-x-0.5 transition-transform text-xs">→</span>
                </h3>
                <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed line-clamp-2">{service.overview}</p>
                <div class="mt-3 text-[11px] text-m3-on-surface-variant/80">https://kalidasstravels.in/services/{service.slug}/</div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- Section 6: Acting Drivers & Corporate Mobility -->
