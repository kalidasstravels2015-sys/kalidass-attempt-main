---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import {
  Handshake,
  Info,
  Car,
  UserCheck,
  MapPin,
  BadgeCheck,
  FileText,
  Camera,
  Send,
  CheckCircle2,
  ArrowLeft,
  AlertCircle,
  Wallet,
  HelpCircle
} from "lucide-react";

const site = "https://kalidasstravels.in";
const pageUrl = `${site}/attach-cab/`;

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Attach Car & Driver Registration", item: "/attach-cab/" },
];

// Single source of truth for FAQs (rendered visibly and marked up in Schema)
const faqItems = [
  {
    q: "Can I send my driving license or RC on WhatsApp?",
    a: "No. Do not send identity or vehicle documents on WhatsApp chat. All driver applications and document photos must be uploaded directly through this official registration form for secure verification by our dispatch team."
  },
  {
    q: "How quickly are trip settlements paid to attached drivers?",
    a: "Trip payments and driver allowances (batta) are settled promptly on the same day or within 24 hours of completing outstation duties. We maintain transparent per-km billing with zero hidden deductions."
  },
  {
    q: "Can I attach more than one car?",
    a: "Yes. Small fleet operators with 2 to 5+ commercial vehicles (Sedans, Ertiga, Innova Crysta, or Tempo Travellers) can attach their fleet under our corporate employee transport and South India tour dispatch network."
  },
  {
    q: "What types of duties are available for attached drivers?",
    a: "We provide regular round-trip outstation duties across Tamil Nadu, Pondicherry, Andhra Pradesh, and Karnataka, MAA Airport round-the-clock pickups/drops, and corporate shift transport contracts."
  },
  {
    q: "Is there any onboarding or registration fee to attach a cab?",
    a: "No. Registration and driver partner onboarding at Kalidass Travels is 100% free of charge (₹0). We never ask for upfront registration fees."
  }
];

// 1. WebPage & ContactPage Schema with strict @id linkage
const webPageSchema = {
  "@type": ["WebPage", "ContactPage"],
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "name": "Attach Car & Driver Registration | Kalidass Travels Chennai",
  "description": "Official driver onboarding and commercial vehicle attachment portal for Kalidass Travels Medavakkam Hub. Attach taxis or join as outstation chauffeurs.",
  "isPartOf": { "@id": `${site}/#website` },
  "about": { "@id": `${site}/#localbusiness` },
  "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
  "inLanguage": "en-IN"
};

// 2. Service Schema for Commercial Taxi & Fleet Attachment
const serviceSchema = {
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  "name": "Commercial Taxi & Fleet Attachment Program",
  "serviceType": "Commercial Vehicle Attachment & Dispatch Service",
  "url": pageUrl,
  "provider": { "@id": `${site}/#localbusiness` },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Puducherry" }
  ],
  "description": "Attach commercial yellow-board sedans (Dzire, Etios), SUVs (Innova Crysta, Ertiga), and Tempo Travellers for outstation duties, airport transfers, and corporate employee transport with same-day settlements.",
  "offers": {
    "@type": "Offer",
    "name": "Driver & Fleet Partner Onboarding",
    "price": "0",
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": pageUrl
  },
  "audience": {
    "@type": "Audience",
    "audienceType": "Commercial Taxi Owners & Fleet Operators"
  }
};

// 3. FAQPage Schema derived strictly from visible page FAQs
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

// Flat schema array passed to Layout for unified @graph integration (JobPosting excluded to isolate driver inquiries)
const pageSchemas = [webPageSchema, serviceSchema, faqSchema];
---

<Layout
  title="Commercial Cab & Fleet Attachment | Kalidass Travels Chennai"
  description="Official commercial vehicle attachment portal for taxi owners and fleet operators. Attach Swift Dzire, Innova Crysta, Ertiga, or Tempo Traveller with Kalidass Travels Medavakkam Hub."
  keywords="attach taxi chennai, attach car travels chennai, cab attachment kalidass travels, fleet attachment chennai, commercial vehicle attachment medavakkam"
  schema={pageSchemas}
  showFloatingActions={false}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface-container-low min-h-screen text-m3-on-surface font-sans py-6 sm:py-10 px-4 sm:px-6">
    <div class="max-w-2xl mx-auto space-y-5">
      
      {/* Passenger Redirection Alert */}
      <div class="bg-amber-50 border border-amber-200 rounded-m3-xl p-3.5 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-amber-950">
        <div class="flex items-center gap-2">
          <span class="text-base shrink-0">🚖</span>
          <span><strong>Looking to book a cab for a trip?</strong> This portal is strictly for commercial car owners & driver partners.</span>
        </div>
        <a
          href="tel:+918939539211"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-m3-primary hover:bg-m3-primary/90 active:bg-m3-primary/80 text-m3-on-primary font-bold text-xs shrink-0 shadow-2xs transition-all"
        >
          <span>Book a Cab: +91 89395 39211</span>
        </a>
      </div>

      {/* Header Section */}
      <div class="text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface border border-m3-outline-variant/60 text-xs font-semibold text-m3-on-surface-variant shadow-2xs mb-2.5">
          <Handshake className="w-4 h-4 text-m3-primary shrink-0" />
          <span>Commercial Fleet & Partner Registration</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
          Commercial Cab &amp; Fleet Attachment
        </h1>
        <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5 max-w-lg mx-auto">
          Yellow-board sedans, SUVs &amp; Tempo Travellers · South India tours &amp; corporate transport · Same-day settlements
        </p>
        <p class="text-[11px] font-semibold text-m3-primary mt-2">
          Driver &amp; Fleet Helpdesk: <a href="tel:+919092303060" class="hover:underline">+91 90923 03060</a> (10:00 AM – 6:00 PM)
        </p>
      </div>

      {/* Notice Banner */}
      <div class="bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-4 shadow-2xs flex items-start gap-3">
        <Info className="w-5 h-5 text-m3-on-surface-variant shrink-0 mt-0.5" />
        <div class="text-xs sm:text-sm leading-relaxed">
          <span class="font-bold text-m3-on-surface block">
            Notice: Do NOT Send Documents on WhatsApp
          </span>
          <span class="text-m3-on-surface-variant mt-0.5 block">
            Please do not send identity cards or vehicle documents on personal WhatsApp. All applications must be submitted through this official form. Our onboarding team (+91 90923 03060) will review and call you directly.
          </span>
        </div>
      </div>

      {/* Flat Unified Form Container (No Nested Boxed Sub-Panels) */}
      <div class="bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-5 sm:p-7 shadow-m3-1" id="formWrapper">
        <form id="driverForm" class="space-y-6" novalidate>
          
          {/* 1. Category Switcher (M3 Tonal Toggle Bar) */}
          <div>
            <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
              Select Registration Type
            </label>
            <div class="grid grid-cols-2 rounded-m3-lg p-1 bg-m3-surface-container-low border border-m3-outline-variant/60" id="categoryToggle">
              <button
                type="button"
                data-category="Attach Car"
                class="category-btn active py-2.5 px-3 rounded-m3-md text-xs sm:text-sm font-bold text-center transition-all bg-m3-primary text-m3-on-primary shadow-2xs cursor-pointer flex items-center justify-center gap-1.5"
              >
                <Car className="w-4 h-4 shrink-0" />
                <span>I Have Car(s)</span>
              </button>
              <button
                type="button"
                data-category="Driver Job Only"
                class="category-btn py-2.5 px-3 rounded-m3-md text-xs sm:text-sm font-bold text-center transition-all text-m3-on-surface-variant hover:text-m3-on-surface cursor-pointer flex items-center justify-center gap-1.5"
              >
                <UserCheck className="w-4 h-4 shrink-0" />
                <span>Driver Job Only</span>
              </button>
            </div>
            <input type="hidden" name="category" id="selectedCategory" value="Attach Car" />
          </div>

          {/* 2. Car Owner Section */}
          <div id="carOwnerSection" class="space-y-5 pt-1">
            
            {/* Number of Cars */}
            <div>
              <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
                Number of Vehicles
              </label>
              <div class="grid grid-cols-3 gap-2" id="carCountGroup">
                <button type="button" data-val="1 Car" class="car-count-btn active py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-m3-surface-container border-m3-primary text-m3-primary cursor-pointer">
                  1 Car
                </button>
                <button type="button" data-val="2 to 3 Cars" class="car-count-btn py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer">
                  2 to 3 Cars
                </button>
                <button type="button" data-val="4+ Cars (Fleet)" class="car-count-btn py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer">
                  4+ Cars (Fleet)
                </button>
              </div>
              <input type="hidden" name="carCount" id="selectedCarCount" value="1 Car" />
            </div>

            {/* Vehicle Models */}
            <div>
              <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
                Available Vehicle Models <span class="font-normal text-m3-on-surface-variant/70">(Tap all that apply)</span>
              </label>
              <div class="flex flex-wrap gap-2" id="carsGroup">
                <button type="button" data-car="Swift / Dzire" class="car-chip-btn active px-3 py-1.5 rounded-m3-full border text-xs font-semibold transition-all bg-m3-surface-container border-m3-primary text-m3-primary cursor-pointer">
                  Swift / Dzire
                </button>
                <button type="button" data-car="Innova / Crysta" class="car-chip-btn px-3 py-1.5 rounded-m3-full border text-xs font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer">
                  Innova / Crysta
                </button>
                <button type="button" data-car="Ertiga" class="car-chip-btn px-3 py-1.5 rounded-m3-full border text-xs font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer">
                  Ertiga
                </button>
                <button type="button" data-car="Tempo Traveller" class="car-chip-btn px-3 py-1.5 rounded-m3-full border text-xs font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer">
                  Tempo Traveller
                </button>
                <button type="button" data-car="Other Commercial Cab" class="car-chip-btn px-3 py-1.5 rounded-m3-full border text-xs font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer">
                  Other Model
                </button>
              </div>
              <input type="hidden" name="cars" id="selectedCars" value="Swift / Dzire" />
            </div>

            {/* Plate Type */}
            <div>
              <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
                Vehicle Permit Type
              </label>
              <div class="grid grid-cols-2 gap-2" id="plateTypeGroup">
                <button type="button" data-plate="Yellow Board (Commercial Taxi)" class="plate-btn active py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-m3-surface-container border-m3-primary text-m3-primary cursor-pointer text-center">
                  Yellow Board (Taxi)
                </button>
                <button type="button" data-plate="White Board" class="plate-btn py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer text-center">
                  White Board
                </button>
              </div>
              <input type="hidden" name="plateType" id="selectedPlateType" value="Yellow Board (Commercial Taxi)" />
            </div>

          </div>

          {/* 3. Driver Job Section */}
          <div id="driverJobSection" class="space-y-5 pt-1 hidden">
            
            {/* License Type */}
            <div>
              <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
                License Classification
              </label>
              <div class="grid grid-cols-3 gap-2" id="licenseGroup">
                <button type="button" data-lic="Car (LMV)" class="license-btn active py-2 px-2 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-m3-surface-container border-m3-primary text-m3-primary cursor-pointer text-center">
                  Car (LMV)
                </button>
                <button type="button" data-lic="Commercial Badge" class="license-btn py-2 px-2 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer text-center">
                  With Badge
                </button>
                <button type="button" data-lic="Heavy (HMV / Bus)" class="license-btn py-2 px-2 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer text-center">
                  Heavy (HMV)
                </button>
              </div>
              <input type="hidden" name="licenseType" id="selectedLicenseType" value="Car (LMV)" />
            </div>

            {/* Experience */}
            <div>
              <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
                Highway Driving Experience
              </label>
              <div class="grid grid-cols-3 gap-2" id="expGroup">
                <button type="button" data-exp="1 to 3 Years" class="exp-btn py-2 px-2 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer text-center">
                  1 - 3 Yrs
                </button>
                <button type="button" data-exp="3 to 5 Years" class="exp-btn active py-2 px-2 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-m3-surface-container border-m3-primary text-m3-primary cursor-pointer text-center">
                  3 - 5 Yrs
                </button>
                <button type="button" data-exp="5+ Years" class="exp-btn py-2 px-2 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer text-center">
                  5+ Yrs
                </button>
              </div>
              <input type="hidden" name="experience" id="selectedExperience" value="3 to 5 Years" />
            </div>

            {/* Preferred Duty */}
            <div>
              <label class="block text-xs font-bold text-m3-on-surface-variant mb-2">
                Preferred Duty Type
              </label>
              <div class="grid grid-cols-2 gap-2" id="dutyGroup">
                <button type="button" data-duty="Outstation Trips" class="duty-btn active py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-m3-surface-container border-m3-primary text-m3-primary cursor-pointer text-center">
                  Outstation Highway
                </button>
                <button type="button" data-duty="Monthly Salary" class="duty-btn py-2 px-3 rounded-m3-lg border text-xs sm:text-sm font-semibold transition-all bg-white border-m3-outline-variant text-m3-on-surface cursor-pointer text-center">
                  Monthly Chauffeur
                </button>
              </div>
              <input type="hidden" name="preferredDuty" id="selectedPreferredDuty" value="Outstation Trips" />
            </div>

          </div>

          {/* 4. Common Contact Fields */}
          <div class="space-y-4 pt-2 border-t border-m3-outline-variant/40">
            
            {/* Full Name */}
            <div>
              <label for="driverName" class="block text-xs font-bold text-m3-on-surface mb-1.5">
                Full Name *
              </label>
              <div class="relative flex items-center bg-white border border-m3-outline-variant hover:border-m3-outline rounded-m3-lg transition-colors focus-within:border-m3-primary focus-within:ring-2 focus-within:ring-m3-primary/20 shadow-2xs">
                <input
                  type="text"
                  id="driverName"
                  name="name"
                  required
                  placeholder="Enter full name"
                  class="w-full bg-transparent py-2.5 px-3.5 text-xs sm:text-sm font-medium text-m3-on-surface outline-none"
                />
              </div>
            </div>

            {/* Mobile Number */}
            <div>
              <label for="driverPhone" class="block text-xs font-bold text-m3-on-surface mb-1.5">
                Mobile Number *
              </label>
              <div class="relative flex items-center bg-white border border-m3-outline-variant hover:border-m3-outline rounded-m3-lg transition-colors focus-within:border-m3-primary focus-within:ring-2 focus-within:ring-m3-primary/20 shadow-2xs">
                <span class="pl-3.5 pr-1.5 text-xs sm:text-sm font-semibold text-m3-on-surface-variant select-none">
                  +91
                </span>
                <input
                  type="tel"
                  id="driverPhone"
                  name="phone"
                  required
                  inputmode="numeric"
                  pattern="[0-9]{10}"
                  maxlength="10"
                  placeholder="98401 23456"
                  class="w-full bg-transparent py-2.5 pr-3.5 text-xs sm:text-sm font-semibold tracking-wide text-m3-on-surface outline-none"
                />
              </div>
            </div>

            {/* City / Base Area (With Google Places Autocomplete) */}
            <div>
              <label for="driverCity" class="block text-xs font-bold text-m3-on-surface mb-1.5">
                City / Base Operating Area *
              </label>
              <div class="relative flex items-center bg-white border border-m3-outline-variant hover:border-m3-outline rounded-m3-lg transition-colors focus-within:border-m3-primary focus-within:ring-2 focus-within:ring-m3-primary/20 shadow-2xs">
                <MapPin className="w-4 h-4 text-m3-on-surface-variant ml-3.5 mr-1 shrink-0 pointer-events-none" />
                <input
                  type="text"
                  id="driverCity"
                  name="city"
                  required
                  placeholder="Type area name (e.g. Medavakkam, Chennai)..."
                  class="w-full bg-transparent py-2.5 px-2 text-xs sm:text-sm font-medium text-m3-on-surface outline-none"
                />
              </div>

              {/* Quick Select Chips */}
              <div class="flex flex-wrap items-center gap-1.5 mt-2">
                <span class="text-[11px] text-m3-on-surface-variant">Common hubs:</span>
                <button type="button" class="city-quick-chip text-[11px] font-medium px-2 py-0.5 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant/60 text-m3-on-surface hover:border-m3-primary transition-all cursor-pointer" data-city="Medavakkam, Chennai">
                  Medavakkam
                </button>
                <button type="button" class="city-quick-chip text-[11px] font-medium px-2 py-0.5 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant/60 text-m3-on-surface hover:border-m3-primary transition-all cursor-pointer" data-city="Tambaram, Chennai">
                  Tambaram
                </button>
                <button type="button" class="city-quick-chip text-[11px] font-medium px-2 py-0.5 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant/60 text-m3-on-surface hover:border-m3-primary transition-all cursor-pointer" data-city="Kanchipuram, Tamil Nadu">
                  Kanchipuram
                </button>
                <button type="button" class="city-quick-chip text-[11px] font-medium px-2 py-0.5 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant/60 text-m3-on-surface hover:border-m3-primary transition-all cursor-pointer" data-city="Chennai Airport, Meenambakkam">
                  Airport
                </button>
              </div>
            </div>

          </div>

          {/* 5. Document Photos (Direct Mobile Uploads) */}
          <div class="space-y-3 pt-2 border-t border-m3-outline-variant/40">
            <div>
              <label class="block text-xs font-bold text-m3-on-surface">
                Document Photos (Upload on Form Only)
              </label>
              <p class="text-[11px] text-m3-on-surface-variant mt-0.5">
                Capture photo using your phone camera or select from storage.
              </p>
            </div>

            {/* DL Photo */}
            <div class="flex items-center justify-between p-3 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60 gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <BadgeCheck className="w-5 h-5 text-m3-on-surface-variant shrink-0" />
                <div class="truncate">
                  <div class="text-xs font-bold text-m3-on-surface">Driving License (Front)</div>
                  <div class="text-[10px] text-m3-on-surface-variant" id="dlFileStatus">No file chosen</div>
                </div>
              </div>
              <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-md bg-white border border-m3-outline-variant text-xs font-semibold text-m3-on-surface hover:bg-m3-surface-container shadow-2xs transition-all shrink-0">
                <Camera className="w-3.5 h-3.5 shrink-0" />
                <span>Select Photo</span>
                <input type="file" id="dlFileInput" accept="image/*" capture="environment" class="hidden" />
              </label>
            </div>

            {/* RC Photo (Car Owners Only) */}
            <div id="rcDocBox" class="flex items-center justify-between p-3 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60 gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <FileText className="w-5 h-5 text-m3-on-surface-variant shrink-0" />
                <div class="truncate">
                  <div class="text-xs font-bold text-m3-on-surface">Vehicle RC Book Photo</div>
                  <div class="text-[10px] text-m3-on-surface-variant" id="rcFileStatus">No file chosen</div>
                </div>
              </div>
              <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-md bg-white border border-m3-outline-variant text-xs font-semibold text-m3-on-surface hover:bg-m3-surface-container shadow-2xs transition-all shrink-0">
                <Camera className="w-3.5 h-3.5 shrink-0" />
                <span>Select Photo</span>
                <input type="file" id="rcFileInput" accept="image/*" capture="environment" class="hidden" />
              </label>
            </div>
          </div>

          {/* Validation Error Message */}
          <div id="errorAlert" class="hidden p-3 rounded-m3-md bg-m3-error-container text-m3-on-error-container text-xs font-semibold flex items-center gap-2">
            <AlertCircle className="w-4 h-4 shrink-0" />
            <span id="errorMessage">Please complete all required fields.</span>
          </div>

          {/* Action Row - Strict Ban on w-full Buttons (Rule 3 in standardized-whatsapp-button.md) */}
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
            <button
              type="submit"
              id="submitBtn"
              class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-m3-full bg-m3-primary text-m3-on-primary font-bold text-sm shadow-m3-1 hover:shadow-m3-2 transition-all cursor-pointer select-none"
            >
              <Send className="w-4 h-4 shrink-0" />
              <span>Submit Registration</span>
            </button>
          </div>

          <div class="text-center text-[11px] text-m3-on-surface-variant">
            Registration is free of charge. Fleet &amp; Driver Partner Desk: <a href="tel:+919092303060" class="font-bold text-m3-primary hover:underline">+91 90923 03060</a>.
          </div>

        </form>
      </div>

      {/* Success Confirmation Card */}
      <div id="successCard" class="hidden bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-6 sm:p-8 shadow-m3-1 text-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-m3-surface-container text-m3-primary mx-auto flex items-center justify-center">
          <CheckCircle2 className="w-6 h-6" />
        </div>
        
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-m3-on-surface font-heading">
            Application Received Successfully
          </h2>
          <div class="text-xs text-m3-on-surface-variant font-mono mt-1 font-bold" id="confLeadId">
            Ref ID: #KT-DRV-101
          </div>
        </div>

        {/* Summary Table */}
        <div class="bg-m3-surface-container-low rounded-m3-lg p-3.5 text-left text-xs space-y-1.5 border border-m3-outline-variant/60 max-w-md mx-auto">
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Name:</span>
            <span class="font-bold text-m3-on-surface" id="confName">-</span>
          </div>
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Mobile Number:</span>
            <span class="font-bold text-m3-on-surface" id="confPhone">-</span>
          </div>
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Category:</span>
            <span class="font-bold text-m3-on-surface" id="confCategory">-</span>
          </div>
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Details:</span>
            <span class="font-bold text-m3-on-surface" id="confDetails">-</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-m3-on-surface-variant">Operating Base:</span>
            <span class="font-bold text-m3-on-surface" id="confCity">-</span>
          </div>
        </div>

        <p class="text-xs text-m3-on-surface-variant max-w-sm mx-auto">
          Our dispatch coordinator will review your submission and call your mobile number directly. Please do not send documents on WhatsApp.
        </p>

        <div class="pt-2">
          <button
            type="button"
            id="resetFormBtn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-m3-primary hover:underline cursor-pointer"
          >
            <ArrowLeft className="w-3.5 h-3.5 shrink-0" />
            <span>Register another vehicle or driver</span>
          </button>
        </div>
      </div>

      {/* Driver Partner & Fleet Attachment Program Highlights (Satisfies JobPosting & Service visible content) */}
      <div class="bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-5 sm:p-6 shadow-2xs space-y-4">
        <h2 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading flex items-center gap-2">
          <Wallet className="w-5 h-5 text-m3-primary shrink-0" />
          <span>Driver Partner Benefits & Tariffs</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
          <div class="p-3.5 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60">
            <div class="font-bold text-m3-on-surface mb-1">💰 Monthly Earnings</div>
            <div class="text-m3-on-surface-variant leading-relaxed">
              <strong>₹25,000 – ₹45,000 / month</strong> based on outstation round-trips & corporate duty volume. Same-day settlement with zero hidden cuts.
            </div>
          </div>
          <div class="p-3.5 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60">
            <div class="font-bold text-m3-on-surface mb-1">🍛 Driver Batta & Allowances</div>
            <div class="text-m3-on-surface-variant leading-relaxed">
              Daily food allowance and night stay batta included on all outstation duties. Driver rest and welfare guaranteed.
            </div>
          </div>
          <div class="p-3.5 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60">
            <div class="font-bold text-m3-on-surface mb-1">🚖 Attached Vehicles Eligible</div>
            <div class="text-m3-on-surface-variant leading-relaxed">
              Commercial yellow-board Dzire, Etios, Ertiga, Innova Crysta, and 12–26 seater Tempo Travellers.
            </div>
          </div>
          <div class="p-3.5 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60">
            <div class="font-bold text-m3-on-surface mb-1">📍 Central Dispatch Hub</div>
            <div class="text-m3-on-surface-variant leading-relaxed">
              Kalidass Travels Medavakkam Hub (No. 4/220, E88, Ponniamman Kovil Street, Chennai 600100). Zero registration fee.
            </div>
          </div>
        </div>
      </div>

      {/* Frequently Asked Questions Section (Visibly rendered for FAQPage Schema compliance) */}
      <section class="space-y-3 pt-2">
        <div class="text-center sm:text-left">
          <h2 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading flex items-center justify-center sm:justify-start gap-2">
            <HelpCircle className="w-5 h-5 text-m3-primary shrink-0" />
            <span>Frequently Asked Questions</span>
          </h2>
          <p class="text-xs text-m3-on-surface-variant mt-0.5">
            Key details for driver partners and commercial car owners attaching to Kalidass Travels.
          </p>
        </div>
        <FAQAccordion items={faqItems} />
      </section>

    </div>
  </main>
</Layout>

<script>
  import { loadGoogleMaps } from '../lib/googleMapsLoader';
  import { getActiveGoogleSheetUrl } from '../config/googleSheets';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('driverForm') as HTMLFormElement;
    const formWrapper = document.getElementById('formWrapper') as HTMLElement;
    const successCard = document.getElementById('successCard') as HTMLElement;
    const errorAlert = document.getElementById('errorAlert') as HTMLElement;
    const errorMessage = document.getElementById('errorMessage') as HTMLElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const resetFormBtn = document.getElementById('resetFormBtn') as HTMLButtonElement;

    const carOwnerSection = document.getElementById('carOwnerSection') as HTMLElement;
    const driverJobSection = document.getElementById('driverJobSection') as HTMLElement;
    const rcDocBox = document.getElementById('rcDocBox') as HTMLElement;

    const selectedCategoryInput = document.getElementById('selectedCategory') as HTMLInputElement;
    const selectedCarCountInput = document.getElementById('selectedCarCount') as HTMLInputElement;
    const selectedCarsInput = document.getElementById('selectedCars') as HTMLInputElement;
    const selectedPlateTypeInput = document.getElementById('selectedPlateType') as HTMLInputElement;
    const selectedLicenseTypeInput = document.getElementById('selectedLicenseType') as HTMLInputElement;
    const selectedExperienceInput = document.getElementById('selectedExperience') as HTMLInputElement;
    const selectedPreferredDutyInput = document.getElementById('selectedPreferredDuty') as HTMLInputElement;

    const nameInput = document.getElementById('driverName') as HTMLInputElement;
    const phoneInput = document.getElementById('driverPhone') as HTMLInputElement;
    const cityInput = document.getElementById('driverCity') as HTMLInputElement;

    const dlFileInput = document.getElementById('dlFileInput') as HTMLInputElement;
    const dlFileStatus = document.getElementById('dlFileStatus') as HTMLElement;

    const rcFileInput = document.getElementById('rcFileInput') as HTMLInputElement;
    const rcFileStatus = document.getElementById('rcFileStatus') as HTMLElement;

    let hasDlFile = false;
    let hasRcFile = false;

    // 1. Category Switcher
    const categoryBtns = document.querySelectorAll('.category-btn');
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'Attach Car';
        selectedCategoryInput.value = cat;

        categoryBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-primary', 'text-m3-on-primary', 'shadow-2xs');
          b.classList.add('text-m3-on-surface-variant');
        });

        btn.classList.add('active', 'bg-m3-primary', 'text-m3-on-primary', 'shadow-2xs');
        btn.classList.remove('text-m3-on-surface-variant');

        if (cat === 'Attach Car') {
          carOwnerSection.classList.remove('hidden');
          driverJobSection.classList.add('hidden');
          rcDocBox.classList.remove('hidden');
        } else {
          carOwnerSection.classList.add('hidden');
          driverJobSection.classList.remove('hidden');
          rcDocBox.classList.add('hidden');
        }
      });
    });

    // 2. Car Count Switcher
    const carCountBtns = document.querySelectorAll('.car-count-btn');
    carCountBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val') || '1 Car';
        selectedCarCountInput.value = val;
        carCountBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
          b.classList.add('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
        });
        btn.classList.add('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
        btn.classList.remove('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
      });
    });

    // 3. Multi-Select Car Chips
    const carChipBtns = document.querySelectorAll('.car-chip-btn');
    const selectedCarsSet = new Set(['Swift / Dzire']);

    carChipBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const car = btn.getAttribute('data-car') || '';
        if (selectedCarsSet.has(car)) {
          if (selectedCarsSet.size > 1) {
            selectedCarsSet.delete(car);
            btn.classList.remove('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
            btn.classList.add('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
          }
        } else {
          selectedCarsSet.add(car);
          btn.classList.add('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
          btn.classList.remove('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
        }
        selectedCarsInput.value = Array.from(selectedCarsSet).join(', ');
      });
    });

    // 4. Plate Type Switcher
    const plateBtns = document.querySelectorAll('.plate-btn');
    plateBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const plate = btn.getAttribute('data-plate') || 'Yellow Board (Commercial Taxi)';
        selectedPlateTypeInput.value = plate;
        plateBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
          b.classList.add('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
        });
        btn.classList.add('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
        btn.classList.remove('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
      });
    });

    // 5. License Classification Switcher
    const licenseBtns = document.querySelectorAll('.license-btn');
    licenseBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lic = btn.getAttribute('data-lic') || 'Car (LMV)';
        selectedLicenseTypeInput.value = lic;
        licenseBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
          b.classList.add('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
        });
        btn.classList.add('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
        btn.classList.remove('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
      });
    });

    // 6. Experience Switcher
    const expBtns = document.querySelectorAll('.exp-btn');
    expBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const exp = btn.getAttribute('data-exp') || '3 to 5 Years';
        selectedExperienceInput.value = exp;
        expBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
          b.classList.add('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
        });
        btn.classList.add('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
        btn.classList.remove('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
      });
    });

    // 7. Duty Type Switcher
    const dutyBtns = document.querySelectorAll('.duty-btn');
    dutyBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const duty = btn.getAttribute('data-duty') || 'Outstation Trips';
        selectedPreferredDutyInput.value = duty;
        dutyBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
          b.classList.add('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
        });
        btn.classList.add('active', 'bg-m3-surface-container', 'border-m3-primary', 'text-m3-primary');
        btn.classList.remove('bg-white', 'border-m3-outline-variant', 'text-m3-on-surface');
      });
    });

    // 8. Quick City Chips
    const cityChips = document.querySelectorAll('.city-quick-chip');
    cityChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const c = chip.getAttribute('data-city') || '';
        cityInput.value = c;
        cityInput.focus();
      });
    });

    // 9. Google Places Autocomplete Integration
    let autocompleteInitialized = false;
    const initAutocomplete = () => {
      if (autocompleteInitialized || !cityInput) return;
      if (!(window as any).google || !(window as any).google.maps || !(window as any).google.maps.places) return;

      try {
        const options = {
          componentRestrictions: { country: 'in' },
          bounds: new (window as any).google.maps.LatLngBounds(
            new (window as any).google.maps.LatLng(12.7, 79.8),
            new (window as any).google.maps.LatLng(13.4, 80.4)
          ),
          fields: ['formatted_address', 'name'],
          strictBounds: false
        };
        const ac = new (window as any).google.maps.places.Autocomplete(cityInput, options);
        ac.addListener('place_changed', () => {
          const place = ac.getPlace();
          if (place && (place.formatted_address || place.name)) {
            cityInput.value = place.formatted_address || place.name;
          }
        });
        autocompleteInitialized = true;
      } catch (_) {}
    };

    cityInput.addEventListener('focus', () => {
      loadGoogleMaps().then(initAutocomplete).catch(() => {});
    });
    window.addEventListener('google-maps-loaded', initAutocomplete);

    // 10. File Input Listeners
    dlFileInput.addEventListener('change', () => {
      if (dlFileInput.files && dlFileInput.files[0]) {
        hasDlFile = true;
        dlFileStatus.textContent = dlFileInput.files[0].name;
      }
    });

    rcFileInput.addEventListener('change', () => {
      if (rcFileInput.files && rcFileInput.files[0]) {
        hasRcFile = true;
        rcFileStatus.textContent = rcFileInput.files[0].name;
      }
    });

    // 11. Form Submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');

      const name = nameInput.value.trim();
      const phone = phoneInput.value.replace(/\D/g, '');
      const city = cityInput.value.trim();
      const category = selectedCategoryInput.value;

      if (!name || name.length < 2) {
        showError('Please enter your full name.');
        nameInput.focus();
        return;
      }

      if (!phone || phone.length !== 10 || !/^[6-9]\d{9}$/.test(phone)) {
        showError('Please enter a valid 10-digit mobile number.');
        phoneInput.focus();
        return;
      }

      if (!city) {
        showError('Please select or enter your operating area.');
        cityInput.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
        <span>Submitting...</span>
      `;

      const leadPayload = {
        name,
        phone,
        category,
        carCount: selectedCarCountInput.value,
        cars: selectedCarsInput.value,
        plateType: selectedPlateTypeInput.value,
        licenseType: selectedLicenseTypeInput.value,
        experience: selectedExperienceInput.value,
        preferredDuty: selectedPreferredDutyInput.value,
        city,
        hasDlPhoto: hasDlFile,
        hasRcPhoto: hasRcFile,
        notes: category === 'Attach Car' 
          ? `Fleet: ${selectedCarCountInput.value} (${selectedCarsInput.value}) | Plate: ${selectedPlateTypeInput.value}`
          : `License: ${selectedLicenseTypeInput.value} | Exp: ${selectedExperienceInput.value} | Duty: ${selectedPreferredDutyInput.value}`
      };

      let leadId = `#KT-DRV-${Date.now().toString().slice(-4)}`;

      try {
        const res = await fetch('/api/record-driver-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(leadPayload)
        });
        if (res.ok) {
          const resData = await res.json();
          if (resData && resData.leadId) {
            leadId = resData.leadId;
          }
        }
      } catch (_) {}

      try {
        const sheetUrl = getActiveGoogleSheetUrl();
        if (sheetUrl && sheetUrl.startsWith('https://script.google.com/macros/s/')) {
          fetch(sheetUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({
              date: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }),
              tripType: `Driver Lead: ${category}`,
              name: leadPayload.name,
              phone: leadPayload.phone,
              pickup: leadPayload.city,
              drop: leadPayload.notes,
              notes: `DL Uploaded: ${hasDlFile ? 'YES' : 'NO'} | RC Uploaded: ${hasRcFile ? 'YES' : 'NO'}`,
              referenceId: leadId
            })
          }).catch(() => {});
        }
      } catch (_) {}

      (document.getElementById('confLeadId') as HTMLElement).textContent = `Ref ID: ${leadId}`;
      (document.getElementById('confName') as HTMLElement).textContent = name;
      (document.getElementById('confPhone') as HTMLElement).textContent = `+91 ${phone}`;
      (document.getElementById('confCategory') as HTMLElement).textContent = category;
      (document.getElementById('confCity') as HTMLElement).textContent = city;
      (document.getElementById('confDetails') as HTMLElement).textContent = category === 'Attach Car' 
        ? `${selectedCarCountInput.value} - ${selectedCarsInput.value}` 
        : `${selectedLicenseTypeInput.value} (${selectedExperienceInput.value})`;

      formWrapper.classList.add('hidden');
      successCard.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    function showError(msg: string) {
      errorAlert.classList.remove('hidden');
      errorMessage.textContent = msg;
    }

    resetFormBtn?.addEventListener('click', () => {
      form.reset();
      hasDlFile = false;
      hasRcFile = false;
      dlFileStatus.textContent = 'No file chosen';
      rcFileStatus.textContent = 'No file chosen';
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <span>Submit Registration</span>
      `;
      successCard.classList.add('hidden');
      formWrapper.classList.remove('hidden');
    });

  });
</script>
