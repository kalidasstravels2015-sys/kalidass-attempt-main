    function bindVehicleCardEvents() {
      // Single Car Model Dropdown change (auto-assigns category silently)
      vehicleCardsContainer.querySelectorAll('.veh-model-select').forEach((sel) => {
        sel.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          const idx = Number(target.getAttribute('data-model-select-idx'));
          const chosenModel = target.value || 'Swift Dzire';
          vehiclesState[idx].model = chosenModel;
          vehiclesState[idx].category = normalizeVehicleCategory(chosenModel);
          renderVehicleCards();
        });
      });

      // Plate Number live auto-formatting
      vehicleCardsContainer.querySelectorAll('.veh-plate-input').forEach((inp) => {
        inp.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const idx = Number(target.getAttribute('data-plate-idx'));
          const formatted = formatIndianPlateNumber(target.value);
          target.value = formatted;
          vehiclesState[idx].plate = formatted;
        });
      });

      // Board Type dropdown change
      vehicleCardsContainer.querySelectorAll('.veh-board-select').forEach((sel) => {
        sel.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          const idx = Number(target.getAttribute('data-board-select-idx'));
          vehiclesState[idx].boardType = target.value || 'Yellow Board';
        });
      });

      // Roof Carrier dropdown change
      vehicleCardsContainer.querySelectorAll('.veh-carrier-select').forEach((sel) => {
        sel.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          const idx = Number(target.getAttribute('data-carrier-select-idx'));
          vehiclesState[idx].carrier = target.value || 'With Carrier';
        });
      });

      // Remove Vehicle
      vehicleCardsContainer.querySelectorAll('.remove-veh-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-remove-idx'));
          if (vehiclesState.length > 1) {
            vehiclesState.splice(idx, 1);
            renderVehicleCards();
          }
        });
      });

      // RC File Upload per Vehicle
      vehicleCardsContainer.querySelectorAll('.veh-rc-input').forEach((inp) => {
        inp.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const idx = Number(target.getAttribute('data-rc-idx'));
          const statusEl = document.getElementById(`rcStatus-${idx}`);
          if (target.files && target.files[0]) {
            const file = target.files[0];
            if (statusEl) statusEl.textContent = `Compressing ${file.name}...`;
            vehiclesState[idx].rcFile = await processImageFile(file);
            renderVehicleCards();
          }
        });
      });

      // Car Front File Upload per Vehicle
      vehicleCardsContainer.querySelectorAll('.veh-car-input').forEach((inp) => {
        inp.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const idx = Number(target.getAttribute('data-car-idx'));
          const statusEl = document.getElementById(`carStatus-${idx}`);
          if (target.files && target.files[0]) {
            const file = target.files[0];
            if (statusEl) statusEl.textContent = `Compressing ${file.name}...`;
            vehiclesState[idx].carFile = await processImageFile(file);
            renderVehicleCards();
          }
        });
      });
    }

    // Add Another Vehicle button
    addVehicleBtn?.addEventListener('click', () => {
      if (vehiclesState.length >= 5) return;
      vehiclesState.push({
        id: `veh-${Date.now()}`,
        category: 'Sedan',
        model: 'Swift Dzire',
        plate: '',
        boardType: 'Yellow Board',
        carrier: 'With Carrier',
        rcFile: null,
        carFile: null
      });
      renderVehicleCards();
    });

    // Initial render of Vehicle #1
    renderVehicleCards();

    // 1. Category Switcher (Attach Vehicle(s) vs Acting Driver Only)
    const categoryBtns = document.querySelectorAll('.category-btn');
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'Attach Car';
        selectedCategoryInput.value = cat;

        categoryBtns.forEach((b) => {
          b.classList.remove('active', 'bg-m3-primary', 'text-m3-on-primary', 'shadow-2xs');
          b.classList.add('text-m3-on-surface-variant');
        });

        btn.classList.add('active', 'bg-m3-primary', 'text-m3-on-primary', 'shadow-2xs');
        btn.classList.remove('text-m3-on-surface-variant');

        if (cat === 'Attach Car') {
          carOwnerSection.classList.remove('hidden');
          driverJobSection.classList.add('hidden');
        } else {
          carOwnerSection.classList.add('hidden');
          driverJobSection.classList.remove('hidden');
        }
      });
    });

    // 2. Single Base Area Input (Auto-detects Chennai Zone silently in background)
    function setCanonicalLocality(areaName: string, zoneId: string) {
      selectedZoneInput.value = zoneId;
      cityInput.value = areaName;
      if (selectedLocalityBadge) {
        selectedLocalityBadge.textContent = `✓ ${areaName}`;
      }
    }

    localitySearchInput?.addEventListener('input', () => {
      const q = localitySearchInput.value.trim();
      if (!q) {
        localitySearchDropdown.classList.add('hidden');
        return;
      }
      const matches = matchChennaiLocality(q).slice(0, 8);
      if (matches.length === 0) {
        cityInput.value = q;
        localitySearchDropdown.classList.add('hidden');
        return;
      }

      // Immediately update silent canonical match from top result
      setCanonicalLocality(matches[0].name, matches[0].zoneId);

      localitySearchDropdown.innerHTML = matches
        .map(
          (loc) => `
          <button
            type="button"
            data-loc-name="${loc.name}"
            data-loc-zone="${loc.zoneId}"
            class="loc-match-item w-full text-left px-3.5 py-2.5 hover:bg-m3-surface-container-low flex items-center justify-between text-xs cursor-pointer"
          >
            <span class="font-bold text-m3-on-surface">${loc.name}</span>
            <span class="font-mono text-[11px] text-m3-primary font-semibold">${loc.pincode}</span>
          </button>
        `
        )
        .join('');

      localitySearchDropdown.classList.remove('hidden');

      localitySearchDropdown.querySelectorAll('.loc-match-item').forEach((item) => {
        item.addEventListener('click', () => {
          const name = item.getAttribute('data-loc-name') || 'Medavakkam';
          const zone = item.getAttribute('data-loc-zone') || 'South & OMR';
          setCanonicalLocality(name, zone);
          localitySearchInput.value = name;
          localitySearchDropdown.classList.add('hidden');
        });
      });
    });

    localitySearchInput?.addEventListener('blur', () => {
      setTimeout(() => {
        localitySearchDropdown.classList.add('hidden');
        const q = localitySearchInput.value.trim();
        if (q) {
          const topMatch = matchChennaiLocality(q)[0];
          if (topMatch) {
            setCanonicalLocality(topMatch.name, topMatch.zoneId);
            localitySearchInput.value = topMatch.name;
          } else {
            cityInput.value = q;
          }
        }
      }, 180);
    });

    setCanonicalLocality('Medavakkam', 'South & OMR');

    // DL Photo Listener
    dlFileInput?.addEventListener('change', async () => {
      if (dlFileInput.files && dlFileInput.files[0]) {
        const file = dlFileInput.files[0];
        dlFileStatus.textContent = `Compressing ${file.name}...`;
        dlFileData = await processImageFile(file);
        dlFileStatus.textContent = `✓ ${file.name} (Ready)`;
        dlFileStatus.classList.add('text-emerald-700', 'font-bold');
      } else {
        dlFileData = null;
        dlFileStatus.textContent = 'Required (Tap to capture or select)';
        dlFileStatus.classList.remove('text-emerald-700', 'font-bold');
      }
    });

    // Form Submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');

      const rawArea = (localitySearchInput.value || cityInput.value || '').trim();
      if (rawArea) {
        const topMatch = matchChennaiLocality(rawArea)[0];
        if (topMatch) {
          setCanonicalLocality(topMatch.name, topMatch.zoneId);
        } else {
          cityInput.value = rawArea;
        }
      }

      const name = nameInput.value.trim();
      const phone = phoneInput.value.replace(/\D/g, '');
      const zone = selectedZoneInput.value.trim() || 'South & OMR';
      const area = cityInput.value.trim();
      const category = selectedCategoryInput.value;

      if (category === 'Attach Car') {
        for (let i = 0; i < vehiclesState.length; i++) {
          const v = vehiclesState[i];
          if (!v.plate || !isValidIndianPlateNumber(v.plate)) {
            showError(`Please enter a valid Vehicle Plate Number (e.g. TN 14 AK 2026) for Vehicle #${i + 1} (${v.model}).`);
            const plateEl = vehicleCardsContainer.querySelector(`[data-plate-idx="${i}"]`) as HTMLInputElement;
            plateEl?.focus();
            return;
          }
          if (!v.rcFile) {
            showError(`Please upload the RC Book photo for Vehicle #${i + 1} (${v.model}).`);
            return;
          }
          if (!v.carFile) {
            showError(`Please upload the Car Front photo with number plate for Vehicle #${i + 1} (${v.model}).`);
            return;
          }
        }
      }

      if (!area || !zone) {
        showError('Please select your Chennai Operating Zone and Base Area.');
        return;
      }

      if (!name || name.length < 2) {
        showError('Please enter your full name.');
        nameInput.focus();
        return;
      }

      if (!phone || phone.length !== 10 || !/^[6-9]\d{9}$/.test(phone)) {
        showError('Please enter a valid 10-digit mobile number.');
        phoneInput.focus();
        return;
      }

      if (!dlFileData) {
        showError('Driving License (DL) photo is required. Please upload your DL photo.');
        dlFileInput.click();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
        <span>Uploading & Saving to Dispatch Roster...</span>
      `;

      const partnerType =
        category === 'Driver Job Only'
          ? 'Acting Driver'
          : vehiclesState.length > 1
          ? 'Fleet Partner'
          : 'Owner-Driver';

      const vehiclesSummaryText =
        category === 'Attach Car'
          ? vehiclesState
              .map((v, i) => `#${i + 1}: ${v.model} [${v.plate} • ${v.boardType} • ${v.carrier}]`)
              .join(' | ')
          : `License: ${selectedLicenseTypeInput.value} | Exp: ${selectedExperienceInput.value} | Duty: ${selectedPreferredDutyInput.value}`;

      const leadPayload = {
        name,
        phone,
        category,
        partnerType,
        zone,
        area,
        city: `${area} (${zone})`,
        carCount: category === 'Attach Car' ? `${vehiclesState.length} Vehicle(s)` : 'Driver Only',
        cars: category === 'Attach Car' ? vehiclesState.map((v) => v.model).join(', ') : 'Acting Driver',
        plateType: category === 'Attach Car' ? vehiclesState.map((v) => v.boardType).join(', ') : '',
        licenseType: selectedLicenseTypeInput.value,
        experience: selectedExperienceInput.value,
        preferredDuty: selectedPreferredDutyInput.value,
        dlFile: dlFileData,
        rcFile: vehiclesState[0]?.rcFile || null,
        carFile: vehiclesState[0]?.carFile || null,
        vehicles: category === 'Attach Car' ? vehiclesState : [],
        webhookUrl: getActiveGoogleSheetUrl(),
        notes: vehiclesSummaryText
      };

      let leadId = getNextDriverLeadId();

      try {
        const res = await fetch('/api/record-driver-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(leadPayload)
        });
        if (res.ok) {
          const resData = await res.json();
          if (resData && resData.leadId) {
            leadId = resData.leadId;
            const m = String(leadId).match(/KT-DRV-(\d+)/i);
            if (m && typeof window !== 'undefined' && window.localStorage) {
              try {
                localStorage.setItem(STORAGE_KEYS.DRIVER_LEAD, m[1]);
              } catch (_) {}
            }
          }
        }
      } catch (_) {}

      try {
        const sheetUrl = getActiveGoogleSheetUrl();
        if (sheetUrl && sheetUrl.startsWith('https://script.google.com/macros/s/')) {
          await fetch(sheetUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({
              type: 'driver_lead',
              leadId,
              date: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }),
              name: leadPayload.name,
              phone: leadPayload.phone,
              category: leadPayload.partnerType,
              zone: leadPayload.zone,
              area: leadPayload.area,
              city: leadPayload.city,
              notes: leadPayload.notes,
              dlFile: dlFileData,
              rcFile: vehiclesState[0]?.rcFile || null,
              carFile: vehiclesState[0]?.carFile || null,
              referenceId: leadId
            })
          }).catch(() => {});
        }
      } catch (_) {}

      (document.getElementById('confLeadId') as HTMLElement).textContent = `Ref ID: ${leadId}`;
      (document.getElementById('confName') as HTMLElement).textContent = name;
      (document.getElementById('confPhone') as HTMLElement).textContent = `+91 ${phone}`;
      (document.getElementById('confCategory') as HTMLElement).textContent = partnerType;
      (document.getElementById('confCity') as HTMLElement).textContent = `${area} (${zone})`;
      (document.getElementById('confDetails') as HTMLElement).textContent =
        category === 'Attach Car'
          ? vehiclesState.map((v) => `${v.model} (${v.plate})`).join(', ')
          : `${selectedLicenseTypeInput.value} • ${selectedExperienceInput.value}`;

      const notifyWhatsAppBtn = document.getElementById('notifyWhatsAppBtn') as HTMLAnchorElement | null;
      if (notifyWhatsAppBtn) {
        const waLines = [
          `*KALIDASS TRAVELS — PARTNER REGISTRATION*`,
          `Ref ID: ${leadId}`,
          `Name: ${name}`,
          `Phone: +91 ${phone}`,
          `Type: ${partnerType}`,
          `Base Zone: ${zone}`,
          `Base Area: ${area}`,
          ...(category === 'Attach Car'
            ? vehiclesState.map(
                (v, i) => `Vehicle #${i + 1}: ${v.model} | Plate: ${v.plate} | ${v.boardType} | ${v.carrier}`
              )
            : [`Driver: ${selectedLicenseTypeInput.value} | ${selectedExperienceInput.value} | ${selectedPreferredDutyInput.value}`]),
          `Documents: Uploaded on Portal`
        ];
        notifyWhatsAppBtn.href = `https://wa.me/919092303060?text=${encodeURIComponent(waLines.join('\n'))}`;
      }

      formWrapper.classList.add('hidden');
      successCard.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    function showError(msg: string) {
      errorAlert.classList.remove('hidden');
      errorMessage.textContent = msg;
    }

    resetFormBtn?.addEventListener('click', () => {
      form.reset();
      dlFileData = null;
      dlFileStatus.textContent = 'Required (Tap to capture or select)';
      dlFileStatus.classList.remove('text-emerald-700', 'font-bold');
      vehiclesState = [
        {
          id: 'veh-1',
          category: 'Sedan',
          model: 'Swift Dzire',
          plate: '',
          boardType: 'Yellow Board',
          carrier: 'With Carrier',
          rcFile: null,
          carFile: null
        }
      ];
      renderVehicleCards();
      setCanonicalLocality('Medavakkam', 'South & OMR');
      submitBtn.disabled = false;
      submitBtn.innerHTML = `<span>Submit Partner Registration</span>`;
      successCard.classList.add('hidden');
      formWrapper.classList.remove('hidden');
    });
  });
</script>
