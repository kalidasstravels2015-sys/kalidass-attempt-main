                      </button>`
                    : `<span class="text-[11px] font-semibold text-m3-on-surface-variant">Primary Cab</span>`
                }
              </div>

              <!-- Row 1: Single Car Model Dropdown + Registration Plate Input -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-m3-on-surface mb-1">
                    Select Car Model *
                  </label>
                  <select
                    data-model-select-idx="${idx}"
                    class="veh-model-select w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2.5 px-3 text-xs sm:text-sm font-bold text-m3-on-surface outline-none shadow-2xs"
                  >
                    ${VEHICLE_CATEGORIES.map(
                      (cat) => `
                        <optgroup label="${cat.label} (${cat.seats})">
                          ${cat.models
                            .map(
                              (m) => `
                                <option value="${m}" ${v.model === m ? 'selected' : ''}>
                                  ${m}
