                  <input
                    type="text"
                    data-plate-idx="${idx}"
                    value="${v.plate}"
                    maxlength="13"
                    placeholder="TN 14 AK 2026"
                    class="veh-plate-input w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2.5 px-3 text-xs sm:text-sm font-mono font-bold uppercase text-m3-on-surface outline-none shadow-2xs"
                  />
                </div>
              </div>

              <!-- Row 2: Board Type + Roof Carrier Dropdowns -->
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-m3-on-surface mb-1">
                    Board / Permit Type
                  </label>
                  <select
                    data-board-select-idx="${idx}"
                    class="veh-board-select w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2 px-3 text-xs sm:text-sm font-semibold text-m3-on-surface outline-none shadow-2xs"
                  >
                    <option value="Yellow Board" ${v.boardType === 'Yellow Board' ? 'selected' : ''}>Yellow Board (T-Permit)</option>
                    <option value="White Board" ${v.boardType === 'White Board' ? 'selected' : ''}>White Board</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-bold text-m3-on-surface mb-1">
                    Luggage Roof Carrier
                  </label>
                  <select
                    data-carrier-select-idx="${idx}"
                    class="veh-carrier-select w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2 px-3 text-xs sm:text-sm font-semibold text-m3-on-surface outline-none shadow-2xs"
                  >
                    <option value="With Carrier" ${v.carrier === 'With Carrier' ? 'selected' : ''}>With Roof Carrier</option>
                    <option value="No Carrier" ${v.carrier === 'No Carrier' ? 'selected' : ''}>No Carrier</option>
                  </select>
                </div>
              </div>

              <!-- Row 3: RC & Car Front Photos for THIS Vehicle -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 border-t border-m3-outline-variant/40">
                <div class="flex items-center justify-between p-2.5 rounded-m3-lg bg-white border border-m3-outline-variant/80 gap-2">
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-m3-on-surface truncate">RC Book Photo #${idx + 1} <span class="text-red-500">*</span></div>
                    <div class="text-[10px] font-mono ${v.rcFile ? 'text-emerald-700 font-bold' : 'text-m3-on-surface-variant'}" id="rcStatus-${idx}">
                      ${v.rcFile ? `✓ ${v.rcFile.name}` : 'Required (No photo)'}
                    </div>
                  </div>
                  <label class="cursor-pointer inline-flex items-center gap-1 px-2.5 py-1.5 rounded-m3-md bg-m3-surface-container-low hover:bg-m3-surface-container border border-m3-outline-variant text-[11px] font-bold text-m3-on-surface shrink-0">
                    <span>${v.rcFile ? 'Change' : 'Upload RC'}</span>
                    <input type="file" data-rc-idx="${idx}" accept="image/*" class="veh-rc-input hidden" />
                  </label>
                </div>

                <div class="flex items-center justify-between p-2.5 rounded-m3-lg bg-white border border-m3-outline-variant/80 gap-2">
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-m3-on-surface truncate">Car Front Photo #${idx + 1} <span class="text-red-500">*</span></div>
                    <div class="text-[10px] font-mono ${v.carFile ? 'text-emerald-700 font-bold' : 'text-m3-on-surface-variant'}" id="carStatus-${idx}">
                      ${v.carFile ? `✓ ${v.carFile.name}` : 'Show Plate No.'}
                    </div>
                  </div>
                  <label class="cursor-pointer inline-flex items-center gap-1 px-2.5 py-1.5 rounded-m3-md bg-m3-surface-container-low hover:bg-m3-surface-container border border-m3-outline-variant text-[11px] font-bold text-m3-on-surface shrink-0">
                    <span>${v.carFile ? 'Change' : 'Upload Car'}</span>
                    <input type="file" data-car-idx="${idx}" accept="image/*" class="veh-car-input hidden" />
                  </label>
                </div>
              </div>
            </div>
          `;
        })
        .join('');

      bindVehicleCardEvents();
