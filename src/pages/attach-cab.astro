---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import {
  Handshake,
  Car,
  UserCheck,
  MapPin,
  BadgeCheck,
  Camera,
  Send,
  CheckCircle2,
  ArrowLeft,
  AlertCircle,
  HelpCircle,
  Plus
} from "lucide-react";
import { ALL_CHENNAI_LOCALITIES } from "../data/chennaiFleetStandards.js";

const site = "https://kalidasstravels.in";
const pageUrl = `${site}/attach-cab/`;

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Attach Car & Driver Registration", item: "/attach-cab/" },
];

// Single source of truth for FAQs (rendered visibly and marked up in Schema)
const faqItems = [
  {
    q: "How does trip settlement and commission work for attached vehicles?",
    a: "We operate on a transparent per-trip outsourced model (not a fixed monthly salary). Standard agency commission is 10% on outsourced bookings, meaning 90% of the trip fare goes to the vehicle partner. If the customer pays the balance directly to you at trip completion, you simply settle the net commission difference with our dispatch desk."
  },
  {
    q: "How do I register if I have 2 or more cars (Fleet Partner)?",
    a: "Fill in the details and upload the RC & Car Front photo for Vehicle #1 first, then tap the '+ Add Another Vehicle' button right below it to add Vehicle #2, #3, etc. Each vehicle gets its own dedicated assignable card in our dispatch roster."
  },
  {
    q: "Are both Yellow Board and White Board vehicles accepted?",
    a: "Yes. You can select either Yellow Board or White Board inside each vehicle box along with whether your vehicle has a luggage roof carrier."
  },
  {
    q: "Can I send my driving license or RC on WhatsApp instead of this form?",
    a: "Please upload your Driving License, RC Book, and Car Front photo with number plate directly through this form first. It automatically organizes your documents and places your profile into our Dispatch Roster verification queue."
  },
  {
    q: "Is there any onboarding or registration fee to attach a cab?",
    a: "No. Registration and partner onboarding at Kalidass Travels is 100% free of charge (₹0). We never ask for upfront registration fees."
  }
];

// 1. WebPage & ContactPage Schema with strict @id linkage
const webPageSchema = {
  "@type": ["WebPage", "ContactPage"],
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "name": "Attach Car & Driver Registration | Kalidass Travels Chennai",
  "description": "Official driver onboarding and vehicle attachment portal for Kalidass Travels Chennai. Attach sedans, SUVs, Innova Crysta, or Tempo Travellers, or join as an acting driver.",
  "isPartOf": { "@id": `${site}/#website` },
  "about": { "@id": `${site}/#localbusiness` },
  "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
  "inLanguage": "en-IN"
};

// 2. Service Schema for Commercial Taxi & Fleet Attachment
const serviceSchema = {
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  "name": "Cab & Fleet Partner Attachment Program",
  "serviceType": "Vehicle Attachment & Outsourced Dispatch Network",
  "url": pageUrl,
  "provider": { "@id": `${site}/#localbusiness` },
  "areaServed": [
    { "@type": "City", "name": "Chennai" },
    { "@type": "AdministrativeArea", "name": "Tamil Nadu" },
    { "@type": "AdministrativeArea", "name": "Puducherry" }
  ],
  "description": "Attach sedans (Swift Dzire, Toyota Etios), SUVs (Innova Crysta, Maruti Ertiga), and Tempo Travellers for outstation duties, airport transfers, and local packages with transparent per-trip settlement.",
  "offers": {
    "@type": "Offer",
    "name": "Driver & Fleet Partner Onboarding",
    "price": "0",
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": pageUrl
  },
  "audience": {
    "@type": "Audience",
    "audienceType": "Car Owners, Fleet Operators & Chauffeurs"
  }
};

// 3. FAQPage Schema derived strictly from visible page FAQs
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const pageSchemas = [webPageSchema, serviceSchema, faqSchema];
---

<Layout
  title="Cab & Fleet Partner Attachment | Kalidass Travels Chennai"
  description="Official vehicle attachment and driver onboarding portal for car owners, fleet operators, and acting chauffeurs in Chennai. Attach Swift Dzire, Ertiga, Innova Crysta, or Tempo Traveller."
  keywords="attach taxi chennai, attach car travels chennai, cab attachment kalidass travels, fleet attachment chennai, vehicle attachment medavakkam"
  schema={pageSchemas}
  whatsappMsg="Hi Kalidass Travels, I want to attach my vehicle / join as a driver partner with your fleet. Please share the partner onboarding process and trip duty details."
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface-container-low min-h-screen text-m3-on-surface font-sans py-6 sm:py-10 px-4 sm:px-6">
    <div class="max-w-2xl mx-auto space-y-5">
      
      {/* Passenger Redirection Alert */}
      <div class="bg-amber-50 border border-amber-200 rounded-m3-xl p-3.5 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-amber-950">
        <div class="flex items-center gap-2">
          <span class="text-base shrink-0">🚖</span>
          <span><strong>Looking to book a cab for a trip?</strong> This portal is strictly for car owners, fleet vendors &amp; chauffeurs.</span>
        </div>
        <a
          href="tel:+918939539211"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-m3-primary hover:bg-m3-primary/90 active:bg-m3-primary/80 text-m3-on-primary font-bold text-xs shrink-0 shadow-2xs transition-all"
        >
          <span>Book a Cab: +91 89395 39211</span>
        </a>
      </div>

      {/* Header Section */}
      <div class="text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface border border-m3-outline-variant/60 text-xs font-semibold text-m3-on-surface-variant shadow-2xs mb-2.5">
          <Handshake className="w-4 h-4 text-m3-primary shrink-0" />
          <span>Official Partner &amp; Dispatch Roster Onboarding</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-m3-on-surface tracking-tight font-heading">
          Cab, Fleet &amp; Chauffeur Attachment
        </h1>
        <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-1.5 max-w-lg mx-auto">
          Outsourced website bookings across Chennai &amp; South India · Transparent per-trip settlement · Zero registration fee
        </p>
        <p class="text-[11px] font-semibold text-m3-primary mt-2">
          Partner Dispatch Desk: <a href="tel:+919092303060" class="hover:underline">+91 90923 03060</a> (10:00 AM – 6:00 PM)
        </p>
      </div>

      {/* Main Registration Form Container */}
      <div class="bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-5 sm:p-7 shadow-m3-1" id="formWrapper">
        <form id="driverForm" class="space-y-6" novalidate>
          
          {/* 1. Partner Category Switcher */}
          <div>
            <div class="block text-xs font-bold text-m3-on-surface mb-2">
              1. Select Registration Type
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 p-1.5 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/60" id="categoryToggle">
              <button
                type="button"
                data-category="Attach Car"
                class="category-btn active py-3 px-3 rounded-m3-lg text-xs sm:text-sm font-bold text-left transition-all bg-m3-primary text-m3-on-primary shadow-2xs cursor-pointer flex items-center gap-2.5"
              >
                <Car className="w-5 h-5 shrink-0" />
                <div>
                  <div class="leading-tight">Attach Vehicle(s)</div>
                  <div class="text-[10px] font-normal opacity-90">1 Car (Owner-Driver) or 2+ Cars (Fleet)</div>
                </div>
              </button>
              <button
                type="button"
                data-category="Driver Job Only"
                class="category-btn py-3 px-3 rounded-m3-lg text-xs sm:text-sm font-bold text-left transition-all text-m3-on-surface-variant hover:text-m3-on-surface cursor-pointer flex items-center gap-2.5"
              >
                <UserCheck className="w-5 h-5 shrink-0" />
                <div>
                  <div class="leading-tight">Acting / Chauffeur Driver</div>
                  <div class="text-[10px] font-normal opacity-80">I don't own a car (Driver duty only)</div>
                </div>
              </button>
            </div>
            <input type="hidden" name="category" id="selectedCategory" value="Attach Car" />
          </div>

          {/* 2. Dynamic Vehicle Cards Section (For Car Owners & Fleet Partners) */}
          <div id="carOwnerSection" class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xs sm:text-sm font-bold text-m3-on-surface">
                  2. Vehicle Details &amp; Photos
                </h2>
                <p class="text-[11px] text-m3-on-surface-variant">
                  Select your car model, enter plate number, and upload RC &amp; Car Front photo. Own a 2nd car? Tap <strong>"+ Add Another Vehicle"</strong> below.
                </p>
              </div>
              <span id="vehicleCountBadge" class="px-2.5 py-1 rounded-full bg-m3-primary/10 text-m3-primary font-bold text-xs shrink-0">
                1 Vehicle
              </span>
            </div>

            {/* Vehicle Cards List Container */}
            <div id="vehicleCardsContainer" class="space-y-4"></div>

            {/* + Add Another Vehicle Button */}
            <button
              type="button"
              id="addVehicleBtn"
              class="w-full py-3 px-4 rounded-m3-xl border-2 border-dashed border-m3-primary/50 hover:border-m3-primary bg-m3-primary/5 hover:bg-m3-primary/10 text-m3-primary font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer"
            >
              <Plus className="w-4 h-4 shrink-0" />
              <span>+ Add Another Vehicle (If you own 2 or more cars)</span>
            </button>
          </div>

          {/* 2B. Chauffeur / Acting Driver Only Section (Clean Dropdowns) */}
          <div id="driverJobSection" class="space-y-4 pt-1 hidden">
            <div class="p-4 rounded-m3-xl bg-m3-surface-container-low border border-m3-outline-variant/60 space-y-3">
              <div class="text-xs sm:text-sm font-bold text-m3-on-surface">
                2. Chauffeur License &amp; Experience Details
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label for="selectedLicenseType" class="block text-xs font-bold text-m3-on-surface mb-1">
                    License Type *
                  </label>
                  <select
                    id="selectedLicenseType"
                    name="licenseType"
                    class="w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2.5 px-3 text-xs sm:text-sm font-semibold text-m3-on-surface outline-none shadow-2xs"
                  >
                    <option value="Commercial Badge">Commercial Badge (Yellow)</option>
                    <option value="Car (LMV)">Car License (LMV)</option>
                    <option value="Heavy (HMV / Bus)">Heavy License (HMV / Bus)</option>
                  </select>
                </div>

                <div>
                  <label for="selectedExperience" class="block text-xs font-bold text-m3-on-surface mb-1">
                    Driving Experience *
                  </label>
                  <select
                    id="selectedExperience"
                    name="experience"
                    class="w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2.5 px-3 text-xs sm:text-sm font-semibold text-m3-on-surface outline-none shadow-2xs"
                  >
                    <option value="3 to 5 Years">3 to 5 Years</option>
                    <option value="5+ Years">5+ Years</option>
                    <option value="1 to 3 Years">1 to 3 Years</option>
                  </select>
                </div>

                <div>
                  <label for="selectedPreferredDuty" class="block text-xs font-bold text-m3-on-surface mb-1">
                    Preferred Duty *
                  </label>
                  <select
                    id="selectedPreferredDuty"
                    name="preferredDuty"
                    class="w-full bg-white border border-m3-outline-variant focus:border-m3-primary rounded-m3-lg py-2.5 px-3 text-xs sm:text-sm font-semibold text-m3-on-surface outline-none shadow-2xs"
                  >
                    <option value="Outstation & Local Acting">Both Local &amp; Outstation</option>
                    <option value="Outstation Trips">Outstation Only</option>
                    <option value="Local City Acting">Local City Only</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          {/* 3. Owner / Driver Details, Base Area & Driving License */}
          <div class="space-y-4 pt-3 border-t border-m3-outline-variant/50">
            <h2 class="text-xs sm:text-sm font-bold text-m3-on-surface">
              3. Driver Contact, Base Area &amp; License *
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {/* Full Name */}
              <div>
                <label for="driverName" class="block text-xs font-bold text-m3-on-surface mb-1.5">
                  Owner / Driver Full Name *
                </label>
                <div class="relative flex items-center bg-white border border-m3-outline-variant hover:border-m3-outline rounded-m3-lg transition-colors focus-within:border-m3-primary focus-within:ring-2 focus-within:ring-m3-primary/20 shadow-2xs">
                  <input
                    type="text"
                    id="driverName"
                    name="name"
                    required
                    placeholder="e.g. Ramesh Kumar"
                    class="w-full bg-transparent py-2.5 px-3.5 text-xs sm:text-sm font-medium text-m3-on-surface outline-none"
                  />
                </div>
              </div>

              {/* Mobile Number */}
              <div>
                <label for="driverPhone" class="block text-xs font-bold text-m3-on-surface mb-1.5">
                  WhatsApp / Mobile Number *
                </label>
                <div class="relative flex items-center bg-white border border-m3-outline-variant hover:border-m3-outline rounded-m3-lg transition-colors focus-within:border-m3-primary focus-within:ring-2 focus-within:ring-m3-primary/20 shadow-2xs">
                  <span class="pl-3.5 pr-1.5 text-xs sm:text-sm font-semibold text-m3-on-surface-variant select-none">
                    +91
                  </span>
                  <input
                    type="tel"
                    id="driverPhone"
                    name="phone"
                    required
                    inputmode="numeric"
                    pattern="[0-9]{10}"
                    maxlength="10"
                    placeholder="98401 23456"
                    class="w-full bg-transparent py-2.5 pr-3.5 text-xs sm:text-sm font-semibold tracking-wide text-m3-on-surface outline-none"
                  />
                </div>
              </div>
            </div>

            {/* Single Clean Base Parking Area / Stand Input (Auto-detects Chennai Zone silently) */}
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="localitySearchInput" class="block text-xs font-bold text-m3-on-surface">
                  Base Parking Area / Stand in Chennai *
                </label>
                <span id="selectedLocalityBadge" class="text-[11px] font-semibold text-emerald-700">
                  ✓ Medavakkam
                </span>
              </div>
              <div class="relative">
                <div class="flex items-center bg-white border border-m3-outline-variant hover:border-m3-outline rounded-m3-lg focus-within:border-m3-primary focus-within:ring-2 focus-within:ring-m3-primary/20 shadow-2xs">
                  <MapPin className="w-4 h-4 text-m3-on-surface-variant ml-3.5 mr-2 shrink-0 pointer-events-none" />
                  <input
                    type="text"
                    id="localitySearchInput"
                    list="chennaiLocalitiesDatalist"
                    value="Medavakkam"
                    placeholder="Type area name or Pincode (e.g. Medavakkam, Tambaram, Velachery, 600100)..."
                    autocomplete="off"
                    class="w-full bg-transparent py-2.5 pr-3.5 text-xs sm:text-sm font-medium text-m3-on-surface outline-none"
                  />
                </div>
                <datalist id="chennaiLocalitiesDatalist">
                  {ALL_CHENNAI_LOCALITIES.map((loc) => (
                    <option value={loc.name}>{`${loc.name} (${loc.pincode})`}</option>
                  ))}
                </datalist>
                <div
                  id="localitySearchDropdown"
                  class="hidden absolute left-0 right-0 top-full mt-1 max-h-48 overflow-y-auto bg-white border border-m3-outline-variant rounded-m3-lg shadow-m3-3 z-30 divide-y divide-m3-outline-variant/30"
                ></div>
              </div>
              <input type="hidden" id="selectedZoneInput" name="zone" value="South & OMR" />
              <input type="hidden" id="driverCity" name="city" value="Medavakkam" required />
            </div>

            {/* Driving License Photo (Mandatory for all) */}
            <div class="flex items-center justify-between p-3.5 rounded-m3-lg bg-m3-surface-container-low border border-m3-outline-variant/60 gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <BadgeCheck className="w-5 h-5 text-m3-primary shrink-0" />
                <div class="truncate">
                  <div class="text-xs font-bold text-m3-on-surface">Driving License (DL) Photo <span class="text-red-500">*</span></div>
                  <div class="text-[10px] text-m3-on-surface-variant font-mono" id="dlFileStatus">Required (Tap to capture or select)</div>
                </div>
              </div>
              <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-2 rounded-m3-md bg-white border border-m3-outline-variant text-xs font-semibold text-m3-on-surface hover:bg-m3-surface-container shadow-2xs transition-all shrink-0">
                <Camera className="w-3.5 h-3.5 text-m3-primary shrink-0" />
                <span>Upload DL</span>
                <input type="file" id="dlFileInput" accept="image/*" class="hidden" />
              </label>
            </div>
          </div>

          {/* Validation Error Message */}
          <div id="errorAlert" class="hidden p-3 rounded-m3-md bg-m3-error-container text-m3-on-error-container text-xs font-semibold flex items-center gap-2">
            <AlertCircle className="w-4 h-4 shrink-0" />
            <span id="errorMessage">Please complete all required fields.</span>
          </div>

          {/* Submit Action Row */}
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
            <button
              type="submit"
              id="submitBtn"
              class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-m3-full bg-m3-primary text-m3-on-primary font-bold text-sm shadow-m3-1 hover:shadow-m3-2 transition-all cursor-pointer select-none"
            >
              <Send className="w-4 h-4 shrink-0" />
              <span>Submit Partner Registration</span>
            </button>
          </div>

          <div class="text-center text-[11px] text-m3-on-surface-variant">
            100% Free Onboarding. Partner Dispatch Desk: <a href="tel:+919092303060" class="font-bold text-m3-primary hover:underline">+91 90923 03060</a>.
          </div>

        </form>
      </div>

      {/* Success Confirmation Card */}
      <div id="successCard" class="hidden bg-m3-surface border border-m3-outline-variant rounded-m3-xl p-6 sm:p-8 shadow-m3-1 text-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-m3-surface-container text-m3-primary mx-auto flex items-center justify-center">
          <CheckCircle2 className="w-6 h-6" />
        </div>
        
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-m3-on-surface font-heading">
            Partner Registration Received
          </h2>
          <div class="text-xs text-m3-on-surface-variant font-mono mt-1 font-bold" id="confLeadId">
            Ref ID: #KT-DRV-1
          </div>
        </div>

        {/* Summary Table */}
        <div class="bg-m3-surface-container-low rounded-m3-lg p-3.5 text-left text-xs space-y-1.5 border border-m3-outline-variant/60 max-w-md mx-auto">
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Partner Name:</span>
            <span class="font-bold text-m3-on-surface" id="confName">-</span>
          </div>
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Mobile Number:</span>
            <span class="font-bold text-m3-on-surface" id="confPhone">-</span>
          </div>
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30">
            <span class="text-m3-on-surface-variant">Partner Type:</span>
            <span class="font-bold text-m3-on-surface" id="confCategory">-</span>
          </div>
          <div class="flex justify-between py-1 border-b border-m3-outline-variant/30 gap-3">
            <span class="text-m3-on-surface-variant shrink-0">Registered Details:</span>
            <span class="font-bold text-m3-on-surface text-right" id="confDetails">-</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-m3-on-surface-variant">Base Area:</span>
            <span class="font-bold text-m3-on-surface" id="confCity">-</span>
          </div>
        </div>

        <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-m3-lg text-emerald-900 text-xs max-w-md mx-auto flex items-center justify-center gap-2">
          <BadgeCheck className="w-4 h-4 text-emerald-600 shrink-0" />
          <span>Added to Kalidass Travels Dispatch Roster verification queue.</span>
        </div>

        <p class="text-xs text-m3-on-surface-variant max-w-sm mx-auto">
          Tap the button below to send your structured registration card to our Dispatch Desk (+91 90923 03060) for instant roster activation.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            id="notifyWhatsAppBtn"
            href="https://wa.me/919092303060?text=Hi%20Kalidass%20Travels%2C%20I%20have%20submitted%20my%20partner%20attachment%20application%20on%20your%20website%20with%20all%20documents%20attached.%20Please%20review."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold text-xs shadow-2xs transition-all"
          >
            <span>Notify Dispatch on WhatsApp</span>
          </a>

          <button
            type="button"
            id="resetFormBtn"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-m3-primary hover:underline cursor-pointer"
          >
            <ArrowLeft className="w-3.5 h-3.5 shrink-0" />
            <span>Register another vehicle/driver</span>
          </button>
        </div>
      </div>

      {/* Frequently Asked Questions Section */}
      <section class="space-y-3 pt-2">
        <div class="text-center sm:text-left">
          <h2 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading flex items-center justify-center sm:justify-start gap-2">
            <HelpCircle className="w-5 h-5 text-m3-primary shrink-0" />
            <span>Frequently Asked Questions</span>
          </h2>
          <p class="text-xs text-m3-on-surface-variant mt-0.5">
            Clear answers for car owners, fleet operators, and chauffeurs partnering with Kalidass Travels.
          </p>
        </div>
        <FAQAccordion items={faqItems} />
      </section>

    </div>
  </main>
</Layout>

<script>
  import { getActiveGoogleSheetUrl } from '../config/googleSheets';
  import {
    VEHICLE_CATEGORIES,
    formatIndianPlateNumber,
    isValidIndianPlateNumber,
    matchChennaiLocality,
    normalizeVehicleCategory
  } from '../data/chennaiFleetStandards.js';
  import { getNextDriverLeadId, STORAGE_KEYS } from '../utils/sequenceGenerator.js';

  interface FilePayload {
    base64: string;
    mimeType: string;
    name: string;
  }

  interface VehicleEntry {
    id: string;
    category: string;
    model: string;
    plate: string;
    boardType: string;
    carrier: string;
