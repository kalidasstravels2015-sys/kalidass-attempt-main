---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/SEO/Breadcrumbs.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import tariffConfig from "../data/tariff_config.json";

const tariffFaqs = [
  {
    q: "How are Extra Hours and Extra Kilometers charged?",
    a: "If your trip exceeds the contracted package (e.g. 5hr/50km or 10hr/100km), additional hours and kilometers are calculated according to the published extra rate table (e.g., ₹15/km and ₹150/hr for Sedans). There are no surge rates applied."
  },
  {
    q: "Can I get GST tax invoices for corporate claims and reimbursements?",
    a: "Yes. All our trips come with verifiable GST invoices clearly detailing base rental, extra kilometers, and driver allowances, making company claims and corporate accounting seamless."
  },
  {
    q: "What is the minimum billing distance for outstation trips?",
    a: "Outstation round-trips carry a standard minimum billing of 250 kilometers per calendar day (300 km for Innova Crysta and Tempo Traveller). If you travel 180 km in a day, the 250 km minimum applies; if you travel 320 km, you pay for the exact 320 km."
  },
  {
    q: "Is driver bata included in local packages?",
    a: "Yes, driver allowance (bata) is fully included in all local hourly packages within Chennai. For outstation journeys, driver bata is billed on a per-calendar-day basis as shown in the outstation tariff table."
  }
];

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Tariff", item: "/tariff/" },
];

const vehicles = Object.entries(tariffConfig.vehicles);

const vehicleCapacity: Record<string, string> = {
  "Swift Dzire": "4 Pax",
  "Toyota Etios": "4 Pax",
  "Maruti Ertiga": "6 Pax",
  "Innova": "6 Pax",
  "Innova Crysta": "7 Pax",
  "Tempo Traveller": "12 Pax",
};

const vehicleImages: Record<string, string> = {
  "Swift Dzire": "/images/fleet/swift-dzire.webp",
  "Toyota Etios": "/images/fleet/toyoto-etios.webp",
  "Maruti Ertiga": "/images/fleet/suv.webp",
  "Innova": "/images/fleet/suv.webp",
  "Innova Crysta": "/images/fleet/suv.webp",
  "Tempo Traveller": "/images/fleet/tempo.webp",
};

const vehicleBadges: Record<string, string> = {
  "Swift Dzire": "Best Value Sedan",
  "Toyota Etios": "Comfort Sedan",
  "Maruti Ertiga": "Popular 7-Seater MPV",
  "Innova": "Legendary Comfort MUV",
  "Innova Crysta": "VIP Executive Luxury",
  "Tempo Traveller": "Group Travel Special",
};

// Schema.org structured data for machine-readable tariff pricing
const tariffSchema = {
  "@type": "OfferCatalog",
  "@id": "https://kalidasstravels.in/tariff/#offercatalog",
  name: "Chennai Taxi & Car Rental Tariff Rates",
  description: "Official local hourly and outstation tariff card for Kalidass Travels in Chennai, covering 5hr/50km, 8hr/80km, 10hr/100km, CPWD/government tender benchmarks, and per-km outstation rates.",
  itemListElement: vehicles.flatMap(([name, v]: [string, any]) => [
    {
      "@type": "Offer",
      name: `${name} Local 5 Hrs / 50 KM Package (Chennai)`,
      price: v.local_5hr_pkg,
      priceCurrency: "INR",
      priceValidUntil: "2027-12-31",
      availability: "https://schema.org/InStock",
      description: `${name} local city package within Chennai for 5 hours and 50 kilometers. Extra km: ₹${v.extra_km_rate}/km, Extra hr: ₹${v.extra_hr_rate}/hr.`,
      eligibleRegion: { "@type": "City", name: "Chennai" },
    },
    {
      "@type": "Offer",
      name: `${name} Local 10 Hrs / 100 KM Package (Chennai)`,
      price: v.local_10hr_pkg,
      priceCurrency: "INR",
      priceValidUntil: "2027-12-31",
      availability: "https://schema.org/InStock",
      description: `${name} standard 10 hours / 100 kilometers package within Chennai. Extra km: ₹${v.extra_km_rate}/km, Extra hr: ₹${v.extra_hr_rate}/hr. Compliant with CPWD / tender rate standards.`,
      eligibleRegion: { "@type": "City", name: "Chennai" },
    },
    {
      "@type": "Offer",
      name: `${name} Outstation Round Trip (Per KM)`,
      price: v.round_trip_rate,
      priceCurrency: "INR",
      priceValidUntil: "2027-12-31",
      availability: "https://schema.org/InStock",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: v.round_trip_rate,
        priceCurrency: "INR",
        unitText: "KM",
      },
      description: `${name} outstation round trip from Chennai at ₹${v.round_trip_rate}/km with min ${v.min_km_per_day} km/day. Driver bata ₹${v.driver_bata}/day.`,
    }
  ])
};

const serviceSchema = {
  "@type": "TaxiService",
  "@id": "https://kalidasstravels.in/tariff/#service",
  name: "Kalidass Travels Taxi & Car Rental Tariff Rates",
  description: "Official local hourly and outstation tariff card for Kalidass Travels in Chennai, covering 5hr/50km, 8hr/80km, 10hr/100km, CPWD/government tender benchmarks, and per-km outstation rates.",
  url: "https://kalidasstravels.in/tariff/",
  serviceType: "Taxi & Car Rental Tariff",
  provider: { "@id": "https://kalidasstravels.in/#localbusiness" },
  areaServed: [
    { "@type": "City", name: "Chennai" },
    { "@type": "AdministrativeArea", name: "Tamil Nadu" },
    { "@type": "Country", name: "India" }
  ],
  hasOfferCatalog: tariffSchema
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://kalidasstravels.in/tariff/#faq",
  mainEntity: tariffFaqs.map(faq => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.a
    }
  }))
};
---

<Layout
  title="Chennai Taxi & Outstation Cab Tariff Card (Per-KM & Hourly Rates) – Kalidass Travels"
  description="Official Chennai taxi tariff card with transparent rates. Local city packages (5hr/50km, 8hr/80km, 10hr/100km) and outstation per-km rates for Dzire, Ertiga, Innova & Tempo Traveller. Zero surge pricing."
  ogImage="/og/tariff.jpg"
  keywords="taxi tariff Chennai, car rental tariff Chennai, cab rates per km Chennai, 5 hr 50 km cab chennai, 10 hr 100 km cab chennai, additional km rate chennai, additional hr rate chennai, cpwd tender cab rates chennai, innova car rental tariff chennai, swift dzire price per km chennai, outstation taxi price chennai"
  schema={[serviceSchema, tariffSchema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="py-8 md:py-12 bg-m3-surface text-m3-on-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-3.5 tracking-wide">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Chennai Commercial &amp; Retail Tariff Card</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
          Chennai Taxi &amp; <span class="text-m3-primary">Car Rental Tariff Card</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant max-w-2xl mx-auto font-normal leading-relaxed mb-6 font-sans">
          Transparent, fixed rates for local hourly packages, outstation journeys, and long-distance travel with zero surge pricing.
        </p>
      </div>

      <!-- Quick Summary Badges -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-8">
        <div class="bg-m3-surface-container-lowest p-5 rounded-m3-lg border border-m3-outline-variant shadow-m3-1 hover:shadow-m3-2 transition-all">
          <div class="text-xs font-semibold text-m3-on-surface-variant uppercase tracking-wider mb-1">Local 5 Hr / 50 KM</div>
          <div class="text-2xl font-black text-m3-on-surface font-heading">₹1,500 <span class="text-xs font-normal text-m3-on-surface-variant">starting</span></div>
          <p class="text-xs text-m3-on-surface-variant mt-1">Sedan half-day city rental</p>
        </div>
        <div class="bg-m3-surface-container-lowest p-5 rounded-m3-lg border border-m3-outline-variant shadow-m3-1 hover:shadow-m3-2 transition-all">
          <div class="text-xs font-semibold text-m3-on-surface-variant uppercase tracking-wider mb-1">Standard 10 Hr / 100 KM</div>
          <div class="text-2xl font-black text-m3-on-surface font-heading">₹2,600 <span class="text-xs font-normal text-m3-on-surface-variant">starting</span></div>
          <p class="text-xs text-m3-on-surface-variant mt-1">Full-day city package & extended sightseeing</p>
        </div>
        <div class="bg-m3-surface-container-lowest p-5 rounded-m3-lg border border-m3-outline-variant shadow-m3-1 hover:shadow-m3-2 transition-all">
          <div class="text-xs font-semibold text-m3-on-surface-variant uppercase tracking-wider mb-1">Outstation Per KM</div>
          <div class="text-2xl font-black text-m3-on-surface font-heading">₹14 <span class="text-xs font-normal text-m3-on-surface-variant">/km starting</span></div>
          <p class="text-xs text-m3-on-surface-variant mt-1">Min. 250 km/day (Crysta &amp; TT: 300 km)</p>
        </div>
        <div class="bg-m3-surface-container-lowest p-5 rounded-m3-lg border border-m3-outline-variant shadow-m3-1 hover:shadow-m3-2 transition-all">
          <div class="text-xs font-semibold text-m3-on-surface-variant uppercase tracking-wider mb-1">Night & Extra Charges</div>
          <div class="text-2xl font-black text-m3-on-surface font-heading">Zero <span class="text-xs font-normal text-m3-on-surface-variant">Surge</span></div>
          <p class="text-xs text-m3-on-surface-variant mt-1">100% pre-disclosed rates & bills</p>
        </div>
      </div>

      <!-- Sticky Sub-Nav Quick Jump Bar (Below Badges) -->
      <nav data-quick-nav aria-label="Tariff Quick Navigation" class="sticky top-16 z-30 bg-m3-surface/95 backdrop-blur-md border-y border-m3-outline-variant/60 shadow-xs py-3 mb-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
          <div class="flex items-center gap-1.5 sm:gap-2 text-xs font-semibold whitespace-nowrap py-0.5">
            <span class="text-micro uppercase tracking-wider text-m3-on-surface-variant mr-1 font-bold hidden sm:inline">Jump To:</span>
            <a href="#local-rates" class="px-3.5 py-2 rounded-m3-full bg-m3-primary text-white font-bold shadow-xs transition-all shrink-0">Local Hourly</a>
            <a href="#outstation-rates" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Outstation Per-KM</a>
            <a href="#fare-rules" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Inclusions &amp; Terms</a>
            <a href="#faq" class="px-3.5 py-2 rounded-m3-full bg-m3-surface-container text-m3-on-surface hover:bg-m3-surface-container-high transition-colors shrink-0 font-medium">Tariff FAQs</a>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a
              href="/calculator/"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-m3-primary hover:bg-slate-900 text-m3-on-primary font-bold text-micro sm:text-xs rounded-m3-full transition-all shadow-xs"
            >
              <span class="material-symbols-outlined text-[14px]">calculate</span>
              <span>Live Calculator</span>
            </a>
          </div>
        </div>
      </nav>

      <!-- Local Packages Section -->
      <div id="local-rates" class="mb-14 scroll-mt-28">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-3 border-b border-m3-outline-variant gap-2">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface font-heading">
              Local City &amp; <span class="text-m3-primary">Hourly Packages</span>
            </h2>
            <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant leading-relaxed font-sans mt-1">Standard hourly packages for city sightseeing, business meetings, and local errands.</p>
          </div>
          <div class="flex items-center gap-3">
            <!-- View switcher for Local Packages -->
            <div class="hidden md:inline-flex items-center p-1 rounded-m3-full bg-m3-surface-container border border-m3-outline-variant text-xs font-semibold select-none">
              <button
                type="button"
                id="local-btn-table"
                class="px-3.5 py-1.5 rounded-m3-full bg-m3-primary text-m3-on-primary shadow-xs transition-all cursor-pointer font-bold"
                aria-pressed="true"
              >
                Table View
              </button>
              <button
                type="button"
                id="local-btn-cards"
                class="px-3.5 py-1.5 rounded-m3-full text-m3-on-surface-variant hover:text-m3-on-surface transition-all cursor-pointer font-medium"
                aria-pressed="false"
              >
                Cards View
              </button>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-m3-primary bg-m3-primary-container px-3 py-1 rounded-m3-full border border-m3-primary/20 w-fit shrink-0">
              Fuel &amp; Driver Bata Included
            </span>
          </div>
        </div>

        {/* Table View (Default on desktop) */}
        <div id="local-table-view" class="hidden md:block overflow-x-auto rounded-m3-xl shadow-m3-1 border border-m3-outline-variant bg-m3-surface">
          <table class="w-full text-sm text-left font-sans">
            <thead class="bg-m3-surface-container-high text-m3-on-surface text-xs font-bold uppercase tracking-wider border-b border-m3-outline-variant">
              <tr>
                <th class="px-5 py-4 sticky left-0 z-10 bg-m3-surface-container-high">Vehicle Type</th>
                <th class="px-4 py-4 text-center">Capacity</th>
                <th class="px-4 py-4 text-center">5 Hrs / 50 KM</th>
                <th class="px-4 py-4 text-center">8 Hrs / 80 KM</th>
                <th class="px-4 py-4 text-center">10 Hrs / 100 KM</th>
                <th class="px-4 py-4 text-center">12 Hrs / 120 KM</th>
                <th class="px-4 py-4 text-center">Extra KM</th>
                <th class="px-4 py-4 text-center">Extra Hr</th>
                <th class="px-4 py-4 text-right">Book</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-m3-outline-variant/40">
              {vehicles.map(([name, v]: [string, any], i) => (
                <tr class={i % 2 === 0 ? "bg-m3-surface hover:bg-m3-surface-container transition-colors" : "bg-m3-surface-container-lowest hover:bg-m3-surface-container transition-colors"}>
                  <td class={`px-5 py-3.5 font-bold text-m3-on-surface sticky left-0 z-10 font-heading ${i % 2 === 0 ? "bg-m3-surface" : "bg-m3-surface-container-lowest"}`}>
                    <div class="flex items-center gap-3">
                      <div class="w-14 h-9 shrink-0 flex items-center justify-center bg-m3-surface-container-low rounded-m3-md p-1 border border-m3-outline-variant/50">
                        <img
                          src={vehicleImages[name] || "/images/fleet/swift-dzire.webp"}
                          alt={`${name} taxi rental in Chennai`}
                          width="56"
                          height="36"
                          decoding="async"
                          class="max-w-full max-h-full object-contain"
                          loading="lazy"
                        />
                      </div>
                      <div>
                        <div class="flex items-center gap-1.5">
                          <span class="text-sm font-bold text-m3-on-surface">{name}</span>
                          {name === "Maruti Ertiga" && (
                            <span class="text-micro font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-m3-xs bg-m3-surface-container-high text-m3-on-surface border border-m3-outline-variant">7-Seater</span>
                          )}
                        </div>
                        <span class="text-micro text-m3-primary font-semibold uppercase tracking-wider block">{vehicleBadges[name]}</span>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 text-center text-m3-on-surface-variant font-medium whitespace-nowrap">{vehicleCapacity[name] || "4 Pax"}</td>
                  <td class="px-4 py-3.5 text-center font-bold text-m3-on-surface">
                    ₹{v.local_5hr_pkg ? v.local_5hr_pkg.toLocaleString("en-IN") : "-"}
                  </td>
                  <td class="px-4 py-3.5 text-center font-bold text-m3-on-surface">
                    ₹{v.local_8hr_pkg ? v.local_8hr_pkg.toLocaleString("en-IN") : "-"}
                  </td>
                  <td class="px-4 py-3.5 text-center font-bold text-m3-on-surface">
                    ₹{v.local_10hr_pkg ? v.local_10hr_pkg.toLocaleString("en-IN") : "-"}
                  </td>
                  <td class="px-4 py-3.5 text-center font-bold text-m3-on-surface">
                    ₹{v.local_12hr_pkg ? v.local_12hr_pkg.toLocaleString("en-IN") : "-"}
                  </td>
                  <td class="px-4 py-3.5 text-center font-bold text-m3-on-surface">
                    ₹{v.extra_km_rate || 15}/km
                  </td>
                  <td class="px-4 py-3.5 text-center font-bold text-m3-on-surface">
                    ₹{v.extra_hr_rate || 150}/hr
                  </td>
                  <td class="px-4 py-3.5 text-right whitespace-nowrap">
                    <a
                      href={`https://wa.me/916381939769?text=${encodeURIComponent(`Hi Kalidass Travels, I would like to book a ${name} for a local Chennai city package.`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 px-3 py-1.5 rounded-m3-full bg-emerald-600 hover:bg-emerald-700 text-white text-micro font-bold shadow-xs transition-all"
                    >
                      <span>Book</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Cards View (Default on mobile, toggleable on desktop) */}
        <div id="local-cards-view" class="block md:hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {vehicles.map(([name, v]: [string, any]) => (
              <div class="bg-m3-surface rounded-m3-xl p-4 sm:p-5 border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between hover:shadow-m3-2 transition-all">
                <div>
                  <!-- Header with vehicle name, badge, and prominent CAR IMAGE -->
                  <div class="flex items-center justify-between gap-3 mb-3.5">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="font-bold text-m3-on-surface text-base font-heading">{name}</span>
                        {name === "Maruti Ertiga" && (
                          <span class="text-micro font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-m3-xs bg-m3-surface-container-high text-m3-on-surface border border-m3-outline-variant">7-Seater</span>
                        )}
                      </div>
                      <div class="flex items-center gap-2 mt-1">
                        <span class="text-micro text-m3-primary font-bold uppercase tracking-wider">{vehicleBadges[name]}</span>
                        <span class="text-micro text-m3-on-surface-variant font-medium bg-m3-surface-container-high px-2 py-0.5 rounded-m3-full">
                          {vehicleCapacity[name] || "4 Pax"}
                        </span>
                      </div>
                    </div>
                    <div class="shrink-0 w-20 h-13 sm:w-24 sm:h-15 flex items-center justify-center bg-m3-surface-container-low rounded-m3-lg p-1.5 border border-m3-outline-variant/50">
                      <img
                        src={vehicleImages[name] || "/images/fleet/swift-dzire.webp"}
                        alt={`${name} taxi rental in Chennai`}
                        width="96"
                        height="56"
                        decoding="async"
                        class="max-w-full max-h-full object-contain"
                        loading="lazy"
                      />
                    </div>
                  </div>

                  <!-- Rate Grid -->
                  <div class="grid grid-cols-2 gap-2 text-center text-xs mb-3">
                    <div class="bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/50">
                      <div class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">5 Hr / 50 KM</div>
                      <div class="text-sm font-bold text-m3-on-surface mt-0.5">₹{v.local_5hr_pkg ? v.local_5hr_pkg.toLocaleString("en-IN") : "-"}</div>
                    </div>
                    <div class="bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/50">
                      <div class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">8 Hr / 80 KM</div>
                      <div class="text-sm font-bold text-m3-on-surface mt-0.5">₹{v.local_8hr_pkg ? v.local_8hr_pkg.toLocaleString("en-IN") : "-"}</div>
                    </div>
                    <div class="bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/50">
                      <div class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">10 Hr / 100 KM</div>
                      <div class="text-sm font-bold text-m3-on-surface mt-0.5">₹{v.local_10hr_pkg ? v.local_10hr_pkg.toLocaleString("en-IN") : "-"}</div>
                    </div>
                    <div class="bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/50">
                      <div class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">12 Hr / 120 KM</div>
                      <div class="text-sm font-bold text-m3-on-surface mt-0.5">₹{v.local_12hr_pkg ? v.local_12hr_pkg.toLocaleString("en-IN") : "-"}</div>
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-badge text-m3-on-surface-variant pt-2 border-t border-m3-outline-variant/40 px-1 mb-3">
                    <span>Extra KM: <strong class="text-m3-on-surface">₹{v.extra_km_rate || 15}/km</strong></span>
                    <span>Extra Hr: <strong class="text-m3-on-surface">₹{v.extra_hr_rate || 150}/hr</strong></span>
                  </div>
                </div>

                <a
                  href={`https://wa.me/916381939769?text=${encodeURIComponent(`Hi Kalidass Travels, I would like to book a ${name} for a local Chennai city package.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-m3-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition-all"
                >
                  <span class="material-symbols-outlined text-[16px]">chat</span>
                  <span>Book {name} Local</span>
                </a>
              </div>
            ))}
          </div>
        </div>

        <p class="text-xs text-m3-on-surface-variant mt-3 font-sans">
