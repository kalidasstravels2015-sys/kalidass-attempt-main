          >
            <span>Live Fare Calculator</span>
            <svg class="w-4 h-4 text-emerald-400 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a
            href="tel:+916381939769"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-m3-surface-container-high hover:bg-m3-surface-container-highest text-m3-on-surface font-bold rounded-m3-full transition-all text-sm shadow-m3-1"
          >
