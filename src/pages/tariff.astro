                    <div class="bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/60">
                      <div class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">One Way</div>
                      <div class="text-sm font-bold text-m3-on-surface mt-0.5">₹{v.one_way_rate} <span class="text-badge font-normal text-m3-on-surface-variant">/km</span></div>
                    </div>
                    <div class="bg-m3-surface-container-low p-2.5 rounded-m3-md border border-m3-outline-variant/60">
                      <div class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">Round Trip</div>
                      <div class="text-sm font-bold text-m3-on-surface mt-0.5">₹{v.round_trip_rate} <span class="text-badge font-normal text-m3-on-surface-variant">/km</span></div>
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-badge text-m3-on-surface-variant pt-2 border-t border-m3-outline-variant/40 px-1 mb-3">
                    <span>Min Run: <strong class="text-m3-on-surface">{v.min_km_per_day} km/day</strong></span>
                    <span>Driver Bata: <strong class="text-m3-on-surface">₹{v.driver_bata}/day</strong></span>
                  </div>
                </div>

                <a
                  href={`https://wa.me/916381939769?text=${encodeURIComponent(`Hi Kalidass Travels, I would like to book an outstation cab (${name}) from Chennai.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-m3-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition-all"
                >
                  <span class="material-symbols-outlined text-[16px]">chat</span>
                  <span>Book {name} Outstation</span>
                </a>
              </div>
            ))}
          </div>
        </div>

        <p class="text-xs text-m3-on-surface-variant mt-3 font-sans">
          * Outstation billing is based on a standard minimum of 250 km per calendar day (300 km for Innova Crysta and Tempo Traveller). One-way drop trips have a 130 km minimum (250 km for Tempo Traveller). Driver bata covers daily driver food and accommodation allowance.
        </p>
      </div>

      <!-- Interactive View Switcher Script (Cards View / Table View) -->
      <script is:inline>
        (function() {
          function initSwitchers() {
            function setupSwitcher(btnTableId, btnCardsId, tableId, cardsId) {
              const btnTable = document.getElementById(btnTableId);
              const btnCards = document.getElementById(btnCardsId);
              const viewTable = document.getElementById(tableId);
              const viewCards = document.getElementById(cardsId);

              if (btnTable && btnCards && viewTable && viewCards) {
                if (btnTable.dataset.switcherBound === 'true') return;
                btnTable.dataset.switcherBound = 'true';

                btnTable.addEventListener('click', function() {
                  // Show Table on desktop, hide Cards on desktop
                  viewTable.classList.remove('md:hidden');
                  viewTable.classList.add('hidden', 'md:block');
                  viewCards.classList.remove('md:block');
                  viewCards.classList.add('block', 'md:hidden');

                  btnTable.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs', 'font-bold');
                  btnTable.classList.remove('text-m3-on-surface-variant', 'font-medium');
                  btnTable.setAttribute('aria-pressed', 'true');

                  btnCards.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs', 'font-bold');
                  btnCards.classList.add('text-m3-on-surface-variant', 'font-medium');
                  btnCards.setAttribute('aria-pressed', 'false');
                });

                btnCards.addEventListener('click', function() {
                  // Hide Table on desktop, show Cards on desktop
                  viewTable.classList.remove('md:block');
                  viewTable.classList.add('hidden', 'md:hidden');
                  viewCards.classList.remove('md:hidden');
                  viewCards.classList.add('block', 'md:block');

                  btnCards.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs', 'font-bold');
                  btnCards.classList.remove('text-m3-on-surface-variant', 'font-medium');
                  btnCards.setAttribute('aria-pressed', 'true');

                  btnTable.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-xs', 'font-bold');
                  btnTable.classList.add('text-m3-on-surface-variant', 'font-medium');
                  btnTable.setAttribute('aria-pressed', 'false');
                });
              }
            }

            setupSwitcher('local-btn-table', 'local-btn-cards', 'local-table-view', 'local-cards-view');
            setupSwitcher('outstation-btn-table', 'outstation-btn-cards', 'outstation-table-view', 'outstation-cards-view');
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSwitchers);
          } else {
            initSwitchers();
          }
          document.addEventListener('astro:page-load', initSwitchers);
        })();
      </script>

      <!-- Subtle Corporate Mobility Cross-Link -->
      <div class="bg-m3-surface-container-low border border-m3-outline-variant/60 rounded-m3-lg p-4 sm:p-5 mb-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-m3-primary text-2xl shrink-0">business_center</span>
