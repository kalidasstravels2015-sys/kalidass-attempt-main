---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/SEO/Breadcrumbs.astro";
import WhatsAppIcon from "../../components/WhatsAppIcon.astro";
import { getAllDrivers, type Driver } from "../../data/driversData";

export async function getStaticPaths() {
  const drivers = getAllDrivers();
  return drivers.map((driver) => ({
    params: { slug: driver.slug },
    props: { driver },
  }));
}

interface Props {
  driver: Driver;
}

const { driver } = Astro.props;

const site = "https://kalidasstravels.in";
const canonicalURL = `${site}/drivers/${driver.slug}/`;

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Drivers", item: "/drivers/" },
  { name: driver.name, item: `/drivers/${driver.slug}/` },
];

const waText = encodeURIComponent(
  `Hi Kalidass Travels, I would like to book driver *${driver.name}* for a trip.\n\n` +
  `Specialty: ${driver.specialty}\n` +
  `Experience: ${driver.experience}\n` +
  `Driver Profile: ${canonicalURL}`
);

// Minimal clean Schema.org Person
const personSchema = {
  "@type": "Person",
  "@id": `${canonicalURL}#person`,
  "name": driver.name,
  "jobTitle": "Professional Driver",
  "description": `${driver.experience} driving experience. Specialist in ${driver.specialty}. Languages: ${driver.languages}. Police background verified.`,
  "image": `${site}${driver.image}`,
  "url": canonicalURL,
  "worksFor": {
    "@type": "TravelAgency",
    "@id": "https://kalidasstravels.in/#localbusiness",
    "name": "Kalidass Travels"
  }
};
---

<Layout
  title={`${driver.name} – Verified Driver ID Card | Kalidass Travels`}
  description={`Official verified ID card for ${driver.name}: ${driver.experience}, ${driver.specialty}. Police verification (PVC) and commercial driving license verified.`}
  schema={personSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="py-6 sm:py-10 bg-slate-100 text-slate-900 min-h-screen font-sans">
    <div class="max-w-lg mx-auto px-4 sm:px-6">

      <!-- Clean Back Link (No icon glitch) -->
      <div class="mb-4">
        <a
          href="/drivers/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-950 transition-colors"
        >
          <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to All Drivers</span>
        </a>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- SINGLE UNIFIED DRIVER IDENTIFICATION CARD -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <div class="bg-white rounded-2xl border-2 border-slate-300 shadow-xl overflow-hidden mb-5">
        
        <!-- ID Card Header -->
        <div class="bg-slate-900 text-white px-4 py-3.5 flex items-center justify-between border-b border-slate-800">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-amber-400 text-slate-950 flex items-center justify-center font-black text-xs shadow-sm">
              KT
            </span>
            <div>
              <span class="text-xs font-bold tracking-wider uppercase block text-amber-400 leading-none font-heading">
                Kalidass Travels
              </span>
              <span class="text-[10px] text-slate-300">Driver Identification Card</span>
            </div>
          </div>

          <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-400 bg-emerald-950/80 border border-emerald-500/40 px-2 py-0.5 rounded">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>VERIFIED PVC</span>
          </span>
        </div>

        <!-- ID Card Body -->
        <div class="p-5">
          
          <!-- Top Row: Photo + Core Identity -->
          <div class="flex flex-col sm:flex-row gap-4 items-center sm:items-start pb-4 border-b border-slate-200 text-center sm:text-left">
            <!-- Driver Photo -->
            <div class="relative w-28 h-28 rounded-xl overflow-hidden border-2 border-slate-300 bg-slate-50 shrink-0 shadow-sm">
              <img
                src={driver.image}
                alt={driver.name}
                width="112"
                height="112"
                class="w-full h-full object-cover object-center"
              />
              <span class="absolute bottom-1 left-1 bg-slate-950/90 text-amber-300 text-[9px] font-bold px-1.5 py-0.5 rounded shadow">
                {driver.tag}
              </span>
            </div>

            <!-- Driver Basic Info -->
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5 mb-1">
                <h1 class="text-lg sm:text-xl font-black text-slate-950 tracking-tight font-heading">
                  {driver.name.toUpperCase()}
                </h1>
                <span class="inline-flex items-center gap-0.5 bg-amber-50 border border-amber-200 text-amber-800 px-1.5 py-0.5 rounded text-[11px] font-bold">
                  ★ {driver.rating}
                </span>
              </div>

              <div class="text-xs font-semibold text-blue-700 mb-2">
                {driver.specialty}
              </div>

              <div class="text-xs text-slate-700 space-y-1">
                <div>
                  <span class="text-slate-500 font-medium">Experience:</span> 
                  <strong class="text-slate-900">{driver.experience}</strong> 
                  <span class="text-slate-500">({driver.trips} trips)</span>
                </div>
                <div>
                  <span class="text-slate-500 font-medium">Languages:</span> 
                  <span class="text-slate-900 font-semibold">{driver.languages}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Official Verification Endorsements -->
          <div class="pt-4 space-y-3">
            
            <!-- 1. Driving License Row (Privacy Masked) -->
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
              <div class="text-xs font-bold text-slate-900 mb-1.5 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px] text-blue-600">directions_car</span>
                  <span>Driving License (RTO Verified)</span>
                </div>
                <span class="text-[10px] text-slate-500 font-mono">TN-RTO</span>
              </div>

              <div class="text-xs space-y-1.5 text-slate-800">
                <div class="flex items-center justify-between">
                  <span class="text-slate-500">License Type:</span>
                  <strong class="text-slate-900">{driver.licenseType}</strong>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-500">License Number:</span>
                  <span class="font-mono text-slate-900 font-bold tracking-wider">
                    {driver.licenseMasked.slice(0, 6)}<span class="line-through decoration-slate-400 text-slate-400 select-none">XXXXXX</span>{driver.licenseMasked.slice(-2)}
                  </span>
                </div>
              </div>
              <p class="text-[10px] text-slate-400 mt-1.5 italic">
                * Middle digits masked for privacy; commercial badge &amp; RTO category verified.
              </p>
            </div>

            <!-- 2. Police Verification Row (PVC) -->
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
              <div class="text-xs font-bold text-slate-900 mb-1.5 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px] text-emerald-600">verified_user</span>
                  <span>Police Clearance (PVC)</span>
                </div>
                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">
                  CLEARED
                </span>
              </div>

              <div class="text-xs space-y-1.5 text-slate-800">
                <div class="flex items-center justify-between">
                  <span class="text-slate-500">Background Status:</span>
                  <strong class="text-emerald-700">✅ {driver.pvcStatus} (No Police Record)</strong>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-500">Certificate No:</span>
                  <span class="font-mono text-slate-700">{driver.pvcNumber}</span>
                </div>
              </div>
            </div>

            <!-- 3. Authorized By Strip -->
            <div class="pt-2 flex items-center justify-between text-xs text-slate-600 border-t border-slate-200">
              <div>
                <span class="block text-[10px] text-slate-400 leading-none mb-0.5">Authorized by:</span>
                <strong class="text-slate-900">Kalidass Travels Chennai</strong>
              </div>
              <div class="text-right">
                <span class="block text-[10px] text-slate-400 leading-none mb-0.5">24/7 Helpline:</span>
                <a href="tel:+916381939769" class="font-bold text-blue-700 hover:underline">+91 63819 39769</a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Action Buttons Directly Below Card -->
      <div class="space-y-2.5">
        <a
          href={`https://wa.me/916381939769?text=${waText}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-sm shadow-sm transition-all text-center"
        >
          <WhatsAppIcon class="w-4 h-4" variant="brand" />
          <span>Book {driver.name} on WhatsApp</span>
        </a>

        <a
          href="tel:+916381939769"
          class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors text-center"
        >
          <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>Call Dispatch (+91 63819 39769)</span>
        </a>
      </div>

    </div>
  </main>
</Layout>
