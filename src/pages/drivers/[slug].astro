---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/SEO/Breadcrumbs.astro";
import WhatsAppIcon from "../../components/WhatsAppIcon.astro";
import { getAllDrivers, type Driver } from "../../data/driversData";
import { ShieldCheck, Car, Route, ArrowRight, CheckCircle2, Phone } from "lucide-react";

export async function getStaticPaths() {
  const drivers = getAllDrivers();
  return drivers.map((driver) => ({
    params: { slug: driver.slug },
    props: { driver },
  }));
}

interface Props {
  driver: Driver;
}

const { driver } = Astro.props;

const site = "https://kalidasstravels.in";
const canonicalURL = `${site}/drivers/${driver.slug}/`;

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Drivers", item: "/drivers/" },
  { name: driver.name, item: `/drivers/${driver.slug}/` },
];

const waText = encodeURIComponent(
  `Hi Kalidass Travels, I would like to book driver *${driver.name}* for a trip.\n\n` +
  `Specialty: ${driver.specialty}\n` +
  `Experience: ${driver.experience}\n` +
  `Driver Profile: ${canonicalURL}`
);

// Route highlights based on specialty
const isHillSpecialist = driver.specialty.toLowerCase().includes("hill") || driver.specialty.toLowerCase().includes("ooty");
const isTempleSpecialist = driver.specialty.toLowerCase().includes("temple") || driver.specialty.toLowerCase().includes("tirupati") || driver.specialty.toLowerCase().includes("sabarimala") || driver.specialty.toLowerCase().includes("pilgrimage");
const isAirportSpecialist = driver.specialty.toLowerCase().includes("airport") || driver.specialty.toLowerCase().includes("city");
const isCorporateSpecialist = driver.specialty.toLowerCase().includes("corporate") || driver.specialty.toLowerCase().includes("luxury") || driver.specialty.toLowerCase().includes("vvip");

const specializedRoutes = isTempleSpecialist ? [
  { name: "Chennai to Tirupati Balaji Darshan", link: "/services/tirupati-package/" },
  { name: "Kumbakonam 9 Navagraha Temple Tour", link: "/services/navagraha-tour/" },
  { name: "Thiruvannamalai Girivalam Package", link: "/services/thiruvannamalai-girivalam-trip/" },
  { name: "Rameswaram & Dhanushkodi Pilgrimage", link: "/services/rameswaram-2-days/" }
] : isHillSpecialist ? [
  { name: "Chennai to Yelagiri Hills Weekend Trip", link: "/services/yelagiri-hills-weekend/" },
  { name: "Chennai to Yercaud Shevaroy Hills", link: "/services/yercaud-hills-weekend/" },
  { name: "Outstation Cabs from Chennai", link: "/services/outstation-cabs/" },
  { name: "Outstation Acting Driver Duties", link: "/services/acting-driver-outstation-round-trip/" }
] : isAirportSpecialist ? [
  { name: "Chennai Airport 24/7 Taxi (MAA)", link: "/services/chennai-airport-taxi/" },
  { name: "Velachery to Airport Transfers", link: "/services/velachery-airport-taxi/" },
  { name: "Tambaram to Airport Transfers", link: "/services/tambaram-airport-taxi/" },
  { name: "Local Chennai Hourly Acting Drivers", link: "/services/acting-driver-within-chennai/" }
] : [
  { name: "Outstation Cabs Across South India", link: "/services/outstation-cabs/" },
  { name: "Corporate Employee Mobility (ETS)", link: "/services/corporate/" },
  { name: "Chennai Airport Taxi Service", link: "/services/chennai-airport-taxi/" },
  { name: "Personal Car Acting Chauffeur", link: "/services/acting-driver-within-chennai/" }
];

const faqs = [
  {
    q: `Can I specifically request ${driver.name} for my trip?`,
    a: `Yes! You can reserve ${driver.name} directly by sharing your travel dates and route via WhatsApp or telephone dispatch. If ${driver.name} is scheduled on another outstation duty, our operations desk will match you with a driver of equal seniority and route specialization.`
  },
  {
    q: `What vehicle categories can ${driver.name} drive?`,
    a: `${driver.name} is licensed for ${driver.licenseType} and possesses thorough operational expertise across manual, automatic, AMT, hybrid, and electric passenger vehicles, including Sedans (Dzire, Etios), SUVs (Ertiga, Innova Crysta), and group carriers.`
  },
  {
    q: `How has ${driver.name}'s background been verified?`,
    a: `${driver.name} has undergone thorough police verification with certificate number ${driver.pvcNumber}, commercial badge validation by the Tamil Nadu Transport Department, continuous telemetry monitoring, and periodic health screenings.`
  },
  {
    q: `What are the driver allowances (Batta) for outstation trips?`,
    a: `For all-inclusive packages (such as Tirupati Balaji or Navagraha packages), driver batta is 100% included. For open outstation per-km rentals, driver batta is transparently billed at ₹400–₹600 per calendar day depending on the vehicle class.`
  }
];

// Schema.org Person & FAQPage
const personSchema = {
  "@type": "Person",
  "@id": `${canonicalURL}#person`,
  "name": driver.name,
  "jobTitle": "Professional Chauffeur",
  "description": `${driver.experience} driving experience. Specialist in ${driver.specialty}. Languages: ${driver.languages}. Police background verified (PVC Cleared).`,
  "image": `${site}${driver.image}`,
  "url": canonicalURL,
  "worksFor": {
    "@type": "TravelAgency",
    "@id": "https://kalidasstravels.in/#localbusiness",
    "name": "Kalidass Travels"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${canonicalURL}#faq`,
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={`${driver.name} – Verified Chauffeur (${driver.experience}) | Kalidass Travels`}
  description={`Verified driver profile for ${driver.name}: ${driver.experience}, ${driver.specialty}. Police verified (PVC cleared), ${driver.trips} trips, rating ${driver.rating}/5 at Kalidass Travels Chennai.`}
  schema={[personSchema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="py-6 sm:py-10 bg-m3-surface text-m3-on-surface min-h-screen font-sans">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <!-- Breadcrumbs Back Link -->
      <div class="mb-4">
        <a
          href="/drivers/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-m3-on-surface-variant hover:text-m3-on-surface transition-colors"
        >
          <svg class="w-4 h-4 text-m3-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to All Verified Drivers</span>
        </a>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- 1. UNIFIED DRIVER IDENTIFICATION CARD -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant shadow-m3-2 overflow-hidden mb-6">
        
        <!-- ID Card Header -->
        <div class="bg-m3-primary text-m3-on-primary px-4 py-3.5 flex items-center justify-between border-b border-white/10">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-m3-md bg-m3-tertiary-container text-m3-on-tertiary-container flex items-center justify-center font-black text-xs shadow-xs font-heading">
              KT
            </span>
            <div>
              <span class="text-xs font-bold tracking-wider uppercase block text-m3-tertiary-fixed leading-none font-heading">
                Kalidass Travels
              </span>
              <span class="text-xs text-m3-on-primary/80">Driver Identification &amp; Credentials Card</span>
            </div>
          </div>

          <span class="inline-flex items-center gap-1 text-xs font-bold text-m3-success-container bg-m3-success/20 border border-m3-success/40 px-2.5 py-0.5 rounded-m3-full">
            <span class="w-1.5 h-1.5 rounded-full bg-m3-success animate-pulse"></span>
            <span>VERIFIED PVC</span>
          </span>
        </div>

        <!-- ID Card Body -->
        <div class="p-5 sm:p-6">
          
          <!-- Top Row: Photo + Core Identity -->
          <div class="flex flex-col sm:flex-row gap-5 items-center sm:items-start pb-5 border-b border-m3-outline-variant/60 text-center sm:text-left">
            <!-- Driver Photo -->
            <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-m3-lg overflow-hidden border border-m3-outline-variant bg-m3-surface-container shrink-0 shadow-xs">
              <img
                src={driver.image}
                alt={`${driver.name} - Verified Chauffeur at Kalidass Travels`}
                width="128"
                height="128"
                class="w-full h-full object-cover object-center"
              />
              <span class="absolute bottom-1 left-1 bg-m3-primary/90 text-m3-tertiary-fixed text-xs font-bold px-1.5 py-0.5 rounded-m3-xs shadow-xs">
                {driver.tag}
              </span>
            </div>

            <!-- Driver Core Info -->
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1.5">
                <h1 class="text-xl sm:text-2xl font-black text-m3-on-surface tracking-tight font-heading">
                  {driver.name.toUpperCase()}
                </h1>
                <span class="inline-flex items-center gap-1 bg-m3-tertiary-container/30 border border-m3-tertiary/20 text-m3-tertiary px-2 py-0.5 rounded-m3-full text-xs font-bold">
                  ★ {driver.rating} ({driver.reviews || '50+'} Reviews)
                </span>
              </div>

              <div class="text-xs sm:text-sm font-semibold text-m3-primary mb-2">
                Specialty: {driver.specialty}
              </div>

              <div class="text-xs text-m3-on-surface-variant space-y-1.5">
                <div>
                  <span class="text-m3-on-surface-variant font-medium">Driving Experience:</span> 
                  <strong class="text-m3-on-surface font-bold">{driver.experience}</strong> 
                  <span class="text-m3-on-surface-variant font-medium">({driver.trips} verified trips completed)</span>
                </div>
                <div>
                  <span class="text-m3-on-surface-variant font-medium">Languages Spoken:</span> 
                  <span class="text-m3-on-surface font-semibold">{driver.languages}</span>
                </div>
                <div>
                  <span class="text-m3-on-surface-variant font-medium">Duty Availability:</span> 
                  <span class="text-m3-success font-bold">24/7 Doorstep Dispatch (Chennai &amp; Suburbs)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Official Verification Endorsements -->
          <div class="pt-5 space-y-3">
            <div class="flex items-center gap-1.5 pb-0.5">
              <ShieldCheck className="w-4 h-4 text-m3-success shrink-0" />
              <h2 class="text-xs sm:text-sm font-bold text-m3-on-surface uppercase tracking-wider font-heading">Official Verification &amp; Clearance Status</h2>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- 1. Driving License Row -->
              <div class="bg-m3-surface-container-low rounded-m3-xl p-3.5 border border-m3-outline-variant/60">
                <div class="text-xs font-bold text-m3-on-surface mb-1.5 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <Car className="w-4 h-4 text-m3-primary shrink-0" />
                    <span>Driving License (RTO)</span>
                  </div>
                  <span class="text-xs text-m3-on-surface-variant font-mono">TN Commercial</span>
                </div>

                <div class="text-xs space-y-1 text-m3-on-surface">
                  <div class="flex items-center justify-between">
                    <span class="text-m3-on-surface-variant">Badge Type:</span>
                    <strong class="text-m3-on-surface">{driver.licenseType}</strong>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-m3-on-surface-variant">DL Identifier:</span>
                    <span class="font-mono text-m3-on-surface font-bold tracking-wider">
                      {driver.licenseMasked.slice(0, 6)}<span class="line-through decoration-m3-outline text-m3-outline select-none">XXXXXX</span>{driver.licenseMasked.slice(-2)}
                    </span>
                  </div>
                </div>
                <p class="text-xs text-m3-on-surface-variant mt-1 font-normal">
                  * Commercial badge &amp; RTO category verified; middle digits masked for privacy.
                </p>
              </div>

              <!-- 2. Police Verification Row (PVC) -->
              <div class="bg-m3-surface-container-low rounded-m3-xl p-3.5 border border-m3-outline-variant/60">
                <div class="text-xs font-bold text-m3-on-surface mb-1.5 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <ShieldCheck className="w-4 h-4 text-m3-success shrink-0" />
                    <span>Police Clearance (PVC)</span>
                  </div>
                  <span class="text-xs font-bold text-m3-on-success-container bg-m3-success-container/70 px-1.5 py-0.5 rounded-m3-xs">
                    CLEARED
                  </span>
                </div>

                <div class="text-xs space-y-1 text-m3-on-surface">
                  <div class="flex items-center justify-between">
                    <span class="text-m3-on-surface-variant">Police Check:</span>
                    <strong class="text-m3-success">✅ {driver.pvcStatus}</strong>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-m3-on-surface-variant">Certificate No:</span>
                    <span class="font-mono text-m3-on-surface font-semibold">{driver.pvcNumber}</span>
                  </div>
                </div>
                <p class="text-xs text-m3-on-surface-variant mt-1 font-normal">
                  * Official Tamil Nadu Police background clearance certificate on file.
                </p>
              </div>
            </div>

            <!-- Authorized By Strip -->
            <div class="pt-3 flex items-center justify-between text-xs text-m3-on-surface-variant border-t border-m3-outline-variant/60">
              <div>
                <span class="block text-xs text-m3-on-surface-variant leading-none mb-0.5">Fleet Organization:</span>
                <strong class="text-m3-on-surface">Kalidass Travels Chennai (Regd. Medavakkam)</strong>
              </div>
              <div class="text-right">
                <span class="block text-xs text-m3-on-surface-variant leading-none mb-0.5">24/7 Dispatch Desk:</span>
                <a href="tel:+918939539211" class="font-bold text-m3-primary hover:underline">+91 89395 39211</a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Action Buttons Directly Below Card -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
        <a
          href={`https://wa.me/918939539211?text=${waText}`}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="inline-flex items-center justify-center min-h-[44px] gap-2 py-3 px-5 rounded-m3-full bg-m3-success-container hover:bg-m3-success/20 active:bg-m3-success/30 text-m3-on-success-container border border-m3-success/30 font-bold text-sm shadow-xs transition-all text-center"
        >
          <WhatsAppIcon class="w-4 h-4" variant="brand" />
          <span>Book {driver.name} on WhatsApp</span>
        </a>

        <a
          href="tel:+918939539211"
          class="inline-flex items-center justify-center min-h-[44px] gap-2 py-3 px-5 rounded-m3-full bg-m3-primary hover:bg-m3-primary/90 text-m3-on-primary font-bold text-sm shadow-m3-1 transition-colors text-center"
        >
          <Phone className="w-4 h-4 text-m3-on-primary shrink-0" />
          <span>Call Dispatch (+91 89395 39211)</span>
        </a>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- 2. PROFESSIONAL PROFILE & ROUTE EXPERTISE -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant/60 p-5 sm:p-7 shadow-m3-1 mb-6 space-y-5">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading mb-2">
            About {driver.name} – Professional Driving Background
          </h2>
          <p class="text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed">
            With over <strong>{driver.experience}</strong> of professional commercial driving across Tamil Nadu, Andhra Pradesh, Karnataka, and Kerala, {driver.name} is one of our senior team members at Kalidass Travels. Having completed <strong>{driver.trips}+ trips</strong> with an exceptional customer satisfaction rating of <strong>{driver.rating}/5</strong>, {driver.name} is known for punctual reporting, calm defensive driving, clean vehicle upkeep, and extensive local highway intelligence.
          </p>
        </div>

        <div>
          <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface uppercase tracking-wider mb-2.5 font-heading">
            Primary Corridors &amp; Trip Specializations
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {specializedRoutes.map((r) => (
              <a
                href={r.link}
                class="flex items-center justify-between p-3 rounded-m3-xl bg-m3-surface-container-low hover:bg-m3-surface-container border border-m3-outline-variant/60 hover:border-m3-primary/40 transition-colors group"
              >
                <div class="flex items-center gap-2 text-xs font-semibold text-m3-on-surface group-hover:text-m3-primary">
                  <Route className="w-4 h-4 text-m3-primary shrink-0" />
                  <span>{r.name}</span>
                </div>
                <ArrowRight className="w-4 h-4 text-m3-on-surface-variant group-hover:text-m3-primary transition-colors shrink-0" />
              </a>
            ))}
          </div>
        </div>

        <!-- Safety Commitments -->
        <div class="pt-2 border-t border-m3-outline-variant/40">
          <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface uppercase tracking-wider mb-2.5 font-heading">
            Verified Safety &amp; Etiquette Checklist
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-m3-on-surface-variant">
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-m3-success shrink-0" />
              <span>100% Teetotaler &amp; Non-Smoker</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-m3-success shrink-0" />
              <span>Zero-Accident Clean Highway Record</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-m3-success shrink-0" />
              <span>Comfortable in Manual, Automatic &amp; Luxury EVs</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-m3-success shrink-0" />
              <span>Real-Time GPS Tracking &amp; Route Telemetry</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- 3. FREQUENTLY ASKED QUESTIONS -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant/60 p-5 sm:p-7 shadow-m3-1 mb-6">
        <h2 class="text-base sm:text-lg font-bold text-m3-on-surface font-heading mb-4">
          Frequently Asked Questions About Booking {driver.name}
        </h2>
        <div class="space-y-4">
          {faqs.map((f) => (
            <div class="border-b border-m3-outline-variant/40 pb-3 last:border-b-0 last:pb-0">
              <h3 class="text-xs sm:text-sm font-bold text-m3-on-surface mb-1">
                {f.q}
              </h3>
              <p class="text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed">
                {f.a}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- 4. QUICK EXPLORE RELATED SERVICES -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <div class="bg-m3-surface-container-lowest rounded-m3-2xl border border-m3-outline-variant/60 p-5 sm:p-7 shadow-m3-1">
        <h2 class="text-sm font-bold text-m3-on-surface uppercase tracking-wider mb-3 font-heading">
          Explore Kalidass Travels Mobility Services
        </h2>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="/services/chennai-airport-taxi/" class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold transition-colors">
            Chennai Airport Taxi
          </a>
          <a href="/services/outstation-cabs/" class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold transition-colors">
            Outstation Cabs (₹14/km)
          </a>
          <a href="/services/acting-drivers/" class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold transition-colors">
            Acting Drivers in Chennai
          </a>
          <a href="/services/tirupati-package/" class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold transition-colors">
            Tirupati Balaji Package
          </a>
          <a href="/tariff/" class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold transition-colors">
            Transparent Tariff Card
          </a>
          <a href="/calculator/" class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 rounded-m3-full bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold transition-colors">
            Fare Calculator
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>
