---
import Layout from "../../layouts/Layout.astro";
import siteContent from "../../data/siteContent.json";
import Breadcrumbs from "../../components/SEO/Breadcrumbs.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Star, Clock, Languages, ShieldCheck, Car, MessageCircle, Download, MapPin, ArrowLeft, Phone } from "lucide-react";

function toSlug(name: string) {
  return name
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

export function getStaticPaths() {
  const toSlug = (name: string) =>
    name.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");

  return siteContent.drivers.map((driver) => ({
    params: { slug: toSlug(driver.name) },
    props: { driver },
  }));
}

const { driver } = Astro.props;
const slug = toSlug(driver.name);

const site = "https://kalidasstravels.in";
const profileUrl = `${site}/drivers/${slug}/`;

const waDriverShareText = encodeURIComponent(
  `Hi! 👋 I'm *${driver.name}*, a professional driver at *Kalidass Travels*.\n\n` +
  `⭐ *${driver.rating}* Rating  |  ${driver.trips} Trips  |  ${driver.experience}\n` +
  `✅ PVC Police Verified\n` +
  `🚗 Specialty: ${driver.specialty}\n\n` +
  `Book your next trip with me 👇\n` +
  `${profileUrl}`
);

const bookingWhatsAppUrl = `https://wa.me/919092303060?text=${encodeURIComponent(`Hi Kalidass Travels, I would like to book a trip with Driver ${driver.name}.`)}`;

const storyCardUrl = `/driver-cards/${slug}`;
const ogImageUrl = `${site}${driver.image}`;

const breadcrumbItems = [
  { name: "Home", item: "/" },
  { name: "Drivers", item: "/drivers/" },
  { name: driver.name, item: `/drivers/${slug}/` },
];
const driverPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": driver.name,
  "jobTitle": "Professional Chauffeur & Acting Driver",
  "worksFor": {
    "@id": "https://kalidasstravels.in/#localbusiness"
  },
  "description": `${driver.name} is a PVC police-verified professional driver with ${driver.experience} experience specializing in ${driver.specialty}.`,
  "image": ogImageUrl,
  "url": profileUrl
};
---

<Layout
  title={`${driver.name} – Verified Chauffeur & Acting Driver | Kalidass Travels`}
  description={`${driver.name} is a PVC verified driver with ${driver.experience} experience and ${driver.trips} trips, specializing in ${driver.specialty}. Book now with Kalidass Travels Chennai.`}
  keywords={`driver ${driver.name}, acting driver chennai, hire chauffeur chennai, ${driver.specialty} driver chennai, call driver ${driver.name}`}
  image={ogImageUrl}
  ogImage={ogImageUrl}
  type="profile"
  schema={driverPersonSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="bg-m3-surface text-m3-on-surface min-h-screen pb-24 pt-6 font-sans">
    <div class="max-w-lg mx-auto px-4 flex flex-col gap-4">

      <!-- ── PROFILE CARD ── -->
      <div class="bg-m3-surface rounded-m3-xl shadow-m3-1 overflow-hidden border border-m3-outline-variant">

        <!-- Photo with overlay -->
        <div class="relative">
          <img
            src={driver.image}
            alt={driver.alt || driver.name}
            class="w-full h-80 sm:h-96 object-cover object-top"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>

          <!-- Tag pill -->
          <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-slate-950/80 backdrop-blur-md border border-white/20 rounded-m3-full px-3 py-1">
            <span class="w-2 h-2 rounded-m3-full bg-m3-secondary"></span>
            <span class="text-white text-xs font-bold">{driver.tag}</span>
          </div>

          <!-- Rating pill -->
          <div class="absolute top-4 right-4 flex items-center gap-1.5 bg-slate-950/80 backdrop-blur-md text-white border border-white/20 px-3 py-1.5 rounded-m3-full shadow-m3-1 font-bold text-sm">
            <Star className="w-4 h-4 fill-gold-600 text-gold-600" />
            <span>{driver.rating}</span>
          </div>

          <!-- Name block -->
          <div class="absolute bottom-0 left-0 p-5">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight drop-shadow-sm font-heading">{driver.name}</h1>
            <p class="text-white/80 text-sm mt-0.5 font-normal">{driver.specialty}</p>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="grid grid-cols-3 divide-x divide-m3-outline-variant/60 border-b border-m3-outline-variant/60 bg-m3-surface-container-low">
          <div class="flex flex-col items-center py-3 gap-0.5">
            <span class="text-lg font-black text-m3-primary font-heading">{driver.rating}</span>
            <span class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">Rating</span>
          </div>
          <div class="flex flex-col items-center py-3 gap-0.5">
            <span class="text-lg font-black text-m3-primary font-heading">{driver.trips}</span>
            <span class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">Trips</span>
          </div>
          <div class="flex flex-col items-center py-3 gap-0.5">
            <span class="text-lg font-black text-m3-primary font-heading">{driver.reviews}</span>
            <span class="text-micro text-m3-on-surface-variant font-semibold uppercase tracking-wider">Reviews</span>
          </div>
        </div>

        <!-- Details -->
        <div class="p-5 space-y-3">
          <div class="inline-flex items-center gap-2 bg-m3-surface-container-high border border-m3-outline-variant rounded-m3-sm px-3 py-1.5">
            <ShieldCheck className="w-4 h-4 text-m3-primary" />
            <span class="text-xs font-bold text-m3-on-surface">PVC Police Background Verified</span>
          </div>

          <div class="grid grid-cols-1 gap-2.5 pt-1">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high flex items-center justify-center shrink-0">
                <Clock className="w-4 h-4 text-m3-primary" />
              </div>
              <div>
                <p class="text-micro text-m3-on-surface-variant uppercase tracking-wider font-bold">Experience</p>
                <p class="text-sm font-semibold text-m3-on-surface">{driver.experience}</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high flex items-center justify-center shrink-0">
                <Languages className="w-4 h-4 text-m3-primary" />
              </div>
              <div>
                <p class="text-micro text-m3-on-surface-variant uppercase tracking-wider font-bold">Languages</p>
                <p class="text-sm font-semibold text-m3-on-surface">{driver.languages}</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high flex items-center justify-center shrink-0">
                <Car className="w-4 h-4 text-m3-primary" />
              </div>
              <div>
                <p class="text-micro text-m3-on-surface-variant uppercase tracking-wider font-bold">Specialty</p>
                <p class="text-sm font-semibold text-m3-on-surface">{driver.specialty}</p>
              </div>
            </div>

            {driver.crossing_border && (
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-m3-md bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0">
                  <MapPin className="w-4 h-4 text-m3-primary" />
                </div>
                <div>
                  <p class="text-micro text-m3-on-surface-variant uppercase tracking-wider font-bold">Clearance</p>
                  <p class="text-sm font-semibold text-m3-on-surface">Cross-border driving approved</p>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- ── CUSTOMER CTA ── -->
        <div class="px-5 pb-5 space-y-2">
          <WhatsAppButton
            href={bookingWhatsAppUrl}
            size="lg"
            fullWidth={true}
            text={`Book Trip with ${driver.name}`}
            ariaLabel={`Book Trip with Driver ${driver.name} on WhatsApp`}
          />
          <p class="text-center text-badge text-m3-on-surface-variant">
            Zero advance deposit • Instant confirmation on WhatsApp
          </p>
        </div>
      </div>

      <!-- Back link -->
      <a href="/drivers" class="inline-flex items-center justify-center gap-1.5 text-center text-xs text-m3-primary hover:underline font-semibold py-2">
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>View All Drivers</span>
      </a>

    </div>
  </main>
</Layout>
