---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import BookingPanel from "../components/BookingPanel.astro";
import SectionNavigator from "../components/react/SectionNavigator.jsx";
import Services from "../components/Services.astro";
import FleetRoll from "../components/react/FleetRoll.jsx";
import Tours from "../components/Tours.astro";
import PartnersCarousel from "../components/react/PartnersCarousel.jsx";
import DriversCarousel from "../components/react/DriversCarousel.jsx";
import SafetySection from "../components/SafetySection.astro";
import Reviews from "../components/Reviews.astro";
import FAQ from "../components/FAQ.astro";
import ExitIntentModal from "../components/react/ExitIntentModal.jsx";
import BottomCTA from "../components/BottomCTA.astro";

const ogImage = "/images/og-main.png";

// Homepage WebPage schema with BreadcrumbList
const homePageSchema = {
  "@type": "WebPage",
  "@id": "https://kalidasstravels.in/#webpage",
  "url": "https://kalidasstravels.in/",
  "name": "Kalidass Travels – Best Taxi, Outstation Cabs & Temple Tours in Chennai",
  "description": "Book reliable taxi and cab services in Chennai: Airport transfers from ₹650, outstation cabs from ₹14/km, Tirupati & temple tour packages, and acting drivers from ₹600. 24/7 support.",
  "isPartOf": { "@id": "https://kalidasstravels.in/#website" },
  "about": { "@id": "https://kalidasstravels.in/#localbusiness" },
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": "https://kalidasstravels.in/images/og-main.png"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "@id": "https://kalidasstravels.in/#breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://kalidasstravels.in/"
      }
    ]
  }
};
---

<Layout
  title="Kalidass Travels – Best Taxi, Outstation Cabs & Temple Tours in Chennai"
  description="Book reliable taxi and cab services in Chennai: Airport transfers from ₹650, outstation cabs from ₹14/km, Tirupati & temple tour packages, and acting drivers from ₹600. 24/7 support."
  keywords="taxi service chennai, cab booking chennai, outstation cabs chennai, chennai to tirupati cab, chennai airport taxi, temple tour packages chennai, acting driver in chennai, call drivers chennai, kalidass travels medavakkam"
  image={ogImage}
  schema={homePageSchema}
>
  <!-- Desktop Floating Section Progress Rail -->
  <SectionNavigator client:idle />

  <!-- 1. Hero + Instant Booking Engine -->
  <Hero />
  <BookingPanel lang="en" />

  <!-- 2. Core Services -->
  <Services />

  <!-- 3. Popular Vehicles (Top 3) -->
  <FleetRoll client:visible currentLang="en" limit={3} />

  <!-- 4. Popular Temple Trips -->
  <Tours />

  <!-- 5. Trusted by Industry Leaders -->
  <PartnersCarousel client:visible currentLang="en" />

  <!-- 6. Professional Drivers (Horizontal Swipe) -->
  <DriversCarousel client:visible currentLang="en" />

  <!-- 7. Verified Client Reviews -->
  <Reviews />

  <!-- 8. Travel Awareness & Safety (2x2 Grid) -->
  <SafetySection />

  <!-- 8. Frequently Asked Questions -->
  <FAQ />

  <!-- 9. Final Booking & Call CTA -->
  <BottomCTA />

  <!-- Exit Intent Vehicle Recommendation Helper -->
  <ExitIntentModal client:idle />
</Layout>
