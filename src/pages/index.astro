---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import BookingPanel from "../components/BookingPanel.astro";
import SectionNavigator from "../components/react/SectionNavigator.jsx";
import Services from "../components/Services.astro";
import FleetCarousel from "../components/FleetCarousel.astro";
import Tours from "../components/Tours.astro";
import PartnersCarousel from "../components/PartnersCarousel.astro";
import DriversCarousel from "../components/DriversCarousel.astro";
import SafetySection from "../components/SafetySection.astro";
import Reviews from "../components/Reviews.astro";
import FAQ from "../components/FAQ.astro";
import BottomCTA from "../components/BottomCTA.astro";
import { getImage } from "astro:assets";
import heroImg from "../assets/images/hero/outstation-highway.webp";

const ogImage = "/images/og-main.png";

const heroOptimized = import.meta.env.PROD
  ? await getImage({
      src: heroImg,
      widths: [360, 640, 800, 1080, 1440, 1920],
      sizes: "(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 100vw",
      format: "avif",
      quality: 82,
    })
  : null;

const preloadHero = heroOptimized
  ? {
      href: heroOptimized.src,
      srcset: heroOptimized.srcSet.attribute,
      sizes: "(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 100vw",
    }
  : {
      href: "/images/hero/outstation-highway.webp",
    };

---

<Layout
  title="Kalidass Travels – Best Cabs & Temple Tours Chennai"
  description="Book reliable taxi services in Chennai: Airport cabs from ₹650, outstation cabs from ₹14/km, temple tours & acting drivers from ₹600. 24/7 support."
  keywords="taxi service chennai, cab booking chennai, outstation cabs chennai, chennai to tirupati cab, chennai airport taxi, temple tour packages chennai, acting driver in chennai, call drivers chennai, kalidass travels medavakkam"
  ogImage={ogImage}
  image={ogImage}
  preloadHero={preloadHero}
>
  <!-- Desktop Floating Section Progress Rail (Desktop Only) -->
  <SectionNavigator client:media="(min-width: 1024px)" />

  <!-- 1. Hero + Instant Booking Engine -->
  <Hero />
  <BookingPanel lang="en" />

  <!-- 2. Core Services -->
  <Services />

  <!-- 3. Popular Vehicles (Top 4: Sedan, Ertiga, Innova Crysta, Tempo Traveller) -->
  <FleetCarousel limit={4} />

  <!-- 4. Popular Temple Trips -->
  <Tours />

  <!-- 5. Trusted by Industry Leaders -->
  <PartnersCarousel currentLang="en" />

  <!-- 6. Professional Drivers (Horizontal Swipe) -->
  <DriversCarousel currentLang="en" />

  <!-- 7. Verified Client Reviews -->
  <Reviews />

  <!-- 8. Travel Awareness & Safety (2x2 Grid) -->
  <SafetySection />

  <!-- 8. Frequently Asked Questions -->
  <FAQ />

  <!-- 9. Final Booking & Call CTA -->
  <BottomCTA />
</Layout>
