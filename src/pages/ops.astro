              <!-- Quick Action Buttons -->
              <div class="pt-2 border-t border-slate-200 flex items-center gap-1.5 font-mono-code overflow-x-auto no-scrollbar">
                <button 
                  onclick="triggerUniversalGuestMessage('${t.id}', '${escape(t.guest)}', '${cleanPhone}', '${escape(t.datetime)}', '${escape(t.pickup)}', '${t.category || 'tirupati'}', '${t.fare}')"
                  class="h-6 px-2 rounded-[2px] bg-slate-100 hover:bg-[#1E252D] hover:text-white text-slate-800 border border-slate-300 text-[10px] font-bold uppercase transition-colors shrink-0"
                >
                  GUEST
                </button>

                ${isTirupati ? `
                <button 
                  onclick="triggerTicketingDossier('${t.id}', '${escape(t.datetime)}', '${escape(t.pax)}')"
                  class="h-6 px-2 rounded-[2px] bg-slate-100 hover:bg-[#1E252D] hover:text-white text-slate-800 border border-slate-300 text-[10px] font-bold uppercase transition-colors shrink-0"
                  title="Pilgrimage Ticketing Desk (SLA: 120m)"
                >
                  DESK (120M)
                </button>
                ` : ''}

                <button 
                  onclick="triggerDriverManifest('${t.id}', '${escape(t.datetime)}', '${escape(t.pickup)}', '${escape(t.guest)}', '${t.fare}')"
                  class="h-6 px-2 rounded-[2px] bg-[#1E252D] text-white hover:bg-slate-800 border border-slate-900 text-[10px] font-bold uppercase transition-colors shrink-0"
                >
                  DUTY
                </button>

                <button 
                  onclick="openStatusModal('${t.id}')"
                  class="h-6 px-2 rounded-[2px] bg-slate-100 hover:bg-[#1E252D] hover:text-white text-slate-800 border border-slate-300 text-[10px] font-bold uppercase transition-colors shrink-0"
                >
                  EDIT
                </button>

                <button 
                  onclick="deleteBooking('${t.id}')"
                  class="h-6 px-2 rounded-[2px] bg-slate-100 hover:bg-rose-900 hover:text-white text-slate-500 border border-slate-300 hover:border-rose-900 text-[10px] font-bold uppercase transition-colors shrink-0"
                  title="Delete booking"
                >
                  DEL
                </button>
              </div>

            </div>
          `;
        }).join('');

        // --- RENDER 14-COLUMN INDUSTRIAL FLIGHT BOARD TABLE ---
        tbody.innerHTML = filtered.map((t, idx) => {
          const serialNum = idx + 1;
          const isTirupati = t.category === 'tirupati' || t.id.includes('TPT');
          const categoryTag = isTirupati
            ? `<span class="inline-block px-1.5 py-0.2 rounded-[2px] bg-amber-100 text-amber-900 border border-amber-300 font-mono-code text-[9px] font-bold uppercase">TIRUPATI</span>`
            : t.category === 'airport'
