            : `<span class="inline-block px-1.5 py-0.2 rounded-[2px] bg-slate-200 text-slate-800 border border-slate-300 font-mono-code text-[9px] font-bold uppercase">${escapeHtml(t.category || 'OUTSTATION').toUpperCase()}</span>`;

