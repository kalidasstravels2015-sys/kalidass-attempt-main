              <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Fare (₹)</label>
              <input
                type="text"
                id="updateFare"
                placeholder="₹6,000"
                class="w-full rounded-[3px] border border-slate-300 bg-white px-2 py-1.5 text-xs font-mono-code text-slate-800"
