            type="text"
            id="modalPhone"
            class="w-full rounded-[3px] border border-slate-300 bg-slate-50 px-3 py-1.5 text-xs font-mono-code text-slate-900 font-semibold focus:outline-none"
            readonly
          />
        </div>

        <div class="mt-3">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono-code">TELEMETRY MESSAGE PAYLOAD</label>
          <textarea
            id="modalText"
            rows="8"
            class="w-full rounded-[3px] border border-slate-300 bg-white p-3 text-xs font-mono-code text-slate-800 leading-relaxed focus:border-[#1E252D] focus:outline-none focus:ring-1 focus:ring-[#1E252D]"
          ></textarea>
        </div>

        <div class="mt-4 flex items-center justify-end gap-2 font-mono-code text-xs">
          <button
            id="copyMessageBtn"
            class="inline-flex items-center gap-1.5 rounded-[3px] border border-slate-300 bg-white px-3 py-2 font-semibold text-slate-700 hover:bg-slate-100 transition-colors"
          >
            <span class="material-symbols-outlined text-[15px]">content_copy</span>
            <span>COPY PAYLOAD</span>
          </button>
          <button
            id="openWhatsAppBtn"
            class="inline-flex items-center gap-1.5 rounded-[3px] bg-[#1E252D] px-4 py-2 font-bold text-white hover:bg-[#141A21] shadow-md transition-colors"
          >
            <span>LAUNCH WHATSAPP</span>
            <span class="material-symbols-outlined text-[15px]">send</span>
          </button>
