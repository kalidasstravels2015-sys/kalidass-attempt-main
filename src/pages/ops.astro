                <span class="px-1.5 py-0.5 rounded-[2px] bg-slate-100 text-slate-800 border border-slate-300 font-mono-code text-[11px] font-bold">
                  ${t.vehicle}
                </span>
              </div>

              <!-- Guest & Itinerary Details -->
              <div class="space-y-1">
                <div class="flex items-center justify-between">
                  <div class="font-bold text-sm text-[#111827]">${escapeHtml(t.guest)}</div>
                  ${cleanPhone ? `<a href="tel:${cleanPhone}" class="h-6 px-2 rounded-[2px] bg-slate-100 text-slate-800 border border-slate-300 hover:bg-[#1E252D] hover:text-white font-mono-code text-[11px] font-bold inline-flex items-center gap-1 transition-colors"><span class="material-symbols-outlined text-[13px]">call</span>${cleanPhone}</a>` : ''}
                </div>
                <div class="text-xs text-slate-700 font-mono-code font-bold">
                  🗓️ ${escapeHtml(t.datetime)}
