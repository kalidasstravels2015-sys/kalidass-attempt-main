                  class="w-full text-xs font-mono-code bg-slate-50 hover:bg-white focus:bg-white border border-slate-300 focus:border-slate-800 rounded-[2px] px-2 py-0.5 text-slate-900 placeholder:text-slate-400 transition-colors" 
                  title="Editable internal remarks (auto-saves on blur)"
                />
