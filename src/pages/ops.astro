              </td>

              <!-- 10. Transit Status (Stage 4) -->
              <td class="py-2 px-2">
                ${renderTransitSelect(t)}
              </td>

              <!-- 11. Fare & Settlement (Stage 5) -->
              <td class="py-2 px-2 text-right">
                ${renderClosureSelect(t)}
              </td>

              <!-- 12. Review (Stage 6) -->
              <td class="py-2 px-2">
                ${renderReviewSelect(t)}
              </td>

              <!-- 13. Internal Notes / Remarks -->
