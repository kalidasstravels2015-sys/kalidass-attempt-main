---
// Security & Privacy: Internal Operations Page (Strictly No-Index)
const title = "Operations Command Center — Kalidass Travels | Universal Multi-Package Dispatch";
---

<!doctype html>
<html lang="en" class="h-full bg-[#F4F6F8] text-[#111827] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Self-Hosted & Google M3 Typography Baseline -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <style is:inline>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-mono-code {
        font-family: 'JetBrains Mono', monospace;
      }
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-weight: normal;
        font-style: normal;
        font-size: 20px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
        vertical-align: middle;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="min-h-full bg-[#F4F6F8] text-[#111827] flex flex-col pb-24 md:pb-12">

    <!-- ========================================================================= -->
    <!-- INDUSTRIAL PIN SECURITY GATE                                             -->
    <!-- ========================================================================= -->
    <div id="pinGate" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0F141C]/85 backdrop-blur-md p-4">
      <div class="w-full max-w-md rounded-[4px] border border-slate-700 bg-[#141A21] p-6 sm:p-8 shadow-2xl text-center text-slate-100">
        <div class="flex justify-center mb-5">
          <img
            src="/images/logo.webp"
            alt="Kalidass Travels logo"
            class="h-10 w-auto object-contain brightness-110"
            width="160"
            height="40"
          />
        </div>

        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[2px] bg-slate-800 text-slate-300 font-mono-code text-[11px] font-bold uppercase tracking-wider mb-3 border border-slate-700">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>DISPATCH TERMINAL ACCESS CONTROL</span>
        </div>

        <h2 class="font-mono-code text-base font-bold text-white tracking-wide uppercase">Universal Dispatch Console</h2>
        <p class="mt-1.5 text-xs text-slate-400 font-mono-code">
          Authorized mobility controllers only. Enter security PIN to unlock telemetry flight board.
        </p>

        <form id="pinForm" class="mt-6 space-y-4">
          <div>
            <input
              type="password"
              id="pinInput"
              maxlength="8"
              inputmode="numeric"
              placeholder="ENTER PIN (2015)"
              class="w-full rounded-[3px] border border-slate-600 bg-slate-900 px-4 py-2.5 text-center text-base font-mono-code font-bold tracking-widest text-white placeholder:text-slate-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white transition-all"
              autofocus
            />
          </div>
          <p id="pinError" class="hidden font-mono-code text-xs font-semibold text-rose-400">ACCESS DENIED: PIN INVALID</p>
          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-[3px] bg-white text-[#141A21] px-5 py-2.5 font-mono-code text-xs font-bold uppercase tracking-wider hover:bg-slate-200 active:scale-[0.99] transition-all shadow-sm"
          >
            <span>AUTHENTICATE CONSOLE</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </button>
        </form>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-center gap-2 font-mono-code text-[11px] text-slate-400">
          <span class="material-symbols-outlined text-[14px] text-emerald-400">lock</span>
          <span>ENCRYPTED INTERNAL DESK • PIN: <strong>2015</strong></span>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MAIN EXECUTIVE INDUSTRIAL COMMAND MONITOR                                -->
    <!-- ========================================================================= -->
    <div id="mainDashboard" class="hidden flex-1 flex flex-col bg-[#F4F6F8]">
      
      <!-- 1. EXECUTIVE INDUSTRIAL COMMAND HEADER (FULL-WIDTH) -->
      <header class="sticky top-0 z-40 border-b border-slate-800 bg-[#141A21] text-slate-100 shadow-md">
        <div class="w-full flex items-center justify-between px-3 sm:px-6 2xl:px-8 h-16">
          
          <div class="flex items-center gap-3 sm:gap-5">
            <a href="/" aria-label="Kalidass Travels Home" class="flex items-center gap-2">
              <img
                src="/images/logo.webp"
                alt="Kalidass Travels logo"
                class="h-8 sm:h-9 w-auto object-contain brightness-110"
                width="140"
                height="40"
              />
            </a>
            <div class="hidden sm:block h-6 w-[1px] bg-slate-700"></div>
            <div class="hidden sm:flex flex-col">
              <div class="flex items-center gap-2">
                <span class="font-mono-code text-xs font-bold uppercase tracking-wider text-white">OPERATIONS COMMAND FLIGHT DECK</span>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[3px] bg-emerald-950/80 text-emerald-300 border border-emerald-700/60 font-mono-code text-[10px] font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
                  LIVE CONNECTED
                </span>
              </div>
              <span class="font-mono-code text-[11px] text-slate-400">
                DISPATCH • FLEET AUDIT • PILGRIMAGE PROCUREMENT • SETTLEMENTS
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <!-- Quick New Booking (Desktop) -->
            <button
              onclick="openNewBookingDrawer()"
              class="inline-flex items-center gap-1.5 rounded-[3px] bg-white hover:bg-slate-100 text-[#141A21] px-3.5 py-1.5 font-mono-code text-xs font-bold shadow-sm transition-all active:scale-[0.98]"
            >
              <span class="material-symbols-outlined text-[16px]">add</span>
              <span>NEW BOOKING</span>
            </button>

            <!-- Refresh Button -->
            <button
              id="refreshBtn"
              class="inline-flex items-center gap-1 rounded-[3px] bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-1.5 font-mono-code text-xs font-semibold transition-colors"
              title="Force Sync Telemetry"
            >
              <span id="refreshIcon" class="material-symbols-outlined text-[15px]">refresh</span>
              <span class="hidden md:inline">SYNC</span>
            </button>

            <!-- External Google Sheet Link -->
            <a
              href="https://docs.google.com/spreadsheets/d/189thbf0Bbn_vuV8_CmqATTwg2_OIPCJtcXMfn-FFxLM/edit?gid=1282577927"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-8 px-2.5 rounded-[3px] bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
              title="Open Raw Google Sheet Data"
            >
              <span class="material-symbols-outlined text-[15px]">table_chart</span>
              <span class="hidden lg:inline ml-1 font-mono-code text-xs font-semibold">SHEET</span>
            </a>

            <!-- Lock Button -->
            <button
              id="lockBtn"
              class="inline-flex items-center justify-center h-8 w-8 rounded-[3px] bg-slate-800 hover:bg-rose-950/60 hover:text-rose-300 text-slate-400 border border-slate-700 transition-colors"
              title="Lock Console"
            >
              <span class="material-symbols-outlined text-[16px]">lock</span>
            </button>
          </div>
        </div>
      </header>

      <!-- 2. TELEMETRY STATUS BAR (FULL-WIDTH) -->
      <section class="border-b border-slate-200 bg-slate-100 px-3 sm:px-6 2xl:px-8 py-1.5 font-mono-code text-[11px] text-slate-600">
        <div class="w-full flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="inline-flex items-center gap-1.5 font-bold text-slate-900">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-900"></span>
              KALIDASS TRAVELS CHENNAI (EST. 2015)
            </span>
            <span class="text-slate-300">|</span>
            <span class="inline-flex items-center gap-1 text-slate-700">
              <span class="material-symbols-outlined text-[14px] text-slate-700">phone_in_talk</span>
              24x7 DESK: <strong class="text-slate-900">+91 89395 39211</strong>
            </span>
            <span class="text-slate-300">|</span>
            <span class="text-slate-600">
              SLA WINDOW: <strong class="text-slate-900">120 MIN</strong>
            </span>
          </div>

          <div class="flex items-center gap-2 font-medium">
            <span class="text-slate-500">SYSTEM TELEMETRY:</span>
            <span id="lastUpdatedText" class="font-bold text-slate-800">CONNECTING...</span>
          </div>
        </div>
      </section>

      <!-- 3. MAIN DASHBOARD CONTENT (FULL-WIDTH OPERATIONS BOARD) -->
      <main class="w-full p-3 sm:p-5 2xl:p-7 space-y-4 flex-1">
        
        <!-- UNIFIED INDUSTRIAL INSTRUMENTATION PANEL (ZERO PASTELS) -->
        <div class="rounded-[4px] border border-slate-300 bg-white shadow-sm overflow-hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
          
          <!-- Tile 1: Active Manifests -->
          <div class="p-3.5 sm:p-4 bg-white hover:bg-slate-50/60 transition-colors">
            <div class="flex items-center justify-between font-mono-code text-[10px] uppercase font-bold tracking-wider text-slate-500">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-900"></span>
                ACTIVE BOOKINGS
              </span>
              <span class="material-symbols-outlined text-[16px] text-slate-400">directions_car</span>
            </div>
            <p id="kpiTotal" class="mt-1 text-2xl sm:text-3xl font-bold font-mono-code text-[#111827] leading-none">0</p>
            <p class="mt-1 font-mono-code text-[10px] text-slate-400 uppercase tracking-tight">ALL VERTICAL TRIPS</p>
          </div>

          <!-- Tile 2: Action Needed -->
          <div class="p-3.5 sm:p-4 bg-white hover:bg-slate-50/60 transition-colors">
            <div class="flex items-center justify-between font-mono-code text-[10px] uppercase font-bold tracking-wider text-slate-600">
              <span class="flex items-center gap-1.5 text-rose-700">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-600 shadow-[0_0_6px_rgba(225,29,72,0.6)]"></span>
                ATTENTION REQUIRED
              </span>
              <span class="material-symbols-outlined text-[16px] text-rose-600">priority_high</span>
            </div>
            <p id="kpiAction" class="mt-1 text-2xl sm:text-3xl font-bold font-mono-code text-rose-950 leading-none">0</p>
            <p class="mt-1 font-mono-code text-[10px] text-slate-400 uppercase tracking-tight">PENDING KYC / TICKETS</p>
          </div>

          <!-- Tile 3: Tirupati Confirmed -->
          <div class="p-3.5 sm:p-4 bg-white hover:bg-slate-50/60 transition-colors">
            <div class="flex items-center justify-between font-mono-code text-[10px] uppercase font-bold tracking-wider text-slate-600">
              <span class="flex items-center gap-1.5 text-amber-800">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shadow-[0_0_6px_rgba(245,158,11,0.6)]"></span>
                TIRUPATI CONFIRMED
              </span>
              <span class="material-symbols-outlined text-[16px] text-amber-700">temple_hindu</span>
            </div>
            <p id="kpiTickets" class="mt-1 text-2xl sm:text-3xl font-bold font-mono-code text-[#111827] leading-none">0</p>
            <p class="mt-1 font-mono-code text-[10px] text-slate-400 uppercase tracking-tight">CONFIRMED SED SLOTS</p>
          </div>

          <!-- Tile 4: Dispatched -->
          <div class="p-3.5 sm:p-4 bg-white hover:bg-slate-50/60 transition-colors">
            <div class="flex items-center justify-between font-mono-code text-[10px] uppercase font-bold tracking-wider text-slate-600">
              <span class="flex items-center gap-1.5 text-emerald-800">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.6)]"></span>
                DUTY DISPATCHED
              </span>
              <span class="material-symbols-outlined text-[16px] text-emerald-700">receipt_long</span>
            </div>
            <p id="kpiDispatched" class="mt-1 text-2xl sm:text-3xl font-bold font-mono-code text-[#111827] leading-none">0</p>
            <p class="mt-1 font-mono-code text-[10px] text-slate-400 uppercase tracking-tight">CHAUFFEUR READY</p>
          </div>

          <!-- Tile 5: Net Contract Margin -->
          <div class="col-span-2 sm:col-span-1 p-3.5 sm:p-4 bg-slate-50/80 hover:bg-slate-100 transition-colors">
            <div class="flex items-center justify-between font-mono-code text-[10px] uppercase font-bold tracking-wider text-slate-600">
              <span class="flex items-center gap-1.5 text-slate-800">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                AGENCY MARGIN
              </span>
              <span class="material-symbols-outlined text-[16px] text-slate-500">payments</span>
            </div>
            <p id="kpiMargin" class="mt-1 text-2xl sm:text-3xl font-bold font-mono-code text-[#111827] leading-none">₹0</p>
            <p class="mt-1 font-mono-code text-[10px] text-emerald-700 font-bold uppercase tracking-tight">NET CONTRACT PROFIT</p>
          </div>

        </div>

        <!-- INDUSTRIAL SEARCH & SEGMENTED FILTER TOOLBAR -->
        <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 bg-white p-2.5 sm:p-3 rounded-[4px] border border-slate-300 shadow-sm">
          
          <div class="relative flex-1 max-w-xl">
            <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">
              search
            </span>
            <input
              type="text"
              id="searchInput"
              placeholder="Filter by S.No, Ref ID, Guest, Phone, Route, Notes..."
              class="w-full rounded-[3px] border border-slate-300 bg-slate-50/70 pl-8 pr-12 py-1.5 font-mono-code text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1E252D] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#1E252D] transition-all"
            />
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 font-mono-code text-[10px] text-slate-400 border border-slate-200 px-1 py-0.5 rounded-[2px]">
              ESC
            </span>
          </div>

          <!-- Industrial Segmented Filter Buttons -->
          <div class="flex items-center rounded-[3px] border border-slate-300 overflow-hidden divide-x divide-slate-300 font-mono-code text-xs overflow-x-auto no-scrollbar shrink-0">
            <button class="filter-btn active px-3 py-1.5 font-bold transition-colors bg-[#1E252D] text-white" data-filter="all">
              ALL
            </button>
            <button class="filter-btn px-3 py-1.5 font-semibold transition-colors bg-white hover:bg-slate-100 text-slate-700" data-filter="tirupati">
              TIRUPATI
            </button>
            <button class="filter-btn px-3 py-1.5 font-semibold transition-colors bg-white hover:bg-slate-100 text-slate-700" data-filter="outstation">
              OUTSTATION
            </button>
            <button class="filter-btn px-3 py-1.5 font-semibold transition-colors bg-white hover:bg-slate-100 text-slate-700" data-filter="airport">
              AIRPORT
            </button>
            <button class="filter-btn px-3 py-1.5 font-semibold transition-colors bg-white hover:bg-slate-100 text-slate-700 inline-flex items-center gap-1.5" data-filter="action">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
              ACTION NEEDED
            </button>
            <button class="filter-btn px-3 py-1.5 font-semibold transition-colors bg-white hover:bg-slate-100 text-slate-700" data-filter="unsettled">
              UNSETTLED
            </button>
          </div>
        </div>

        <!-- ========================================================================= -->
        <!-- MOBILE VIEW: HIGH-DENSITY INDUSTRIAL TELEMETRY CARDS                     -->
        <!-- ========================================================================= -->
        <div id="mobileCardsContainer" class="md:hidden space-y-3">
          <div class="text-center py-12 text-slate-500 font-mono-code">
            <span class="material-symbols-outlined text-[24px] text-slate-800 animate-spin">progress_activity</span>
            <p class="mt-2 text-xs font-semibold">SYNCHRONIZING TELEMETRY STREAM...</p>
          </div>
        </div>

        <!-- ========================================================================= -->
        <!-- DESKTOP/TABLET VIEW: HIGH-DENSITY INDUSTRIAL FLIGHT BOARD TABLE           -->
        <!-- ========================================================================= -->
        <div class="hidden md:block rounded-[4px] border border-slate-300 bg-white shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap min-w-[1580px]">
              <thead>
                <tr class="border-b-2 border-slate-900 bg-[#1E252D] text-[10px] uppercase tracking-wider font-bold font-mono-code text-slate-200 select-none divide-x divide-slate-700/60">
                  <th class="py-2.5 px-2.5 text-center w-12 text-slate-300">S.NO</th>
                  <th class="py-2.5 px-3 w-32 text-slate-300">BOOKING REF</th>
                  <th class="py-2.5 px-3 w-48 text-slate-300">GUEST & CONTACT</th>
                  <th class="py-2.5 px-3 w-36 text-slate-300">SCHEDULE</th>
                  <th class="py-2.5 px-3 w-52 text-slate-300">PICKUP & ROUTE</th>
                  <th class="py-2.5 px-3 w-32 text-slate-300">FLEET & PAX</th>
                  <th class="py-2.5 px-3 w-36 text-slate-300">1. LEAD / KYC</th>
                  <th class="py-2.5 px-3 w-44 text-slate-300">2. TICKETING DESK</th>
                  <th class="py-2.5 px-3 w-48 text-slate-300">3. CHAUFFEUR DUTY</th>
                  <th class="py-2.5 px-3 w-36 text-slate-300">4. TRANSIT STATUS</th>
                  <th class="py-2.5 px-3 w-40 text-right text-slate-300">5. FARE & SETTLEMENT</th>
                  <th class="py-2.5 px-3 w-36 text-slate-300">6. REVIEW</th>
                  <th class="py-2.5 px-3 min-w-[220px] text-slate-300">INTERNAL REMARKS</th>
                  <th class="py-2.5 px-3 text-center w-36 text-slate-300">DISPATCH HUB</th>
                </tr>
              </thead>
              <tbody id="tripTableBody" class="divide-y divide-slate-200 text-xs">
              </tbody>
            </table>
          </div>
        </div>

      </main>

      <!-- 4. INDUSTRIAL TELEMETRY FOOTER (FULL-WIDTH) -->
      <footer class="mt-auto border-t border-slate-300 bg-slate-100 px-4 sm:px-6 2xl:px-8 py-3.5 font-mono-code text-[11px] text-slate-600">
        <div class="w-full flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
          <div>
            <p class="font-bold text-slate-900">KALIDASS TRAVELS INTERNAL OPERATIONS CONTROL</p>
            <p class="text-slate-500">Medavakkam, Chennai 600100 • All South India Outstation & Pilgrimage Verticals</p>
          </div>
          <div class="flex items-center gap-3 text-slate-500">
            <a href="/privacy" class="hover:text-slate-900 hover:underline">PRIVACY POLICY</a>
            <span>•</span>
            <a href="/terms" class="hover:text-slate-900 hover:underline">TERMS</a>
            <span>•</span>
            <span class="text-slate-700 font-bold">V4.0 INDUSTRIAL DISPATCH FLIGHT DECK</span>
          </div>
        </div>
      </footer>
    </div>

    <!-- ========================================================================= -->
    <!-- INDUSTRIAL FLOATING ACTION BUTTON (MOBILE ONLY)                           -->
    <!-- ========================================================================= -->
    <div id="fabContainer" class="fixed bottom-6 right-5 z-40 md:hidden">
      <button
        onclick="openNewBookingDrawer()"
        class="inline-flex items-center gap-2 rounded-[3px] bg-[#1E252D] px-4 py-3 text-xs font-mono-code font-bold text-white shadow-2xl hover:bg-[#141A21] border border-slate-700 active:scale-95 transition-all"
      >
        <span class="material-symbols-outlined text-[18px]">add</span>
        <span>NEW BOOKING</span>
      </button>
    </div>

    <!-- ========================================================================= -->
    <!-- INDUSTRIAL MULTI-PACKAGE ORDER CREATION DRAWER                            -->
    <!-- ========================================================================= -->
    <div id="newBookingDrawer" class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-[#0F141C]/80 backdrop-blur-sm p-0 sm:p-4">
      <div class="w-full max-w-xl rounded-t-[4px] sm:rounded-[4px] border border-slate-300 bg-white p-5 sm:p-6 shadow-2xl max-h-[94vh] overflow-y-auto">
        
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-[3px] bg-[#1E252D] text-white flex items-center justify-center">
              <span class="material-symbols-outlined text-[18px]">add_task</span>
            </div>
            <div>
              <h3 class="text-xs sm:text-sm font-bold text-[#111827] uppercase tracking-wide">Create Booking Manifest</h3>
              <p class="text-[10px] text-slate-500 font-mono-code uppercase">Intelligent Vehicle Pruning & Vertical Routing</p>
            </div>
          </div>
          <button onclick="closeNewBookingDrawer()" class="h-7 w-7 rounded-[3px] border border-slate-300 inline-flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors">
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </div>

        <form id="newBookingForm" class="mt-4 space-y-3.5">
          
          <!-- STEP 1: SERVICE VERTICAL / PACKAGE SELECTOR -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono-code">1. SERVICE VERTICAL / PACKAGE *</label>
            <select
              id="formPackageType"
