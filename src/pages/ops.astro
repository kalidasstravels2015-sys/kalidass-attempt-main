                <div class="grid grid-cols-2 gap-1.5 text-xs">
                  <div>
                    <label class="font-mono-code text-[9px] font-bold text-slate-500 block mb-0.5">1. LEAD / KYC</label>
                    ${renderKycSelect(t)}
                  </div>
                  <div>
                    <label class="font-mono-code text-[9px] font-bold text-slate-500 block mb-0.5">2. TICKETING (120M)</label>
                    ${renderDarshanSelect(t)}
                  </div>
                  <div>
                    <label class="font-mono-code text-[9px] font-bold text-slate-500 block mb-0.5">3. CHAUFFEUR</label>
                    ${renderManifestSelect(t)}
                  </div>
                  <div>
                    <label class="font-mono-code text-[9px] font-bold text-slate-500 block mb-0.5">4. TRANSIT</label>
                    ${renderTransitSelect(t)}
                  </div>
                  <div>
                    <label class="font-mono-code text-[9px] font-bold text-slate-500 block mb-0.5">5. SETTLEMENT</label>
                    ${renderClosureSelect(t)}
                  </div>
                  <div>
                    <label class="font-mono-code text-[9px] font-bold text-slate-500 block mb-0.5">6. REVIEW</label>
                    ${renderReviewSelect(t)}
                  </div>
                </div>
              </div>

              <!-- Inline Remarks / Notes -->
              <div class="pt-2 border-t border-slate-200">
                <input 
                  type="text" 
                  value="${escapeHtml(t.notes || '')}" 
                  onblur="updateTripNotes('${t.id}', this.value)" 
                  placeholder="+ Add remarks / notes..." 
                  class="w-full text-xs font-mono-code bg-slate-50 focus:bg-white border border-slate-300 focus:border-slate-800 rounded-[2px] px-2 py-1 text-slate-900 transition-colors placeholder:text-slate-400"
                />
