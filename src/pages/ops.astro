                  <button 
                    onclick="deleteBooking('${t.id}')"
                    class="h-6 w-6 inline-flex items-center justify-center rounded-[2px] bg-slate-100 hover:bg-rose-900 hover:text-white border border-slate-300 hover:border-rose-900 text-slate-500 transition-colors"
                    title="Delete booking"
                  >
                    <span class="material-symbols-outlined text-[13px]">delete</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      // 5. Drawer Open/Close
      const newBookingDrawer = document.getElementById('newBookingDrawer');
      const newBookingForm = document.getElementById('newBookingForm');

      window.openNewBookingDrawer = function() {
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById('formTravelDate').value = tomorrow.toISOString().split('T')[0];
        newBookingDrawer.classList.remove('hidden');
        newBookingDrawer.classList.add('flex');
        
        // Trigger initial checks
        handlePackageTypeChange();
        handlePaxChange(document.getElementById('formPaxInput').value);
        document.getElementById('formGuestName').focus();
      };

      window.closeNewBookingDrawer = function() {
        newBookingDrawer.classList.add('hidden');
        newBookingDrawer.classList.remove('flex');
      };

      // Form Submit
      newBookingForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const pkg = document.getElementById('formPackageType').value;
        const pax = document.getElementById('formPaxInput').value + ' Pax';
        const vehicle = document.querySelector('input[name="vehicleChoice"]:checked').value;
        const name = document.getElementById('formGuestName').value.trim();
        const phone = document.getElementById('formGuestPhone').value.trim();
        const date = document.getElementById('formTravelDate').value;
        const time = document.getElementById('formTravelTime').value;
        let pickup = document.getElementById('formPickupAddress').value.trim();

        // Package specific data
        let darshanStatus = 'Not Applicable';
        if (pkg === 'tirupati') {
          darshanStatus = document.getElementById('formDarshanChoice').value;
        } else if (pkg === 'outstation' || pkg === 'temple') {
          const route = document.getElementById('formOutstationRoute').value.trim() || 'Outstation';
          const format = document.getElementById('formOutstationFormat').value;
          pickup = `${pickup} ➔ ${route} (${format})`;
        } else if (pkg === 'airport') {
          const flight = document.getElementById('formFlightDetails').value.trim();
          const transfer = document.getElementById('formAirportType').value;
          pickup = `${transfer}: ${pickup} (Flight: ${flight || 'N/A'})`;
        }

        const fare = document.getElementById('formFareInput').value;
        const payout = document.getElementById('formPayoutInput').value;
        const margin = document.getElementById('formMarginInput').value;
        const notes = (document.getElementById('formNotesInput')?.value || '').trim();

        const dateObj = new Date(`${date}T${time}`);
        const formattedDate = dateObj.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ` @ ${time}`;

        // ID Generator based on package prefix
        const prefix = pkg === 'tirupati' ? 'KT-TPT' : pkg === 'airport' ? 'KT-AIR' : 'KT-OUT';
        let maxNum = 100;
        allTrips.forEach(t => {
          const match = t.id.match(new RegExp(`#?${prefix}-(\\d+)`));
          if (match) {
            const num = parseInt(match[1]);
            if (num > maxNum) maxNum = num;
          }
        });
        const newId = `#${prefix}-${maxNum + 1}`;

        const newOrder = {
          id: newId,
          category: pkg,
          guest: `${name} (+91 ${phone})`,
          datetime: formattedDate,
          pickup: pickup,
          vehicle: vehicle,
          pax: pax,
          kyc: 'Pending',
          darshan: darshanStatus,
          driver: 'Unassigned',
          manifest: 'Pending',
          transit: 'Scheduled',
          fare: fare,
          payout: payout,
          margin: margin,
          closure: 'Unpaid (Post-Trip Due)',
          review: 'Pending',
          notes: notes
        };

        allTrips.unshift(newOrder);
        saveLocalOrders(allTrips);
        renderDashboard();
        closeNewBookingDrawer();
        newBookingForm.reset();
        showToast(`Created booking ${newId}`);

        const cleanPhone = phone.replace(/[^0-9]/g, '');
        triggerUniversalGuestMessage(newId, escape(name), cleanPhone.length === 10 ? `91${cleanPhone}` : cleanPhone, escape(formattedDate), escape(pickup), pkg, fare);
      });

      // 6. Interactive Status Update Modal
      const statusModal = document.getElementById('statusUpdateModal');
      const statusForm = document.getElementById('statusUpdateForm');

      window.openStatusModal = function(id) {
        const trip = allTrips.find(t => t.id === id);
        if (!trip) return;

        document.getElementById('updateTripId').value = trip.id;
        document.getElementById('updateModalTitle').textContent = `Update ${trip.id} — ${trip.guest.split(' ')[0]}`;
        document.getElementById('updateKycStatus').value = trip.kyc.toLowerCase().includes('verif') ? 'Verified' : trip.kyc.toLowerCase().includes('reject') ? 'Rejected' : 'Pending';
        
        // Hide darshan field if non-Tirupati
        const darshanGroup = document.getElementById('updateDarshanFieldGroup');
        if (trip.category !== 'tirupati' && !trip.id.includes('TPT')) {
          darshanGroup.classList.add('hidden');
        } else {
          darshanGroup.classList.remove('hidden');
          document.getElementById('updateDarshanStatus').value = trip.darshan || 'Needs Tickets (Unassigned)';
        }

        document.getElementById('updateDriver').value = trip.driver === 'Unassigned' ? '' : (trip.driver || '');
        document.getElementById('updateManifestStatus').value = (trip.manifest || '').toLowerCase().includes('dispatch') ? 'Dispatched' : (trip.manifest || '').toLowerCase().includes('assign') ? 'Assigned' : 'Pending';
        document.getElementById('updateTransitStatus').value = trip.transit || 'Scheduled';
        document.getElementById('updateClosureStatus').value = trip.closure || 'Unpaid (Post-Trip Due)';
        document.getElementById('updateReviewStatus').value = trip.review || 'Pending';
        document.getElementById('updateFare').value = trip.fare || '₹6,000';
        document.getElementById('updatePayout').value = trip.payout || '₹4,800';
        document.getElementById('updateNotes').value = trip.notes || '';

        statusModal.classList.remove('hidden');
        statusModal.classList.add('flex');
      };

      window.closeStatusModal = function() {
        statusModal.classList.add('hidden');
        statusModal.classList.remove('flex');
      };

      statusForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const id = document.getElementById('updateTripId').value;
        const trip = allTrips.find(t => t.id === id);
        if (trip) {
          const fareVal = parseInt(document.getElementById('updateFare').value.replace(/[^0-9]/g, '')) || 0;
          const payoutVal = parseInt(document.getElementById('updatePayout').value.replace(/[^0-9]/g, '')) || 0;
          const marginVal = Math.max(0, fareVal - payoutVal);

          trip.kyc = document.getElementById('updateKycStatus').value;
          if (trip.category === 'tirupati' || trip.id.includes('TPT')) {
            trip.darshan = document.getElementById('updateDarshanStatus').value.trim() || 'Needs Tickets (Unassigned)';
          }
          trip.driver = document.getElementById('updateDriver').value.trim() || 'Unassigned';
          trip.manifest = document.getElementById('updateManifestStatus').value;
          trip.transit = document.getElementById('updateTransitStatus').value;
          trip.closure = document.getElementById('updateClosureStatus').value;
          trip.review = document.getElementById('updateReviewStatus').value;
          if (fareVal > 0) trip.fare = `₹${fareVal.toLocaleString('en-IN')}`;
          if (payoutVal > 0) trip.payout = `₹${payoutVal.toLocaleString('en-IN')}`;
          trip.margin = `₹${marginVal.toLocaleString('en-IN')}`;
          trip.notes = document.getElementById('updateNotes').value.trim();

          saveLocalOrders(allTrips);
          renderDashboard();
          closeStatusModal();
          showToast(`Manifest updated for ${trip.id}`);
        }
      });

      // 7. Universal Package-Aware WhatsApp Message Generators
      const modal = document.getElementById('actionModal');
      const modalTitle = document.getElementById('modalTitle');
      const modalPhone = document.getElementById('modalPhone');
      const modalText = document.getElementById('modalText');
      const modalIcon = document.getElementById('modalIcon');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const copyMessageBtn = document.getElementById('copyMessageBtn');
      const openWhatsAppBtn = document.getElementById('openWhatsAppBtn');

      closeModalBtn.addEventListener('click', () => modal.classList.add('hidden'));

      window.triggerUniversalGuestMessage = function(id, guest, phone, datetime, pickup, category, fare) {
        guest = unescape(guest);
        datetime = unescape(datetime);
        pickup = unescape(pickup);

        modalIcon.textContent = 'chat';
        modalTitle.textContent = `Guest Confirmation — ${id}`;
        modalPhone.value = phone || 'Guest Mobile';

        if (category === 'tirupati' || id.includes('TPT')) {
          modalText.value = 
`🙏 Om Namo Venkatesaya!

Dear ${guest.split(' ')[0]},
Thank you for choosing Kalidass Travels Chennai! Your Tirupati Balaji pilgrimage booking has been registered.

📌 BOOKING ID: ${id}
🗓️ Travel Date: ${datetime}
📍 Doorstep Pickup: ${pickup}
💰 Cab Tariff: ${fare} Flat All-Inclusive (Tolls, AP Permit & Driver Batta included)
💳 Payment Terms: Payable after trip completion!

🎫 DARSHAN TICKETS:
Our Pilgrimage Ticketing Desk is processing your verified Darshan slot under statutory guidelines at actual cost. Please reply to this chat with photos of government ID (Aadhaar cards) for all traveling members.

Kalidass Travels Operations Desk — +91 89395 39211`;
        } else if (category === 'airport') {
          modalText.value =
`✈️ Kalidass Travels — Airport Transfer Confirmation

Dear ${guest.split(' ')[0]},
Your Chennai Airport (MAA) executive taxi booking is confirmed:

📌 BOOKING REF: ${id}
🗓️ Schedule: ${datetime}
📍 Transfer Itinerary: ${pickup}
💰 Fixed Fare: ${fare} (Tolls included)

Your chauffeur details and vehicle registration will be dispatched 1 hour prior to reporting time.
Hotline: +91 89395 39211`;
        } else {
          // Outstation / Temple Tour
          modalText.value =
`🚗 Kalidass Travels — Outstation Cab Booking Confirmation

Dear ${guest.split(' ')[0]},
Thank you for booking your journey with Kalidass Travels Chennai!

📌 BOOKING REFERENCE: ${id}
🗓️ Travel Schedule: ${datetime}
🛣️ Journey Itinerary: ${pickup}
💰 Estimated Fare: ${fare} (Driver batta & interstate permits included)
💳 Terms: No surge pricing. Payable upon journey completion.

Your designated chauffeur details will be issued the evening before departure.
Kalidass Travels Support: +91 89395 39211`;
        }

        modal.classList.remove('hidden');
      };

      window.triggerTicketingDossier = function(id, datetime, pax) {
        datetime = unescape(datetime);
        pax = unescape(pax);

        modalIcon.textContent = 'confirmation_number';
        modalTitle.textContent = `Pilgrim KYC Dossier — Ticketing Desk (SLA: 120m) — ${id}`;
        modalPhone.value = 'Ticketing Desk (Pilgrimage Procurement)';
        modalText.value =
`📋 PILGRIM KYC DOSSIER — ${id}
━━━━━━━━━━━━━━━━━━━━━━━━━
• Functional Desk: Pilgrimage Ticketing Desk (SLA: 120m)
• Target Travel Date: ${datetime}
• Party Size: ${pax}
• Target Slot: 11:30 AM Special Entry Darshan (SED)
• RACI Accountable: Ticketing Procurement Lead
• Aadhaar Documents: [Attached above ⬆️]

Please confirm slot availability within the strict 120-minute SLA window.`;

        modal.classList.remove('hidden');
      };

      window.triggerDriverManifest = function(id, datetime, pickup, guest, fare) {
        datetime = unescape(datetime);
        pickup = unescape(pickup);
        guest = unescape(guest);

        modalIcon.textContent = 'local_taxi';
        modalTitle.textContent = `Chauffeur Duty Manifest — ${id}`;
        modalPhone.value = 'Assigned Chauffeur';
        modalText.value =
`🚗 KALIDASS TRAVELS — CHAUFFEUR DUTY MANIFEST
Manifest Ref: CDM-${id.replace('#', '')}
━━━━━━━━━━━━━━━━━━━━━━━━━
• Reporting Date & Time: ${datetime}
• Reporting Address: ${pickup}
• Guest Details: ${guest}

FINANCIAL SETTLEMENT:
• Collect from Guest at drop: ${fare} (Cash/UPI)
• Remit Kalidass Agency Margin immediately at drop.

Please reply "ACKNOWLEDGED" to confirm duty.`;

        modal.classList.remove('hidden');
      };

      // Clipboard Copy
      copyMessageBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(modalText.value);
        copyMessageBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">done</span><span>Copied!</span>';
        setTimeout(() => {
          copyMessageBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">content_copy</span><span>Copy Text</span>';
        }, 2000);
      });

      // Launch WhatsApp
      openWhatsAppBtn.addEventListener('click', () => {
        const phone = modalPhone.value.replace(/[^0-9]/g, '');
        const encoded = encodeURIComponent(modalText.value);
        const url = phone ? `https://wa.me/${phone}?text=${encoded}` : `https://wa.me/?text=${encoded}`;
        window.open(url, '_blank');
      });

      // Search & Filters
      document.getElementById('searchInput').addEventListener('input', renderDashboard);
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('active', 'bg-[#1E252D]', 'text-white');
            b.classList.add('bg-white', 'text-slate-700');
          });
          btn.classList.add('active', 'bg-[#1E252D]', 'text-white');
          btn.classList.remove('bg-white', 'text-slate-700');
          activeFilter = btn.dataset.filter;
          renderDashboard();
        });
      });

      document.getElementById('refreshBtn').addEventListener('click', fetchSheetData);

      setInterval(() => {
        if (!pinGate.classList.contains('hidden')) return;
        fetchSheetData();
      }, 30000);

      checkSavedAuth();
    </script>
  </body>
</html>
