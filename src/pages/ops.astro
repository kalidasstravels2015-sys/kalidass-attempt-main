              <!-- 14. Dispatch Hub Actions -->
              <td class="py-2 px-2 text-center">
                <div class="flex items-center justify-center gap-1">
                  <button 
                    onclick="triggerUniversalGuestMessage('${t.id}', '${escape(t.guest)}', '${cleanPhone}', '${escape(t.datetime)}', '${escape(t.pickup)}', '${t.category || 'tirupati'}', '${t.fare}')"
                    class="h-6 px-1.5 rounded-[2px] bg-slate-100 hover:bg-[#1E252D] hover:text-white border border-slate-300 text-slate-800 font-mono-code text-[10px] font-bold uppercase transition-colors"
