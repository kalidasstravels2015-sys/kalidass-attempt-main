    <div id="actionModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-[#0F141C]/80 backdrop-blur-sm p-4">
      <div class="w-full max-w-lg rounded-[4px] border border-slate-300 bg-white p-5 sm:p-6 shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <div class="flex items-center gap-2">
            <span id="modalIcon" class="material-symbols-outlined text-[#1E252D] text-[20px]">chat</span>
            <h3 id="modalTitle" class="text-xs sm:text-sm font-bold text-[#111827] uppercase tracking-wide">Dispatch Manifest</h3>
          </div>
          <button id="closeModalBtn" class="h-7 w-7 rounded-[3px] border border-slate-300 inline-flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors">
            <span class="material-symbols-outlined text-[18px]">close</span>
