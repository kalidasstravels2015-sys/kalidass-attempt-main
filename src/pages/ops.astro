          </div>

          <!-- Notes / Remarks -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-mono-code">Internal Notes / Remarks</label>
            <textarea
              id="updateNotes"
              rows="2"
