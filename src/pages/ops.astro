              <td class="py-2 px-2.5">
                <button onclick="openStatusModal('${t.id}')" class="font-bold text-xs text-slate-900 hover:text-white px-1.5 py-0.5 rounded-[2px] bg-slate-100 hover:bg-[#1E252D] border border-slate-300 transition-colors">
