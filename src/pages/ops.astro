                    #${String(serialNum).padStart(2, '0')}
                  </span>
                  <button onclick="openStatusModal('${t.id}')" class="px-1.5 py-0.5 rounded-[2px] bg-slate-100 text-slate-900 border border-slate-300 font-bold text-xs hover:bg-[#1E252D] hover:text-white transition-colors">
                    ${t.id}
                  </button>
                  ${categoryTag}
