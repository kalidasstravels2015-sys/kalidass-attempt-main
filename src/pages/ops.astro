    </div>

    <!-- INDUSTRIAL HUD TOAST FEEDBACK -->
    <div id="opsToast" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 flex items-center gap-2 px-3.5 py-2 rounded-[3px] bg-[#141A21] text-white border border-slate-700 shadow-2xl font-mono-code text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse"></span>
      <span id="toastMsg">TELEMETRY UPDATED</span>
    </div>

    <!-- ========================================================================= -->
    <!-- JAVASCRIPT: DYNAMIC CAPACITY FILTERING & MULTI-PACKAGE ENGINE             -->
    <!-- ========================================================================= -->
    <script is:inline>
      const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTajZcTvEn98dRWHzbdv8IQK1yCMHFjGOw6q7lATMFUG19lSfhjTX9Km4fUW9HaZ8eXJZyu9ciCJN8D/pub?output=csv';
      const CORRECT_PIN = '2015';
      const STORAGE_KEY = 'kt_ops_universal_orders_v2';
      
      let allTrips = [];
      let activeFilter = 'all';

      // 1. PIN Security Gate
      const pinGate = document.getElementById('pinGate');
      const mainDashboard = document.getElementById('mainDashboard');
      const pinForm = document.getElementById('pinForm');
      const pinInput = document.getElementById('pinInput');
      const pinError = document.getElementById('pinError');
      const lockBtn = document.getElementById('lockBtn');

      function checkSavedAuth() {
        if (sessionStorage.getItem('kt_ops_authenticated') === 'true') {
          pinGate.classList.add('hidden');
          mainDashboard.classList.remove('hidden');
          initData();
        }
      }

      pinForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (pinInput.value.trim() === CORRECT_PIN) {
          sessionStorage.setItem('kt_ops_authenticated', 'true');
          pinGate.classList.add('hidden');
          mainDashboard.classList.remove('hidden');
          pinError.classList.add('hidden');
          initData();
        } else {
          pinError.classList.remove('hidden');
          pinInput.value = '';
          pinInput.focus();
        }
      });

      lockBtn.addEventListener('click', () => {
        sessionStorage.removeItem('kt_ops_authenticated');
        mainDashboard.classList.add('hidden');
        pinGate.classList.remove('hidden');
        pinInput.value = '';
      });

      // 2. CSV Parser
      function parseCSV(text) {
        const lines = [];
        let row = [];
        let inQuotes = false;
        let currentValue = '';

        for (let i = 0; i < text.length; i++) {
          const char = text[i];
          const nextChar = text[i + 1];

          if (char === '"') {
            if (inQuotes && nextChar === '"') {
              currentValue += '"';
              i++;
            } else {
              inQuotes = !inQuotes;
            }
          } else if (char === ',' && !inQuotes) {
            row.push(currentValue.trim());
            currentValue = '';
          } else if ((char === '\r' || char === '\n') && !inQuotes) {
            if (char === '\r' && nextChar === '\n') i++;
            row.push(currentValue.trim());
            if (row.some(val => val.length > 0)) lines.push(row);
            row = [];
            currentValue = '';
          } else {
            currentValue += char;
          }
        }
        if (currentValue.length > 0 || row.length > 0) {
          row.push(currentValue.trim());
          if (row.some(val => val.length > 0)) lines.push(row);
        }
        return lines;
      }

      // 3. Data Storage & Google Sheet Merging
      function normalizeTrip(t, idx = 0) {
        const isTirupati = (t.category === 'tirupati') || (t.id && t.id.includes('TPT'));
        return {
          id: t.id || `#KT-${100 + idx}`,
          category: t.category || (isTirupati ? 'tirupati' : 'outstation'),
          guest: t.guest || 'Guest',
          datetime: t.datetime || 'TBD',
          pickup: t.pickup || 'Chennai',
          vehicle: t.vehicle || 'Sedan',
          pax: t.pax || '4 Pax',
          kyc: t.kyc || 'Pending',
          darshan: t.darshan || (isTirupati ? 'Needs Tickets (Unassigned)' : 'N/A'),
          driver: t.driver || 'Unassigned',
          manifest: t.manifest || 'Pending',
          transit: t.transit || 'Scheduled',
          closure: t.closure || 'Unpaid (Post-Trip Due)',
          review: t.review || 'Pending',
          notes: t.notes || '',
          fare: (t.fare || '₹6,000').startsWith('₹') ? t.fare : `₹${t.fare}`,
          payout: (t.payout || '₹4,800').startsWith('₹') ? t.payout : `₹${t.payout}`,
          margin: (t.margin || '₹1,200').startsWith('₹') ? t.margin : `₹${t.margin}`
        };
      }

      function loadLocalOrders() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          return saved ? JSON.parse(saved) : [];
        } catch {
          return [];
        }
      }

      function saveLocalOrders(orders) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
        } catch (e) {
          console.error(e);
        }
      }

      async function initData() {
        const local = loadLocalOrders();
        if (local.length > 0) {
          allTrips = local.map((t, idx) => normalizeTrip(t, idx));
          renderDashboard();
        }
        await fetchSheetData();
      }

      async function fetchSheetData() {
        const refreshIcon = document.getElementById('refreshIcon');
        const lastUpdatedText = document.getElementById('lastUpdatedText');
        refreshIcon.classList.add('animate-spin');

        try {
          const response = await fetch(`${CSV_URL}&t=${Date.now()}`);
          if (!response.ok) throw new Error('Network error');
          const csvText = await response.text();
          const parsed = parseCSV(csvText);

          if (parsed.length > 1) {
            const sheetTrips = parsed.slice(1).map((row, idx) => {
              const isTirupati = (row[0] || '').includes('TPT') || (row[7] || '').toLowerCase().includes('darshan') || (row[7] || '').toLowerCase().includes('confirmed');
              return normalizeTrip({
                id: row[0] || `#KT-${100 + idx}`,
                category: isTirupati ? 'tirupati' : 'outstation',
                guest: row[1] || 'Guest',
                datetime: row[2] || 'TBD',
                pickup: row[3] || 'Chennai',
                vehicle: row[4] || 'Sedan',
                pax: row[5] || '4 Pax',
                kyc: row[6] || 'Pending',
                darshan: row[7] || (isTirupati ? 'Needs Tickets (Unassigned)' : 'N/A'),
                driver: row[8] || 'Unassigned',
                manifest: row[9] || 'Pending',
                fare: row[10] || '₹6,000',
                payout: row[11] || '₹4,800',
                margin: row[12] || '₹1,200',
                closure: (row[13] || '').includes('Settled') ? 'Settled (UPI)' : 'Unpaid (Post-Trip Due)',
                transit: row[14] || 'Scheduled',
                review: row[15] || 'Pending',
                notes: row[16] || ''
              }, idx);
            });

            const local = loadLocalOrders().map((t, idx) => normalizeTrip(t, idx));
            const localOnly = local.filter(l => !sheetTrips.some(s => s.id === l.id));
            allTrips = [...localOnly, ...sheetTrips];
            saveLocalOrders(allTrips);

            renderDashboard();
            const now = new Date();
            lastUpdatedText.textContent = `Synced ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
          }
        } catch (err) {
          console.error(err);
          lastUpdatedText.textContent = 'Offline Mode';
        } finally {
          refreshIcon.classList.remove('animate-spin');
        }
      }

      // =========================================================================
      // DYNAMIC VEHICLE CAPACITY FILTERING & PACKAGE SWITCHING ENGINE
      // =========================================================================
      window.adjustPax = function(delta) {
        const input = document.getElementById('formPaxInput');
        let current = parseInt(input.value) || 4;
        current = Math.max(1, Math.min(20, current + delta));
        input.value = current;
        handlePaxChange(current);
      };

      window.setPax = function(num) {
        document.getElementById('formPaxInput').value = num;
        document.querySelectorAll('.pax-quick-btn').forEach(btn => {
          btn.classList.remove('active', 'bg-[#1E252D]', 'text-white', 'border-[#1E252D]');
          btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
        });
        if (window.event && window.event.target) {
          const target = window.event.target.closest('.pax-quick-btn');
          if (target) {
            target.classList.add('active', 'bg-[#1E252D]', 'text-white', 'border-[#1E252D]');
            target.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
          }
        }
        handlePaxChange(num);
      };

      window.handlePaxChange = function(paxVal) {
        const pax = parseInt(paxVal) || 1;
        document.getElementById('paxDisplayLabel').textContent = pax;

        const sedanCard = document.getElementById('vehicleOptionSedan');
        const ertigaCard = document.getElementById('vehicleOptionErtiga');
        const crystaCard = document.getElementById('vehicleOptionCrysta');
        const tempoCard = document.getElementById('vehicleOptionTempo');
        const warning = document.getElementById('capacityWarningText');

        const sedanRadio = sedanCard.querySelector('input');
        const ertigaRadio = ertigaCard.querySelector('input');
        const crystaRadio = crystaCard.querySelector('input');
        const tempoRadio = tempoCard.querySelector('input');

        // RULE 1: PAX <= 4 (All available)
        if (pax <= 4) {
          sedanCard.classList.remove('hidden');
          ertigaCard.classList.remove('hidden');
          crystaCard.classList.remove('hidden');
          tempoCard.classList.remove('hidden');
          warning.classList.add('hidden');
        }
        // RULE 2: PAX 5 or 6 (Sedan ELIMINATED)
        else if (pax <= 6) {
          sedanCard.classList.add('hidden');
          ertigaCard.classList.remove('hidden');
          crystaCard.classList.remove('hidden');
          tempoCard.classList.remove('hidden');
          warning.classList.remove('hidden');
          warning.textContent = '⚠️ AC Sedan (Max 4 Pax) auto-removed. Maruti Ertiga (6 Pax) selected.';

          if (sedanRadio.checked) ertigaRadio.checked = true;
        }
        // RULE 3: PAX = 7 (Sedan & Ertiga ELIMINATED)
        else if (pax === 7) {
          sedanCard.classList.add('hidden');
          ertigaCard.classList.add('hidden');
          crystaCard.classList.remove('hidden');
          tempoCard.classList.remove('hidden');
          warning.classList.remove('hidden');
          warning.textContent = '⚠️ Sedan & Ertiga auto-removed. Innova Crysta (7 Pax) selected.';

          if (sedanRadio.checked || ertigaRadio.checked) crystaRadio.checked = true;
        }
        // RULE 4: PAX >= 8 (ALL CARS ELIMINATED, ONLY TEMPO ALLOWED)
        else {
          sedanCard.classList.add('hidden');
          ertigaCard.classList.add('hidden');
          crystaCard.classList.add('hidden');
          tempoCard.classList.remove('hidden');
          warning.classList.remove('hidden');
          warning.textContent = '⚠️ Passenger count is 8+. Group requires Tempo Traveller (12–17 Seater).';

          tempoRadio.checked = true;
        }

        updateTariffCalculations();
      };

      // Handle Package Vertical Switch
      window.handlePackageTypeChange = function() {
        const pkg = document.getElementById('formPackageType').value;
        const tirupatiFields = document.getElementById('tirupatiExclusiveFields');
        const outstationFields = document.getElementById('outstationExclusiveFields');
        const airportFields = document.getElementById('airportExclusiveFields');
        const localFields = document.getElementById('localExclusiveFields');

        tirupatiFields.classList.add('hidden');
        outstationFields.classList.add('hidden');
        airportFields.classList.add('hidden');
        localFields.classList.add('hidden');

        if (pkg === 'tirupati') {
          tirupatiFields.classList.remove('hidden');
        } else if (pkg === 'outstation' || pkg === 'temple') {
          outstationFields.classList.remove('hidden');
        } else if (pkg === 'airport') {
          airportFields.classList.remove('hidden');
        } else if (pkg === 'local') {
          localFields.classList.remove('hidden');
        }

        updateTariffCalculations();
      };

      // Dynamic Price & Margin Calculator
      window.updateTariffCalculations = function() {
        const pkg = document.getElementById('formPackageType').value;
        const vehicle = document.querySelector('input[name="vehicleChoice"]:checked')?.value || 'Sedan';

        let fare = '₹6,000';
        let payout = '₹4,800';
        let margin = '₹1,200';

        if (pkg === 'tirupati') {
          if (vehicle === 'Sedan') { fare = '₹6,000'; payout = '₹4,800'; margin = '₹1,200'; }
          else if (vehicle === 'Ertiga') { fare = '₹8,500'; payout = '₹7,200'; margin = '₹1,300'; }
          else if (vehicle.includes('Crysta')) { fare = '₹11,000'; payout = '₹9,500'; margin = '₹1,500'; }
          else if (vehicle.includes('Tempo')) { fare = '₹14,500'; payout = '₹12,000'; margin = '₹2,500'; }
        } else if (pkg === 'airport') {
          if (vehicle === 'Sedan') { fare = '₹1,200'; payout = '₹950'; margin = '₹250'; }
          else if (vehicle === 'Ertiga') { fare = '₹1,800'; payout = '₹1,450'; margin = '₹350'; }
          else if (vehicle.includes('Crysta')) { fare = '₹2,500'; payout = '₹2,000'; margin = '₹500'; }
          else if (vehicle.includes('Tempo')) { fare = '₹3,500'; payout = '₹2,800'; margin = '₹700'; }
        } else if (pkg === 'local') {
          if (vehicle === 'Sedan') { fare = '₹2,600'; payout = '₹2,100'; margin = '₹500'; }
          else if (vehicle === 'Ertiga') { fare = '₹3,400'; payout = '₹2,800'; margin = '₹600'; }
          else if (vehicle.includes('Crysta')) { fare = '₹5,200'; payout = '₹4,300'; margin = '₹900'; }
          else if (vehicle.includes('Tempo')) { fare = '₹6,500'; payout = '₹5,300'; margin = '₹1,200'; }
        } else {
          // Outstation / Temple Tour Estimate
          if (vehicle === 'Sedan') { fare = '₹5,500'; payout = '₹4,400'; margin = '₹1,100'; }
          else if (vehicle === 'Ertiga') { fare = '₹7,800'; payout = '₹6,400'; margin = '₹1,400'; }
          else if (vehicle.includes('Crysta')) { fare = '₹10,200'; payout = '₹8,600'; margin = '₹1,600'; }
          else if (vehicle.includes('Tempo')) { fare = '₹13,500'; payout = '₹11,200'; margin = '₹2,300'; }
        }

        document.getElementById('formFareInput').value = fare;
        document.getElementById('formPayoutInput').value = payout;
        document.getElementById('formMarginInput').value = margin;
      };

      // 4. Render Dashboard Views & Inline Workflow Controls
      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function showToast(msg) {
        const toast = document.getElementById('opsToast');
        const msgEl = document.getElementById('toastMsg');
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
        }, 2200);
      }

      window.updateTripStage = function(id, stage, value) {
        const trip = allTrips.find(t => t.id === id);
        if (!trip) return;
        trip[stage] = value;
        saveLocalOrders(allTrips);
        showToast(`Updated ${stage.toUpperCase()} for ${trip.id}`);
        renderDashboard();
      };

      window.updateTripNotes = function(id, value) {
        const trip = allTrips.find(t => t.id === id);
        if (!trip) return;
        trip.notes = value.trim();
        saveLocalOrders(allTrips);
        showToast(`Remarks saved for ${trip.id}`);
      };

      window.deleteBooking = function(id) {
        if (confirm(`Are you sure you want to delete booking ${id}?`)) {
          allTrips = allTrips.filter(t => t.id !== id);
          saveLocalOrders(allTrips);
          showToast(`Deleted ${id}`);
          renderDashboard();
        }
      };

      function renderKycSelect(t) {
        const val = (t.kyc || 'Pending');
        const isVerif = val.toLowerCase().includes('verif');
        const isRej = val.toLowerCase().includes('reject');
        const borderIndicator = isVerif
          ? 'border-l-[3px] border-l-emerald-600'
          : isRej
          ? 'border-l-[3px] border-l-rose-600'
          : 'border-l-[3px] border-l-amber-500';
        
        return `
          <select onchange="updateTripStage('${t.id}', 'kyc', this.value)" class="h-[26px] py-0 px-1 rounded-[2px] bg-slate-50 border border-slate-300 ${borderIndicator} font-mono-code text-[11px] font-semibold text-slate-900 cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors">
            <option value="Pending" ${!isVerif && !isRej ? 'selected' : ''}>▲ PENDING KYC</option>
            <option value="Verified" ${isVerif ? 'selected' : ''}>● VERIFIED</option>
            <option value="Rejected" ${isRej ? 'selected' : ''}>■ REJECTED</option>
          </select>
        `;
      }

      function renderDarshanSelect(t) {
        const isTirupati = t.category === 'tirupati' || t.id.includes('TPT');
        if (!isTirupati) {
          return `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-[2px] bg-slate-100 text-slate-700 text-[10px] font-mono-code font-semibold border border-slate-300">ROUTE FIXED</span>`;
        }
        const val = (t.darshan || 'Needs Tickets (Unassigned)');
        const isConfirmed = val.toLowerCase().includes('confirm');
        const isProcess = val.toLowerCase().includes('process');
        const isOwn = val.toLowerCase().includes('have') || val.toLowerCase().includes('own');
        const borderIndicator = isConfirmed
          ? 'border-l-[3px] border-l-emerald-600'
          : isProcess
          ? 'border-l-[3px] border-l-amber-500'
          : isOwn
          ? 'border-l-[3px] border-l-slate-400'
          : 'border-l-[3px] border-l-rose-600';

        return `
          <select onchange="updateTripStage('${t.id}', 'darshan', this.value)" class="h-[26px] py-0 px-1 rounded-[2px] bg-slate-50 border border-slate-300 ${borderIndicator} font-mono-code text-[11px] font-semibold text-slate-900 cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors" title="Pilgrimage Ticketing Desk (SLA: 120m)">
            <option value="Needs Tickets (Unassigned)" ${!isConfirmed && !isProcess && !isOwn ? 'selected' : ''}>■ NEEDS QUOTA</option>
            <option value="In-Process with Ticketing Desk" ${isProcess ? 'selected' : ''}>▲ IN-PROCESS 120M</option>
            <option value="Confirmed (11:30 AM)" ${val.includes('11:30') ? 'selected' : ''}>● CONFIRMED (11:30)</option>
            <option value="Confirmed (Special Slot)" ${val.includes('Special') ? 'selected' : ''}>● CONFIRMED (SPECIAL)</option>
            <option value="Already Have Tickets" ${isOwn ? 'selected' : ''}>◆ DEVOTEE'S OWN</option>
          </select>
        `;
      }

      function renderManifestSelect(t) {
        const val = (t.manifest || 'Pending');
        const isDispatched = val.toLowerCase().includes('dispatch');
        const isAssigned = val.toLowerCase().includes('assign');
        const borderIndicator = isDispatched
          ? 'border-l-[3px] border-l-emerald-600'
          : isAssigned
          ? 'border-l-[3px] border-l-amber-500'
          : 'border-l-[3px] border-l-rose-600';

        return `
          <div class="space-y-0.5">
            <select onchange="updateTripStage('${t.id}', 'manifest', this.value)" class="h-[26px] py-0 px-1 rounded-[2px] bg-slate-50 border border-slate-300 ${borderIndicator} font-mono-code text-[11px] font-semibold text-slate-900 cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors">
              <option value="Pending" ${!isDispatched && !isAssigned ? 'selected' : ''}>■ PENDING DRIVER</option>
              <option value="Assigned" ${isAssigned ? 'selected' : ''}>▲ ASSIGNED</option>
              <option value="Dispatched" ${isDispatched ? 'selected' : ''}>● DISPATCHED</option>
            </select>
            <div class="text-[10px] font-mono-code text-slate-600 flex items-center gap-1 cursor-pointer hover:text-black truncate max-w-[170px]" onclick="openStatusModal('${t.id}')" title="Click to assign chauffeur details">
              <span class="material-symbols-outlined text-[12px] text-slate-500">person</span>
              <span>${escapeHtml(t.driver || 'Click to assign')}</span>
            </div>
          </div>
        `;
      }

      function renderTransitSelect(t) {
        const val = (t.transit || 'Scheduled');
        const isComp = val.toLowerCase().includes('complet');
        const isOnTrip = val.toLowerCase().includes('trip') || val.toLowerCase().includes('route');
        const isCancel = val.toLowerCase().includes('cancel');
        const borderIndicator = isComp
          ? 'border-l-[3px] border-l-emerald-600'
          : isOnTrip
          ? 'border-l-[3px] border-l-amber-500'
          : isCancel
          ? 'border-l-[3px] border-l-rose-600'
          : 'border-l-[3px] border-l-slate-400';

        return `
          <select onchange="updateTripStage('${t.id}', 'transit', this.value)" class="h-[26px] py-0 px-1 rounded-[2px] bg-slate-50 border border-slate-300 ${borderIndicator} font-mono-code text-[11px] font-semibold text-slate-900 cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors">
            <option value="Scheduled" ${!isComp && !isOnTrip && !isCancel ? 'selected' : ''}>◆ SCHEDULED</option>
            <option value="On Trip" ${isOnTrip ? 'selected' : ''}>▲ EN ROUTE</option>
            <option value="Completed" ${isComp ? 'selected' : ''}>● COMPLETED</option>
            <option value="Cancelled" ${isCancel ? 'selected' : ''}>■ CANCELLED</option>
          </select>
        `;
      }

      function renderClosureSelect(t) {
        const val = (t.closure || 'Unpaid (Post-Trip Due)');
        const isSettled = val.toLowerCase().includes('settled') || val.toLowerCase().includes('audit');
        const isAdvance = val.toLowerCase().includes('advance');
        const borderIndicator = isSettled
          ? 'border-l-[3px] border-l-emerald-600'
          : isAdvance
          ? 'border-l-[3px] border-l-amber-500'
          : 'border-l-[3px] border-l-rose-600';

        return `
          <div class="space-y-0.5 text-right font-mono-code">
            <div class="font-bold text-xs text-slate-900">${t.fare}</div>
            <div class="text-[10px] font-bold text-emerald-800">PROFIT: ${t.margin}</div>
            <select onchange="updateTripStage('${t.id}', 'closure', this.value)" class="h-[24px] py-0 px-1 rounded-[2px] bg-slate-50 border border-slate-300 ${borderIndicator} font-mono-code text-[10px] font-semibold text-slate-900 cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors">
              <option value="Unpaid (Post-Trip Due)" ${!isSettled && !isAdvance ? 'selected' : ''}>■ DUE AT DROP</option>
              <option value="Advance Paid" ${isAdvance ? 'selected' : ''}>▲ ADVANCE PAID</option>
              <option value="Settled (UPI)" ${val.includes('Settled') ? 'selected' : ''}>● SETTLED UPI/CASH</option>
              <option value="Margin Audited" ${val.includes('Audited') ? 'selected' : ''}>★ AUDITED</option>
            </select>
          </div>
        `;
      }

      function renderReviewSelect(t) {
        const val = (t.review || 'Pending');
        const is5Star = val.includes('5') || val.toLowerCase().includes('google');
        const isReq = val.toLowerCase().includes('request');
        const isEsc = val.toLowerCase().includes('escalat');
        const borderIndicator = is5Star
          ? 'border-l-[3px] border-l-emerald-600'
          : isReq
          ? 'border-l-[3px] border-l-amber-500'
          : isEsc
          ? 'border-l-[3px] border-l-rose-600'
          : 'border-l-[3px] border-l-slate-400';

        return `
          <select onchange="updateTripStage('${t.id}', 'review', this.value)" class="h-[26px] py-0 px-1 rounded-[2px] bg-slate-50 border border-slate-300 ${borderIndicator} font-mono-code text-[11px] font-semibold text-slate-900 cursor-pointer focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors">
            <option value="Pending" ${!is5Star && !isReq && !isEsc ? 'selected' : ''}>◆ PENDING</option>
            <option value="Review Requested" ${isReq ? 'selected' : ''}>▲ LINK SENT</option>
            <option value="5★ Google Review" ${is5Star ? 'selected' : ''}>★ 5★ GOOGLE</option>
            <option value="Issue Escalated" ${isEsc ? 'selected' : ''}>■ ESCALATED</option>
          </select>
        `;
      }

      function renderDashboard() {
        const tbody = document.getElementById('tripTableBody');
        const mobileContainer = document.getElementById('mobileCardsContainer');
        const searchVal = document.getElementById('searchInput').value.toLowerCase();

        const total = allTrips.length;
        let actionCount = 0;
        let tirupatiCount = 0;
        let dispatchedCount = 0;
        let marginTotal = 0;

        allTrips.forEach(t => {
          const isKycPending = (t.kyc || '').toLowerCase().includes('pending');
          const isTicketPending = (t.darshan || '').toLowerCase().includes('unassigned') || (t.darshan || '').toLowerCase().includes('process');
          const isDriverPending = (t.manifest || '').toLowerCase().includes('pending');
          if (isKycPending || isTicketPending || isDriverPending) actionCount++;

          if ((t.category === 'tirupati' || t.id.includes('TPT')) && ((t.darshan || '').toLowerCase().includes('confirm') || (t.darshan || '').toLowerCase().includes('booked'))) {
            tirupatiCount++;
          }
          if ((t.manifest || '').toLowerCase().includes('dispatch')) dispatchedCount++;

          const numericMargin = parseInt((t.margin || '1200').replace(/[^0-9]/g, '')) || 1200;
          marginTotal += numericMargin;
        });

        document.getElementById('kpiTotal').textContent = total;
        document.getElementById('kpiAction').textContent = actionCount;
        document.getElementById('kpiTickets').textContent = tirupatiCount;
        document.getElementById('kpiDispatched').textContent = dispatchedCount;
        document.getElementById('kpiMargin').textContent = `₹${marginTotal.toLocaleString('en-IN')}`;

        // Filter Rows
        const filtered = allTrips.filter((t, idx) => {
          const serialStr = `#${idx + 1} ${idx + 1}`;
          const searchable = (serialStr + ' ' + t.id + ' ' + t.guest + ' ' + t.pickup + ' ' + (t.driver || '') + ' ' + (t.category || '') + ' ' + (t.notes || '')).toLowerCase();
          const textMatch = searchable.includes(searchVal);
          if (!textMatch) return false;

          if (activeFilter === 'tirupati') {
            return t.category === 'tirupati' || t.id.includes('TPT');
          }
          if (activeFilter === 'outstation') {
            return t.category === 'outstation' || t.category === 'temple' || t.id.includes('OUT');
          }
          if (activeFilter === 'airport') {
            return t.category === 'airport' || t.id.includes('AIR');
          }
          if (activeFilter === 'action') {
            return (t.kyc || '').toLowerCase().includes('pending') || (t.darshan || '').toLowerCase().includes('unassigned') || (t.manifest || '').toLowerCase().includes('pending');
          }
          if (activeFilter === 'unsettled') {
            return (t.closure || '').toLowerCase().includes('unpaid') || (t.closure || '').toLowerCase().includes('unreconciled');
          }
          return true;
        });

        if (filtered.length === 0) {
          const emptyHtml = `<div class="p-8 text-center text-slate-500 font-mono-code text-xs bg-white rounded-[4px] border border-slate-300">NO TELEMETRY MATCHES FOUND FOR THIS FILTER.</div>`;
          tbody.innerHTML = `<tr><td colspan="14" class="text-center py-12 text-slate-500 font-mono-code text-xs">NO DISPATCH MANIFESTS MATCHING QUERY.</td></tr>`;
          mobileContainer.innerHTML = emptyHtml;
          return;
        }

        // --- RENDER MOBILE INDUSTRIAL TELEMETRY CARDS ---
        mobileContainer.innerHTML = filtered.map((t, idx) => {
          const serialNum = idx + 1;
          const isTirupati = t.category === 'tirupati' || t.id.includes('TPT');
          const categoryTag = isTirupati
            ? `<span class="px-1.5 py-0.5 rounded-[2px] bg-amber-100 text-amber-900 border border-amber-300 font-mono-code text-[10px] font-bold uppercase">TIRUPATI</span>`
