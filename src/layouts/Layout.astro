  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: "+919092303060",
      contactType: "customer service",
      areaServed: "IN",
      availableLanguage: ["en", "ta"],
    },
  ],
  sameAs: [
    "https://maps.google.com/?q=Kalidass+Travels+Medavakkam+Chennai",
  ],
};

const localBusinessSchema = {
  "@type": ["TaxiService", "TravelAgency"],
  "@id": "https://kalidasstravels.in/#localbusiness",
  name: "Kalidass Travels",
  image: "https://kalidasstravels.in/images/logo.webp",
  description: description || "Premium taxi, temple tour, and corporate cab services across Chennai and South India.",
  telephone: "+919092303060",
  email: "kalidasstravels2015@gmail.com",
  url: "https://kalidasstravels.in/",
  parentOrganization: {
