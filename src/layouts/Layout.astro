const defaultTitle = "Kalidass Travels - Premium Travel Experience";
const defaultDescription = "Premium travel and cab services across South India. Professional drivers, comfortable vehicles, affordable rates.";
const defaultKeywords = "taxi service Chennai, temple tours Tamil Nadu, corporate travel Chennai, airport taxi Chennai, outstation cabs Chennai, Kalidass Travels";

const defaultOgImage = "/images/logo-clean-white.png";

const {
  title = defaultTitle,
  description = defaultDescription,
  image,
  ogImage,
  type = "website",
  url = Astro.url.href,
  schema,
  keywords = defaultKeywords,
  showFloatingActions = true,
  preloadHero,
} = Astro.props;

const siteUrl = "https://kalidasstravels.in";
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isHome = pathname === "/" || pathname === "";
const isTamilPage = pathname.startsWith("/ta");
const canonicalURL = new URL(pathname, siteUrl).href;

const isFleet = pathname.startsWith("/fleet");
const isDrivers = pathname.startsWith("/drivers");
const isTariff = pathname.startsWith("/tariff");
const isCalculator = pathname.startsWith("/calculator");
const isTempleTours =
  pathname.startsWith("/services/tours/") ||
  pathname.includes("tirupati") ||
  pathname.includes("navagraha") ||
  pathname.includes("girivalam") ||
  pathname.includes("kanchipuram") ||
  pathname.includes("vellore") ||
  pathname.includes("chidambaram") ||
  pathname.includes("rameswaram") ||
  pathname.includes("tiruchendur") ||
  pathname.includes("sabarimala") ||
  pathname.includes("temple");
const isCabsAndRentals =
  !isTempleTours &&
  (pathname.startsWith("/services") ||
    pathname.includes("airport") ||
    pathname.includes("outstation") ||
    pathname.includes("corporate") ||
    pathname.includes("acting-driver"));

const rawImage = ogImage || (image && image !== "/images/logo.png" ? image : defaultOgImage);
const fullImage = rawImage.startsWith("http")
  ? rawImage
  : `${siteUrl}${rawImage}`;

