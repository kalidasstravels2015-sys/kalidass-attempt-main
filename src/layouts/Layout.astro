const websiteSchema = {
  "@type": "WebSite",
  "@id": "https://kalidasstravels.in/#website",
  name: "Kalidass Travels",
  alternateName: [
    "Kalidass Travels Chennai",
    "Kalidass",
    "Chennai Kalidass Travels",
    "kalidasstravels.in",
  ],
  url: "https://kalidasstravels.in/",
  publisher: {
    "@id": "https://kalidasstravels.in/#organization",
  },
};

const siteNavigationSchema = {
  "@type": "ItemList",
  "@id": "https://kalidasstravels.in/#navigation",
  name: "Site Navigation Sitelinks",
  itemListElement: [
    {
      "@type": "SiteNavigationElement",
      position: 1,
      name: "Airport Transfers",
      description: "Book reliable Chennai Airport (MAA) taxi transfers with 5-10 min dispatch, flight delay tracking & zero surge.",
      url: "https://kalidasstravels.in/services/chennai-airport-taxi/",
    },
    {
      "@type": "SiteNavigationElement",
      position: 2,
      name: "Outstation Cabs",
      description: "Book clean AC cabs from Chennai for outstation trips, weekend getaways & per-km round trips with zero surge.",
      url: "https://kalidasstravels.in/services/popular-destinations/",
    },
    {
      "@type": "SiteNavigationElement",
      position: 3,
      name: "Temple Tours",
      description: "All-inclusive South India temple tour packages from Chennai to Tirupati, Navagraha, Thiruvannamalai & Rameswaram.",
      url: "https://kalidasstravels.in/services/temple-tours/",
    },
    {
      "@type": "SiteNavigationElement",
      position: 4,
      name: "Corporate Mobility",
      description: "24/7 routed employee commute transport, monthly executive car retainers, and GST compliant billing in Chennai.",
      url: "https://kalidasstravels.in/services/corporate/",
    },
    {
      "@type": "SiteNavigationElement",
      position: 5,
      name: "Acting Drivers",
      description: "Hire background-verified professional acting drivers in Chennai for your personal car on hourly or daily duty.",
      url: "https://kalidasstravels.in/services/acting-drivers/",
    },
    {
      "@type": "SiteNavigationElement",
      position: 6,
      name: "Tariff",
      description: "Official taxi tariff card with transparent local hourly packages and per-km outstation rates.",
      url: "https://kalidasstravels.in/tariff/",
    },
    {
      "@type": "SiteNavigationElement",
      position: 7,
      name: "Fare Calculator",
      description: "Calculate instant, transparent travel costs for outstation cabs, hourly acting drivers & vehicle relocations.",
      url: "https://kalidasstravels.in/calculator/",
    },
  ],
};

// Assemble unified @graph Knowledge Graph
const graphItems: any[] = [organizationSchema, localBusinessSchema, websiteSchema, siteNavigationSchema];

if (schema) {
  if (Array.isArray(schema)) {
    graphItems.push(...schema);
  } else if (typeof schema === "object") {
    const { "@context": _, ...cleanSchema } = schema as any;
    graphItems.push(cleanSchema);
  }
}

const unifiedSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": graphItems,
};
