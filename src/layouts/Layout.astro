---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImage?: string;
  type?: string;
  url?: string;
  schema?: object;
  keywords?: string;
}

import siteContent from "../data/siteContent.json";
import CookieConsent from "../components/CookieConsent.astro";
import FloatingActions from "../components/FloatingActions.astro";

const defaultTitle = "Kalidass Travels - Premium Travel Experience";
const defaultDescription = "Premium travel and cab services across South India. Professional drivers, comfortable vehicles, affordable rates.";
const defaultKeywords = "taxi service Chennai, temple tours Tamil Nadu, corporate travel Chennai, airport taxi Chennai, outstation cabs Chennai, Kalidass Travels";

const {
  title = defaultTitle,
  description = defaultDescription,
  image = "/images/og-main.png",
  ogImage,
  type = "website",
  url = Astro.url.href,
  schema,
  keywords = defaultKeywords,
} = Astro.props;

const services = siteContent.services;
const siteUrl = "https://kalidasstravels.in";
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isHome = pathname === "/" || pathname === "";
const canonicalURL = new URL(pathname, siteUrl).href;

const fullImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage}`
  : image.startsWith("http")
    ? image
    : `${siteUrl}${image}`;

const organizationSchema = {
  "@type": "Organization",
  "@id": "https://kalidasstravels.in/#organization",
  name: "Kalidass Travels",
  alternateName: "Kalidass Travel Agency",
  url: "https://kalidasstravels.in/",
  logo: {
    "@type": "ImageObject",
    "@id": "https://kalidasstravels.in/#logo",
    url: "https://kalidasstravels.in/images/logo.webp",
    caption: "Kalidass Travels Logo",
  },
