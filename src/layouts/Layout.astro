    <!-- Virtual Keyboard API: exposes --keyboard-height and --keyboard-visible CSS variables -->
    <script is:inline>
      (function () {
        var root = document.documentElement;

        function applyHeight(px) {
          var open = px > 80;
          root.style.setProperty('--keyboard-height', (open ? px : 0) + 'px');
          root.style.setProperty('--keyboard-visible', open ? '1' : '0');
        }

        // visualViewport — Chrome 61+, Safari 13+, Firefox 91+
        var vv = window.visualViewport;
        if (vv) {
          function onVVChange() {
            var kh = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
            applyHeight(kh);
          }
          vv.addEventListener('resize', onVVChange);
          vv.addEventListener('scroll', onVVChange);
        }

        // navigator.virtualKeyboard — Chrome 94+ (geometrychange, read-only here)
        var vkb = navigator.virtualKeyboard;
        if (vkb) {
          vkb.addEventListener('geometrychange', function (e) {
            applyHeight(e.target.boundingRect.height);
          });
        }
      })();
    </script>
    <!-- Reading Progress Bar placeholder (rendered inside nav below) -->
    <script is:inline>
      (function () {
        var bar = null;
        var ticking = false;

        function getBar() {
          if (!bar) bar = document.getElementById('reading-progress-bar');
          return bar;
        }

        function updateProgress() {
          var b = getBar();
          if (!b) return;
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          var progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
          b.style.width = (progress * 100) + '%';
          b.style.opacity = progress > 0 ? '1' : '0';
          ticking = false;
        }

        // Scroll listener — always active
        window.addEventListener('scroll', function () {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });

        // Init once DOM is ready (works on every page, every navigation type)
        document.addEventListener('DOMContentLoaded', function () {
          bar = null; // force re-query after DOM is ready
          updateProgress();
        });

        // Astro View Transitions: reset & re-init on SPA navigation
        document.addEventListener('astro:before-preparation', function () {
          var b = getBar();
          if (b) { b.style.width = '0%'; b.style.opacity = '0'; }
        });
        document.addEventListener('astro:after-swap', function () {
          bar = null; // re-query after DOM swap
          var b = getBar();
          if (b) { b.style.width = '0%'; b.style.opacity = '0'; }
          window.scrollTo(0, 0);
        });
        document.addEventListener('astro:page-load', function () {
          bar = null; // re-query after page load
          updateProgress();
        });
      })();
    </script>
