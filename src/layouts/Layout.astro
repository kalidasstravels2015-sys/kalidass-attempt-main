  <!-- Mobile Menu Toggle Script -->
  <script>
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const closeMenuBtn = document.getElementById("close-menu-btn");
    const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
    const mobileMenuDrawer = document.getElementById("mobile-menu-drawer");
    const mobileLinks = mobileMenuDrawer?.querySelectorAll("a");
    const floatingActions = document.getElementById("floating-actions-container");

    // Submenu elements
    const cabsToggle = document.getElementById("cabs-menu-toggle");
    const cabsSubmenu = document.getElementById("cabs-submenu");
    const cabsChevron = document.getElementById("cabs-chevron");

    const toursToggle = document.getElementById("tours-menu-toggle");
    const toursSubmenu = document.getElementById("tours-submenu");
    const toursChevron = document.getElementById("tours-chevron");

    function openMenu() {
      if (mobileMenuOverlay && mobileMenuDrawer) {
        mobileMenuBtn?.setAttribute("aria-expanded", "true");
        mobileMenuOverlay.classList.remove("hidden");
        floatingActions?.classList.add("opacity-0", "pointer-events-none");
        // small delay to allow display:block to apply before opacity transition
        setTimeout(() => {
          mobileMenuOverlay.classList.remove("opacity-0");
          mobileMenuDrawer.classList.remove("translate-x-full");
        }, 10);
        document.body.style.overflow = "hidden"; // Prevent background scrolling

        // Ensure submenus are open by default when menu opens
        cabsSubmenu?.classList.remove("hidden");
        cabsToggle?.setAttribute("aria-expanded", "true");
        cabsChevron?.classList.add("rotate-180");

        toursSubmenu?.classList.remove("hidden");
        toursToggle?.setAttribute("aria-expanded", "true");
        toursChevron?.classList.add("rotate-180");

        // Focus management
        const firstLink = mobileMenuDrawer.querySelector("a, button");
        if (firstLink instanceof HTMLElement) {
          firstLink.focus();
        }
      }
    }

    function closeMenu() {
      if (mobileMenuOverlay && mobileMenuDrawer) {
        mobileMenuBtn?.setAttribute("aria-expanded", "false");
        mobileMenuOverlay.classList.add("opacity-0");
        mobileMenuDrawer.classList.add("translate-x-full");
        floatingActions?.classList.remove("opacity-0", "pointer-events-none");

        setTimeout(() => {
          mobileMenuOverlay.classList.add("hidden");
        }, 300); // Match transition duration
        document.body.style.overflow = "";
        mobileMenuBtn?.focus(); // Return focus
      }
    }

    mobileMenuBtn?.addEventListener("click", openMenu);
    closeMenuBtn?.addEventListener("click", closeMenu);
    mobileMenuOverlay?.addEventListener("click", closeMenu);

    mobileLinks?.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (
          href?.startsWith("#") ||
          (href?.includes("#") && href?.includes(window.location.pathname))
        ) {
          const id = href.split("#")[1];
          const element = document.getElementById(id);
          if (element) {
            e.preventDefault();
            closeMenu();
            // Wait for menu animation to finish
            setTimeout(() => {
              const yOffset = -window.innerHeight / 4; // Adjust to center better
              const y =
                element.getBoundingClientRect().top +
                window.pageYOffset +
                yOffset;
              window.scrollTo({ top: y, behavior: "smooth" });

              // Alternative if simple centering is better:
              // element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 350);
          }
        } else {
          closeMenu();
        }
      });
    });

    // Cabs & Rentals Menu Toggle
    cabsToggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = cabsSubmenu?.classList.toggle("hidden");
      cabsToggle.setAttribute("aria-expanded", String(!isHidden));
      cabsChevron?.classList.toggle("rotate-180");
    });

    // Tour Packages Menu Toggle
    toursToggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = toursSubmenu?.classList.toggle("hidden");
      toursToggle.setAttribute("aria-expanded", String(!isHidden));
      toursChevron?.classList.toggle("rotate-180");
    });
  </script>



  <!-- Sticky Quick-Navigation Scroll Spy -->
  <script>
    import { initStickyQuickNav } from "../lib/stickyQuickNav";

    let cleanup: (() => void) | null = null;
    function init() {
      cleanup?.();
      cleanup = initStickyQuickNav(); // reloaded
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }

    document.addEventListener("astro:page-load", init);
  </script>

  <!-- Virtual Keyboard API: exposes --keyboard-height and --keyboard-visible CSS variables -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      function applyHeight(px) {
        var open = px > 80;
        root.style.setProperty('--keyboard-height', (open ? px : 0) + 'px');
        root.style.setProperty('--keyboard-visible', open ? '1' : '0');
      }
      var vv = window.visualViewport;
      if (vv) {
        function onVVChange() {
          var kh = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
          applyHeight(kh);
        }
        vv.addEventListener('resize', onVVChange);
      }
      var vkb = navigator.virtualKeyboard;
      if (vkb) {
        vkb.addEventListener('geometrychange', function (e) {
          applyHeight(e.target.boundingRect.height);
        });
      }
    })();
  </script>



  <!-- Reading Progress Bar (Scroll-driven without forced reflow) -->
  <script is:inline>
    (function () {
      // Modern baseline browsers run the progress animation entirely on the compositor via CSS @supports (animation-timeline: scroll())
      if (typeof CSS !== 'undefined' && CSS.supports && (CSS.supports('animation-timeline: scroll()') || CSS.supports('animation-timeline', 'scroll()'))) {
        return;
      }

      var bar = null;
      var ticking = false;
      function updateProgress() {
        if (!bar) bar = document.getElementById('scroll-progress-line') || document.getElementById('reading-progress-bar');
        if (!bar) return;
        var scrollTop = window.scrollY;
        if (scrollTop <= 0) {
          bar.style.width = '0%';
          bar.style.opacity = '0';
          ticking = false;
          return;
        }
        var docHeight = (document.documentElement.scrollHeight || document.body.scrollHeight) - window.innerHeight;
        var progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
        bar.style.width = (progress * 100) + '%';
        bar.style.opacity = progress > 0 ? '1' : '0';
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      }, { passive: true });
      document.addEventListener('astro:after-swap', function () {
        bar = null;
      });
    })();
  </script>
