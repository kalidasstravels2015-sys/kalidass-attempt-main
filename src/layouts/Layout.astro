    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />
    <!-- Public Google Sheet webhook (build-time) so CUSTOMER browsers can log enquiries to the admin sheet -->
    <script is:inline define:vars={{ ktSheetUrl: import.meta.env.PUBLIC_GOOGLE_SHEET_WEBHOOK_URL || '' }}>
      window.KT_SHEET_WEBHOOK_URL = ktSheetUrl;
    </script>
    {preloadHero && (
      <link
        rel="preload"
        as="image"
        href={preloadHero.href}
        imagesrcset={preloadHero.srcset}
        imagesizes={preloadHero.sizes}
        fetchpriority="high"
      />
    )}
    <!-- Self-hosted Latin Font Preload (Primary LCP typography) -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Self-hosted Material Symbols Font Preload (Instant Icon Render) -->
    <link
      rel="preload"
      href="/fonts/material-symbols-outlined.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {isTamilPage && (
      <link
        rel="preload"
        href="/fonts/noto-sans-tamil.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <meta name="theme-color" content="#0B57D0" />
    <link rel="icon" type="image/webp" href="/images/favicon.webp" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Kalidass Travels" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-extended" content="index, follow" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <!-- Machine-Readable LLM Discovery Files -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="AI / LLM Context Summary (llms.txt)" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="AI / LLM Comprehensive Knowledge Base (llms-full.txt)" />
    <link rel="alternate" type="text/markdown" href="/.well-known/llms.txt" title="AI / LLM Context Summary (.well-known)" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="AI Crawler Policy" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" title="XML Sitemap" />

    <!-- Schema.org Unified JSON-LD Knowledge Graph (Parsed by Googlebot, Perplexity & AI agents) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(unifiedSchemaGraph)}
    />

    <slot name="head" />

    <title>{title}</title>

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:secure_url" content={fullImage} />
    <meta property="og:image:type" content={fullImage.endsWith('.png') ? 'image/png' : fullImage.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Kalidass Travels" />
    <meta property="og:locale" content={isTamilPage ? "ta_IN" : "en_IN"} />
    <link rel="image_src" href={fullImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kalidasstravels" />
    <meta name="twitter:creator" content="@kalidasstravels" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Open Graph / Twitter Meta Tags Complete -->

    <style is:global>
      /* Self-Hosted Ultra-Fast Variable Fonts */
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 400 800;
        font-display: optional;
        src: url('/fonts/plus-jakarta-sans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Material Symbols Outlined';
        font-style: normal;
        font-weight: 100 700;
        font-display: swap;
        src: url('/fonts/material-symbols-outlined.woff2') format('woff2');
      }

      @font-face {
        font-family: 'Noto Sans Tamil';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/noto-sans-tamil.woff2') format('woff2');
        unicode-range: U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC;
      }

      /* Official Google Material Symbols M3 Configuration with Layout-Safe Fallback */
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-display: swap;
        font-weight: normal;
        font-style: normal;
        font-size: 24px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
        vertical-align: middle;
        width: 1em;
        height: 1em;
        aspect-ratio: 1 / 1;
        flex-shrink: 0;
        overflow: hidden; /* Guaranteed protection: Prevents unrendered ligatures from stretching UI */
        user-select: none;
      }

      /* 100% Google Material Design 3 (M3) Option 1: Google Sapphire Blue & Clean Pearl */
      :root {
        color-scheme: light;

        /* Primary Roles - Google Sapphire Blue (#0B57D0 / Tone 40) */
        --md-sys-color-primary-rgb: 11 87 208;
        --md-sys-color-primary: #0B57D0;
        --md-sys-color-on-primary-rgb: 255 255 255;
        --md-sys-color-on-primary: #FFFFFF;
        --md-sys-color-primary-container-rgb: 211 227 253;
        --md-sys-color-primary-container: #D3E3FD;
        --md-sys-color-on-primary-container-rgb: 4 30 73;
        --md-sys-color-on-primary-container: #041E49;
        --md-sys-color-primary-fixed-rgb: 211 227 253;
        --md-sys-color-primary-fixed: #D3E3FD;
        --md-sys-color-primary-fixed-dim-rgb: 168 199 250;
        --md-sys-color-primary-fixed-dim: #A8C7FA;
        --md-sys-color-on-primary-fixed-rgb: 4 30 73;
        --md-sys-color-on-primary-fixed: #041E49;
        --md-sys-color-on-primary-fixed-variant-rgb: 8 66 160;
        --md-sys-color-on-primary-fixed-variant: #0842A0;

        /* Secondary Roles - Harmonized Slate Steel (Tone 40) */
        --md-sys-color-secondary-rgb: 71 84 103;
        --md-sys-color-secondary: #475467;
        --md-sys-color-on-secondary-rgb: 255 255 255;
        --md-sys-color-on-secondary: #FFFFFF;
        --md-sys-color-secondary-container-rgb: 234 236 240;
        --md-sys-color-secondary-container: #EAECF0;
        --md-sys-color-on-secondary-container-rgb: 29 41 57;
        --md-sys-color-on-secondary-container: #1D2939;
        --md-sys-color-secondary-fixed-rgb: 234 236 240;
        --md-sys-color-secondary-fixed: #EAECF0;
        --md-sys-color-secondary-fixed-dim-rgb: 186 199 222;
        --md-sys-color-secondary-fixed-dim: #BAC7DE;
        --md-sys-color-on-secondary-fixed-rgb: 29 41 57;
        --md-sys-color-on-secondary-fixed: #1D2939;
        --md-sys-color-on-secondary-fixed-variant-rgb: 59 72 90;
        --md-sys-color-on-secondary-fixed-variant: #3B485A;

        /* Tertiary Roles - Harmonized Subtle Slate (Eliminating conflicting gold/amber) */
        --md-sys-color-tertiary-rgb: 71 84 103;
        --md-sys-color-tertiary: #475467;
        --md-sys-color-on-tertiary-rgb: 255 255 255;
        --md-sys-color-on-tertiary: #FFFFFF;
        --md-sys-color-tertiary-container-rgb: 243 244 246;
        --md-sys-color-tertiary-container: #F3F4F6;
        --md-sys-color-on-tertiary-container-rgb: 31 41 55;
        --md-sys-color-on-tertiary-container: #1F2937;
        --md-sys-color-tertiary-fixed-rgb: 243 244 246;
        --md-sys-color-tertiary-fixed: #F3F4F6;
        --md-sys-color-tertiary-fixed-dim-rgb: 229 231 235;
        --md-sys-color-tertiary-fixed-dim: #E5E7EB;
        --md-sys-color-on-tertiary-fixed-rgb: 31 41 55;
        --md-sys-color-on-tertiary-fixed: #1F2937;
        --md-sys-color-on-tertiary-fixed-variant-rgb: 75 85 99;
        --md-sys-color-on-tertiary-fixed-variant: #4B5563;

        /* Success Roles (M3 Custom Harmonized Semantic Color) */
        --md-sys-color-success-rgb: 0 109 59;
        --md-sys-color-success: #006D3B;
        --md-sys-color-on-success-rgb: 255 255 255;
        --md-sys-color-on-success: #FFFFFF;
        --md-sys-color-success-container-rgb: 183 241 196;
        --md-sys-color-success-container: #B7F1C4;
        --md-sys-color-on-success-container-rgb: 0 33 14;
        --md-sys-color-on-success-container: #00210E;

        /* Error Roles */
        --md-sys-color-error-rgb: 186 26 26;
        --md-sys-color-error: #BA1A1A;
        --md-sys-color-on-error-rgb: 255 255 255;
        --md-sys-color-on-error: #FFFFFF;
        --md-sys-color-error-container-rgb: 255 218 214;
        --md-sys-color-error-container: #FFDAD6;
        --md-sys-color-on-error-container-rgb: 65 0 2;
        --md-sys-color-on-error-container: #410002;

        /* Authentic Google M3 Clean Anti-Glare Surface Hierarchy */
        --md-sys-color-surface-rgb: 249 250 251;
        --md-sys-color-surface: #F9FAFB;
        --md-sys-color-surface-dim-rgb: 229 231 235;
        --md-sys-color-surface-dim: #E5E7EB;
        --md-sys-color-surface-bright-rgb: 255 255 255;
        --md-sys-color-surface-bright: #FFFFFF;
        --md-sys-color-surface-container-lowest-rgb: 255 255 255;
        --md-sys-color-surface-container-lowest: #FFFFFF;
        --md-sys-color-surface-container-low-rgb: 243 244 246;
        --md-sys-color-surface-container-low: #F3F4F6;
        --md-sys-color-surface-container-rgb: 236 238 241;
        --md-sys-color-surface-container: #ECEEF1;
        --md-sys-color-surface-container-high-rgb: 232 234 237;
        --md-sys-color-surface-container-high: #E8EAED;
        --md-sys-color-surface-container-highest-rgb: 226 228 233;
        --md-sys-color-surface-container-highest: #E2E4E9;

        /* Text, Outlines, Inverse & Tint - Enhanced WCAG AAA Contrast (8.5:1) */
        --md-sys-color-on-surface-rgb: 17 24 39;
        --md-sys-color-on-surface: #111827;
        --md-sys-color-on-surface-variant-rgb: 71 84 103;
        --md-sys-color-on-surface-variant: #475467;
        --md-sys-color-outline-rgb: 107 114 128;
        --md-sys-color-outline: #6B7280;
        --md-sys-color-outline-variant-rgb: 201 205 211;
        --md-sys-color-outline-variant: #C9CDD3;
        --md-sys-color-inverse-surface-rgb: 31 41 55;
        --md-sys-color-inverse-surface: #1F2937;
        --md-sys-color-inverse-on-surface-rgb: 249 250 251;
        --md-sys-color-inverse-on-surface: #F9FAFB;
        --md-sys-color-inverse-primary-rgb: 156 163 175;
        --md-sys-color-inverse-primary: #9CA3AF;
        --md-sys-color-surface-tint-rgb: 11 87 208;
        --md-sys-color-surface-tint: #0B57D0;
        --md-sys-color-scrim-rgb: 0 0 0;
        --md-sys-color-scrim: #000000;
        --md-sys-color-shadow-rgb: 0 0 0;
        --md-sys-color-shadow: #000000;

        /* Brand Accent (Signature "K" Logo Mark Only - Rule 2 Protected) */
        --md-sys-color-brand-red-rgb: 236 34 31;
        --md-sys-color-brand-red: #EC221F;
      }

      html {
        font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
        scroll-behavior: smooth;
        background-color: var(--md-sys-color-surface, #F9FAFB);
        color: var(--md-sys-color-on-surface, #111827);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Global scroll margin fallback for targeted anchors to clear the sticky top header */
      :target {
        scroll-margin-top: 5.5rem;
      }

      body {
        background-color: var(--md-sys-color-surface, #F9FAFB);
        color: var(--md-sys-color-on-surface, #111827);
        font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
        letter-spacing: -0.025em;
        text-rendering: optimizeLegibility;
      }

      h1 {
        line-height: 1.15;
        font-weight: 800;
      }

      h2 {
        line-height: 1.25;
        font-weight: 800;
      }

      h3 {
        line-height: 1.35;
        font-weight: 700;
      }

      h4 {
        line-height: 1.4;
        font-weight: 700;
      }

      p {
        line-height: 1.65;
        text-rendering: optimizeLegibility;
      }

      /* Tabular numbers for financial and pricing figures */
      .tabular-nums, [data-price], .price-figure {
        font-variant-numeric: tabular-nums;
      }

      /* WCAG 2.2 Level AA / AAA Touch Target Ergonomics */
      button:not(.btn-inline), a.btn, a[role="button"] {
        touch-action: manipulation;
      }

      /* Interactive button active feedback physics */
      button:active, a.btn:active, [role="button"]:active {
        transform: scale(0.98);
        transition: transform 0.1s ease-out;
      }

      /* Multi-Layer Elevation & Depth System */
      .elevation-resting {
        box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.05), 0 8px 16px -4px rgba(15, 23, 42, 0.04);
        border: 1px solid rgba(203, 213, 225, 0.8);
      }
      .elevation-hover {
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
      }
      .elevation-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.08), 0 12px 24px -4px rgba(15, 23, 42, 0.08);
        border-color: rgba(148, 163, 184, 0.8);
      }
      .elevation-2 {
        box-shadow: 0 4px 12px -1px rgba(15, 23, 42, 0.08), 0 2px 6px -2px rgba(15, 23, 42, 0.04);
      }
      .elevation-3 {
        box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.1), 0 4px 12px -2px rgba(15, 23, 42, 0.05);
      }

      /* Skeleton Shimmer Effect */
      .skeleton-shimmer {
        position: relative;
        overflow: hidden;
        background-color: #e2e8f0;
        border-radius: 1rem;
      }

      .skeleton-shimmer::after {
        content: "";
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0) 0,
          rgba(255, 255, 255, 0.4) 20%,
          rgba(255, 255, 255, 0.7) 60%,
          rgba(255, 255, 255, 0)
        );
        animation: shimmer 2s infinite;
      }

      @keyframes shimmer {
        100% {
          transform: translateX(100%);
        }
      }

      /* Google Places Autocomplete - Smart Mobile & Desktop Viewport Handling */
      .pac-container {
        z-index: 99999 !important;
        border-radius: 12px !important;
        box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(15, 23, 42, 0.08) !important;
        border: 1px solid #E2E8F0 !important;
        background-color: #FFFFFF !important;
        margin-top: 4px !important;
        font-family: "Plus Jakarta Sans", sans-serif !important;
        overflow-y: auto !important;
        max-height: min(300px, calc(100dvh - var(--keyboard-height, 0px) - 180px)) !important;
        -webkit-overflow-scrolling: touch !important;
        pointer-events: auto !important;
        overscroll-behavior: contain !important;
      }
      .pac-container.pac-flipped-above {
        margin-top: 0 !important;
        margin-bottom: 4px !important;
        box-shadow: 0 -12px 28px -4px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(15, 23, 42, 0.08) !important;
        border-radius: 12px !important;
      }
      .pac-item {
        padding: 9px 12px !important;
        font-size: 13px !important;
        line-height: 1.35 !important;
        cursor: pointer !important;
        min-height: 40px !important;
        display: flex !important;
        align-items: center !important;
        border-bottom: 1px solid #F1F5F9 !important;
        transition: background-color 0.15s ease !important;
        white-space: normal !important;
        touch-action: pan-y !important;
        user-select: none !important;
        -webkit-user-select: none !important;
      }
      .pac-item:last-child {
        border-bottom: none !important;
      }
      .pac-item:hover,
      .pac-item.pac-item-selected {
        background-color: #F1F5F9 !important;
      }
      .pac-item-query {
        font-size: 13px !important;
        font-weight: 600 !important;
        color: #0F172A !important;
        padding-right: 4px !important;
      }
      .pac-matched {
        font-weight: 700 !important;
        color: #0F172A !important;
      }
      .pac-secondary-text {
        font-size: 11px !important;
        color: #64748B !important;
        display: inline !important;
      }
      .pac-icon {
        margin-right: 10px !important;
        margin-top: 1px !important;
        transform: scale(0.9) !important;
      }

      /* Autocomplete input scroll positioning headroom */
      .pac-target-input,
      [data-autocomplete-input] {
        scroll-margin-top: 75px !important;
      }

      /* Clean swipeable containers without ugly desktop/mobile scrollbars */
      .no-scrollbar::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
      .no-scrollbar {
        -ms-overflow-style: none !important;
        scrollbar-width: none !important;
        -webkit-overflow-scrolling: touch;
      }

      /* Modern Web Guidance: Defer rendering and asset decoding for offscreen sections without layout shifts */
      .offscreen-defer {
        content-visibility: auto;
        contain-intrinsic-size: auto 650px;
      }

      @supports not (content-visibility: auto) {
        .offscreen-defer {
          contain: layout style paint;
        }
      }

      /* Modern Web Standards: Pure Compositor CSS Scroll-Driven Animation (Zero JS scroll overhead) */
      @supports (animation-timeline: scroll()) {
        #reading-progress-bar, #scroll-progress-line {
          width: 100% !important;
          transform-origin: 0 50%;
          animation: m3-reading-scroll-progress auto linear both;
          animation-timeline: scroll(root block);
        }
        @keyframes m3-reading-scroll-progress {
          from { transform: scaleX(0); opacity: 0; }
          to { transform: scaleX(1); opacity: 1; }
        }
      }

      /* ── Popup ⇄ Floating Contact Action & Sticky Nav rule (docs/03_RULES.md §8.4) ──
         Any open popup already has its own enquiry CTA and takes full focus,
         so hide the global floating FAB and sticky quick-navigation pill bar.
         • Native <dialog> via showModal() → matched by dialog:modal automatically
         • Custom overlays → add data-hide-contact-dock to the overlay root
         NOTE: never match [aria-modal] — the nav drawer keeps it permanently. */
      html:has(dialog:modal, [data-hide-contact-dock]) #floating-actions-container,
      html:has(dialog:modal, [data-hide-contact-dock]) nav[data-quick-nav] {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      /* Quick-Navigation Sticky Pill Bar - Guaranteed High-Contrast Active & Inactive States */
      nav[data-quick-nav] a[data-active="true"],
      nav[data-quick-nav] a[data-active="true"]:hover,
      nav[data-quick-nav] a[data-active="true"]:focus,
      nav[data-quick-nav] a[data-active="true"]:active {
        background-color: #0B57D0 !important;
        color: #FFFFFF !important;
        font-weight: 700 !important;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
      }

      nav[data-quick-nav] a:not([data-active="true"]) {
        background-color: #ECEEF1;
        color: #111827;
      }

      nav[data-quick-nav] a:not([data-active="true"]):hover,
      nav[data-quick-nav] a:not([data-active="true"]):focus {
        background-color: #E5E7EB;
        color: #111827;
      }

      /* =========================================================================
         OFFICIAL PRINT / PDF LETTERHEAD RULES
         Guarantees zero webpage components, navbars, docks, floating buttons,
         or multi-page repeats when printing invoices.
         ========================================================================= */
      @media print {
        @page {
          size: A4 portrait;
          margin: 8mm 10mm;
        }

        /* When printing an invoice modal */
        body.modal-invoice-open {
          background: #ffffff !important;
          color: #0f172a !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          min-height: auto !important;
        }

        /* Hide EVERY element in body except the invoice portal */
        body.modal-invoice-open > *:not(#gst-invoice-portal-root):not([data-printable-invoice-portal]) {
          display: none !important;
        }

        /* Hide all common webpage components unconditionally when printing an invoice */
        body.modal-invoice-open header,
        body.modal-invoice-open footer,
        body.modal-invoice-open nav,
        body.modal-invoice-open #contact-dock,
        body.modal-invoice-open #floating-actions-container,
        body.modal-invoice-open [data-hide-contact-dock]:not(#gst-invoice-portal-root),
        body.modal-invoice-open .site-header,
        body.modal-invoice-open .site-footer,
        body.modal-invoice-open .pac-container,
        .no-print {
          display: none !important;
        }

        /* Reset the modal portal container so it flows as a clean A4 sheet */
        #gst-invoice-portal-root {
          position: static !important;
          display: block !important;
          width: 100% !important;
          background: transparent !important;
          backdrop-filter: none !important;
