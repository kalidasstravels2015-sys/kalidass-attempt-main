// Helper to strip nested @context inside @graph items to prevent JSON-LD syntax warnings
const cleanSchemaItem = (item: any) => {
  if (!item || typeof item !== "object") return item;
  const { "@context": _, ...clean } = item;
  return clean;
};

// Base root items
const baseItems: any[] = [
  organizationSchema,
  localBusinessSchema,
  websiteSchema,
  webPageSchema,
  siteNavigationSchema,
];

// Extract incoming custom schemas
const incomingItems: any[] = [];
if (schema) {
  if (Array.isArray(schema)) {
    incomingItems.push(...schema.filter(Boolean).map(cleanSchemaItem));
  } else if (typeof schema === "object") {
    if (Array.isArray((schema as any)["@graph"])) {
      incomingItems.push(...(schema as any)["@graph"].filter(Boolean).map(cleanSchemaItem));
    } else {
      incomingItems.push(cleanSchemaItem(schema));
    }
  }
}

// Assemble unified @graph Knowledge Graph with strict @id deduplication
const graphMap = new Map<string, any>();
const unkeyedItems: any[] = [];

for (const item of baseItems) {
  if (item && item["@id"]) {
    graphMap.set(item["@id"], item);
  } else if (item) {
    unkeyedItems.push(item);
  }
}

for (const incoming of incomingItems) {
  if (!incoming) continue;
  const id = incoming["@id"];
  if (id && graphMap.has(id)) {
    // If incoming node shares an @id (such as a custom #webpage definition), merge properties rather than duplicating
    const existing = graphMap.get(id);
    graphMap.set(id, { ...existing, ...incoming });
  } else if (id) {
    graphMap.set(id, incoming);
  } else {
    unkeyedItems.push(incoming);
  }
}

const unifiedSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": [...graphMap.values(), ...unkeyedItems],
};
