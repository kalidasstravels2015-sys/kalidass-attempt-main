---
import OptimizedImage from "./OptimizedImage.astro";
import siteContent from "../data/siteContent.json";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const hero = siteContent.hero;
const heroImages = hero.images && hero.images.length > 0 ? hero.images : [
  "/images/hero/airavatesvara.webp",
  "/images/hero/coimbatore.webp",
  "/images/hero/madurai.webp",
];
const heroImageAlts: Record<string, string> = {
  "/images/hero/airavatesvara.webp": "Airavatesvara Temple Darasuram - Kalidass Travels Tamil Nadu Pilgrimage Tour",
  "/images/hero/coimbatore.webp": "Adiyogi Shiva statue Coimbatore - Kalidass Travels Outstation Cab",
  "/images/hero/madurai.webp": "Madurai Meenakshi Amman Temple Gopuram - Kalidass Travels Chauffeur Taxi",
};
---

<section
  id="hero"
  class="relative min-h-[78vh] flex items-center justify-center overflow-hidden pt-16 pb-12 bg-slate-950"
>
  <!-- Background Image Carousel with High-Contrast Dark Gradient Scrim -->
  <div class="absolute inset-0 z-0">
    <div
      class="hero-slides absolute inset-0 pointer-events-none"
      aria-hidden="true"
    >
      <div
        class="hero-slide absolute inset-0 w-full h-full first-slide"
        style="animation-delay: 0s;"
      >
        <OptimizedImage
          src={heroImages[0]}
          alt={heroImageAlts[heroImages[0]] || "Kalidass Travels Chennai Cab and Outstation Taxi"}
          class="w-full h-full object-cover object-center scale-105 opacity-80"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          sizes="100vw"
        />
      </div>

      {heroImages.length > 1 && (
        <template id="deferred-hero-slides">
          {heroImages.slice(1).map((image, index) => (
            <div
              class="hero-slide absolute inset-0 w-full h-full"
              style={`animation-delay: ${(index + 1) * 7}s;`}
            >
              <OptimizedImage
                src={image}
                alt={heroImageAlts[image] || "Kalidass Travels Chennai Cab and Outstation Taxi"}
                class="w-full h-full object-cover object-center scale-105 opacity-80"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                sizes="100vw"
              />
            </div>
          ))}
        </template>
      )}
    </div>
    <!-- Deep Gradient Scrim for 100% Crisp Contrast and Legibility -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/40 z-10"
    >
    </div>
  </div>

  <div
    class="relative z-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center"
  >

    <!-- M3 Display Headline -->
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-3 font-heading drop-shadow-sm"
    >
      <span class="block text-white">Reliable Taxi Service</span>
      <span class="block mt-1 text-white/95 font-extrabold tracking-tight">
        Chennai &amp; South India
      </span>
    </h1>

    <!-- Subtitle / Body (M3 Body Large) -->
    <p
      class="text-xs sm:text-sm md:text-base text-slate-300 font-normal max-w-xl mx-auto leading-relaxed mb-6 px-2 font-sans"
    >
      Clean AC cabs, verified local drivers, and honest rates. Airport transfers from ₹650, outstation trips from ₹14/km, and temple tours with all tolls included.
    </p>

    <!-- M3 Signature Action Button (Executive Charcoal with Traffic Green GO Arrow) -->
    <div class="mb-6">
      <a
        href="#booking-panel"
        class="inline-flex items-center gap-2.5 px-8 py-3.5 bg-m3-primary hover:bg-slate-900 text-m3-on-primary text-sm font-bold rounded-m3-full shadow-m3-2 hover:shadow-m3-3 transition-all transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer border border-white/20 group"
      >
        <span class="text-m3-label-l font-bold text-white">Calculate Fare &amp; Rates</span>
        <span class="material-symbols-outlined text-[20px] text-emerald-400 transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>

    <!-- M3 Assist Chips -->
    <div
      class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 max-w-2xl"
    >
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-m3-full bg-m3-inverse-surface/85 backdrop-blur-md border border-white/10 text-m3-inverse-on-surface text-m3-label-m shadow-m3-1 hover:bg-m3-inverse-surface transition-colors">
        <span class="material-symbols-outlined text-[18px] text-emerald-400 shrink-0">verified_user</span>
        <span>Police Verified Drivers</span>
      </div>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-m3-full bg-m3-inverse-surface/85 backdrop-blur-md border border-white/10 text-m3-inverse-on-surface text-m3-label-m shadow-m3-1 hover:bg-m3-inverse-surface transition-colors">
        <span class="material-symbols-outlined text-[18px] text-white/80 shrink-0">currency_rupee</span>
        <span>Zero Surge Pricing</span>
      </div>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-m3-full bg-m3-inverse-surface/85 backdrop-blur-md border border-white/10 text-m3-inverse-on-surface text-m3-label-m shadow-m3-1 hover:bg-m3-inverse-surface transition-colors">
        <WhatsAppIcon variant="brand" className="w-4 h-4 shrink-0" />
        <span>24/7 WhatsApp Support</span>
      </div>
    </div>
  </div>

  <!-- Minimalist Scroll Down Indicator -->
  <a
    href="#booking-panel"
    class="absolute bottom-3 left-1/2 -translate-x-1/2 text-white/70 hover:text-white transition-colors p-2 flex items-center justify-center"
    aria-label="Scroll to booking form"
  >
    <span class="material-symbols-outlined text-[26px] animate-bounce text-white/80">keyboard_arrow_down</span>
  </a>
</section>

<style is:inline>
  .hero-slides {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: heroFade 21s ease-in-out infinite;
    animation-fill-mode: both;
  }

  .first-slide {
    opacity: 1;
  }

  @keyframes heroFade {
    0% { opacity: 0; transform: scale(1.04); }
    8% { opacity: 1; transform: scale(1.02); }
    30% { opacity: 1; transform: scale(1); }
    38% { opacity: 0; transform: scale(1.04); }
    100% { opacity: 0; transform: scale(1.04); }
  }
</style>

<script is:inline>
  // Defer secondary hero carousel slides until after initial load and idle
  (function() {
    const mountDeferredSlides = function() {
      const template = document.getElementById('deferred-hero-slides');
      const container = document.querySelector('.hero-slides');
      if (template && container) {
        container.appendChild(template.content);
      }
    };
    if (document.readyState === 'complete') {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(mountDeferredSlides, { timeout: 2500 });
      } else {
        setTimeout(mountDeferredSlides, 1200);
      }
    } else {
      window.addEventListener('load', function() {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(mountDeferredSlides, { timeout: 3000 });
        } else {
          setTimeout(mountDeferredSlides, 1500);
        }
      }, { once: true });
    }
  })();
</script>

