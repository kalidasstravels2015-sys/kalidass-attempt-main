    // Advanced Rich Card & Clean Markdown Synthesizer
    function formatMarkdown(text) {
      if (!text) return '';

      // 1. Clean accidental LaTeX math blocks ($$ or \[ \]) into a sleek formula card
      let clean = text
        .replace(/\$\$([\s\S]*?)\$\$/g, (_, math) => {
          const formula = math.replace(/\\text\{([^}]+)\}/g, '$1').replace(/\\times/g, '×').replace(/\\pm/g, '±').trim();
          return `\n:::FORMULA:::${formula}:::ENDFORMULA:::\n`;
        })
        .replace(/\\\[([\s\S]*?)\\\]/g, (_, math) => {
          const formula = math.replace(/\\text\{([^}]+)\}/g, '$1').replace(/\\times/g, '×').replace(/\\pm/g, '±').trim();
          return `\n:::FORMULA:::${formula}:::ENDFORMULA:::\n`;
        })
        .replace(/\\text\{([^}]+)\}/g, '$1');

      // 2. Convert accidental markdown table rows
      clean = clean.replace(/(?:^|\n)\|([^\n]+)\|/g, (match, row) => {
        if (/^[\s\-:|]+$/.test(row)) return '';
        const cells = row.split('|').map(c => c.trim()).filter(Boolean);
        if (cells.length === 0) return '';
        if (/^(?:vehicle|capacity|rate|model|fare)/i.test(cells[0])) {
          return '\n• **' + cells.join(' | ') + '**';
        }
        return '\n• ' + cells.join(' — ');
      });

      const lines = clean.split('\n');
      const processedLines = [];

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];

        if (line.includes(':::FORMULA:::')) {
          const fMatch = line.match(/:::FORMULA:::([\s\S]*?):::ENDFORMULA:::/);
          if (fMatch) {
            processedLines.push(createFormulaCard(fMatch[1]));
            continue;
          }
        }

        // Match vehicle lines: e.g. "   - Sedan (4 seats - Dzire / Etios): ₹14/km + ₹400 driver bata/day"
        // or "- Sedan: ₹14/km" or "• Swift Dzire: ₹6,000"
        const vehMatch = line.match(/^\s*[•*-]\s*(?:\*\*)?([^:(]+?)(?:\(([^)]+)\))?(?:\*\*)?\s*:\s*(.+)$/i);
        if (vehMatch) {
          const name = vehMatch[1].replace(/\*\*/g, '').trim();
          const capacity = vehMatch[2] ? vehMatch[2].replace(/\*\*/g, '').trim() : '';
          const rateDetails = vehMatch[3].replace(/\*\*/g, '').trim();
          const isVehicle = /\b(?:sedan|dzire|etios|ertiga|xl6|innova|crysta|tempo|traveller|urbania|car|cars|van|vans|minibus|bus|coach|hatchback|suv|force)\b/i.test(name);
          const hasRate = /(?:₹|\/km|per km)/i.test(rateDetails);

          if (isVehicle && hasRate) {
            const encodedVehQuery = encodeURIComponent(`Hi Kalidass Travels, I would like to book the ${name} (${rateDetails}) as quoted on your website.`);
            const waHref = `https://wa.me/918939539211?text=${encodedVehQuery}`;
            processedLines.push(createVehicleCard(name, capacity, rateDetails, waHref));
            continue;
          }
        }

        processedLines.push(line);
      }

      // Convert standard markdown tokens without breaking HTML card attributes
      let parsed = processedLines.map(l => {
        if (l.startsWith('<div class="my-2 p-3') || l.startsWith('<div class="my-2.5 p-3')) {
          return l;
        }
        let p = l.replace(/(?:^|\n)###\s*(.+)/g, '<div class="font-bold text-sm text-slate-900 dark:text-white mt-2.5 mb-1">$1</div>');
        p = p.replace(/(?:^|\n)##\s*(.+)/g, '<div class="font-bold text-base text-slate-900 dark:text-white mt-3 mb-1.5">$1</div>');
        p = p.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>');
        p = p.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em class="text-xs text-slate-500 dark:text-slate-400">$1</em>');
        p = p.replace(/\[(.*?)\]\(((?:\/|https?:\/\/)[^\s\)]+)\)/g, function(match, label, href) {
          const isWa = href.includes('wa.me') || href.includes('whatsapp.com');
          if (isWa) {
            return `<a href="${href}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-semibold shadow-xs transition-all active:scale-95 no-underline my-1.5">${label}</a>`;
          }
          return `<a href="${href}" class="ai-action-link inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white text-xs font-bold shadow-md transition-all no-underline my-1.5 cursor-pointer border border-blue-500/40"><span>⚡ ${label}</span> <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>`;
        });
        p = p.replace(/^\s*[•*-]\s*(.+)/g, '<div class="flex items-start gap-2 my-1"><span class="text-blue-600 dark:text-blue-400 font-bold shrink-0 mt-0.5">•</span><span class="flex-1">$1</span></div>');
        return p;
      }).join('<div class="my-1"></div>');

      return parsed;
    }

