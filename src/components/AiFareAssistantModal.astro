    function removeTypingIndicator() {
      const typingDiv = document.getElementById('ai-typing-indicator');
      typingDiv?.remove();
    }

    function getLocalTariffReply(historyOrText, passedContext) {
      const messages = Array.isArray(historyOrText)
        ? historyOrText
        : [{ role: 'user', content: String(historyOrText || '') }];

      const userMessages = messages.filter((m) => m.role === 'user');
      const lastMsg = userMessages[userMessages.length - 1]?.content || '';
      const lastLower = lastMsg.toLowerCase();

      if (!passedContext && typeof window !== 'undefined') {
        passedContext = window.__KT_CURRENT_CALCULATION || null;
      }

      // State tracking across all turns
      let activeDest = null;
      let days = 1;
      let hours = 8;
      let vehicles = [];
      let isTamil = false;

      // Inherit destination and vehicle from on-screen context if available
      if (passedContext) {
        const destStr = ((passedContext.destination || '') + ' ' + (passedContext.serviceSlug || '')).toLowerCase();
        if (destStr.includes('tirupati') || destStr.includes('tirumala') || destStr.includes('balaji')) activeDest = 'tirupati';
        else if (destStr.includes('pondy') || destStr.includes('pondicherry')) activeDest = 'pondicherry';
        else if (destStr.includes('chidambaram')) activeDest = 'chidambaram';
        else if (destStr.includes('thiruvannamalai') || destStr.includes('tiruvannamalai')) activeDest = 'thiruvannamalai';
        else if (destStr.includes('kanchipuram')) activeDest = 'kanchipuram';
        else if (destStr.includes('navagraha')) activeDest = 'navagraha';
        else if (destStr.includes('rameswaram')) activeDest = 'rameswaram';
        else if (destStr.includes('sabarimala')) activeDest = 'sabarimala';
        else if (destStr.includes('vellore')) activeDest = 'vellore';
        else if (destStr.includes('local')) activeDest = 'local';
        else if (destStr.includes('airport')) activeDest = 'airport';

        if (passedContext.vehicleName) {
          const vLow = passedContext.vehicleName.toLowerCase();
          if (vLow.includes('dzire') || vLow.includes('etios') || vLow.includes('sedan')) vehicles.push('sedan');
          else if (vLow.includes('ertiga') || vLow.includes('xl6')) vehicles.push('ertiga');
          else if (vLow.includes('crysta')) vehicles.push('crysta');
          else if (vLow.includes('innova')) vehicles.push('innova');
          else if (vLow.includes('tempo')) vehicles.push('tempo');
        }
      }

      for (const m of userMessages) {
        const text = m.content || '';
        const lower = text.toLowerCase();

        if (/[\u0B80-\u0BFF]/.test(text) || lower.includes('evlo') || lower.includes('sollunga')) {
          isTamil = true;
        }

        // Days
        const dMatch = lower.match(/(\d+)\s*(?:days?|day|நாட்கள்|நாட்களுக்கு|நாளுக்கு|நாள்)/i);
        if (dMatch) {
          days = parseInt(dMatch[1], 10);
        } else if (lower.includes('2-day') || lower.includes('2 day') || lower.includes('two day') || lower.includes('2 நாள்') || lower.includes('2 நாட்கள்')) {
          days = 2;
        } else if (lower.includes('3-day') || lower.includes('3 day') || lower.includes('three day') || lower.includes('3 நாள்') || lower.includes('3 நாட்கள்')) {
          days = 3;
        } else if (lower.includes('1-day') || lower.includes('1 day') || lower.includes('same day')) {
          days = 1;
        }

        // Hours
        const hMatch = lower.match(/(\d+)\s*(?:hrs?|hours?|மணி)/);
        if (hMatch) {
          hours = parseInt(hMatch[1], 10);
        }

        // Turn vehicles
        const turnVehicles = [];
        if (lower.includes('sedan') || lower.includes('dzire') || lower.includes('etios') || lower.includes('செடான்')) turnVehicles.push('sedan');
        if (lower.includes('ertiga') || lower.includes('xl6') || lower.includes('எர்டிகா')) turnVehicles.push('ertiga');
        if (lower.includes('crysta') || lower.includes('கிரிஸ்டா')) turnVehicles.push('crysta');
        else if (lower.includes('innova') || lower.includes('இன்னோவா')) turnVehicles.push('innova');
        if (lower.includes('tempo') || lower.includes('traveller') || lower.includes('டெம்போ')) turnVehicles.push('tempo');
        if (turnVehicles.length > 0) vehicles = turnVehicles;

        // Destination
        if (lower.includes('tirupati') || lower.includes('tirumala') || lower.includes('balaji') || lower.includes('திருப்பதி')) activeDest = 'tirupati';
        else if (lower.includes('chidambaram') || lower.includes('pichavaram') || lower.includes('சிதம்பரம்')) activeDest = 'chidambaram';
        else if (lower.includes('thiruvannamalai') || lower.includes('tiruvannamalai') || lower.includes('girivalam') || lower.includes('திருவண்ணாமலை')) activeDest = 'thiruvannamalai';
        else if (lower.includes('kanchipuram') || lower.includes('kanchi') || lower.includes('காஞ்சிபுரம்')) activeDest = 'kanchipuram';
        else if (lower.includes('navagraha') || lower.includes('kumbakonam') || lower.includes('நவக்கிரக')) activeDest = 'navagraha';
        else if (lower.includes('rameswaram') || lower.includes('rameshwaram') || lower.includes('dhanushkodi') || lower.includes('ராமேஸ்வரம்')) activeDest = 'rameswaram';
        else if (lower.includes('sabarimala') || lower.includes('pamba') || lower.includes('சபரிமலை')) activeDest = 'sabarimala';
        else if (lower.includes('vellore') || lower.includes('golden temple') || lower.includes('வேலூர்')) activeDest = 'vellore';
        else if (lower.includes('pondy') || lower.includes('pondicherry') || lower.includes('பாண்டிச்சேரி')) activeDest = 'pondicherry';
        else if (lower.includes('airport') || lower.includes('flight') || lower.includes('ஏர்போர்ட்')) activeDest = 'airport';
        else if (lower.includes('acting driver') || lower.includes('ஆக்டிங் டிரைவர்')) activeDest = 'acting_driver';
        else if (lower.includes('local') || lower.includes('hourly') || lower.includes('லோக்கல்')) activeDest = 'local';
        else if (lower.includes('bangalore') || lower.includes('bengaluru')) activeDest = 'bangalore';
        else if (lower.includes('madurai')) activeDest = 'madurai';
        else if (lower.includes('coimbatore')) activeDest = 'coimbatore';
        else if (lower.includes('salem')) activeDest = 'salem';
        else if (lower.includes('ooty')) activeDest = 'ooty';
        else if (lower.includes('kodaikanal')) activeDest = 'kodaikanal';
      }

      // Check policy questions in latest message
      if (lastLower.includes('advance') || lastLower.includes('deposit') || lastLower.includes('முன்பணம்')) {
        const destName = activeDest ? activeDest.toUpperCase() : 'your trip';
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent('Hi Kalidass Travels, I want to pay ₹500 advance to lock cab for ' + destName)}`;
        if (isTamil) {
          return `🛡️ **Kalidass Travels முன்பணம் பாலிசி (Advance Policy):**\n\n` +
            `• **₹500 முன்பணம் மட்டுமே:** காரை உறுதிசெய்து லாக் செய்ய ₹500 மட்டுமே பெறப்படுகிறது.\n` +
            `• **மீதமுள்ள தொகை பயணத்திற்குப் பின்:** 100% பாக்கித் தொகையை பயணம் முடிந்தவுடன் டிரைவரிடம் செலுத்தலாம்.\n` +
            `• **முழு ரீஃபண்ட்:** 6 மணிநேரம் முன்பு ரத்து செய்தால் ₹500 திரும்பப் பெறலாம்.\n\n` +
            `[👉 ₹500 செலுத்தி காரை லாக் செய்ய](${waUrl})`;
        }
        return `🛡️ **Kalidass Travels Advance Payment Policy:**\n\n` +
          `• **Nominal ₹500 Advance:** For outstation trips and tour packages (${destName}), we collect only **₹500 advance** to guarantee cab allocation & schedule driver.\n` +
          `• **Balance Paid Post-Trip:** Pay the remaining balance directly to your chauffeur after trip completion.\n` +
          `• **100% Refund Guarantee:** Fully refundable if canceled up to 6 hours before departure.\n\n` +
          `[👉 Pay ₹500 Advance & Lock Cab on WhatsApp](${waUrl})`;
      }

      if (lastLower.includes('cancel') || lastLower.includes('refund') || lastLower.includes('ரத்து')) {
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent('Hi Kalidass Travels, I have a query about cancellation policy.')}`;
        return `🛡️ **Cancellation & Refund Policy:**\n\n` +
          `• **Outstation & Tour Packages:** 100% full refund of ₹500 advance if canceled up to **6 hours** prior to journey departure.\n` +
          `• **Local City & Acting Drivers:** Free cancellation up to 2 hours before scheduled pickup time.\n\n` +
          `[👉 Contact Support on WhatsApp](${waUrl})`;
      }

      // Check active on-screen calculation context (Pro-Rata / Current quote)
      if (passedContext && passedContext.totalFare) {
        const asksFor2Days = lastLower.includes('2 day') || lastLower.includes('two day') || lastLower.includes('2-day') || lastLower.includes('2 நாள்') || lastLower.includes('2 நாட்கள்');
        const asksPrice = lastLower.includes('price') || lastLower.includes('cost') || lastLower.includes('fare') || lastLower.includes('rate') || lastLower.includes('how much') || lastLower.includes('quote') || lastLower.includes('evlo') || lastLower.includes('kattanam') || lastLower.includes('tariff');
        const asksExplain = lastLower.includes('explain') || lastLower.includes('why') || lastLower.includes('breakup') || lastLower.includes('breakdown') || lastLower.includes('details') || lastLower.includes('screen') || lastLower.includes('quote');

        if (asksFor2Days || asksPrice || asksExplain || lastLower.includes('this trip') || lastLower.includes('my trip') || lastLower.includes('selected')) {
          const destName = passedContext.destination || (passedContext.serviceTitle ? passedContext.serviceTitle.replace(/Chennai to /i, '') : 'your trip');
          const vehName = passedContext.vehicleName || 'Swift Dzire / Etios';
          const fareFormatted = passedContext.formattedFare || `₹${passedContext.totalFare?.toLocaleString('en-IN')}`;
          const durLabel = passedContext.durationLabel || `${passedContext.durationHours || 24} hrs`;
          const subText = passedContext.durationSubText || (passedContext.isProRata ? '1 Night Stay' : '');

          if (passedContext.isProRata) {
            const hrs = passedContext.durationHours || 36;
            const extraHrs = passedContext.extraHours || (hrs - 24);
            const savings = passedContext.savings ? `₹${passedContext.savings.toLocaleString('en-IN')}` : '₹1,750';
            const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent(`Hi Kalidass Travels, I have configured a ${durLabel} trip to ${destName} (${fareFormatted} for ${vehName}). Please confirm availability.`)}`;

            if (isTamil) {
              return `உங்கள் திரையில் தேர்ந்தெடுக்கப்பட்ட பயண அட்டவணை: **${durLabel} (${hrs} மணிநேரம் / ${subText || '1 இரவு தங்குதல்'})**:\n\n` +
                `• **திரையில் உள்ள புரோ-ரேட்டா கட்டணம்:** **${fareFormatted}** (${vehName})\n` +
                `  உங்கள் பயணம் முழு 48 மணிநேரம் இல்லாமல் **${hrs} மணிநேரம்** மட்டுமே என்பதால், காளிதாஸ் டிராவல்ஸ் நியாயமான புரோ-ரேட்டா முறையில் கணக்கிட்டு முழு 2-நாள் கட்டணத்தை விட **${savings} மிச்சப்படுத்துகிறது**!\n\n` +
                `• **முழு 48-மணிநேர 2-நாள் பேக்கேஜ்:**\n` +
                `  நீங்கள் காரை முழு 48 மணிநேரமும் பயன்படுத்த விரும்பினால்:\n` +
                `  - **Swift Dzire / Etios (4 Pax):** ₹9,500\n` +
                `  - **Maruti Ertiga / XL6 (6 Pax):** ₹11,500\n` +
                `  - **Toyota Innova (7 Pax):** ₹12,500\n` +
                `  - **Innova Crysta:** ₹16,000\n\n` +
                `✅ **உள்ளடக்கம்:** சுத்தமான ஏசி கார், டிரைவர் பேட்டா, ஆந்திரா பெர்மிட் & திருமலை மலைப்பாதை அனுமதி.\n` +
                `🛡️ **பாலிசி:** காரை உறுதிசெய்து லாக் செய்ய **₹500 முன்பணம்** மட்டுமே. மீதமுள்ள தொகை பயண முடிவில்!\n\n` +
                `[👉 வாட்ஸ்அப்பில் முன்பதிவு செய்ய](${waUrl})`;
            }

            return `I see your selected schedule on screen is **${durLabel}** (${hrs} hours${subText ? ` / ${subText}` : ''}) for **${destName}**:\n\n` +
              `• **Your On-Screen Pro-Rata Fare:** **${fareFormatted}** for **${vehName}**\n` +
              `  Because your trip duration is **${hrs} hours** (rather than the full 48 hours), our transparent tariff charges you pro-rata for 1 Day + ${extraHrs} hrs, **saving you ${savings}** compared to the full 2-day package!\n\n` +
              `• **Full 48-Hour 2-Day Package Rates:**\n` +
              `  If you require the cab for the complete 48 hours (e.g. 2 full calendar days or returning late night on Day 2):\n` +
              `  - **Swift Dzire / Etios (4 Pax):** ₹9,500\n` +
              `  - **Maruti Ertiga / XL6 (6 Pax):** ₹11,500\n` +
              `  - **Toyota Innova (7 Pax):** ₹12,500\n` +
              `  - **Toyota Innova Crysta (7 Pax):** ₹16,000\n` +
              `  - **Tempo Traveller (12 Pax):** ₹19,500\n\n` +
              `✅ **Inclusions:** Dedicated AC Cab & Experienced Chauffeur, Fuel, AP State Border Permit, Tirumala Ghat Road ascent, and Driver Bata.\n` +
              `🛡️ **Policy:** Nominal **₹500 advance** to confirm & lock cab (avoids last-minute cancellation). Remaining balance paid post-trip!\n\n` +
              `[👉 Confirm Booking on WhatsApp](${waUrl})`;
          }
        }
      }

      // Tirupati package (1, 2, or 3 days)
      if (activeDest === 'tirupati') {
        const d = Math.min(Math.max(days, 1), 3);
        const rates = {
          1: { sedan: 6000, ertiga: 7500, innova: 8500, crysta: 10000, tempo: 12500 },
          2: { sedan: 9500, ertiga: 11500, innova: 12500, crysta: 16000, tempo: 19500 },
          3: { sedan: 13200, ertiga: 15800, innova: 17500, crysta: 22500, tempo: 27000 }
        }[d];

        const allLines = {
          sedan: `• **Swift Dzire / Etios (4 Pax):** ₹${rates.sedan.toLocaleString('en-IN')}`,
          ertiga: `• **Maruti Ertiga / XL6 (6 Pax):** ₹${rates.ertiga.toLocaleString('en-IN')}`,
          innova: `• **Toyota Innova (7 Pax):** ₹${rates.innova.toLocaleString('en-IN')}`,
          crysta: `• **Toyota Innova Crysta (7 Pax):** ₹${rates.crysta.toLocaleString('en-IN')}`,
          tempo: `• **Tempo Traveller (12 Pax):** ₹${rates.tempo.toLocaleString('en-IN')}`
        };

        let selected = Object.keys(allLines);
        if (vehicles.length > 0) {
          const matched = vehicles.filter((v) => allLines[v]);
          if (matched.length > 0) selected = matched;
        }

        const linesStr = selected.map((k) => allLines[k]).join('\n');
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent(`Hi Kalidass Travels, I want to book Chennai to Tirupati (${d}-Day) package. Please confirm availability.`)}`;

        if (isTamil) {
          return `சென்னை ⇄ **திருப்பதி ${d}-நாள் பேக்கேஜ்** அதிகாரப்பூர்வ கட்டணங்கள்:\n\n` +
            `${linesStr}\n\n` +
            `✅ **உள்ளடக்கம்:** சுத்தமான ஏசி வாகனம், டிரைவர் பேட்டா, திருமலை மலைப்பாதை அனுமதி & சுங்கக் கட்டணம் (1-நாள் பேக்கேஜில் அடங்கும்).\n` +
            `🛡️ **பாலிசி:** ₹500 முன்பணம் செலுத்தி காரை லாக் செய்யலாம். மீதமுள்ள தொகை பயணத்திற்குப் பின்!\n\n` +
            `[👉 வாட்ஸ்அப்பில் உறுதிப்படுத்தவும்](${waUrl})`;
        }

        const incl = d === 1
          ? 'Fuel, FASTag Tolls, AP Border Permit, Tirumala Ghat Road ascent & Driver Bata.'
          : 'Dedicated AC cab & experienced chauffeur for all days. Highway Tolls & Parking as per actual plazas.';

        return `Here are our official **Chennai ⇄ Tirupati ${d}-Day Package** rates:\n\n` +
          `${linesStr}\n\n` +
          `✅ **Inclusions:** ${incl}\n` +
          `🛡️ **Policy:** ₹500 advance to confirm & lock cab (avoids last-minute cancellation). Remaining balance paid post-trip!\n\n` +
          `[👉 Confirm Booking on WhatsApp](${waUrl})`;
      }

      // Pondicherry package
      if (activeDest === 'pondicherry') {
        const d = Math.min(Math.max(days, 1), 2);
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent(`Hi Kalidass Travels, I want to book Chennai to Pondicherry (${d}-Day) package.`)}`;
        if (d === 2) {
          return `Here are our official **Chennai ⇄ Pondicherry 2-Day Package** rates:\n\n` +
            `• **AC Sedan (Dzire / Etios - 4 Pax):** ₹7,500\n` +
            `• **Maruti Ertiga / XL6 (6 Pax):** ₹9,200\n` +
            `• **Toyota Innova (7 Pax):** ₹10,200\n` +
            `• **Toyota Innova Crysta:** ₹12,500\n\n` +
            `✅ **Inclusions:** Dedicated AC cab & experienced chauffeur for 2 days. Tolls & parking at actuals.\n` +
            `🛡️ **Policy:** ₹500 advance to confirm & lock cab. Balance post-trip!\n\n` +
            `[👉 Confirm Booking on WhatsApp](${waUrl})`;
        }
        return `For **Chennai ⇄ Pondicherry (Same Day Return ~320 km)**:\n\n` +
          `• **AC Sedan (4 Pax):** ~₹4,500 - ₹5,000 (At ₹14/km + driver bata ₹400)\n` +
          `• **Maruti Ertiga (6 Pax):** ~₹5,800 - ₹6,200 (At ₹17/km + driver bata ₹500)\n` +
          `• **Toyota Innova (7 Pax):** ~₹7,000 (At ₹20/km + driver bata ₹600)\n\n` +
          `🛡️ **Policy:** ₹500 advance to confirm & lock cab. Balance post-trip!\n\n` +
          `[👉 Confirm Booking on WhatsApp](${waUrl})`;
      }

      // Local Chennai Hourly
      if (activeDest === 'local' || lastLower.includes('local') || lastLower.includes('hourly') || lastLower.includes('8hr') || lastLower.includes('4hr')) {
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent(`Hi Kalidass Travels, I want to book Chennai local rental (${hours} hrs).`)}`;
        return `Here are our official **Chennai City Local Rental Packages**:\n\n` +
          `• **AC Sedan (Dzire / Etios):**\n` +
          `  - 4 hrs / 40 km: ₹1,350 (Extra km: ₹15 | Extra hr: ₹150)\n` +
          `  - 8 hrs / 80 km: ₹2,200 *(Most Popular)*\n` +
          `  - 10 hrs / 100 km: ₹2,600\n\n` +
          `• **Maruti Ertiga / XL6 (6 Pax):**\n` +
          `  - 4 hrs / 40 km: ₹1,700 (Extra km: ₹17 | Extra hr: ₹200)\n` +
          `  - 8 hrs / 80 km: ₹2,800\n\n` +
          `• **Toyota Innova (7 Pax):**\n` +
          `  - 8 hrs / 80 km: ₹3,200 | Innova Crysta: ₹4,500\n\n` +
          `🛡️ **Policy:** ₹0 advance deposit for local city rentals — pay balance after trip!\n\n` +
          `[👉 Book on WhatsApp](${waUrl})`;
      }

      // Airport transfer
      if (activeDest === 'airport' || lastLower.includes('airport')) {
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent('Hi Kalidass Travels, I need Chennai Airport transfer.')}`;
        return `Here are our fixed **Chennai Airport (MAA) Taxi Transfer** rates:\n\n` +
          `• **AC Sedan (Dzire / Etios - 4 Pax):** ₹550 - ₹750 (Depending on locality)\n` +
          `• **Maruti Ertiga / XL6 (6 Pax):** ₹750 - ₹950\n` +
          `• **Toyota Innova (7 Pax):** ₹1,000 - ₹1,300\n\n` +
          `✈️ 24/7 pickup from Domestic & International terminals, real-time flight tracking & zero delay surge!\n\n` +
          `[👉 Book Airport Cab on WhatsApp](${waUrl})`;
      }

      // Acting driver
      if (activeDest === 'acting_driver' || lastLower.includes('acting driver')) {
        const waUrl = `https://wa.me/918939539211?text=${encodeURIComponent('Hi Kalidass Travels, I need an Acting Driver for my personal car.')}`;
        return `Here are our verified **Acting Driver Services** for your personal car:\n\n` +
          `• **Chennai City Duty:** 4 Hours: ₹500 | 8 Hours: ₹800 (Extra hr: ₹100, Night charge 10 PM - 6 AM: ₹150)\n` +
          `• **Outstation Round Trip:** ₹1,100 / day (+ ₹300 bata or food/stay)\n\n` +
          `👮 Police Background Cleared (PVC Cleared) drivers, 5+ years experience.\n\n` +
          `[👉 Book Driver on WhatsApp](${waUrl})`;
      }

      // Default tariff menu
      return `I can instantly quote fares for you:\n\n` +
        `• 🕉️ **Tirupati Balaji:** 1-Day (Sedan ₹6,000 | Ertiga ₹7,500), 2-Day (Sedan ₹9,500 | Ertiga ₹11,500)\n` +
        `• ⏱️ **Local Chennai 8hr:** Sedan ₹2,200 | Ertiga ₹2,800\n` +
        `• 🛣️ **Outstation:** ₹14/km Sedan | ₹17/km Ertiga | ₹20/km Innova (Min 250 km/day)\n` +
        `• 🏖️ **Pondicherry:** Sedan ₹4,500 | Ertiga ₹5,800\n` +
        `• ✈️ **Airport Taxi & 👮 Acting Drivers**\n\n` +
        `Tell me your travel destination or vehicle preference to get started!`;
    }

    function getChatSessionId() {
      try {
        let sid = sessionStorage.getItem('kt_ai_chat_session_id');
        if (!sid) {
          sid = 'KT-SES-' + Math.floor(1000 + Math.random() * 9000);
          sessionStorage.setItem('kt_ai_chat_session_id', sid);
        }
        return sid;
      } catch (_) {
        return 'KT-SES-TEMP';
      }
    }

    async function handleUserSubmit(text) {
      if (!text || isRequestInProgress) return;
      isRequestInProgress = true;
      if (sendBtn) sendBtn.disabled = true;

      appendMessage('user', text);
      chatHistory.push({ role: 'user', content: text });
      if (userInput) userInput.value = '';

      showTypingIndicator();

      const sessionId = getChatSessionId();
      const sourcePage = window.location.pathname || '/';

      const pageContext = window.__KT_CURRENT_CALCULATION || null;

      let reply = '';
      try {
        const response = await fetch('/api/ai-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: chatHistory,
            sessionId,
            sourcePage,
            pageContext
          }),
        });

        if (response.ok) {
          const data = await response.json();
          if (data && data.reply) {
            reply = data.reply;
          }
        }
      } catch (_) {}

      // If backend API is not reachable, use instant client-side tariff engine with full multi-turn chatHistory
      if (!reply) {
        await new Promise((r) => setTimeout(r, 200));
        reply = getLocalTariffReply(chatHistory, pageContext);

        // Async telemetry backup for offline client fallback
        try {
          fetch('https://script.google.com/macros/s/AKfycbwoEpKqa3Qg-DIvMe06pGUgGLlC_0vJQev61nzIh9ssh1-uHZ5VtYkGzpMVwhEyi7tvEQ/exec', {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({
              type: 'ai_chat_query',
              date: new Date().toLocaleString(),
              sessionId,
              sourcePage,
              userQuery: text,
              aiReply: reply,
              engine: 'client_local_fallback'
            })
          }).catch(() => {});
        } catch (_) {}
      }

      removeTypingIndicator();
      appendMessage('assistant', reply);
      chatHistory.push({ role: 'assistant', content: reply });

      isRequestInProgress = false;
      if (sendBtn) sendBtn.disabled = false;
      userInput?.focus();
    }

    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = userInput?.value?.trim();
      if (text) handleUserSubmit(text);
    });

    quickChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const prompt = chip.getAttribute('data-quick-prompt');
        if (prompt) handleUserSubmit(prompt);
      });
    });
  })();
</script>
