---
import AndroidPhoneIcon from './AndroidPhoneIcon.astro';
import GeminiIcon from './GeminiIcon.astro';
import { WHATSAPP_CONFIG } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
}

const {
  phone = `+${WHATSAPP_CONFIG.phone}`,
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
} = Astro.props;

const callUrl = `tel:${phone}`;
---

<!-- Google "Ask Gemini" Full-Height Side Panel Drawer (Desktop) & Bottom Sheet (Mobile) -->
<div
  id="ai-fare-modal"
  class="fixed inset-0 z-[100] hidden flex-col justify-end sm:justify-start items-end bg-black/50 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none pb-[env(safe-area-inset-bottom,0px)] pr-[env(safe-area-inset-right,0px)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ai-modal-title"
  aria-hidden="true"
>
  <!-- Ask Gemini Side Panel Box: Docked flush right edge full height on desktop, smooth slide-up on mobile -->
  <div
    id="ai-modal-box"
    class="relative w-full sm:w-[440px] md:w-[460px] lg:w-[480px] h-[92vh] sm:h-full max-h-[92vh] sm:max-h-screen flex flex-col bg-white dark:bg-[#131314] text-slate-800 dark:text-[#E3E3E3] rounded-t-3xl sm:rounded-none sm:rounded-l-3xl shadow-2xl overflow-hidden border-t sm:border-t-0 sm:border-l border-slate-200/80 dark:border-white/10 transform translate-y-full sm:translate-y-0 sm:translate-x-full transition-transform duration-300 ease-out pointer-events-auto"
  >
    <!-- M3 & Gemini Top App Bar: Minimal, Clean & Distinctive -->
    <header class="flex items-center justify-between px-4 py-3 bg-white/90 dark:bg-[#131314]/90 backdrop-blur-md border-b border-slate-200/80 dark:border-white/10 shrink-0 select-none z-10">
      <!-- Title & Official Google Gemini Sparkle -->
      <div class="flex items-center gap-2 min-w-0">
        <div class="relative w-7 h-7 rounded-full bg-gradient-to-tr from-[#4285F4]/15 via-[#9B72CB]/15 to-[#D96570]/15 border border-slate-200/70 dark:border-white/15 flex items-center justify-center shrink-0 shadow-xs">
          <GeminiIcon class="w-4 h-4" />
        </div>
        <h2 id="ai-modal-title" class="font-bold text-sm sm:text-base text-slate-900 dark:text-white tracking-tight whitespace-nowrap">
          Ask Gemini
        </h2>
      </div>

      <!-- Action items: New Chat + Multi-Helpline Call + Clean Close Icon -->
      <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
        <!-- New Chat Reset Button -->
        <button
          type="button"
          id="ai-new-chat-btn"
          class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-100 dark:hover:bg-white/10 active:scale-95 transition-all cursor-pointer"
          title="Start fresh conversation"
          aria-label="Start fresh conversation"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span class="hidden md:inline">New Chat</span>
        </button>

        <!-- Helpline Call Button with Multi-Number Quick Popover -->
        <div class="relative group">
          <a
            href={callUrl}
            class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-full bg-[#006D3B] hover:bg-[#00532B] active:scale-95 text-xs font-semibold text-white transition-all shadow-xs"
            title={`Call Helpline ${displayPhone}`}
            aria-label={`Call Helpline ${displayPhone}`}
          >
            <AndroidPhoneIcon className="w-3 h-3 shrink-0 text-white" />
            <span class="hidden sm:inline tracking-tight text-[11px] sm:text-xs">{displayPhone}</span>
            <span class="sm:hidden text-[11px] font-bold">Call</span>
            <svg class="w-2.5 h-2.5 text-white/80 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Popover with all 3 helplines -->
          <div class="absolute right-0 top-full pt-1.5 w-56 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white dark:bg-[#1E1F20] text-slate-800 dark:text-white rounded-2xl shadow-xl border border-slate-200 dark:border-white/15 p-1.5 space-y-1">
              <div class="px-2.5 py-1 text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                24/7 Helplines
              </div>
              <a
                href="tel:+918939539211"
                class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
              >
                <span>+91 89395 39211</span>
                <span class="text-[9px] text-[#006D3B] dark:text-emerald-400 font-bold">Primary</span>
              </a>
              <a
                href="tel:+916381939769"
                class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
              >
                <span>+91 63819 39769</span>
                <span class="text-[9px] text-blue-600 dark:text-blue-400 font-bold">Line 2</span>
              </a>
              <a
                href="tel:+919092303060"
                class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
              >
                <span>+91 90923 03060</span>
                <span class="text-[9px] text-amber-600 dark:text-amber-400 font-bold">Line 3</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Clean Close Icon -->
        <button
          type="button"
          id="close-ai-modal-btn"
          class="w-8 h-8 rounded-full flex items-center justify-center text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 active:scale-90 transition-all focus:outline-none cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Content Area: Seamlessly hosts Welcome Hero OR Active Chat Thread -->
    <main
      id="ai-chat-thread"
      class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4 text-sm scroll-smooth bg-slate-50/50 dark:bg-[#131314]"
    >
      <!-- Initial Welcome Hero (Empty State, Exactly like Google Ask Gemini) -->
      <div id="ai-welcome-hero" class="py-6 sm:py-8 px-2 flex flex-col items-center text-center select-none">
        <!-- Glowing Gemini Animated Sparkle -->
        <div class="relative mb-4 flex items-center justify-center">
          <span class="absolute -inset-3 rounded-full bg-gradient-to-r from-[#4285F4]/30 via-[#9B72CB]/30 to-[#D96570]/30 blur-lg animate-pulse"></span>
          <div class="relative w-14 h-14 rounded-2xl bg-white dark:bg-[#1E1F20] border border-slate-200/90 dark:border-white/15 shadow-xl flex items-center justify-center">
            <GeminiIcon class="w-8 h-8" />
          </div>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-1.5">
          Plan your journey with Gemini
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xs leading-relaxed mb-6">
          Ask about outstation itineraries, temple circuits, or compare car and tempo options with 100% verified rates.
        </p>

        <!-- Vertically Stacked Prompt Starter Cards (Ask Gemini Style) -->
        <div class="w-full max-w-sm space-y-2 text-left" id="ai-welcome-prompts">
          <button
            type="button"
            data-quick-prompt="We are going to multiple places. How do you calculate the outstation car cost for 2 or 3 days?"
            class="welcome-prompt-card w-full p-3 rounded-2xl bg-white dark:bg-[#1E1F20] hover:bg-blue-50/60 dark:hover:bg-[#28292D] border border-slate-200/80 dark:border-white/10 hover:border-blue-400/60 transition-all duration-200 cursor-pointer active:scale-[0.99] flex items-center justify-between gap-3 shadow-xs hover:shadow-md group text-left"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base shrink-0 group-hover:scale-105 transition-transform">
                🗺️
              </span>
              <div class="min-w-0">
                <div class="font-bold text-xs text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  Multiple Places & Outstation Tour
                </div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  Calculate 2 or 3-day car cost with driver
                </div>
              </div>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <button
            type="button"
            data-quick-prompt="How much for Chennai to Kumbakonam 9 temples 3-day package in Ertiga and Innova?"
            class="welcome-prompt-card w-full p-3 rounded-2xl bg-white dark:bg-[#1E1F20] hover:bg-blue-50/60 dark:hover:bg-[#28292D] border border-slate-200/80 dark:border-white/10 hover:border-blue-400/60 transition-all duration-200 cursor-pointer active:scale-[0.99] flex items-center justify-between gap-3 shadow-xs hover:shadow-md group text-left"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-8 h-8 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center text-base shrink-0 group-hover:scale-105 transition-transform">
                🕉️
              </span>
              <div class="min-w-0">
                <div class="font-bold text-xs text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  Kumbakonam Navagraha 9 Temples
                </div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  3-day temple circuit in Ertiga & Innova
                </div>
              </div>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-purple-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <button
            type="button"
            data-quick-prompt="How much for Chennai to Tirupati 1-day or 2-day package in Sedan and Ertiga?"
            class="welcome-prompt-card w-full p-3 rounded-2xl bg-white dark:bg-[#1E1F20] hover:bg-blue-50/60 dark:hover:bg-[#28292D] border border-slate-200/80 dark:border-white/10 hover:border-blue-400/60 transition-all duration-200 cursor-pointer active:scale-[0.99] flex items-center justify-between gap-3 shadow-xs hover:shadow-md group text-left"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base shrink-0 group-hover:scale-105 transition-transform">
                ⛰️
              </span>
              <div class="min-w-0">
                <div class="font-bold text-xs text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                  Tirupati Balaji Darshan Package
                </div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  1-day & 2-day rates, ghat road permit
                </div>
              </div>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <button
            type="button"
            data-quick-prompt="What is the outstation per km rate for Tempo Traveller 12, 14, 20 seater and Force Urbania?"
            class="welcome-prompt-card w-full p-3 rounded-2xl bg-white dark:bg-[#1E1F20] hover:bg-blue-50/60 dark:hover:bg-[#28292D] border border-slate-200/80 dark:border-white/10 hover:border-blue-400/60 transition-all duration-200 cursor-pointer active:scale-[0.99] flex items-center justify-between gap-3 shadow-xs hover:shadow-md group text-left"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base shrink-0 group-hover:scale-105 transition-transform">
                🚐
              </span>
              <div class="min-w-0">
                <div class="font-bold text-xs text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  Tempo Traveller & Force Urbania
                </div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  12, 14, 20 & 26-seater group travel tariffs
                </div>
              </div>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <p class="text-[11px] text-slate-500 dark:text-slate-500 mt-6 max-w-xs leading-normal">
          Instant tariff calculations strictly follow Kalidass Travels rate card. For custom schedules, call
          <a href="tel:+918939539211" class="text-blue-600 dark:text-blue-400 underline font-semibold">+91 89395 39211</a>.
        </p>
      </div>

      <!-- Chat Bubbles will be appended here dynamically -->
    </main>

    <!-- Google Ask Gemini Bottom Bar: Context Pill + Capsule Input + Attribution -->
    <footer class="p-3 sm:p-3.5 bg-white dark:bg-[#131314] border-t border-slate-200/80 dark:border-white/10 shrink-0">
      <!-- Voice Listening Status Bar (Visible only when recording) -->
      <div
        id="ai-voice-status"
        class="hidden mb-2 px-3 py-1.5 rounded-2xl bg-red-500/10 dark:bg-red-500/15 border border-red-500/30 flex items-center justify-between text-xs text-red-600 dark:text-red-400 shadow-xs transition-all"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="relative flex h-2.5 w-2.5 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600"></span>
          </span>
          <span id="ai-voice-status-text" class="truncate font-semibold tracking-tight text-[11px] sm:text-xs">
            Listening... Speak now
          </span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span id="ai-voice-listening-lang" class="px-2 py-0.5 rounded-full bg-red-500/20 text-[10px] font-bold">
            Auto
          </span>
          <button
            type="button"
            id="ai-voice-cancel-btn"
            class="px-2.5 py-0.5 rounded-full bg-red-600 hover:bg-red-700 active:scale-95 text-white text-[10px] font-semibold transition-all cursor-pointer shadow-xs"
          >
            Cancel
          </button>
        </div>
      </div>

      <!-- Quick Toast / Notification Bubble -->
      <div
        id="ai-voice-toast"
        class="hidden mb-2 px-3 py-1.5 rounded-xl bg-slate-800 text-white dark:bg-white dark:text-slate-900 border border-transparent text-[11px] font-medium text-center shadow-md transition-all"
      ></div>

      <!-- Google-Style Context Awareness Pill (Like Ask Gemini's "Sharing Google" chip) -->
      <div id="ai-context-container" class="mb-2 hidden">
        <div
          id="ai-context-pill"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60 text-xs font-semibold shadow-2xs hover:bg-blue-100 dark:hover:bg-blue-900/40 transition-all cursor-pointer active:scale-95"
          title="Click to ask about current page or quote"
        >
          <span id="ai-context-icon" class="text-xs">📍</span>
          <span id="ai-context-text" class="truncate max-w-[280px]">Viewing: Outstation Cabs</span>
          <button
            type="button"
            id="ai-context-dismiss-btn"
            class="w-4 h-4 rounded-full flex items-center justify-center hover:bg-blue-200/80 dark:hover:bg-blue-800/80 text-blue-700 dark:text-blue-300 text-[10px] ml-0.5"
            title="Dismiss context"
            aria-label="Dismiss context"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Main Input Bar Form -->
      <form id="ai-chat-form" class="flex items-center gap-1.5 sm:gap-2">
        <div class="relative flex-1 flex items-center min-w-0 rounded-full bg-slate-100 dark:bg-[#1E1F20] border border-slate-200 dark:border-white/15 focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition-all p-1">
          <input
            type="text"
            id="ai-user-input"
            placeholder="Ask Gemini (e.g. 3 days Kumbakonam)..."
            class="w-full pl-3 pr-16 py-1.5 bg-transparent text-slate-900 dark:text-white placeholder:text-slate-400 text-xs sm:text-sm focus:outline-none"
            autocomplete="off"
            required
          />
          <!-- Language Picker Button placed neatly inside input on the right -->
          <button
            type="button"
            id="ai-lang-picker-btn"
            class="absolute right-1 px-2 py-1 rounded-full bg-white dark:bg-[#2A2B30] hover:bg-slate-50 dark:hover:bg-white/10 text-slate-600 dark:text-slate-300 text-[10px] font-semibold flex items-center gap-1 transition-all border border-slate-200 dark:border-white/10 shadow-2xs cursor-pointer active:scale-95"
            title="Change voice speech language (All languages supported)"
            aria-label="Change voice speech language"
          >
            <span class="text-[11px]">🌐</span>
            <span id="ai-current-lang-code" class="font-bold tracking-tight">Auto</span>
          </button>
        </div>

        <!-- Multilingual Microphone Button -->
        <button
          type="button"
          id="ai-mic-btn"
          class="w-9 h-9 rounded-full bg-slate-100 dark:bg-[#1E1F20] hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-white/10 text-slate-700 dark:text-slate-300 flex items-center justify-center shrink-0 transition-all shadow-xs focus:outline-none cursor-pointer group relative border border-slate-200 dark:border-white/10 active:scale-90"
          title="Voice input in any language (Tamil, English, Hindi, Telugu...)"
          aria-label="Voice input in any language"
        >
          <!-- Mic Normal Icon -->
          <svg id="ai-mic-icon-idle" class="w-4 h-4 text-slate-600 dark:text-slate-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
            <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
          </svg>
          <!-- Mic Recording Pulsing Aura & Red Icon -->
          <span id="ai-mic-pulse" class="hidden absolute inset-0 rounded-full bg-red-500/30 animate-ping pointer-events-none"></span>
          <svg id="ai-mic-icon-active" class="hidden w-4 h-4 text-red-600 animate-pulse" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
            <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
          </svg>
        </button>

        <!-- Send Submit Button -->
        <button
          type="submit"
          id="ai-send-btn"
          class="w-9 h-9 rounded-full bg-blue-600 hover:bg-blue-700 active:scale-95 text-white flex items-center justify-center shrink-0 transition-all shadow-xs focus:outline-none disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
          aria-label="Send message"
        >
          <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- Official Google Gemini AI Attribution -->
      <div class="mt-2 text-center text-[10px] text-slate-500 dark:text-slate-500 font-medium tracking-wide flex items-center justify-center gap-1.5 select-none">
        <GeminiIcon class="w-3.5 h-3.5" id="modal-footer-gemini" />
        <span>Powered by Google Gemini 3.8 Flash</span>
      </div>
    </footer>

    <!-- Multilingual Speech Language Picker Modal -->
    <div
      id="ai-lang-modal"
      class="hidden absolute inset-0 z-40 bg-black/60 backdrop-blur-xs flex flex-col justify-end sm:justify-center items-center p-0 sm:p-4 opacity-0 pointer-events-none transition-all duration-200"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ai-lang-modal-title"
    >
      <div
        id="ai-lang-modal-box"
        class="w-full sm:max-w-md bg-white dark:bg-[#1E1F20] text-slate-800 dark:text-white rounded-t-3xl sm:rounded-2xl shadow-2xl flex flex-col max-h-[82vh] overflow-hidden border border-slate-200 dark:border-white/10 transform translate-y-6 sm:scale-95 transition-all duration-200"
      >
        <!-- Modal Header -->
        <div class="px-4 py-3 bg-slate-50 dark:bg-[#18191B] border-b border-slate-200 dark:border-white/10 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-sm shadow-xs">
              🌐
            </span>
            <div>
              <h3 id="ai-lang-modal-title" class="font-bold text-sm text-slate-900 dark:text-white leading-tight">
                Speech Language
              </h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">Speak in any language</p>
            </div>
          </div>
          <button
            type="button"
            id="ai-lang-close-btn"
            class="w-8 h-8 rounded-full flex items-center justify-center text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 active:scale-90 transition-all cursor-pointer"
            aria-label="Close language selector"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="p-3 bg-white dark:bg-[#1E1F20] border-b border-slate-200 dark:border-white/10 shrink-0">
          <div class="relative flex items-center">
            <svg class="w-4 h-4 absolute left-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="ai-lang-search-input"
              placeholder="Search language (Tamil, Hindi, Telugu, English...)"
              class="w-full pl-9 pr-8 py-2 rounded-xl bg-slate-100 dark:bg-[#28292D] text-xs text-slate-900 dark:text-white placeholder:text-slate-400 border border-transparent focus:border-blue-500 focus:outline-none transition-all"
              autocomplete="off"
            />
            <button
              type="button"
              id="ai-lang-search-clear"
              class="hidden absolute right-2.5 text-xs text-slate-400 hover:text-slate-700 dark:hover:text-white p-1 cursor-pointer"
              aria-label="Clear search"
            >
              ✕
            </button>
          </div>
        </div>

        <!-- Language List (Scrollable) -->
        <div id="ai-lang-list" class="overflow-y-auto p-2 space-y-1 text-xs divide-y divide-slate-100 dark:divide-white/5 flex-1 min-h-[240px]">
          <!-- Injected dynamically -->
        </div>

        <!-- Modal Footer -->
        <div class="px-4 py-2.5 bg-slate-50 dark:bg-[#18191B] border-t border-slate-200 dark:border-white/10 text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-between shrink-0 select-none">
          <span id="ai-lang-active-display">Active: <strong class="text-slate-900 dark:text-white">Auto Detect</strong></span>
          <span class="text-blue-600 dark:text-blue-400 font-medium text-[10px]">Tap to choose</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('ai-fare-modal');
    const modalBox = document.getElementById('ai-modal-box');
    const closeBtn = document.getElementById('close-ai-modal-btn');
    const newChatBtn = document.getElementById('ai-new-chat-btn');
    const chatForm = document.getElementById('ai-chat-form');
    const userInput = document.getElementById('ai-user-input');
    const chatThread = document.getElementById('ai-chat-thread');
    const welcomeHero = document.getElementById('ai-welcome-hero');
    const sendBtn = document.getElementById('ai-send-btn');
    const welcomePromptCards = document.querySelectorAll('.welcome-prompt-card');

    // Context Awareness Elements
    const contextContainer = document.getElementById('ai-context-container');
    const contextPill = document.getElementById('ai-context-pill');
    const contextText = document.getElementById('ai-context-text');
    const contextIcon = document.getElementById('ai-context-icon');
    const contextDismissBtn = document.getElementById('ai-context-dismiss-btn');
    let currentContextPrompt = '';

    // Multilingual Voice Input Elements
    const micBtn = document.getElementById('ai-mic-btn');
    const micIconIdle = document.getElementById('ai-mic-icon-idle');
    const micIconActive = document.getElementById('ai-mic-icon-active');
    const micPulse = document.getElementById('ai-mic-pulse');
    const voiceStatus = document.getElementById('ai-voice-status');
    const voiceStatusText = document.getElementById('ai-voice-status-text');
    const voiceListeningLang = document.getElementById('ai-voice-listening-lang');
    const voiceCancelBtn = document.getElementById('ai-voice-cancel-btn');
    const voiceToast = document.getElementById('ai-voice-toast');
    const langPickerBtn = document.getElementById('ai-lang-picker-btn');
    const currentLangCodeEl = document.getElementById('ai-current-lang-code');

    // Language Modal Elements
    const langModal = document.getElementById('ai-lang-modal');
    const langModalBox = document.getElementById('ai-lang-modal-box');
    const langCloseBtn = document.getElementById('ai-lang-close-btn');
    const langSearchInput = document.getElementById('ai-lang-search-input');
    const langSearchClear = document.getElementById('ai-lang-search-clear');
    const langList = document.getElementById('ai-lang-list');
    const langActiveDisplay = document.getElementById('ai-lang-active-display');

    // Full Comprehensive Multilingual Voice Database
    const VOICE_LANGUAGES = [
      { code: 'auto', name: 'Auto Detect (Device / Browser Language)', native: 'Auto Detect', flag: '🌐', group: 'Detected' },
      { code: 'ta-IN', name: 'Tamil (India)', native: 'தமிழ்', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'en-IN', name: 'English (India)', native: 'English (IN)', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'hi-IN', name: 'Hindi (India)', native: 'हिन्दी', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'te-IN', name: 'Telugu (India)', native: 'తెలుగు', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'ml-IN', name: 'Malayalam (India)', native: 'മലയാളം', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'kn-IN', name: 'Kannada (India)', native: 'ಕನ್ನಡ', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'bn-IN', name: 'Bengali (India)', native: 'বাংলা', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'mr-IN', name: 'Marathi (India)', native: 'मராठी', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'gu-IN', name: 'Gujarati (India)', native: 'ગુજરાતી', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'pa-IN', name: 'Punjabi (India)', native: 'ਪੰਜਾਬੀ', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'ur-IN', name: 'Urdu (India)', native: 'اردو', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'ta-LK', name: 'Tamil (Sri Lanka)', native: 'தமிழ் (இலங்கை)', flag: '🇱🇰', group: 'Global' },
      { code: 'ta-SG', name: 'Tamil (Singapore)', native: 'தமிழ் (சிங்கப்பூர்)', flag: '🇸🇬', group: 'Global' },
      { code: 'ta-MY', name: 'Tamil (Malaysia)', native: 'தமிழ் (மலேசியா)', flag: '🇲🇾', group: 'Global' },
      { code: 'en-US', name: 'English (United States)', native: 'English (US)', flag: '🇺🇸', group: 'Global' },
      { code: 'en-GB', name: 'English (United Kingdom)', native: 'English (UK)', flag: '🇬🇧', group: 'Global' },
      { code: 'en-AU', name: 'English (Australia)', native: 'English (AU)', flag: '🇦🇺', group: 'Global' },
      { code: 'en-SG', name: 'English (Singapore)', native: 'English (SG)', flag: '🇸🇬', group: 'Global' },
      { code: 'en-MY', name: 'English (Malaysia)', native: 'English (MY)', flag: '🇲🇾', group: 'Global' },
      { code: 'en-AE', name: 'English (UAE / Gulf)', native: 'English (UAE)', flag: '🇦🇪', group: 'Global' },
      { code: 'ar-SA', name: 'Arabic (Saudi Arabia)', native: 'العربية (السعودية)', flag: '🇸🇦', group: 'Global' },
      { code: 'es-ES', name: 'Spanish (Spain)', native: 'Español', flag: '🇪🇸', group: 'Global' },
      { code: 'fr-FR', name: 'French (France)', native: 'Français', flag: '🇫🇷', group: 'Global' },
      { code: 'de-DE', name: 'German (Germany)', native: 'Deutsch', flag: '🇩🇪', group: 'Global' },
      { code: 'zh-CN', name: 'Chinese (Mandarin)', native: '中文 (普通话)', flag: '🇨🇳', group: 'Global' },
      { code: 'ja-JP', name: 'Japanese', native: '日本語', flag: '🇯🇵', group: 'Global' },
      { code: 'ko-KR', name: 'Korean', native: '한국어', flag: '🇰🇷', group: 'Global' },
      { code: 'ru-RU', name: 'Russian', native: 'Русский', flag: '🇷🇺', group: 'Global' },
      { code: 'pt-BR', name: 'Portuguese (Brazil)', native: 'Português', flag: '🇧🇷', group: 'Global' },
      { code: 'it-IT', name: 'Italian', native: 'Italiano', flag: '🇮🇹', group: 'Global' },
      { code: 'id-ID', name: 'Indonesian', native: 'Bahasa Indonesia', flag: '🇮🇩', group: 'Global' },
      { code: 'ms-MY', name: 'Malay (Malaysia)', native: 'Bahasa Melayu', flag: '🇲🇾', group: 'Global' },
      { code: 'th-TH', name: 'Thai', native: 'ไทย', flag: '🇹🇭', group: 'Global' },
      { code: 'tr-TR', name: 'Turkish', native: 'Türkçe', flag: '🇹🇷', group: 'Global' },
      { code: 'vi-VN', name: 'Vietnamese', native: 'Tiếng Việt', flag: '🇻🇳', group: 'Global' }
    ];

    let chatHistory = [];
    let isRequestInProgress = false;

    // Load active voice language
    let selectedVoiceLang = 'auto';
    try {
      const saved = localStorage.getItem('kalidass_voice_lang');
      if (saved && (saved === 'auto' || VOICE_LANGUAGES.some(l => l.code === saved))) {
        selectedVoiceLang = saved;
      }
    } catch (_) {}

    function getLangShortLabel(code) {
      if (!code || code === 'auto') return 'Auto';
      if (code === 'ta-IN') return 'தமிழ்';
      if (code === 'hi-IN') return 'हिन्दी';
      if (code === 'te-IN') return 'తెలుగు';
      if (code === 'ml-IN') return 'മലയാളം';
      if (code === 'kn-IN') return 'ಕನ್ನಡ';
      const found = VOICE_LANGUAGES.find(l => l.code === code);
      if (found) {
        if (code.startsWith('en-')) return found.native.replace('English', 'EN');
        return found.native;
      }
      return code.split('-')[0].toUpperCase();
    }

    function getLangFullName(code) {
      if (!code || code === 'auto') return 'Auto Detect (Device / Browser)';
      const found = VOICE_LANGUAGES.find(l => l.code === code);
      return found ? `${found.native} — ${found.name}` : code;
    }

    function updateLangBadgeUI() {
      if (currentLangCodeEl) {
        currentLangCodeEl.textContent = getLangShortLabel(selectedVoiceLang);
      }
      if (langActiveDisplay) {
        langActiveDisplay.innerHTML = `Active: <strong class="text-slate-900 dark:text-white">${escapeHtml(getLangFullName(selectedVoiceLang))}</strong>`;
      }
    }
    updateLangBadgeUI();

    let toastTimer = null;
    function showVoiceToast(msg, duration = 3500) {
      if (!voiceToast) return;
      clearTimeout(toastTimer);
      voiceToast.textContent = msg;
      voiceToast.classList.remove('hidden');
      toastTimer = setTimeout(() => {
        voiceToast.classList.add('hidden');
      }, duration);
    }

    function isMobileDevice() {
      if (typeof window === 'undefined') return false;
      return (
        window.innerWidth < 768 ||
        'ontouchstart' in window ||
        (navigator.maxTouchPoints && navigator.maxTouchPoints > 0)
      );
    }

    // Update Context Awareness Pill
    function updateContextPill() {
      if (!contextContainer || !contextText || !contextIcon) return;

      const currentCalc = window.__KT_CURRENT_CALCULATION;
      if (currentCalc && currentCalc.formattedFare) {
        const destTitle = currentCalc.destination || 'My Trip';
        contextIcon.textContent = '✨';
        contextText.textContent = `On-Screen: ${currentCalc.vehicleName || 'Cab'} (${currentCalc.formattedFare})`;
        currentContextPrompt = `Can you explain the ${currentCalc.formattedFare} quote on my screen for ${destTitle}?`;
        contextContainer.classList.remove('hidden');
        return;
      }

      // Detect current page context
      const path = (window.location.pathname || '').toLowerCase();
      let pageTitle = '';
      let promptSuggestion = '';

      if (path.includes('tempo-traveller')) {
        pageTitle = 'Tempo Traveller Rental';
        promptSuggestion = 'What are the Tempo Traveller seating options and per-km rates?';
      } else if (path.includes('tirupati')) {
        pageTitle = 'Tirupati Package';
        promptSuggestion = 'What are the Chennai to Tirupati 1-day and 2-day package rates?';
      } else if (path.includes('pondicherry')) {
        pageTitle = 'Pondicherry Tour';
        promptSuggestion = 'What is the fare for Chennai to Pondicherry 2-day trip in Sedan and Ertiga?';
      } else if (path.includes('kumbakonam') || path.includes('navagraha')) {
        pageTitle = 'Navagraha Kumbakonam Temples';
        promptSuggestion = 'How much for Kumbakonam 9 temples 3-day package?';
      } else if (path.includes('thiruvannamalai')) {
        pageTitle = 'Thiruvannamalai Girivalam';
        promptSuggestion = 'What is the package rate for Chennai to Thiruvannamalai Girivalam?';
      } else if (path.includes('airport')) {
        pageTitle = 'Chennai Airport Taxi';
        promptSuggestion = 'What are the Chennai Airport pickup and drop rates?';
      } else if (path.includes('acting-driver')) {
        pageTitle = 'Acting Drivers';
        promptSuggestion = 'What are the acting driver charges for city and outstation?';
      } else if (path.includes('outstation')) {
        pageTitle = 'Outstation Cabs';
        promptSuggestion = 'How do you calculate outstation car cost for multi-destination trips?';
      }

      if (pageTitle) {
        contextIcon.textContent = '📍';
        contextText.textContent = `Viewing: ${pageTitle}`;
        currentContextPrompt = promptSuggestion;
        contextContainer.classList.remove('hidden');
      } else {
        contextContainer.classList.add('hidden');
      }
    }

    contextPill?.addEventListener('click', (e) => {
      if (e.target.closest('#ai-context-dismiss-btn')) return;
      if (currentContextPrompt) {
        handleUserSubmit(currentContextPrompt);
      }
    });

    contextDismissBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      contextContainer?.classList.add('hidden');
    });

    // Reset Chat to Welcome Hero
    function resetChatToWelcome() {
      chatHistory = [];
      const messages = chatThread?.querySelectorAll('.ai-chat-bubble-row');
      messages?.forEach(m => m.remove());
      welcomeHero?.classList.remove('hidden');
      if (userInput) userInput.value = '';
      updateContextPill();
      if (chatThread) chatThread.scrollTop = 0;
    }

    newChatBtn?.addEventListener('click', () => {
      resetChatToWelcome();
      showVoiceToast('✨ Started a new conversation with Gemini');
    });

    // Modal Opening & Closing (Side Panel Slide-In)
    function openAiModal(initialQuery) {
      if (!modal || !modalBox) return;
      modal.setAttribute('data-hide-contact-dock', 'true');
      modal.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      updateContextPill();

      setTimeout(() => {
        modalBox.classList.remove('translate-y-full', 'sm:translate-x-full');
        if (!isMobileDevice()) {
          userInput?.focus();
        }
      }, 10);

      if (initialQuery && typeof initialQuery === 'string') {
        const queryText = initialQuery === 'multiple places'
          ? 'We are going to multiple places. How do you calculate the outstation car cost for 2 or 3 days?'
          : initialQuery;
        setTimeout(() => {
          handleUserSubmit(queryText);
        }, 200);
      }
    }

    function closeAiModal() {
      if (!modal || !modalBox) return;
      stopListeningUI();
      closeLangModal();

      modalBox.classList.add('translate-y-full', 'sm:translate-x-full');
      modal.classList.add('opacity-0');

      setTimeout(() => {
        modal.removeAttribute('data-hide-contact-dock');
        modal.classList.add('hidden', 'pointer-events-none');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }, 300);
    }

    function toggleAiModal() {
      if (modal && !modal.classList.contains('hidden') && !modal.classList.contains('opacity-0')) {
        closeAiModal();
      } else {
        openAiModal();
      }
    }

    window.openAiFareModal = openAiModal;
    window.closeAiFareModal = closeAiModal;
    window.toggleAiFareModal = toggleAiModal;

    closeBtn?.addEventListener('click', closeAiModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeAiModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (langModal && !langModal.classList.contains('hidden')) {
          closeLangModal();
          e.stopPropagation();
          return;
        }
        if (!modal?.classList.contains('hidden')) {
          closeAiModal();
        }
      }
    });

    // Welcome Prompt Card Click Handlers
    welcomePromptCards.forEach(card => {
      card.addEventListener('click', () => {
        const prompt = card.getAttribute('data-quick-prompt');
        if (prompt) {
          handleUserSubmit(prompt);
        }
      });
    });

    // Language Picker Modal Logic
    function renderLangList(query = '') {
      if (!langList) return;
      langList.innerHTML = '';
      const q = query.trim().toLowerCase();

      const filtered = VOICE_LANGUAGES.filter(lang => {
        if (!q) return true;
        return lang.name.toLowerCase().includes(q) ||
               lang.native.toLowerCase().includes(q) ||
               lang.code.toLowerCase().includes(q) ||
               lang.group.toLowerCase().includes(q);
      });

      if (filtered.length === 0) {
        langList.innerHTML = `
          <div class="py-8 text-center text-slate-400 text-xs">
            No language found matching "${escapeHtml(query)}"
          </div>
        `;
        return;
      }

      filtered.forEach(lang => {
        const isSelected = selectedVoiceLang === lang.code;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-full px-3 py-2.5 rounded-xl flex items-center justify-between transition-all cursor-pointer text-left ${
          isSelected
            ? 'bg-blue-500/15 text-blue-600 dark:text-blue-400 font-bold shadow-2xs'
            : 'hover:bg-slate-100 dark:hover:bg-white/5 text-slate-800 dark:text-slate-200'
        }`;
        btn.innerHTML = `
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="text-base shrink-0 select-none">${lang.flag}</span>
            <div class="min-w-0">
              <div class="font-semibold text-xs text-slate-900 dark:text-white flex items-center gap-1.5">
                <span>${escapeHtml(lang.native)}</span>
                ${lang.code !== 'auto' ? `<span class="text-[10px] text-slate-400 font-mono font-normal">(${lang.code})</span>` : ''}
              </div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">${escapeHtml(lang.name)}</div>
            </div>
          </div>
          ${
            isSelected
              ? `<span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>`
              : `<span class="text-[11px] text-slate-400 shrink-0 font-medium">Select</span>`
          }
        `;

        btn.addEventListener('click', () => {
          selectVoiceLang(lang.code);
        });

        langList.appendChild(btn);
      });
    }

    function selectVoiceLang(code) {
      selectedVoiceLang = code;
      try {
        localStorage.setItem('kalidass_voice_lang', code);
      } catch (_) {}
      updateLangBadgeUI();
      closeLangModal();
      showVoiceToast(`Speech language set to: ${getLangShortLabel(code)}`);
    }

    function openLangModal() {
      if (!langModal || !langModalBox) return;
      renderLangList();
      if (langSearchInput) langSearchInput.value = '';
      langSearchClear?.classList.add('hidden');
      langModal.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
      langModal.setAttribute('aria-hidden', 'false');

      setTimeout(() => {
        langModalBox.classList.remove('translate-y-6', 'sm:scale-95');
        langSearchInput?.focus();
      }, 10);
    }

    function closeLangModal() {
      if (!langModal || !langModalBox) return;
      langModalBox.classList.add('translate-y-6', 'sm:scale-95');
      langModal.classList.add('opacity-0');

      setTimeout(() => {
        langModal.classList.add('hidden', 'pointer-events-none');
        langModal.setAttribute('aria-hidden', 'true');
      }, 200);
    }

    langPickerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openLangModal();
    });

    langCloseBtn?.addEventListener('click', closeLangModal);
    langModal?.addEventListener('click', (e) => {
      if (e.target === langModal) closeLangModal();
    });

    langSearchInput?.addEventListener('input', (e) => {
      const val = e.target.value;
      if (langSearchClear) {
        if (val) langSearchClear.classList.remove('hidden');
        else langSearchClear.classList.add('hidden');
      }
      renderLangList(val);
    });

    langSearchClear?.addEventListener('click', () => {
      if (langSearchInput) {
        langSearchInput.value = '';
        langSearchInput.focus();
      }
      langSearchClear.classList.add('hidden');
      renderLangList();
    });

    // Speech Recognition
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognitionInstance = null;
    let isListening = false;
    let autoSubmitVoice = false;
    let liveVoiceBuffer = '';

    function stopListeningUI() {
      isListening = false;
      micIconIdle?.classList.remove('hidden');
      micIconActive?.classList.add('hidden');
      micPulse?.classList.add('hidden');
      micBtn?.classList.remove('bg-red-500/20', 'border-red-500');
      voiceStatus?.classList.add('hidden');
    }

    function startListeningUI(label, code) {
      isListening = true;
      micIconIdle?.classList.add('hidden');
      micIconActive?.classList.remove('hidden');
      micPulse?.classList.remove('hidden');
      micBtn?.classList.add('bg-red-500/20', 'border-red-500');

      if (voiceStatusText) {
        voiceStatusText.textContent = `Listening in ${label}... Speak now`;
      }
      if (voiceListeningLang) {
        voiceListeningLang.textContent = code || 'Auto';
      }
      voiceStatus?.classList.remove('hidden');
    }

    function stopListening(submit = false) {
      if (recognitionInstance) {
        try {
          recognitionInstance.stop();
        } catch (_) {}
      }
      stopListeningUI();
      if (submit && userInput && userInput.value.trim().length > 0) {
        handleUserSubmit(userInput.value.trim());
      }
    }

    function toggleVoiceInput() {
      if (isListening) {
        stopListening(true);
        return;
      }

      if (!SpeechRecognition) {
        showVoiceToast('Voice recognition is not supported on this browser. Try Chrome on Android/Desktop.');
        return;
      }

      try {
        if (recognitionInstance) {
          try { recognitionInstance.abort(); } catch (_) {}
        }

        recognitionInstance = new SpeechRecognition();
        recognitionInstance.continuous = false;
        recognitionInstance.interimResults = true;

        let activeCode = selectedVoiceLang;
        let activeLabel = getLangShortLabel(selectedVoiceLang);

        if (!activeCode || activeCode === 'auto') {
          activeCode = navigator.language || 'ta-IN';
          activeLabel = 'Auto (' + activeCode.split('-')[0].toUpperCase() + ')';
        }

        recognitionInstance.lang = activeCode;
        liveVoiceBuffer = '';
        autoSubmitVoice = true;

        recognitionInstance.onstart = () => {
          startListeningUI(activeLabel, activeCode);
        };

        recognitionInstance.onresult = (event) => {
          let interimTranscript = '';
          let finalTranscript = '';

          for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              finalTranscript += event.results[i][0].transcript;
            } else {
              interimTranscript += event.results[i][0].transcript;
            }
          }

          const currentText = finalTranscript || interimTranscript;
          if (currentText) {
            liveVoiceBuffer = currentText.trim();
            if (userInput) userInput.value = liveVoiceBuffer;
          }
        };

        recognitionInstance.onerror = (event) => {
          stopListeningUI();
          if (event.error === 'not-allowed') {
            showVoiceToast('Microphone access blocked. Please allow microphone permission.');
          } else if (event.error === 'no-speech') {
            showVoiceToast('No voice detected. Please tap mic and speak clearly.');
          }
        };

        recognitionInstance.onend = () => {
          stopListeningUI();
          if (autoSubmitVoice && liveVoiceBuffer && liveVoiceBuffer.length > 2) {
            handleUserSubmit(liveVoiceBuffer);
            liveVoiceBuffer = '';
          }
        };

        recognitionInstance.start();
      } catch (err) {
        stopListeningUI();
        showVoiceToast('Microphone error: ' + (err.message || 'Please try again.'));
      }
    }

    micBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      toggleVoiceInput();
    });

    voiceCancelBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      autoSubmitVoice = false;
      if (recognitionInstance) {
        try { recognitionInstance.abort(); } catch (_) {}
      }
      stopListeningUI();
      if (userInput && liveVoiceBuffer && userInput.value === liveVoiceBuffer) {
        userInput.value = '';
      }
      liveVoiceBuffer = '';
    });

