---
import AndroidPhoneIcon from './AndroidPhoneIcon.astro';
import GeminiIcon from './GeminiIcon.astro';
import { WHATSAPP_CONFIG } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
}

const {
  phone = `+${WHATSAPP_CONFIG.phone}`,
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
} = Astro.props;

const callUrl = `tel:${phone}`;
---

<!-- Material Design 3 AI Fare Concierge Modal (Clean, Minimal, Non-Clumpy) -->
<div
  id="ai-fare-modal"
  class="fixed inset-0 z-[100] hidden flex-col justify-end sm:justify-center items-center bg-black/50 backdrop-blur-xs transition-opacity duration-200 p-0 sm:p-4 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ai-modal-title"
  aria-hidden="true"
>
  <!-- M3 Dialog / Bottom-Sheet Container -->
  <div
    id="ai-modal-box"
    class="relative w-full sm:max-w-lg md:max-w-xl h-[85vh] sm:h-[580px] max-h-[90vh] flex flex-col bg-m3-surface-bright dark:bg-[#1E1F20] text-m3-on-surface rounded-t-3xl sm:rounded-3xl shadow-m3-4 overflow-hidden border border-m3-outline-variant/50 transform translate-y-8 sm:translate-y-2 sm:scale-95 transition-all duration-200"
  >
    <!-- M3 Top App Bar: Minimal, One Single Call Number at Top -->
    <header class="flex items-center justify-between px-4 py-3 bg-m3-surface dark:bg-[#1A1B1E] border-b border-m3-outline-variant/40 shrink-0 select-none">
      <!-- Title & Gemini Symbol -->
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-8 h-8 rounded-full bg-white dark:bg-white/10 border border-slate-200/80 dark:border-white/10 flex items-center justify-center shadow-xs shrink-0">
          <GeminiIcon class="w-5 h-5" id="modal-header-gemini" />
        </span>
        <h2 id="ai-modal-title" class="font-semibold text-sm sm:text-base text-m3-on-surface tracking-tight whitespace-nowrap">
          Let me Help You
        </h2>
      </div>

      <!-- Action items: ONLY ONE Phone Call Button + Clean Close Icon -->
      <div class="flex items-center gap-2">
        <a
          href={callUrl}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#006D3B] hover:bg-[#00532B] active:scale-95 text-xs font-semibold text-white transition-all shadow-xs"
          title={`Call Helpline ${displayPhone}`}
          aria-label={`Call Helpline ${displayPhone}`}
        >
          <AndroidPhoneIcon className="w-3.5 h-3.5 shrink-0 text-white" />
          <span class="tracking-tight">{displayPhone}</span>
        </a>
        <button
          type="button"
          id="close-ai-modal-btn"
          class="w-9 h-9 rounded-full flex items-center justify-center text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container active:scale-90 transition-all focus:outline-none"
          aria-label="Close dialog"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- M3 Chat Thread: Clean, Breathable, Spaced -->
    <main
      id="ai-chat-thread"
      class="flex-1 overflow-y-auto p-4 space-y-3 bg-m3-surface dark:bg-[#121316] text-sm scroll-smooth"
    >
      <!-- Clean Welcome Message (Direct & Minimal) -->
      <div class="flex items-start gap-2.5 max-w-[88%]">
        <div class="w-7 h-7 rounded-full bg-m3-primary text-m3-on-primary flex items-center justify-center text-xs shrink-0 mt-0.5 font-bold shadow-xs">
          KT
        </div>
        <div class="bg-m3-surface-container-low dark:bg-m3-surface-container p-3.5 rounded-2xl rounded-tl-xs border border-m3-outline-variant/40 shadow-xs text-m3-on-surface leading-relaxed text-sm">
          <p class="font-medium text-m3-on-surface">Vanakkam! Which trip fare can I check for you?</p>
          <p class="text-xs text-m3-on-surface-variant mt-1">Tap a route below or type your destination.</p>
        </div>
      </div>
    </main>

    <!-- M3 Assist Chips (Clean, Compact, Horizontal Scroll) -->
    <div
      id="ai-quick-chips"
      class="px-4 py-2 bg-m3-surface-container-low dark:bg-[#1A1B1E] border-t border-m3-outline-variant/40 flex items-center gap-1.5 overflow-x-auto no-scrollbar whitespace-nowrap text-xs"
    >
      <button
        type="button"
        data-quick-prompt="How much for Chennai to Tirupati 1-day package in Sedan and Ertiga?"
        class="quick-chip px-3 py-1.5 rounded-full bg-m3-surface-container-high dark:bg-[#2A2B30] hover:bg-m3-primary/10 text-m3-on-surface border border-m3-outline-variant/60 transition-all shrink-0 active:scale-95 font-medium cursor-pointer"
      >
        🕉️ Tirupati Balaji
      </button>
      <button
        type="button"
        data-quick-prompt="What are Chennai local 8 hour packages for Sedan and Ertiga?"
        class="quick-chip px-3 py-1.5 rounded-full bg-m3-surface-container-high dark:bg-[#2A2B30] hover:bg-m3-primary/10 text-m3-on-surface border border-m3-outline-variant/60 transition-all shrink-0 active:scale-95 font-medium cursor-pointer"
      >
        ⏱️ Local 8hr Rental
      </button>
      <button
        type="button"
        data-quick-prompt="What is the outstation per km rate for Ertiga and Innova?"
        class="quick-chip px-3 py-1.5 rounded-full bg-m3-surface-container-high dark:bg-[#2A2B30] hover:bg-m3-primary/10 text-m3-on-surface border border-m3-outline-variant/60 transition-all shrink-0 active:scale-95 font-medium cursor-pointer"
      >
        🛣️ Outstation Rates
      </button>
      <button
        type="button"
        data-quick-prompt="How much for Chennai to Pondicherry same day return?"
        class="quick-chip px-3 py-1.5 rounded-full bg-m3-surface-container-high dark:bg-[#2A2B30] hover:bg-m3-primary/10 text-m3-on-surface border border-m3-outline-variant/60 transition-all shrink-0 active:scale-95 font-medium cursor-pointer"
      >
        🏖️ Pondicherry
      </button>
    </div>

    <!-- M3 Search / Text Input Bar (Multilingual Mic & Zero Clutter) -->
    <footer class="p-3 bg-m3-surface dark:bg-[#1E1F20] border-t border-m3-outline-variant/40">
      <!-- Voice Listening Status Bar (Visible only when recording) -->
      <div
        id="ai-voice-status"
        class="hidden mb-2 px-3 py-1.5 rounded-2xl bg-red-500/10 dark:bg-red-500/15 border border-red-500/30 flex items-center justify-between text-xs text-red-600 dark:text-red-400 shadow-xs transition-all"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="relative flex h-2.5 w-2.5 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600"></span>
          </span>
          <span id="ai-voice-status-text" class="truncate font-semibold tracking-tight text-[11px] sm:text-xs">
            Listening... Speak now
          </span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span id="ai-voice-listening-lang" class="px-2 py-0.5 rounded-full bg-red-500/20 text-[10px] font-bold">
            Auto
          </span>
          <button
            type="button"
            id="ai-voice-cancel-btn"
            class="px-2.5 py-0.5 rounded-full bg-red-600 hover:bg-red-700 active:scale-95 text-white text-[10px] font-semibold transition-all cursor-pointer shadow-xs"
          >
            Cancel
          </button>
        </div>
      </div>

      <!-- Quick Toast / Notification Bubble -->
      <div
        id="ai-voice-toast"
        class="hidden mb-2 px-3 py-1.5 rounded-xl bg-m3-surface-container-highest text-m3-on-surface border border-m3-outline-variant/50 text-[11px] font-medium text-center shadow-xs transition-all"
      ></div>

      <form id="ai-chat-form" class="flex items-center gap-1.5 sm:gap-2">
        <div class="relative flex-1 flex items-center min-w-0">
          <input
            type="text"
            id="ai-user-input"
            placeholder="Ask trip fare or tap mic..."
            class="w-full pl-3.5 pr-20 sm:pr-24 py-2.5 rounded-full bg-m3-surface-container dark:bg-[#28292D] text-m3-on-surface placeholder:text-m3-on-surface-variant/60 text-xs sm:text-sm border border-transparent focus:border-m3-primary focus:bg-m3-surface-bright focus:outline-none transition-all"
            autocomplete="off"
            required
          />
          <!-- Language Picker Button placed neatly inside input on the right -->
          <button
            type="button"
            id="ai-lang-picker-btn"
            class="absolute right-1.5 px-2 py-1 rounded-full bg-m3-surface-container-high dark:bg-[#383A40] hover:bg-m3-primary/15 hover:text-m3-primary text-m3-on-surface-variant text-[11px] font-medium flex items-center gap-1 transition-all border border-m3-outline-variant/40 shadow-xs cursor-pointer active:scale-95"
            title="Change voice speech language (All languages supported)"
            aria-label="Change voice speech language"
          >
            <span class="text-xs">🌐</span>
            <span id="ai-current-lang-code" class="font-bold tracking-tight text-[10px]">Auto</span>
          </button>
        </div>

        <!-- Multilingual Microphone Button -->
        <button
          type="button"
          id="ai-mic-btn"
          class="w-10 h-10 rounded-full bg-m3-surface-container-high dark:bg-[#28292D] hover:bg-m3-surface-container-highest active:scale-90 text-m3-on-surface flex items-center justify-center shrink-0 transition-all shadow-xs focus:outline-none cursor-pointer group relative border border-m3-outline-variant/40"
          title="Voice input in any language (Tamil, English, Hindi, Telugu...)"
          aria-label="Voice input in any language"
        >
          <!-- Mic Normal Icon -->
          <svg id="ai-mic-icon-idle" class="w-4 h-4 text-m3-primary transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
            <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
          </svg>
          <!-- Mic Recording Pulsing Aura & Red Icon -->
          <span id="ai-mic-pulse" class="hidden absolute inset-0 rounded-full bg-red-500/30 animate-ping pointer-events-none"></span>
          <svg id="ai-mic-icon-active" class="hidden w-4 h-4 text-red-600 animate-pulse" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
            <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
          </svg>
        </button>

        <!-- Send Submit Button -->
        <button
          type="submit"
          id="ai-send-btn"
          class="w-10 h-10 rounded-full bg-m3-primary hover:bg-m3-primary/90 active:scale-95 text-m3-on-primary flex items-center justify-center shrink-0 transition-all shadow-xs focus:outline-none disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
          aria-label="Send message"
        >
          <svg class="w-4 h-4 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>
      <!-- Official Google Gemini AI Attribution (Brand Guidelines Compliant) -->
      <div class="mt-2 text-center text-[10px] text-m3-on-surface-variant/70 font-medium tracking-wide flex items-center justify-center gap-1.5 select-none">
        <GeminiIcon class="w-3.5 h-3.5" id="modal-footer-gemini" />
        <span>Powered by Google Gemini</span>
      </div>
    </footer>

    <!-- Multilingual Speech Language Picker Modal -->
    <div
      id="ai-lang-modal"
      class="hidden absolute inset-0 z-40 bg-black/60 backdrop-blur-xs flex flex-col justify-end sm:justify-center items-center p-0 sm:p-4 opacity-0 pointer-events-none transition-all duration-200"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ai-lang-modal-title"
    >
      <div
        id="ai-lang-modal-box"
        class="w-full sm:max-w-md bg-m3-surface dark:bg-[#1E1F20] text-m3-on-surface rounded-t-3xl sm:rounded-2xl shadow-2xl flex flex-col max-h-[82vh] overflow-hidden border border-m3-outline-variant/50 transform translate-y-6 sm:scale-95 transition-all duration-200"
      >
        <!-- Modal Header -->
        <div class="px-4 py-3 bg-m3-surface-container-low dark:bg-[#18191B] border-b border-m3-outline-variant/40 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-full bg-m3-primary/10 text-m3-primary flex items-center justify-center text-sm shadow-xs">
              🌐
            </span>
            <div>
              <h3 id="ai-lang-modal-title" class="font-bold text-sm text-m3-on-surface leading-tight">
                Speech Language
              </h3>
              <p class="text-[11px] text-m3-on-surface-variant">Speak in any language</p>
            </div>
          </div>
          <button
            type="button"
            id="ai-lang-close-btn"
            class="w-8 h-8 rounded-full flex items-center justify-center text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container active:scale-90 transition-all cursor-pointer"
            aria-label="Close language selector"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="p-3 bg-m3-surface dark:bg-[#1E1F20] border-b border-m3-outline-variant/30 shrink-0">
          <div class="relative flex items-center">
            <svg class="w-4 h-4 absolute left-3 text-m3-on-surface-variant/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="ai-lang-search-input"
              placeholder="Search language (Tamil, Hindi, Telugu, English...)"
              class="w-full pl-9 pr-8 py-2 rounded-xl bg-m3-surface-container dark:bg-[#28292D] text-xs text-m3-on-surface placeholder:text-m3-on-surface-variant/60 border border-transparent focus:border-m3-primary focus:outline-none transition-all"
              autocomplete="off"
            />
            <button
              type="button"
              id="ai-lang-search-clear"
              class="hidden absolute right-2.5 text-xs text-m3-on-surface-variant hover:text-m3-on-surface p-1 cursor-pointer"
              aria-label="Clear search"
            >
              ✕
            </button>
          </div>
        </div>

        <!-- Language List (Scrollable) -->
        <div id="ai-lang-list" class="overflow-y-auto p-2 space-y-1 text-xs divide-y divide-m3-outline-variant/15 flex-1 min-h-[240px]">
          <!-- Injected dynamically -->
        </div>

        <!-- Modal Footer -->
        <div class="px-4 py-2.5 bg-m3-surface-container-low dark:bg-[#18191B] border-t border-m3-outline-variant/30 text-[11px] text-m3-on-surface-variant flex items-center justify-between shrink-0 select-none">
          <span id="ai-lang-active-display">Active: <strong class="text-m3-on-surface">Auto Detect</strong></span>
          <span class="text-m3-primary font-medium text-[10px]">Tap to choose</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('ai-fare-modal');
    const modalBox = document.getElementById('ai-modal-box');
    const closeBtn = document.getElementById('close-ai-modal-btn');
    const chatForm = document.getElementById('ai-chat-form');
    const userInput = document.getElementById('ai-user-input');
    const chatThread = document.getElementById('ai-chat-thread');
    const sendBtn = document.getElementById('ai-send-btn');
    const quickChips = document.querySelectorAll('.quick-chip');

    // Multilingual Voice Input Elements
    const micBtn = document.getElementById('ai-mic-btn');
    const micIconIdle = document.getElementById('ai-mic-icon-idle');
    const micIconActive = document.getElementById('ai-mic-icon-active');
    const micPulse = document.getElementById('ai-mic-pulse');
    const voiceStatus = document.getElementById('ai-voice-status');
    const voiceStatusText = document.getElementById('ai-voice-status-text');
    const voiceListeningLang = document.getElementById('ai-voice-listening-lang');
    const voiceCancelBtn = document.getElementById('ai-voice-cancel-btn');
    const voiceToast = document.getElementById('ai-voice-toast');
    const langPickerBtn = document.getElementById('ai-lang-picker-btn');
    const currentLangCodeEl = document.getElementById('ai-current-lang-code');

    // Language Modal Elements
    const langModal = document.getElementById('ai-lang-modal');
    const langModalBox = document.getElementById('ai-lang-modal-box');
    const langCloseBtn = document.getElementById('ai-lang-close-btn');
    const langSearchInput = document.getElementById('ai-lang-search-input');
    const langSearchClear = document.getElementById('ai-lang-search-clear');
    const langList = document.getElementById('ai-lang-list');
    const langActiveDisplay = document.getElementById('ai-lang-active-display');

    // Full Comprehensive Multilingual Voice Database
    const VOICE_LANGUAGES = [
      { code: 'auto', name: 'Auto Detect (Device / Browser Language)', native: 'Auto Detect', flag: '🌐', group: 'Detected' },

      // Indian Languages (Priority for Kalidass Travels Chennai)
      { code: 'ta-IN', name: 'Tamil (India)', native: 'தமிழ்', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'en-IN', name: 'English (India)', native: 'English (IN)', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'hi-IN', name: 'Hindi (India)', native: 'हिन्दी', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'te-IN', name: 'Telugu (India)', native: 'తెలుగు', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'ml-IN', name: 'Malayalam (India)', native: 'മലയാളം', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'kn-IN', name: 'Kannada (India)', native: 'ಕನ್ನಡ', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'bn-IN', name: 'Bengali (India)', native: 'বাংলা', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'mr-IN', name: 'Marathi (India)', native: 'मराठी', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'gu-IN', name: 'Gujarati (India)', native: 'ગુજરાતી', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'pa-IN', name: 'Punjabi (India)', native: 'ਪੰਜਾਬੀ', flag: '🇮🇳', group: 'Indian Languages' },
      { code: 'ur-IN', name: 'Urdu (India)', native: 'اردو', flag: '🇮🇳', group: 'Indian Languages' },

      // International Tamil & NRI English
      { code: 'ta-LK', name: 'Tamil (Sri Lanka)', native: 'தமிழ் (இலங்கை)', flag: '🇱🇰', group: 'Global' },
      { code: 'ta-SG', name: 'Tamil (Singapore)', native: 'தமிழ் (சிங்கப்பூர்)', flag: '🇸🇬', group: 'Global' },
      { code: 'ta-MY', name: 'Tamil (Malaysia)', native: 'தமிழ் (மலேசியா)', flag: '🇲🇾', group: 'Global' },
      { code: 'en-US', name: 'English (United States)', native: 'English (US)', flag: '🇺🇸', group: 'Global' },
      { code: 'en-GB', name: 'English (United Kingdom)', native: 'English (UK)', flag: '🇬🇧', group: 'Global' },
      { code: 'en-AU', name: 'English (Australia)', native: 'English (AU)', flag: '🇦🇺', group: 'Global' },
      { code: 'en-SG', name: 'English (Singapore)', native: 'English (SG)', flag: '🇸🇬', group: 'Global' },
      { code: 'en-MY', name: 'English (Malaysia)', native: 'English (MY)', flag: '🇲🇾', group: 'Global' },
      { code: 'en-AE', name: 'English (UAE / Gulf)', native: 'English (UAE)', flag: '🇦🇪', group: 'Global' },

      // Major World Languages
      { code: 'ar-SA', name: 'Arabic (Saudi Arabia)', native: 'العربية (السعودية)', flag: '🇸🇦', group: 'Global' },
      { code: 'ar-AE', name: 'Arabic (UAE)', native: 'العربية (الإمارات)', flag: '🇦🇪', group: 'Global' },
      { code: 'es-ES', name: 'Spanish (Spain)', native: 'Español', flag: '🇪🇸', group: 'Global' },
      { code: 'fr-FR', name: 'French (France)', native: 'Français', flag: '🇫🇷', group: 'Global' },
      { code: 'de-DE', name: 'German (Germany)', native: 'Deutsch', flag: '🇩🇪', group: 'Global' },
      { code: 'zh-CN', name: 'Chinese (Mandarin / Simplified)', native: '中文 (普通话)', flag: '🇨🇳', group: 'Global' },
      { code: 'ja-JP', name: 'Japanese', native: '日本語', flag: '🇯🇵', group: 'Global' },
      { code: 'ko-KR', name: 'Korean', native: '한국어', flag: '🇰🇷', group: 'Global' },
      { code: 'ru-RU', name: 'Russian', native: 'Русский', flag: '🇷🇺', group: 'Global' },
      { code: 'pt-BR', name: 'Portuguese (Brazil)', native: 'Português', flag: '🇧🇷', group: 'Global' },
      { code: 'it-IT', name: 'Italian', native: 'Italiano', flag: '🇮🇹', group: 'Global' },
      { code: 'id-ID', name: 'Indonesian', native: 'Bahasa Indonesia', flag: '🇮🇩', group: 'Global' },
      { code: 'ms-MY', name: 'Malay (Malaysia)', native: 'Bahasa Melayu', flag: '🇲🇾', group: 'Global' },
      { code: 'th-TH', name: 'Thai', native: 'ไทย', flag: '🇹🇭', group: 'Global' },
      { code: 'tr-TR', name: 'Turkish', native: 'Türkçe', flag: '🇹🇷', group: 'Global' },
      { code: 'vi-VN', name: 'Vietnamese', native: 'Tiếng Việt', flag: '🇻🇳', group: 'Global' },
      { code: 'nl-NL', name: 'Dutch', native: 'Nederlands', flag: '🇳🇱', group: 'Global' },
      { code: 'fil-PH', name: 'Filipino (Tagalog)', native: 'Filipino', flag: '🇵🇭', group: 'Global' },
      { code: 'sv-SE', name: 'Swedish', native: 'Svenska', flag: '🇸🇪', group: 'Global' },
      { code: 'pl-PL', name: 'Polish', native: 'Polski', flag: '🇵🇱', group: 'Global' },
      { code: 'he-IL', name: 'Hebrew', native: 'עברית', flag: '🇮🇱', group: 'Global' }
    ];

    let chatHistory = [];
    let isRequestInProgress = false;

    // Load active voice language (Defaults to Auto Device Language)
    let selectedVoiceLang = 'auto';
    try {
      const saved = localStorage.getItem('kalidass_voice_lang');
      if (saved && (saved === 'auto' || VOICE_LANGUAGES.some(l => l.code === saved))) {
        selectedVoiceLang = saved;
      }
    } catch (_) {}

    function getLangShortLabel(code) {
      if (!code || code === 'auto') return 'Auto';
      if (code === 'ta-IN') return 'தமிழ்';
      if (code === 'hi-IN') return 'हिन्दी';
      if (code === 'te-IN') return 'తెలుగు';
      if (code === 'ml-IN') return 'മലയാളம்';
      if (code === 'kn-IN') return 'ಕನ್ನಡ';
      if (code === 'bn-IN') return 'বাংলা';
      if (code === 'mr-IN') return 'मराठी';
      if (code === 'gu-IN') return 'ગુજરાતી';
      if (code === 'pa-IN') return 'ਪੰਜਾਬੀ';
      if (code === 'ur-IN') return 'اردو';
      const found = VOICE_LANGUAGES.find(l => l.code === code);
      if (found) {
        if (code.startsWith('en-')) return found.native.replace('English', 'EN');
        return found.native;
      }
      return code.split('-')[0].toUpperCase();
    }

    function getLangFullName(code) {
      if (!code || code === 'auto') return 'Auto Detect (Device / Browser)';
      const found = VOICE_LANGUAGES.find(l => l.code === code);
      return found ? `${found.native} — ${found.name}` : code;
    }

    function updateLangBadgeUI() {
      if (currentLangCodeEl) {
        currentLangCodeEl.textContent = getLangShortLabel(selectedVoiceLang);
      }
      if (langActiveDisplay) {
        langActiveDisplay.innerHTML = `Active: <strong class="text-m3-on-surface">${escapeHtml(getLangFullName(selectedVoiceLang))}</strong>`;
      }
    }
    updateLangBadgeUI();

    let toastTimer = null;
    function showVoiceToast(msg, duration = 3500) {
      if (!voiceToast) return;
      clearTimeout(toastTimer);
      voiceToast.textContent = msg;
      voiceToast.classList.remove('hidden');
      toastTimer = setTimeout(() => {
        voiceToast.classList.add('hidden');
      }, duration);
    }

    // Modal Opening & Closing
    function openAiModal() {
      if (!modal) return;
      modal.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Check on-screen calculation and inject contextual assistance chip
      const currentCalc = window.__KT_CURRENT_CALCULATION;
      const quickChipsContainer = document.getElementById('ai-quick-chips');
      let existingContextChip = document.getElementById('ai-context-chip');
      if (currentCalc && currentCalc.formattedFare && quickChipsContainer) {
        const destTitle = currentCalc.destination || 'My Trip';
        const chipPrompt = `Can you explain the ${currentCalc.formattedFare} rate on my screen for ${destTitle}?`;
        if (!existingContextChip) {
          existingContextChip = document.createElement('button');
          existingContextChip.type = 'button';
          existingContextChip.id = 'ai-context-chip';
          existingContextChip.className = 'quick-chip px-3 py-1.5 rounded-full bg-emerald-600/15 dark:bg-emerald-500/20 hover:bg-emerald-600/25 text-emerald-800 dark:text-emerald-300 border border-emerald-500/40 transition-all shrink-0 active:scale-95 font-semibold cursor-pointer flex items-center gap-1.5 animate-pulse';
          existingContextChip.innerHTML = `<span>✨ On-Screen: ${escapeHtml(currentCalc.vehicleName || 'Cab')} (${escapeHtml(currentCalc.formattedFare)})</span>`;
          existingContextChip.setAttribute('data-quick-prompt', chipPrompt);
          existingContextChip.addEventListener('click', () => {
            handleUserSubmit(existingContextChip.getAttribute('data-quick-prompt'));
          });
          quickChipsContainer.prepend(existingContextChip);
        } else {
          existingContextChip.innerHTML = `<span>✨ On-Screen: ${escapeHtml(currentCalc.vehicleName || 'Cab')} (${escapeHtml(currentCalc.formattedFare)})</span>`;
          existingContextChip.setAttribute('data-quick-prompt', chipPrompt);
        }
      }

      setTimeout(() => {
        modalBox?.classList.remove('translate-y-8', 'sm:translate-y-2', 'sm:scale-95');
        userInput?.focus();
      }, 10);
    }

    function closeAiModal() {
      if (!modal) return;
      stopListening(false);
      closeLangModal();
      modalBox?.classList.add('translate-y-8', 'sm:translate-y-2', 'sm:scale-95');
      modal.classList.add('opacity-0');

      setTimeout(() => {
        modal.classList.add('hidden', 'pointer-events-none');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }, 200);
    }

    window.openAiFareModal = openAiModal;

    closeBtn?.addEventListener('click', closeAiModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeAiModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (langModal && !langModal.classList.contains('hidden')) {
          closeLangModal();
          e.stopPropagation();
          return;
        }
        if (!modal?.classList.contains('hidden')) {
          closeAiModal();
        }
      }
    });

    // Language Picker Modal Logic
    function renderLangList(query = '') {
      if (!langList) return;
      langList.innerHTML = '';
      const q = query.trim().toLowerCase();

      const filtered = VOICE_LANGUAGES.filter(lang => {
        if (!q) return true;
        return lang.name.toLowerCase().includes(q) ||
               lang.native.toLowerCase().includes(q) ||
               lang.code.toLowerCase().includes(q) ||
               lang.group.toLowerCase().includes(q);
      });

      if (filtered.length === 0) {
        langList.innerHTML = `
          <div class="py-8 text-center text-m3-on-surface-variant text-xs">
            No language found matching "${escapeHtml(query)}"
          </div>
        `;
        return;
      }

      filtered.forEach(lang => {
        const isSelected = selectedVoiceLang === lang.code;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-full px-3 py-2.5 rounded-xl flex items-center justify-between transition-all cursor-pointer text-left ${
          isSelected
            ? 'bg-m3-primary/15 text-m3-primary font-bold shadow-xs'
            : 'hover:bg-m3-surface-container-high text-m3-on-surface'
        }`;
        btn.innerHTML = `
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="text-base shrink-0 select-none">${lang.flag}</span>
            <div class="min-w-0">
              <div class="font-semibold text-xs text-m3-on-surface flex items-center gap-1.5">
                <span>${escapeHtml(lang.native)}</span>
                ${lang.code !== 'auto' ? `<span class="text-[10px] text-m3-on-surface-variant/70 font-mono font-normal">(${lang.code})</span>` : ''}
              </div>
              <div class="text-[10px] text-m3-on-surface-variant truncate">${escapeHtml(lang.name)}</div>
            </div>
          </div>
          ${
            isSelected
              ? `<span class="w-5 h-5 rounded-full bg-m3-primary text-m3-on-primary flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>`
              : `<span class="text-[11px] text-m3-on-surface-variant/40 shrink-0 font-medium">Select</span>`
          }
        `;

        btn.addEventListener('click', () => {
          selectVoiceLang(lang.code);
        });

        langList.appendChild(btn);
      });
    }

    function selectVoiceLang(code) {
      selectedVoiceLang = code;
      try {
        localStorage.setItem('kalidass_voice_lang', code);
      } catch (_) {}
      updateLangBadgeUI();
      closeLangModal();
      showVoiceToast(`Speech language set to: ${getLangShortLabel(code)}`);
    }

    function openLangModal() {
      if (!langModal) return;
      renderLangList();
      if (langSearchInput) langSearchInput.value = '';
      langSearchClear?.classList.add('hidden');
      langModal.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
      langModal.setAttribute('aria-hidden', 'false');

      setTimeout(() => {
        langModalBox?.classList.remove('translate-y-6', 'sm:scale-95');
        langSearchInput?.focus();
      }, 10);
    }

    function closeLangModal() {
      if (!langModal) return;
      langModalBox?.classList.add('translate-y-6', 'sm:scale-95');
      langModal.classList.add('opacity-0');

      setTimeout(() => {
        langModal.classList.add('hidden', 'pointer-events-none');
        langModal.setAttribute('aria-hidden', 'true');
      }, 200);
    }

    langPickerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openLangModal();
    });

    langCloseBtn?.addEventListener('click', closeLangModal);
    langModal?.addEventListener('click', (e) => {
      if (e.target === langModal) closeLangModal();
    });

    langSearchInput?.addEventListener('input', (e) => {
      const val = e.target.value;
      if (langSearchClear) {
        if (val) langSearchClear.classList.remove('hidden');
        else langSearchClear.classList.add('hidden');
      }
      renderLangList(val);
    });

    langSearchClear?.addEventListener('click', () => {
      if (langSearchInput) {
        langSearchInput.value = '';
        langSearchInput.focus();
      }
      langSearchClear.classList.add('hidden');
      renderLangList();
    });

    // Speech Recognition Implementation
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognitionInstance = null;
    let isListening = false;
    let autoSubmitVoice = false;
    let liveVoiceBuffer = '';

    function stopListeningUI() {
      isListening = false;
      micIconIdle?.classList.remove('hidden');
      micIconActive?.classList.add('hidden');
      micPulse?.classList.add('hidden');
      micBtn?.classList.remove('bg-red-500/20', 'border-red-500');
      voiceStatus?.classList.add('hidden');
    }

    function startListeningUI(label, code) {
      isListening = true;
      micIconIdle?.classList.add('hidden');
      micIconActive?.classList.remove('hidden');
      micPulse?.classList.remove('hidden');
      micBtn?.classList.add('bg-red-500/20', 'border-red-500');

      if (voiceStatusText) {
        voiceStatusText.textContent = `Listening in ${label}... Speak now`;
      }
      if (voiceListeningLang) {
        voiceListeningLang.textContent = code || 'Auto';
      }
      voiceStatus?.classList.remove('hidden');
    }

    function stopListening(processSubmit = true) {
      if (!isListening && !recognitionInstance) return;
      if (!processSubmit) {
        autoSubmitVoice = false;
      }
      if (recognitionInstance) {
        try {
          recognitionInstance.stop();
        } catch (_) {}
      }
      stopListeningUI();
    }

    function toggleVoiceInput() {
      if (!SpeechRecognition) {
        showVoiceToast('⚠️ Voice input is not supported in this browser. Please use Chrome, Edge, or Safari.');
        return;
      }

      if (isListening) {
        stopListening(true);
        return;
      }

      try {
        if (recognitionInstance) {
          try { recognitionInstance.abort(); } catch (_) {}
        }
        recognitionInstance = new SpeechRecognition();

        let effectiveLang = selectedVoiceLang;
        if (effectiveLang === 'auto') {
          effectiveLang = navigator.language || 'en-IN';
        }

        recognitionInstance.lang = effectiveLang;
        recognitionInstance.interimResults = true;
        recognitionInstance.continuous = false;
        recognitionInstance.maxAlternatives = 1;

        autoSubmitVoice = true;
        liveVoiceBuffer = '';

        recognitionInstance.onstart = () => {
          startListeningUI(getLangShortLabel(selectedVoiceLang), effectiveLang);
        };

        recognitionInstance.onresult = (event) => {
          let interimText = '';
          let finalText = '';

          for (let i = event.resultIndex; i < event.results.length; ++i) {
            const item = event.results[i];
            if (item.isFinal) {
              finalText += item[0].transcript;
            } else {
              interimText += item[0].transcript;
            }
          }

          const captured = (finalText || interimText || '').trim();
          if (captured) {
            liveVoiceBuffer = captured;
            if (userInput) {
              userInput.value = captured;
            }
          }
        };

        recognitionInstance.onerror = (event) => {
          stopListeningUI();
          if (event.error === 'not-allowed') {
            showVoiceToast('🔒 Microphone permission blocked. Allow mic access in browser.');
          } else if (event.error === 'no-speech') {
            showVoiceToast('No voice detected. Tap mic to try again.');
          } else if (event.error === 'network') {
            showVoiceToast('Network issue with speech recognition service.');
          }
        };

        recognitionInstance.onend = () => {
          stopListeningUI();
          const query = (userInput?.value || liveVoiceBuffer || '').trim();
          if (autoSubmitVoice && query.length >= 2) {
            handleUserSubmit(query);
          }
        };

        recognitionInstance.start();
      } catch (err) {
        stopListeningUI();
        showVoiceToast('Microphone error: ' + (err.message || 'Please try again.'));
      }
    }

    micBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      toggleVoiceInput();
    });

    voiceCancelBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      autoSubmitVoice = false;
      if (recognitionInstance) {
        try { recognitionInstance.abort(); } catch (_) {}
      }
      stopListeningUI();
      if (userInput && liveVoiceBuffer && userInput.value === liveVoiceBuffer) {
        userInput.value = '';
      }
      liveVoiceBuffer = '';
    });

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatMarkdown(text) {
      if (!text) return '';
      let escaped = escapeHtml(text);
      // bold **text**
      escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      // markdown links [text](url)
      escaped = escaped.replace(/\[(.*?)\]\((https?:\/\/[^\s\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-semibold shadow-xs transition-all active:scale-95 no-underline my-1.5">$1</a>');
      // bullet lists
      escaped = escaped.replace(/(?:^|\n)[•*-]\s*(.+)/g, '<div class="flex items-start gap-1.5 my-1"><span class="text-m3-primary font-bold shrink-0">•</span><span>$1</span></div>');
      // line breaks
      escaped = escaped.replace(/\n\n/g, '<div class="my-2"></div>');
      escaped = escaped.replace(/\n/g, '<br/>');
      return escaped;
    }

