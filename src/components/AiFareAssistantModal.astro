    function getChatSessionId() {
      try {
        let sid = sessionStorage.getItem('kt_ai_chat_session_id');
        if (!sid) {
          let seq = parseInt(localStorage.getItem('kt_last_ai_chat_seq') || '100', 10);
          if (isNaN(seq) || seq < 100) seq = 100;
          seq += 1;
          localStorage.setItem('kt_last_ai_chat_seq', String(seq));
          sid = 'KT-SES-' + seq;
          sessionStorage.setItem('kt_ai_chat_session_id', sid);
        }
        return sid;
      } catch (_) {
        return 'KT-SES-101';
      }
    }

    async function handleUserSubmit(text) {
      if (!text || isRequestInProgress) return;
      isRequestInProgress = true;
      if (sendBtn) sendBtn.disabled = true;

      if (isMobileDevice()) {
        userInput?.blur();
      }

      appendMessage('user', text);
      chatHistory.push({ role: 'user', content: text });
      if (userInput) userInput.value = '';

      showTypingIndicator();

      const sessionId = getChatSessionId();
      const sourcePage = window.location.pathname || '/';
      const pageContext = window.__KT_CURRENT_CALCULATION || null;

      let reply = '';
      try {
        const response = await fetch('/api/ai-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: chatHistory,
            sessionId,
            sourcePage,
            pageContext
          }),
        });

        if (response.ok) {
          const data = await response.json();
          if (data && data.reply) {
            reply = data.reply;
          }
        }
      } catch (_) {}

      if (!reply) {
        await new Promise((r) => setTimeout(r, 200));
        reply = getLocalTariffReply(chatHistory, pageContext);
      }

      removeTypingIndicator();
      appendMessage('assistant', reply);
      chatHistory.push({ role: 'assistant', content: reply });

      const wantsToOpen = /(?:open|launch|navigate|go to|take me|calculate.*page|set.*calculate)/i.test(text);
      if (wantsToOpen) {
        const linkMatch = reply.match(/\[.*?\]\(((?:\/services\/[^\s\)]+)|(?:https?:\/\/[^\s\)]*\/services\/[^\s\)]+))\)/);
        if (linkMatch && linkMatch[1]) {
          const targetHref = linkMatch[1];
          showVoiceToast('🚀 Directing to calculator...');
          setTimeout(() => {
            closeAiModal();
            const target = new URL(targetHref, window.location.origin);
            if (window.location.pathname === target.pathname) {
              window.location.search = target.search;
            } else {
              window.location.href = targetHref;
            }
          }, 1200);
        }
      }

      isRequestInProgress = false;
      if (sendBtn) sendBtn.disabled = false;

      if (!isMobileDevice()) {
        userInput?.focus();
      } else {
        userInput?.blur();
      }
    }

    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = userInput?.value.trim();
      if (query) {
        handleUserSubmit(query);
      }
    });

    document.addEventListener('click', (e) => {
      const link = e.target.closest('.ai-action-link');
      if (link && link.getAttribute('href')) {
        const href = link.getAttribute('href');
        closeAiModal();
        const target = new URL(href, window.location.origin);
        if (window.location.pathname === target.pathname) {
          window.location.search = target.search;
        } else {
          window.location.href = href;
        }
      }
    });

    function getLocalTariffReply(historyOrText, passedContext) {
      const messages = Array.isArray(historyOrText)
        ? historyOrText
        : [{ role: 'user', content: String(historyOrText || '') }];

      const userMessages = messages.filter((m) => m.role === 'user');
      const lastMsg = userMessages[userMessages.length - 1]?.content || '';
      const lastLower = lastMsg.toLowerCase();

      if (!passedContext && typeof window !== 'undefined') {
        passedContext = window.__KT_CURRENT_CALCULATION || null;
      }

      let activeDest = null;
      let days = 1;
      let vehicles = [];
      let isTamil = false;

      for (const m of userMessages) {
        const text = m.content || '';
        const lower = text.toLowerCase();

        if (/[\u0B80-\u0BFF]/.test(text) || lower.includes('evlo') || lower.includes('sollunga')) {
          isTamil = true;
        }

        const dMatch = lower.match(/(\d+)\s*(?:days?|day|நாட்கள்|நாளுக்கு)/i);
        if (dMatch) days = parseInt(dMatch[1], 10);
        else if (lower.includes('2-day') || lower.includes('2 day') || lower.includes('two day')) days = 2;
        else if (lower.includes('3-day') || lower.includes('3 day') || lower.includes('three day')) days = 3;

        if (lower.includes('sedan') || lower.includes('dzire') || lower.includes('etios')) vehicles.push('sedan');
        if (lower.includes('ertiga') || lower.includes('xl6')) vehicles.push('ertiga');
        if (lower.includes('crysta')) vehicles.push('crysta');
        else if (lower.includes('innova')) vehicles.push('innova');
        if (lower.includes('tempo') || lower.includes('traveller')) vehicles.push('tempo');

        if (lower.includes('tirupati') || lower.includes('tirumala') || lower.includes('balaji')) activeDest = 'tirupati';
        else if (lower.includes('navagraha') || lower.includes('kumbakonam')) activeDest = 'navagraha';
        else if (lower.includes('pondy') || lower.includes('pondicherry')) activeDest = 'pondicherry';
        else if (lower.includes('thiruvannamalai') || lower.includes('tiruvannamalai')) activeDest = 'thiruvannamalai';
        else if (lower.includes('chidambaram')) activeDest = 'chidambaram';
      }

      if (lastLower.includes('permit') || lastLower.includes('border') || lastLower.includes('entry tax')) {
        return `• **Interstate State Permits (NOT INCLUDED):**\n` +
          `- For all outstation trips outside Tamil Nadu (Andhra Pradesh, Karnataka, Kerala, Puducherry), state border entry permits are NOT included in the car rate.\n` +
          `- You pay actual border checkpost receipts.\n` +
          `• **Tolls & Parking (NOT INCLUDED):** Highway tolls and parking are also NOT included in the car rate. Pay actual plaza receipts.\n` +
          `• **Exception (1-Day Tirupati Package):** The same-day Chennai ⇄ Tirupati package (₹6,000 Sedan) ALREADY INCLUDES AP border permit and NH FASTag tolls.\n` +
          `• **Advance:** ₹500 advance to lock your vehicle (deducted from your final bill).\n\n` +
          `[👉 Chat on WhatsApp](https://wa.me/918939539211?text=${encodeURIComponent('Hi Kalidass Travels, I have a question about interstate permits and tolls.')})`;
      }

      if (passedContext && passedContext.totalFare && (lastLower.includes('screen') || lastLower.includes('quote') || lastLower.includes('explain'))) {
        const destName = passedContext.destination || 'your trip';
        const vehName = passedContext.vehicleName || 'Swift Dzire';
        const fareFormatted = passedContext.formattedFare || `₹${passedContext.totalFare}`;
        const isTirupati1Day = (destName.toLowerCase().includes('tirupati') || destName.toLowerCase().includes('tirumala')) && !passedContext.isMultiDay;
        const inclusionText = isTirupati1Day
          ? 'AC cab, fuel, NH FASTag toll plaza receipts, AP border permit, and chauffeur allowance.'
          : 'AC cab, fuel, and chauffeur allowance. Highway tolls, parking, and interstate state border permits are strictly NOT included and payable at actual checkposts.';
        return `Here is the explanation of your on-screen quote for **${destName}**:\n\n` +
          `• **Quoted Vehicle:** ${vehName}\n` +
          `• **Quoted Total:** **${fareFormatted}**\n` +
          `• **Inclusions:** ${inclusionText}\n` +
          `• **Booking Advance:** Pay ₹500 to lock vehicle (deducted from final bill). Pay remaining balance post-trip.\n\n` +
