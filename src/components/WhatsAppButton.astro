---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { buildWhatsAppUrl } from '../utils/whatsapp';

interface Props {
  href?: string;
  text?: string;
  size?: 'sm' | 'md' | 'lg' | 'icon';
  fullWidth?: boolean;
  className?: string;
  variant?: 'filled' | 'elevated' | 'tonal' | 'outlined';
  ariaLabel?: string;
  id?: string;
  [key: string]: any;
}

const {
  text = "Book on WhatsApp",
  href = buildWhatsAppUrl(typeof text === 'string' ? text : undefined),
  size = "md",
  fullWidth = false,
  className = "",
  variant = "tonal",
  ariaLabel,
  id,
  ...rest
} = Astro.props;

// Google Material Design 3 (M3) button dimensions & tokens - WCAG 44px-48px Touch Ergonomics
const sizeClasses = {
  sm: "py-2.5 px-4 text-xs sm:text-sm gap-2 min-h-[44px]",
  md: "py-3 px-5 text-sm sm:text-base gap-2.5 min-h-[48px]",
  lg: "py-3.5 px-6 text-base sm:text-lg gap-3 min-h-[52px]",
  icon: "p-2.5 min-h-[44px] min-w-[44px] justify-center"
}[size];

const iconSize = {
  sm: "w-4 h-4",
  md: "w-4 h-4 sm:w-5 sm:h-5",
  lg: "w-5 h-5",
  icon: "w-5 h-5"
}[size];

// M3 Surface & State Layer specifications - Authentic WhatsApp brand colors
const variantClasses = {
  filled: "bg-[#075E54] hover:bg-[#128C7E] active:bg-[#054c44] text-white font-bold border border-[#075E54] shadow-sm hover:shadow-md",
  elevated: "bg-[#075E54] hover:bg-[#128C7E] active:bg-[#054c44] text-white font-bold border border-[#075E54] shadow-m3-1 hover:shadow-m3-2",
  tonal: "bg-[#25D366]/15 hover:bg-[#25D366]/25 active:bg-[#25D366]/30 text-[#075E54] font-bold border border-[#25D366]/30 shadow-xs",
  outlined: "bg-white hover:bg-[#25D366]/10 text-[#075E54] border border-[#25D366]/50 shadow-xs"
}[variant] || "bg-[#25D366]/15 hover:bg-[#25D366]/25 active:bg-[#25D366]/30 text-[#075E54] font-bold border border-[#25D366]/30 shadow-xs";

const iconVariant = (variant === 'filled' || variant === 'elevated') ? 'white' : 'brand';
---

<a
  href={href}
  id={id}
  target="_blank"
  rel="noopener noreferrer nofollow"
  class={`inline-flex items-center justify-center font-bold font-sans rounded-m3-full transition-all duration-200 cursor-pointer select-none active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-m3-success shadow-xs ${sizeClasses} ${variantClasses} ${className}`}
  {...rest}
>
  <WhatsAppIcon variant={iconVariant} className={iconSize} />
  {size !== 'icon' && (
    <span class="tracking-wide leading-none">
      <slot>{text}</slot>
    </span>
  )}
</a>
