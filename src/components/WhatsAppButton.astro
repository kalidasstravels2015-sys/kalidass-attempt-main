---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { buildWhatsAppUrl } from '../utils/whatsapp';

interface Props {
  href?: string;
  text?: string;
  size?: 'sm' | 'md' | 'lg' | 'icon';
  fullWidth?: boolean;
  className?: string;
  variant?: 'filled' | 'elevated' | 'tonal' | 'outlined';
  ariaLabel?: string;
  id?: string;
  [key: string]: any;
}

const {
  text = "Book on WhatsApp",
  href = buildWhatsAppUrl(typeof text === 'string' ? text : undefined),
  size = "md",
  fullWidth = false,
  className = "",
  variant = "tonal",
  ariaLabel,
  id,
  ...rest
} = Astro.props;

// Google Material Design 3 (M3) button dimensions & tokens - WCAG 44px-48px Touch Ergonomics
const sizeClasses = {
  sm: "py-2.5 px-4 text-xs sm:text-sm gap-2 min-h-[44px]",
  md: "py-3 px-5 text-sm sm:text-base gap-2.5 min-h-[48px]",
  lg: "py-3.5 px-6 text-base sm:text-lg gap-3 min-h-[52px]",
  icon: "p-2.5 min-h-[44px] min-w-[44px] justify-center"
}[size];

const iconSize = {
  sm: "w-4 h-4",
  md: "w-4 h-4 sm:w-5 sm:h-5",
  lg: "w-5 h-5",
  icon: "w-5 h-5"
}[size];

// M3 Surface & State Layer specifications - Harmonized M3 Blue theme
const variantClasses = {
  filled: "bg-m3-primary hover:bg-m3-primary/90 active:bg-m3-primary/80 text-m3-on-primary font-bold border border-m3-primary shadow-m3-1 hover:shadow-m3-2",
  elevated: "bg-m3-primary hover:bg-m3-primary/90 active:bg-m3-primary/80 text-m3-on-primary font-bold border border-m3-primary shadow-m3-2 hover:shadow-m3-3",
  tonal: "bg-m3-primary-container hover:bg-m3-primary-container/80 active:bg-m3-primary-container/90 text-m3-on-primary-container font-bold border border-m3-primary/20 shadow-xs",
  outlined: "bg-transparent hover:bg-m3-primary/10 active:bg-m3-primary/20 text-m3-primary border border-m3-outline shadow-xs"
}[variant] || "bg-m3-primary hover:bg-m3-primary/90 active:bg-m3-primary/80 text-m3-on-primary font-bold border border-m3-primary shadow-m3-1";

const iconVariant = (variant === 'filled' || variant === 'elevated') ? 'white' : (variant === 'tonal' || variant === 'outlined' ? 'monochrome' : 'brand');
---

<a
  href={href}
  id={id}
  target="_blank"
  rel="noopener noreferrer nofollow"
  class={`inline-flex items-center justify-center font-bold font-sans rounded-m3-full transition-all duration-200 cursor-pointer select-none active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-m3-primary shadow-xs ${sizeClasses} ${variantClasses} ${className}`}
  {...rest}
>
  <WhatsAppIcon variant={iconVariant} className={iconSize} />
  {size !== 'icon' && (
    <span class="tracking-wide leading-none">
      <slot>{text}</slot>
    </span>
  )}
</a>
