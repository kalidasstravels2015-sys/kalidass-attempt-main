---
import trips from '../data/trips.json';
---

<section id="trips" class="py-16 bg-m3-surface-container-low">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-m3-on-surface mb-4 font-heading">
        Popular Destinations
      </h2>
      <p class="text-base sm:text-lg text-m3-on-surface-variant max-w-2xl mx-auto font-sans">
        Handpicked travel packages to the most beautiful destinations in South India
      </p>
    </div>

    <!-- Trip Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {trips.map((trip) => (
        <div class="bg-m3-surface rounded-m3-xl overflow-hidden shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <!-- Image -->
            <div class="relative h-48 overflow-hidden bg-m3-surface-container-high">
              <img 
                src={trip.image} 
                alt={trip.title}
                width="400"
                height="192"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              />
              <!-- Badge -->
              <div class="absolute top-4 right-4">
                <span class="bg-m3-surface-container-high/90 backdrop-blur-md text-m3-on-surface px-3 py-1 rounded-m3-full text-xs font-bold shadow-m3-1">
                  {trip.type}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-5">
              <h3 class="text-lg font-bold text-m3-on-surface mb-2 font-heading">
                {trip.title}
              </h3>
              <p class="text-m3-on-surface-variant text-sm mb-4 leading-relaxed font-sans">
                {trip.desc}
              </p>

              <!-- Trip Details -->
              <div class="flex items-center justify-between text-xs text-m3-on-surface-variant mb-4 font-sans">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-m3-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  {trip.duration}
                </div>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-m3-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                  </svg>
                  {trip.kmOneWay} km
                </div>
              </div>
            </div>
          </div>

          <div class="p-5 pt-0">
            <!-- CTA Button -->
            <button 
              class="tariff-btn w-full bg-m3-primary text-m3-on-primary font-bold py-3 rounded-m3-full hover:bg-m3-primary/90 transition-all duration-300 shadow-m3-2 hover:shadow-m3-3 text-sm cursor-pointer"
              data-trip-id={trip.id}
              data-trip-title={trip.title}
              data-trip-km={trip.kmOneWay}
              data-trip-duration={trip.duration}
            >
              Check Tariff
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Handle tariff button clicks
  document.addEventListener('DOMContentLoaded', () => {
    const tariffButtons = document.querySelectorAll('.tariff-btn');
    
    tariffButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tripData = {
          id: button.getAttribute('data-trip-id'),
          title: button.getAttribute('data-trip-title'),
          kmOneWay: button.getAttribute('data-trip-km'),
          duration: button.getAttribute('data-trip-duration')
        };

        // Dispatch custom event
        const event = new CustomEvent('open-calculator', {
          detail: tripData,
          bubbles: true
        });
        document.dispatchEvent(event);
      });
    });
  });
</script>
