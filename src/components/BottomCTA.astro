---
import { Calculator, ArrowRight, Phone } from "lucide-react";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { WHATSAPP_CONFIG } from "../utils/whatsapp";

const phone = `+${WHATSAPP_CONFIG.phone}`;
const displayPhone = WHATSAPP_CONFIG.formattedPhone;
const whatsappUrl = `https://wa.me/${WHATSAPP_CONFIG.phone}?text=${encodeURIComponent('Hi Kalidass Travels, I need a cab quotation and availability details.')}`;
---

<section class="offscreen-defer py-12 md:py-18 bg-gradient-to-br from-[#0B57D0] via-[#0842A0] to-[#041E49] text-white relative overflow-hidden border-t border-[#0B57D0]/20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight leading-tight mb-3 font-heading text-white">
      Ready for a Smooth &amp; Reliable Journey?
    </h2>

    <p class="text-xs sm:text-sm md:text-base text-white/90 max-w-2xl mx-auto font-normal leading-relaxed mb-8 font-sans">
      Reserve early with <strong class="text-white font-semibold">₹500 advance</strong> (deducted from bill) — balance paid after your trip completes safely. Sanitized AC cabs, police-verified chauffeurs, and transparent flat &amp; per-km pricing.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        href={`tel:${phone}`}
        class="min-h-[48px] inline-flex items-center justify-center gap-2 px-6 sm:px-8 rounded-m3-full bg-white hover:bg-slate-100 text-[#041E49] text-sm sm:text-base font-extrabold shadow-m3-2 hover:shadow-m3-3 transition-all cursor-pointer border border-white/40 active:scale-[0.98]"
        aria-label={`Call ${displayPhone} for Instant Booking`}
      >
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <Phone className="w-4 h-4 text-[#0B57D0] shrink-0" />
        <span>Call: {displayPhone}</span>
      </a>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[48px] inline-flex items-center justify-center gap-2 px-6 sm:px-8 rounded-m3-full bg-emerald-500 hover:bg-emerald-600 text-white text-sm sm:text-base font-bold shadow-m3-2 hover:shadow-m3-3 transition-all cursor-pointer border border-emerald-400/40 active:scale-[0.98]"
        aria-label="Chat with Kalidass Travels on WhatsApp"
      >
        <WhatsAppIcon className="w-4 h-4 text-white shrink-0 fill-current" />
        <span>WhatsApp Quick Booking</span>
      </a>

      <a
        href="#booking-panel"
        class="min-h-[48px] inline-flex items-center justify-center gap-2 px-5 sm:px-6 rounded-m3-full bg-white/15 hover:bg-white/25 text-white text-sm font-semibold border border-white/30 transition-all cursor-pointer active:scale-[0.98]"
      >
        <Calculator className="w-4 h-4 text-white shrink-0" />
        <span>Calculate Fare</span>
      </a>
    </div>
  </div>
</section>
