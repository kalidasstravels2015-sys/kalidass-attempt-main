---
import { Calculator, ArrowUp } from "lucide-react";

interface Props {
  whatsappMsg?: string;
}
---

<section class="offscreen-defer py-12 md:py-18 bg-gradient-to-br from-[#0B57D0] via-[#0842A0] to-[#041E49] text-white relative overflow-hidden border-t border-[#0B57D0]/20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight leading-tight mb-3 font-heading text-white">
      Ready for a Smooth &amp; Reliable Journey?
    </h2>

    <p class="text-xs sm:text-sm md:text-base text-white/90 max-w-2xl mx-auto font-normal leading-relaxed mb-8 font-sans">
      Head back up to our instant booking engine to check live fares, compare AC vehicles, and confirm your ride with 100% transparent pricing.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        href="#booking-panel"
        class="min-h-[48px] inline-flex items-center justify-center gap-2 px-7 sm:px-9 rounded-m3-full bg-white hover:bg-[#F0F4F9] active:bg-[#E8F0FE] !text-[#0B57D0] hover:!text-[#0842A0] text-sm sm:text-base font-extrabold shadow-m3-2 hover:shadow-m3-3 transition-all cursor-pointer border border-white/40 group active:scale-[0.98]"
        aria-label="Calculate Fare and Book at the Top Booking Engine"
      >
        <Calculator className="w-4 h-4 text-[#0B57D0] shrink-0" />
        <span>Calculate Fare &amp; Book</span>
        <ArrowUp className="w-4 h-4 text-[#0B57D0] group-hover:-translate-y-0.5 transition-transform shrink-0" />
      </a>
    </div>
  </div>
</section>
