---
import siteContent from '../data/siteContent.json';
const reviews = siteContent.reviews.slice(0, 5);
---

<section id="reviews" class="py-10 md:py-16 bg-m3-surface-container-low">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-3.5 tracking-wide">
        <span class="material-symbols-outlined text-[16px] text-[#4285F4]">location_on</span>
        <span class="font-bold text-m3-on-surface">Google Verified Reviews</span>
        <span class="text-m3-on-surface-variant">•</span>
        <span class="text-amber-500 font-bold">4.9/5 Rating</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
        Customer <span class="text-m3-primary">Experiences</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant font-normal max-w-2xl mx-auto leading-relaxed mb-6 font-sans">
        Hear from our happy customers about their journey with us.
      </p>
    </div>

    <!-- Reviews Scroll -->
    <div class="flex overflow-x-auto gap-4 pb-6 scrollbar-hide snap-x">
      {reviews.map((review) => (
        <div class="flex-none w-64 sm:w-80 bg-m3-surface p-6 rounded-m3-xl shadow-m3-1 border border-m3-outline-variant snap-center flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-m3-surface-container-high rounded-m3-full flex items-center justify-center text-m3-primary text-xs font-bold shadow-m3-1 border border-m3-outline-variant">
                  {review.name.charAt(0)}
                </div>
                <div>
                  <span class="block text-sm font-bold text-m3-on-surface leading-none font-heading">{review.name}</span>
                  <div class="flex text-amber-400 text-micro mt-1">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                  </div>
                </div>
              </div>
              <div class="text-m3-primary opacity-30">
                <i class="fab fa-google text-xl"></i>
              </div>
            </div>
            <p class="text-sm text-m3-on-surface-variant italic leading-relaxed font-sans">"{review.quote}"</p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-6">
      <a href="https://maps.app.goo.gl/i2LdJhWMi2ZgAiCa8" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-m3-primary font-bold text-sm hover:underline transition group">
        <span class="material-symbols-outlined text-[16px] text-[#4285F4]">location_on</span>
        <span>See More Reviews on Google Maps</span>
        <span class="material-symbols-outlined text-[16px] text-emerald-500 transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
