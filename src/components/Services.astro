---
import OptimizedImage from './OptimizedImage.astro';
import siteContent from '../data/siteContent.json';
import { ArrowRight } from 'lucide-react';
const services = siteContent.services;
---

<section id="services" class="offscreen-defer py-10 md:py-14 bg-m3-surface-container-low border-t border-m3-outline-variant/60 scroll-mt-24 sm:scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
        Cab &amp; Driver Services in Chennai
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant font-normal max-w-2xl mx-auto leading-relaxed mb-6 font-sans">
        Airport taxi transfers, per-km outstation cabs, all-inclusive temple packages, corporate mobility, and acting drivers for your own car.
      </p>
    </div>

    <!-- Elevated Service Cards Grid (2-Column Grid on Mobile, max 4 cards) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 mb-8">
      {services.slice(0, 4).map((service) => (
        <a
          href={`${service.link.endsWith('/') ? service.link : `${service.link}/`}`}
          title={`Explore ${service.title} in Chennai`}
          class="group relative h-48 sm:h-56 lg:h-64 rounded-m3-xl overflow-hidden shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant cursor-pointer block transform hover:-translate-y-1 transition-all duration-300 bg-[#041E49] flex flex-col justify-end"
        >
          <!-- Background Image with Zoom on Hover -->
          <OptimizedImage
            src={service.image}
            alt={`Kalidass Travels - ${service.title}`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90"
            sizes="(max-width: 640px) 200px, (max-width: 1024px) 300px, 300px"
          />

          <!-- High-Contrast Sapphire Scrim Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#041E49] via-[#041E49]/75 to-transparent opacity-95 transition-opacity group-hover:opacity-100"></div>

          <!-- Card Content Layer -->
          <div class="relative p-3 sm:p-4 z-10 flex flex-col justify-end">
            <h3 class="text-sm sm:text-base lg:text-lg font-bold text-white mb-1 leading-snug tracking-tight group-hover:text-white transition-colors font-heading">
              {service.title}
            </h3>
            
            <!-- Subtext is always visible across all device sizes -->
            <p class="text-white/90 text-xs sm:text-sm line-clamp-2 mb-2 sm:mb-2.5 font-normal leading-relaxed drop-shadow-sm">
              {service.description}
            </p>
            
            <!-- Action Button (Proportionate compact chip) -->
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/20 group-hover:!bg-[#0B57D0] text-white text-xs font-semibold tracking-normal shadow-sm transition-all w-fit border border-white/20 whitespace-nowrap">
              <span>Explore</span>
              <ArrowRight className="w-3.5 h-3.5 text-white transform group-hover:translate-x-1 transition-transform" />
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- View All Services CTA Button -->
    <div class="text-center">
      <a
        href="/services/"
        class="inline-flex items-center gap-2.5 px-6 py-3 bg-white hover:bg-m3-surface-container-high border border-[#0B57D0]/40 text-[#0B57D0] hover:text-[#0842A0] text-xs sm:text-sm font-bold rounded-m3-full shadow-m3-1 hover:shadow-m3-2 transition-all group min-h-[44px]"
      >
        <span>View All Services</span>
        <ArrowRight className="w-4 h-4 text-[#0B57D0] group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>
</section>
