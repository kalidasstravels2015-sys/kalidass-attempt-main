---
import OptimizedImage from './OptimizedImage.astro';
import siteContent from '../data/siteContent.json';
const services = siteContent.services;
---

<section id="services" class="py-10 md:py-14 bg-m3-surface-container-low border-t border-m3-outline-variant/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
        Our Premium <span class="text-m3-primary">Travel Services</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant font-normal max-w-2xl mx-auto leading-relaxed mb-6 font-sans">
        Chennai airport transfers, outstation cabs, temple tours, corporate mobility, and acting driver solutions across South India.
      </p>
    </div>

    <!-- Elevated Service Cards Grid (2-Column Grid on Mobile, max 4 cards) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 mb-8">
      {services.slice(0, 4).map((service) => (
        <a
          href={`${service.link.endsWith('/') ? service.link : `${service.link}/`}`}
          title={`Explore ${service.title} in Chennai`}
          class="group relative h-48 sm:h-56 lg:h-64 rounded-m3-xl overflow-hidden shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant cursor-pointer block transform hover:-translate-y-1 transition-all duration-300 bg-slate-950 flex flex-col justify-end"
        >
          <!-- Background Image with Zoom on Hover -->
          <OptimizedImage
            src={service.image}
            alt={`Kalidass Travels - ${service.title}`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90"
            sizes="(max-width: 640px) 50vw, (max-width: 1024px) 50vw, 25vw"
          />

          <!-- High-Contrast Scrim Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent opacity-95 transition-opacity group-hover:opacity-100"></div>

          <!-- Card Content Layer -->
          <div class="relative p-3 sm:p-4 z-10 flex flex-col justify-end">
            <h3 class="text-sm sm:text-base lg:text-lg font-bold text-white mb-1 leading-snug tracking-tight group-hover:text-white transition-colors font-heading">
              {service.title}
            </h3>
            
            <!-- Subtext is always visible across all device sizes -->
            <p class="text-slate-300 text-[11px] sm:text-xs lg:text-sm line-clamp-2 mb-2 sm:mb-2.5 font-normal leading-relaxed drop-shadow-sm">
              {service.description}
            </p>
            
            <!-- Action Button (Proportionate compact chip) -->
            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 sm:py-1 rounded-full bg-white/15 group-hover:bg-m3-primary text-white text-[11px] sm:text-xs font-medium tracking-normal shadow-sm transition-all w-fit border border-white/20 whitespace-nowrap">
              <span>Explore</span>
              <span class="material-symbols-outlined text-[12px] sm:text-[14px] text-emerald-400 transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- View All Services CTA Button -->
    <div class="text-center">
      <a
        href="/services/"
        class="inline-flex items-center gap-2.5 px-6 py-3 bg-m3-surface hover:bg-m3-surface-container-high border border-m3-outline text-m3-on-surface hover:text-m3-primary text-xs sm:text-sm font-bold rounded-m3-full shadow-m3-1 hover:shadow-m3-2 transition-all group"
      >
        <span>View All Services (Including Acting Drivers & Packages)</span>
        <span class="material-symbols-outlined text-[18px] text-m3-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
