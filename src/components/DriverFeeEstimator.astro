---
import { MapPin, Navigation, Calendar, Bed, Info, Calculator, ArrowRight, Check, ChevronDown, User, Car } from 'lucide-react';
import tnBusFares from '../data/tnBusFares.json';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Acting Driver Cost",
  subtitle = "Calculate Bata & Stay"
} = Astro.props;
---

<div class="w-full bg-m3-surface rounded-m3-xl shadow-m3-2 border border-m3-outline-variant overflow-hidden max-w-md mx-auto font-sans">

  <!-- Header -->
  <div class="p-6 pb-2">
    <div class="flex flex-col items-center text-center gap-2 mb-1">
      <div class="w-12 h-12 rounded-m3-full bg-m3-primary-container flex items-center justify-center text-m3-primary shadow-xs">
        <User className="w-6 h-6 text-m3-primary" />
      </div>
      <div>
        <h3 class="text-xl font-bold text-m3-on-surface font-heading">{title}</h3>
        <p class="text-xs text-m3-on-surface-variant font-normal">{subtitle}</p>
      </div>
    </div>
  </div>

  <!-- Tabs (M3 Segmented Button) -->
  <div class="px-6 mb-6">
    <div class="bg-m3-surface-container-high p-1 rounded-m3-full flex border border-m3-outline-variant">
      <button id="tab-oneway" class="flex-1 py-2 text-xs sm:text-sm font-semibold rounded-m3-full text-m3-on-surface-variant hover:text-m3-on-surface transition-all cursor-pointer">
        One Way Drop
      </button>
      <button id="tab-round" class="flex-1 py-2 text-xs sm:text-sm font-semibold rounded-m3-full bg-m3-primary text-m3-on-primary shadow-m3-1 transition-all cursor-pointer">
        Round Trip
      </button>
    </div>
  </div>

  <div class="px-6 pb-8 space-y-5">

    <!-- Inputs -->
    <div class="space-y-4">

      <!-- Vehicle Class Selector -->
      <div>
        <label class="block text-badge font-bold text-m3-on-surface-variant uppercase mb-1.5">Vehicle Type</label>
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <Car className="w-4 h-4 text-m3-on-surface-variant group-focus-within:text-m3-primary transition-colors" />
          </div>
          <select
            id="vehicle-type"
            class="w-full pl-10 pr-10 py-3 bg-m3-surface border border-m3-outline rounded-m3-md focus:border-m3-primary focus:ring-2 focus:ring-m3-primary outline-none text-m3-on-surface text-sm font-medium transition-all appearance-none cursor-pointer"
          >
            <option value="600" data-name="Hatchback & Sedan">Hatchback & Sedan (Dzire, Etios, City) — ₹600/day</option>
            <option value="700" data-name="Compact SUV / MPV">Compact SUV / MPV (Ertiga, Creta, Carens) — ₹700/day</option>
            <option value="800" data-name="Premium SUV / MUV">Premium SUV (Innova Crysta, Fortuner) — ₹800/day</option>
            <option value="1000" data-name="Luxury European">Luxury European (BMW, Mercedes, Audi) — ₹1,000/day</option>
          </select>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-m3-on-surface-variant">
            <ChevronDown className="w-4 h-4" />
          </div>
        </div>
      </div>

      <!-- Pickup -->
      <div>
        <label class="block text-badge font-bold text-m3-on-surface-variant uppercase mb-1.5">Pickup Location</label>
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <MapPin className="w-4 h-4 text-m3-on-surface-variant group-focus-within:text-m3-primary transition-colors" />
          </div>
          <input
            type="text"
            id="simple-pickup"
            placeholder="e.g. Pallavaram, Chennai"
            autocomplete="off"
            class="w-full pl-10 pr-4 py-3 bg-m3-surface border border-m3-outline rounded-m3-md focus:border-m3-primary focus:ring-2 focus:ring-m3-primary outline-none text-m3-on-surface text-sm font-medium transition-all"
          />
        </div>
      </div>

      <!-- Drop -->
      <div>
        <label class="block text-badge font-bold text-m3-on-surface-variant uppercase mb-1.5">Drop Location</label>
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <Navigation className="w-4 h-4 text-m3-on-surface-variant group-focus-within:text-m3-primary transition-colors" />
          </div>
          <input
            type="text"
            id="simple-drop"
            placeholder="e.g. Madurai"
            autocomplete="off"
            class="w-full pl-10 pr-4 py-3 bg-m3-surface border border-m3-outline rounded-m3-md focus:border-m3-primary focus:ring-2 focus:ring-m3-primary outline-none text-m3-on-surface text-sm font-medium transition-all"
          />
        </div>
      </div>

      <!-- Round Trip Specific Fields -->
      <div id="round-trip-fields" class="space-y-4 animate-in fade-in slide-in-from-top-2 duration-300">

        <!-- Duration -->
        <div>
          <label class="block text-badge font-bold text-m3-on-surface-variant uppercase mb-1.5">Total Duration (Days)</label>
          <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
              <Calendar className="w-4 h-4 text-m3-on-surface-variant group-focus-within:text-m3-primary transition-colors" />
            </div>
            <input
              type="number"
              id="duration-days"
              value="2"
              min="1"
              class="w-full pl-10 pr-4 py-3 bg-m3-surface border border-m3-outline rounded-m3-md focus:border-m3-primary focus:ring-2 focus:ring-m3-primary outline-none text-m3-on-surface text-sm font-medium transition-all"
            />
          </div>
        </div>

        <!-- Stay Checkbox -->
        <label class="flex items-start gap-3 p-3.5 border border-m3-outline-variant rounded-m3-md cursor-pointer hover:border-m3-primary/50 transition-colors bg-m3-surface-container-low">
          <div class="relative flex items-center mt-0.5">
            <input type="checkbox" id="stay-provided" class="peer h-5 w-5 cursor-pointer appearance-none rounded-m3-xs border border-m3-outline checked:border-m3-primary checked:bg-m3-primary focus-visible:ring-2 focus-visible:ring-m3-primary focus-visible:ring-offset-2 transition-all" />
            <Check className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 text-m3-on-primary opacity-0 peer-checked:opacity-100 pointer-events-none" />
          </div>
          <div>
            <span class="block text-sm font-semibold text-m3-on-surface">I will provide Driver Stay</span>
            <span class="block text-xs text-m3-on-surface-variant mt-0.5">Select if hotel provides driver dorm or accommodation.</span>
          </div>
        </label>

      </div>

    </div>

    <!-- Calculate Button (M3 Filled Button) -->
    <button id="calc-btn" class="w-full bg-m3-primary hover:bg-m3-primary/90 text-m3-on-primary font-bold py-3.5 rounded-m3-full transition-all flex items-center justify-center shadow-m3-2 hover:shadow-m3-3 active:scale-[0.98] cursor-pointer text-sm">
      <span>Calculate Cost</span> <ArrowRight className="w-4 h-4 ml-2 text-white" />
    </button>

    <!-- Results Section -->
    <div id="result-section" class="hidden pt-6 border-t border-m3-outline-variant/50">

      <div class="flex justify-between items-end mb-6">
        <div>
          <p class="text-micro font-bold text-m3-on-surface-variant uppercase mb-1">Estimated Total</p>
          <p class="text-3xl sm:text-4xl font-extrabold text-m3-on-surface tracking-tight font-heading" id="total-price">₹0</p>
        </div>
        <div class="text-right">
          <p class="text-sm font-bold text-m3-on-surface font-heading" id="distance-display">0 km</p>
          <p class="text-xs text-m3-on-surface-variant" id="duration-display">0 hrs Driving</p>
        </div>
      </div>

      <div class="space-y-2.5 text-sm" id="breakdown-list">
        <!-- Dynamic Content -->
      </div>

      <div class="mt-5 p-3.5 bg-m3-surface-container-low border border-m3-outline-variant rounded-m3-md flex gap-2.5">
        <Info className="w-4 h-4 text-m3-primary shrink-0 mt-0.5" />
        <p class="text-xs text-m3-on-surface-variant leading-relaxed font-sans">
          Rate is per calendar day. Providing driver accommodation saves you <span class="font-bold text-m3-on-surface">₹300/night!</span>
        </p>
      </div>

      <!-- Instant WhatsApp Booking Action -->
      <a
        id="driver-calc-whatsapp-btn"
        href="#"
        target="_blank"
        rel="noopener noreferrer nofollow"
        aria-label="Book Driver with This Estimate on WhatsApp"
        class="mt-4 w-full bg-emerald-50 hover:bg-emerald-100 active:bg-emerald-200 text-emerald-950 border border-emerald-300/80 font-bold py-2.5 px-4 rounded-m3-full transition-all flex items-center justify-center gap-2 shadow-xs text-sm cursor-pointer"
      >
        <WhatsAppIcon variant="brand" className="w-4 h-4 shrink-0" />
        <span>Book Driver with This Estimate</span>
      </a>

    </div>

  </div>
</div>

<script is:inline define:vars={{ tnBusFares }}>
  (function() {
    // --- STATE ---
    let activeTab = 'round'; // 'oneway' | 'round'

    // --- DOM ELEMENTS ---
    const tabOneway = document.getElementById('tab-oneway');
    const tabRound = document.getElementById('tab-round');
    const roundTripFields = document.getElementById('round-trip-fields');
    const durationInput = document.getElementById('duration-days');
    const stayCheckbox = document.getElementById('stay-provided');
    const vehicleSelect = document.getElementById('vehicle-type');
    const resultSection = document.getElementById('result-section');
    const pInput = document.getElementById('simple-pickup');
    const dInput = document.getElementById('simple-drop');
    const calcBtn = document.getElementById('calc-btn');

    // --- TAB LOGIC ---
    function switchTab(tab) {
      activeTab = tab;
      if (tab === 'oneway') {
        tabOneway?.classList.remove('text-m3-on-surface-variant');
        tabOneway?.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-m3-1');
        tabRound?.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-m3-1');
        tabRound?.classList.add('text-m3-on-surface-variant');
        roundTripFields?.classList.add('hidden');
      } else {
        tabRound?.classList.remove('text-m3-on-surface-variant');
        tabRound?.classList.add('bg-m3-primary', 'text-m3-on-primary', 'shadow-m3-1');
        tabOneway?.classList.remove('bg-m3-primary', 'text-m3-on-primary', 'shadow-m3-1');
        tabOneway?.classList.add('text-m3-on-surface-variant');
        roundTripFields?.classList.remove('hidden');
      }
      resultSection?.classList.add('hidden');
    }

    tabOneway?.addEventListener('click', () => switchTab('oneway'));
    tabRound?.addEventListener('click', () => switchTab('round'));

    // --- GOOGLE MAPS INIT ---
    let attempts = 0;
    const maxAttempts = 50;

    function initializeAutocomplete() {
      const pickup = document.getElementById('simple-pickup');
      const drop = document.getElementById('simple-drop');

      if (!pickup || !drop) return;
      if (pickup.dataset.googleAttached === "true") return;

      try {
        const options = {
          componentRestrictions: { country: "in" },
          fields: ["geometry", "name"],
          strictBounds: false,
        };
        new google.maps.places.Autocomplete(pickup, options);
        new google.maps.places.Autocomplete(drop, options);
        pickup.dataset.googleAttached = "true";
        drop.dataset.googleAttached = "true";
      } catch (e) {
        console.error("DriverFeeEstimator: Autocomplete failed", e);
      }
    }

    const triggerMaps = () => {
      import('../lib/googleMapsLoader').then(m => m.loadGoogleMaps().then(initializeAutocomplete));
    };
    pInput?.addEventListener('focus', triggerMaps, { once: true });
    dInput?.addEventListener('focus', triggerMaps, { once: true });
    window.addEventListener('google-maps-loaded', initializeAutocomplete);

    const intervalId = setInterval(() => {
      attempts++;
      if (window.google && window.google.maps && window.google.maps.places) {
        clearInterval(intervalId);
        initializeAutocomplete();
      } else if (attempts >= maxAttempts) {
        clearInterval(intervalId);
      }
    }, 200);

    // --- CALCULATION LOGIC ---
    if (calcBtn) {
      calcBtn.addEventListener('click', () => {
        const pickup = pInput ? pInput.value.trim() : '';
        const drop = dInput ? dInput.value.trim() : '';

        if (!pickup || !drop) {
          alert("Please enter both pickup and drop locations.");
          return;
        }

        const originalBtnText = calcBtn.innerHTML;
        calcBtn.innerHTML = 'Calculating...';
        calcBtn.disabled = true;

        // 1. LOCAL LOOKUP FIRST
        const p = pickup.toLowerCase();
        const d = drop.toLowerCase();

        const route = tnBusFares.find(r =>
          (p.includes(r.source) && d.includes(r.destination)) ||
          (p.includes(r.destination) && d.includes(r.source))
        );

        if (route) {
          setTimeout(() => {
            calcBtn.innerHTML = originalBtnText;
            calcBtn.disabled = false;

            const realDist = route.distanceKm;
            const durationText = Math.round(realDist / 50) + " hrs (Est)";
            const setcFare = route.setcFare;

            calculateAndShow(realDist, durationText, setcFare);
          }, 400);
          return;
        }

        // 2. FALLBACK TO DISTANCE MATRIX API
        if (window.google && window.google.maps) {
          const service = new google.maps.DistanceMatrixService();
          service.getDistanceMatrix(
            {
              origins: [pickup],
              destinations: [drop],
              travelMode: google.maps.TravelMode.DRIVING,
              unitSystem: google.maps.UnitSystem.METRIC,
            },
            (response, status) => {
              calcBtn.innerHTML = originalBtnText;
              calcBtn.disabled = false;

              if (status !== "OK") {
                alert("Error with distance service: " + status);
                return;
              }

              const result = response.rows[0].elements[0];
              if (result.status !== "OK") {
                alert("Could not calculate distance. Please check locations.");
                return;
              }

              const distanceInMeters = result.distance.value;
              const realDist = Math.round(distanceInMeters / 1000);
              const durationText = result.duration.text;
              const calculatedFare = Math.round(realDist * 1.2);

              calculateAndShow(realDist, durationText, calculatedFare);
            }
          );
        } else {
          calcBtn.innerHTML = originalBtnText;
          calcBtn.disabled = false;
          // Local fallback approximation if offline / no API
          const approxDist = 150;
          const approxDuration = "3.5 hrs (Est)";
          const approxFare = 250;
          calculateAndShow(approxDist, approxDuration, approxFare);
        }
      });

      function calculateAndShow(dist, duration, busFare) {
        const selectedOption = vehicleSelect ? vehicleSelect.options[vehicleSelect.selectedIndex] : null;
        const BATA_PER_DAY = parseInt(selectedOption?.value || "600", 10);
        const vehicleName = selectedOption?.getAttribute('data-name') || "Hatchback & Sedan";
        const FOOD_PER_DAY = 300; // 2 meals @ ₹150/meal
        const STAY_PER_NIGHT = 300; // Dormitory/room allowance

        let total = 0;
        let breakdownHTML = '';

        if (activeTab === 'oneway') {
          total = BATA_PER_DAY + FOOD_PER_DAY + busFare;

          breakdownHTML = `
            <div class="flex justify-between py-2 border-b border-m3-outline-variant/40">
              <span class="text-m3-on-surface-variant">Vehicle Class</span>
              <span class="font-bold text-m3-on-surface">${vehicleName}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-m3-outline-variant/40">
              <span class="text-m3-on-surface-variant">Driver Bata (1 Day Duty)</span>
              <span class="font-bold text-m3-on-surface">₹${BATA_PER_DAY}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-m3-outline-variant/40">
              <span class="text-m3-on-surface-variant">Food Allowance</span>
              <span class="font-bold text-m3-on-surface">₹${FOOD_PER_DAY}</span>
            </div>
            <div class="flex justify-between py-2">
              <span class="text-m3-on-surface-variant">Return Bus Ticket (SETC/Actuals)</span>
              <span class="font-bold text-m3-on-surface">₹${busFare}</span>
            </div>
          `;
        } else {
          let days = parseInt(durationInput?.value || "1", 10) || 1;
          const totalRoundTripDist = dist * 2;
          if (totalRoundTripDist > 250 && days < 2) {
            days = 2;
            if (durationInput) durationInput.value = "2";
          }

          const nights = Math.max(0, days - 1);
          const provideStay = stayCheckbox?.checked || false;

          const totalBata = BATA_PER_DAY * days;
          const totalFood = FOOD_PER_DAY * days;
          const totalStay = provideStay ? 0 : (STAY_PER_NIGHT * nights);

          total = totalBata + totalFood + totalStay;

          breakdownHTML = `
            <div class="flex justify-between py-2 border-b border-m3-outline-variant/40">
              <span class="text-m3-on-surface-variant">Vehicle Class</span>
              <span class="font-bold text-m3-on-surface">${vehicleName}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-m3-outline-variant/40">
              <span class="text-m3-on-surface-variant">Driver Bata (${days} Days @ ₹${BATA_PER_DAY}/day)</span>
              <span class="font-bold text-m3-on-surface">₹${totalBata}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-m3-outline-variant/40">
              <span class="text-m3-on-surface-variant">Food Allowance (${days} Days)</span>
              <span class="font-bold text-m3-on-surface">₹${totalFood}</span>
            </div>
            ${nights > 0 ? `
            <div class="flex justify-between py-2 ${provideStay ? 'text-m3-on-surface-variant line-through opacity-70' : ''}">
              <span class="text-m3-on-surface-variant">Night Stay (${nights} Nights)</span>
              <span class="font-bold text-m3-on-surface">${provideStay ? 'Provided by You (₹0)' : '₹' + totalStay}</span>
            </div>
            ` : ''}
          `;
        }

        const displayDist = activeTab === 'round' ? dist * 2 : dist;
        const totalPriceEl = document.getElementById('total-price');
        const distEl = document.getElementById('distance-display');
        const durEl = document.getElementById('duration-display');
        const breakdownEl = document.getElementById('breakdown-list');

        if (totalPriceEl) totalPriceEl.innerText = `₹${total.toLocaleString('en-IN')}`;
        if (distEl) distEl.innerText = `${displayDist} km`;
        if (durEl) durEl.innerText = duration;
        if (breakdownEl) breakdownEl.innerHTML = breakdownHTML;

        // WhatsApp booking link update
        const pickupVal = pInput ? pInput.value.trim() : '';
        const dropVal = dInput ? dInput.value.trim() : '';
        const tripType = activeTab === 'round' ? 'Round Trip' : 'One Way Drop';
        const daysLabel = activeTab === 'round' ? `${parseInt(durationInput?.value || "1", 10) || 1} Days` : '1 Day Drop';
        const stayStatus = activeTab === 'round' ? (stayCheckbox?.checked ? 'Stay Provided by Customer' : 'Driver Stay Allowance Included') : 'Driver Returns via Bus';

        const whatsappText = `Hi Kalidass Travels, I calculated an Outstation Acting Driver estimate:
• Service: Outstation Acting Driver (${tripType})
• Vehicle: ${vehicleName}
• Route: ${pickupVal} to ${dropVal} (~${displayDist} km)
• Duration: ${daysLabel}
• Accommodation: ${stayStatus}
• Estimated Total: ₹${total}
Please confirm driver availability.`;

        const whatsappBtn = document.getElementById('driver-calc-whatsapp-btn');
        if (whatsappBtn) {
          whatsappBtn.href = `https://wa.me/916381939769?text=${encodeURIComponent(whatsappText)}`;
        }

        resultSection?.classList.remove('hidden');
      }
    }
  })();
</script>
