---
import { ChevronDown } from "lucide-react";

interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  columns?: 1 | 2;
  name?: string;
  className?: string;
}

const { items, columns = 1, name, className = "" } = Astro.props;
---

<div class={`font-sans ${columns === 2 ? 'grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 items-start' : 'space-y-3'} ${className}`}>
  {items.map((item) => (
    <details
      class="group bg-m3-surface-container-lowest rounded-m3-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all overflow-hidden"
      name={name}
    >
      <summary class="flex items-center justify-between gap-3 px-4 py-3.5 sm:px-5 sm:py-4 cursor-pointer list-none select-none hover:bg-m3-surface-container-low transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-m3-primary focus-visible:ring-inset min-h-[48px]">
        <span class="font-heading font-bold text-sm sm:text-base text-m3-on-surface group-open:text-m3-primary transition-colors leading-snug">
          {item.q}
        </span>
        <ChevronDown className="w-5 h-5 text-slate-500 group-open:rotate-180 group-open:text-m3-primary transition-transform duration-200 shrink-0" />
      </summary>
      <div class="px-4 sm:px-5 pb-4 pt-3 border-t border-slate-200/60 bg-m3-surface-container-lowest">
        <p class="text-sm text-slate-700 font-normal leading-relaxed">
          {item.a}
        </p>
      </div>
    </details>
  ))}
</div>
