---
---

<section id="safety" class="py-10 md:py-14 bg-m3-surface border-t border-m3-outline-variant/60">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
        Travel Awareness &amp; <span class="text-m3-primary">Safety</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant font-normal max-w-2xl mx-auto leading-relaxed mb-6 font-sans">
        Verified guidelines, emergency numbers, and official government resources for a secure journey across Tamil Nadu.
      </p>
    </div>

    <!-- 2-Column Responsive Safety Grid (2 columns on mobile and desktop) -->
    <div class="grid grid-cols-2 gap-3 sm:gap-6 max-w-5xl mx-auto">
      
      <!-- Card 1: Travel Responsibility -->
      <div class="bg-m3-surface rounded-m3-xl p-3.5 sm:p-6 shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant transition-all duration-300 flex flex-col justify-between h-full">
        <div>
          <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-m3-md bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center mb-3 sm:mb-4 text-m3-primary">
            <span class="material-symbols-outlined text-[24px] sm:text-[28px]">task_alt</span>
          </div>
          <h3 class="text-sm sm:text-lg font-bold text-m3-on-surface mb-1 sm:mb-2 font-heading leading-snug">
            Travel Responsibility
          </h3>
          <p class="text-badge sm:text-sm text-m3-on-surface-variant leading-relaxed mb-4 line-clamp-3 sm:line-clamp-none">
            Cleanliness, punctuality, safety belts, and courteous conduct throughout your journey.
          </p>
        </div>
        <div class="pt-2">
          <button
            type="button"
            data-modal-target="responsibility-modal"
            class="w-full inline-flex items-center justify-center gap-1 bg-m3-primary hover:bg-slate-900 text-m3-on-primary px-2 sm:px-4 py-1.5 sm:py-2 rounded-m3-full font-semibold text-micro sm:text-xs shadow-m3-1 hover:shadow-m3-2 transition-all cursor-pointer whitespace-nowrap"
          >
            <span class="material-symbols-outlined text-[15px] text-white">checklist</span>
            <span>View Checklist</span>
          </button>
        </div>
      </div>

      <!-- Card 2: Official Govt Resources -->
      <div class="bg-m3-surface rounded-m3-xl p-3.5 sm:p-6 shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant transition-all duration-300 flex flex-col justify-between h-full">
        <div>
          <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-m3-md bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center mb-3 sm:mb-4 text-m3-primary">
            <span class="material-symbols-outlined text-[24px] sm:text-[28px]">account_balance</span>
          </div>
          <h3 class="text-sm sm:text-lg font-bold text-m3-on-surface mb-1 sm:mb-2 font-heading leading-snug">
            Official Portals
          </h3>
          <p class="text-badge sm:text-sm text-m3-on-surface-variant leading-relaxed mb-4 line-clamp-3 sm:line-clamp-none">
            Direct access to official Tamil Nadu Tourism, TTDC bookings, and temple timings.
          </p>
        </div>
        <div class="pt-2">
          <button
            type="button"
            data-modal-target="resources-modal"
            class="w-full inline-flex items-center justify-center gap-1 bg-m3-surface hover:bg-m3-surface-container-high text-m3-on-surface border border-m3-outline px-2 sm:px-4 py-1.5 sm:py-2 rounded-m3-full font-semibold text-micro sm:text-xs shadow-m3-1 transition-all cursor-pointer whitespace-nowrap"
          >
            <span class="material-symbols-outlined text-[15px] text-m3-on-surface-variant">open_in_new</span>
            <span>Official Portals</span>
          </button>
        </div>
      </div>

      <!-- Card 3: Kaaval Uthavi App (Dual Android & iOS Links) -->
      <div class="bg-m3-surface rounded-m3-xl p-3.5 sm:p-6 shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant transition-all duration-300 flex flex-col justify-between h-full">
        <div>
          <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-m3-md bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center mb-3 sm:mb-4 text-m3-primary">
            <span class="material-symbols-outlined text-[24px] sm:text-[28px]">shield</span>
          </div>
          <h3 class="text-sm sm:text-lg font-bold text-m3-on-surface mb-1 sm:mb-2 font-heading leading-snug">
            Kaaval Uthavi App
          </h3>
          <p class="text-badge sm:text-sm text-m3-on-surface-variant leading-relaxed mb-4 line-clamp-3 sm:line-clamp-none">
            Official TN Police mobile app for instant SOS alerts and police dispatch.
          </p>
        </div>
        <div class="pt-2 flex flex-col gap-1.5 sm:gap-2">
          <!-- Android Play Store -->
          <a
            href="https://play.google.com/store/apps/details?id=com.amtexsystems.kaavaluthavi&hl=en_IN&pli=1"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-1 bg-m3-surface-container-high hover:bg-m3-surface-container-highest text-m3-on-surface border border-m3-outline-variant py-1.5 sm:py-2 px-2 rounded-m3-full text-micro sm:text-xs font-bold transition-colors"
            title="Download Kaaval Uthavi for Android"
          >
            <svg class="w-3.5 h-3.5 text-m3-primary shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.38 2.38 0 01-.61-1.638V3.452c0-.623.23-1.2.61-1.638zm11.24 11.24l2.52 2.52-12.7 7.238 10.18-9.758zm2.52-2.52L4.669 3.006 17.37 10.24l-2.52 2.52.02-.226zm1.18 1.18l3.18-1.81a1.53 1.53 0 000-2.66l-3.18-1.81-1.87 1.87 1.87 1.87v.54z"/>
            </svg>
            <span>Play Store (Android)</span>
          </a>
          <!-- iOS App Store -->
          <a
            href="https://apps.apple.com/in/app/kaaval-uthavi/id1388361252"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-1 bg-m3-surface-container-highest hover:bg-m3-outline text-m3-on-surface py-1.5 sm:py-2 px-2 rounded-m3-full text-micro sm:text-xs font-bold transition-colors"
            title="Download Kaaval Uthavi for iOS"
          >
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.65-.82 1.1-1.97.97-3.12-1 .04-2.15.65-2.82 1.43-.58.67-1.1 1.76-.97 2.88 1.13.09 2.19-.57 2.82-1.19z"/>
            </svg>
            <span>App Store (iOS)</span>
          </a>
        </div>
      </div>

      <!-- Card 4: Emergency Helpline -->
      <div class="bg-m3-surface rounded-m3-xl p-3.5 sm:p-6 shadow-m3-1 hover:shadow-m3-3 border border-m3-outline-variant transition-all duration-300 flex flex-col justify-between h-full">
        <div>
          <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-m3-md bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center mb-3 sm:mb-4 text-m3-primary">
            <span class="material-symbols-outlined text-[24px] sm:text-[28px]">emergency</span>
          </div>
          <h3 class="text-sm sm:text-lg font-bold text-m3-on-surface mb-1 sm:mb-2 font-heading leading-snug">
            Emergency Helpline
          </h3>
          <div class="text-badge sm:text-sm text-m3-on-surface space-y-1 mb-4 font-normal">
            <p><strong>Police:</strong> 100 &bull; <strong>Ambulance:</strong> 108</p>
            <p><strong>National SOS:</strong> 112</p>
          </div>
        </div>
        <div class="pt-2">
          <a
            href="tel:112"
            class="w-full inline-flex items-center justify-center gap-1 bg-m3-primary hover:bg-slate-900 text-m3-on-primary px-2 sm:px-4 py-1.5 sm:py-2 rounded-m3-full font-semibold text-micro sm:text-xs shadow-m3-1 transition-all whitespace-nowrap"
          >
            <span class="material-symbols-outlined text-[15px]">call</span>
            <span>Call 112 SOS</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Modals -->
    
    <!-- Responsibility Modal -->
    <div id="responsibility-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="flex items-center justify-center min-h-screen p-4 text-center">
        <div class="fixed inset-0 bg-m3-scrim/60 backdrop-blur-sm transition-opacity" aria-hidden="true" data-modal-close="responsibility-modal"></div>
        <div class="inline-block bg-m3-surface rounded-m3-xl text-left overflow-hidden shadow-m3-4 transform transition-all my-8 max-w-lg w-full z-10 border border-m3-outline-variant">
          <div class="p-6">
            <div class="flex items-center gap-3 mb-4 pb-3 border-b border-m3-outline-variant/40">
              <div class="w-10 h-10 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-m3-on-surface font-heading" id="modal-title">
                Passenger Travel Checklist
              </h3>
            </div>
            <ul class="space-y-3 text-sm text-m3-on-surface-variant">
              <li class="flex items-start gap-2.5">
                <span class="text-m3-primary font-bold shrink-0">✓</span>
                <span><strong>Vehicle Cleanliness:</strong> Help us keep the cabin clean. Please avoid littering inside the car.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-m3-primary font-bold shrink-0">✓</span>
                <span><strong>No Smoking / Alcohol:</strong> Consumption is strictly prohibited inside all commercial vehicles.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-m3-primary font-bold shrink-0">✓</span>
                <span><strong>Punctuality:</strong> Adhere to scheduled pickup timings for timely arrival and smooth temple darshan.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-m3-primary font-bold shrink-0">✓</span>
                <span><strong>Safety Belts:</strong> Fasten seatbelts whenever the vehicle is in motion.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-m3-primary font-bold shrink-0">✓</span>
                <span><strong>Respectful Interaction:</strong> Our chauffeurs are police-verified professionals here to assist your travel.</span>
              </li>
            </ul>
          </div>
          <div class="bg-m3-surface-container-low px-6 py-4 border-t border-m3-outline-variant/40 flex justify-end">
            <button type="button" class="px-5 py-2.5 rounded-m3-full bg-m3-primary text-m3-on-primary font-bold text-xs hover:bg-slate-900 transition-colors shadow-m3-1" data-modal-close="responsibility-modal">
              I Understand
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Resources Modal -->
    <div id="resources-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="resources-modal-title" role="dialog" aria-modal="true">
      <div class="flex items-center justify-center min-h-screen p-4 text-center">
        <div class="fixed inset-0 bg-m3-scrim/60 backdrop-blur-sm transition-opacity" aria-hidden="true" data-modal-close="resources-modal"></div>
        <div class="inline-block bg-m3-surface rounded-m3-xl text-left overflow-hidden shadow-m3-4 transform transition-all my-8 max-w-lg w-full z-10 border border-m3-outline-variant">
          <div class="p-6">
            <div class="flex items-center gap-3 mb-4 pb-3 border-b border-m3-outline-variant/40">
              <div class="w-10 h-10 rounded-m3-md bg-m3-surface-container-high text-m3-primary flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-m3-on-surface font-heading" id="resources-modal-title">
                Official Government Travel Portals
              </h3>
            </div>
            <div class="grid gap-2.5">
              <a href="https://www.tamilnadutourism.tn.gov.in/" target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-m3-lg border border-m3-outline-variant hover:bg-m3-surface-container transition-colors">
                <div class="w-9 h-9 flex items-center justify-center bg-m3-surface-container-high text-m3-on-surface rounded-m3-sm mr-3 font-bold text-xs">TN</div>
                <div>
                  <div class="font-bold text-m3-on-surface text-sm">Tamil Nadu Tourism</div>
                  <div class="text-xs text-m3-on-surface-variant">Official Government Tourism Website</div>
                </div>
                <svg class="w-4 h-4 ml-auto text-m3-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a href="https://tourism.gov.in/" target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-m3-lg border border-m3-outline-variant hover:bg-m3-surface-container transition-colors">
                <div class="w-9 h-9 flex items-center justify-center bg-m3-surface-container-high text-m3-on-surface rounded-m3-sm mr-3 font-bold text-xs">IN</div>
                <div>
                  <div class="font-bold text-m3-on-surface text-sm">Ministry of Tourism</div>
                  <div class="text-xs text-m3-on-surface-variant">Government of India</div>
                </div>
                <svg class="w-4 h-4 ml-auto text-m3-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a href="https://hrce.tn.gov.in/" target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-m3-lg border border-m3-outline-variant hover:bg-m3-surface-container transition-colors">
                <div class="w-9 h-9 flex items-center justify-center bg-m3-surface-container-high text-m3-on-surface rounded-m3-sm mr-3 font-bold text-xs">HRCE</div>
                <div>
                  <div class="font-bold text-m3-on-surface text-sm">HR &amp; CE Department</div>
                  <div class="text-xs text-m3-on-surface-variant">Official TN Temple Information &amp; Timings</div>
                </div>
                <svg class="w-4 h-4 ml-auto text-m3-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
          <div class="bg-m3-surface-container-low px-6 py-4 border-t border-m3-outline-variant/40 flex justify-end">
            <button type="button" class="px-5 py-2.5 rounded-m3-full bg-m3-surface border border-m3-outline text-m3-on-surface font-bold text-xs hover:bg-m3-surface-container-high transition-colors shadow-m3-1" data-modal-close="resources-modal">
              Close
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const openButtons = document.querySelectorAll('[data-modal-target]');
    const closeButtons = document.querySelectorAll('[data-modal-close]');

    openButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modalId = button.getAttribute('data-modal-target');
        if (modalId) {
          const modal = document.getElementById(modalId);
          if (modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }
      });
    });

    closeButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modalId = button.getAttribute('data-modal-close');
        if (modalId) {
          const modal = document.getElementById(modalId);
          if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }
      });
    });
  });
</script>
