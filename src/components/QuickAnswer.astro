---
// QuickAnswer.astro — High-authority AEO & AI Overview Snapshot Component
// Designed according to DESIGN_SYSTEM.md (M3 Luxe Ruby & Warm Amber)
import WhatsAppButton from './WhatsAppButton.astro';
import { CheckCircle2, Phone, Award, Route, Star, ExternalLink, ShieldCheck } from 'lucide-react';
---

<section
  id="quick-answer"
  class="relative py-12 md:py-16 bg-m3-surface-container-low border-t border-m3-outline-variant/60"
  aria-label="Overview and Credentials Summary"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main Card Container with subtle elevated border -->
    <div
      class="bg-m3-surface rounded-m3-xl p-6 sm:p-8 border border-m3-outline-variant shadow-m3-1"
    >
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <!-- Left: Quick Answer Text optimized for Google AI Overviews & Perplexity -->
        <div class="lg:max-w-3xl">
          <!-- Eyebrow Pill -->
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-3.5 tracking-wide"
          >
            <CheckCircle2 className="w-4 h-4 text-m3-primary shrink-0" />
            <span>AITP Certified Commercial Fleet · Serving Since 2019</span>
          </div>

          <h2
            class="text-xl sm:text-2xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading"
          >
            Quick Answer: <span class="text-m3-primary">Kalidass Travels at a Glance</span>
          </h2>

          <p
            class="text-xs sm:text-sm text-m3-on-surface-variant font-normal leading-relaxed mb-4"
          >
            <strong>Kalidass Travels</strong> is a licensed All-India Tourist Permit (AITP) outstation cab and fleet operator headquartered in Medavakkam, Chennai. Established in <strong>2019</strong> with <strong>7+ years of trusted service</strong> and <strong>25,000+ completed journeys</strong>, we specialize in <strong>Tempo Travellers (12–26 seats)</strong>, <strong>Force Urbania luxury recliners</strong>, <strong>Toyota Innova Crysta</strong>, and family sedans. We operate with 100% transparent per-km billing starting from <strong>₹14/km</strong> (Sedan) to <strong>₹24/km</strong> (Tempo Traveller), with fixed daily driver batta and zero hidden surge charges.
          </p>

          <!-- Micro Links for AI / Humans -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-m3-on-surface-variant">
            <span class="inline-flex items-center gap-1 font-medium text-m3-on-surface">
              <CheckCircle2 className="w-3.5 h-3.5 text-m3-primary shrink-0" />
              <span>Updated for 2026</span>
            </span>
            <span class="text-m3-outline">•</span>
            <a href="/tariff/" class="text-m3-on-surface-variant hover:text-m3-primary font-medium transition-colors underline decoration-dotted">
              View Tariff Card
            </a>
            <span class="text-m3-outline">•</span>
            <a href="/drivers/" class="text-m3-on-surface-variant hover:text-m3-primary font-medium transition-colors underline decoration-dotted">
              Driver PVC Verification
            </a>
            <span class="text-m3-outline">•</span>
            <a href="/llms.txt" class="text-m3-on-surface-variant hover:text-m3-on-surface font-medium transition-colors" title="Machine readable knowledge file">
              AI Index (llms.txt)
            </a>
          </div>
        </div>

        <!-- Right: Multi-Channel Instant Actions -->
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0 lg:min-w-[220px]">
          <!-- Instant Fare Calculator & Booking -->
          <a
            href="#booking-panel"
            class="inline-flex items-center justify-center min-h-[44px] gap-2 px-5 py-3 rounded-m3-full bg-m3-primary hover:bg-m3-primary/90 text-white font-bold text-xs sm:text-sm shadow-m3-1 transition-all active:scale-[0.98]"
            aria-label="Calculate instant fare & book cab online"
          >
            <span>Instant Fare Calculator</span>
            <span>→</span>
          </a>

          <!-- Direct Phone Call -->
          <a
            href="tel:+918939539211"
            class="inline-flex items-center justify-center min-h-[44px] gap-2 px-5 py-3 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-surface-container border border-m3-outline-variant text-m3-on-surface font-bold text-xs sm:text-sm shadow-m3-1 transition-all"
            aria-label="Call Kalidass Travels dispatch desk"
          >
            <Phone className="w-4 h-4 text-m3-primary shrink-0" />
            <span class="text-m3-label-l font-bold">Call +91 89395 39211</span>
          </a>
        </div>
      </div>

      <!-- Bottom: 4 Key Proof Pillars -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mt-6 pt-6 border-t border-m3-outline-variant/60"
      >
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <Award className="w-5 h-5 text-m3-primary shrink-0" />
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">7+ Years Service</div>
            <div class="text-xs text-m3-on-surface-variant">Since 2019</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <Route className="w-5 h-5 text-m3-primary shrink-0" />
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">25,000+ Trips</div>
            <div class="text-xs text-m3-on-surface-variant">South India Covered</div>
          </div>
        </div>

        <a
          href="https://maps.app.goo.gl/i2LdJhWMi2ZgAiCa8"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 group"
          title="View 4.7 Star Verified Google Reviews for Kalidass Travels"
        >
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0 group-hover:scale-105 transition-transform">
            <Star className="w-5 h-5 text-amber-500 fill-amber-500 shrink-0" />
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface flex items-center gap-1">
              <span>4.7★ Google Maps</span>
              <ExternalLink className="w-3.5 h-3.5 text-m3-outline opacity-0 group-hover:opacity-100 transition-opacity shrink-0" />
            </div>
            <div class="text-xs text-m3-on-surface-variant group-hover:underline">14 Verified Reviews</div>
          </div>
        </a>

        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <ShieldCheck className="w-5 h-5 text-m3-primary shrink-0" />
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">AITP Certified</div>
            <div class="text-xs text-m3-on-surface-variant">100% PVC Drivers</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
