---
// QuickAnswer.astro — High-authority AEO & AI Overview Snapshot Component
// Designed according to DESIGN_SYSTEM.md (M3 Luxe Ruby & Warm Amber)
import WhatsAppButton from './WhatsAppButton.astro';
---

<section
  id="quick-answer"
  class="relative py-12 md:py-16 bg-m3-surface-container-low border-t border-m3-outline-variant/60"
  aria-label="Overview and Credentials Summary"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main Card Container with subtle elevated border -->
    <div
      class="bg-m3-surface rounded-m3-xl p-6 sm:p-8 border border-m3-outline-variant shadow-m3-1"
    >
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <!-- Left: Quick Answer Text optimized for Google AI Overviews & Perplexity -->
        <div class="lg:max-w-3xl">
          <!-- Eyebrow Pill -->
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold shadow-m3-1 mb-3.5 tracking-wide"
          >
            <span class="w-2 h-2 rounded-full bg-logo-red animate-pulse"></span>
            <span>AITP Certified Commercial Fleet · Serving Since 2019</span>
          </div>

          <h2
            class="text-xl sm:text-2xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading"
          >
            Quick Answer: <span class="text-m3-primary">Kalidass Travels at a Glance</span>
          </h2>

          <p
            class="text-xs sm:text-sm text-m3-on-surface-variant font-normal leading-relaxed mb-4"
          >
            <strong>Kalidass Travels</strong> is a licensed All-India Tourist Permit (AITP) outstation cab and fleet operator headquartered in Medavakkam, Chennai. Established in <strong>2019</strong> with <strong>7+ years of trusted service</strong> and <strong>25,000+ completed journeys</strong>, we specialize in <strong>Tempo Travellers (12–26 seats)</strong>, <strong>Force Urbania luxury recliners</strong>, <strong>Toyota Innova Crysta</strong>, and family sedans. We operate with 100% transparent per-km billing starting from <strong>₹14/km</strong> (Sedan) to <strong>₹24/km</strong> (Tempo Traveller), with fixed daily driver batta and zero hidden surge charges.
          </p>

          <!-- Micro Links for AI / Humans -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-700">
            <span class="inline-flex items-center gap-1 font-medium text-slate-800">
              <span class="material-symbols-outlined text-[16px] text-m3-primary">verified</span>
              <span>Updated for 2026</span>
            </span>
            <span class="text-slate-400">•</span>
            <a href="/pricing" class="text-slate-700 hover:text-m3-primary font-medium transition-colors underline decoration-dotted">
              View Tariff Card
            </a>
            <span class="text-slate-400">•</span>
            <a href="/safety" class="text-slate-700 hover:text-m3-primary font-medium transition-colors underline decoration-dotted">
              Driver PVC Verification
            </a>
            <span class="text-slate-400">•</span>
            <a href="/llms.txt" class="text-slate-700 hover:text-slate-950 font-medium transition-colors" title="Machine readable knowledge file">
              AI Index (llms.txt)
            </a>
          </div>
        </div>

        <!-- Right: Multi-Channel Instant Actions -->
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0 lg:min-w-[220px]">
          <!-- WhatsApp Quick Quote -->
          <WhatsAppButton
            href="https://wa.me/916381939769?text=Hi%20Kalidass%20Travels%2C%20I%20would%20like%20a%20quick%20quote%20for%20a%20trip."
            size="md"
            fullWidth={true}
            text="WhatsApp Quick Quote"
            ariaLabel="Chat on WhatsApp for instant quote"
          />

          <!-- Direct Phone Call -->
          <a
            href="tel:+916381939769"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-m3-full bg-m3-surface-container-high hover:bg-m3-surface-container border border-m3-outline-variant text-m3-on-surface font-bold text-xs sm:text-sm shadow-m3-1 transition-all"
            aria-label="Call Kalidass Travels dispatch desk"
          >
            <span class="material-symbols-outlined text-[18px] text-m3-primary">call</span>
            <span class="text-m3-label-l font-bold">Call +91 63819 39769</span>
          </a>
        </div>
      </div>

      <!-- Bottom: 4 Key Proof Pillars -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mt-6 pt-6 border-t border-m3-outline-variant/60"
      >
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <span class="material-symbols-outlined text-[20px] text-m3-primary">military_tech</span>
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">7+ Years Service</div>
            <div class="text-[11px] text-m3-on-surface-variant">Since 2019</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <span class="material-symbols-outlined text-[20px] text-m3-primary">route</span>
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">25,000+ Trips</div>
            <div class="text-[11px] text-m3-on-surface-variant">South India Covered</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <span class="material-symbols-outlined text-[20px] text-gold-600">star</span>
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">4.9★ Rating</div>
            <div class="text-[11px] text-m3-on-surface-variant">1,500+ Family Reviews</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center shrink-0 shadow-m3-0">
            <span class="material-symbols-outlined text-[20px] text-m3-primary">verified_user</span>
          </div>
          <div>
            <div class="text-xs font-bold text-m3-on-surface">AITP Certified</div>
            <div class="text-[11px] text-m3-on-surface-variant">100% PVC Drivers</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
