---
import { Check } from "lucide-react";

interface Props {
  selected?: boolean;
  label: string;
  count?: string | number;
  href?: string;
  id?: string;
  class?: string;
  [key: string]: any;
}

const {
  selected = false,
  label,
  count,
  href,
  id,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const baseClasses =
  "relative inline-flex items-center justify-center min-h-[44px] px-3.5 gap-1.5 rounded-lg text-m3-label-m font-medium transition-all duration-200 select-none overflow-hidden border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-m3-primary";

const stateClasses = selected
  ? "bg-m3-secondary-container text-m3-on-secondary-container border-transparent shadow-xs"
  : "bg-m3-surface text-m3-on-surface-variant border-m3-outline-variant hover:bg-m3-surface-container-high";
---

<Tag
  href={href}
  id={id}
  class:list={[
    baseClasses,
    stateClasses,
    className,
  ]}
  aria-pressed={!href ? selected : undefined}
  {...rest}
>
  {selected && (
    <Check className="w-4 h-4 shrink-0" aria-hidden="true" />
  )}
  <span>{label}</span>
  {count !== undefined && (
    <span class="ml-1 text-xs font-semibold opacity-75">
      ({count})
    </span>
  )}
</Tag>
