---
import { WHATSAPP_CONFIG } from '../utils/whatsapp';

interface Props {
  phone?: string;
}

const {
  phone = WHATSAPP_CONFIG.phone
} = Astro.props;

const currentPath = Astro.url.pathname;
const isTempoPage = currentPath.includes('tempo');
const isActingDriver = currentPath.includes('acting-driver');

const defaultTitle = isTempoPage 
  ? "Need a Tempo Traveller Quote?" 
  : isActingDriver 
    ? "Need an Acting Driver for Your Car?" 
    : "Need Help Planning Your Route?";

const defaultSubtitle = isTempoPage
  ? "Connect directly with our fleet manager for 12, 17-Seater & Urbania rates with transparent billing."
  : isActingDriver
    ? "Hire a verified highway pilot from ₹1,400/day. Professional and punctual chauffeurs."
    : "Connect directly with our 24/7 Medavakkam dispatch desk for instant quotes and vehicle availability.";

const defaultWaText = isTempoPage
  ? "Hi Kalidass Travels, I need a Tempo Traveller quote. Please share vehicle availability."
  : isActingDriver
    ? "Hi Kalidass Travels, I need an Acting Driver for my personal car. Please share available drivers."
    : "Hi Kalidass Travels, I need an outstation cab quote. Please share vehicle availability.";

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(defaultWaText)}`;
---

<!-- Google Material Design 3 (M3) Dispatch & Booking Dialog -->
<div
  id="exit-intent-modal"
  class="fixed inset-0 z-[100] hidden items-end sm:items-center justify-center p-0 sm:p-4 bg-slate-950/40 backdrop-blur-xs opacity-0 transition-opacity duration-300 font-sans select-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
>
  <!-- M3 Dialog Container: Mobile Bottom Sheet (rounded-t-[28px]) & Desktop Centered Dialog (rounded-[28px]) -->
  <div
    id="exit-modal-card"
    class="w-full sm:max-w-md bg-white dark:bg-[#1E1F20] text-slate-900 dark:text-slate-100 rounded-t-[28px] sm:rounded-[28px] shadow-m3-3 border border-slate-200/70 dark:border-white/10 overflow-hidden transform translate-y-full sm:translate-y-4 sm:scale-95 transition-all duration-300 max-h-[90vh] flex flex-col"
  >
    <!-- Mobile M3 Drag Handle -->
    <div class="sm:hidden pt-3 pb-1 flex justify-center">
      <div class="w-8 h-1 rounded-full bg-slate-300 dark:bg-slate-700"></div>
    </div>

    <div class="p-6 sm:p-8 text-center relative">
      <!-- M3 Standard Icon Close Button -->
      <button
        type="button"
        id="exit-modal-close-btn"
        class="absolute top-4 right-4 w-9 h-9 rounded-full flex items-center justify-center text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 cursor-pointer"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- M3 24dp Leading Icon in Tonal Circle -->
      <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 flex items-center justify-center mx-auto mb-4 shadow-xs">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </div>

      <!-- M3 Headline Small -->
      <h3 id="exit-modal-title" class="text-xl sm:text-2xl font-semibold tracking-tight text-slate-900 dark:text-white mb-2">
        {defaultTitle}
      </h3>

      <!-- M3 Body Medium -->
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6 max-w-sm mx-auto">
        {defaultSubtitle}
      </p>

      <!-- M3 Actions: Filled Button (Call) + Tonal/Outlined Button (WhatsApp) -->
      <div class="flex flex-col gap-3">
        <!-- 1. M3 Filled Button: Direct Call -->
        <a
          href={`tel:+${phone}`}
          id="exit-modal-call-btn"
          class="h-12 w-full rounded-full bg-slate-900 hover:bg-slate-800 active:bg-black dark:bg-white dark:hover:bg-slate-100 dark:active:bg-slate-200 text-white dark:text-slate-900 font-medium text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-m3-1 hover:shadow-m3-2 active:shadow-m3-0 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Dispatch Desk: +91 89395 39211</span>
        </a>

        <!-- 2. M3 Tonal / Outlined Button: WhatsApp -->
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="exit-modal-wa-btn"
          class="h-12 w-full rounded-full border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-medium text-sm sm:text-base flex items-center justify-center gap-2.5 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.966.528 1.945.813 3.023.813 3.179 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-6.002-5.77zm3.364 8.204c-.14.394-.807.747-1.127.794-.32.047-.732.067-1.189-.08-.456-.148-1.044-.343-1.804-1.002-.958-.832-1.577-1.848-1.767-2.115-.19-.267-.406-.541-.406-.993 0-.452.235-.675.319-.76.084-.085.183-.106.244-.106.061 0 .122.001.176.004.056.003.131-.021.205.155.075.176.257.629.28.675.023.047.038.102.008.162-.03.06-.045.097-.09.149-.045.052-.095.116-.136.156-.045.044-.092.092-.04.181.052.09.231.381.496.617.342.304.63.399.72.444.09.045.143.038.196-.023.053-.061.228-.266.289-.357.061-.091.122-.076.205-.045.083.03 1.233.581 1.446.687.213.106.355.158.406.248.053.09.053.523-.087.917z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <!-- M3 Assist Chips: Key Service Guarantees -->
      <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          Transparent Per-KM
        </span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          No Hidden Charges
        </span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          Direct Fleet
        </span>
      </div>

      <!-- M3 Text Dismiss Button -->
      <button
        type="button"
        id="exit-modal-dismiss-link"
        class="mt-3 py-1.5 px-3 text-xs text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 transition-colors cursor-pointer rounded-full"
      >
        Continue browsing
      </button>
    </div>
  </div>
</div>

<script>
  function initExitIntentController() {
    const modal = document.getElementById('exit-intent-modal');
    const card = document.getElementById('exit-modal-card');
    const closeBtn = document.getElementById('exit-modal-close-btn');
    const dismissLink = document.getElementById('exit-modal-dismiss-link');
    if (!modal || !card) return;

    let isModalOpen = false;

    function showModal() {
      if (isModalOpen) return;
      if (sessionStorage.getItem('kt_exit_modal_shown')) return;

      sessionStorage.setItem('kt_exit_modal_shown', 'true');
      isModalOpen = true;

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        card.classList.remove('translate-y-full', 'sm:translate-y-4', 'sm:scale-95');
        card.classList.add('translate-y-0', 'sm:translate-y-0', 'sm:scale-100');
      });
    }

    function closeModal() {
      if (!isModalOpen) return;
      isModalOpen = false;

      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      card.classList.remove('translate-y-0', 'sm:translate-y-0', 'sm:scale-100');
      card.classList.add('translate-y-full', 'sm:translate-y-4', 'sm:scale-95');

      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    closeBtn?.addEventListener('click', closeModal);
    dismissLink?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Clean trigger: Desktop mouse-leave exit intent only (no invasive mobile back-button trap)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 8) {
        showModal();
      }
    });

    // Provide globally so any button can open the M3 Dispatch Helpline dialog explicitly
    (window as any).openDispatchHelplineModal = showModal;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExitIntentController);
  } else {
    initExitIntentController();
  }
  document.addEventListener('astro:page-load', initExitIntentController);
</script>
