---
import { WHATSAPP_CONFIG } from '../utils/whatsapp';

interface Props {
  phone?: string;
}

const {
  phone = WHATSAPP_CONFIG.phone
} = Astro.props;

const currentPath = Astro.url.pathname;
const isTempoPage = currentPath.includes('tempo');
const isActingDriver = currentPath.includes('acting-driver');

const defaultTitle = isTempoPage 
  ? "Wait! Need a Tempo Traveller in Chennai?" 
  : isActingDriver 
    ? "Wait! Need an Acting Driver for Your Car?" 
    : "Wait! Planning an Outstation Trip?";

const defaultSubtitle = isTempoPage
  ? "Speak directly with our fleet manager. Get locked rates for 12, 17-Seater & Urbania with zero middleman markup."
  : isActingDriver
    ? "Hire a verified highway pilot from ₹1,400/day. Don't stress in highway traffic."
    : "Speak directly with our 24/7 Chennai dispatch desk. Get confirmed pricing in 60 seconds.";

const defaultWaText = isTempoPage
  ? "Hi Kalidass Travels, I need a Tempo Traveller quote. Please share vehicle availability."
  : isActingDriver
    ? "Hi Kalidass Travels, I need an Acting Driver for my personal car. Please share available drivers."
    : "Hi Kalidass Travels, I need an outstation cab quote. Please share vehicle availability.";

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(defaultWaText)}`;
---

<!-- Exit Intent & Back-Button Intercept Modal -->
<div
  id="exit-intent-modal"
  class="fixed inset-0 z-[100] hidden items-end sm:items-center justify-center p-0 sm:p-4 bg-slate-950/70 backdrop-blur-xs opacity-0 transition-opacity duration-300 font-sans select-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
>
  <!-- Modal Card (Bottom Sheet on Mobile, Centered Modal on Desktop) -->
  <div
    id="exit-modal-card"
    class="w-full sm:max-w-md bg-white rounded-t-3xl sm:rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform translate-y-full sm:translate-y-4 sm:scale-95 transition-all duration-300 max-h-[92vh] flex flex-col"
  >
    <!-- Top Festive Accent Strip -->
    <div class="h-2 w-full bg-gradient-to-r from-amber-500 via-orange-500 to-emerald-500"></div>

    <div class="p-5 sm:p-6 text-center relative">
      <!-- Close Button -->
      <button
        type="button"
        id="exit-modal-close-btn"
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 p-2 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400"
        aria-label="Close dialog"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-extrabold uppercase tracking-wider mb-3">
        <span>⚡ Quick Booking Helpline</span>
      </div>

      <h3 id="exit-modal-title" class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-tight mb-2">
        {defaultTitle}
      </h3>

      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 px-1">
        {defaultSubtitle}
      </p>

      <!-- Two Big Primary Action Buttons -->
      <div class="flex flex-col gap-3">
        <!-- 1. Direct Call CTA -->
        <a
          href={`tel:+${phone}`}
          id="exit-modal-call-btn"
          class="flex items-center justify-center gap-2.5 w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-sm sm:text-base shadow-lg shadow-emerald-600/25 transition-all active:scale-[0.98]"
        >
          <svg class="w-5 h-5 text-white shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Dispatch Desk: +91 89395 39211</span>
        </a>

        <!-- 2. Direct WhatsApp CTA -->
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="exit-modal-wa-btn"
          class="flex items-center justify-center gap-2.5 w-full py-3.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 active:bg-slate-950 text-white font-bold text-sm sm:text-base shadow-md transition-all active:scale-[0.98]"
        >
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.966.528 1.945.813 3.023.813 3.179 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-6.002-5.77zm3.364 8.204c-.14.394-.807.747-1.127.794-.32.047-.732.067-1.189-.08-.456-.148-1.044-.343-1.804-1.002-.958-.832-1.577-1.848-1.767-2.115-.19-.267-.406-.541-.406-.993 0-.452.235-.675.319-.76.084-.085.183-.106.244-.106.061 0 .122.001.176.004.056.003.131-.021.205.155.075.176.257.629.28.675.023.047.038.102.008.162-.03.06-.045.097-.09.149-.045.052-.095.116-.136.156-.045.044-.092.092-.04.181.052.09.231.381.496.617.342.304.63.399.72.444.09.045.143.038.196-.023.053-.061.228-.266.289-.357.061-.091.122-.076.205-.045.083.03 1.233.581 1.446.687.213.106.355.158.406.248.053.09.053.523-.087.917z"/>
          </svg>
          <span>Chat on WhatsApp (Instant Reply)</span>
        </a>
      </div>

      <!-- Guarantees Row -->
      <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-around text-[11px] text-slate-500 font-medium">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Transparent Per-KM
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          No Hidden Charges
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Direct Medavakkam Fleet
        </span>
      </div>

      <!-- Continue browsing text link -->
      <button
        type="button"
        id="exit-modal-dismiss-link"
        class="mt-3 text-[11px] text-slate-400 hover:text-slate-600 underline cursor-pointer"
      >
        No thanks, continue browsing
      </button>
    </div>
  </div>
</div>

<script>
  function initExitIntentController() {
    const modal = document.getElementById('exit-intent-modal');
    const card = document.getElementById('exit-modal-card');
    const closeBtn = document.getElementById('exit-modal-close-btn');
    const dismissLink = document.getElementById('exit-modal-dismiss-link');
    if (!modal || !card) return;

    let isModalOpen = false;

    function showModal() {
      if (isModalOpen) return;
      if (sessionStorage.getItem('kt_exit_modal_shown')) return;

      sessionStorage.setItem('kt_exit_modal_shown', 'true');
      isModalOpen = true;

      modal.classList.remove('hidden');
      // allow display block before triggering opacity
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        card.classList.remove('translate-y-full', 'sm:translate-y-4', 'sm:scale-95');
        card.classList.add('translate-y-0', 'sm:translate-y-0', 'sm:scale-100');
      });
    }

    function closeModal() {
      if (!isModalOpen) return;
      isModalOpen = false;

      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      card.classList.remove('translate-y-0', 'sm:translate-y-0', 'sm:scale-100');
      card.classList.add('translate-y-full', 'sm:translate-y-4', 'sm:scale-95');

      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    closeBtn?.addEventListener('click', closeModal);
    dismissLink?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // 1. Mobile Back-Button Intercept
    // Push dummy history entry so the first Back press triggers popstate instead of leaving site
    if (window.history && window.history.pushState) {
      try {
        window.history.pushState({ ktExitGuard: true }, document.title, window.location.href);
        window.addEventListener('popstate', (e) => {
          if (!sessionStorage.getItem('kt_exit_modal_shown')) {
            showModal();
          }
        });
      } catch (err) {
        // silent fail on restricted environments
      }
    }

    // 2. Desktop Mouse-Leave Exit Intent
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 8) {
        showModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExitIntentController);
  } else {
    initExitIntentController();
  }
  document.addEventListener('astro:page-load', initExitIntentController);
</script>

