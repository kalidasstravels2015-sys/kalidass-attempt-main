---
import { ShieldCheck, Star, Users, CheckCircle2, ArrowRight, ExternalLink } from "lucide-react";

const reviews = [
  {
    name: "Dr. R. Venkataraman",
    role: "Tirupati Balaji Darshan",
    quote: "Very punctual and polite driver. Arranged everything smoothly for my family's temple visit with zero stress.",
    rating: 5,
  },
  {
    name: "Karthik Raja",
    role: "OMR Corporate Commute",
    quote: "Clean and sanitized Innova on time every day. Transparent per-km billing without hidden surprises.",
    rating: 5,
  },
  {
    name: "Meenakshi Sundaram",
    role: "Navagraha Temple Tour",
    quote: "Completed a 3-day Kumbakonam trip with senior citizens. Driver drove safely and knew all temple opening timings.",
    rating: 5,
  },
];
---

<section id="trust-strip" class="py-10 md:py-16 bg-m3-surface-container-low border-t border-m3-outline-variant/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-m3-full bg-m3-surface-container-high border border-m3-outline-variant text-m3-on-surface text-xs font-semibold tracking-wide mb-3.5 shadow-m3-1">
        <span class="w-2 h-2 rounded-full bg-m3-secondary"></span>
        <span>Trusted &amp; Verified</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
        Why 10,000+ Travelers <span class="text-m3-primary">Choose Us</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant font-normal max-w-2xl mx-auto leading-relaxed mb-6 font-sans">
        Reliable commercial-plate cabs, police-verified chauffeurs, and 100% transparent per-km billing.
      </p>
    </div>

    <!-- 4 Trust Badges Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-8">
      <a
        href="https://maps.app.goo.gl/i2LdJhWMi2ZgAiCa8"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-m3-surface hover:bg-m3-surface-container p-3.5 sm:p-4 rounded-m3-xl border border-m3-outline-variant shadow-m3-1 flex items-center gap-3 transition group cursor-pointer"
        title="View 5.0 Star Verified Google Reviews for Kalidass Travels"
      >
        <div class="w-10 h-10 rounded-m3-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center shrink-0 shadow-xs">
          <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </div>
        <div>
          <p class="text-base sm:text-lg font-extrabold text-m3-on-surface leading-none font-heading flex items-center gap-1">
            5.0 / 5.0
            <ExternalLink className="w-3.5 h-3.5 text-m3-on-surface-variant opacity-0 group-hover:opacity-100 transition-opacity" />
          </p>
          <p class="text-xs text-m3-on-surface-variant font-medium mt-0.5 group-hover:underline">12 Google Reviews</p>
        </div>
      </a>

      <div class="bg-m3-surface p-3.5 sm:p-4 rounded-m3-xl border border-m3-outline-variant shadow-m3-1 flex items-center gap-3">
        <div class="w-10 h-10 rounded-m3-lg bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center text-m3-primary shrink-0">
          <ShieldCheck className="w-5 h-5 text-m3-primary" />
        </div>
        <div>
          <p class="text-base sm:text-lg font-extrabold text-m3-on-surface leading-none font-heading">100% Verified</p>
          <p class="text-xs text-m3-on-surface-variant font-medium mt-0.5">Police Checked Drivers</p>
        </div>
      </div>

      <div class="bg-m3-surface p-3.5 sm:p-4 rounded-m3-xl border border-m3-outline-variant shadow-m3-1 flex items-center gap-3">
        <div class="w-10 h-10 rounded-m3-lg bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center text-m3-primary shrink-0">
          <CheckCircle2 className="w-5 h-5 text-m3-primary" />
        </div>
        <div>
          <p class="text-base sm:text-lg font-extrabold text-m3-on-surface leading-none font-heading">Zero Hidden Fees</p>
          <p class="text-xs text-m3-on-surface-variant font-medium mt-0.5">Pay Balance Post-Trip</p>
        </div>
      </div>

      <div class="bg-m3-surface p-3.5 sm:p-4 rounded-m3-xl border border-m3-outline-variant shadow-m3-1 flex items-center gap-3">
        <div class="w-10 h-10 rounded-m3-lg bg-m3-surface-container-high border border-m3-outline-variant flex items-center justify-center text-m3-primary shrink-0">
          <Users className="w-5 h-5 text-m3-primary" />
        </div>
        <div>
          <p class="text-base sm:text-lg font-extrabold text-m3-on-surface leading-none font-heading">24/7 Support</p>
          <p class="text-xs text-m3-on-surface-variant font-medium mt-0.5">Live GPS &amp; Helpline</p>
        </div>
      </div>
    </div>

    <!-- 3 Compact Testimonial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 mb-6">
      {reviews.map((rev) => (
        <div class="bg-m3-surface p-4 sm:p-5 rounded-m3-xl border border-m3-outline-variant shadow-m3-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 mb-2">
              {[...Array(rev.rating)].map(() => (
                <Star className="w-3.5 h-3.5 fill-m3-tertiary text-m3-tertiary" />
              ))}
            </div>
            <p class="text-xs sm:text-sm text-m3-on-surface-variant leading-relaxed italic mb-3 font-sans">"{rev.quote}"</p>
          </div>
          <div class="flex items-center justify-between border-t border-m3-outline-variant/60 pt-2.5">
            <div>
              <p class="text-xs font-bold text-m3-on-surface font-heading">{rev.name}</p>
              <p class="text-xs text-m3-on-surface-variant font-medium">{rev.role}</p>
            </div>
            <span class="text-xs font-bold text-m3-on-surface bg-m3-surface-container-high px-2 py-0.5 rounded-m3-full border border-m3-outline-variant">
              Verified Trip
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm">
      <a
        href="/drivers/"
        class="inline-flex items-center justify-center min-h-[44px] gap-1.5 text-m3-primary font-bold hover:underline py-2 px-3.5 rounded-m3-full hover:bg-m3-primary-container/30 transition-colors"
      >
        <span>Meet Our 12+ Professional Chauffeurs</span>
        <ArrowRight className="w-3.5 h-3.5 shrink-0" />
      </a>
      <span class="text-m3-outline hidden sm:inline">•</span>
      <a
        href="/#safety"
        class="inline-flex items-center justify-center min-h-[44px] gap-1.5 text-m3-on-surface-variant font-semibold hover:text-m3-on-surface py-2 px-3.5 rounded-m3-full hover:bg-m3-surface-container transition-colors"
      >
        <span>View Safety &amp; Government Guidelines</span>
        <ArrowRight className="w-3.5 h-3.5 shrink-0" />
      </a>
    </div>
  </div>
</section>
