---
import trips from '../data/trips.json';
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<div id="tariff-calculator" class="fixed inset-0 z-50 hidden">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="calculator-backdrop"></div>
  
  <!-- Modal -->
  <div class="relative flex items-center justify-center min-h-screen p-4">
    <div class="bg-m3-surface rounded-m3-xl shadow-m3-4 border border-m3-outline-variant max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <!-- Header -->
      <div class="bg-m3-surface-container-low text-m3-on-surface p-6 rounded-t-m3-xl border-b border-m3-outline-variant flex justify-between items-center">
        <div>
          <h3 class="text-xl font-bold font-heading" id="modal-title">Trip Calculator</h3>
          <p class="text-sm text-m3-on-surface-variant mt-1" id="modal-subtitle">Estimated pricing for your trip</p>
        </div>
        <button id="close-calculator" class="text-m3-on-surface-variant hover:text-m3-on-surface p-2 rounded-m3-full hover:bg-m3-surface-container transition cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="p-6 space-y-6">
        <!-- Trip Details -->
        <div class="bg-m3-surface-container-low rounded-m3-lg border border-m3-outline-variant/60 p-5">
          <h4 class="font-bold text-sm uppercase tracking-wider text-m3-on-surface mb-3 font-heading">Trip Details</h4>
          <div class="grid grid-cols-2 gap-4 text-xs sm:text-sm font-sans">
            <div>
              <span class="text-m3-on-surface-variant">One Way Distance</span>
              <p class="font-bold text-m3-on-surface" id="detail-oneway">-</p>
            </div>
            <div>
              <span class="text-m3-on-surface-variant">Total Distance</span>
              <p class="font-bold text-m3-on-surface" id="detail-total">-</p>
            </div>
            <div>
              <span class="text-m3-on-surface-variant">Duration</span>
              <p class="font-bold text-m3-on-surface" id="detail-duration">-</p>
            </div>
            <div>
              <span class="text-m3-on-surface-variant">Driver Bata</span>
              <p class="font-bold text-m3-on-surface" id="detail-bata">-</p>
            </div>
          </div>
        </div>

        <!-- Pricing Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Etios Card -->
          <div class="border border-m3-outline-variant bg-m3-surface rounded-m3-lg p-5 shadow-m3-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h4 class="font-bold text-base text-m3-on-surface font-heading">Toyota Etios</h4>
                <svg class="w-5 h-5 text-m3-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="space-y-1.5 text-xs text-m3-on-surface-variant mb-4 font-sans">
                <p>• Comfortable Sedan</p>
                <p>• 4 Passengers + Driver</p>
                <p>• Rate: ₹14/km</p>
              </div>
            </div>
            <div class="bg-m3-surface-container-low rounded-m3-md p-3 border border-m3-outline-variant/60">
              <p class="text-m3-on-surface-variant text-badge font-semibold mb-0.5">Estimated Cost</p>
              <p class="text-2xl font-black text-m3-on-surface font-heading" id="cost-etios">₹0</p>
            </div>
          </div>

          <!-- Innova Card -->
          <div class="border border-m3-outline-variant bg-m3-surface rounded-m3-lg p-5 shadow-m3-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h4 class="font-bold text-base text-m3-on-surface font-heading">Toyota Innova</h4>
                <svg class="w-5 h-5 text-m3-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="space-y-1.5 text-xs text-m3-on-surface-variant mb-4 font-sans">
                <p>• Premium SUV</p>
                <p>• 6-7 Passengers + Driver</p>
                <p>• Rate: ₹18/km</p>
              </div>
            </div>
            <div class="bg-m3-surface-container-low rounded-m3-md p-3 border border-m3-outline-variant/60">
              <p class="text-m3-on-surface-variant text-badge font-semibold mb-0.5">Estimated Cost</p>
              <p class="text-2xl font-black text-m3-on-surface font-heading" id="cost-innova">₹0</p>
            </div>
          </div>
        </div>

        <!-- Important Notes -->
        <div class="bg-m3-surface-container-low border border-m3-outline-variant rounded-m3-lg p-4 font-sans">
          <h4 class="font-bold text-xs uppercase tracking-wider text-m3-on-surface mb-2 flex items-center font-heading">
            <svg class="w-4 h-4 mr-1.5 text-m3-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Important Notes
          </h4>
          <ul class="text-xs text-m3-on-surface-variant space-y-1">
            <li>• Prices are indicative and may vary based on season and availability</li>
            <li>• Driver allowance (Bata) is included in the estimate</li>
            <li>• Toll charges and parking fees are additional</li>
            <li>• Final pricing will be confirmed via WhatsApp</li>
          </ul>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button 
            id="whatsapp-enquiry"
            class="flex-1 bg-[#25D366] hover:bg-[#20BD5A] active:bg-[#1EBE5D] text-white font-medium py-3.5 px-6 rounded-m3-full shadow-m3-1 hover:shadow-m3-2 active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2.5 text-sm cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2"
          >
            <WhatsAppIcon variant="two-tone" class="w-5 h-5 shrink-0" />
            <span>Confirm via WhatsApp</span>
          </button>
          <button 
            id="close-calculator-bottom"
            class="flex-1 bg-m3-surface-container hover:bg-m3-surface-container-high text-m3-on-surface font-semibold py-3.5 rounded-m3-full transition text-sm cursor-pointer"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ trips }}>
  let currentTrip = null;

  // Open calculator when custom event is fired
  document.addEventListener('open-calculator', (event) => {
    const tripData = event.detail;
    const tripId = parseInt(tripData.id);
    
    // Find the trip in JSON data
    currentTrip = trips.find(t => t.id === tripId);
    
    if (currentTrip) {
      // Calculate costs with min 250 km/day
      const totalKm = currentTrip.kmOneWay * 2;
      const durationDays = parseInt(currentTrip.duration) || 1;
      const minKm = durationDays * 250;
      const chargeableKm = Math.max(minKm, totalKm);
      const etiosBata = 300 * durationDays;
      const innovaBata = 500 * durationDays;
      const etiosCost = (chargeableKm * 14) + etiosBata;
      const innovaCost = (chargeableKm * 18) + innovaBata;
      
      // Update UI
      document.getElementById('modal-title').textContent = currentTrip.title;
      document.getElementById('modal-subtitle').textContent = `${currentTrip.type} Package - ${currentTrip.duration}`;
      document.getElementById('detail-oneway').textContent = `${currentTrip.kmOneWay} km`;
      document.getElementById('detail-total').textContent = `${totalKm} km (${chargeableKm} km min billed)`;
      document.getElementById('detail-duration').textContent = currentTrip.duration;
      document.getElementById('detail-bata').textContent = `₹${etiosBata}`;
      document.getElementById('cost-etios').textContent = `₹${etiosCost.toLocaleString('en-IN')}`;
      document.getElementById('cost-innova').textContent = `₹${innovaCost.toLocaleString('en-IN')}`;
      
      // Show modal
      document.getElementById('tariff-calculator').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });

  // Close calculator
  const closeCalculator = () => {
    document.getElementById('tariff-calculator').classList.add('hidden');
    document.body.style.overflow = '';
  };

  document.getElementById('close-calculator')?.addEventListener('click', closeCalculator);
  document.getElementById('close-calculator-bottom')?.addEventListener('click', closeCalculator);
  document.getElementById('calculator-backdrop')?.addEventListener('click', closeCalculator);

  // WhatsApp enquiry
  document.getElementById('whatsapp-enquiry')?.addEventListener('click', () => {
    if (currentTrip) {
      const totalKm = currentTrip.kmOneWay * 2;
      const durationDays = parseInt(currentTrip.duration) || 1;
      const minKm = durationDays * 250;
      const chargeableKm = Math.max(minKm, totalKm);
      const etiosCost = (chargeableKm * 14) + (300 * durationDays);
      const innovaCost = (chargeableKm * 18) + (500 * durationDays);
      const message = encodeURIComponent(
        `Hi! I'm interested in the ${currentTrip.title} package.\n\n` +
        `Estimated Costs:\n` +
        `Etios: ₹${etiosCost.toLocaleString('en-IN')}\n` +
        `Innova: ₹${innovaCost.toLocaleString('en-IN')}\n\n` +
        `Please confirm the final pricing and availability.`
      );
      window.open(`https://wa.me/919092303060?text=${message}`, '_blank');
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeCalculator();
    }
  });
</script>
