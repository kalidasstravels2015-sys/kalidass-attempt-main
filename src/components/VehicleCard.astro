---
import { Users, Luggage, ChevronRight, Car } from 'lucide-react';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  name: string;
  image?: string;
  badge?: string;
  seats?: string;
  baggage?: string;
  priceLabel?: string;
  priceSubtext?: string;
  price?: string;
  actionText?: string;
  actionHref?: string;
  actionClass?: string;
  secondaryActionText?: string;
  secondaryActionHref?: string;
  dataAttributes?: Record<string, string>;
  selectVehicleId?: string;
  selectPax?: number;
  className?: string;
  id?: string;
}

const {
  name,
  image,
  badge,
  seats = '4 Passengers',
  baggage = '2 Bags',
  priceLabel = 'Starting From',
  priceSubtext = 'Per-KM Rates',
  price,
  actionText = 'Select Car',
  actionHref,
  actionClass = '',
  secondaryActionText,
  secondaryActionHref,
  dataAttributes = {},
  selectVehicleId,
  selectPax,
  className = '',
  id,
} = Astro.props;

const isWhatsApp = Boolean(actionHref && actionHref.includes('wa.me'));
---

<div
  id={id}
  class={`bg-m3-surface-container-lowest rounded-m3-2xl border border-slate-200/80 shadow-ambient hover:shadow-ambient-hover hover:border-slate-300 transition-all flex flex-col justify-between overflow-hidden group select-none ${className}`}
>
  <div>
    <!-- 1. Vehicle Photo Showcase Container -->
    <div class="relative h-28 sm:h-32 bg-m3-surface-container-low flex items-center justify-center p-3 border-b border-slate-200/60">
      {badge && (
        <span class="absolute top-2.5 left-2.5 z-10 text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-m3-full bg-white/95 text-m3-on-surface border border-slate-200 shadow-xs">
          {badge}
        </span>
      )}

      {image ? (
        <img
          src={image}
          alt={`${name} taxi rental - Kalidass Travels`}
          width="160"
          height="80"
          loading="lazy"
          decoding="async"
          class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-xs"
        />
      ) : (
        <Car className="w-10 h-10 text-m3-on-surface-variant" />
      )}
    </div>

    <!-- 2. Card Content -->
    <div class="p-4 sm:p-5">
      <h3 class="text-sm sm:text-base font-bold text-m3-on-surface font-heading leading-tight truncate" title={name}>
        {name}
      </h3>

      <!-- 3. Clean Seats & Luggage Spec (Strict Single Line) -->
      <div class="flex items-center gap-2 text-xs text-slate-600 mt-2 font-medium whitespace-nowrap">
        <span class="inline-flex items-center gap-1.5 shrink-0">
          <Users className="w-4 h-4 text-slate-500 shrink-0" />
          <span>{seats}</span>
        </span>
        <span class="text-slate-300 shrink-0">•</span>
        <span class="inline-flex items-center gap-1.5 shrink-0">
          <Luggage className="w-4 h-4 text-slate-500 shrink-0" />
          <span>{baggage}</span>
        </span>
      </div>

      <!-- 4. Transparent Fare Display -->
      {price && (
        <div class="mt-3.5 pt-3 border-t border-slate-200/80 flex items-baseline justify-between">
          <div>
            <span class="block text-xs uppercase font-bold tracking-wider text-slate-500">
              {priceLabel}
            </span>
            <span class="text-xs font-semibold text-slate-600">{priceSubtext}</span>
          </div>
          <span class="text-base sm:text-lg font-extrabold text-m3-on-surface font-heading tabular-nums">
            {price}
          </span>
        </div>
      )}
    </div>
  </div>

  <!-- 5. Action Button & Secondary Tariff Link (44px Minimum Touch Target) -->
  <div class="p-4 sm:p-5 pt-0 space-y-2">
    {actionHref ? (
      <a
        href={actionHref}
        target={isWhatsApp ? "_blank" : undefined}
        rel={isWhatsApp ? "noopener noreferrer nofollow" : undefined}
        class={`w-full inline-flex items-center justify-center gap-2 py-2.5 sm:py-3 px-4 min-h-[44px] rounded-m3-full ${
          isWhatsApp 
            ? 'bg-[#25D366] hover:bg-[#20ba5a] active:bg-[#1da851] text-white shadow-xs hover:shadow-sm' 
            : 'bg-m3-primary hover:bg-[#0B57D0] active:bg-[#0842A0] text-white shadow-xs hover:shadow-sm'
        } text-xs sm:text-sm font-bold transition-all cursor-pointer active:scale-[0.98] group/btn ${actionClass}`}
        {...dataAttributes}
      >
        {isWhatsApp && <WhatsAppIcon variant="white" className="w-4 h-4" />}
        <span>{actionText}</span>
        {!isWhatsApp && <ChevronRight className="w-4 h-4 transform group-hover/btn:translate-x-0.5 transition-transform" />}
      </a>
    ) : (
      <button
        type="button"
        data-select-vehicle={selectVehicleId}
        data-select-pax={selectPax}
        class={`w-full inline-flex items-center justify-center gap-2 py-2.5 sm:py-3 px-4 min-h-[44px] rounded-m3-full bg-m3-primary hover:bg-[#0B57D0] active:bg-[#0842A0] text-white text-xs sm:text-sm font-bold transition-all cursor-pointer active:scale-[0.98] shadow-xs hover:shadow-sm group/btn ${actionClass}`}
        {...dataAttributes}
      >
        <span>{actionText}</span>
        <ChevronRight className="w-4 h-4 transform group-hover/btn:translate-x-0.5 transition-transform" />
      </button>
    )}

    {secondaryActionText && secondaryActionHref && (
      <div class="text-center pt-0.5">
        <a
          href={secondaryActionHref}
          class="text-xs font-semibold text-slate-600 hover:text-m3-primary transition-colors inline-flex items-center gap-1"
        >
          <span>{secondaryActionText}</span>
          <ChevronRight className="w-3.5 h-3.5" />
        </a>
      </div>
    )}
  </div>
</div>
