---
import { Users, Luggage, ChevronRight, Car } from 'lucide-react';

interface Props {
  name: string;
  image?: string;
  badge?: string;
  seats?: string;
  baggage?: string;
  priceLabel?: string;
  priceSubtext?: string;
  price?: string;
  actionText?: string;
  actionHref?: string;
  actionClass?: string;
  dataAttributes?: Record<string, string>;
  selectVehicleId?: string;
  selectPax?: number;
  className?: string;
  id?: string;
}

const {
  name,
  image,
  badge,
  seats = '4 Passengers',
  baggage = '2 Bags',
  priceLabel = 'Starting From',
  priceSubtext = 'Per-KM Rates',
  price,
  actionText = 'Select Car',
  actionHref,
  actionClass = '',
  dataAttributes = {},
  selectVehicleId,
  selectPax,
  className = '',
  id,
} = Astro.props;
---

<div
  id={id}
  class={`bg-white rounded-2xl border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between overflow-hidden group select-none ${className}`}
>
  <div>
    <!-- 1. Vehicle Photo Showcase Container -->
    <div class="relative h-28 sm:h-32 bg-slate-50 flex items-center justify-center p-3 border-b border-slate-100">
      {badge && (
        <span class="absolute top-2.5 left-2.5 z-10 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/95 text-slate-700 border border-slate-200 shadow-2xs">
          {badge}
        </span>
      )}

      {image ? (
        <img
          src={image}
          alt={`${name} taxi rental - Kalidass Travels`}
          width="160"
          height="80"
          loading="lazy"
          decoding="async"
          class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-xs"
        />
      ) : (
        <Car className="w-10 h-10 text-slate-400" />
      )}
    </div>

    <!-- 2. Card Content -->
    <div class="p-3.5 sm:p-4">
      <h3 class="text-sm sm:text-base font-bold text-slate-900 font-heading leading-tight truncate" title={name}>
        {name}
      </h3>

      <!-- 3. Clean Seats & Luggage Spec (Strict Single Line) -->
      <div class="flex items-center gap-2 text-xs text-slate-500 mt-1.5 font-medium whitespace-nowrap">
        <span class="inline-flex items-center gap-1 shrink-0">
          <Users className="w-3.5 h-3.5 text-slate-400 shrink-0" />
          <span>{seats}</span>
        </span>
        <span class="text-slate-300 shrink-0">•</span>
        <span class="inline-flex items-center gap-1 shrink-0">
          <Luggage className="w-3.5 h-3.5 text-slate-400 shrink-0" />
          <span>{baggage}</span>
        </span>
      </div>

      <!-- 4. Transparent Fare Display -->
      {price && (
        <div class="mt-3 pt-3 border-t border-slate-100 flex items-baseline justify-between">
          <div>
            <span class="block text-[10px] uppercase font-bold tracking-wider text-slate-400">
              {priceLabel}
            </span>
            <span class={`text-[11px] font-medium ${priceSubtext.toLowerCase().includes('extra') || priceSubtext.toLowerCase().includes('actual') ? 'text-amber-800' : 'text-emerald-700'}`}>{priceSubtext}</span>
          </div>
          <span class="text-base sm:text-lg font-extrabold text-slate-900 font-heading">
            {price}
          </span>
        </div>
      )}
    </div>
  </div>

  <!-- 5. Action Button -->
  <div class="p-3.5 sm:p-4 pt-0">
    {actionHref ? (
      <a
        href={actionHref}
        class={`w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-full bg-slate-900 hover:bg-m3-primary active:bg-black text-white text-xs font-bold transition-all cursor-pointer shadow-2xs group/btn ${actionClass}`}
        {...dataAttributes}
      >
        <span>{actionText}</span>
        <ChevronRight className="w-3.5 h-3.5 transform group-hover/btn:translate-x-0.5 transition-transform" />
      </a>
    ) : (
      <button
        type="button"
        data-select-vehicle={selectVehicleId}
        data-select-pax={selectPax}
        class={`w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-full bg-slate-900 hover:bg-m3-primary active:bg-black text-white text-xs font-bold transition-all cursor-pointer shadow-2xs group/btn ${actionClass}`}
        {...dataAttributes}
      >
        <span>{actionText}</span>
        <ChevronRight className="w-3.5 h-3.5 transform group-hover/btn:translate-x-0.5 transition-transform" />
      </button>
    )}
  </div>
</div>
