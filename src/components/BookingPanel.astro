---
import QuotationEngine from "./QuotationEngine.jsx";
const { lang = "en" } = Astro.props;
const isTa = lang === "ta";
---

<section
  id="booking-panel"
  class="relative z-20 py-4 sm:py-8 px-3 sm:px-6 max-w-3xl mx-auto scroll-mt-24 sm:scroll-mt-28"
>
  <!-- Accessible Semantic SEO Heading -->
  <h2 class="sr-only">Plan Your Journey & Calculate Fare - Instant Cab Estimator</h2>

  <!-- Interactive Quotation Engine Card -->
  <QuotationEngine client:visible currentLang={lang} showAirportTab={true} variant="card" />

  <!-- Trust Reassurance Footer Strip -->
  <div class="mt-3 flex flex-wrap items-center justify-center gap-2.5 sm:gap-6 text-m3-label-s sm:text-m3-label-m text-m3-on-surface-variant font-medium">
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[16px] text-m3-success shrink-0">verified</span>
      <span class="font-bold text-m3-on-surface">{isTa ? "பயண முடிவில் கட்டணம் செலுத்தலாம்" : "Pay Balance After Trip"}</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[16px] text-m3-outline shrink-0">chat</span>
      <span>{isTa ? "வாட்ஸ்அப் உறுதிப்படுத்தல்" : "Direct WhatsApp Confirmation"}</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[16px] text-m3-outline shrink-0">receipt_long</span>
      <span>{isTa ? "வெளிப்படையான கி.மீ கட்டணங்கள்" : "Transparent Per-KM Billing"}</span>
    </div>
  </div>
</section>
