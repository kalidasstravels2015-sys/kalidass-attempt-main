---
import QuotationEngine from "./QuotationEngine.jsx";
const { lang = "en" } = Astro.props;
---

<section
  id="booking-panel"
  class="relative z-30 -mt-12 sm:-mt-20 lg:-mt-24 px-3 sm:px-6 max-w-4xl mx-auto scroll-mt-20 sm:scroll-mt-28"
>
  <!-- Accessible Semantic SEO Heading -->
  <h2 class="sr-only">Plan Your Journey &amp; Calculate Fare - Instant Cab Estimator</h2>

  <!-- Interactive Quotation Engine Card -->
  <div id="fare-calculator" class="w-full flex-1 rounded-2xl sm:rounded-3xl shadow-2xl shadow-blue-950/20 border border-gray-200/90 dark:border-white/10 bg-white dark:bg-m3-surface-container p-3 sm:p-5">
    <QuotationEngine 
      client:load 
      currentLang={lang}
      allowedTabs={['round', 'local', 'airport']}
      variant="card" 
      showHeader={false}
    />
  </div>
</section>
