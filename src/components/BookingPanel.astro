---
import QuotationEngine from "./QuotationEngine.jsx";
const { lang = "en" } = Astro.props;
---

<section
  id="booking-panel"
  class="relative z-20 py-4 sm:py-8 px-3 sm:px-6 max-w-3xl mx-auto scroll-mt-20 sm:scroll-mt-24"
>
  <!-- Accessible Semantic SEO Heading -->
  <h2 class="sr-only">Plan Your Journey & Calculate Fare - Instant Cab Estimator</h2>

  <!-- Interactive Quotation Engine Card -->
  <QuotationEngine client:load currentLang={lang} showAirportTab={true} variant="card" />

  <!-- Trust Reassurance Footer Strip -->
  <div class="mt-3 flex flex-wrap items-center justify-center gap-2.5 sm:gap-6 text-m3-label-s sm:text-m3-label-m text-m3-on-surface-variant font-medium">
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[16px] text-m3-secondary shrink-0">check_circle</span>
      <span>Instant WhatsApp confirmation</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[16px] text-m3-secondary shrink-0">check_circle</span>
      <span>No hidden night charges</span>
    </div>
  </div>
</section>
