---
import BookingEngine from "./BookingEngine.jsx";
const { lang = "en" } = Astro.props;
---

<section
  id="booking-panel"
  class="relative z-30 -mt-14 sm:-mt-20 lg:-mt-24 px-3 sm:px-6 max-w-4xl mx-auto scroll-mt-20 sm:scroll-mt-28"
>
  <!-- Accessible Semantic SEO Heading -->
  <h2 class="sr-only">Plan Your Journey &amp; Calculate Fare - Instant Cab Estimator</h2>

  <!-- Interactive Unified Booking Engine Card -->
  <BookingEngine 
    client:idle 
    initialTab="outstation" 
    allowedTabs={['outstation', 'local', 'airport']} 
    variant="card" 
  />
</section>
