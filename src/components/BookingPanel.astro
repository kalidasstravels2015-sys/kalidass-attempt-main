---
import QuotationEngine from "./QuotationEngine.jsx";
const { lang = "en" } = Astro.props;
---

<section
  id="booking-panel"
  class="relative z-20 py-4 sm:py-8 px-3 sm:px-6 max-w-3xl mx-auto scroll-mt-24 sm:scroll-mt-28"
>
  <!-- Accessible Semantic SEO Heading -->
  <h2 class="sr-only">Plan Your Journey & Calculate Fare - Instant Cab Estimator</h2>

  <!-- Interactive Quotation Engine Card -->
  <QuotationEngine client:visible currentLang={lang} showAirportTab={true} variant="card" />
</section>
