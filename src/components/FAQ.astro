---
import FAQAccordion from "./FAQAccordion.astro";

const faqs = [
  {
    q: "Do you offer one-way drop taxi services from Chennai to other cities?",
    a: "Yes! We provide reliable one-way drop taxi services from Chennai to major destinations including Bangalore, Coimbatore, Trichy, Madurai, Salem, Pondicherry, and Vellore. You only pay for the one-way distance traveled without return charges."
  },
  {
    q: "How is the outstation taxi fare calculated? Are there hidden fees?",
    a: "Our pricing is 100% transparent with zero hidden charges. Outstation fares are calculated based on actual kilometers with a standard minimum of 250 km/day. Night driving charges and driver allowances are clearly mentioned before booking confirmation."
  },
  {
    q: "Are driver batta, toll charges, and interstate permit taxes included?",
    a: "Our package quotes include driver batta (daily allowance). Fastag highway toll fees, airport/temple parking charges, and interstate state entry permits (e.g., entering AP/Karnataka/Kerala) are paid directly as per actuals."
  },
  {
    q: "What vehicles are available for temple tour packages and family trips?",
    a: "We have a comprehensive fleet for all group sizes: Swift Dzire & Toyota Etios (up to 4 passengers), Innova & Innova Crysta (6-7 passengers), and Tempo Travellers (12 to 20 seats) equipped with carrier space and pushback seats."
  },
  {
    q: "Do you provide 24/7 airport pickup and drop at Chennai Airport (MAA)?",
    a: "Yes, we operate round-the-clock airport transfers for both Domestic and International terminals. Our driver tracks your flight status to adjust for delays, greeting you at the arrival pickup point."
  },
  {
    q: "Can I hire acting drivers / temporary chauffeurs for my own car?",
    a: "Yes, our certified Acting Driver service provides police-verified, experienced chauffeurs for manual and automatic cars within Chennai city, daily office commutes, night driving, or outstation family trips in your personal vehicle."
  },
  {
    q: "Is night travel safe with Kalidass Travels drivers?",
    a: "Passenger safety is our highest priority. All our drivers undergo police background verification, possess 5+ years of highway driving experience, and follow strict non-alcoholic and fatigue-management safety protocols."
  },
  {
    q: "What is your cancellation and refund policy?",
    a: "We offer hassle-free cancellation. For standard local and outstation taxi bookings, cancellations made up to 4 hours before scheduled pickup incur zero cancellation fees."
  },
  {
    q: "Can I customize our temple tour or holiday itinerary midway?",
    a: "Absolutely. All our pilgrimage packages (Tirupati, Navagraha, Thiruvannamalai, Rameswaram) are flexible. You can request additional temple stops or dining breaks along the route with your chauffeur."
  },
  {
    q: "How far in advance should I book my trip?",
    a: "For local city trips and airport transfers, 2 to 4 hours advance notice is sufficient. For weekend temple pilgrimages, outstation tours, and festival periods (Girivalam, Pongal, Diwali), booking 24-48 hours ahead is recommended."
  }
];
---

<section id="faq" class="py-10 md:py-14 bg-m3-surface-container-low border-t border-m3-outline-variant/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-m3-on-surface tracking-tight leading-tight mb-2.5 font-heading">
        Frequently Asked <span class="text-m3-primary">Questions</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-m3-on-surface-variant font-normal max-w-2xl mx-auto leading-relaxed mb-6 font-sans">
        Transparent answers about our taxi rates, booking process, driver safety, and outstation trips.
      </p>
    </div>

    <!-- 2-Column Space-Efficient Accordion Grid -->
    <FAQAccordion items={faqs} columns={2} />
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(faq => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.a,
      },
    })),
  })}
/>
