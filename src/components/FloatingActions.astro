---
import WhatsAppIcon from './WhatsAppIcon.astro';
import GeminiIcon from './GeminiIcon.astro';
import { WHATSAPP_CONFIG, getPageWhatsAppMessage } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
  whatsappMsg?: string;
}

const {
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
  whatsappMsg,
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedWhatsAppMsg = whatsappMsg || getPageWhatsAppMessage(currentPath);
const rawPhone = WHATSAPP_CONFIG.phone;
const whatsappUrl = `https://wa.me/${rawPhone}?text=${encodeURIComponent(resolvedWhatsAppMsg)}`;
---

<!-- Global Floating Contact & Booking Actions -->
<!-- Desktop: Call + WhatsApp + AI Plan always accessible in dock -->
<!-- Mobile: Always accessible direct 1-tap Call and WhatsApp buttons -->
<div 
  id="floating-actions-container"
  class="fixed bottom-4 right-3 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-2.5 sm:gap-3 pointer-events-none select-none pb-[env(safe-area-inset-bottom,0px)] pr-[env(safe-area-inset-right,0px)] transition-all duration-300 transform translate-y-0 opacity-100 will-change-transform"
  role="region"
  aria-label="Direct Booking & AI Helplines"
>
  <!-- 1. Direct Phone Call Button (M3 Standard FAB) -->
  <a
    href={`tel:+${rawPhone}`}
    id="floating-call-btn"
    class="flex pointer-events-auto group relative items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white shadow-m3-3 hover:shadow-m3-4 active:shadow-m3-1 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 cursor-pointer opacity-100 scale-100 translate-y-0 z-10"
    aria-label={`Call Booking Helpline (${displayPhone})`}
    title={`Call Booking Helpline: ${displayPhone}`}
  >
    <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    
    <!-- M3 Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/95 text-white text-xs font-medium shadow-m3-2 pointer-events-none transition-opacity duration-150 z-20"
      role="tooltip"
    >
      Call {displayPhone}
    </span>
  </a>

  <!-- 2. WhatsApp Button (M3 Standard FAB) -->
  <a
    href={whatsappUrl}
    id="floating-whatsapp-btn"
    target="_blank"
    rel="noopener noreferrer"
    class="flex pointer-events-auto group relative items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] active:bg-[#1da851] text-white shadow-m3-3 hover:shadow-m3-4 active:shadow-m3-1 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 cursor-pointer opacity-100 scale-100 translate-y-0 z-10"
    aria-label={`Chat on WhatsApp (${displayPhone})`}
    title={`Chat on WhatsApp: ${displayPhone}`}
  >
    <WhatsAppIcon variant="white" className="w-6 h-6 sm:w-7 sm:h-7 text-white shrink-0 fill-current" />
    
    <!-- M3 Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/95 text-white text-xs font-medium shadow-m3-2 pointer-events-none transition-opacity duration-150 z-20"
      role="tooltip"
    >
      WhatsApp Us
    </span>
  </a>

  <!-- 3. Plan My Trip Button (M3 Extended FAB) -->
  <button
    type="button"
    id="floating-ai-plan-btn"
    class="hidden md:flex pointer-events-none md:pointer-events-auto group relative items-center gap-2.5 h-12 sm:h-14 px-4 sm:px-5 rounded-2xl bg-amber-700 hover:bg-amber-800 active:bg-amber-900 text-white shadow-m3-3 hover:shadow-m3-4 active:shadow-m3-1 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 cursor-pointer select-none opacity-0 md:opacity-100 scale-90 md:scale-100 translate-y-2 md:translate-y-0 z-10"
    aria-label="Plan My Trip - Custom Itinerary & Tariff Planner"
    title="Plan your trip & estimate fares with Kalidass Travels"
  >
    <!-- M3 24dp Route / Compass Icon -->
    <svg class="w-5 h-5 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity="0.2"/>
    </svg>
    
    <!-- M3 Label Large -->
    <span class="font-medium text-sm tracking-wide text-white leading-none whitespace-nowrap">
      Plan My Trip
    </span>

    <!-- Forward Arrow -->
    <svg class="w-4 h-4 text-white/80 group-hover:text-white group-hover:translate-x-0.5 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>

    <!-- M3 Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/95 text-white text-xs font-medium shadow-m3-2 pointer-events-none transition-opacity duration-150 z-20"
      role="tooltip"
    >
      Plan My Trip &amp; Fares
    </span>
  </button>
</div>

<script>
  function initFloatingActionsController() {
    const container = document.getElementById('floating-actions-container');
    const callBtn = document.getElementById('floating-call-btn');
    const whatsappBtn = document.getElementById('floating-whatsapp-btn');
    const aiPlanBtn = document.getElementById('floating-ai-plan-btn');
    if (!container) return;

    // Connect AI Plan button to modal
    if (aiPlanBtn) {
      aiPlanBtn.addEventListener('click', () => {
        if (typeof (window as any).openAiFareModal === 'function') {
          (window as any).openAiFareModal();
        }
      });
    }

    let isInputFocused = false;

    function showButton(btn: HTMLElement | null) {
      if (!btn) return;
      btn.classList.remove('hidden', 'opacity-0', 'scale-90', 'translate-y-2', 'pointer-events-none');
      btn.classList.add('flex', 'opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
    }

    function updateVisibility() {
      if (!container) return;
      const isDesktop = window.innerWidth >= 768;

      // Call and WhatsApp are ALWAYS visible on mobile & desktop so users can call with 1 tap
      showButton(callBtn);
      showButton(whatsappBtn);

      if (isDesktop) {
        showButton(aiPlanBtn);
      }

      // Input focus protection: hide floating dock when user is typing in forms
      if (isInputFocused) {
        container.classList.add('translate-y-28', 'opacity-0', 'pointer-events-none');
        container.classList.remove('translate-y-0', 'opacity-100');
      } else {
        container.classList.remove('translate-y-28', 'opacity-0', 'pointer-events-none');
        container.classList.add('translate-y-0', 'opacity-100');
      }
    }

    document.addEventListener('focusin', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) {
        isInputFocused = true;
        updateVisibility();
      }
    });

    document.addEventListener('focusout', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) {
        isInputFocused = false;
        setTimeout(() => {
          if (!isInputFocused) updateVisibility();
        }, 150);
      }
    });

    window.addEventListener('resize', updateVisibility, { passive: true });
    updateVisibility();
  }

  // Initialize on load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingActionsController);
  } else {
    initFloatingActionsController();
  }
  document.addEventListener('astro:page-load', initFloatingActionsController);
</script>
