---
import WhatsAppIcon from './WhatsAppIcon.astro';
import AndroidPhoneIcon from './AndroidPhoneIcon.astro';
import { WHATSAPP_CONFIG, getPageWhatsAppMessage } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
  whatsappMsg?: string;
}

const {
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
  whatsappMsg,
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedWhatsAppMsg = whatsappMsg || getPageWhatsAppMessage(currentPath);
const rawPhone = WHATSAPP_CONFIG.phone;
const whatsappUrl = `https://wa.me/${rawPhone}?text=${encodeURIComponent(resolvedWhatsAppMsg)}`;
---

<!-- Global Floating Contact Actions (Option A: Highest Conversion) -->
<!-- 2 Clean, Round, Unobtrusive Floating Action Buttons (Mobile & Desktop) -->
<div 
  id="floating-actions-container"
  class="fixed bottom-4 right-3 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-3 pointer-events-none select-none pb-[env(safe-area-inset-bottom,0px)] pr-[env(safe-area-inset-right,0px)] transition-all duration-300 transform translate-y-0 opacity-100 will-change-transform"
  role="region"
  aria-label="Direct Booking Helplines"
>
  <!-- 1. Direct Phone Call Button (M3 Round Circular FAB in Android Blue #1A73E8) -->
  <a
    href={`tel:+${rawPhone}`}
    id="floating-call-btn"
    class="flex pointer-events-auto group relative items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#1A73E8] hover:bg-[#1557B0] active:bg-[#174EA6] text-white shadow-m3-3 hover:shadow-m3-4 active:shadow-m3-1 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1A73E8] cursor-pointer opacity-100 scale-100 translate-y-0 z-10"
    aria-label={`Call Booking Helpline (${displayPhone})`}
    title={`Call Booking Helpline: ${displayPhone}`}
  >
    <AndroidPhoneIcon className="w-5 h-5 sm:w-6 sm:h-6 text-white shrink-0 fill-current" />
    
    <!-- M3 Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/95 text-white text-xs font-medium shadow-m3-2 pointer-events-none transition-opacity duration-150 z-20"
      role="tooltip"
    >
      Call {displayPhone}
    </span>
  </a>

  <!-- 2. WhatsApp Button (M3 Round Circular FAB in Official Brand Green #25D366) -->
  <a
    href={whatsappUrl}
    id="floating-whatsapp-btn"
    target="_blank"
    rel="noopener noreferrer"
    class="flex pointer-events-auto group relative items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#25D366] hover:bg-[#20bd5a] active:bg-[#1da851] text-white shadow-m3-3 hover:shadow-m3-4 active:shadow-m3-1 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] cursor-pointer opacity-100 scale-100 translate-y-0 z-10"
    aria-label={`Chat on WhatsApp (${displayPhone})`}
    title={`Chat on WhatsApp: ${displayPhone}`}
  >
    <WhatsAppIcon variant="white" className="w-6 h-6 sm:w-7 sm:h-7 text-white shrink-0 fill-current" />
    
    <!-- M3 Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/95 text-white text-xs font-medium shadow-m3-2 pointer-events-none transition-opacity duration-150 z-20"
      role="tooltip"
    >
      WhatsApp Us
    </span>
  </a>
</div>

<script is:inline>
  (function () {
    function initFloatingActionsController() {
      var container = document.getElementById('floating-actions-container');
      if (!container) return;

      var restoreTimer = null;

      function hideActions() {
        if (restoreTimer) {
          clearTimeout(restoreTimer);
          restoreTimer = null;
        }
        container.classList.add('is-hidden-typing', 'pointer-events-none', 'opacity-0');
        document.documentElement.setAttribute('data-keyboard-open', 'true');
      }

      function restoreActions() {
        var activeEl = document.activeElement;
        var isEditing = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'SELECT' || activeEl.tagName === 'TEXTAREA');
        if (isEditing) return;

        if (window.visualViewport && (window.innerHeight - window.visualViewport.height > 100)) {
          return;
        }

        container.classList.remove('is-hidden-typing', 'pointer-events-none', 'opacity-0');
        document.documentElement.removeAttribute('data-keyboard-open');
      }

      // 1. Capture focusin across all inputs/textareas/selects
      document.addEventListener('focusin', function (e) {
        var target = e.target;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) {
          hideActions();
        }
      }, true);

      // 2. Debounce focusout so moving between fields does not flash buttons
      document.addEventListener('focusout', function (e) {
        var target = e.target;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) {
          if (restoreTimer) clearTimeout(restoreTimer);
          restoreTimer = setTimeout(restoreActions, 200);
        }
      }, true);

      // 3. Viewport resize detection (Android & iOS virtual keyboard open/close)
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', function () {
          var keyboardOpen = (window.innerHeight - window.visualViewport.height) > 100;
          if (keyboardOpen) {
            hideActions();
          } else {
            if (restoreTimer) clearTimeout(restoreTimer);
            restoreTimer = setTimeout(restoreActions, 150);
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFloatingActionsController);
    } else {
      initFloatingActionsController();
    }
    document.addEventListener('astro:page-load', initFloatingActionsController);
  })();
</script>
