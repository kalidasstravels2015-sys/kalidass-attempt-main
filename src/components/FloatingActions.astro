---
import WhatsAppIcon from './WhatsAppIcon.astro';
import AndroidPhoneIcon from './AndroidPhoneIcon.astro';

interface Props {
  phone?: string;
  displayPhone?: string;
  whatsappMsg?: string;
}

const {
  phone = "+916381939769",
  displayPhone = "+91 63819 39769",
  whatsappMsg = "Hi Kalidass Travels, I would like to enquire about booking a cab."
} = Astro.props;

const cleanPhoneForWa = phone.replace(/[^0-9]/g, '');
const whatsappUrl = `https://wa.me/${cleanPhoneForWa}?text=${encodeURIComponent(whatsappMsg)}`;
const callUrl = `tel:${phone}`;
---

<!-- Floating Quick Contact Actions (Desktop Only: hidden on mobile to prevent content overlap) -->
<div 
  id="floating-actions-container"
  class="fixed bottom-6 right-4 sm:bottom-7 sm:right-6 z-50 hidden md:flex flex-col items-end gap-3 pointer-events-none select-none pb-[env(safe-area-inset-bottom,0px)]"
  role="region"
  aria-label="Quick contact shortcuts"
>
  <!-- Android M3 Phone Call Button (Soft Surface with Blue Accent) -->
  <a
    href={callUrl}
    class="pointer-events-auto group relative flex items-center justify-center w-12 h-12 sm:w-auto sm:h-12 sm:px-4 sm:gap-2.5 rounded-full bg-white/95 backdrop-blur-md hover:bg-blue-50 active:bg-blue-100 text-slate-800 hover:text-[#1A73E8] shadow-m3-2 hover:shadow-m3-3 border border-blue-200/90 transform hover:scale-105 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#1A73E8]"
    aria-label="Call Us - 24/7 Helpline (+91 63819 39769)"
    title={`Call Helpline: ${displayPhone}`}
  >
    <!-- Android Dialer Handset Icon in Google Blue -->
    <AndroidPhoneIcon className="w-5 h-5 sm:w-4.5 sm:h-4.5 text-[#1A73E8] group-hover:rotate-12 transition-transform duration-300 shrink-0" />
    
    <!-- Extended FAB label on desktop -->
    <span class="hidden sm:inline font-bold text-sm text-slate-800 group-hover:text-[#1A73E8] tracking-wide font-sans leading-none">
      Call Us
    </span>
  </a>

  <!-- Meta WhatsApp M3 Button (Soft Mint Tonal with Brand Icon) -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer nofollow"
    class="pointer-events-auto group relative flex items-center justify-center w-12 h-12 sm:w-auto sm:h-12 sm:px-4 sm:gap-2.5 rounded-full bg-emerald-50/95 backdrop-blur-md hover:bg-emerald-100 active:bg-emerald-200 text-emerald-950 shadow-m3-2 hover:shadow-m3-3 border border-emerald-300/90 transform hover:scale-105 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#128C7E]"
    aria-label="WhatsApp - Chat with Kalidass Travels"
    title="Chat on WhatsApp (+91 63819 39769)"
  >

    <!-- Official Meta Brand WhatsApp Icon -->
    <WhatsAppIcon variant="brand" className="w-5 h-5 sm:w-5 sm:h-5 relative z-10 shrink-0" />

    <!-- Desktop text label -->
    <span class="hidden sm:inline font-bold text-sm text-emerald-950 tracking-wide font-sans relative z-10 leading-none">
      WhatsApp
    </span>
  </a>
</div>
