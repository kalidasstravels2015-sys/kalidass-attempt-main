---
import AndroidPhoneIcon from './AndroidPhoneIcon.astro';
import { WHATSAPP_CONFIG } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
  whatsappMsg?: string;
}

const {
  phone = `+${WHATSAPP_CONFIG.phone}`,
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
} = Astro.props;

const callUrl = `tel:${phone}`;
---

<!-- Floating Quick Call Action (Google M3 Small FAB - Mobile & Desktop) -->
<div 
  id="floating-actions-container"
  class="fixed bottom-4 right-4 sm:bottom-5 sm:right-5 z-50 flex items-center justify-center pointer-events-none select-none pb-[env(safe-area-inset-bottom,0px)] transition-all duration-300"
  role="region"
  aria-label="Quick contact shortcut"
>
  <a
    href={callUrl}
    id="floating-call-btn"
    class="pointer-events-auto group relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#1A73E8] hover:bg-[#1557B0] active:bg-[#0D47A1] text-white shadow-m3-2 hover:shadow-m3-3 active:scale-95 transition-all duration-200 border border-white/15 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[#1A73E8]/40 after:absolute after:-inset-1.5 after:content-['']"
    aria-label={`Call Helpline (${displayPhone})`}
    title={`Call Helpline: ${displayPhone}`}
  >
    <AndroidPhoneIcon className="w-5 h-5 sm:w-5.5 sm:h-5.5 text-white group-hover:rotate-12 transition-transform duration-300 shrink-0" />
  </a>
</div>

