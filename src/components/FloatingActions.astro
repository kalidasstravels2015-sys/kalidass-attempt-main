---
import WhatsAppIcon from './WhatsAppIcon.astro';
import GeminiIcon from './GeminiIcon.astro';
import { WHATSAPP_CONFIG, getPageWhatsAppMessage } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
  whatsappMsg?: string;
}

const {
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
  whatsappMsg,
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedWhatsAppMsg = whatsappMsg || getPageWhatsAppMessage(currentPath);
const rawPhone = WHATSAPP_CONFIG.phone;
const whatsappUrl = `https://wa.me/${rawPhone}?text=${encodeURIComponent(resolvedWhatsAppMsg)}`;
---

<!-- Global Floating Contact & AI Actions -->
<!-- Desktop: WhatsApp + AI Plan always visible in floating dock -->
<!-- Mobile: Dynamic morphing FAB — WhatsApp at top, AI Plan while scrolling, BOTH at bottom of page -->
<div 
  id="floating-actions-container"
  class="fixed bottom-4 right-3 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-2.5 sm:gap-3 pointer-events-none select-none pb-[env(safe-area-inset-bottom,0px)] pr-[env(safe-area-inset-right,0px)] transition-all duration-300 transform translate-y-0 opacity-100 will-change-transform"
  role="region"
  aria-label="Direct Booking & AI Helplines"
>
  <!-- 1. WhatsApp Button (Mobile: visible at top & bottom of page; Desktop: always visible) -->
  <a
    href={whatsappUrl}
    id="floating-whatsapp-btn"
    target="_blank"
    rel="noopener noreferrer"
    class="flex pointer-events-auto group relative items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#25D366] hover:bg-[#20bd5a] active:bg-[#1da851] text-white shadow-m3-2 hover:shadow-m3-3 active:scale-95 transition-all duration-300 border border-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 cursor-pointer opacity-100 scale-100 translate-y-0 z-10"
    aria-label={`Chat on WhatsApp (${displayPhone})`}
    title={`Chat on WhatsApp: ${displayPhone}`}
  >
    <WhatsAppIcon variant="white" className="w-6 h-6 sm:w-7 sm:h-7 text-white shrink-0 fill-current" />
    
    <!-- Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/90 text-white text-xs font-semibold shadow-md pointer-events-none transition-opacity duration-150 z-20 border border-white/10"
      role="tooltip"
    >
      WhatsApp Us
    </span>
  </a>

  <!-- 2. Plan Trip Button (Mobile: reveals on scroll & visible at bottom of page; Desktop: always visible) -->
  <button
    type="button"
    id="floating-ai-plan-btn"
    class="hidden md:flex pointer-events-none md:pointer-events-auto group relative flex-col items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white dark:bg-[#1E1F20] text-slate-800 dark:text-white shadow-m3-2 hover:shadow-m3-3 active:scale-95 transition-all duration-300 border border-[#006D3B]/40 hover:border-[#006D3B] dark:border-emerald-500/40 dark:hover:border-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#006D3B]/50 cursor-pointer select-none opacity-0 md:opacity-100 scale-90 md:scale-100 translate-y-2 md:translate-y-0 z-10"
    aria-label="Plan Trip - Custom Itinerary & Tariff Planner"
    title="Plan your trip & estimate fares with Kalidass Travels"
  >
    <!-- Route / Compass Travel Icon -->
    <span class="relative flex items-center justify-center shrink-0">
      <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#006D3B] dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity="0.2"/>
      </svg>
    </span>
    
    <!-- Plan Trip Text Label Below Icon -->
    <span class="font-bold text-[9px] sm:text-[10px] tracking-tight text-slate-900 dark:text-slate-100 leading-none mt-0.5 whitespace-nowrap">
      Plan Trip
    </span>

    <!-- Tooltip on Hover -->
    <span 
      class="hidden md:group-hover:inline-flex md:group-focus-visible:inline-flex absolute right-full mr-2.5 top-1/2 -translate-y-1/2 whitespace-nowrap px-2.5 py-1 rounded-md bg-slate-900/90 text-white text-xs font-semibold shadow-md pointer-events-none transition-opacity duration-150 z-20 border border-white/10"
      role="tooltip"
    >
      Plan Your Trip &amp; Fares
    </span>
  </button>
</div>

<script>
  function initFloatingActionsController() {
    const container = document.getElementById('floating-actions-container');
    const whatsappBtn = document.getElementById('floating-whatsapp-btn');
    const aiPlanBtn = document.getElementById('floating-ai-plan-btn');
    if (!container) return;

    // Connect AI Plan button to modal
    if (aiPlanBtn) {
      aiPlanBtn.addEventListener('click', () => {
        if (typeof (window as any).openAiFareModal === 'function') {
          (window as any).openAiFareModal();
        }
      });
    }

    let isInputFocused = false;
    let ticking = false;

    // Thresholds
    const SCROLL_THRESHOLD = 60;

    function checkIfAtBottom() {
      const scrollY = window.scrollY || window.pageYOffset;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      
      const footer = document.querySelector('footer');
      const footerInView = footer ? (footer.getBoundingClientRect().top <= windowHeight + 120) : false;
      const nearBottom = (windowHeight + scrollY) >= (docHeight - 350);

      return footerInView || nearBottom;
    }

    function showButton(btn: HTMLElement | null) {
      if (!btn) return;
      btn.classList.remove('hidden', 'opacity-0', 'scale-90', 'translate-y-2', 'pointer-events-none');
      btn.classList.add('flex', 'opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
    }

    function hideButton(btn: HTMLElement | null) {
      if (!btn) return;
      btn.classList.remove('flex', 'opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
      btn.classList.add('hidden', 'opacity-0', 'scale-90', 'translate-y-2', 'pointer-events-none');
    }

    function updateVisibility() {
      if (!container) return;
      const currentScrollY = window.scrollY || window.pageYOffset;
      const isDesktop = window.innerWidth >= 768;

      if (isDesktop) {
        // Desktop: Always show both WhatsApp and AI Plan buttons
        showButton(whatsappBtn);
        showButton(aiPlanBtn);
      } else {
        const isAtBottom = checkIfAtBottom();

        if (isAtBottom) {
          // Bottom of page (footer): Show BOTH AI Plan and WhatsApp button
          showButton(whatsappBtn);
          showButton(aiPlanBtn);
        } else if (currentScrollY > SCROLL_THRESHOLD) {
          // Scrolled down mid-page: Show AI Plan only
          hideButton(whatsappBtn);
          showButton(aiPlanBtn);
        } else {
          // Initial view at top: Show WhatsApp only
          showButton(whatsappBtn);
          hideButton(aiPlanBtn);
        }
      }

      // Input focus protection: hide floating dock when typing
      if (isInputFocused) {
        container.classList.add('translate-y-28', 'opacity-0', 'pointer-events-none');
        container.classList.remove('translate-y-0', 'opacity-100');
      } else {
        container.classList.remove('translate-y-28', 'opacity-0', 'pointer-events-none');
        container.classList.add('translate-y-0', 'opacity-100');
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateVisibility);
        ticking = true;
      }
    }

    document.addEventListener('focusin', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) {
        isInputFocused = true;
        updateVisibility();
      }
    });

    document.addEventListener('focusout', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) {
        isInputFocused = false;
        setTimeout(() => {
          if (!isInputFocused) updateVisibility();
        }, 150);
      }
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateVisibility, { passive: true });
    updateVisibility();
  }

  // Initialize on load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingActionsController);
  } else {
    initFloatingActionsController();
  }
  document.addEventListener('astro:page-load', initFloatingActionsController);
</script>
