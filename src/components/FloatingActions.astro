---
import AiFareAssistantModal from './AiFareAssistantModal.astro';
import AndroidPhoneIcon from './AndroidPhoneIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import GeminiIcon from './GeminiIcon.astro';
import { WHATSAPP_CONFIG } from '../utils/whatsapp';

interface Props {
  phone?: string;
  displayPhone?: string;
  whatsappMsg?: string;
}

const {
  phone = `+${WHATSAPP_CONFIG.phone}`,
  displayPhone = WHATSAPP_CONFIG.formattedPhone,
  whatsappMsg = 'Hi Kalidass Travels, I need cab quotation and availability details.',
} = Astro.props;

const rawPhone = WHATSAPP_CONFIG.phone;
const cleanPhone = `+${rawPhone}`;
const callUrl = `tel:${cleanPhone}`;
const whatsappUrl = `https://wa.me/${rawPhone}?text=${encodeURIComponent(whatsappMsg)}`;
---

<!-- Global Floating Actions (Mobile: WhatsApp & Call FABs | Desktop: AI Plan FAB) -->
<div 
  id="floating-actions-container"
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-2.5 pointer-events-none select-none pb-[env(safe-area-inset-bottom,0px)] pr-[env(safe-area-inset-right,0px)] transition-all duration-300"
  role="region"
  aria-label="Quick Actions"
>
  <!-- WhatsApp Circular FAB (Mobile Only) -->
  <a
    href={whatsappUrl}
    id="floating-whatsapp-btn"
    target="_blank"
    rel="noopener noreferrer"
    class="md:hidden pointer-events-auto group relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#25D366] hover:bg-[#20bd5a] active:bg-[#1da851] text-white shadow-md hover:shadow-lg active:shadow-sm active:scale-95 transition-all duration-200 border border-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 cursor-pointer"
    aria-label={`Chat on WhatsApp (${displayPhone})`}
    title={`Chat on WhatsApp: ${displayPhone}`}
  >
    <WhatsAppIcon variant="white" className="w-5 h-5 text-white shrink-0 fill-current" />
  </a>

  <!-- Call Helpline Circular FAB (Mobile Only) -->
  <a
    href={callUrl}
    id="floating-call-btn"
    class="md:hidden pointer-events-auto group relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-m3-primary hover:bg-m3-primary/90 active:bg-m3-primary/80 text-m3-on-primary shadow-md hover:shadow-lg active:shadow-sm active:scale-95 transition-all duration-200 border border-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-m3-primary/50 cursor-pointer"
    aria-label={`Call Helpline (${displayPhone})`}
    title={`Call Helpline: ${displayPhone}`}
  >
    <AndroidPhoneIcon className="w-5 h-5 text-white group-hover:rotate-12 transition-transform duration-300 shrink-0" />
  </a>

  <!-- Desktop Floating AI Plan Action Button (Replaces WhatsApp & Call on Desktop) -->
  <button
    type="button"
    id="floating-ai-plan-btn"
    onclick="window.toggleAiFareModal ? window.toggleAiFareModal() : (window.openAiFareModal && window.openAiFareModal())"
    class="hidden md:inline-flex pointer-events-auto items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-[#0B57D0] via-[#1A73E8] to-[#4F46E5] hover:from-[#0842A0] hover:to-[#4338CA] text-white text-xs lg:text-sm font-bold rounded-full shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-200 cursor-pointer border border-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 group"
    aria-label="Plan My Trip AI"
    title="Plan My Trip with AI"
  >
    <GeminiIcon class="w-4 h-4 text-blue-200 shrink-0 group-hover:rotate-12 transition-transform duration-300" />
    <span class="tracking-wide">AI Plan</span>
  </button>
</div>

<!-- AI Fare Concierge Modal Window (Embedded so openAiFareModal() works from navbar & page buttons) -->
<AiFareAssistantModal phone={cleanPhone} displayPhone={displayPhone} />
