---
/**
 * HeroVisualCard — Desktop hero visual showcase card used beside booking engines
 * on service pages.
 *
 * Renders a crisp 4:3 aspect framed image showcase with:
 * - Floating top badge (e.g. 100% Commercial Yellow-Board Fleet)
 * - Gradient scrim ensuring clear visibility of vehicles/destinations
 * - Bottom trust overlay with headline and checkmark pills
 * - Configurable objectPosition to ensure people/chauffeur heads are never cropped
 */
import OptimizedImage from './OptimizedImage.astro';
import { ShieldCheck, CheckCircle2 } from 'lucide-react';

interface Props {
  badge: string;
  headline: string;
  points?: string[];
  src?: string;
  alt?: string;
  objectPosition?: string;
  variant?: 'glass' | 'solid';
}

const {
  badge,
  headline,
  points = [],
  src,
  alt = '',
  objectPosition = 'center center',
  variant = 'glass',
} = Astro.props;

const isGlass = variant === 'glass';
---

{src ? (
  <div class="relative w-full h-[240px] sm:h-[260px] my-3 rounded-2xl overflow-hidden shadow-xl border border-white/20 bg-[#041E49] group shrink-0">
    <OptimizedImage
      src={src}
      alt={alt || headline}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      style={`object-position: ${objectPosition};`}
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 1024px) 100vw, 480px"
    />
    <!-- Cinema overlay: subtle at top, darker at bottom for text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#041E49]/95 via-[#041E49]/30 to-transparent pointer-events-none"></div>

    <!-- Top Floating Badge -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2 z-10 pointer-events-none">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#041E49]/85 backdrop-blur-md border border-white/25 text-xs font-bold text-white shadow-sm">
        <ShieldCheck className="w-4 h-4 text-emerald-400 shrink-0" />
        <span>{badge}</span>
      </span>
    </div>

    <!-- Bottom Trust Overlay -->
    <div class="absolute bottom-3.5 left-3.5 right-3.5 text-white z-10">
      <p class="text-sm sm:text-base font-bold font-heading leading-snug drop-shadow-md text-white">
        {headline}
      </p>
      {points.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
          {points.map((pt) => (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-black/40 backdrop-blur-xs border border-white/15 text-[11px] sm:text-xs font-medium text-white/95">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400 shrink-0" />
              <span>{pt}</span>
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
) : (
  <div class={`relative flex-1 flex flex-col justify-between my-3 p-4 sm:p-5 rounded-2xl shadow-md transition-all ${
    isGlass
      ? 'backdrop-blur-md bg-white/[0.08] border border-white/15 text-white shadow-[0_8px_32px_rgba(0,0,0,0.25)]'
      : 'bg-m3-surface-container-high border border-m3-outline-variant/80 text-m3-on-surface'
  }`}>
    <!-- Top Badge -->
    <div class="flex items-center justify-between gap-2 mb-2 sm:mb-2.5">
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold shadow-xs ${
        isGlass
          ? 'bg-white/10 backdrop-blur-md border border-white/20 text-white'
          : 'bg-m3-primary/10 text-m3-primary border border-m3-primary/20'
      }`}>
        <ShieldCheck className="w-4 h-4 text-emerald-400 shrink-0" />
        <span>{badge}</span>
      </span>
    </div>

    <!-- Trust Headline & Guarantees -->
    <div class="space-y-2.5">
      <p class={`text-sm sm:text-base font-bold font-heading leading-snug ${
        isGlass ? 'text-white drop-shadow-xs' : 'text-m3-on-surface'
      }`}>
        {headline}
      </p>

      <!-- Trust Feature Pills -->
      {points.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 pt-0.5">
          {points.map((pt) => (
            <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] sm:text-xs font-medium ${
              isGlass
                ? 'bg-[#041E49]/60 border border-white/15 text-white/95 backdrop-blur-xs'
                : 'bg-m3-surface-container border border-m3-outline-variant text-m3-on-surface-variant'
            }`}>
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400 shrink-0" />
              <span>{pt}</span>
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
)}
