---
interface Props {
  items: { name: string; item: string }[];
}

const { items = [] } = Astro.props;

// Ensure "Home" is the root element without duplicating it
const normalizedItems =
  items.length > 0 && (items[0].item === "/" || items[0].name.toLowerCase() === "home")
    ? items
    : [{ name: "Home", item: "/" }, ...items];

const formatItemUrl = (path: string) => {
  if (!path) return "https://kalidasstravels.in/";
  if (path.startsWith("http")) return path;
  const clean = path.startsWith("/") ? path : `/${path}`;
  if (clean.endsWith("/") || clean.includes("#") || clean.includes("?")) {
    return `https://kalidasstravels.in${clean}`;
  }
  return `https://kalidasstravels.in${clean}/`;
};

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: normalizedItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: formatItemUrl(item.item),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav aria-label="Breadcrumb" class="py-2 sm:py-2.5 px-4 sm:px-6 max-w-4xl mx-auto overflow-hidden">
  <ol class="flex items-center list-none p-0 text-xs sm:text-sm text-m3-on-surface-variant overflow-x-auto whitespace-nowrap scrollbar-hide no-scrollbar">
    {
      normalizedItems.map((item, index) => (
        <li class="flex items-center shrink-0">
          {index === normalizedItems.length - 1 ? (
            <span class="text-m3-on-surface font-semibold max-w-[200px] sm:max-w-none truncate" aria-current="page" title={item.name}>
              {item.name}
            </span>
          ) : (
            <>
              <a href={item.item} class="hover:text-m3-primary transition-colors">
                {item.name}
              </a>
              <svg class="h-3.5 w-3.5 mx-1.5 sm:mx-2 text-m3-outline shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  ol::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
    width: 0;
    height: 0;
  }
</style>
