---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  class?: string;
  style?: string;
  width?: number | `${number}`;
  height?: number | `${number}`;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  format?: "webp" | "avif";
  quality?: number;
  widths?: number[];
}

const {
  src,
  alt,
  class: className,
  style,
  width,
  height,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  sizes = "(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw",
  format = "webp",
  quality = 75,
  widths = [240, 360, 480, 540, 640, 800, 1080, 1440, 1920],
} = Astro.props;

// glob all images from src/assets/images
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,svg}",
);

// The src from JSON is usually like "/images/hero/abc.webp"
// We need to map it to absolute src path if it exists in src/assets
const isRemote = src.startsWith("http") || src.startsWith("//");
const assetsPrefix = "/src/assets";
const normalizedSrc = (src || "").replace(/\\/g, "/");
const imagePath = `${assetsPrefix}${normalizedSrc.startsWith("/") ? normalizedSrc : `/${normalizedSrc}`}`;

let imageData: ImageMetadata | null = null;
if (!isRemote) {
  if (images[imagePath]) {
    try {
      const mod = (await images[imagePath]()) as { default: ImageMetadata };
      imageData = mod.default;
    } catch (e) {
      console.error(`Failed to load image: ${imagePath}`, e);
    }
  } else {
    // console.log(`Image not found in src/assets: ${imagePath}`);
  }
}

const resolvedWidth = imageData
  ? (width ? Number(width) : imageData.width)
  : width;
const resolvedHeight = imageData
  ? (width ? Math.round(Number(width) * (imageData.height / imageData.width)) : (height ? Number(height) : imageData.height))
  : height;
---

{
  isRemote ? (
    <img
      src={src}
      alt={alt}
      class={className}
      style={style}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      width={width}
      height={height}
    />
  ) : import.meta.env.DEV ? (
    <img
      src={src}
      alt={alt}
      class={className}
      style={style}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      width={resolvedWidth}
      height={resolvedHeight}
    />
  ) : imageData ? (
    <Image
      src={imageData}
      alt={alt}
      class={className}
      style={style}
      widths={widths}
      sizes={sizes}
      format={format}
      loading={loading}
      decoding={decoding}
      quality={quality}
      fetchpriority={fetchpriority}
      width={resolvedWidth}
      height={resolvedHeight}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      class={className}
      style={style}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      width={width}
      height={height}
    />
  )
}
