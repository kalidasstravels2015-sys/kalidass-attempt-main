---
import OptimizedImage from "./OptimizedImage.astro";
import siteContent from "../data/siteContent.json";
import { Star, Clock, Languages, ShieldCheck, ArrowRight } from "lucide-react";
const drivers = siteContent.drivers;
---

<section class="py-12 md:py-20 bg-m3-surface-container-low">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2
        class="text-2xl md:text-4xl font-extrabold text-m3-on-surface inline-block relative mb-4 font-heading"
      >
        Our Professional Drivers
        <div
          class="absolute bottom-[-10px] left-1/2 transform -translate-x-1/2 w-20 h-1.5 bg-m3-primary rounded-m3-full"
        >
        </div>
      </h2>
      <p class="text-base text-m3-on-surface-variant max-w-2xl mx-auto mt-4 font-sans">
        Experienced, verified, and multilingual drivers at your service.
      </p>
    </div>

    <div class="flex overflow-x-auto gap-6 pb-8 snap-x scrollbar-hide">
      {
        drivers.map((driver) => (
          <div class="flex-none w-72 snap-center bg-m3-surface rounded-m3-xl shadow-m3-1 border border-m3-outline-variant p-4 hover:shadow-m3-3 transition-all duration-300 group">
            <div class="relative mb-4 overflow-hidden rounded-m3-lg">
              <OptimizedImage
                src={driver.image}
                class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"
                alt={driver.name}
                sizes="288px"
              />
              <span class="absolute bottom-2 left-2 bg-slate-950/80 backdrop-blur-md text-white text-micro font-bold px-2.5 py-0.5 rounded-m3-full shadow-m3-1">
                {driver.tag}
              </span>
            </div>
            <h3 class="font-bold text-lg text-m3-on-surface font-heading">{driver.name}</h3>

            <div class="inline-flex items-center gap-1.5 mt-1 mb-2 px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/20 rounded-m3-sm text-micro font-bold text-emerald-800">
              <ShieldCheck className="w-3 h-3 text-emerald-600" />
              100% Police Verified
            </div>

            <div class="text-sm text-m3-on-surface-variant mt-1 space-y-2 font-sans">
              <div class="flex items-center gap-2">
                <Clock className="w-4 h-4 text-m3-primary" />
                <span>{driver.experience}</span>
              </div>
              <div class="flex items-center gap-2">
                <Languages className="w-4 h-4 text-m3-primary" />
                <span>{driver.languages}</span>
              </div>
            </div>
            <div class="flex text-amber-400 mt-4 gap-0.5">
              <Star className="w-4 h-4 fill-current" />
              <Star className="w-4 h-4 fill-current" />
              <Star className="w-4 h-4 fill-current" />
              <Star className="w-4 h-4 fill-current" />
              <Star className="w-4 h-4 fill-current" />
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-8">
      <a
        href="/drivers"
        class="inline-flex items-center gap-2 text-m3-primary font-bold hover:underline transition-colors duration-200 group text-sm"
      >
        <span>View All Drivers</span>
        <ArrowRight
          className="w-4 h-4 text-emerald-500 transform group-hover:translate-x-1 transition-transform duration-200"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
