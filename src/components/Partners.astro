---
import OptimizedImage from "./OptimizedImage.astro";
const partners = [
  {
    name: "Airport Authority of India",
    logo: "/images/partners/airport-chennai.webp",
  },
  { name: "L&T", logo: "/images/partners/landt.webp" },
  { name: "Reliance Jio", logo: "/images/partners/jio.webp" },
  { name: "Savaari", logo: "/images/partners/savaari.webp" },
  { name: "Saravn Enterprises", logo: "/images/partners/saravn.webp" },
  { name: "Cognizant", logo: "/images/partners/cognizant.webp" },
  { name: "TN Police", logo: "/images/partners/tn-police.webp" },
];

// Duplicate for infinite scroll
const scrollingPartners = [...partners, ...partners, ...partners];
---

<section
  class="py-10 md:py-16 bg-m3-surface-container-low overflow-hidden border-t border-m3-outline-variant/60"
>
  <div class="max-w-7xl mx-auto px-4 mb-12 text-center">
    <h2
      class="text-2xl md:text-4xl font-extrabold text-m3-on-surface inline-block relative mb-4 font-heading"
    >
      Trusted By Industry Leaders
      <div
        class="absolute bottom-[-10px] left-1/2 transform -translate-x-1/2 w-20 h-1.5 bg-m3-primary rounded-m3-full"
      >
      </div>
    </h2>
    <p class="text-base text-m3-on-surface-variant max-w-2xl mx-auto mt-4 font-sans">
      Proud to serve these esteemed organizations
    </p>
  </div>

  <div class="relative w-full max-w-6xl mx-auto">
    <!-- Gradient Masks -->
    <div
      class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-m3-surface-container-low to-transparent z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-m3-surface-container-low to-transparent z-10 pointer-events-none"
    >
    </div>

    <!-- Scrolling Track -->
    <div class="flex w-max animate-scroll hover:pause items-center">
      {
        scrollingPartners.map((partner) => (
          <div class="flex-shrink-0 mx-8 md:mx-12">
            <div class="w-44 h-24 md:w-56 md:h-32 flex items-center justify-center bg-m3-surface rounded-m3-xl shadow-m3-1 border border-m3-outline-variant p-4">
              {partner.logo ? (
                <OptimizedImage
                  src={partner.logo}
                  alt={partner.name}
                  class="object-contain w-full h-full transition-all duration-500 transform hover:scale-105"
                />
              ) : (
                <span class="font-bold text-m3-on-surface-variant text-lg">
                  {partner.name}
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    } /* Move by 1/3rd since we tripled the list */
  }
  .animate-scroll {
    animation: scroll 30s linear infinite;
  }
  .hover\:pause:hover {
    animation-play-state: paused;
  }
</style>
